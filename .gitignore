# macOS
.DS_Store

# Editor / IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# loft build / cache (placeholder; refine when build pipeline lands)
target/
build/
dist/
.cache/

# Generated docs
doc/*.html

# Local test outputs
*.log
result.txt
/tmp/

# Golden-image tests: actual outputs are regenerated every run;
# only the goldens are checked in.
tests/actual/

# Scripted-run shots (plan 08 V1b).  Written fresh by every
# validation run and kept for a human to look at, not compared —
# a shot a doc cites gets copied into docs/ deliberately.  The
# .keys scripts under tests/scripts/ ARE committed: they are
# source, not output.
shots/

# Loft's native-compile + interpret cache directories — generated
# binaries / bytecode, regenerated per build.  Both root-level and
# src-level locations.
.loft/
src/.loft/

# Interactive-editor default-slot save (E1-live writes
# dryopea_save.json + the marker sidecar to the cwd when
# launched without a MAP= argument).  Named maps under
# maps/ are intentional repo content — authors commit
# them as authored.
dryopea_save.json
dryopea_save_markers.json

# loft's native build cache — `loft --native` / `make play-native`, and
# any run that compiles a library, drop a cdylib plus its generated .rs
# here.  Build output, regenerated on demand.
native-auto/

# Plan 21 R0 probe output (regenerate with `bash probe/r0/run.sh`)
probe/r0/capture_out.png

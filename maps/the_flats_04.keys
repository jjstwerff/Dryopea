# ── The markers ──
do toggle_mode

# The core, dead centre, with six clear hexes around it in every
# direction — the one place on the map that was kept plain.
do cycle_kind
click    0    0
marker   0    0 target

# ⚠ No tower markers.  A tower site is an authored answer to *where do
# you stand*, which is the one thing this map refuses to say.

# The east spawn, facing home — 28 out.
do cycle_kind
do cycle_kind
do cycle_kind
do rotate
do rotate
do rotate
click   28    0
marker   28    0 spawn 3

# The west spawn.  Three more rotations bring the place-direction back
# round to 0, which is EAST.
do rotate
do rotate
do rotate
click  -28    0
marker  -28    0 spawn 0

do toggle_mode

# ⚠ The painted total is the geometry gate: 65 x 65 is 4225, and a
# generator whose idea of a row span differed from the seam's by one hex
# anywhere would miss it.
count painted 4225 4225
count markers 3 3
kind    0    0 grass
kind   32    0 steep_rock
kind    0   32 steep_rock
kind  -32  -32 steep_rock
kind   31    0 steep_rock
kind   30    0 grass
kind   28    0 grass
kind  -28    0 grass
kind    0   30 grass

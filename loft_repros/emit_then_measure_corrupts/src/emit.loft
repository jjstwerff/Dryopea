// The EMIT half: write vertices into a mesh3d::Mesh, one per limb.
use mesh3d;
use hex_body;
use shape;

pub fn part_emit(m: Mesh, p: Part) -> integer {
  n = 0;
  for l in p.pt_limbs {
    add_vertex(m, vertex(vec3(l.lb_cx, l.lb_cy, l.lb_cz), vec3(0.0, 0.0, 1.0), vec2(0.0, 0.0)));
    n += 1;
  }
  n
}

// THE CONTROL.  The same library, the same function, the ambiguity
// removed.  Compiles clean — no `lost-write` — and prints
//
//   loop bind -> true   (want true)
//
// on the interpreter and on --native.  So the write the other file's
// warning calls lost is there.

use slotlib;

fn main() {
    println("loop bind -> {mutate_through_a_loop_variable()}   (want true)");
}

//
// THE HUD — the editor's status indicators, and the ONE number the
// game shows.
//
// Pure Canvas, no font dependency.  ⚠⚠ **THAT WAS A CONSTRAINT AND IS
// NOW A CHOICE** (BACKLOG B1, `@X268`).  It said `graphics::draw_text`
// was unusable twice over — a `#native` call answering *"native
// function not loaded"* under `loft test`, and no font file in the
// repo.  ⚠ The first half is **stale**: measured on the pinned
// `graphics` 0.5.2, `draw_text` draws 1324 pixels on a headless
// `Canvas` under the interpreter (`@M047`).  The second half is
// **paid**: `assets/DejaVuSans-Bold.ttf` ships and `src/font.loft` is
// the seam.
//
// ⚠⚠ **The digits stay RECTANGLES anyway, and not out of inertia.**
// They are gated by an INDEPENDENT ORACLE (the lit-segment counts),
// they are sized 24 x 40 because 14 x 24 was an unreadable squint in a
// real window (`@M042`), and — the reason that would decide it alone —
// **anti-aliased text is not a palette colour**: 774 of a glyph line's
// 1324 lit pixels are blended, so `classify_canvas`'s exact lookup
// would put the wallet in `unknown` and `@X092`'s frame arithmetic
// would stop closing.  ⚠ `picker.loft` reached the same conclusion in
// plan 01 and its note is the older half of this one.
//
// Plan 03 follow-up — QoL polish.  ⚠ Plan 19 P7 added § The wallet.

use graphics;
use wallet;

// ─── Save-state indicator ───────────────────────────────────────
//
// A small filled circle showing whether the editor's in-memory
// state has been saved since the last edit.  Green = clean (the
// disk reflects what's on screen); amber = dirty (unsaved
// changes are pending).  Sits to the right of the picker.

pub const SAVE_INDICATOR_RADIUS:   integer = 4;
pub const SAVE_INDICATOR_CLEAN_BG: integer = 0x40c060;   // grass-green
pub const SAVE_INDICATOR_DIRTY_BG: integer = 0xf0a020;   // amber
pub const SAVE_INDICATOR_BORDER:   integer = 0xffffff;

// Draw the save indicator at (cx, cy) (the dot's centre).
// `dirty == true` means there are unsaved changes since the last
// successful save_world / save_markers call.
pub fn render_save_indicator(cv: Canvas, dirty: boolean, cx: integer, cy: integer) {
    rsi_bg = if dirty { SAVE_INDICATOR_DIRTY_BG } else { SAVE_INDICATOR_CLEAN_BG };
    cv.fill_circle(cx, cy, SAVE_INDICATOR_RADIUS, rsi_bg);
    cv.draw_circle(cx, cy, SAVE_INDICATOR_RADIUS, SAVE_INDICATOR_BORDER);
}

// ─── The wallet — the ONE number the game shows (plan 19 P7) ────
//
// ⚠⚠ **`docs/DESIGN.md` § HUD IS EMPHATIC, AND MOST OF THIS SECTION IS
// WHAT IT REFUSES.**  Its whole numeric HUD is:
//
//   > **Wallet** (points) — one corner number.  The only number the
//   > player must see to make build decisions.
//   > […] That's the entire HUD.  No wave-number, no inter-wave
//   > countdown, no minimap, no boost cooldown bar.
//
// So there is no health bar, no tick counter, no enemy count and no
// wave readout here, and adding one is a DESIGN change rather than a
// feature.  ⚠ Everything else the player needs is diegetic and already
// built: the rotors show boost (`@X091`), the canopy shows cargo
// (`@X090`), a tower's top shows whether it has one (`@X093`), and
// § No wave HUD applies the rule *uncompromisingly* to waves.

// A seven-segment digit, as the seven bits `a b c d e f g`.
//
//        aaa
//       f   b
//        ggg
//       e   c
//        ddd
//
// ⚠ **The table is DATA and a wrong row is invisible** — a `5` drawn
// with a `6`'s segments is a perfectly good-looking digit that reads
// the wrong number, and no pixel count can see it.  ⚠ The gate is an
// INDEPENDENT ORACLE: the number of lit segments per digit is the
// classic **6 2 5 5 4 5 6 3 7 6**, which is derived from nothing in
// this file.
//
// Example: @DRY-068, @DRY-069
pub fn digit_segments(d: integer) -> integer {
    if d == 0 { return 0x3f; }   // a b c d e f
    if d == 1 { return 0x06; }   //   b c
    if d == 2 { return 0x5b; }   // a b   d e   g
    if d == 3 { return 0x4f; }   // a b c d     g
    if d == 4 { return 0x66; }   //   b c     f g
    if d == 5 { return 0x6d; }   // a   c d   f g
    if d == 6 { return 0x7d; }   // a   c d e f g
    if d == 7 { return 0x07; }   // a b c
    if d == 8 { return 0x7f; }   // every one
    if d == 9 { return 0x6f; }   // a b c d   f g
    0
}

// How wide one digit is drawn, how tall, how thick its strokes, and
// how far apart two of them sit — in pixels.
//
// ⚠ The height is `3 * THICK + 2 * half`, so it is chosen to DIVIDE:
// 40 = 3 x 6 + 2 x 11.  A height that does not leaves a digit a pixel
// short of its box, and only `test_a_digit_fills_its_box` can see it.
// ⚠ The first version shipped 14 x 24 and was measured in the window
// against a 960 x 720 frame: legible, but a squint.  A HUD is read at a
// glance or it is not read.
pub const HUD_DIGIT_W:     integer = 24;
pub const HUD_DIGIT_H:     integer = 40;
pub const HUD_DIGIT_THICK: integer = 6;
pub const HUD_DIGIT_GAP:   integer = 6;

// Draw one digit with its top-left corner at `(x, y)`.
//
// ⚠ A digit the table does not know draws NOTHING rather than a
// plausible wrong glyph — `digit_segments` answers 0 — which is the
// same rule `palette_color` follows for a kind it does not know.
//
// Example: @DRY-069, @DRY-070
pub fn render_digit(cv: Canvas, d: integer, x: integer, y: integer, colour: integer) {
    rd_s = digit_segments(d);
    rd_t = HUD_DIGIT_THICK;
    // The half-height of a vertical stroke, so the three horizontal
    // strokes and two halves fill the box exactly.
    rd_h = ((HUD_DIGIT_H - 3 * rd_t) / 2) ?? 0;
    rd_w = HUD_DIGIT_W;
    // ⚠ Seven statements rather than a rectangle table: a
    // `vector<Struct>` local here would be seven allocations on every
    // digit of every frame, and the segments are not a list anybody
    // iterates for any other reason.
    if rd_s & 0x01 != 0 { cv.fill_rect(x + rd_t, y, rd_w - 2 * rd_t, rd_t, colour); }
    if rd_s & 0x02 != 0 { cv.fill_rect(x + rd_w - rd_t, y + rd_t, rd_t, rd_h, colour); }
    if rd_s & 0x04 != 0 { cv.fill_rect(x + rd_w - rd_t, y + 2 * rd_t + rd_h, rd_t, rd_h, colour); }
    if rd_s & 0x08 != 0 { cv.fill_rect(x + rd_t, y + 2 * rd_t + 2 * rd_h, rd_w - 2 * rd_t, rd_t, colour); }
    if rd_s & 0x10 != 0 { cv.fill_rect(x, y + 2 * rd_t + rd_h, rd_t, rd_h, colour); }
    if rd_s & 0x20 != 0 { cv.fill_rect(x, y + rd_t, rd_t, rd_h, colour); }
    if rd_s & 0x40 != 0 { cv.fill_rect(x + rd_t, y + rd_t + rd_h, rd_w - 2 * rd_t, rd_t, colour); }
}

// Draw `n` right-aligned so its LAST digit ends at `right`, with the
// top of the digits at `top`.  Answers how many digits were drawn.
//
// ⚠⚠ **RIGHT-ALIGNED, because it is a corner readout**: a number that
// grows leftward from a fixed edge never moves the digit the eye is
// resting on, and a left-aligned one shifts every digit when the
// hundreds column appears or goes.
//
// ⚠ **A negative `n` draws `0`.**  `wallet_left` really can go below
// zero — `wallet_spent` is unbounded and `wallet_broke` is `spent >=
// 200` — and *minus forty points* is not a thing the player can act
// on.  Zero is what they have.
//
// Example: @DRY-072
pub fn render_number(cv: Canvas, n: integer, right: integer, top: integer,
                     colour: integer) -> integer {
    rn_n = n;
    if rn_n < 0 { rn_n = 0; }
    rn_x = right - HUD_DIGIT_W;
    rn_c = 0;
    // ⚠ A `while` rather than a digit-count-then-loop, so that 0 draws
    // one digit rather than none: the first pass always runs.
    while true {
        render_digit(cv, (rn_n % 10) ?? 0, rn_x, top, colour);
        rn_c += 1;
        rn_n = (rn_n / 10) ?? 0;
        if rn_n == 0 { break; }
        rn_x -= HUD_DIGIT_W + HUD_DIGIT_GAP;
    }
    rn_c
}

// The digits' colour at a full wallet, and at a broke one.
//
// ⚠⚠ **THE RAMP IS NOT ONE COLOUR, IT IS 201** — one per whole point
// the wallet can show — and that is the whole reason it is written as
// a function of `hud_wallet_points` rather than of `wallet_left`.  A
// ramp over the FLOAT reaches uncountably many colours and can only be
// sampled; a ramp over the integer the digits already show reaches
// exactly `WALLET_STARTING_POINTS + 1`, so `tests/19_p7` sweeps EVERY
// ONE of them against the palette, the entity table and the clear
// colour.  ⚠ It also means the colour can never disagree with the
// number, because it IS the number.
//
// ⚠⚠ **AND THE SWEEP EARNED ITS KEEP IMMEDIATELY** (`@M043`): amber to
// red passes through `#ff8000`, which was the SCOUT's colour, at
// exactly **134 points** — so at one value of the wallet the HUD would
// have been painted in a robot's colour and the GL gate would have
// counted those pixels as a robot.  The scout moved; the lane is now
// **3969** squared-RGB clear at its worst.
pub const HUD_INK_FULL:  integer = 0xffc000;   // amber
pub const HUD_INK_BROKE: integer = 0xff0000;   // red

// The colour `points` is drawn in.
//
// ⚠ LINEAR in the wallet's remaining points, which is the one curve
// that invents no number: the endpoints are the two colours above and
// the span is `WALLET_STARTING_POINTS`, which the simulation already
// owns.  ⚠⚠ **The threshold a designer would reach for — *the number
// goes warm when you can no longer buy the cheapest thing* — needs
// `order_cost_points` (100), which lives in `examples/numbers.json`
// and in NO `.loft` constant**, because building is not built.
// Introducing a simulation constant nobody spends, to colour a HUD, is
// a constant that drifts; the trigger to add the band is BUILDING.
//
// Example: @DRY-074, @DRY-076
pub fn hud_ink_for(points: integer) -> integer {
    hif_t = floor(WALLET_STARTING_POINTS) as integer? ?? 0;
    if hif_t <= 0 { return HUD_INK_FULL; }
    hif_p = points;
    // ⚠ Clamped BOTH ways: `wallet_earn` exists, so a run really can
    // hold more than it started with, and a wallet above full is not a
    // colour past amber — it is amber.
    if hif_p < 0 { hif_p = 0; }
    if hif_p > hif_t { hif_p = hif_t; }
    rgb(hud_ink_channel(16, hif_p, hif_t),
        hud_ink_channel(8,  hif_p, hif_t),
        hud_ink_channel(0,  hif_p, hif_t))
}

// One channel of the ramp.
//
// ⚠ **INTEGER arithmetic with a NON-NEGATIVE numerator**, so the
// truncation is one rounding rather than two and the 201 reachable
// colours are exactly reproducible — which is what makes the sweep in
// `tests/19_p7` an exhaustive statement rather than a sample.
fn hud_ink_channel(shift: integer, points: integer, total: integer) -> integer {
    hic_f = (HUD_INK_FULL  >> shift) & 255;
    hic_b = (HUD_INK_BROKE >> shift) & 255;
    ((hic_f * points + hic_b * (total - points)) / total) ?? 0
}

// The wallet, floored, as the number the corner shows.
//
// ⚠ **FLOOR and not round**, and it is the meaning rather than the
// arithmetic: `DESIGN.md` calls this *the only number the player must
// see to make build decisions*, and a tower costs 100 whole points.
// Rounding 99.6 up to 100 would show a tower the player cannot buy.
// ⚠ It reads 0 for a run that is alive with 0.4 points left, which is
// honest for the same reason — and *is the run over* is
// `wallet_broke`, never this number.
//
// Example: @DRY-071
pub fn hud_wallet_points(w: const Wallet) -> integer {
    hwp = floor(wallet_left(w)) as integer? ?? 0;
    if hwp < 0 { return 0; }
    hwp
}

// The colour this wallet's number is drawn in — the ramp, read off the
// same integer the digits show.
//
// Example: @DRY-076, @DRY-077
pub fn hud_wallet_ink(w: const Wallet) -> integer {
    hud_ink_for(hud_wallet_points(w))
}

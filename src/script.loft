//
// The `.keys` script runner — plan 08 phase V1a.
//
// V0 built the seam: every editor action is an `EditorInput` field
// that `editor_step` applies to an `EditorState`, with no GL and no
// clock.  This file is the reader that turns a line of text into
// those frames, so a run can be written down, replayed, and
// measured.
//
// ── The invariant ───────────────────────────────────────────────
//
// **The runner reaches the editor ONLY through `editor_step`.**  It
// never assigns an `EditorState` field, not even the camera — see
// `at` below, which walks the camera with pan frames rather than
// setting `s.cam`.  That is what makes "the script and the editor
// are one machine" a fact rather than an aspiration: anything a
// script can do, a player can do, because the script has no other
// door.
//
// ── One key table, and this runner types on it (plan 09 I1) ─────
//
// A script says `do toggle_mode`, not `key Tab` — that has been
// true since V1a and still is.  ⚠ `do Tab` must keep FAILING: the
// vocabulary names actions, and a key name that starts working
// means a second table has been built.
//
// What changed in I1 is underneath.  V1a's `script_set_action`
// mapped a name STRAIGHT onto an `EditorInput` field, and
// `main.loft` bound physical keys onto the same fields from the
// other side.  Neither held a copy of the other's table — but
// neither held the SAME one either, so nothing a script did was
// evidence about the keyboard.  A binding could be wrong in the
// editor and all 14 scripts stayed green.
//
// Now both sides go through `src/bindings.loft`:
//
//     the player   keyboard → input_tick        ┐
//                                               ├→ editor_input_from → seam
//     a .keys run  action   → keys → feed       ┘
//
// So `do undo` presses Ctrl and Z, and a wrong binding fails the
// gate.  The rebinding a script survives is now a real remap rather
// than a promise — `ScriptRun.isrc` is what a test hands a remapped
// table to.
//
// ── Vocabulary ──────────────────────────────────────────────────
//
//   # …                        comment — whole lines only
//   echo <text…>               marker into the transcript
//   at <q> <r> [zoom]          walk the camera to a hex (and zoom)
//   do <action>                one frame with the action held, then
//                              a release frame — a key TAP
//   hold <action> <n>          the action held for n frames, no
//                              release — a key HELD DOWN
//   step <n>                   n frames with no action
//   palette <index>            select a palette entry (a tap)
//   hover <q> <r>              move the pointer over a hex
//   click <q> <r>              press + release at a hex — paints or
//                              places, whichever the mode is in
//   drag <q1> <r1> <q2> <r2>   press, move, release — the
//                              paint-line path
//   snap <name>                the frame into <shots>/<name>.png,
//                              plus a state line in the transcript
//   wave <n> [class]           start a wave of n enemies at the
//                              spawn markers, cored on the target.
//                              `class` is robot (the default) or
//                              insect (plan 11 F6)
//   raise <q> <r> <m> [source] pile metres of rubble onto a hex at
//                              RUNTIME — what a body does when it
//                              falls and a wall does when it breaks
//                              (plan 11 F6, plan 12 B1).  `source` is
//                              wreckage (the default), carapace or
//                              masonry.  Accumulates; never saved
//   clear <q> <r>              take the whole pile away, leaving the
//                              hex exactly as the map paints it — the
//                              layer's defining property (plan 12 B1)
//   damage <q> <r> <hp>        land HP on the structure at a hex, so a
//                              scenario need not tick out 100 s of
//                              siege (plan 12 B2).  It cannot BREAK
//                              anything — only a tick does that
//   hit <i> <hp>               land HP on one ENEMY, by roster index
//                              (plan 12 B4).  It cannot KILL — only a
//                              tick does that, so there is one death
//                              path for the tower to share
//   tick <n>                   advance the wave n game-ticks — over
//                              the session's own world, so an enemy
//                              stops at what its class cannot cross.
//                              Since B2 it also lands the siege's
//                              damage and breaks what has run out
//   park <q> <r>               put the player on a hex (plan 13 V1)
//   drive <q> <r>              point the player at a hex; the TICK
//                              moves it, two hexes a tick, along the
//                              straight line — a player DRIVES, so it
//                              stops at what it cannot climb rather
//                              than routing round it
//   boost                      start a boost (plan 13 V4) — four hexes
//                              a tick and a 3.0 m climb for 2 s, then
//                              5 s of cooldown.  ⚠ An ERROR when the
//                              vehicle is not READY, because a script
//                              asserts intent where a held key would
//                              simply do nothing
//   crew <q> <r>               add a helper at a hex (plan 14 H1).
//                              ⚠ An ERROR past `roster_cap` (6), which
//                              is the number a base can hold
//   send <i> <q> <r>           point helper `i` at a hex — the same
//                              verb `drive` is for the player, named
//                              apart because one takes an index
//   helper <i> <q> <r>         EXACT hex of one helper
//   fall <max>                 tick until the base FALLS — the wallet
//                              at zero — and stop (plan 12 B7).
//                              ⚠ Still standing after <max> is an
//                              ERROR: a scenario that runs out of
//                              ticks has measured nothing, whatever
//                              it drew
//
// ── Measurements (V2) — each one asserts ────────────────────────
//
//   count painted <lo> <hi>    painted hexes within a band
//   count markers <lo> <hi>    placed markers within a band
//   count alive <lo> <hi>      live enemies — the wave-clear sentinel
//   count targets <lo> <hi>    DISTINCT hexes the wave is attacking —
//                              the siege's spread (plan 11 F7).  A set,
//                              so it does not depend on spawn order
//   target <i> <q> <r>         the EXACT hex one enemy is attacking
//   kind <q> <r> <name>        EXACT ground type at a hex
//   marker <q> <r> <kind> [d]  EXACT marker identity at a hex
//   range <lo> <hi>            how far the live enemies are from
//                              the core, as a span (V3)
//   enemy <i> <q> <r>          EXACT hex of one enemy (plan 11 F1)
//   enemies distinct           no two live enemies share a hex —
//                              they spread, they do not stack
//                              (plan 11 F5c).  RED at the moment a
//                              wave starts: a wave spawns stacked
//   enemies passable           no live enemy stands where its CLASS
//                              cannot (plan 11 F1)
//   hp <q> <r> <lo> <hi>       HP left in the structure at a hex — an
//                              ERROR where nothing breakable stands,
//                              because "at 0" and "not there" are the
//                              two states a break moves between
//                              (plan 12 B2)
//   pile <q> <r> <lo> <hi>     metres of rubble on a hex — the other
//                              half of a break, and the half that says
//                              the breach is a way IN
//   wallet <lo> <hi>           POINTS LEFT in the run's budget — the
//                              only end state dryopea has, since the
//                              core is invulnerable (plan 12 B6).
//                              `wallet 0 0` is "the base fell"
//   vehicle <q> <r>            EXACT hex of the player (plan 13 V1) —
//                              an ERROR when no vehicle has been
//                              placed, because "not in the world" and
//                              "parked on the origin" are two states
//                              one reading cannot tell apart
//   hull <lo> <hi>             the player's blocker HP (plan 13 V5) —
//                              an ERROR with no vehicle in the run.
//                              ⚠ NOT `hp`, which is a hex's structure:
//                              one word for both would be a reading
//                              whose meaning depends on knowing which
//   ticks <lo> <hi>            game-ticks played so far — the run's
//                              CLOCK, and plan 12 B7's deliverable.
//                              A band, because a clock is the sum of
//                              a routing, a siege, a magazine and a
//                              heap of bodies
//   frame <bucket> <lo> <hi>   share of WORLD pixels in a bucket
//
// A measurement that reads out of band ENDS the run, naming the
// number it saw and the band it wanted — the transcript is the
// verdict, so a passing line and a failing line both say what was
// measured.  Prefer the exact ones: a hex either is grass or it is
// not, and no band is needed to say so.  `frame` earns its place on
// the one question the others cannot answer — *is the thing
// actually drawn?* — which is the question `fill_triangle` failed
// for two releases with every state assertion green.
//
// ── Where a shot goes, and what it is ───────────────────────────
//
// `shots_dir` is per-run and defaults to `shots/` (gitignored,
// written fresh); a test points it at `tests/actual/` instead.
// `snap` creates the directory, because `save_png` does NOT create
// parents and answers false rather than raising — an unchecked
// write there goes nowhere and leaves a gate green over a picture
// that was never taken.  So the answer is checked, and a failed
// write ends the run.
//
// The picture is `render_editor_frame` — the SAME composition
// main.loft draws, not a second renderer that lives in the harness
// (see `editor_view.loft`).  A shot is evidence about the editor
// only if it is the editor's own frame.
//
// ⚠ **An unknown command is an ERROR, not a skipped line**, and so
// is an unknown action, a bad number and a wrong argument count.  A
// typo that silently does nothing turns a passing run into a lie —
// this is the runner's negative control, and `ScriptRun.ok` /
// `.line` / `.message` are how it says so.
//
// ── Why `hold` needs no help ────────────────────────────────────
//
// The seam edge-detects, so `hold toggle_mode 5` is five identical
// frames and toggles the mode ONCE — exactly what holding Tab does
// for a player.  The runner does nothing to arrange that; it just
// hands the same input over five times.  Level-triggered actions
// (pan, palette) repeat under `hold` for the same reason, which is
// also what the player sees.
//
// ── The pointer persists ────────────────────────────────────────
//
// `hover` / `click` / `drag` leave the pointer where they put it,
// and every later frame carries that position.  A pointer does not
// jump back to the origin when a button lifts, and V1b's `snap`
// renders the hover preview under it.

use lattice;
use camera;
use painted;
use markers;
use picker;
use palette;
use editor_mode;
use editor_step;
use bindings;
use editor_view;
use measure;
use save;
use height;
use passable;
use damage;
use wallet;
use vehicle;
use helper;
use occupancy;
use spawn;
use fixstep;
use play;
use graphics;

// ─── The run record ─────────────────────────────────────────────

// What a run produced: whether it survived, where it died if not,
// and how much of it happened.  It also carries the pointer, which
// persists across commands the way a real one does — a run's record
// and its cursor are the same object because the cursor IS part of
// where the run got to.
pub struct ScriptRun {
    ok:       boolean,
    line:     integer,   // 1-based line of the failure; 0 when ok
    message:  text,      // "" when ok
    commands: integer,   // commands executed
    frames:   integer,   // `editor_step` calls made
    snaps:    integer,   // pictures written
    checks:   integer,   // measurements that passed

    hover_q:  integer,
    hover_r:  integer,

    // The GAME the run is playing — the roster, the clock, and the
    // seconds banked toward the next tick (plan 19 P1).
    //
    // It lives here rather than on `EditorState` because it is not
    // editor state: a session that is being edited has no enemies in
    // it, and folding a roster into the seam would make `editor_step`
    // answer for something no editor action touches.  A run has a
    // pointer, a shots directory and a game; the editor has none of
    // the three.
    //
    // ⚠ **One record, not three fields.**  It was a bare `WaveState`
    // plus a `ticks` counter until P1, and it cannot stay that way:
    // `play_advance` takes a `PlayState`, so a run holding the pieces
    // separately could not reach the door at all without handing over
    // its own copies — which is the two-games defect `play.loft`
    // exists to make unwritable.  `run.play.ticks` is plan 12 B7's
    // clock, moved and not renamed.
    play: PlayState,

    // Where `snap` writes.  Per-run rather than a constant, so the
    // suite can drop its shots in `tests/actual/` (wiped between
    // runs) while a validation run keeps them in `shots/`.
    shots_dir: text,

    // The keyboard this run types on (plan 09 I1) — `input`'s
    // abstract state plus dryopea's one key table.  Per-run rather
    // than global so two runs in one process cannot leak a held key
    // into each other, and so a run can be given REBOUND keys: a
    // script that still passes under a remap is what proves the
    // indirection is real rather than decorative.
    isrc: EditorInputSource,
}

// Default home for shots: gitignored, rewritten every run.  A shot
// worth keeping is copied into `docs/` by whatever cites it.
pub const SHOTS_DIR: text = "shots";

pub fn script_run_new(shots_dir: text) -> ScriptRun {
    ScriptRun {
        ok:        true,
        line:      0,
        message:   "",
        commands:  0,
        frames:    0,
        snaps:     0,
        checks:    0,
        hover_q:   0,
        hover_r:   0,
        play:      play_state_new(),
        shots_dir: shots_dir,
        isrc:      input_source_new(),
    }
}

// A one-line verdict, for a transcript or a shell gate.
pub fn script_describe(r: const ScriptRun) -> text {
    if r.ok {
        "ok — {r.commands} commands, {r.frames} frames, {r.snaps} shots, {r.checks} checks"
    } else {
        "FAILED at line {r.line}: {r.message}"
    }
}

// Repeat counts are bounded so a typo (`hold undo 100000000`) fails
// loudly instead of hanging the harness.  Same for the camera walk:
// `at` is a walk, so a far-away target costs frames, and a target
// further than this is a mistake rather than a long journey.
pub const SCRIPT_MAX_REPEAT:       integer = 10000;
pub const SCRIPT_MAX_CAMERA_STEPS: integer = 4096;

// Spawn markers this close to the core are silenced for the
// mission — `examples/numbers.json § core.close_spawn_disable_radius`,
// DESIGN.md § Updates: free-pick landing.  Restated here because
// nothing loads numbers.json yet; when a loader lands this reads
// from it instead of holding a second copy of the number.
pub const SCRIPT_SPAWN_DISABLE_RADIUS: integer = 10;

// ─── The physical layer (plan 09 I1) ────────────────────────────

// One frame of PHYSICAL input: which key codes are down, whether
// the left button is down, what the wheel did, and whether a paint
// tick is due.
//
// ⚠ The runner used to skip all of this.  `script_set_action`
// mapped an action name STRAIGHT onto an `EditorInput` field, so a
// script never touched a key code — and a binding could be wrong in
// the editor with all 14 scripts still green.  Now `do undo`
// presses the keys a player presses and `src/bindings.loft`
// resolves them, which is what makes a script evidence about the
// keyboard rather than only about the seam.
//
// It costs a round trip that looks pointless written down —
// name → keys → `input` → name → field — and buys the only thing
// that made § One table, two readers true rather than aspirational.
struct ScriptPhys {
    sp_keys:  vector<boolean>,
    sp_mouse: boolean,
    sp_wheel: integer,
    sp_paint: boolean,

    // Is this frame a PLAY frame (plan 19 P2)?  WASD pans a camera and
    // drives a vehicle, so one key has two meanings and the frame has
    // to say which.
    //
    // ⚠ **Set by the ACTION NAME, not by a mode verb**, and that is the
    // choice worth defending: `do pan_north` presses W as a camera key
    // and `do drive_north` presses the same W as a play key, so a line
    // SAYS which game it is playing.  A `live` verb would have made the
    // meaning depend on a line somewhere above, which is exactly what
    // `take` / `drop` refuse to do about one carry key.
    //
    // ⚠ Zero-neutral, so every scenario written before P2 keeps its
    // meaning and all 520 gate measurements are untouched.
    sp_playing: boolean,
}

fn script_phys_new() -> ScriptPhys {
    ScriptPhys {
        sp_keys:    keyboard_empty(),
        sp_mouse:   false,
        sp_wheel:   0,
        sp_paint:   false,
        sp_playing: false,
    }
}

// The play half of the key table, by name.  ⚠ Kept here rather than
// asked of `bindings.loft`, because "does this action drive the game?"
// is a question about the SCRIPT's frame, and an `EditorAction` row
// carries keys and a modifier rule — a third field would be a mode
// concept inside a key table.
fn script_action_is_play(name: text) -> boolean {
    name == "drive_north" || name == "drive_south"
 || name == "drive_east"  || name == "drive_west"
 || name == "boost"       || name == "carry"
}

fn script_press(p: ScriptPhys, keys: const vector<integer>) {
    for spr_k in keys { p.sp_keys[spr_k] = true; }
}

// Press what an action name stands for, modifier included.
//
// Returns false for a name that is not a script action; the caller
// turns that into an error rather than a quiet no-op, because
// `input` will not — an unknown action name simply reads false
// forever, which is a script that silently tests nothing.
//
// ⚠ Three names have no table row, because they are not keys:
// `zoom_in` / `zoom_out` are the WHEEL, and `rotate_ccw` is rotate
// with Shift.  They still resolve THROUGH the table (rotate's keys,
// mod_shift's keys), so no key code is written down twice.
fn script_phys_action(run: ScriptRun, p: ScriptPhys, name: text) -> boolean {
    // The wheel is not a key, so it has no binding to look up.
    if name == "zoom_in"  { p.sp_wheel =  1; return true; }
    if name == "zoom_out" { p.sp_wheel = -1; return true; }

    // Anticlockwise rotation IS rotation, with Shift held — the
    // same gesture the player makes.
    if name == "rotate_ccw" {
        script_press(p, action_keys(run.isrc.eis_actions, "rotate"));
        script_press(p, action_keys(run.isrc.eis_actions, ACTION_MOD_SHIFT));
        return true;
    }

    // The modifiers and the twelve palette hotkeys ARE table rows,
    // but they are not script actions: `do mod_ctrl` would be a
    // frame that does nothing, and `do palette_5` a second spelling
    // of `palette 5`.  Refused, so the vocabulary cannot widen by
    // accident just because the table grew a row.
    if name == ACTION_MOD_CTRL || name == ACTION_MOD_SHIFT { return false; }
    if action_palette_index(run.isrc.eis_actions, name) >= 0 { return false; }

    // ⚠ **And `toggle_play` is refused too** (plan 19 P3).  It is a
    // table row because it is a key, but it is the WINDOW's key: P2
    // decided a script says which meaning it wants by ACTION NAME —
    // `do pan_north` versus `do drive_north` — precisely so that a
    // line's meaning never depends on a line above it.  A `do
    // toggle_play` would put that dependency back, and it would put it
    // in the one place `take` / `drop` already refused to.
    if name == "toggle_play" { return false; }

    if !action_exists(run.isrc.eis_actions, name) { return false; }
    script_press(p, action_keys(run.isrc.eis_actions, name));
    if action_ctrl(run.isrc.eis_actions, name) == CTRL_REQUIRED {
        script_press(p, action_keys(run.isrc.eis_actions, ACTION_MOD_CTRL));
    }
    // ⚠ The name decides what the frame IS — see `ScriptPhys.sp_playing`.
    // Set rather than assigned, so `hold drive_north 5` and a frame
    // that pressed two actions both stay play frames.
    if script_action_is_play(name) { p.sp_playing = true; }
    true
}

// ─── Frames ─────────────────────────────────────────────────────

// One frame through the seam.  The single door — see § The
// invariant.
//
// Physical input goes in; `bindings.loft` decides what it MEANS and
// `editor_step` decides whether a held key has just been pressed.
// Neither decision is made here, which is the point.
fn script_frame(s: EditorState, run: ScriptRun, p: const ScriptPhys) {
    sf_btn: integer = 0;
    if p.sp_mouse { sf_btn = 1; }
    input_source_feed(run.isrc, p.sp_keys, 0.0, 0.0, sf_btn, p.sp_wheel);
    sf_hover = Hex { q: run.hover_q, r: run.hover_r };
    // A script's clock is one tick per scripted frame, so the pan
    // rate limit is always due; the paint one is due only on the
    // frames that say so.
    // ⚠ Through `play_step`, not `editor_step` — a scripted frame and a
    // GL frame are the same door (plan 19 P1), and 0.0 seconds is what
    // makes a script's clock the script's business: no wall time passes
    // while a scenario paints its map, so no tick is taken.
    play_step(run.play, s,
              editor_input_from(run.isrc, sf_hover, true, p.sp_paint, p.sp_playing),
              0.0);
    run.frames += 1;
}

// A frame with nothing held, at the pointer where the run left it.
// This is the RELEASE that makes the next tap of the same action a
// rising edge.
fn script_idle(s: EditorState, run: ScriptRun) {
    script_frame(s, run, script_phys_new());
}

// Walk the camera to (q, r, zoom) with pan / zoom frames, the way a
// player holding W and D gets there.  One frame steps every axis
// that is still off, so the walk costs max(|dq|, |dr|, |dzoom|)
// frames rather than their sum.
//
// Setting `s.cam` directly would be one line and would break the
// invariant this file rests on, so it is not done.
fn script_walk_camera(s: EditorState, run: ScriptRun, q: integer, r: integer, zoom: integer) -> text {
    swc_steps = 0;
    while s.cam.pos.q != q || s.cam.pos.r != r || s.cam.zoom != zoom {
        swc_p = script_phys_new();
        if s.cam.pos.q < q { script_press(swc_p, action_keys(run.isrc.eis_actions, "pan_east")); }
        if s.cam.pos.q > q { script_press(swc_p, action_keys(run.isrc.eis_actions, "pan_west")); }
        // ⚠ North is LARGER r since plan 09 C3, so the key that
        // raises `r` is pan_NORTH.  Get this backwards and the walk
        // diverges instead of converging, and `at` fails with
        // "target is more than N camera steps away" rather than with
        // anything that names the real cause.
        if s.cam.pos.r < r { script_press(swc_p, action_keys(run.isrc.eis_actions, "pan_north")); }
        if s.cam.pos.r > r { script_press(swc_p, action_keys(run.isrc.eis_actions, "pan_south")); }
        // Zoom is the wheel, not a key — the one axis of the walk
        // that has no binding to press.
        if s.cam.zoom > zoom { swc_p.sp_wheel =  1; }
        if s.cam.zoom < zoom { swc_p.sp_wheel = -1; }
        script_frame(s, run, swc_p);
        swc_steps += 1;
        if swc_steps > SCRIPT_MAX_CAMERA_STEPS {
            return "at: target is more than {SCRIPT_MAX_CAMERA_STEPS} camera steps away";
        }
    }
    ""
}

// ─── The state line ─────────────────────────────────────────────

// The "state dump" that rides with every shot.  It goes into the
// transcript beside the file name rather than into a sidecar file,
// because the transcript is where someone reading a failed run is
// already looking — and V2's measurement commands, not a `.txt`
// nobody parses, are what will make these numbers assertable.
fn script_state_line(s: EditorState) -> text {
    "{painted_count(s.pw)} hexes, {marker_count(s.mw)} markers, cam ({s.cam.pos.q}, {s.cam.pos.r}) z{s.cam.zoom}, {mode_name(s.mode)}, tool {s.picker.active}, history {s.history.cursor}/{len(s.history.entries)}"
}

// ─── Measurement plumbing ───────────────────────────────────────

// One measurement, reported EITHER WAY.  A pass prints what it saw
// beside the band it wanted, because a transcript that only speaks
// up on failure cannot be read afterwards as a record of what was
// actually checked — which is the whole point of the transcript
// being the verdict.
fn measure_int(run: ScriptRun, label: text, value: integer, lo: integer, hi: integer) -> text {
    if lo > hi { return "{label}: band {lo}..{hi} is empty"; }
    if value < lo || value > hi { return "{label} = {value}, outside {lo}..{hi}"; }
    println("script: {label} = {value}  [{lo}..{hi}]");
    run.checks += 1;
    ""
}

fn measure_float(run: ScriptRun, label: text, value: float, lo: float, hi: float) -> text {
    if lo > hi { return "{label}: band {lo}..{hi} is empty"; }
    if value < lo || value > hi { return "{label} = {value:8.6}, outside {lo}..{hi}"; }
    println("script: {label} = {value:8.6}  [{lo}..{hi}]");
    run.checks += 1;
    ""
}

// An exact check has no band, so it reports itself.
fn measure_exact(run: ScriptRun, label: text) {
    println("script: {label}");
    run.checks += 1;
}

fn script_kind_name(pal: vector<GroundType>, idx: integer) -> text {
    if idx < 0 || idx >= len(pal) { return "?"; }
    skn_e = pal[idx];
    if skn_e == null { return "?"; }
    skn_e.name
}

// The core is where the target marker is.  Returns (how many, q, r).
//
// EXACTLY one is required by the caller: a wave has to know what it
// is walking towards, and "whichever one the hash yielded first" is
// not an answer a run can repeat.
// ⚠ **Delegates to `play_core`, and does not restate it.**  The core
// is a marker, so "where is the wave walking to" belongs beside the
// markers rather than inside the script runner — and `play_advance`
// has to ask the same question, so a private copy here would be the
// second answer that drifts.  The wrapper survives only because every
// call site and every error message below reads it.
fn script_core(mw: MarkerWorld) -> (integer, integer, integer) {
    play_core(mw)
}

// How many DISTINCT hexes the live wave is attacking — plan 11 F7.
//
// An enemy attacking nothing reports its own hex (`enemy_target`'s
// convention), so those are skipped rather than counted: a wave that is
// walking peacefully besieges zero hexes, not one per enemy.
fn script_distinct_targets(s: EditorState, run: ScriptRun, core: Hex) -> integer {
    sdt_seen: vector<Hex> = [];
    sdt_ts   = wave_targets(run.play.wave, s.picker.palette, s.pw, core);
    sdt_i    = 0;
    for sdt_e in run.play.wave.enemies {
        sdt_t = sdt_ts[sdt_i] ?? Hex { q: sdt_e.q, r: sdt_e.r };
        if sdt_e.alive && !(sdt_t.q == sdt_e.q && sdt_t.r == sdt_e.r) {
            sdt_new = true;
            for sdt_h in sdt_seen {
                if sdt_h.q == sdt_t.q && sdt_h.r == sdt_t.r { sdt_new = false; }
            }
            if sdt_new { sdt_seen += [Hex { q: sdt_t.q, r: sdt_t.r }]; }
        }
        sdt_i += 1;
    }
    len(sdt_seen)
}

// ─── The measurements ───────────────────────────────────────────

// Split out of `script_command` because they are a different kind
// of thing: the commands above CHANGE the session, these only ASK
// it questions — and one dispatcher doing both reads as a list of
// twenty unrelated branches.
fn script_measure(s: EditorState, run: ScriptRun, tok: vector<text>) -> text {
    sm_cmd  = tok[0] ?? "";
    sm_argc = len(tok) - 1;
    sm_a1   = tok[1] ?? "";
    sm_a2   = tok[2] ?? "";
    sm_a3   = tok[3] ?? "";
    sm_a4   = tok[4] ?? "";

    if sm_cmd == "count" {
        if sm_argc != 3 { return "count needs <painted|markers|alive> <lo> <hi>"; }
        sm_lo = sm_a2 as integer?;
        sm_hi = sm_a3 as integer?;
        if sm_lo == null || sm_hi == null { return "count: <lo> and <hi> must be integers"; }
        if sm_a1 == "painted" {
            return measure_int(run, "count painted", painted_count(s.pw), sm_lo ?? 0, sm_hi ?? 0);
        }
        if sm_a1 == "markers" {
            return measure_int(run, "count markers", marker_count(s.mw), sm_lo ?? 0, sm_hi ?? 0);
        }
        if sm_a1 == "alive" {
            return measure_int(run, "count alive", alive_count(run.play.wave), sm_lo ?? 0, sm_hi ?? 0);
        }
        // ⚠ **The anti-collapse measurement** (plan 11 F7).  How many
        // DISTINCT hexes the wave is attacking — the set, not the
        // list.  `docs/ENEMY_MOVEMENT.md` § Sealing the perimeter is a
        // claim about spread, and an implementation that computed "the
        // nearest wall" once would still have every enemy attacking
        // something; it would just all be the same hex.  Only the size
        // of the set can tell those apart, and it is order-independent,
        // which is what lets a script assert it over a roster whose
        // spawn order comes from hash iteration.
        if sm_a1 == "targets" {
            sm_tcore = script_core(s.mw);
            if sm_tcore.0 != 1 {
                return "count targets: needs exactly ONE core marker to besiege, found {sm_tcore.0}";
            }
            return measure_int(run, "count targets",
                               script_distinct_targets(s, run,
                                                       Hex { q: sm_tcore.1, r: sm_tcore.2 }),
                               sm_lo ?? 0, sm_hi ?? 0);
        }
        return "count: unknown subject '{sm_a1}' — painted, markers, alive or targets";
    }

    // Exact, and preferred wherever it can answer the question: a
    // hex either is grass or it is not.
    if sm_cmd == "kind" {
        if sm_argc != 3 { return "kind needs <q> <r> <name>"; }
        sm_v = script_ints(tok, 2);
        if len(sm_v) != 2 { return "kind: <q> and <r> must be integers"; }
        sm_want = palette_index_of(s.picker.palette, sm_a3);
        // An unknown NAME must fail loudly.  `palette_index_of`
        // answers -1, and treating that as sea would quietly turn a
        // typo into an assertion about the wrong thing.
        if sm_want < 0 { return "kind: unknown ground type '{sm_a3}'"; }
        sm_q = sm_v[0] ?? 0;
        sm_r = sm_v[1] ?? 0;
        sm_got = lookup_painted(s.pw, sm_q, sm_r) as integer;
        if sm_got != sm_want {
            return "kind at ({sm_q}, {sm_r}) is '{script_kind_name(s.picker.palette, sm_got)}', expected '{sm_a3}'";
        }
        measure_exact(run, "kind ({sm_q}, {sm_r}) = {sm_a3}");
        return "";
    }

    // What the structure at a hex has left, in HP.
    //
    // A BAND rather than an exact number because HP falls by
    // `per_tick(1.0)` — two thirds of a point — so an exact figure
    // would be a float equality on an accumulated sum, and the one
    // thing it would reliably catch is arithmetic drift rather than
    // the mechanic.  Plan 12 B2.
    //
    // ⚠ A hex with nothing breakable on it is an ERROR, not 0 HP.
    // "This wall is at 0" and "there is no wall here" are the two
    // states a break moves BETWEEN, and a measurement that could not
    // tell them apart would pass before the siege started.
    if sm_cmd == "hp" {
        if sm_argc != 4 { return "hp needs <q> <r> <lo> <hi>"; }
        sm_hv = script_ints(tok, 2);
        if len(sm_hv) != 2 { return "hp: <q> and <r> must be integers"; }
        sm_hlo = sm_a3 as float?;
        sm_hhi = sm_a4 as float?;
        if sm_hlo == null || sm_hhi == null { return "hp: <lo> and <hi> must be numbers"; }
        sm_hq = sm_hv[0] ?? 0;
        sm_hr = sm_hv[1] ?? 0;
        if !structure_breakable(s.picker.palette, s.pw, sm_hq, sm_hr) {
            return "hp at ({sm_hq}, {sm_hr}): '{painted_kind_name(s.picker.palette, s.pw, sm_hq, sm_hr)}' has no HP — nothing there can break";
        }
        return measure_float(run, "hp ({sm_hq}, {sm_hr})",
                             structure_hp(s.picker.palette, s.pw, run.play.wave.damage, sm_hq, sm_hr),
                             sm_hlo ?? 0.0, sm_hhi ?? 0.0);
    }

    // How deep the rubble on a hex is, in metres — the other half of a
    // break, and the half that says the breach is a way in rather than
    // a hole.  Plan 12 B1 built the layer; B2 is what fills it.
    if sm_cmd == "pile" {
        if sm_argc != 4 { return "pile needs <q> <r> <lo> <hi>"; }
        sm_pv = script_ints(tok, 2);
        if len(sm_pv) != 2 { return "pile: <q> and <r> must be integers"; }
        sm_plo = sm_a3 as float?;
        sm_phi = sm_a4 as float?;
        if sm_plo == null || sm_phi == null { return "pile: <lo> and <hi> must be numbers"; }
        sm_pq = sm_pv[0] ?? 0;
        sm_pr = sm_pv[1] ?? 0;
        return measure_float(run, "pile ({sm_pq}, {sm_pr})",
                             height_rise(run.play.wave.heights, sm_pq, sm_pr),
                             sm_plo ?? 0.0, sm_phi ?? 0.0);
    }

    // Points LEFT in the run's budget.  Plan 12 B6, and the only
    // end state dryopea has: the core is invulnerable, so `wallet 0 0`
    // is how a script says "the base fell".
    //
    // ⚠ It needs no core marker and no wave.  The wallet is the RUN's,
    // not the battlefield's — a script may read it before a single
    // enemy has spawned, and 200 is the honest answer then.
    if sm_cmd == "wallet" {
        if sm_argc != 2 { return "wallet needs <lo> <hi>"; }
        sm_wlo = sm_a1 as float?;
        sm_whi = sm_a2 as float?;
        if sm_wlo == null || sm_whi == null { return "wallet: <lo> and <hi> must be numbers"; }
        return measure_float(run, "wallet", wallet_left(run.play.wave.wallet),
                             sm_wlo ?? 0.0, sm_whi ?? 0.0);
    }

    // Where the player is.  Plan 13 V1.
    //
    // ⚠ **An ERROR when nobody has parked one**, for the same reason
    // `hp` refuses a hex with nothing breakable on it: "no vehicle in
    // this run" and "a vehicle on (0, 0)" are two states, and a
    // measurement that answered (0, 0) for both would be green over a
    // run that never placed a player.
    if sm_cmd == "vehicle" {
        if sm_argc != 2 { return "vehicle needs <q> <r>"; }
        sm_vv = script_ints(tok, 2);
        if len(sm_vv) != 2 { return "vehicle: <q> and <r> must be integers"; }
        if !vehicle_present(run.play.wave.player) {
            return "vehicle: no vehicle in this run — `park <q> <r>` puts one in the world";
        }
        sm_vq = sm_vv[0] ?? 0;
        sm_vr = sm_vv[1] ?? 0;
        if run.play.wave.player.q != sm_vq || run.play.wave.player.r != sm_vr {
            return "vehicle is at ({run.play.wave.player.q}, {run.play.wave.player.r}), expected ({sm_vq}, {sm_vr})";
        }
        measure_exact(run, "vehicle ({sm_vq}, {sm_vr})");
        return "";
    }

    // What the player has left, in HP.  Plan 13 V5.
    //
    // ⚠ **`hull` and not `hp`.**  `hp <q> <r> <lo> <hi>` is a hex's
    // structure and this is the vehicle's; one verb doing both would
    // be a line whose meaning depends on knowing which, the same
    // objection plan 12 B4 raised against overloading `damage` for
    // enemies.
    if sm_cmd == "hull" {
        if sm_argc != 2 { return "hull needs <lo> <hi>"; }
        sm_hlo2 = sm_a1 as float?;
        sm_hhi2 = sm_a2 as float?;
        if sm_hlo2 == null || sm_hhi2 == null { return "hull: <lo> and <hi> must be numbers"; }
        if !vehicle_present(run.play.wave.player) {
            return "hull: no vehicle in this run — `park <q> <r>` puts one in the world";
        }
        return measure_float(run, "hull", vehicle_hp(run.play.wave.player),
                             sm_hlo2 ?? 0.0, sm_hhi2 ?? 0.0);
    }

    // Where one helper is.  Plan 14 H1, and the same shape as
    // `enemy <i> <q> <r>`: an index, because a crew is a roster.
    if sm_cmd == "helper" {
        if sm_argc != 3 { return "helper needs <i> <q> <r>"; }
        sm_hv2 = script_ints(tok, 3);
        if len(sm_hv2) != 3 { return "helper: <i>, <q> and <r> must be integers"; }
        sm_hi2 = sm_hv2[0] ?? 0;
        if sm_hi2 < 0 || sm_hi2 >= len(run.play.wave.crew) {
            return "helper: no helper {sm_hi2} — the crew is {len(run.play.wave.crew)} strong";
        }
        sm_hh = run.play.wave.crew[sm_hi2] ?? Helper { };
        if sm_hh.q != (sm_hv2[1] ?? 0) || sm_hh.r != (sm_hv2[2] ?? 0) {
            return "helper {sm_hi2} is at ({sm_hh.q}, {sm_hh.r}), expected ({sm_hv2[1] ?? 0}, {sm_hv2[2] ?? 0})";
        }
        measure_exact(run, "helper {sm_hi2} ({sm_hh.q}, {sm_hh.r})");
        return "";
    }

    // How many carryable things are lying about or being carried.
    // Plan 15 C2.
    //
    // ⚠ **Objects still IN THE WORLD**, so a delivered one is not
    // counted: `cargo 0 0` is how a run says every crew member has been
    // brought home, and the number falling is the only scripted sign
    // that a deposit did anything.
    if sm_cmd == "cargo" {
        if sm_argc != 2 { return "cargo needs <lo> <hi>"; }
        sm_glo = sm_a1 as integer?;
        sm_ghi = sm_a2 as integer?;
        if sm_glo == null || sm_ghi == null { return "cargo: <lo> and <hi> must be integers"; }
        return measure_int(run, "cargo", cargo_count(run.play.wave.cargo),
                           sm_glo ?? 0, sm_ghi ?? 0);
    }

    // How many crew members are STANDING — plan 15 C2, and the verb
    // plan 14 H3 said would arrive with the scenario that wanted it.
    //
    // ⚠ **Standing, not enrolled.**  `len(crew)` never falls, because a
    // wreck keeps its roster slot (H3); what a run wants to assert is
    // that somebody is gone, and then that they are back.  ⚠ A crew
    // member in RECOVERY is not standing either — they are at the core
    // on a 60 s clock — so this reads one lower until the clock runs
    // out, which is what makes the recovery visible to a script at all.
    if sm_cmd == "roster" {
        if sm_argc != 2 { return "roster needs <lo> <hi>"; }
        sm_rlo = sm_a1 as integer?;
        sm_rhi = sm_a2 as integer?;
        if sm_rlo == null || sm_rhi == null { return "roster: <lo> and <hi> must be integers"; }
        sm_rn = 0;
        for sm_rh in run.play.wave.crew {
            if sm_rh.alive { sm_rn += 1; }
        }
        return measure_int(run, "roster", sm_rn, sm_rlo ?? 0, sm_rhi ?? 0);
    }

    // How many shots a tower has FIRED, out of its budget — plan 17 T3.
    //
    // ⚠ **Fired, never remaining**, so the band reads the same way the
    // engine stores it (`tower.loft` § shots FIRED) — and `shots 4 0
    // 0 0` is how a run says "that tower has been rebuilt".
    if sm_cmd == "shots" {
        if sm_argc != 4 { return "shots needs <q> <r> <lo> <hi>"; }
        sm_shv = script_ints(tok, 2);
        if len(sm_shv) != 2 { return "shots: <q> and <r> must be integers"; }
        sm_shlo = (tok[3] ?? "") as integer?;
        sm_shhi = (tok[4] ?? "") as integer?;
        if sm_shlo == null || sm_shhi == null {
            return "shots: <lo> and <hi> must be integers";
        }
        sm_shq = sm_shv[0] ?? 0;
        sm_shr = sm_shv[1] ?? 0;
        if marker_kind(s.mw, sm_shq, sm_shr) != MARKER_KIND_TOWER {
            return "shots: no tower at ({sm_shq}, {sm_shr})";
        }
        return measure_int(run, "shots ({sm_shq}, {sm_shr})",
                           tower_shots(run.play.wave.towers, sm_shq, sm_shr),
                           sm_shlo ?? 0, sm_shhi ?? 0);
    }

    // Whether a tower still has its top on — plan 17 T2.
    //
    // ⚠ **A word rather than a number**, because `top 4 0 0` would read
    // as a count and this is a state.  ⚠ And it REFUSES a hex with no
    // tower marker: "no top" and "no tower" are the two things a
    // stripped tower sits between, and one answer for both is green
    // before the tower is placed and after it is taken away.
    if sm_cmd == "top" {
        if sm_argc != 3 { return "top needs <q> <r> <on|off>"; }
        sm_tpv = script_ints(tok, 2);
        if len(sm_tpv) != 2 { return "top: <q> and <r> must be integers"; }
        sm_tpq = sm_tpv[0] ?? 0;
        sm_tpr = sm_tpv[1] ?? 0;
        sm_tpw = tok[3] ?? "";
        if sm_tpw != "on" && sm_tpw != "off" {
            return "top: <on|off>, not '{sm_tpw}'";
        }
        if marker_kind(s.mw, sm_tpq, sm_tpr) != MARKER_KIND_TOWER {
            return "top: no tower at ({sm_tpq}, {sm_tpr})";
        }
        sm_tphas = tower_has_top(run.play.wave.towers, sm_tpq, sm_tpr);
        if sm_tphas != (sm_tpw == "on") {
            return "top ({sm_tpq}, {sm_tpr}) is {if sm_tphas { "on" } else { "off" }}, expected {sm_tpw}";
        }
        measure_exact(run, "top ({sm_tpq}, {sm_tpr}) {sm_tpw}");
        return "";
    }

    // How many waves the schedule has SENT — plan 16 W1.
    //
    // ⚠ **Sent, not cleared and not survived.**  It is the schedule's
    // own counter, so `waves 2 2` says "the run got as far as wave 2"
    // and says nothing about how that went — which is what lets a
    // scenario assert that a base LASTED long enough to see one.
    if sm_cmd == "waves" {
        if sm_argc != 2 { return "waves needs <lo> <hi>"; }
        sm_wvlo = sm_a1 as integer?;
        sm_wvhi = sm_a2 as integer?;
        if sm_wvlo == null || sm_wvhi == null { return "waves: <lo> and <hi> must be integers"; }
        return measure_int(run, "waves", wave_schedule_sent(run.play.wave.schedule),
                           sm_wvlo ?? 0, sm_wvhi ?? 0);
    }

    // The run's CLOCK, in game-ticks — plan 12 B7.
    //
    // ⚠ **A band, and it has to be.**  `hp` and `kind` are exact
    // because a wall either is at 15 HP or is not; a clock is the sum
    // of a routing, a siege, a tower's magazine and a heap of bodies,
    // and pinning it to a single tick would make every later phase's
    // balance change read as a regression.  What the phase asserts is
    // the SEPARATION between two runs, and that lives in a test where
    // both numbers are in scope at once.
    if sm_cmd == "ticks" {
        if sm_argc != 2 { return "ticks needs <lo> <hi>"; }
        sm_tlo = sm_a1 as integer?;
        sm_thi = sm_a2 as integer?;
        if sm_tlo == null || sm_thi == null { return "ticks: <lo> and <hi> must be integers"; }
        return measure_int(run, "ticks", run.play.ticks, sm_tlo ?? 0, sm_thi ?? 0);
    }

    if sm_cmd == "marker" {
        if sm_argc != 3 && sm_argc != 4 {
            return "marker needs <q> <r> <spawn|target|none> [direction]";
        }
        sm_v = script_ints(tok, 2);
        if len(sm_v) != 2 { return "marker: <q> and <r> must be integers"; }
        sm_q = sm_v[0] ?? 0;
        sm_r = sm_v[1] ?? 0;
        sm_here = has_marker(s.mw, sm_q, sm_r);

        if sm_a3 == "none" {
            if sm_argc != 3 { return "marker: 'none' takes no direction"; }
            if sm_here { return "marker at ({sm_q}, {sm_r}) exists, expected none"; }
            measure_exact(run, "marker ({sm_q}, {sm_r}) = none");
            return "";
        }
        if marker_kind_of(sm_a3) < 0 {
            return "marker: unknown kind '{sm_a3}' — spawn, target, tower or none";
        }
        if !sm_here { return "marker at ({sm_q}, {sm_r}) is none, expected {sm_a3}"; }

        // ⚠ Named through `markers.loft`, not with a local if/else.
        // The one this replaced answered "spawn" for every kind that
        // was not a target, so a tower would have measured as a spawn
        // and a scenario asserting `marker 4 0 spawn` over one would
        // have been green.
        sm_kind = marker_kind(s.mw, sm_q, sm_r);
        sm_name = marker_kind_name(sm_kind);
        if sm_name != sm_a3 {
            return "marker at ({sm_q}, {sm_r}) is {sm_name}, expected {sm_a3}";
        }
        if sm_argc == 4 {
            // Only a spawn has an authored facing.  A direction over
            // any other kind is a claim about a number the player
            // cannot see and cannot set.
            if sm_a3 != "spawn" {
                return "marker: a {sm_a3} has no direction";
            }
            sm_d = sm_a4 as integer?;
            if sm_d == null { return "marker: <direction> must be an integer 0..5"; }
            sm_want_d = sm_d ?? 0;
            sm_got_d  = marker_direction(s.mw, sm_q, sm_r) as integer;
            if sm_got_d != sm_want_d {
                return "marker at ({sm_q}, {sm_r}) faces {sm_got_d}, expected {sm_want_d}";
            }
            measure_exact(run, "marker ({sm_q}, {sm_r}) = spawn facing {sm_want_d}");
            return "";
        }
        measure_exact(run, "marker ({sm_q}, {sm_r}) = {sm_a3}");
        return "";
    }

    // How far the live enemies are from the core, as a span.
    //
    // Added in V3, not V2, because until a scenario said what it
    // had to assert there was no way to know whether the useful
    // shape was "is closer than last time" or "is exactly here".
    // It is the latter: two `range` lines with lower numbers SHOW
    // the approach, and each is exact, where a `closer` command
    // would hide the numbers it compared.
    if sm_cmd == "range" {
        if sm_argc != 2 { return "range needs <lo> <hi>"; }
        sm_lo = sm_a1 as integer?;
        sm_hi = sm_a2 as integer?;
        if sm_lo == null || sm_hi == null { return "range: <lo> and <hi> must be integers"; }
        if sm_lo > sm_hi { return "range: band {sm_lo ?? 0}..{sm_hi ?? 0} is empty"; }
        sm_core = script_core(s.mw);
        if sm_core.0 != 1 {
            return "range: needs exactly ONE target marker to measure from, found {sm_core.0}";
        }
        sm_live = 0;
        sm_near = 0;
        sm_far  = 0;
        for sm_e in run.play.wave.enemies {
            if sm_e.alive {
                sm_dist = lat_distance(Hex { q: sm_core.1, r: sm_core.2 },
                                       Hex { q: sm_e.q,    r: sm_e.r });
                if sm_live == 0 {
                    sm_near = sm_dist;
                    sm_far  = sm_dist;
                } else {
                    if sm_dist < sm_near { sm_near = sm_dist; }
                    if sm_dist > sm_far  { sm_far  = sm_dist; }
                }
                sm_live += 1;
            }
        }
        // A band over an empty roster passes for the wrong reason,
        // which is the whole failure mode this plan is about.
        if sm_live == 0 {
            return "range: no live enemies to measure";
        }
        if sm_near < (sm_lo ?? 0) || sm_far > (sm_hi ?? 0) {
            return "range = {sm_near}..{sm_far} hexes from the core, outside {sm_lo ?? 0}..{sm_hi ?? 0}";
        }
        println("script: range = {sm_near}..{sm_far} hexes  [{sm_lo ?? 0}..{sm_hi ?? 0}]");
        run.checks += 1;
        return "";
    }

    // WHERE an enemy is — exact, and the measurement plan 11 needs
    // that none of V2's could give it.
    //
    // `count alive` says how many, `range` says how far; neither can
    // tell an enemy routing AROUND a wall from one walking THROUGH
    // it, because both show the same shrinking distance.  A hex can.
    //
    // ⚠ The index is the ROSTER index, which is spawn order, and
    // spawn order is round-robin over `active_spawn_markers` — whose
    // order is a hash iteration.  That is stable within a run but
    // not across runs, so a script asserting `enemy <i>` on a map
    // with SEVERAL active spawn markers is asserting something it
    // cannot repeat.  One spawn marker, or measure with `enemies
    // passable` / `range` / `count` instead.
    if sm_cmd == "enemy" {
        if sm_argc != 3 { return "enemy needs <index> <q> <r>"; }
        sm_v = script_ints(tok, 3);
        if len(sm_v) != 3 { return "enemy: <index>, <q> and <r> must be integers"; }
        sm_i = sm_v[0] ?? 0;
        sm_n = len(run.play.wave.enemies);
        // A read past the end must fail loudly: an assertion about an
        // enemy that was never spawned is the confident meaningless
        // number this plan exists to stop.
        if sm_i < 0 || sm_i >= sm_n {
            return "enemy {sm_i}: the roster holds {sm_n} — has the wave started?";
        }
        // Named `sm_one` and not `sm_e`: `sm_e` is the loop variable
        // the roster scans use, and loft rejects a loop variable that
        // shadows a local of the same name.
        sm_one = run.play.wave.enemies[sm_i];
        if sm_one == null { return "enemy {sm_i}: the roster holds {sm_n}"; }
        sm_q = sm_v[1] ?? 0;
        sm_r = sm_v[2] ?? 0;
        if sm_one.q != sm_q || sm_one.r != sm_r {
            return "enemy {sm_i} is at ({sm_one.q}, {sm_one.r}), expected ({sm_q}, {sm_r})";
        }
        sm_dead = if sm_one.alive { "" } else { " — dead" };
        measure_exact(run, "enemy {sm_i} at ({sm_q}, {sm_r}){sm_dead}");
        return "";
    }

    // WHICH wall hex an enemy is attacking — plan 11 F7, and the
    // invariant-gate row that asks for "the exact wall hex, named".
    //
    // `count targets` says the siege is spread; this says where one
    // enemy's own route ran out.  Both are needed: a spread of the
    // wrong hexes has the right count.
    //
    // The same roster-index caveat as `enemy` applies — one spawn
    // marker, or use `count targets`, which is a SET and so cannot
    // depend on spawn order.
    if sm_cmd == "target" {
        if sm_argc != 3 { return "target needs <index> <q> <r>"; }
        sm_v = script_ints(tok, 3);
        if len(sm_v) != 3 { return "target: <index>, <q> and <r> must be integers"; }
        sm_i = sm_v[0] ?? 0;
        sm_n = len(run.play.wave.enemies);
        if sm_i < 0 || sm_i >= sm_n {
            return "target {sm_i}: the roster holds {sm_n} — has the wave started?";
        }
        sm_tc = script_core(s.mw);
        if sm_tc.0 != 1 {
            return "target: needs exactly ONE core marker to besiege, found {sm_tc.0}";
        }
        sm_one = run.play.wave.enemies[sm_i];
        if sm_one == null { return "target {sm_i}: the roster holds {sm_n}"; }
        sm_all = wave_targets(run.play.wave, s.picker.palette, s.pw,
                              Hex { q: sm_tc.1, r: sm_tc.2 });
        sm_t = sm_all[sm_i] ?? Hex { q: sm_one.q, r: sm_one.r };
        sm_q = sm_v[1] ?? 0;
        sm_r = sm_v[2] ?? 0;
        // Attacking nothing is reported as the enemy's OWN hex, and
        // saying so beats "expected (3, 0), got (4, 0)" — which reads
        // like a wrong target rather than like no siege at all.
        if sm_t.q == sm_one.q && sm_t.r == sm_one.r {
            return "enemy {sm_i} at ({sm_one.q}, {sm_one.r}) is attacking nothing, expected ({sm_q}, {sm_r})";
        }
        if sm_t.q != sm_q || sm_t.r != sm_r {
            return "enemy {sm_i} is attacking ({sm_t.q}, {sm_t.r}), expected ({sm_q}, {sm_r})";
        }
        measure_exact(run, "target {sm_i} = ({sm_q}, {sm_r})");
        return "";
    }

    // No live enemy is standing where its CLASS cannot stand.
    //
    // This is the assertion plan 11 F1 exists for, and it is red
    // against the mover in the tree today: approach mode walks a
    // straight heading, so an enemy fired at a wall ends up ON it.
    // An assertion that could not fail before the feature was built
    // would measure nothing (plan 08 § The instrument comes first).
    //
    // Scoped by CLASS, not by material: an insect on a wall it
    // climbs is correct and a robot there is not, so both read the
    // one rule in `passable.loft`.
    if sm_cmd == "enemies" {
        if sm_argc != 1 { return "enemies needs <passable|distinct>"; }
        if sm_a1 != "passable" && sm_a1 != "distinct" {
            return "enemies: unknown check '{sm_a1}' — passable, distinct";
        }
        sm_live = 0;
        sm_at   = 0;
        for sm_e in run.play.wave.enemies {
            if sm_e.alive {
                sm_why = occupancy_fault(s.picker.palette, s.pw, run.play.wave.heights,
                                         sm_e.kind, sm_e.q, sm_e.r);
                if sm_a1 == "passable" && sm_why != "" {
                    return "enemy {sm_at} at ({sm_e.q}, {sm_e.r}): {sm_why}";
                }
                sm_live += 1;
            }
            sm_at += 1;
        }
        // Green over an empty roster is the same lie `range` refuses:
        // every enemy is somewhere legal when there are no enemies.
        if sm_live == 0 { return "enemies {sm_a1}: no live enemies to check"; }

        // ── distinct: no two live enemies share a hex (plan 11 F5c) ─
        //
        // ⚠ This one is RED at the moment a wave starts, and that is
        // not a defect in it: `spawn_wave` emits the whole wave at one
        // marker, so N enemies are stacked before any of them has
        // moved.  A scenario asserts it once they are walking, which
        // makes the red/green pair one tick apart — the same shape as
        // F1's `enemies passable`, and the reason the assertion is
        // known to be able to fail.
        if sm_a1 == "distinct" {
            sm_stack = occupancy_stacked(wave_occupancy(run.play.wave));
            if sm_stack.n > 1 {
                return "{sm_stack.n} enemies are stacked on ({sm_stack.q}, {sm_stack.r})";
            }
            measure_exact(run, "enemies distinct — {sm_live} live, no two on one hex");
            return "";
        }
        measure_exact(run, "enemies passable — {sm_live} live, none where its class cannot stand");
        return "";
    }

    // The only measurement that reads pixels — and so the only one
    // that can see "the thing is not drawn".
    if sm_cmd == "frame" {
        if sm_argc != 3 { return "frame needs <bucket> <lo> <hi>"; }
        sm_b = palette_index_of(s.picker.palette, sm_a1);
        if sm_b < 0 { return "frame: unknown bucket '{sm_a1}'"; }
        sm_flo = sm_a2 as float?;
        sm_fhi = sm_a3 as float?;
        if sm_flo == null || sm_fhi == null {
            return "frame: <lo> and <hi> must be shares of the canvas, 0.0..1.0";
        }
        sm_fc = classify_world(s.cam, s.pw, len(s.picker.palette),
                               VIEW_W, VIEW_H, VIEW_PPM);
        // V2p proved the rasteriser hard-edged, and every band a
        // scenario carries was sized on that.  A pixel that is not
        // a palette colour means the renderer changed underneath
        // the instrument — which invalidates the number rather than
        // nudging it, so it stops the run.
        if sm_fc.unknown > 0 {
            return "frame: {sm_fc.unknown} of {sm_fc.total} pixels are not a palette colour — the renderer is blending, and these bands assume it does not";
        }
        return measure_float(run, "frame {sm_a1}", frame_share(sm_fc, sm_b),
                             sm_flo ?? 0.0, sm_fhi ?? 0.0);
    }

    "unknown measurement '{sm_cmd}'"
}

// ─── Argument parsing ───────────────────────────────────────────

// The first `n` arguments as integers.  Returns a SHORT vector when
// any of them is not a number, so a caller that checks the length
// can phrase the error in its own words.
fn script_ints(tok: vector<text>, n: integer) -> vector<integer> {
    sit_out: vector<integer> = [];
    for sit_i in 1..=n {
        sit_v = (tok[sit_i] ?? "") as integer?;
        if sit_v == null {
            sit_out = [];
            break;
        }
        sit_out += [sit_v ?? 0];
    }
    sit_out
}

// ─── One command ────────────────────────────────────────────────

// Execute one already-tokenised command.  Returns "" on success and
// the error message otherwise — every failure path is a message, so
// no command can fail quietly.
//
// `rest` is the raw remainder of the line after the command word,
// which only `echo` wants.
// ─── Authoring the rest of the state (plan 18 S1b) ──────────────
//
// `plans/18` emits a captured situation as `.keys`, so the vocabulary
// has to be able to SAY every field of a `WaveState`.  S1a did the
// roster; these seven do the layers and the conditions that had no
// setter at all — towers, the wallet, cargo, and the fields on the
// player, the crew and the schedule that no play verb reaches.
//
// ⚠ **Seven command words rather than one `set` with a subject**, and
// the converter is why.  `convert.loft::keys_schemas` keys a
// coordinate's POSITION on the first token, so a single `set` would
// need one pair position for `set tower 4 0 …` and another for
// `set wallet 30` — and the mismatch is silent: a lattice conversion
// would rewrite `set member 0 on 0.5` as if `0 on` were a hex.  That is
// the exact failure `tests/09_c5a_converter.loft` § What must NOT be
// touched exists to refuse.
//
// ⚠ **They AUTHOR and never simulate**, S1a's rule and `damage`'s
// before it: each writes a field and triggers no consequence.  `tower`
// does not fire, `object` does not check reach, `player` does not
// respawn.  A captured state carries every consequence as its own line.
//
// ⚠ In its own function rather than another seven branches of
// `script_command`, which the complexity advice already flags at 214.
fn is_author_cmd(name: text) -> boolean {
    name == "tower" || name == "object" || name == "spent"
    || name == "player" || name == "member" || name == "pending"
    || name == "cursor" || name == "flag"
}

// Read an on/off word.  -1 when it is neither, so a caller can refuse.
fn on_off(word: text) -> integer {
    if word == "on"  { return 1; }
    if word == "off" { return 0; }
    -1
}

fn script_author(s: EditorState, run: ScriptRun, tok: vector<text>) -> text {
    sa_cmd  = tok[0] ?? "";
    sa_argc = len(tok) - 1;

    // A marker, placed directly (plan 18 S2).
    //
    // ⚠ **The editor's dance is not emittable.**  Every scenario in
    // `tests/scripts/` places a marker by toggling to MARKER mode,
    // pressing `cycle_kind` the right number of times and clicking —
    // and the right number depends on `MARKER_KIND_COUNT`, which
    // `CLAUDE.md` § Add a marker kind warns grows.  A generated fixture
    // written that way rots the day a kind is added, silently placing
    // the wrong one.  So the emitter says which kind it means.
    //
    // ⚠ `marker <q> <r> <kind>` stays the ASSERTION, the same split
    // `place` / `enemy` keeps.
    if sa_cmd == "flag" {
        if sa_argc < 3 || sa_argc > 4 {
            return "flag needs <q> <r> <kind> [dir]";
        }
        sa_fv = script_ints(tok, 2);
        if len(sa_fv) != 2 { return "flag: <q> and <r> must be integers"; }
        sa_fk = marker_kind_of(tok[3] ?? "");
        if sa_fk < 0 {
            return "flag: unknown kind '{tok[3] ?? ""}' — spawn, target, tower";
        }
        sa_fd = 0;
        if sa_argc == 4 {
            sa_fdv = (tok[4] ?? "") as integer?;
            if sa_fdv == null { return "flag: <dir> must be an integer"; }
            sa_fd = sa_fdv ?? 0;
            if sa_fd < 0 || sa_fd >= NUM_HEX_DIRECTIONS {
                return "flag: <dir> must be 0..{NUM_HEX_DIRECTIONS - 1}";
            }
        }
        place_marker(s.mw, sa_fv[0] ?? 0, sa_fv[1] ?? 0,
                     sa_fk as u8? ?? 0, sa_fd as u8? ?? 0);
        return "";
    }

    // A tower's whole top: what it has fired, what it has banked toward
    // its next shot, what has been banked toward a rebuild, and whether
    // the top is on it at all.
    //
    // ⚠ It demands a tower MARKER, the same refusal `shots` and `top`
    // make: "no top" and "no tower" are the two states a stripped tower
    // sits between, and one answer for both is green before the tower
    // is placed and after it is taken away.
    if sa_cmd == "tower" {
        if sa_argc != 6 {
            return "tower needs <q> <r> <shots> <charge> <repair> <on|off>";
        }
        sa_tv = script_ints(tok, 2);
        if len(sa_tv) != 2 { return "tower: <q> and <r> must be integers"; }
        sa_tq = sa_tv[0] ?? 0;
        sa_tr = sa_tv[1] ?? 0;
        if marker_kind(s.mw, sa_tq, sa_tr) != MARKER_KIND_TOWER {
            return "tower: no tower marker at ({sa_tq}, {sa_tr})";
        }
        sa_tsh = (tok[3] ?? "") as integer?;
        if sa_tsh == null { return "tower: <shots> must be an integer"; }
        sa_tch = (tok[4] ?? "") as float?;
        if sa_tch == null { return "tower: <charge> must be a number"; }
        sa_trp = (tok[5] ?? "") as float?;
        if sa_trp == null { return "tower: <repair> must be a number"; }
        sa_ttp = on_off(tok[6] ?? "");
        if sa_ttp < 0 { return "tower: <on|off> for the top, not '{tok[6] ?? ""}'"; }

        // Written through one cell so the four fields cannot disagree
        // about which tower they belong to.
        tower_bank(run.play.wave.towers, sa_tq, sa_tr, 0.0);
        sa_tc = run.play.wave.towers.cells[sa_tq, sa_tr];
        if sa_tc == null { return "tower: ({sa_tq}, {sa_tr}) has no cell"; }
        sa_tc.shots       = sa_tsh;
        sa_tc.charge      = sa_tch;
        // ⚠ The UP reading — `repair` is time BANKED toward the rebuild
        // (`tower.loft::tower_repair_progress`), so it restores as spent
        // rather than as left.
        timer_restore_spent(sa_tc.repair,
                            clock_units_from_seconds(sa_trp ?? 0.0),
                            TOWER_REPAIR_UNITS);
        sa_tc.top_removed = sa_ttp == 0;
        return "";
    }

    // One carryable thing.  ⚠ Coordinates FIRST, so the converter's
    // pair position matches every other coordinate verb.
    if sa_cmd == "object" {
        if sa_argc != 5 {
            return "object needs <q> <r> <kind> <subj> <owner>";
        }
        sa_ov = script_ints(tok, 2);
        if len(sa_ov) != 2 { return "object: <q> and <r> must be integers"; }
        sa_okw = tok[3] ?? "";
        sa_ok = CARGO_WRECK;
        if sa_okw == "top" { sa_ok = CARGO_TOP; }
        else if sa_okw != "wreck" {
            return "object: unknown kind '{sa_okw}' — wreck, top";
        }
        sa_osj = (tok[4] ?? "") as integer?;
        if sa_osj == null { return "object: <subj> must be an integer"; }

        // The owner IS the state machine (`carry.loft`): on the ground,
        // in a carrier's slot, or spent.  Named the way `take` / `drop`
        // name a carrier, so one vocabulary covers both.
        sa_ow = tok[5] ?? "";
        sa_owner = BLOCKER_NONE;
        if sa_ow == "ground" { sa_owner = BLOCKER_NONE; }
        else if sa_ow == "gone" { sa_owner = CARGO_GONE; }
        else if sa_ow == "player" { sa_owner = BLOCKER_PLAYER; }
        else {
            sa_oc = sa_ow as integer?;
            if sa_oc == null {
                return "object: <owner> is ground, gone, player or a crew index, not '{sa_ow}'";
            }
            sa_ocn = sa_oc ?? 0;
            if sa_ocn < 0 || sa_ocn >= len(run.play.wave.crew) {
                return "object: no helper {sa_ocn} — the crew is {len(run.play.wave.crew)} strong";
            }
            sa_owner = BLOCKER_CREW + sa_ocn;
        }

        sa_oi = cargo_spawn(run.play.wave.cargo, sa_ok as u8? ?? 0, sa_osj ?? 0,
                            sa_ov[0] ?? 0, sa_ov[1] ?? 0);
        (run.play.wave.cargo.items[sa_oi] ?? CarryObject { }).owner = sa_owner;
        return "";
    }

    // Points SPENT out of the run's budget — the way `wallet.loft`
    // stores it, so the fixture says what the ledger says.
    if sa_cmd == "spent" {
        if sa_argc != 1 { return "spent needs <points>"; }
        sa_sp = (tok[1] ?? "") as float?;
        if sa_sp == null { return "spent: <points> must be a number"; }
        run.play.wave.wallet.spent = sa_sp;
        return "";
    }

    // The player's condition — what `park` and `drive` do not reach.
    // ⚠ `<on|off>` is IN THE WORLD, not alive: a vehicle that has never
    // been parked is at (0, 0) and not present, and (0, 0) is a real
    // hex (`vehicle.loft`).
    if sa_cmd == "player" {
        if sa_argc != 4 {
            return "player needs <on|off> <boost> <cool> <taken>";
        }
        sa_pp = on_off(tok[1] ?? "");
        if sa_pp < 0 { return "player: <on|off> for in-the-world, not '{tok[1] ?? ""}'"; }
        sa_pb = (tok[2] ?? "") as float?;
        sa_pc = (tok[3] ?? "") as float?;
        sa_pt = (tok[4] ?? "") as float?;
        if sa_pb == null || sa_pc == null || sa_pt == null {
            return "player: <boost>, <cool> and <taken> must be numbers";
        }
        run.play.wave.player.parked     = sa_pp == 1;
        timer_restore_left(run.play.wave.player.boost,
                           clock_units_from_seconds(sa_pb ?? 0.0),
                           VEHICLE_BOOST_DURATION_UNITS);
        timer_restore_left(run.play.wave.player.cool,
                           clock_units_from_seconds(sa_pc ?? 0.0),
                           VEHICLE_BOOST_COOLDOWN_UNITS);
        run.play.wave.player.taken      = sa_pt ?? 0.0;
        return "";
    }

    // One crew member's condition — what `crew` and `send` do not reach.
    if sa_cmd == "member" {
        if sa_argc != 5 {
            return "member needs <i> <on|off> <progress> <taken> <recover>";
        }
        sa_mi = (tok[1] ?? "") as integer?;
        if sa_mi == null { return "member: <i> must be an integer"; }
        sa_min = sa_mi ?? 0;
        if sa_min < 0 || sa_min >= len(run.play.wave.crew) {
            return "member: no helper {sa_min} — the crew is {len(run.play.wave.crew)} strong";
        }
        sa_ma = on_off(tok[2] ?? "");
        if sa_ma < 0 { return "member: <on|off> for standing, not '{tok[2] ?? ""}'"; }
        sa_mp = (tok[3] ?? "") as float?;
        sa_mt = (tok[4] ?? "") as float?;
        sa_mr = (tok[5] ?? "") as float?;
        if sa_mp == null || sa_mt == null || sa_mr == null {
            return "member: <progress>, <taken> and <recover> must be numbers";
        }
        sa_mh = run.play.wave.crew[sa_min] ?? Helper { };
        sa_mh.alive    = sa_ma == 1;
        bank_restore_fraction(sa_mh.bank, sa_mp ?? 0.0, BANK_WHOLE);
        sa_mh.taken    = sa_mt ?? 0.0;
        timer_restore_left(sa_mh.recover,
                           clock_units_from_seconds(sa_mr ?? 0.0),
                           HELPER_RECOVERY_UNITS);
        return "";
    }

    // Where the wave list has GOT to — what `schedule` does not reach,
    // because it authors the list and starts it at the beginning.
    if sa_cmd == "pending" {
        if sa_argc != 4 {
            return "pending needs <sent> <lull> <delay> <on|off>";
        }
        sa_ps = (tok[1] ?? "") as integer?;
        if sa_ps == null { return "pending: <sent> must be an integer"; }
        sa_pl = (tok[2] ?? "") as float?;
        if sa_pl == null { return "pending: <lull> must be a number"; }
        sa_pd = (tok[3] ?? "") as float?;
        if sa_pd == null { return "pending: <delay> must be a number"; }
        sa_pr = on_off(tok[4] ?? "");
        if sa_pr < 0 { return "pending: <on|off> for running, not '{tok[4] ?? ""}'"; }
        run.play.wave.schedule.sent    = sa_ps;
        timer_restore_left(run.play.wave.schedule.lull,
                           clock_units_from_seconds(sa_pl ?? 0.0),
                           clock_units_from_seconds(sa_pd ?? 0.0));
        // ⚠ **The delay is here and not on `schedule`**, and finding
        // that out is a plan 18 S2 story worth keeping: S1b's totality
        // test missed this field entirely, because both the script and
        // the hand-built state used `INTER_WAVE_DELAY_SECONDS` — and a
        // field left at its DEFAULT on both sides of a comparison
        // compares equal and proves nothing.  A totality test has to
        // hold every field at a value the default would not produce.
        run.play.wave.schedule.delay   = clock_units_from_seconds(sa_pd);
        run.play.wave.schedule.running = sa_pr == 1;
        return "";
    }

    // The round-robin index into the active markers.  ⚠ It decides
    // which marker the NEXT wave uses, so a fixture that dropped it
    // would replay identically until a wave spawned and then diverge —
    // `plans/18` § Open questions 1.
    if sa_cmd == "cursor" {
        if sa_argc != 1 { return "cursor needs <n>"; }
        sa_cn = (tok[1] ?? "") as integer?;
        if sa_cn == null { return "cursor: <n> must be an integer"; }
        run.play.wave.pick_cursor = sa_cn;
        return "";
    }

    "unknown author command '{sa_cmd}'"
}

// ─── `compose`, parsed away from the dispatcher (plan 23 K1) ────
//
// ⚠ **These three exist because building the parts INSIDE
// `script_command` aborts the interpreter.**  See the `compose` branch
// below for the bisection; the short version is that a
// `vector<WavePart>` local in a ~700-line function corrupts the heap at
// compile time, and the damage lands in an unrelated test file.  They
// are small functions for a bad reason and read like good ones.
//
// ⚠ The split is the repo's own `*_fault` idiom (`tower_sight_fault`,
// `can_step` / `step_fault`): one function ASKS and one ANSWERS why
// not, so a refusal names itself and the builder can assume a checked
// line.

// Everything wrong with a `compose` line, or "" when it parses.
//
// ⚠ Every branch here is a way a typo becomes a green lie: a wave that
// quietly stayed regulars measures the regular's clock and reports it
// as the miner's.
fn compose_fault(tok: vector<text>) -> text {
    cf_argc = len(tok) - 1;
    if cf_argc < 3 {
        return "compose needs <wave> <count> <class> [<count> <class> ...]";
    }
    if (cf_argc - 1) % 2 != 0 {
        return "compose: <count> <class> comes in pairs, got {cf_argc - 1} after <wave>";
    }
    cf_wt = tok[1] ?? "";
    cf_wn = cf_wt as integer?;
    if cf_wn == null { return "compose: <wave> must be an integer"; }

    cf_at = 2;
    while cf_at < len(tok) {
        cf_ct = tok[cf_at] ?? "";
        cf_nm = tok[cf_at + 1] ?? "";
        cf_cn = cf_ct as integer?;
        if cf_cn == null {
            return "compose: <count> must be an integer, got '" + cf_ct + "'";
        }
        cf_c = cf_cn ?? 0;
        if cf_c < 0 || cf_c > SCRIPT_MAX_REPEAT {
            return "compose: each <count> must be 0..{SCRIPT_MAX_REPEAT}, got {cf_c}";
        }
        cf_kv = enemy_class_of(cf_nm);
        if cf_kv == null {
            return "compose: unknown class '" + cf_nm + "' — {enemy_class_names()}";
        }
        cf_at += 2;
    }
    ""
}

// Which wave a `compose` line names.  ⚠ Only meaningful once
// `compose_fault` has passed the line.
fn compose_wave(tok: vector<text>) -> integer {
    cw_t = tok[1] ?? "";
    cw_n = cw_t as integer?;
    cw_n ?? 0
}

// The groups a CHECKED `compose` line names, in the order written.
fn compose_parts(tok: vector<text>, wave: integer) -> vector<WavePart> {
    cp_out: vector<WavePart> = [];
    cp_at = 2;
    while cp_at < len(tok) {
        cp_ct = tok[cp_at] ?? "";
        cp_nm = tok[cp_at + 1] ?? "";
        cp_cn = cp_ct as integer?;
        cp_kv = enemy_class_of(cp_nm);
        cp_c  = cp_cn ?? 0;
        cp_k  = cp_kv ?? 0;
        cp_out += [WavePart { wave: wave, count: cp_c, kind: cp_k }];
        cp_at += 2;
    }
    cp_out
}

// Apply a checked `compose` line.  False when the list has no such
// wave — the one refusal that needs the schedule rather than the text.
fn script_compose(ws: WaveSchedule, tok: vector<text>, wave: integer) -> boolean {
    sco_p = compose_parts(tok, wave);
    wave_schedule_compose(ws, wave, sco_p)
}

fn script_command(s: EditorState, run: ScriptRun, tok: vector<text>, rest: text) -> text {
    sc_cmd  = tok[0] ?? "";
    sc_argc = len(tok) - 1;
    // Out-of-range reads come back null, so a missing argument is
    // "" and fails the same checks a malformed one does.
    sc_a1 = tok[1] ?? "";
    sc_a2 = tok[2] ?? "";

    if sc_cmd == "echo" {
        println("script: {rest}");
        return "";
    }

    // The fixture-authoring verbs (plan 18 S1b) live in their own
    // function — see `script_author`.
    if is_author_cmd(sc_cmd) { return script_author(s, run, tok); }

    if sc_cmd == "at" {
        if sc_argc != 2 && sc_argc != 3 { return "at needs <q> <r> [zoom]"; }
        sc_v = script_ints(tok, sc_argc);
        if len(sc_v) != sc_argc { return "at: every argument must be an integer"; }
        sc_zoom = s.cam.zoom;
        if sc_argc == 3 { sc_zoom = sc_v[2] ?? sc_zoom; }
        if sc_zoom < ZOOM_MIN || sc_zoom > ZOOM_MAX {
            return "at: zoom must be {ZOOM_MIN}..{ZOOM_MAX}";
        }
        return script_walk_camera(s, run, sc_v[0] ?? 0, sc_v[1] ?? 0, sc_zoom);
    }

    // A key tap: one frame held, one frame released.  The release
    // is what makes the NEXT tap of the same action an edge.
    if sc_cmd == "do" {
        if sc_argc != 1 { return "do needs <action>"; }
        sc_p = script_phys_new();
        if !script_phys_action(run, sc_p, sc_a1) { return "unknown action '{sc_a1}'"; }
        script_frame(s, run, sc_p);
        script_idle(s, run);
        return "";
    }

    // A key held down: the SAME input, n times over, with no
    // release.  The seam decides what that means per action —
    // toggle_mode fires once, pan walks every frame.
    if sc_cmd == "hold" {
        if sc_argc != 2 { return "hold needs <action> <frames>"; }
        // Argument 1 is the action name, so only the second is a
        // number — `script_ints` is for the all-integer commands.
        sc_n = (tok[2] ?? "") as integer?;
        if sc_n == null { return "hold: <frames> must be an integer"; }
        sc_count = sc_n ?? 0;
        if sc_count < 0 || sc_count > SCRIPT_MAX_REPEAT {
            return "hold: <frames> must be 0..{SCRIPT_MAX_REPEAT}";
        }
        sc_p = script_phys_new();
        if !script_phys_action(run, sc_p, sc_a1) { return "unknown action '{sc_a1}'"; }
        for _ in 0..sc_count { script_frame(s, run, sc_p); }
        return "";
    }

    if sc_cmd == "step" {
        if sc_argc != 1 { return "step needs <frames>"; }
        sc_n = sc_a1 as integer?;
        if sc_n == null { return "step: <frames> must be an integer"; }
        sc_count = sc_n ?? 0;
        if sc_count < 0 || sc_count > SCRIPT_MAX_REPEAT {
            return "step: <frames> must be 0..{SCRIPT_MAX_REPEAT}";
        }
        for _ in 0..sc_count { script_idle(s, run); }
        return "";
    }

    // The one action that carries a value, so it gets its own
    // command rather than an optional argument on `do` — which
    // would make `hold palette 5` ambiguous about what the 5 is.
    if sc_cmd == "palette" {
        if sc_argc != 1 { return "palette needs <index>"; }
        sc_v = script_ints(tok, 1);
        if len(sc_v) != 1 { return "palette: <index> must be an integer"; }
        // Selection is a HOTKEY, so an entry with no hotkey is a
        // gesture no player can make.  It used to be accepted and
        // silently ignored by the seam's range check, which is a
        // script asserting nothing.
        sc_pal = action_for_palette(run.isrc.eis_actions, sc_v[0] ?? 0);
        if sc_pal == "" {
            return "palette: no hotkey selects entry {sc_v[0] ?? 0}";
        }
        sc_p = script_phys_new();
        script_press(sc_p, action_keys(run.isrc.eis_actions, sc_pal));
        script_frame(s, run, sc_p);
        script_idle(s, run);
        return "";
    }

    if sc_cmd == "hover" {
        if sc_argc != 2 { return "hover needs <q> <r>"; }
        sc_v = script_ints(tok, 2);
        if len(sc_v) != 2 { return "hover: <q> and <r> must be integers"; }
        run.hover_q = sc_v[0] ?? 0;
        run.hover_r = sc_v[1] ?? 0;
        script_idle(s, run);
        return "";
    }

    // Press and release at one hex.  Paints in ground mode, places
    // or removes a marker in marker mode — the script says what the
    // player did with the mouse and the mode decides what it means.
    //
    // The press frame carries a paint tick: the caller owns the
    // rate limit, and a script's clock is one tick per scripted
    // frame.
    if sc_cmd == "click" {
        if sc_argc != 2 { return "click needs <q> <r>"; }
        sc_v = script_ints(tok, 2);
        if len(sc_v) != 2 { return "click: <q> and <r> must be integers"; }
        run.hover_q = sc_v[0] ?? 0;
        run.hover_r = sc_v[1] ?? 0;
        sc_p = script_phys_new();
        sc_p.sp_mouse = true;
        sc_p.sp_paint = true;
        script_frame(s, run, sc_p);
        script_idle(s, run);
        return "";
    }

    // Press at the first hex, move to the second with the button
    // still down, release.  The seam joins consecutive paint ticks
    // with a hex line, so the hexes between the two ends are
    // painted too — this is the drag-paint path, and one drag is
    // one undoable action.
    if sc_cmd == "drag" {
        if sc_argc != 4 { return "drag needs <q1> <r1> <q2> <r2>"; }
        sc_v = script_ints(tok, 4);
        if len(sc_v) != 4 { return "drag: every argument must be an integer"; }
        run.hover_q = sc_v[0] ?? 0;
        run.hover_r = sc_v[1] ?? 0;
        sc_p = script_phys_new();
        sc_p.sp_mouse = true;
        sc_p.sp_paint = true;
        script_frame(s, run, sc_p);

        run.hover_q = sc_v[2] ?? 0;
        run.hover_r = sc_v[3] ?? 0;
        script_frame(s, run, sc_p);

        script_idle(s, run);
        return "";
    }

    // Photograph the frame.  Costs no `editor_step` call and
    // changes nothing: a script must play the same way whether or
    // not someone asked it for pictures.
    if sc_cmd == "snap" {
        if sc_argc != 1 { return "snap needs <name>"; }
        // A name is a file name, not a path — a `/` would put the
        // picture somewhere the harness never looks for it.
        if sc_a1.contains("/") || sc_a1.contains("\\") {
            return "snap: <name> is a file name, not a path: '{sc_a1}'";
        }
        mkdir_all(run.shots_dir);
        sc_png = "{run.shots_dir}/{sc_a1}.png";
        sc_cv  = render_editor_frame(s, VIEW_W, VIEW_H, VIEW_PPM);
        // `save_png` ANSWERS false on a write it could not do — an
        // absent directory above all.  Ignoring that answer is how
        // a run stays green over a picture that does not exist.
        if !sc_cv.save_png(sc_png) { return "snap: could not write {sc_png}"; }
        run.snaps += 1;
        println("script: snap {sc_a1} -> {sc_png} | {script_state_line(s)}");
        return "";
    }

    // Start a wave.  The core is the target marker — a wave has to
    // walk towards something, and the marker layer already says
    // where that is.
    if sc_cmd == "wave" {
        if sc_argc < 1 || sc_argc > 2 { return "wave needs <count> [class]"; }
        sc_n = sc_a1 as integer?;
        if sc_n == null { return "wave: <count> must be an integer"; }
        sc_count = sc_n ?? 0;
        if sc_count < 0 || sc_count > SCRIPT_MAX_REPEAT {
            return "wave: <count> must be 0..{SCRIPT_MAX_REPEAT}";
        }
        // The class is named, never numbered: a script that said
        // `wave 4 1` would be unreadable and would silently follow the
        // discriminants if they ever moved.  An unknown name is an
        // ERROR rather than a fallback to robot — a typo that spawns
        // the wrong class quietly turns a green run into a lie.
        sc_kind = ENEMY_KIND_REGULAR;
        if sc_argc == 2 {
            sc_kv = enemy_class_of(sc_a2);
            if sc_kv == null {
                return "wave: unknown class '{sc_a2}' — {enemy_class_names()}";
            }
            sc_kind = sc_kv ?? ENEMY_KIND_REGULAR;
        }
        sc_core = script_core(s.mw);
        if sc_core.0 == 0 {
            return "wave: no target marker — the core is where the target is";
        }
        if sc_core.0 > 1 {
            return "wave: {sc_core.0} target markers — a wave needs ONE core to walk towards";
        }
        sc_before = alive_count(run.play.wave);
        spawn_wave(run.play.wave, sc_count, sc_kind as u8? ?? 0, s.mw, sc_core.1, sc_core.2,
                   SCRIPT_SPAWN_DISABLE_RADIUS);
        sc_emitted = alive_count(run.play.wave) - sc_before;
        // A wave that asks for five and emits none is the confident
        // meaningless number this plan exists to stop: every later
        // `count alive 0 0` would pass for the wrong reason.
        if sc_emitted != sc_count {
            return "wave: asked for {sc_count}, emitted {sc_emitted} — is any spawn marker at least {SCRIPT_SPAWN_DISABLE_RADIUS} hexes from the core?";
        }
        println("script: wave {sc_count} {enemy_class_name(sc_kind as u8? ?? 0)} towards core ({sc_core.1}, {sc_core.2}) — {alive_count(run.play.wave)} alive");
        return "";
    }

    // Pile rubble onto a hex at runtime — what a body does when it
    // falls, and what a wall does when it breaks
    // (`docs/ENEMY_MOVEMENT.md` § Bodies are terrain).
    //
    // Plan 11 F6 builds the layer; combat is what will fill it.  Until
    // then this is how a scenario states the mechanic — *the kill zone
    // closes itself* — and it is the only way a `.keys` run can make
    // the height rule do something no palette entry could.
    //
    // ⚠ It lives on the WAVE, so it is gone when the wave is: a pile
    // is runtime state and never reaches a save file.
    //
    // The source is NAMED, never numbered, for the same reason `wave`'s
    // class is: a script saying `raise 3 0 2.5 2` would be unreadable
    // and would follow the discriminants silently if they ever moved.
    // It is optional and defaults to wreckage — dead machines are what
    // has piled up in every scenario written so far — and an unknown
    // name is an ERROR, because a pile that quietly became something
    // else is a scenario measuring a material it never asked for.
    if sc_cmd == "raise" {
        if sc_argc < 3 || sc_argc > 4 { return "raise needs <q> <r> <metres> [source]"; }
        sc_v = script_ints(tok, 2);
        if len(sc_v) != 2 { return "raise: <q> and <r> must be integers"; }
        sc_m = tok[3] as float?;
        if sc_m == null { return "raise: <metres> must be a number"; }
        sc_src = RUBBLE_WRECKAGE;
        if sc_argc == 4 {
            sc_sname = tok[4] ?? "";
            if sc_sname == "carapace" { sc_src = RUBBLE_CARAPACE; }
            else if sc_sname == "masonry" { sc_src = RUBBLE_MASONRY; }
            else if sc_sname != "wreckage" {
                return "raise: unknown source '{sc_sname}' — wreckage, carapace, masonry";
            }
        }
        sc_rq = sc_v[0] ?? 0;
        sc_rr = sc_v[1] ?? 0;
        height_raise(run.play.wave.heights, sc_rq, sc_rr, sc_m ?? 0.0, sc_src as u8? ?? 0);
        println("script: raise ({sc_rq}, {sc_rr}) by {sc_m ?? 0.0:4.2} m of {rubble_source_name(sc_src as u8? ?? 0)} — now {height_rise(run.play.wave.heights, sc_rq, sc_rr):4.2} m of pile");
        return "";
    }

    // Land damage on the structure at a hex, without waiting for a
    // siege to do it.
    //
    // ⚠ **What it buys is a SHORT scenario.**  100 HP at 1 HP/s is 150
    // ticks for one robot, and a `.keys` run that spends 150 ticks
    // proving arithmetic measures the arithmetic, not the break.  So a
    // scenario ticks far enough to watch the HP fall at the right
    // rate, softens the wall with one line, and then lets the siege
    // land the last of it — every step of the real path, none of the
    // waiting.
    //
    // It goes through the same `damage_apply` the tick does, and the
    // break is still `damage_resolve`'s at the end of a tick: this
    // verb cannot break a wall on its own, which is what keeps it from
    // becoming a second, shorter code path (plan 12 B2).
    if sc_cmd == "damage" {
        if sc_argc != 3 { return "damage needs <q> <r> <hp>"; }
        sc_dv = script_ints(tok, 2);
        if len(sc_dv) != 2 { return "damage: <q> and <r> must be integers"; }
        sc_dhp = tok[3] as float?;
        if sc_dhp == null { return "damage: <hp> must be a number"; }
        sc_dq = sc_dv[0] ?? 0;
        sc_dr = sc_dv[1] ?? 0;
        // A hex with nothing breakable on it must FAIL rather than
        // record a hit nothing can ever resolve — a script that
        // damaged the wrong coordinate and then asserted the wall
        // still stands would be green for the wrong reason.
        if !structure_breakable(s.picker.palette, s.pw, sc_dq, sc_dr) {
            return "damage: ({sc_dq}, {sc_dr}) is '{painted_kind_name(s.picker.palette, s.pw, sc_dq, sc_dr)}', which nothing can break";
        }
        damage_apply(run.play.wave.damage, sc_dq, sc_dr, sc_dhp ?? 0.0);
        println("script: damage ({sc_dq}, {sc_dr}) by {sc_dhp ?? 0.0:6.2} HP — {structure_hp(s.picker.palette, s.pw, run.play.wave.damage, sc_dq, sc_dr):6.2} HP left");
        return "";
    }

    // Land damage on one ENEMY, by roster index.
    //
    // A separate verb from `damage`, not an overload of it: `damage`
    // takes a hex and this takes an index, and `damage 4 10` reading
    // as either would be a line whose meaning depends on knowing which.
    // It also keeps the `.keys` converter simple — `hit` carries no
    // coordinate, so it needs no schema row in `convert.loft`.
    //
    // ⚠ **It cannot KILL.**  Death is the tick's (`wave_deaths`), for
    // the same reason `damage` cannot break a wall: one death path, so
    // the tower B5 builds and the `hit` a script types cannot drift
    // apart.  A script that hits an enemy for its whole HP and then
    // asserts `count alive` without a `tick` between is asserting that
    // — plan 12 B4.
    // ─── Authoring one enemy (plan 18 S1a) ──────────────────────
    //
    // `wave <n>` puts a whole wave on the markers and is how a scenario
    // starts a fight.  These three put ONE enemy in a stated condition,
    // which is what a captured fixture needs: `plans/18` § So the real
    // work is making `.keys` TOTAL over the state.
    //
    // ⚠ **A separate verb rather than an overload of `enemy`**, which is
    // an ASSERTION (`enemy <i> <q> <r>`).  Plan 12 B4 set the rule when
    // it refused to overload `damage` for enemies: a line whose meaning
    // depends on knowing which reading applies is a line nobody can
    // check by looking at it.
    //
    // ⚠ **They AUTHOR and never simulate**, the rule `damage <q> <r>
    // <hp>` already keeps — it fills the ledger and *"cannot BREAK
    // anything, only a tick does, so it stays one code path"*.  So
    // `dead` marks an enemy down and deposits NO body: a captured state
    // carries the body as its own `raise` line, and `wave_deaths` stays
    // the one death path in the engine.
    if sc_cmd == "place" {
        if sc_argc < 3 || sc_argc > 4 {
            return "place needs <q> <r> <class> [heading]";
        }
        sc_pv2 = script_ints(tok, 2);
        if len(sc_pv2) != 2 { return "place: <q> and <r> must be integers"; }

        // The class is NAMED, never numbered — `wave`'s rule, and an
        // unknown name is an error rather than a quiet fallback to
        // robot.
        sc_pcls = tok[3] ?? "";
        sc_pkv = enemy_class_of(sc_pcls);
        if sc_pkv == null {
            return "place: unknown class '{sc_pcls}' — {enemy_class_names()}";
        }
        sc_pk = sc_pkv ?? ENEMY_KIND_REGULAR;

        sc_phd = 0;
        if sc_argc == 4 {
            sc_phv = (tok[4] ?? "") as integer?;
            if sc_phv == null { return "place: <heading> must be an integer"; }
            sc_phd = sc_phv ?? 0;
            if sc_phd < 0 || sc_phd >= NUM_HEX_DIRECTIONS {
                return "place: <heading> must be 0..{NUM_HEX_DIRECTIONS - 1}";
            }
        }

        // ⚠ **Healthy, and walking.**  `taken` and `stand` are left at
        // their zero, which is the neutral value for both (plan 12 B4,
        // plan 16 W2) — so a bare `place` is a robot that is whole and
        // free to move, and anything else has to be SAID.
        run.play.wave.enemies += [Enemy { q: sc_pv2[0] ?? 0, r: sc_pv2[1] ?? 0,
                                     kind: sc_pk as u8? ?? 0,
                                     heading: sc_phd as u8? ?? 0,
                                     alive: true, taken: 0.0,
                                     stand: timer_new(), bank: bank_new() }];
        println("script: place {enemy_class_name(sc_pk as u8? ?? 0)} at ({sc_pv2[0] ?? 0}, {sc_pv2[1] ?? 0}) heading {sc_phd} — {len(run.play.wave.enemies)} in the roster");
        return "";
    }

    // Seconds still to stand at the marker — plan 16 W2's window.
    if sc_cmd == "stand" {
        if sc_argc != 2 { return "stand needs <i> <seconds>"; }
        sc_si2 = sc_a1 as integer?;
        if sc_si2 == null { return "stand: <i> must be an integer"; }
        sc_ssec = (tok[2] ?? "") as float?;
        if sc_ssec == null { return "stand: <seconds> must be a number"; }
        sc_sidx = sc_si2 ?? 0;
        if sc_sidx < 0 || sc_sidx >= len(run.play.wave.enemies) {
            return "stand: no enemy {sc_sidx} — the roster holds {len(run.play.wave.enemies)}";
        }
        timer_arm((run.play.wave.enemies[sc_sidx] ?? Enemy { }).stand,
                  clock_units_from_seconds(sc_ssec ?? 0.0));
        return "";
    }

    // Whole hexes an enemy has banked but not yet spent — the
    // `progress` field `enemy_bank` carries (plan 23 K2a), authorable
    // since K2b.
    //
    // ⚠ **It is `stand`'s sibling and not `place`'s argument**, for the
    // reason `place`'s own header gives: `progress` is ZERO-neutral, so
    // a bare `place` is an enemy that has banked nothing, and a field
    // that has a neutral value gets a verb of its own rather than a
    // positional slot nobody fills.
    //
    // ⚠ **This is the line plan 23 K2a predicted would be needed and
    // deliberately did not write.**  At 1.5 hex/s the carry is exactly
    // 0.0 after every tick, so no captured scenario could hold a
    // remainder and `state_diff` learned the field as a TRIPWIRE.  K2b
    // shipped two classes whose carry is not zero, `18_s2`'s round trip
    // went red on `enemies[0].progress` within one suite run, and the
    // answer was to make the emitter total rather than to loosen the
    // comparison.
    if sc_cmd == "banked" {
        if sc_argc != 2 { return "banked needs <i> <hexes>"; }
        sc_bi = sc_a1 as integer?;
        if sc_bi == null { return "banked: <i> must be an integer"; }
        sc_bhx = (tok[2] ?? "") as float?;
        if sc_bhx == null { return "banked: <hexes> must be a number"; }
        sc_bidx = sc_bi ?? 0;
        if sc_bidx < 0 || sc_bidx >= len(run.play.wave.enemies) {
            return "banked: no enemy {sc_bidx} — the roster holds {len(run.play.wave.enemies)}";
        }
        bank_restore_fraction((run.play.wave.enemies[sc_bidx] ?? Enemy { }).bank,
                              sc_bhx, BANK_WHOLE);
        return "";
    }

    // Mark an enemy down.  ⚠ It deposits NO body — see the note above.
    if sc_cmd == "dead" {
        if sc_argc != 1 { return "dead needs <i>"; }
        sc_di = sc_a1 as integer?;
        if sc_di == null { return "dead: <i> must be an integer"; }
        sc_didx = sc_di ?? 0;
        if sc_didx < 0 || sc_didx >= len(run.play.wave.enemies) {
            return "dead: no enemy {sc_didx} — the roster holds {len(run.play.wave.enemies)}";
        }
        (run.play.wave.enemies[sc_didx] ?? Enemy { }).alive = false;
        return "";
    }

    if sc_cmd == "hit" {
        if sc_argc != 2 { return "hit needs <i> <hp>"; }
        sc_hi = sc_a1 as integer?;
        if sc_hi == null { return "hit: <i> must be an integer"; }
        sc_hhp = tok[2] as float?;
        if sc_hhp == null { return "hit: <hp> must be a number"; }
        sc_hidx = sc_hi ?? 0;
        // An index past the roster is an ERROR rather than a no-op: a
        // script that hit nobody and then asserted the wave was still
        // alive would be green for the wrong reason.
        if sc_hidx < 0 || sc_hidx >= len(run.play.wave.enemies) {
            return "hit: no enemy {sc_hidx} — the roster holds {len(run.play.wave.enemies)}";
        }
        sc_he = run.play.wave.enemies[sc_hidx] ?? Enemy {};
        enemy_hurt(sc_he, sc_hhp ?? 0.0);
        println("script: hit {sc_hidx} for {sc_hhp ?? 0.0:6.2} HP — {enemy_hp(sc_he):6.2} HP left, alive={sc_he.alive}");
        return "";
    }

    // Take a pile away, leaving the hex exactly as the map paints it.
    //
    // The player's counter-play (`ENEMY_MOVEMENT.md` § Bodies are
    // terrain: *"collecting bodies is what stops the ramp"*), and the
    // only way a `.keys` run can state the layer's defining property —
    // that clearing rubble RESTORES the authored ground, because the
    // ground was never overwritten.  Plan 12 B1.
    if sc_cmd == "clear" {
        if sc_argc != 2 { return "clear needs <q> <r>"; }
        sc_cv2 = script_ints(tok, 2);
        if len(sc_cv2) != 2 { return "clear: <q> and <r> must be integers"; }
        sc_cq = sc_cv2[0] ?? 0;
        sc_cr = sc_cv2[1] ?? 0;
        height_clear(run.play.wave.heights, sc_cq, sc_cr);
        println("script: clear ({sc_cq}, {sc_cr}) — {height_count(run.play.wave.heights)} piles left");
        return "";
    }

    // Advance the wave.  A game-tick, not a frame: `step` moves the
    // editor on, `tick` moves the enemies.
    //
    // The wave is ticked against the session's OWN world, so an enemy
    // stops at ground its class cannot cross (plan 11 F1b) — which
    // also means a `tick` over an unpainted map moves nobody, because
    // an unpainted hex is sea.  A scenario that walks enemies has to
    // paint the ground they walk on.
    // Put the player on a hex, and point it at one.  Plan 13 V1.
    //
    // ⚠ Two verbs and not one: parking is instantaneous authoring and
    // driving is a thing the TICK does.  `park 4 0` then `drive 0 0`
    // reads as a setup line and an instruction, which is what they
    // are — and a single verb would have made "where the player is"
    // and "where the player is going" the same statement.
    if sc_cmd == "park" || sc_cmd == "drive" {
        if sc_argc != 2 { return "{sc_cmd} needs <q> <r>"; }
        sc_pv = script_ints(tok, 2);
        if len(sc_pv) != 2 { return "{sc_cmd}: <q> and <r> must be integers"; }
        sc_pq = sc_pv[0] ?? 0;
        sc_pr = sc_pv[1] ?? 0;
        if sc_cmd == "park" {
            vehicle_place(run.play.wave.player, sc_pq, sc_pr);
            return "";
        }
        if !vehicle_present(run.play.wave.player) {
            return "drive: no vehicle — `park <q> <r>` puts one in the world first";
        }
        vehicle_drive(run.play.wave.player, sc_pq, sc_pr);
        return "";
    }

    // Start a boost.  Plan 13 V4.
    //
    // ⚠ **Stricter than the key it stands for.**  A player holding
    // Shift on cooldown gets nothing and thinks no more about it; a
    // script that says `boost` is CLAIMING one starts, and a claim
    // that quietly did not happen would leave every assertion after it
    // measuring an unboosted run.  Same argument `hp` makes for
    // refusing a hex with nothing breakable on it.
    if sc_cmd == "boost" {
        if sc_argc != 0 { return "boost takes no arguments"; }
        if !vehicle_present(run.play.wave.player) {
            return "boost: no vehicle — `park <q> <r>` puts one in the world first";
        }
        if !vehicle_boost(run.play.wave.player) {
            return "boost: the vehicle is not ready — {clock_seconds_from_units(timer_left(run.play.wave.player.cool)):4.2} s of cooldown left, boosting = {vehicle_boosting(run.play.wave.player)}";
        }
        return "";
    }

    // Add a helper, and point one somewhere.  Plan 14 H1.
    if sc_cmd == "crew" {
        if sc_argc != 2 { return "crew needs <q> <r>"; }
        sc_crw = script_ints(tok, 2);
        if len(sc_crw) != 2 { return "crew: <q> and <r> must be integers"; }
        if len(run.play.wave.crew) >= HELPER_ROSTER_CAP {
            return "crew: a base holds {HELPER_ROSTER_CAP} helpers and already has {len(run.play.wave.crew)}";
        }
        run.play.wave.crew += [helper_new(sc_crw[0] ?? 0, sc_crw[1] ?? 0)];
        return "";
    }

    if sc_cmd == "send" {
        if sc_argc != 3 { return "send needs <i> <q> <r>"; }
        sc_sv = script_ints(tok, 3);
        if len(sc_sv) != 3 { return "send: <i>, <q> and <r> must be integers"; }
        sc_si = sc_sv[0] ?? 0;
        if sc_si < 0 || sc_si >= len(run.play.wave.crew) {
            return "send: no helper {sc_si} — the crew is {len(run.play.wave.crew)} strong";
        }
        helper_drive(run.play.wave.crew[sc_si] ?? Helper { }, sc_sv[1] ?? 0, sc_sv[2] ?? 0);
        return "";
    }

    // Author the run's wave list.  Plan 16 W1, armed rather than
    // started since W3.
    //
    // ⚠ **`schedule 5 8` is not `wave 5` twice.**  `wave` puts enemies
    // on the ground now and the script says when; this hands the run a
    // LIST and the simulation decides when — the next wave goes out
    // once the previous one is dead and the lull has run.  A scenario
    // using this has no line saying when wave 2 arrives, which is the
    // whole point of gating it.
    //
    // ⚠ **It AUTHORS and does not start** (plan 16 W3): the design
    // gives wave 1 a trigger and the trigger is a POSITION, so a script
    // starts its own list by driving onto a spawn marker at least
    // `WAVE_1_PROVOCATION_HEXES` from the core, exactly as a player
    // does.  A verb that also started it would be the one shortcut that
    // let every scenario in the gate skip the rule.
    //
    // ⚠ So a list with nobody to poke it never plays, and the println
    // is what stops that reading as a broken schedule — a `waves 0 0`
    // three lines later says the same thing as an assertion.
    if sc_cmd == "schedule" {
        if sc_argc < 1 { return "schedule needs at least one <count>"; }
        sc_sched = script_ints(tok, sc_argc);
        if len(sc_sched) != sc_argc {
            return "schedule: every <count> must be an integer";
        }
        for sc_sc in sc_sched {
            if sc_sc < 0 || sc_sc > SCRIPT_MAX_REPEAT {
                return "schedule: each <count> must be 0..{SCRIPT_MAX_REPEAT}, got {sc_sc}";
            }
        }
        run.play.wave.schedule = wave_schedule_of(sc_sched, INTER_WAVE_DELAY_SECONDS);
        println("script: {len(sc_sched)} waves armed — a spawn marker {WAVE_1_PROVOCATION_HEXES}+ hexes out has to be driven onto before wave 1 goes");
        return "";
    }

    // Say what ONE wave of the armed list is made of.  Plan 23 K1.
    //
    // ⚠ **`schedule` arms and `compose` fills**, two verbs for what
    // could have been one grammar, and the reason is the same one
    // `script_author` gives for seven command words rather than one
    // `set`: `schedule 12 12` already means *two waves of twelve*, and
    // a form that also took class names inside it could not tell a wave
    // boundary from a group boundary.  Every scenario written before
    // this phase keeps its meaning untouched, which is what K1's
    // identity gate needs.
    //
    // ⚠ **It REPLACES the wave**, so `compose 0 4 miner` after
    // `schedule 12` is a wave of FOUR, not sixteen.  There is no stored
    // total to disagree with the parts (`waves.loft` § A wave is
    // PARTS) — the size a scenario measures is the sum of what it said.
    //
    // ⚠ The class is NAMED and an unknown one is an ERROR, per `wave`:
    // a typo that silently spawns regulars turns a composition
    // measurement into a restatement of the baseline.
    // ⚠⚠ **The parsing is in `compose_fault` / `compose_parts` and NOT
    // here, and the suite is what says it has to be.**  The first draft
    // built its `vector<WavePart>` inline in this function and aborted
    // the interpreter — `realloc(): invalid next size`, deterministic,
    // in `tests/12_b1_rubble.loft`, a file that never says `compose`
    // and never reaches this branch.  Bisected at full-suite scale:
    // every other file of plan 23 K1 together is 1107 green, and adding
    // this branch alone is the crash.  `script_step` is ~700 lines and
    // that appears to be the ingredient — the corruption is written
    // where the code is COMPILED and detected wherever the allocator
    // next touches it, which is why moving the locals into small
    // functions of their own fixes it.  `QUESTIONS_FOR_LOFT.md` § A
    // `vector<Struct>` local in a very large function.
    //
    // ⚠ So the rule this leaves behind is not about `compose`: **do not
    // add a `vector<Struct>` local to `script_step`** — give it a
    // helper.  A green suite cannot see the violation.
    if sc_cmd == "compose" {
        sc_cfault = compose_fault(tok);
        if sc_cfault != "" { return sc_cfault; }
        sc_cw = compose_wave(tok);
        if !script_compose(run.play.wave.schedule, tok, sc_cw) {
            return "compose: no wave {sc_cw} — the list is {wave_schedule_count(run.play.wave.schedule)} long; `schedule` arms it first";
        }
        println("script: wave {sc_cw} is {wave_schedule_size(run.play.wave.schedule, sc_cw)} robots");
        return "";
    }

    // Pick something up, and put it down.  Plan 15 C2.
    //
    // ⚠ **Two verbs for `DESIGN.md` § 11's ONE key**, and that is the
    // same choice `park` / `drive` made: the key is context-resolved on
    // the carrier's state (empty hands = pickup, carrying = deposit),
    // and a script SAYS what it means so that a line asserting a pickup
    // cannot quietly have been a deposit.  What a script must NOT get
    // to decide is where the cargo ends up — that is the destination's
    // to answer, and `drop` at the core retrieves where `drop` one hex
    // out merely puts down.
    //
    // ⚠ Both are stricter than the key, per `boost`: a script that says
    // `take player` is CLAIMING one happens, and a pickup that quietly
    // found nothing would leave every assertion after it measuring an
    // empty-handed run.
    if sc_cmd == "take" || sc_cmd == "drop" {
        if sc_argc != 1 { return "{sc_cmd} needs <who> — `player` or a crew index"; }

        sc_who = CARGO_NONE;
        if sc_a1 == "player" {
            sc_who = BLOCKER_PLAYER;
        } else {
            sc_wi = sc_a1 as integer?;
            if sc_wi == null {
                return "{sc_cmd}: <who> is `player` or a crew index, not '{sc_a1}'";
            }
            sc_wn = sc_wi ?? 0;
            if sc_wn < 0 || sc_wn >= len(run.play.wave.crew) {
                return "{sc_cmd}: no helper {sc_wn} — the crew is {len(run.play.wave.crew)} strong";
            }
            sc_who = BLOCKER_CREW + sc_wn;
        }

        if !wave_carrier_ready(run.play.wave, sc_who) {
            return "{sc_cmd}: {sc_a1} cannot carry — no vehicle in the world, or a wreck";
        }

        if sc_cmd == "take" {
            if wave_take(run.play.wave, sc_who, s.mw) == CARGO_NONE {
                return "take: {sc_a1} picked nothing up — hands full, or nothing within {CARGO_REACH_HEXES} hex";
            }
            return "";
        }

        // ⚠ A drop needs the core, because the core is what makes it a
        // DELIVERY — so `drop` demands the same one target marker a
        // `tick` does, rather than silently treating "no core" as "no
        // destination anywhere" and putting a rescued crew member down
        // on the floor.
        sc_dcore = script_core(s.mw);
        if sc_dcore.0 != 1 {
            return "drop: needs exactly ONE target marker to deliver to, found {sc_dcore.0}";
        }
        if wave_drop(run.play.wave, sc_who,
                     Hex { q: sc_dcore.1, r: sc_dcore.2 },
                     s.mw) == CARGO_NONE {
            return "drop: {sc_a1} is not carrying anything";
        }
        return "";
    }

    if sc_cmd == "tick" {
        if sc_argc != 1 { return "tick needs <ticks>"; }
        sc_n = sc_a1 as integer?;
        if sc_n == null { return "tick: <ticks> must be an integer"; }
        sc_count = sc_n ?? 0;
        if sc_count < 0 || sc_count > SCRIPT_MAX_REPEAT {
            return "tick: <ticks> must be 0..{SCRIPT_MAX_REPEAT}";
        }
        // The wave walks towards the core, so a tick needs to know
        // where that is — the same ONE target marker `wave` demanded.
        sc_tcore = script_core(s.mw);
        if sc_tcore.0 != 1 {
            return "tick: needs exactly ONE target marker to walk towards, found {sc_tcore.0}";
        }
        // ⚠ **A COUNT through the count door** (plan 19 P1), never
        // `sc_count * TICK_SECONDS` through `play_advance`: that is
        // wrong for 602 of the first 1000 counts, and it fails in the
        // direction nothing notices — one tick SHORT, at the end, on a
        // scenario that then reads a wave as never sent.
        //
        // ⚠ And not `play_step` either: a `tick` has no keypress in it,
        // so the frame door would fabricate a neutral input, which
        // `editor_step` reads as *the player let go* — committing an
        // in-flight paint stroke and resetting the edge history.
        play_ticks(run.play, s, sc_count);
        return "";
    }

    // Play until the base FALLS — the wallet at zero — and stop.
    // Plan 12 B7, and the phase's whole deliverable: a base that
    // falls in 40 s and one that falls in 400 s are the difference
    // between "damage exists" and "defences work".
    //
    // ⚠ **Not falling within `<max>` is an ERROR, not a quiet stop.**
    // A scenario called "an undefended base" that runs out of ticks
    // still standing has measured nothing, whatever it drew — and it
    // is exactly the failure a later `ticks` band would report as a
    // number one hex outside its range rather than as the premise
    // collapsing.  So the run ends here, naming what was left.
    //
    // ⚠ It ticks nothing at all if the base has ALREADY fallen, so a
    // second `fall` is a no-op rather than a `<max>`-tick wait.
    if sc_cmd == "fall" {
        if sc_argc != 1 { return "fall needs <max ticks>"; }
        sc_fmax = sc_a1 as integer?;
        if sc_fmax == null { return "fall: <max ticks> must be an integer"; }
        sc_flim = sc_fmax ?? 0;
        if sc_flim < 1 || sc_flim > SCRIPT_MAX_REPEAT {
            return "fall: <max ticks> must be 1..{SCRIPT_MAX_REPEAT}";
        }
        sc_fcore = script_core(s.mw);
        if sc_fcore.0 != 1 {
            return "fall: needs exactly ONE target marker to walk towards, found {sc_fcore.0}";
        }
        // One tick at a time, because the stop condition is read
        // BETWEEN ticks — but through the same door `tick` uses, so a
        // base that falls and a base that is ticked to the same place
        // cannot diverge.
        sc_fspent = 0;
        while sc_fspent < sc_flim && !wallet_broke(run.play.wave.wallet) {
            play_ticks(run.play, s, 1);
            sc_fspent += 1;
        }
        if !wallet_broke(run.play.wave.wallet) {
            return "fall: the base was still standing after {sc_flim} ticks — {wallet_left(run.play.wave.wallet):8.6} points left, {alive_count(run.play.wave)} enemies alive";
        }
        println("script: the base fell after {run.play.ticks} ticks ({(run.play.ticks as float) * TICK_SECONDS:8.6} s), {alive_count(run.play.wave)} enemies alive");
        return "";
    }

    // The measurements ask the session questions rather than
    // changing it, so they live in their own dispatcher.
    if sc_cmd == "count" || sc_cmd == "kind" || sc_cmd == "marker"
    || sc_cmd == "frame" || sc_cmd == "range"
    || sc_cmd == "enemy" || sc_cmd == "enemies" || sc_cmd == "target"
    || sc_cmd == "hp" || sc_cmd == "pile" || sc_cmd == "wallet"
    || sc_cmd == "ticks" || sc_cmd == "vehicle" || sc_cmd == "hull"
    || sc_cmd == "helper" || sc_cmd == "cargo" || sc_cmd == "roster"
    || sc_cmd == "waves" || sc_cmd == "shots" || sc_cmd == "top" {
        return script_measure(s, run, tok);
    }

    "unknown command '{sc_cmd}'"
}

// ─── The runner ─────────────────────────────────────────────────

// Run a script against an editor session.  Stops at the first
// failure and reports which line it was — a run that kept going
// past an error would report a state nobody asked for.
//
// Comments are whole-line only (`# …`); a `#` after a command is
// part of the command, which keeps `echo` able to say anything.
//
// `shots_dir` is where `snap` writes; the default is the one a
// validation run wants, and a test overrides it to land its
// pictures where the suite already cleans up.
pub fn script_run(s: EditorState, source: text, shots_dir: text = SHOTS_DIR) -> ScriptRun {
    script_run_on(s, script_run_new(shots_dir), source)
}

// Play a script on a run the CALLER prepared.
//
// The reason this is reachable rather than private: `ScriptRun`
// carries the key table (`isrc`), so a caller that wants REMAPPED
// keys builds a run, rebinds it, and plays the script on it.  A
// script that lands on the same `EditorState` under a keyboard with
// every key moved is what proves the indirection is real rather
// than decorative — and that gate cannot be written if the runner
// insists on building its own keyboard.
pub fn script_run_on(s: EditorState, run: ScriptRun, source: text) -> ScriptRun {
    sr_no  = 0;
    for sr_line in source.split('\n') {
        sr_no += 1;
        // Tabs count as spaces, and `trim` takes the \r off a
        // CRLF-authored file.
        sr_t = sr_line.replace("\t", " ").trim();
        if sr_t == "" { continue; }
        if sr_t.starts_with_at(0, "#") { continue; }

        sr_tok: vector<text> = [];
        for sr_p in sr_t.split(' ') {
            if sr_p != "" { sr_tok += [sr_p]; }
        }

        // Everything after the command word, verbatim — `echo`'s
        // argument, where collapsing the spaces would change what
        // the transcript says.
        sr_rest = "";
        sr_sp = sr_t.find(" ");
        if sr_sp != null {
            sr_rest = sr_t[(sr_sp ?? 0) + 1..sr_t.size()].trim();
        }

        sr_err = script_command(s, run, sr_tok, sr_rest);
        if sr_err != "" {
            run.ok      = false;
            run.line    = sr_no;
            run.message = sr_err;
            return run;
        }
        run.commands += 1;
    }
    run
}

// Run a script from a file.  An absent file is a failure, not an
// empty run: a validation gate that silently passes because it
// could not find its script is the exact shape of lie this plan
// exists to catch.
pub fn script_run_file(s: EditorState, path: text, shots_dir: text = SHOTS_DIR) -> ScriptRun {
    if !file(path).exists() {
        srf_run = script_run_new(shots_dir);
        srf_run.ok      = false;
        srf_run.message = "script file not found: {path}";
        return srf_run;
    }
    // `content()` is UTF-8-only and answers "" on a binary file;
    // an empty script then runs zero commands, which `ok` reports
    // honestly as a run that did nothing.
    script_run(s, file(path).content() ?? "", shots_dir)
}

//
// MarkerFile — the on-disk JSON shape for the marker sidecar.
//
// Stored ALONGSIDE the main save (`map_file.loft`), in a separate
// file, NOT folded into MapFile.  Reasons:
//   1. Avoids re-tripping the loft JSON-cast 8-field threshold
//      (see QUESTIONS_FOR_LOFT.md § "text as Struct" HANGS — the
//      MapFile cap is 6 fields today).
//   2. Decouples bulk runtime data (markers will grow) from the
//      painted-layer save — independent file lifecycles, simpler
//      schema evolution per layer.
//   3. Mirrors how plan 04 § L1 will eventually structure the
//      multi-layer save (one sidecar per data layer).
//
// Three top-level fields here — safely below any known cast
// threshold.
//
// On-disk MarkerSaveEntry mirrors in-memory MarkerEntry exactly,
// u8 fields included, so the save path is a copy rather than a
// widen-on-write / narrow-on-read pair.
//
// It was widened to `integer` for a while: loft's `:j` used to
// zero u8 fields when the vector was embedded in a wrapping
// struct (the standalone-vector case always worked).  That is
// fixed — QUESTIONS_FOR_LOFT.md § Resolved, verified 2026-08-12 —
// and `tests/03_m1_markers.loft` now carries the regression that
// the deleted reproducer used to.
//
// ⚠ The narrowing is deliberately NOT a format change: u8 and
// integer both serialise as a bare JSON number, so `{"kind":1,
// "direction":5}` is byte-identical either way and sidecars
// written by the widened shape load unchanged.  Checked, not
// assumed.
//
// Plan 03 phase M1.

use markers;

// On-disk shape for one marker — the same shape MarkerEntry has
// in memory.  Maps to/from it in save.loft (marker_world_to_file
// / markerfile_to_world).
pub struct MarkerSaveEntry {
    q:         integer,
    r:         integer,
    kind:      u8,
    direction: u8,
}

// The marker sidecar record.  `markers` MUST be non-empty when
// this file exists on disk (see `save_markers` in save.loft —
// it skips the write when the world has no markers, so an empty
// vector never round-trips through `:j` / `text as MarkerFile`
// and the known empty-vector cast bugs can't bite).
pub struct MarkerFile {
    version: integer,
    name:    text,
    markers: vector<MarkerSaveEntry>,
}

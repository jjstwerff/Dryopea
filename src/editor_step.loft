//
// The editor's input seam — plan 08 phase V0.
//
// `src/main.loft` used to read the keyboard and mutate editor state
// in the same breath: `if gl_key_pressed(KEY_X) { ...do the thing... }`,
// ~25 times over.  That shape has two costs.  It cannot run without a
// GL window, so nothing can drive the editor headlessly; and main.loft
// sits outside the `dryopea.loft` aggregator, so `scripts/test.sh`
// never even parses the file that IS the game.
//
// This file is the seam that fixes both.  State lives in one
// `EditorState`; a frame's worth of player intent lives in one
// `EditorInput`; `editor_step` applies the second to the first and
// touches nothing else — no GL, no clock.  main.loft polls GL into an
// `EditorInput`, calls `editor_step`, and renders.  A test (and, from
// V1, a `.keys` script) builds the same `EditorInput` directly and
// gets the same state change, with no window open.
//
// ⚠ ONE table, two readers.  The key→action mapping must live HERE
// and be called by both the GL poll and the script runner.  Two
// copies that drift is how a script silently stops testing what the
// player actually does.
//
// ── What "pure" means here ──────────────────────────────────────
//
// No GL and no clock, ever: `editor_step` never reads the keyboard
// and never calls `ticks()`.  Rate limits belong to the caller — it
// passes a `*_tick` boolean saying an event is due — which is what
// makes a run reproducible frame by frame.
//
// Disk is touched by exactly two actions, save and reload, and only
// on the frame the player asks for them.  They are actions the
// editor genuinely has, so they live in the seam rather than being
// the two things a script cannot drive; `save_path` /
// `marker_save_path` on the state say where they go.
//
// ── Held keys are edge-detected HERE ────────────────────────────
//
// `EditorInput` carries what is held THIS frame, not what changed.
// Tab held for five frames toggles the mode ONCE — `editor_step`
// compares against `s.prev` (the previous frame's input) to find the
// rising edge.  Keeping that inside the seam is what makes a
// scripted `hold Tab 5` behave the way holding Tab behaves for a
// player.  If the caller resolved edges instead, the script and the
// editor would be two different machines.
//
// ⚠ `s.prev` is READ-ONLY for the whole of a step, and written once
// at the end.  It is the record of a frame that has already
// happened, so a mid-step write does not cancel an edge — it FORGES
// one for every branch below it, which is exactly what @D001 was.
// An action that wants to end a gesture sets the gesture's own state
// (`s.painting`), never the input history.
//
// ── Phase V0 — complete ─────────────────────────────────────────
//
// Every editor action is here: paint (V0a), then in groups (V0b)
// the tool state (mode toggle, rotation, place-kind, palette),
// the camera (pan / zoom / recentre), marker placement, the
// history (undo / redo / clear), and disk (save / reload).
// `src/main.loft` is now a GL shell that polls, steps and renders.
//
// Two rate limits stay with the caller — paint and pan — because
// honouring them here would mean reading a clock.  They arrive as
// `in_*_tick` booleans: the caller decides WHEN, this decides WHAT.

use lattice;
use painted;
use markers;
use camera;
use picker;
use history;
use chunks;
use editor_mode;
use save;
use gridmesh;

// ─── Input ──────────────────────────────────────────────────────

// One frame of player intent.  Every field here is honoured by
// `editor_step`; fields arrive together with the code that reads
// them, because an input field nothing consumes is a lie a script
// would happily tell.
//
// The hover hex is carried as (q, r), NOT as mouse pixels: pixel →
// hex is a camera-and-window concern that belongs on the polling
// side, and a script wants to say "click hex (3, -2)" without
// reasoning about a window that isn't open.
//
// Boolean fields are HELD state, not events — see § Held keys above.
pub struct EditorInput {
    in_hover_q: integer,
    in_hover_r: integer,

    // Left button state THIS frame.  Held across frames: its rising
    // edge places a marker, its falling edge ends a paint stroke.
    in_mouse_left: boolean,

    // Is a paint event due this frame?  The caller owns the rate
    // limit (main.loft debounces on `ticks()`; a script paints once
    // per scripted frame), which keeps `editor_step` free of the
    // clock and therefore reproducible.
    in_paint_tick: boolean,

    // ── Tool state (V0b group 1) ──
    in_toggle_mode: boolean,   // Tab — Ground ↔ Marker
    in_rotate:      boolean,   // R — turn the place-direction one step
    in_rotate_ccw:  boolean,   // …anticlockwise instead (Shift held)
    in_cycle_kind:  boolean,   // K — spawn ↔ target

    // ── Camera (V0b group 2) ──
    // Pan and zoom are rate-limited by the caller, like paint: a key
    // held down should walk the camera at a readable speed, not at
    // the frame rate.  A flag set here means "step the camera now".
    in_pan_north: boolean,
    in_pan_south: boolean,
    in_pan_east:  boolean,
    in_pan_west:  boolean,
    in_zoom_in:   boolean,
    in_zoom_out:  boolean,
    in_recentre:  boolean,     // H — camera back to the origin

    // ── History (V0b group 4) ──
    in_undo:      boolean,     // Ctrl+Z
    in_redo:      boolean,     // Ctrl+Y
    in_clear_all: boolean,     // Ctrl+N — empty both layers, recentre

    // ── Disk (V0b group 5) ──
    in_save:   boolean,        // Ctrl+S
    in_reload: boolean,        // Ctrl+R — re-read both layers from disk

    // Palette hotkey: is one down, and which entry does it select.
    // One index rather than twelve booleans — the player presses one
    // hotkey, and a script says `key 5`.
    //
    // ⚠ The pair exists so that NO action is the zero value of every
    // field.  A bare `EditorInput { … }` literal that omits a field
    // gets that field's default, so a neutral value of -1 would turn
    // every partially-built input into "select palette entry 0" —
    // which is sea, which erases.  Neutral must be the default, in
    // this struct more than anywhere: its whole job is to be built
    // by callers that do not know what was added to it last week.
    in_select_palette: boolean,
    in_palette_index:  integer,
}

pub fn editor_input_empty() -> EditorInput {
    EditorInput {
        in_hover_q:        0,
        in_hover_r:        0,
        in_mouse_left:     false,
        in_paint_tick:     false,
        in_toggle_mode:    false,
        in_rotate:         false,
        in_rotate_ccw:     false,
        in_cycle_kind:     false,
        in_select_palette: false,
        in_palette_index:  0,
        in_pan_north:      false,
        in_pan_south:      false,
        in_pan_east:       false,
        in_pan_west:       false,
        in_zoom_in:        false,
        in_zoom_out:       false,
        in_recentre:       false,
        in_undo:           false,
        in_redo:           false,
        in_clear_all:      false,
        in_save:           false,
        in_reload:         false,
    }
}

// A detached copy, so remembering a frame can't alias the caller's
// input record and mutate under us next frame.
fn input_copy(ic: const EditorInput) -> EditorInput {
    EditorInput {
        in_hover_q:        ic.in_hover_q,
        in_hover_r:        ic.in_hover_r,
        in_mouse_left:     ic.in_mouse_left,
        in_paint_tick:     ic.in_paint_tick,
        in_toggle_mode:    ic.in_toggle_mode,
        in_rotate:         ic.in_rotate,
        in_rotate_ccw:     ic.in_rotate_ccw,
        in_cycle_kind:     ic.in_cycle_kind,
        in_select_palette: ic.in_select_palette,
        in_palette_index:  ic.in_palette_index,
        in_pan_north:      ic.in_pan_north,
        in_pan_south:      ic.in_pan_south,
        in_pan_east:       ic.in_pan_east,
        in_pan_west:       ic.in_pan_west,
        in_zoom_in:        ic.in_zoom_in,
        in_zoom_out:       ic.in_zoom_out,
        in_recentre:       ic.in_recentre,
        in_undo:           ic.in_undo,
        in_redo:           ic.in_redo,
        in_clear_all:      ic.in_clear_all,
        in_save:           ic.in_save,
        in_reload:         ic.in_reload,
    }
}

// ─── State ──────────────────────────────────────────────────────

// Everything the editor mutates while a session is open, in one
// place.  main.loft holds exactly one of these and, once V0b lands
// in full, nothing else.
//
// Not a save format — `map_file.loft` / `marker_file.loft` own what
// reaches disk.  This is session state, so it also carries the
// derived + transient bits (chunk dirty set, in-flight stroke,
// re-render flag, last frame's input) that a save deliberately drops.
pub struct EditorState {
    // ── World layers (what a save round-trips) ──
    pw:  PaintedWorld,
    mw:  MarkerWorld,
    cam: EditorCamera,

    // ── Tool state ──
    picker:          Picker,
    mode:            integer,   // MODE_GROUND | MODE_MARKER
    place_direction: u8,        // rotation for the NEXT spawn placement, 0..5
    place_kind:      integer,   // MARKER_KIND_SPAWN | MARKER_KIND_TARGET

    // ── Undo / redo ──
    history: History,
    // Deltas accumulated while the button is held.  A whole drag is
    // ONE undoable action, so the stroke is pushed onto `history`
    // when the button comes up, not per painted hex.
    stroke:  UndoEntry,

    // ── Stroke continuation ──
    // A paint tick fires at most every PAINT_DEBOUNCE_US, and the
    // mouse can cross several hexes in between, so consecutive ticks
    // are joined with a hex line.  `painting` says whether the
    // previous tick belongs to the same stroke — without it, a
    // release-then-quick-repress would bridge two separate strokes.
    painting:       boolean,
    last_paint_hex: Hex,

    // Last frame's input, for rising-edge detection.  An action that
    // must fire once per press compares against this rather than
    // trusting the caller to have resolved the edge.
    prev: EditorInput,

    // ── Where this session saves ──
    // Empty means "not attached to a file": save and reload both
    // refuse rather than writing somewhere arbitrary, or — worse for
    // reload — reading an absent file and wiping the world with the
    // empty one that comes back.  `editor_state_new` leaves them
    // empty on purpose; `editor_state_attach` is how a session says
    // where it lives.
    save_path:        text,
    marker_save_path: text,

    // ── Render / save bookkeeping ──
    cf:            ChunkField,   // gridmesh dirty set — which chunks to rebuild
    dirty:         boolean,      // in-memory state differs from disk (HUD indicator)
    render_needed: boolean,      // view changed (camera / hover / mode / picker)
}

// ─── Factories ──────────────────────────────────────────────────

// Adopt already-loaded world layers — the editor-open path, where
// `pw` / `mw` / `cam` come off disk.
pub fn editor_state_from(
    pw:     PaintedWorld,
    mw:     MarkerWorld,
    cam:    EditorCamera,
    picker: Picker,
) -> EditorState {
    EditorState {
        pw:              pw,
        mw:              mw,
        cam:             cam,
        picker:          picker,
        mode:            MODE_GROUND,
        place_direction: 0 as u8,
        place_kind:      MARKER_KIND_SPAWN,
        history:         history_empty(),
        stroke:          undo_entry_empty(),
        painting:        false,
        last_paint_hex:  Hex { q: 0, r: 0 },
        prev:            editor_input_empty(),
        save_path:        "",
        marker_save_path: "",
        cf:              chunks_from_painted(pw),
        dirty:           false,
        // Force the first frame: nothing is on screen yet.
        render_needed:   true,
    }
}

// A fresh editor on an empty (all-sea) world.
pub fn editor_state_new(palette_path: text) -> EditorState {
    editor_state_from(
        painted_empty(),
        marker_empty(),
        camera_default(),
        picker_default(palette_path),
    )
}

// Attach a session to the files it saves to and reloads from.
// Until this is called, save and reload are refused — see the
// `save_path` field.
pub fn editor_state_attach(s: EditorState, save_path: text, marker_save_path: text) {
    s.save_path        = save_path;
    s.marker_save_path = marker_save_path;
}

// ─── The step ───────────────────────────────────────────────────

// Apply one frame of input to the editor state.
//
// An input with no action set must leave the state untouched; the
// no-op frame is a test, not a comment.
//
// Action order matches the order the player's keys were read in
// before the seam existed, so a frame that sets several at once
// resolves the same way it always did.
pub fn editor_step(s: EditorState, input: EditorInput) {
    es_hover = Hex { q: input.in_hover_q, r: input.in_hover_r };

    // ── Mode toggle ─────────────────────────────────────────────
    if input.in_toggle_mode && !s.prev.in_toggle_mode {
        s.mode = toggle_mode(s.mode);
        // Flush any in-flight paint stroke before the flip — it is a
        // complete stroke from the player's point of view.
        if !undo_entry_is_noop(s.stroke) {
            history_push(s.history, s.stroke);
            s.stroke = undo_entry_empty();
        }
        // Drop the stroke so a held button does not bleed across the
        // boundary into the other mode.  ⚠ Clearing the button EDGE
        // here as well is what @D001 was: it made the marker branch
        // below read a rising edge that never happened, so Tab with
        // the button held placed a marker.  `s.painting = false` is
        // what actually ends the stroke.
        s.painting = false;
        s.render_needed = true;
    }

    // ── Place-direction rotation ────────────────────────────────
    // Marker mode only, and only for spawns — targets are spherical,
    // so a rotation would be a lie the ghost preview would tell.
    if input.in_rotate && !s.prev.in_rotate
    && s.mode == MODE_MARKER && s.place_kind == MARKER_KIND_SPAWN {
        s.place_direction = rotate_direction(
            s.place_direction,
            if input.in_rotate_ccw { -1 } else { 1 }
        );
        s.render_needed = true;
    }

    // ── Place-kind cycle ────────────────────────────────────────
    if input.in_cycle_kind && !s.prev.in_cycle_kind && s.mode == MODE_MARKER {
        if s.place_kind == MARKER_KIND_SPAWN {
            s.place_kind = MARKER_KIND_TARGET;
        } else {
            s.place_kind = MARKER_KIND_SPAWN;
        }
        s.render_needed = true;
    }

    // ── Save ────────────────────────────────────────────────────
    // Edge-triggered like every other action, which is what the old
    // half-second debounce was standing in for: one press, one save.
    // The palette comes off the picker rather than being carried
    // twice — the picker already IS the loaded palette.
    if input.in_save && !s.prev.in_save && s.save_path != "" {
        save_world(s.pw, s.cam, s.picker.palette, "interactive", s.save_path);
        save_markers(s.mw, "interactive", s.marker_save_path);
        s.dirty = false;
        s.render_needed = true;   // the save indicator goes amber → green
    }

    // ── Reload from disk ────────────────────────────────────────
    // Records the current→loaded diff as ONE undo entry first, so a
    // mis-hit Ctrl+R is recoverable with Ctrl+Z.
    if input.in_reload && !s.prev.in_reload && s.save_path != "" {
        // Commit any in-flight stroke, so it is part of the diff
        // rather than lost inside it.
        if !undo_entry_is_noop(s.stroke) {
            history_push(s.history, s.stroke);
            s.stroke = undo_entry_empty();
        }
        es_loaded  = load_map_or_empty(s.save_path, s.picker.palette);
        es_pw_new  = es_loaded.0;
        es_cam_new = es_loaded.1;
        es_mw_new  = load_markers_or_empty(s.marker_save_path);
        reload_and_record(s.pw, s.mw, es_pw_new, es_mw_new, s.history);
        s.pw  = es_pw_new;
        s.mw  = es_mw_new;
        s.cam = es_cam_new;
        s.cf  = chunks_from_painted(s.pw);   // resync the dirty tracker
        s.dirty    = false;   // disk and memory now match
        s.painting = false;   // (never the button edge — see @D001)
        s.render_needed = true;
    }

    // ── Clear all ───────────────────────────────────────────────
    // Snapshots everything into one undo entry first, so a mis-hit
    // Ctrl+N costs one Ctrl+Z rather than the session.  Does NOT
    // save: the cleared state reaches disk only on the next save.
    if input.in_clear_all && !s.prev.in_clear_all {
        clear_and_record(s.pw, s.mw, s.history);
        s.pw  = painted_empty();
        s.mw  = marker_empty();
        s.cam = camera_default();
        s.cf  = chunks_from_painted(s.pw);   // resync the dirty tracker
        s.dirty    = true;
        s.painting = false;   // (never the button edge — see @D001)
        s.render_needed = true;
    }

    // ── Undo / redo ─────────────────────────────────────────────
    if input.in_undo && !s.prev.in_undo {
        // Commit any in-flight stroke FIRST, so the player can undo
        // back through the drag they are in the middle of.
        if !undo_entry_is_noop(s.stroke) {
            history_push(s.history, s.stroke);
            s.stroke   = undo_entry_empty();
            s.painting = false;   // (never the button edge — see @D001)
        }
        if history_undo(s.history, s.pw, s.mw) {
            s.cf    = chunks_from_painted(s.pw);   // bulk change to pw
            s.dirty = true;
            s.render_needed = true;
        }
    }

    if input.in_redo && !s.prev.in_redo {
        if history_redo(s.history, s.pw, s.mw) {
            s.cf    = chunks_from_painted(s.pw);   // bulk change to pw
            s.dirty = true;
            s.render_needed = true;
        }
    }

    // ── Camera recentre ─────────────────────────────────────────
    // Leaves the painted and marker layers alone — this is "where
    // was I?", not "start again".
    if input.in_recentre && !s.prev.in_recentre {
        s.cam = camera_default();
        s.render_needed = true;
    }

    // ── Camera pan + zoom ───────────────────────────────────────
    // `camera_update` already models this; the seam feeds it rather
    // than restating what a pan does to a hex coordinate.
    es_cam = InputState {
        in_pan_north: input.in_pan_north,
        in_pan_south: input.in_pan_south,
        in_pan_east:  input.in_pan_east,
        in_pan_west:  input.in_pan_west,
        in_zoom_in:   input.in_zoom_in,
        in_zoom_out:  input.in_zoom_out,
    };
    if es_cam.in_pan_north || es_cam.in_pan_south
    || es_cam.in_pan_east  || es_cam.in_pan_west
    || es_cam.in_zoom_in   || es_cam.in_zoom_out {
        camera_update(s.cam, es_cam);
        s.render_needed = true;   // the view moved → full re-rasterise
    }

    // ── Palette selection ───────────────────────────────────────
    // Idempotent, so no edge detection: a held hotkey re-selects the
    // entry that is already active.  Only a real change re-renders
    // (both the preview colour and the picker highlight move).
    if input.in_select_palette {
        es_pre_active = s.picker.active;
        picker_set_active(s.picker, input.in_palette_index);
        if s.picker.active != es_pre_active { s.render_needed = true; }
    }

    // ── Ground-mode paint ───────────────────────────────────────
    if input.in_mouse_left && s.mode == MODE_GROUND {
        // Writes the painted-hex layer AND accumulates per-hex deltas
        // into `stroke` for undo.
        if input.in_paint_tick {
            if s.painting {
                paint_line_and_record(s.pw, s.last_paint_hex, es_hover,
                                      s.picker.active as u8? ?? 0,
                                      s.stroke);
            } else {
                paint_and_record(s.pw, es_hover.q, es_hover.r,
                                 s.picker.active as u8? ?? 0,
                                 s.stroke);
            }
            s.last_paint_hex.q = es_hover.q;
            s.last_paint_hex.r = es_hover.r;
            s.painting = true;
            s.dirty    = true;
            chunks_mark_dirty(s.cf, es_hover.q, es_hover.r);   // pw changed → re-render
        }
    } else {
        // The stroke ended — button released, or the mode flipped
        // out from under it.  Commit it as one undoable action and
        // reset for the next press.
        if s.painting {
            if !undo_entry_is_noop(s.stroke) {
                history_push(s.history, s.stroke);
                s.stroke = undo_entry_empty();
            }
            s.cf = chunks_from_painted(s.pw);   // resync the cell set after the stroke
        }
        s.painting = false;
    }

    // ── Marker placement (V0b group 3) ──────────────────────────
    // Edge-triggered, unlike paint: each press is ONE place-or-remove
    // event, so holding the button and sweeping the mouse does not
    // lay a trail of markers.  Clicking an occupied hex removes what
    // is there — place and remove are the same gesture.
    if input.in_mouse_left && !s.prev.in_mouse_left && s.mode == MODE_MARKER {
        if has_marker(s.mw, es_hover.q, es_hover.r) {
            remove_marker_and_record(s.mw, es_hover.q, es_hover.r, s.history);
        } else if s.place_kind == MARKER_KIND_TARGET {
            place_target_and_record(s.mw, es_hover.q, es_hover.r, s.history);
        } else {
            place_spawn_and_record(s.mw, es_hover.q, es_hover.r,
                                   s.place_direction, s.history);
        }
        s.dirty = true;
        chunks_mark_dirty(s.cf, es_hover.q, es_hover.r);   // marker layer changed → re-render
    }

    // Remember this frame for the next one's edge detection.  Last,
    // so every action above sees the previous frame.
    s.prev = input_copy(input);
}

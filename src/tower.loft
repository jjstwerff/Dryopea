// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// The tower — the first thing in dryopea that shoots back.
//
// Plan 12 phase B5a.  `docs/DESIGN.md` § 7 describes a pulsed-laser
// tower with a range, a fire interval, a damage per shot, a line of
// sight and a shot budget; B5a builds the first three and B5b the
// last two, so **everything here is in range and nothing here can
// miss**.
//
// ── Where a tower comes from (plan 12 open question 3) ──────────
//
// A **marker** — `markers.loft::MARKER_KIND_TOWER`, the third kind.
// The marker layer's own header says what it is for: *placeholder
// content the runtime reads but the painted palette does not
// represent*.  A tower is 6 m of machine with HP, a range and a
// budget; putting it in a palette whose other entries are dirt and
// water would have made every ground question ask "unless it is a
// tower".  It also makes towers authorable in the editor that already
// exists, and measurable by a `.keys` script that already speaks
// `marker <q> <r> tower`.
//
// ⚠ **The 7-hex footprint is NOT built.**  `numbers.json` §
// tower.footprint_layout says a tower covers a centre hex and its six
// neighbours; B5a places it on ONE hex and fires from there.  Range
// and LOS both measure from the centre, so the footprint changes what
// a tower BLOCKS and what it costs to place, not what it can hit —
// and blocking is a passability question that belongs with the
// structure layer plan 06 S1 will build.
//
// ── Why a tower needs runtime state at all ──────────────────────
//
// Because a shot is DISCRETE and a tick is not a shot.  B0 measured
// the awkward number this whole plan turns on: a 1.0 s fire interval
// is **1.5 ticks**.  So a tower cannot "fire once per tick", and
// spending its damage as a smooth 10 HP/s rate — which `per_tick`
// would make easy — throws away the one thing B5b needs, a COUNT of
// shots to charge against the 30-shot budget.
//
// So each tower carries a **charge**: every tick adds `TICK_SECONDS`
// to it, and while it holds a whole `fire_interval` the tower fires
// one shot and SUBTRACTS the interval — never resets — so the
// remainder carries.  That gives two shots every three ticks forever,
// and each one is a shot B5b can count, `docs/DESIGN.md` can call
// pulsed, and a player can watch recharge.
//
// ⚠ The comparison needs `TOWER_CHARGE_EPSILON`.  `1 / 1.5` has no
// exact float form, so three ticks sum a hair under 2.0 and a plain
// `>=` drops every third shot — see the constant.
//
// ⚠ It is a WHILE and not an IF: a caller that ticked a tower after a
// long pause would otherwise silently lose the shots it had banked.
// Nothing does that today, and the loop costs nothing when it cannot
// fire.

use lattice;
use markers;
use palette;
use painted;
use height;
use passable;

// ─── The numbers ────────────────────────────────────────────────
//
// `examples/numbers.json` § tower, restated here because nothing loads
// that file yet — the same note `spawn.loft` and `damage.loft` carry.

// numbers.json § tower.range.  ⚠ **A LATTICE distance, and nothing
// else.**  `lat_distance` is the only thing allowed to answer "how far
// apart", and reaching for a `+ 1` on a q or an r to compute it is
// moros#10 again — the bug that sheared every reach computation in the
// first project to speak this lattice.
pub const TOWER_RANGE_HEXES: integer = 15;

// numbers.json § tower.fire_interval — one shot a second.  ⚠ 1.5
// ticks, which is the whole reason a tower banks charge instead of
// firing on a tick boundary.
pub const TOWER_FIRE_INTERVAL_S: float = 1.0;

// numbers.json § tower.damage_per_shot — three shots kill a regular.
pub const TOWER_DAMAGE_PER_SHOT: float = 10.0;

// numbers.json § tower.height — how high off its own hex the tower
// looks and shoots from.
//
// ⚠ **It is measured from the tower's SURFACE, not from sea level**,
// which is the whole reason `DESIGN.md` § LOS is a HEIGHT question
// says the ridge works for free: a tower standing on 3 m of wall sees
// from 9 m with nothing written for elevation at all.
pub const TOWER_HEIGHT_METRES: float = 6.0;

// numbers.json § tower.shot_budget_per_charge — how many shots a tower
// has before it **goes black** and stops firing.
//
// ⚠ Decay is per SHOT and never per time (`DESIGN.md` § 7), and that
// is a design rule rather than an implementation detail: an idle tower
// in a quiet corner never decays, which is one of the few things in
// dryopea that lets a player rest.  A budget that ticked down would
// take that away and would make a tower a timer.
pub const TOWER_SHOT_BUDGET: integer = 30;

// ⚠ **How close to a whole interval still counts as one, and it is
// not defensive noise — without it the tower LOSES SHOTS.**
//
// A tick is `1 / 1.5` seconds, which has no exact float
// representation, so three ticks sum to 1.9999999999999998 rather
// than 2.0 and `>= 1.0` refuses the second shot.  Measured: the
// cadence test read 1 shot in 3 ticks where the design says 2, and it
// would have gone on reading low forever — a tower quietly at
// two-thirds of its documented DPS, which no assertion about "it
// killed the thing" could see.
//
// The residue does NOT grow, because a shot subtracts exactly one
// interval rather than resetting the charge: the debt stays within an
// ulp or two of zero however long a run lasts, which
// `test_the_cadence_does_not_drift_over_a_long_run` is the gate for.
pub const TOWER_CHARGE_EPSILON: float = 1.0e-9;

// ─── What it takes to bring a black tower back (plan 17 T1) ─────

// `numbers.json` § tower.repair_time_helper_rebuild — *"Time for a
// helper to repair a black tower from scratch."*
//
// ⚠ **ONE rate for the player and for a helper**, because the file has
// one row.  A separate player figure would be a tunable this plan
// invented, which is the rule `vehicle.loft` § salvage already keeps —
// there is no helper salvage RATE for the same reason.
pub const TOWER_REPAIR_SECONDS: float = 20.0;

// ⚠⚠ **The banked-timer rule has a second half, and plan 17 T1 is what
// found it: the DIRECTION of the count is part of it.**
//
// Plan 15 C0's rule was *"a timer loses a tick exactly when its
// duration divides the tick length exactly"* — 60.0 s of helper
// recovery is 90 ticks and a bare `> 0.0` gives 91.  True, and
// incomplete.  Every other banked timer in dryopea counts DOWN
// (`helper.recover`, `Vehicle.boost_left`, `Enemy.stand`,
// `WaveSchedule.lull`); this one counts UP, because `repair` has to be
// *seconds banked* for zero to be the neutral value.  And the two
// directions do not accumulate the same way.
//
// Measured, over a 1/1.5 s tick, for durations that ARE exact
// multiples:
//
//   | T      | ticks | counting UP        | counting DOWN     |
//   |---|---|---|---|
//   |  4.0 s |    6  | 3.9999999999999996 | residue > 0       |
//   | 10.0 s |   15  | 9.999999999999998  | residue > 0       |
//   | 20.0 s |   30  | **exactly 20.0**   | residue > 0       |
//   | 30.0 s |   45  | 30.000000000000018 | residue < 0       |
//   | 40.0 s |   60  | 39.99999999999999  | residue > 0       |
//   | 60.0 s |   90  | 59.99999999999992  | residue > 0       |
//
// ⚠ **So NEITHER direction is safe, and today's value is exact by
// LUCK.**  20.0 counting up lands on the nose and needs no epsilon at
// all; 10.0, 40.0 and 60.0 counting up all fall short and would each
// cost a tick.  This constant therefore is not what makes 20.0 work —
// it is what makes the number TUNABLE, and `tests/17_t1_the_rebuild.
// loft` § The guard can fire is the assertion that keeps it honest
// rather than decorative.
//
// ⚠ Do not "simplify" this away after checking that the suite stays
// green: it stays green because of the luck above, and the first person
// to retune the repair time pays for it.
pub const TOWER_REPAIR_EPSILON: float = 1.0e-9;

// How close a vehicle has to be to work on a tower.
//
// ⚠ **DERIVED, not picked**: `numbers.json` § tower.footprint_layout is
// `hex_disc_radius_1`, so a tower occupies its hex and all six
// neighbours — and a vehicle within one hex is standing ON it.  It is
// the same derivation `wallet.loft`'s `NIBBLE_REACH_HEXES` makes from
// the core's footprint, and it lands on the same number as
// `CARGO_REACH_HEXES` by arithmetic rather than by copying.
pub const TOWER_REPAIR_REACH_HEXES: integer = 1;

// ⚠ The sight epsilon moved to `passable.loft::SIGHT_EPSILON` in plan
// 21 R2, with the tower's own reasoning intact — it is a property of
// drawing a line over heights, and the camera draws one too.

// ─── What a tower remembers between ticks ───────────────────────

// One tower's charge in seconds banked toward its next shot, and how
// many shots it has spent out of its budget.
//
// ⚠ Shots FIRED rather than shots REMAINING, and it is the same choice
// `damage.loft` makes for a wall: zero is the neutral value, so a
// tower this struct has never heard of is a fresh one rather than a
// black one.  A `TowerCharge {}` literal is a working tower.
// ⚠ **`charge` and `shots` are TWO CLOCKS and a repair touches ONE of
// them** (plan 17 T1), which is worth saying beside the fields because
// getting it wrong is invisible.  `charge` is seconds banked toward the
// NEXT shot and `shots` is the magazine; a rebuild refills the magazine
// and must leave the charge exactly where it was.  T0 measured what
// happens otherwise: a tower needs 1.5 ticks of charge to reach one
// firing interval, so a repair that also zeroed the charge left every
// tower permanently a hair short and it **never fired at all** — a base
// that reads exactly like an undefended one, 233 ticks, with three
// towers standing in it.
//
// ⚠ `repair` is seconds banked toward the REBUILD, and zero is the
// neutral value a third time: a `TowerCharge { }` literal is a tower
// nobody is working on.
//
// ⚠⚠ **`top_removed` and NEVER `has_top`** (plan 17 T2), and the name is
// the whole safety argument.  A struct literal that omits a field takes
// its ZERO silently ([loft#914](https://github.com/loft-lang/loft/issues/914)),
// so a `has_top` would default to FALSE and disarm every tower in a
// suite that had never heard of the field — a game-wide silent
// regression from adding one line.  Stated as the removal, zero means
// *the top is on*, which is what every literal that predates this
// wants to mean.  Same rule as `Enemy.stand`, `damage taken` and
// `shots fired`.
//
// ⚠⚠ **And this is where the magazine stops belonging to the HEX.**
// `shots` is the mounted TOP's spent count, not the tower's: detach it
// and the number leaves with it (as `CarryObject.subj`), so
// detach-and-remount cannot refill.  The hash is still keyed by hex
// because a tower's PLACE is what has a charge and a rebuild in
// progress — but the ammunition is the top's, and that is the
// distinction plan 17 exists to draw.
pub struct TowerCharge {
    q:           integer,
    r:           integer,
    charge:      float,
    shots:       integer,
    repair:      float,
    top_removed: boolean,
}

// What every tower on the map has banked.  A hash must be a struct
// field — the same loft idiom `PaintedWorld`, `HeightLayer` and
// `DamageLayer` follow.
pub struct TowerState {
    cells: hash<TowerCharge[q, r]>,
}

// Factory: every tower cold, with nothing banked.
//
// ⚠ A cold tower fires on its SECOND tick, not its first: one tick
// banks 0.667 s and two bank 1.333, which is the first time a whole
// interval is available.  That is the recharge gap `DESIGN.md` § 7
// says should be visible, arriving at the start of a wave rather than
// being special-cased into it.
pub fn tower_state_empty() -> TowerState {
    TowerState { cells: [] }
}

// How much (q, r) has banked toward its next shot, in seconds.
//
// ⚠ The only door — a miss is 0.0, "this tower has not been ticked
// yet", which is what a tower placed mid-run needs.
pub fn tower_charge(ts: const TowerState, q: integer, r: integer) -> float {
    tc_c = ts.cells[q, r];
    if tc_c == null { return 0.0; }
    tc_c.charge
}

// Bank `seconds` onto (q, r) — negative spends it.
//
// `pub` because the firing loop lives in `spawn.loft`, where
// `WaveState` and `Enemy` are: this file owns what a tower IS and the
// wave engine owns what a tick DOES to one, the same split
// `damage.loft` and `spawn.loft` already have for enemy HP.
pub fn tower_bank(ts: TowerState, q: integer, r: integer, seconds: float) {
    tb_c = ts.cells[q, r];
    if tb_c == null {
        // `shots: 0` is spelled out rather than defaulted — a literal
        // that omits a field takes its zero SILENTLY, and this is the
        // site where a wrong one would hand out a black tower.
        ts.cells[q, r] = TowerCharge { q: q, r: r, charge: seconds, shots: 0,
                                       repair: 0.0, top_removed: false };
    } else {
        tb_c.charge = tb_c.charge + seconds;
    }
}

// Cap the charge at one whole interval — what a tower that could NOT
// fire does with the seconds it just banked.
//
// ⚠ **A capacitor holds one shot, not a magazine**, and the cap is
// what makes "a blocked shot is not fired" survive contact with a long
// blockage.  Hold the charge uncapped and a tower blinded for a
// hundred ticks empties two thirds of its budget into the first thing
// it sees, which is the burst B5a's empty-field rule already refused —
// only worse, because now it is spending a budget as well.
//
// It only ever REMOVES charge, so it cannot manufacture a shot: a
// tower a hair short of an interval stays a hair short.
pub fn tower_hold(ts: TowerState, q: integer, r: integer) {
    th_c = ts.cells[q, r];
    if th_c == null { return; }
    if th_c.charge > TOWER_FIRE_INTERVAL_S { th_c.charge = TOWER_FIRE_INTERVAL_S; }
}

// How many shots (q, r) has FIRED.  A tower nobody has ticked has
// fired none.
pub fn tower_shots(ts: const TowerState, q: integer, r: integer) -> integer {
    tsh_c = ts.cells[q, r];
    if tsh_c == null { return 0; }
    tsh_c.shots
}

// Charge one shot against (q, r)'s budget.
//
// ⚠ Called from the ONE place a shot is fired (`spawn.loft::wave_fire`)
// and never anywhere else, for the reason `wave_deaths` is the one
// death path: a second site that spent a shot without landing one, or
// landed one without spending, would make the budget disagree with the
// damage and no test naming either could see it.
pub fn tower_spend_shot(ts: TowerState, q: integer, r: integer) {
    tss_c = ts.cells[q, r];
    if tss_c == null {
        ts.cells[q, r] = TowerCharge { q: q, r: r, charge: 0.0, shots: 1,
                                       repair: 0.0, top_removed: false };
    } else {
        tss_c.shots = tss_c.shots + 1;
    }
}

// Has (q, r) spent its budget — is it **black**?
//
// `DESIGN.md` § 7: a black tower stops firing and waits for a player
// to repair it.  Nothing in this plan repairs one, so in an unattended
// run black is terminal, and that is the point: B7's clock is partly
// the tower budget running out.
pub fn tower_black(ts: const TowerState, q: integer, r: integer) -> boolean {
    tower_shots(ts, q, r) >= TOWER_SHOT_BUDGET
}

// Shots left before (q, r) goes black — 0 for a tower already there.
pub fn tower_budget_left(ts: const TowerState, q: integer, r: integer) -> integer {
    tbl_n = TOWER_SHOT_BUDGET - tower_shots(ts, q, r);
    if tbl_n < 0 { return 0; }
    tbl_n
}

// How many towers have been ticked at least once.
pub fn tower_count(ts: const TowerState) -> integer {
    len(ts.cells)
}

// ─── Bringing one back (plan 17 T1) ─────────────────────────────

// May (q, r) be repaired at all?
//
// ⚠ **A FIRING tower may not**, and it is `DESIGN.md` § 7's rule rather
// than a convenience: *"a firing (red) tower cannot be repaired —
// repair only applies to a tower whose top is either black (decayed in
// place, no longer firing) or detached"*.  The fiction is that you do
// not fiddle with a heavy energy weapon while it is powered on; the
// consequence is that upkeep has to be TIMED, which is what makes the
// hot-swap in T2 a cycle rather than a convenience.
//
// ⚠ **And there has to BE a top.**  A tower whose top has been carried
// off is not a tower with a problem, it is a mast — there is nothing
// there to work on.  ⚠ `DESIGN.md` § 7 also allows repairing a
// **detached** top where it lies, and that half is NOT built: a
// grounded top is a `CarryObject` and healing one needs a timer on the
// object, which is new carrying code.  Recorded in `plans/17` § Open
// questions rather than smuggled in.
pub fn tower_repairable(ts: const TowerState, q: integer, r: integer) -> boolean {
    tower_has_top(ts, q, r) && tower_black(ts, q, r)
}

// Seconds banked toward (q, r)'s rebuild.  Zero for a tower nobody is
// working on, which is also a tower nobody has ever ticked.
pub fn tower_repair_progress(ts: const TowerState, q: integer, r: integer) -> float {
    trp_c = ts.cells[q, r];
    if trp_c == null { return 0.0; }
    trp_c.repair
}

// Is somebody part-way through a rebuild here?
pub fn tower_repairing(ts: const TowerState, q: integer, r: integer) -> boolean {
    tower_repair_progress(ts, q, r) > TOWER_REPAIR_EPSILON
}

// Bank one turn of repair into (q, r).  Answers whether THIS call
// finished it.
//
// ⚠ **The progress lives on the TOWER, not on whoever is working on
// it** (`plans/17` § Open questions 1).  A crew member driven off at 19
// of 20 seconds leaves the work where it stands, and a second one — or
// the player — finishes it.  Storing it on the vehicle would make a
// rebuild the property of a particular helper, so losing that helper
// would silently discard the work with nothing able to see it.
//
// ⚠ **It refills the MAGAZINE and never touches the CHARGE** — see the
// warning on `TowerCharge`.  This is the one line where getting it
// wrong produces a base that reads exactly like an undefended one.
//
// ⚠ The comparison needs `TOWER_REPAIR_EPSILON`: 20.0 s is exactly 30
// ticks and a bare `>=` gives 31.
pub fn tower_repair_tick(ts: TowerState, q: integer, r: integer,
                         seconds: float) -> boolean {
    if !tower_repairable(ts, q, r) { return false; }
    trt_c = ts.cells[q, r];
    // A tower that is black HAS a cell by construction — `tower_black`
    // is `shots >= 30` and shots only rise through `tower_spend_shot`,
    // which creates one.  The guard is here so the null case has an
    // answer rather than because it is reachable.
    if trt_c == null { return false; }

    trt_c.repair = trt_c.repair + seconds;
    if trt_c.repair < TOWER_REPAIR_SECONDS - TOWER_REPAIR_EPSILON {
        return false;
    }

    trt_c.repair = 0.0;
    trt_c.shots  = 0;
    true
}

// ─── The top comes off (plan 17 T2) ─────────────────────────────
//
// `DESIGN.md` § Tower-top salvage: *"A tower's red top is a detachable
// carry object … player drives to a healthy tower, presses pickup → top
// detaches, tower goes black (stops firing)."*  ⚠ "Goes black" there
// means STOPS FIRING; in this engine `tower_black` already means
// *spent*, so the two are kept apart: a topless tower does not fire
// because it has nothing to fire WITH, whatever its magazine says.

// Does (q, r) have a top on it?
//
// ⚠ **An absent cell answers TRUE**, and that is the whole reason the
// field is `top_removed`: a tower nobody has ticked is a fresh tower
// with its top on, and the sparse default has to say so.
pub fn tower_has_top(ts: const TowerState, q: integer, r: integer) -> boolean {
    tht_c = ts.cells[q, r];
    if tht_c == null { return true; }
    !tht_c.top_removed
}

// Take the top off (q, r).  Answers the shots it has FIRED — the
// magazine that travels with it — or -1 if there was no top to take.
//
// ⚠ **The charge and any repair in progress are DISCHARGED**, and it is
// the design's own fiction rather than bookkeeping: `DESIGN.md` § 7's
// repair rule is that *"the mount cools, the capacitors discharge, the
// safety interlocks unlatch"*.  It also closes the obvious exploit —
// bank a charge, pull the top, put it straight back, fire instantly.
//
// ⚠ It does NOT create the carry object; `spawn.loft::wave_take` does
// that, because a `CargoLayer` is not this file's business.  Two
// effects at one SITE, the rule `damage.loft::break_structure` keeps —
// and the site is the one that owns both halves.
pub fn tower_detach_top(ts: TowerState, q: integer, r: integer) -> integer {
    if !tower_has_top(ts, q, r) { return -1; }

    tdt_c = ts.cells[q, r];
    if tdt_c == null {
        // A fresh tower nobody has ticked: its top is full.
        ts.cells[q, r] = TowerCharge { q: q, r: r, charge: 0.0, shots: 0,
                                       repair: 0.0, top_removed: true };
        return 0;
    }

    tdt_n = tdt_c.shots;
    tdt_c.top_removed = true;
    tdt_c.charge      = 0.0;
    tdt_c.repair      = 0.0;
    tdt_n
}

// Put a top carrying `shots` spent onto (q, r).  Answers whether it
// went on.
//
// ⚠ **It REFUSES a tower that already has one**, and never overwrites:
// an overwrite would delete a top out of the world with nothing able to
// see it, which is the defect `carry.loft`'s whole representation
// exists to make unwritable.  The design's hot-swap — *"strained top
// drops to the ground; spare goes onto the tower"* — is therefore
// COMPOSED at the call site out of a detach and a mount, rather than
// being a third primitive that could disagree with them.
//
// ⚠ It also refuses a hex this state has never heard of, because such a
// hex has a top by definition (§ `tower_has_top`).  Whether the hex is
// a tower at ALL is the marker layer's question and `spawn.loft` asks
// it — this file cannot see markers.
pub fn tower_mount_top(ts: TowerState, q: integer, r: integer,
                       shots: integer) -> boolean {
    if tower_has_top(ts, q, r) { return false; }

    tmt_c = ts.cells[q, r];
    if tmt_c == null { return false; }

    tmt_c.top_removed = false;
    tmt_c.shots       = shots;
    tmt_c.charge      = 0.0;
    tmt_c.repair      = 0.0;
    true
}

// Is `at` close enough to the tower at `tower` to work on it?
//
// ⚠ Stated once, here, so no call site reaches for a `+ 1` on a q or an
// r to decide it — `lat_distance` and nothing else, the same rule
// `tower_in_range` carries.
pub fn tower_in_repair_reach(tower: const Hex, at: const Hex) -> boolean {
    lat_distance(tower, at) <= TOWER_REPAIR_REACH_HEXES
}

// ─── Range ──────────────────────────────────────────────────────

// Is `target` inside this tower's reach?
//
// ⚠ Inclusive at the limit: `numbers.json` says a range of 15 hexes,
// and a weapon that stopped at 14 would be a different number.  The
// invariant gate is exactly this line — *hit at 15, untouched at 16*.
pub fn tower_in_range(tower: const Hex, target: const Hex) -> boolean {
    lat_distance(tower, target) <= TOWER_RANGE_HEXES
}

// ─── Line of sight (plan 12 B5b) ────────────────────────────────
//
// **A shot travels in a straight line from the tower's eye to the
// target's body, and anything the line does not clear stops it.**
// That is the whole rule, and every term in it is a HEIGHT.
//
// ⚠ **There is deliberately no table of what blocks.**
// `DESIGN.md` § LOS is a HEIGHT question spells out why: the numbers
// already decide it (a 6 m tower against a 5 m `wall_high`), and a
// *`wall_high` blocks / `wall` does not* lookup would be a second
// source of truth for heights `passable.loft` already owns — the shape
// this codebase has caught twice (`walk_ground` versus the height rule
// in plan 11 F0; the painted kind versus the surface in B1).  Reading
// the height buys three things a table cannot:
//
// - **elevation, free.**  A tower on a ridge or on its own wall sees
//   from higher, with nothing written for it.
// - **rubble blocks.**  A pile is a height, so the bodies that ramp a
//   kill zone shut also blind the tower covering it — the same
//   losing spiral `ENEMY_MOVEMENT.md` § Bodies are terrain describes,
//   arriving from a direction nobody wrote down.
// - **terrain will block itself.**  `steep_rock` is 0.0 m today and
//   blocks nothing, because dryopea has no terrain elevation at all
//   yet; the day plan 02's slope solver lands it blocks for free and
//   this file does not change.
//
// ⚠ **And it FALSIFIES the design's own summary of itself.**
// `DESIGN.md` § 7 says LOS is *"blocked by `wall_high` + `steep_rock`,
// not by `wall`"*.  Measured against the ray: a `wall` blocks whenever
// it stands past roughly three fifths of the way to the target, so a
// tower two hexes behind its own wall cannot touch the robots chewing
// the far side of it.  That is dead ground and it is real geometry —
// see `tests/12_b5b_los_budget.loft` § The falsification.

// How high off sea level this tower's weapon sits: the height of
// whatever it stands on, plus the tower.
pub fn tower_eye(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                 at: const Hex) -> float {
    hex_height(pal, pw, hl, at.q, at.r) + TOWER_HEIGHT_METRES
}

// Can a tower at `from` put a shot into something `target_height`
// metres tall standing at `to`?
//
// The line and the lerp are `passable.loft::sight_first_block`'s — the
// ONE walker, shared with the camera's boom since plan 21 R2.  This is
// the tower's door onto it: the eye is the tower's, the aim is the
// target's top, and the answer is a yes/no because a shot either lands
// or does not.
//
// ⚠ **The endpoints are walked and CANNOT block, which used to be an
// explicit skip.**  The tower stands ON the first cell — its own 3 m
// wall does not blind it — and the enemy stands ON the last.  Both fall
// out of the heights rather than out of an index test: the eye is
// `hex_height(from) + TOWER_HEIGHT_METRES` and the aim is
// `hex_height(to) + target_height`, so each end's own surface is BELOW
// the ray that starts on top of it whenever those two offsets are
// non-negative — which they are, by construction.  ⚠ Measured, not
// argued: `tests/21_r2_the_boom.loft` § An endpoint cannot block its
// own line, and the whole LOS corpus green either way.
//
// ⚠ Aimed at the target's TOP, not at its feet: a shot that reaches
// any part of the body hits.  See `damage.loft::ENEMY_HEIGHT_METRES`
// for why the difference is not cosmetic.
pub fn tower_sees(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                  from: const Hex, to: const Hex, target_height: float) -> boolean {
    sight_first_block(pal, pw, hl, from, to,
                      tower_eye(pal, pw, hl, from),
                      hex_height(pal, pw, hl, to.q, to.r) + target_height) < 0
}

// What stopped the shot, in the numbers that stopped it — the `*_fault`
// twin `passable.loft` gives every one of its predicates.
//
// A message rather than a boolean, because a blind tower and a tower
// out of range look identical from outside and the difference is three
// metres on one hex halfway down the line.
pub fn tower_sight_fault(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                         from: const Hex, to: const Hex, target_height: float) -> text {
    tsf_n = lat_distance(from, to);
    if tsf_n <= 1 { return "clear — nothing stands between adjacent hexes"; }

    tsf_eye = tower_eye(pal, pw, hl, from);
    tsf_aim = hex_height(pal, pw, hl, to.q, to.r) + target_height;

    // ⚠ **Asks the same walker `tower_sees` does, rather than repeating
    // its arithmetic.**  A `*_fault` twin that walks its own line can
    // disagree with the predicate it explains — and the case it would
    // disagree in is exactly the one somebody is reading it to
    // understand.
    tsf_at = sight_first_block(pal, pw, hl, from, to, tsf_eye, tsf_aim);
    if tsf_at < 0 {
        return "clear — the shot from {tsf_eye:5.2} m reaches {tsf_aim:5.2} m over {tsf_n} hexes";
    }

    tsf_line = lat_line(from, to);
    tsf_c = tsf_line[tsf_at];
    tsf_ray = tsf_eye + (tsf_aim - tsf_eye) * (((tsf_at as float) / (tsf_n as float)) ?? 0.0);
    tsf_h = hex_height(pal, pw, hl, tsf_c.q, tsf_c.r);
    "blocked at ({tsf_c.q}, {tsf_c.r}), {tsf_at}/{tsf_n} along: "
        + "{tsf_h:5.2} m of {hex_ground_name(pal, pw, hl, tsf_c.q, tsf_c.r)} "
        + "under a shot at {tsf_ray:5.2} m "
        + "(eye {tsf_eye:5.2} m, aim {tsf_aim:5.2} m)"
}

// ─── Choosing what to shoot, and firing ─────────────────────────
//
// Both live in `spawn.loft` — `tower_pick` and `wave_fire` — because
// they read the roster, and `WaveState` is the wave engine's.  This
// file must not depend on it: the tick calls INTO here.

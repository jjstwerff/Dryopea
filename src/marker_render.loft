//
// Marker render — draws a hot-pink triangle arrow per placed
// spawn marker at its hex centre, oriented per its direction
// (0..5).  Sits on top of the painted-hex render — the ground
// colour underneath stays visible.
//
// Plan 03 phase M3 (M4 swaps the filled-vs-outline + alpha for
// the in-game render mode; the editor uses the same primitive).

use graphics;
use lattice;
use camera;
use markers;

// Plan 03 § Editor visual specifies `#ff3060` (hot pink) so the
// arrow stays unambiguous against any palette colour — including
// sand `#f0d860` and the wall placeholder reds.
pub const ARROW_COLOR:       integer = 0xff3060;
pub const ARROW_GHOST_COLOR: integer = 0xc02050;   // dimmer for hover preview

// Arrow geometry in HEX-RELATIVE units (multiplied by ppm at
// render time so the arrow scales with zoom).  Tuned so the
// triangle sits comfortably inside a hex without overlapping
// neighbours.
pub const ARROW_LEN_M:  float = 0.55;   // tip distance from hex centre
pub const ARROW_BASE_M: float = 0.18;   // back-of-arrow offset from centre
pub const ARROW_HALF_W: float = 0.25;   // half-width of the triangle base

// Target marker — classical red/white bullseye sphere per
// @PLAN50 § Scoring.  Editor renders the same as two filled
// concentric circles (the 3D-extruded sphere is the renderer's
// job in @PLAN50; the editor only marks the hex coordinate).
pub const TARGET_OUTER_COLOR: integer = 0xc02020;   // red ring
pub const TARGET_INNER_COLOR: integer = 0xffffff;   // white centre
pub const TARGET_GHOST_COLOR: integer = 0x801818;   // dimmer red for hover
pub const TARGET_OUTER_R_M:   float = 0.40;          // outer radius in hex-relative units
pub const TARGET_INNER_R_M:   float = 0.18;          // inner radius

// Tower marker (plan 12 B5a) — a cyan ring with a hollow centre, so
// it reads as a machine rather than as the target's solid bullseye or
// the spawn's arrow at a glance, and reads differently again in
// greyscale (a ring, not a disc).  A tower has no facing, so there is
// nothing to orient.
pub const TOWER_COLOR:       integer = 0x30d0d0;
pub const TOWER_GHOST_COLOR: integer = 0x188080;   // dimmer for hover
pub const TOWER_R_M:         float   = 0.34;

// Trap marker (BACKLOG C4) — an amber X, drawn as two crossed lines
// through the hex centre.
//
// ⚠ **A different SHAPE and not just a different colour**, the rule
// the other three already keep: an arrow, a disc, a ring and now a
// cross, so the four are told apart in greyscale and at a zoom where
// a hex is a dozen pixels.  `entity_view.loft::entity_colour` states
// the same rule for the things the game draws — *distinct is not
// distinguishable*.
//
// ⚠ **The marker says a plate is HERE and never whether it is armed.**
// A spent trap looks exactly like a live one in the editor, because
// the editor draws the MAP and being spent is something a RUN did
// (`markers.loft` § MARKER_KIND_TRAP).  What a player should see is
// `DESIGN.md` § Two surface signals' job and nothing here draws it.
pub const TRAP_COLOR:       integer = 0xf09020;
pub const TRAP_GHOST_COLOR: integer = 0x785010;   // dimmer for hover
pub const TRAP_R_M:         float   = 0.32;

// Unit forward vector in world metres for a hex direction d ∈ 0..5.
//
// ⚠ Comes from the LATTICE (plan 09 C4), not from an angle table.
// It used to be `(sin θ, cos θ)` with `θ = d · π/3` — d=0 pointing
// south, to match axial `+r`.  Both halves of that are now wrong:
// direction 0 is EAST in `hex_grid`'s compass, and the step order
// runs the other way round.
//
// Deriving it from `lat_neighbour` rather than restating the angles
// is what stops a direction meaning one thing to the enemy that
// walks it and another to the arrow drawn over it.  A spawn arrow
// that lies about where the wave comes from is a bug the player
// discovers by losing.
pub fn direction_unit(d: u8) -> (float, float) {
    lat_direction_unit(d as integer)
}

// Draw a spawn-arrow triangle at the (q, r) hex centre, pointing
// in `direction`.  `filled` controls fill vs outline (outline is
// used for the hover-ghost preview in marker mode).
pub fn draw_marker_arrow(
    cv:        Canvas,
    cam:       EditorCamera,
    q:         integer,
    r:         integer,
    direction: u8,
    color:     integer,
    cw:        integer,
    ch:        integer,
    ppm:       float,
    filled:    boolean,
) {
    // Hex centre in pixel coords (float).  Inlined from
    // render.loft's world_to_canvas so we keep floats throughout;
    // loft's parser doesn't accept `(tuple.N as float)` on a
    // tuple local, so casting `world_to_canvas`'s integer return
    // is awkward.  Math is identical.
    dma_camw  = lat_to_metres(cam.pos);
    dma_world = lat_to_metres(Hex { q: q, r: r });
    dma_dx_m  = dma_world.0 - dma_camw.0;
    dma_dy_m  = dma_world.1 - dma_camw.1;
    dma_cx    = (cw as float) * 0.5 + dma_dx_m * ppm + 0.5;
    dma_cy    = (ch as float) * 0.5 + dma_dy_m * ppm + 0.5;

    dma_fwd = direction_unit(direction);
    dma_fx  = dma_fwd.0;
    dma_fy  = dma_fwd.1;
    // Perpendicular: (fy, -fx) — rotate forward 90° CCW in
    // canvas-y-down coordinates.  Used to splay the two base
    // vertices either side of the arrow's centre line.
    dma_px = dma_fy;
    dma_py = -dma_fx;

    dma_tip_x  = dma_cx + ARROW_LEN_M * ppm * dma_fx;
    dma_tip_y  = dma_cy + ARROW_LEN_M * ppm * dma_fy;
    dma_back_x = dma_cx - ARROW_BASE_M * ppm * dma_fx;
    dma_back_y = dma_cy - ARROW_BASE_M * ppm * dma_fy;

    dma_a_x = dma_back_x + ARROW_HALF_W * ppm * dma_px;
    dma_a_y = dma_back_y + ARROW_HALF_W * ppm * dma_py;
    dma_b_x = dma_back_x - ARROW_HALF_W * ppm * dma_px;
    dma_b_y = dma_back_y - ARROW_HALF_W * ppm * dma_py;

    dma_tx = dma_tip_x as integer;
    dma_ty = dma_tip_y as integer;
    dma_ax = dma_a_x as integer;
    dma_ay = dma_a_y as integer;
    dma_bx = dma_b_x as integer;
    dma_by = dma_b_y as integer;

    if filled {
        cv.fill_triangle(dma_tx, dma_ty, dma_ax, dma_ay, dma_bx, dma_by, color);
    } else {
        cv.draw_line(dma_tx, dma_ty, dma_ax, dma_ay, color);
        cv.draw_line(dma_ax, dma_ay, dma_bx, dma_by, color);
        cv.draw_line(dma_bx, dma_by, dma_tx, dma_ty, color);
    }
}

// Draw a target bullseye at the (q, r) hex centre.  Filled =
// two concentric filled circles (red ring + white centre);
// outline = two ring outlines (for hover-ghost previews).
pub fn draw_target_marker(
    cv:     Canvas,
    cam:    EditorCamera,
    q:      integer,
    r:      integer,
    cw:     integer,
    ch:     integer,
    ppm:    float,
    filled: boolean,
) {
    // Same inline world→canvas math as draw_marker_arrow —
    // keeps floats end-to-end so the (tuple.N as float) parser
    // bug doesn't bite.
    dtm_camw  = lat_to_metres(cam.pos);
    dtm_world = lat_to_metres(Hex { q: q, r: r });
    dtm_dx_m  = dtm_world.0 - dtm_camw.0;
    dtm_dy_m  = dtm_world.1 - dtm_camw.1;
    dtm_cx_f  = (cw as float) * 0.5 + dtm_dx_m * ppm + 0.5;
    dtm_cy_f  = (ch as float) * 0.5 + dtm_dy_m * ppm + 0.5;
    dtm_cx    = dtm_cx_f as integer;
    dtm_cy    = dtm_cy_f as integer;

    dtm_outer = (TARGET_OUTER_R_M * ppm) as integer;
    dtm_inner = (TARGET_INNER_R_M * ppm) as integer;
    if dtm_outer < 3 { dtm_outer = 3; }
    if dtm_inner < 1 { dtm_inner = 1; }

    if filled {
        cv.fill_circle(dtm_cx, dtm_cy, dtm_outer, TARGET_OUTER_COLOR);
        cv.fill_circle(dtm_cx, dtm_cy, dtm_inner, TARGET_INNER_COLOR);
    } else {
        cv.draw_circle(dtm_cx, dtm_cy, dtm_outer, TARGET_GHOST_COLOR);
        cv.draw_circle(dtm_cx, dtm_cy, dtm_inner, TARGET_GHOST_COLOR);
    }
}

// Draw a tower at the (q, r) hex centre — a ring, filled as a thick
// band and outlined as a single circle for the hover ghost.
pub fn draw_tower_marker(
    cv:     Canvas,
    cam:    EditorCamera,
    q:      integer,
    r:      integer,
    cw:     integer,
    ch:     integer,
    ppm:    float,
    filled: boolean,
) {
    // The same inline world→canvas maths the other two markers use —
    // floats end to end, so the `(tuple.N as float)` parser bug does
    // not bite.
    dtw_camw  = lat_to_metres(cam.pos);
    dtw_world = lat_to_metres(Hex { q: q, r: r });
    dtw_cx    = ((cw as float) * 0.5 + (dtw_world.0 - dtw_camw.0) * ppm + 0.5) as integer;
    dtw_cy    = ((ch as float) * 0.5 + (dtw_world.1 - dtw_camw.1) * ppm + 0.5) as integer;

    dtw_outer = (TOWER_R_M * ppm) as integer;
    if dtw_outer < 3 { dtw_outer = 3; }
    dtw_inner = (dtw_outer * 2) / 3;
    if dtw_inner < 1 { dtw_inner = 1; }

    if filled {
        // A band rather than a disc: fill out, then punch the middle
        // back to the hex under it would need the ground colour, so
        // the inner circle is drawn as an outline instead and the
        // silhouette stays a ring.
        cv.draw_circle(dtw_cx, dtw_cy, dtw_outer, TOWER_COLOR);
        cv.draw_circle(dtw_cx, dtw_cy, dtw_outer - 1, TOWER_COLOR);
        cv.draw_circle(dtw_cx, dtw_cy, dtw_inner, TOWER_COLOR);
    } else {
        cv.draw_circle(dtw_cx, dtw_cy, dtw_outer, TOWER_GHOST_COLOR);
        cv.draw_circle(dtw_cx, dtw_cy, dtw_inner, TOWER_GHOST_COLOR);
    }
}

// Draw a trap plate at the (q, r) hex centre — an X of two crossed
// lines, thickened by a second pair one pixel off when it is placed
// and left thin for the hover ghost.
pub fn draw_trap_marker(
    cv:     Canvas,
    cam:    EditorCamera,
    q:      integer,
    r:      integer,
    cw:     integer,
    ch:     integer,
    ppm:    float,
    filled: boolean,
) {
    // The same inline world→canvas maths the other three markers use —
    // floats end to end, so the `(tuple.N as float)` parser bug does
    // not bite.
    dtp_camw  = lat_to_metres(cam.pos);
    dtp_world = lat_to_metres(Hex { q: q, r: r });
    dtp_cx    = ((cw as float) * 0.5 + (dtp_world.0 - dtp_camw.0) * ppm + 0.5) as integer;
    dtp_cy    = ((ch as float) * 0.5 + (dtp_world.1 - dtp_camw.1) * ppm + 0.5) as integer;

    dtp_a = (TRAP_R_M * ppm) as integer;
    if dtp_a < 3 { dtp_a = 3; }

    dtp_col = if filled { TRAP_COLOR } else { TRAP_GHOST_COLOR };
    cv.draw_line(dtp_cx - dtp_a, dtp_cy - dtp_a,
                 dtp_cx + dtp_a, dtp_cy + dtp_a, dtp_col);
    cv.draw_line(dtp_cx - dtp_a, dtp_cy + dtp_a,
                 dtp_cx + dtp_a, dtp_cy - dtp_a, dtp_col);
    if filled {
        // A second pair one pixel down gives the cross a body without
        // a fill primitive — the same trick `draw_tower_marker` plays
        // with two circles one radius apart.
        cv.draw_line(dtp_cx - dtp_a, dtp_cy - dtp_a + 1,
                     dtp_cx + dtp_a, dtp_cy + dtp_a + 1, dtp_col);
        cv.draw_line(dtp_cx - dtp_a, dtp_cy + dtp_a + 1,
                     dtp_cx + dtp_a, dtp_cy - dtp_a + 1, dtp_col);
    }
}

// Hover preview for a trap — thin cross, at the hovered hex.
pub fn render_ghost_trap(
    cv:  Canvas,
    cam: EditorCamera,
    q:   integer,
    r:   integer,
    cw:  integer,
    ch:  integer,
    ppm: float,
) {
    draw_trap_marker(cv, cam, q, r, cw, ch, ppm, false);
}

// Hover preview for a tower — outline only, at the hovered hex.
pub fn render_ghost_tower(
    cv:  Canvas,
    cam: EditorCamera,
    q:   integer,
    r:   integer,
    cw:  integer,
    ch:  integer,
    ppm: float,
) {
    draw_tower_marker(cv, cam, q, r, cw, ch, ppm, false);
}

// Iterate the marker world and draw each placed marker per its
// kind: spawn → hot-pink arrow oriented per direction, target →
// red/white bullseye.  Sparse — most hexes have nothing.
pub fn render_markers(
    cv:  Canvas,
    cam: EditorCamera,
    mw:  MarkerWorld,
    cw:  integer,
    ch:  integer,
    ppm: float,
) {
    for rm_e in mw.markers {
        if rm_e.kind == MARKER_KIND_SPAWN as u8 {
            draw_marker_arrow(cv, cam,
                              rm_e.q, rm_e.r, rm_e.direction,
                              ARROW_COLOR,
                              cw, ch, ppm, true);
        } else if rm_e.kind == MARKER_KIND_TARGET as u8 {
            draw_target_marker(cv, cam,
                               rm_e.q, rm_e.r,
                               cw, ch, ppm, true);
        } else if rm_e.kind == MARKER_KIND_TOWER as u8 {
            draw_tower_marker(cv, cam,
                              rm_e.q, rm_e.r,
                              cw, ch, ppm, true);
        } else if rm_e.kind == MARKER_KIND_TRAP as u8 {
            draw_trap_marker(cv, cam,
                             rm_e.q, rm_e.r,
                             cw, ch, ppm, true);
        }
    }
}

// Hover preview — outline-only triangle at the hovered hex,
// pointing in the editor's currently selected place-direction.
// Lets the player see where + which way the next click will
// drop a spawn marker.
pub fn render_ghost_arrow(
    cv:        Canvas,
    cam:       EditorCamera,
    q:         integer,
    r:         integer,
    direction: u8,
    cw:        integer,
    ch:        integer,
    ppm:       float,
) {
    draw_marker_arrow(cv, cam, q, r, direction,
                      ARROW_GHOST_COLOR, cw, ch, ppm, false);
}

// Hover preview — outline-only bullseye at the hovered hex.
// Used when the editor's place-kind is TARGET.
pub fn render_ghost_target(
    cv:  Canvas,
    cam: EditorCamera,
    q:   integer,
    r:   integer,
    cw:  integer,
    ch:  integer,
    ppm: float,
) {
    draw_target_marker(cv, cam, q, r, cw, ch, ppm, false);
}

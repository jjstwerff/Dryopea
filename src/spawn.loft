//
// Spawn director + wave engine — runtime spawn execution.
//
// At wave start, `spawn_wave` emits N enemies, each at an
// active spawn marker (= a placed marker outside the
// close-spawn-disable radius from the core).  Each enemy's
// initial heading = the marker's `direction` field.
//
// Marker selection is **round-robin** through the active
// markers — a cursor in `WaveState` advances per spawn.
// Deterministic + testable; the eventual game's "feels random"
// texture comes from the marker positions themselves (the
// designer authors multiple-direction layouts), not from RNG.
// Loft doesn't yet expose a user-callable RNG; round-robin
// is the simplest substitute that produces multi-direction
// pressure without the RNG dependency.
//
// Approach mode: an enemy walks one hex per tick along its
// heading direction — and since plan 11 F1b it STOPS in front of
// ground its class cannot cross, which is what makes a wall a
// wall.  Still no flow field, no engage-mode hand-off and no
// death/HP: those are plan 11 F5 / F5b and the combat work after.
//
// Plan 03 phase M5; the walk's passability is plan 11 F1b.

use world;
use markers;
use palette;
use painted;
use passable;
use flow;

// The kind discriminants an `Enemy` carries — `ENEMY_KIND_REGULAR`
// and friends — live in `passable.loft`, because a class IS its
// climb limit as far as movement is concerned and the mover has to
// be able to ask (plan 11 F1b).  They are in scope here through the
// `use` above; the validation tier still emits only regulars.

// One enemy on the map.  Mixes integer (q, r) with u8
// (kind, heading) fields.  Not serialised today — vector<Enemy>
// stays in memory only — so the QUESTIONS_FOR_LOFT.md
// `:j`/vector-u8 corruption bug doesn't apply.  If enemies ever
// need on-disk persistence, mirror the painted-layer pattern:
// widen u8 → integer in a separate on-disk struct.
pub struct Enemy {
    q:       integer,
    r:       integer,
    kind:    u8,
    heading: u8,
    alive:   boolean,
}

// Wave-engine state.  `enemies` is the running roster across
// the current wave (and the future across-waves view); per-wave
// metadata lives here too.  `pick_cursor` is the round-robin
// index into the active-marker set, advancing every spawn.
pub struct WaveState {
    enemies:     vector<Enemy>,
    pick_cursor: integer,
}

// Factory: a fresh wave state with no enemies and a cursor at 0.
pub fn wave_state_empty() -> WaveState {
    WaveState { enemies: [], pick_cursor: 0 }
}

// ⚠ `hex_offset` — the 6-direction table an enemy heading steps
// along — now lives in `world.loft` § The neighbour relation, and is
// in scope here through `use world;`.  Plan 11 F2 moved it: the
// flow field is built from the same relation, and a wave engine is
// the wrong owner for the geometry of the whole world.  One table,
// one place for plan 09's lattice conversion to change.

// ─── Active markers (close-spawn-disable filter) ────────────────

// Return the subset of placed spawn markers that are AT LEAST
// `disable_radius` hexes from the core.  Markers within the
// radius are visible to the player (a safety signal — "this
// won't fire on you") but don't emit enemies.  Per DESIGN.md
// § Updates: free-pick landing.
//
// Returns a fresh vector copy so the caller can iterate without
// holding the hash open.  Order is iteration order of the
// underlying hash — stable within a single program run but not
// across runs (use index 0 etc as test fixtures only when the
// test placed exactly one marker, or use the round-robin
// cursor's behaviour to test order-independent properties).
pub fn active_spawn_markers(
    mw:             MarkerWorld,
    core_q:         integer,
    core_r:         integer,
    disable_radius: integer,
) -> vector<MarkerEntry> {
    asm_out: vector<MarkerEntry> = [];
    asm_core = Hex { q: core_q, r: core_r };
    for asm_e in mw.markers {
        if asm_e.kind == MARKER_KIND_SPAWN as u8 {
            asm_d = hex_distance(asm_core, Hex { q: asm_e.q, r: asm_e.r });
            if asm_d >= disable_radius {
                asm_out += [MarkerEntry {
                    q:         asm_e.q,
                    r:         asm_e.r,
                    kind:      asm_e.kind,
                    direction: asm_e.direction,
                }];
            }
        }
    }
    asm_out
}

// ─── Wave spawn + tick ──────────────────────────────────────────

// Spawn one wave's worth of enemies: emit `count` enemies, each
// at a different (round-robin) active marker, each with the
// marker's direction as its initial heading.  Appends to
// `state.enemies`; advances `state.pick_cursor` by `count`.
//
// No-op if there are zero active markers (an all-disabled map
// or an authoring mistake — the caller logs / surfaces).
pub fn spawn_wave(
    state:          WaveState,
    count:          integer,
    mw:             MarkerWorld,
    core_q:         integer,
    core_r:         integer,
    disable_radius: integer,
) {
    sw_active = active_spawn_markers(mw, core_q, core_r, disable_radius);
    sw_n = len(sw_active);
    if sw_n == 0 { return; }
    // `while` loop drops an unused loop counter; the `?? 0` and
    // `?? <fallback>` defensive operators silence the static
    // analyser's modulus / out-of-bounds warnings — both
    // invariants are guarded by the `sw_n == 0` early-return
    // above (sw_n > 0; pick_cursor % sw_n ∈ 0..sw_n-1).
    sw_remaining = count;
    while sw_remaining > 0 {
        sw_idx = (state.pick_cursor % sw_n) ?? 0;
        sw_m   = sw_active[sw_idx] ?? sw_active[0];
        state.enemies += [Enemy {
            q:       sw_m.q,
            r:       sw_m.r,
            kind:    ENEMY_KIND_REGULAR as u8,
            heading: sw_m.direction,
            alive:   true,
        }];
        state.pick_cursor = state.pick_cursor + 1;
        sw_remaining = sw_remaining - 1;
    }
}

// Advance one alive enemy by one hex along its heading — unless the
// hex it would enter is one its class cannot hold, in which case it
// STAYS PUT.  Plan 11 F1b.
//
// Dead enemies are a no-op (the runtime keeps them in the roster for
// post-mortem accounting; final-wave-clear checks alive_count to
// gate "wave done").
//
// ── The world is a parameter, and deliberately not optional ─────
//
// It would have been one line to give `pal` / `pw` defaults and keep
// every existing caller compiling.  That would make the passability
// check skippable, and a caller that skipped it would walk enemies
// through walls exactly as this phase's own negative control did —
// silently, because an empty palette answers "no ground anywhere".
// So the signature changed and every call site was made to say which
// world it ticks against.  The compile errors were the point.
//
// ── What a blocked enemy does ───────────────────────────────────
//
// Nothing, today.  It still wants the core
// (`docs/ENEMY_MOVEMENT.md` § Two modes: "An enemy never halts
// permanently.  Blocked, it attacks"), but there is no combat yet,
// so approach mode's whole answer to a wall is to stop in front of
// it.  Stopping is what makes the wall a wall; the attack is F5+ and
// the routing round it is F5.
pub fn enemy_tick(e: Enemy, pal: vector<GroundType>, pw: PaintedWorld, f: FlowField) {
    if !e.alive { return; }

    // ── Engage: follow the field (plan 11 F5) ───────────────────
    //
    // The field is per class and already refuses every hex this class
    // cannot hold, so a step down it needs no passability check of
    // its own — `flow_build` did it.
    et_d = flow_distance(f, e.q, e.r);
    if et_d == 0 { return; }                    // arrived; attacking the core is combat's job
    if et_d < FLOW_UNREACHABLE {
        et_t = flow_step(f, e.q, e.r);
        // F3's sweep proves the arrow never stalls on a reachable
        // cell, so this moves.  If it ever did not, standing still is
        // the right answer — a stalled field is not a licence to
        // wander off the route.
        e.q = et_t.q;
        e.r = et_t.r;
        return;
    }

    // ── Approach: no route, so walk the heading (plan 11 F1b) ───
    //
    // ⚠ **"Has a route" is a STAND-IN for the real mode selector**,
    // and two later phases replace it:
    //
    //   * F5b makes the mode depend on the scrambler bubble — outside
    //     it an enemy follows its spawn heading even when a route
    //     exists, which is what `docs/ENEMY_MOVEMENT.md` § Two modes
    //     actually specifies;
    //   * F7 replaces this fallback for an enemy with NO route: it
    //     follows a second field (walls passable) and attacks the
    //     first impassable hex it meets, rather than walking a
    //     heading into it.
    //
    // Until then this composition is what keeps both behaviours
    // alive: an enemy that can reach the core routes to it, and one
    // that cannot still presses in along its heading and stops at
    // what it cannot cross.
    et_off = hex_offset(e.heading);
    et_q = e.q + et_off.0;
    et_r = e.r + et_off.1;
    // ⚠ ONE rule, shared with the `enemies passable` assertion that
    // measures it (`passable.loft`).  If the mover and the
    // measurement each had their own idea of passability, a green
    // gate would only prove the two agreed — not that either was
    // right.
    if !can_occupy(pal, pw, e.kind, et_q, et_r) { return; }
    e.q = et_q;
    e.r = et_r;
}

// Has any enemy of this kind been spawned into the roster?
//
// Used to skip building a field no enemy would read — two BFS sweeps
// per tick would cost little, but a field built for nobody is also a
// number in a profile that nobody can explain.
fn wave_has_kind(state: const WaveState, kind: integer) -> boolean {
    whk_any = false;
    for whk_e in state.enemies {
        if whk_e.alive && (whk_e.kind as integer) == kind { whk_any = true; }
    }
    whk_any
}

fn kind_already_done(done: vector<integer>, kind: integer) -> boolean {
    kad_seen = false;
    for kad_k in done {
        if kad_k == kind { kad_seen = true; }
    }
    kad_seen
}

// Advance the whole wave by one game-tick.
//
// ── The field is rebuilt ONCE per tick, before anybody moves ─────
//
// `docs/ENEMY_MOVEMENT.md` § The tick resolves once: within a tick
// every enemy acts against the same world.  That is not primarily a
// cost decision — it is what makes a tick ORDER-INDEPENDENT, and so
// what makes a scripted run reproducible, which is the premise plan
// 08 gates on.  A field rebuilt mid-loop would make the outcome
// depend on which enemy the roster happened to visit first, and no
// `.keys` scenario could assert a stable number over that.
//
// The invariant that holds it: the same wave, played with the roster
// iterated in REVERSE, produces an identical result.
//
// ── One field per CLASS, built for the classes present ──────────
//
// A wall stops a robot and an insect climbs it, so they do not share
// a field (plan 11 F0: passability is boolean, so nothing weighs an
// edge — it is separate fields, not one field with costs).  The
// roster decides which get built: the classes actually in it, each
// once, rather than a field per class the game knows about.
//
// ⚠ **From scratch every tick, deliberately.**  F8 makes it
// incremental, and its gate is equality with this — so this path
// stays the reference implementation and is not optimised away.
pub fn wave_tick(state: WaveState, pal: vector<GroundType>, pw: PaintedWorld, core: Hex) {
    wt_done: vector<integer> = [];
    for wt_e in state.enemies {
        wt_k = wt_e.kind as integer;
        if !kind_already_done(wt_done, wt_k) && wave_has_kind(state, wt_k) {
            wt_done += [wt_k];
            wt_f = flow_build(pal, pw, wt_e.kind, core);
            for wt_o in state.enemies {
                if (wt_o.kind as integer) == wt_k {
                    enemy_tick(wt_o, pal, pw, wt_f);
                }
            }
        }
    }
}

// Count of alive enemies in the wave — wave-clear check.
pub fn alive_count(state: WaveState) -> integer {
    ac_n = 0;
    for ac_e in state.enemies {
        if ac_e.alive { ac_n = ac_n + 1; }
    }
    ac_n
}

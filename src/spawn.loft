// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Spawn director + wave engine — runtime spawn execution.
//
// At wave start, `spawn_wave` emits N enemies, each at an
// active spawn marker (= a placed marker outside the
// close-spawn-disable radius from the core).  Each enemy's
// initial heading = the marker's `direction` field.
//
// Marker selection is **round-robin** through the active
// markers — a cursor in `WaveState` advances per spawn.
// Deterministic + testable; the eventual game's "feels random"
// texture comes from the marker positions themselves (the
// designer authors multiple-direction layouts), not from RNG.
// Loft doesn't yet expose a user-callable RNG; round-robin
// is the simplest substitute that produces multi-direction
// pressure without the RNG dependency.
//
// Movement is `enemy_tick`, and it has three rules on top of each
// other: the scrambler bubble picks the mode (F5b — heading outside,
// flow field inside), the height step says what ground the class can
// hold (F1b), and companions block a step (F5c — enemies spread, they
// do not stack).  No death/HP yet: that is the combat work after.
//
// Plan 03 phase M5; the walk's passability is plan 11 F1b, the routing
// F5/F5b, the occupancy F5c.

use lattice;
use markers;
use palette;
use painted;
use height;
use passable;
use flow;
use occupancy;
use damage;

// The radius of the core's comms-jamming bubble, in hexes — the
// boundary where an enemy stops following its spawn heading and starts
// following the flow field (`docs/ENEMY_MOVEMENT.md` § Two modes).
//
// `examples/numbers.json` § core.scrambler_bubble_radius is where this
// number lives; it is restated here because nothing loads numbers.json
// yet, exactly as `script.loft` restates the spawn-disable radius.
// When a loader lands, this reads from it instead of holding a second
// copy.
pub const SCRAMBLER_BUBBLE_RADIUS: integer = 25;

// ─── What a tick is worth, in seconds (plan 12 B0) ──────────────
//
// `examples/numbers.json` § enemy_regular.speed_engage, restated here
// for the same reason as the bubble radius above: nothing loads that
// file yet.
//
// ⚠ **The tick's duration is DERIVED, not chosen.**  `enemy_tick`
// advances an enemy by exactly one hex, and the design says an enemy
// covers 1.5 hexes a second — so a tick is 1/1.5 s and there is no
// second opinion to have about it.  `tests/12_b0_probe.loft` measures
// the one-hex half against the running mover, which is what makes this
// a derivation rather than a pair of numbers that happen to agree.
pub const ENEMY_SPEED_HEX_PER_SECOND: float = 1.5;
pub const TICK_SECONDS: float = 1.0 / ENEMY_SPEED_HEX_PER_SECOND;

// ── Why the SECONDS survive into the engine (plan 12 B0) ────────
//
// Every damage number in `numbers.json` is a per-SECOND rate — 1 pt/s
// of wallet drain, 1 HP/s into a wall, one tower shot a second — and
// plan 12 had a real fork open: convert them to per-tick once at the
// numbers boundary, or keep seconds and let each site multiply.
//
// B0 measured the fork rather than arguing it, and the tower settles
// it: a 1.0 s fire interval is **1.5 ticks**.  It is not a count of
// anything, so a per-tick integer cadence cannot express the design's
// own numbers, and rounding it either way changes the tower's DPS by
// 33%.  The same goes for the 5.0 s scramble window (7.5 ticks) and
// the 15.0 s inter-wave delay (22.5).
//
// So the boundary conversion is not available, `numbers.json` keeps
// saying `HP/s` — which is also what makes it moddable, since a
// per-tick number is unreadable to anyone outside this engine — and a
// rate reaches the sim by being multiplied by `TICK_SECONDS` at the
// point it is applied.  `wave_damage` (B2) is the first site.
pub fn per_tick(rate_per_second: float) -> float {
    rate_per_second * TICK_SECONDS
}

// What a besieging enemy does to the wall it cannot climb, per second
// — `numbers.json` § enemy_regular.damage_to_wall, restated here for
// the same reason the speed is.
//
// ⚠ **One rate for every class**, and that is the file's shape rather
// than a simplification: `numbers.json` has an `enemy_regular` section
// and no `enemy_insect` one, so a second number would be a tunable
// this plan invented.  When insects get a section they get a rate, and
// this becomes a lookup like `climb_limit`.
//
// Slow on purpose.  100 HP at 1 HP/s is 100 s — 150 ticks — for one
// robot, so breaking a wall is a rare path rather than the default
// way in, and a base only falls to a wave that stays on it.
pub const ENEMY_DAMAGE_TO_WALL_PER_SECOND: float = 1.0;

// The kind discriminants an `Enemy` carries — `ENEMY_KIND_REGULAR`
// and friends — live in `passable.loft`, because a class IS its
// climb limit as far as movement is concerned and the mover has to
// be able to ask (plan 11 F1b).  They are in scope here through the
// `use` above; the validation tier still emits only regulars.

// One enemy on the map.  Mixes integer (q, r) with u8
// (kind, heading) fields.  Not serialised today — vector<Enemy>
// stays in memory only — so the QUESTIONS_FOR_LOFT.md
// `:j`/vector-u8 corruption bug doesn't apply.  If enemies ever
// need on-disk persistence, mirror the painted-layer pattern:
// widen u8 → integer in a separate on-disk struct.
// ⚠ `taken` is damage ABSORBED, not HP remaining, and the choice is
// the same one `damage.loft` makes for structures — with a second
// reason here that CLAUDE.md § Loft language gotchas spells out: a
// struct literal that omits a field takes that field's DEFAULT
// silently, so in a struct callers build field by field the neutral
// value must be the ZERO value.  Store HP remaining and every
// `Enemy { … }` literal in the suite that predates plan 12 B4 spawns a
// corpse.
pub struct Enemy {
    q:       integer,
    r:       integer,
    kind:    u8,
    heading: u8,
    alive:   boolean,
    taken:   float,
}

// What this enemy has left, in HP — 0.0 once it has absorbed its whole
// allowance.
pub fn enemy_hp(e: const Enemy) -> float {
    max(enemy_max_hp(e.kind) - e.taken, 0.0)
}

// Land `hp` of damage on one enemy.
//
// ⚠ **It does not kill.**  Death is `wave_deaths`, at the end of a
// tick, for the same reason `damage_apply` does not break a wall: one
// death path, so the tower B5 builds and the `hit` a script types
// cannot drift apart.  An enemy at 0 HP is a walking dead man until
// the tick resolves, which is exactly what "the tick resolves once"
// means (`docs/ENEMY_MOVEMENT.md`).
pub fn enemy_hurt(e: Enemy, hp: float) {
    e.taken = max(e.taken + hp, 0.0);
}

// Wave-engine state.  `enemies` is the running roster across
// the current wave (and the future across-waves view); per-wave
// metadata lives here too.  `pick_cursor` is the round-robin
// index into the active-marker set, advancing every spawn.
//
// ⚠ `heights` is the RUNTIME rubble layer (plan 11 F6, plan 12 B1) —
// what bodies and broken walls have piled on the map — and `damage` is
// the ledger of what every structure has absorbed (plan 12 B2).  Both
// ride here rather than on the world because plan 11 says where they
// belong: *pile heights live with the wave, not in the save*.  A wave
// is also the thing whose lifetime they share, and no save file ever
// has to learn a field it should not keep.
//
// ⚠ The BREAK is the exception, and it is deliberate: a broken wall
// really is gone, so `damage.loft::break_structure` edits the painted
// world.  Only the heap it leaves is runtime.
pub struct WaveState {
    enemies:     vector<Enemy>,
    pick_cursor: integer,
    heights:     HeightLayer,
    damage:      DamageLayer,
}

// Factory: a fresh wave state with no enemies, a cursor at 0 and the
// map exactly as painted.
pub fn wave_state_empty() -> WaveState {
    WaveState {
        enemies: [], pick_cursor: 0,
        heights: height_layer_empty(),
        damage:  damage_layer_empty(),
    }
}

// ⚠ An enemy heading steps through `lat_neighbour` (`use lattice;`),
// and there is NO 6-direction offset table to reach for.  Plan 11 F2
// moved `hex_offset` out of here — the flow field is built from the
// same relation, and a wave engine is the wrong owner for the
// geometry of the whole world — and plan 09 C6 then deleted the table
// itself: in odd-r the delta depends on row parity, so a constant
// `(dq, dr)` table does not exist.  One relation, one place.

// ─── Active markers (close-spawn-disable filter) ────────────────

// Return the subset of placed spawn markers that are AT LEAST
// `disable_radius` hexes from the core.  Markers within the
// radius are visible to the player (a safety signal — "this
// won't fire on you") but don't emit enemies.  Per DESIGN.md
// § Updates: free-pick landing.
//
// Returns a fresh vector copy so the caller can iterate without
// holding the hash open.  Order is iteration order of the
// underlying hash — stable within a single program run but not
// across runs (use index 0 etc as test fixtures only when the
// test placed exactly one marker, or use the round-robin
// cursor's behaviour to test order-independent properties).
pub fn active_spawn_markers(
    mw:             MarkerWorld,
    core_q:         integer,
    core_r:         integer,
    disable_radius: integer,
) -> vector<MarkerEntry> {
    asm_out: vector<MarkerEntry> = [];
    asm_core = Hex { q: core_q, r: core_r };
    for asm_e in mw.markers {
        if asm_e.kind == MARKER_KIND_SPAWN as u8 {
            asm_d = lat_distance(asm_core, Hex { q: asm_e.q, r: asm_e.r });
            if asm_d >= disable_radius {
                asm_out += [MarkerEntry {
                    q:         asm_e.q,
                    r:         asm_e.r,
                    kind:      asm_e.kind,
                    direction: asm_e.direction,
                }];
            }
        }
    }
    asm_out
}

// ─── Wave spawn + tick ──────────────────────────────────────────

// Spawn one wave's worth of enemies: emit `count` enemies of class
// `kind`, each at a different (round-robin) active marker, each with
// the marker's direction as its initial heading.  Appends to
// `state.enemies`; advances `state.pick_cursor` by `count`.
//
// ⚠ `kind` is a parameter and not a default (plan 11 F6).  Until F6
// every enemy the game could emit was a robot, so no scenario could
// state the thing the per-class field exists for — *an insect crosses
// what a robot must walk around*.  A default would have kept that
// untestable from a `.keys` script while looking like it worked, which
// is the shape plan 08 § The instrument comes first is about.
//
// No-op if there are zero active markers (an all-disabled map
// or an authoring mistake — the caller logs / surfaces).
pub fn spawn_wave(
    state:          WaveState,
    count:          integer,
    kind:           u8,
    mw:             MarkerWorld,
    core_q:         integer,
    core_r:         integer,
    disable_radius: integer,
) {
    sw_active = active_spawn_markers(mw, core_q, core_r, disable_radius);
    sw_n = len(sw_active);
    if sw_n == 0 { return; }
    // `while` loop drops an unused loop counter; the `?? 0` and
    // `?? <fallback>` defensive operators silence the static
    // analyser's modulus / out-of-bounds warnings — both
    // invariants are guarded by the `sw_n == 0` early-return
    // above (sw_n > 0; pick_cursor % sw_n ∈ 0..sw_n-1).
    sw_remaining = count;
    while sw_remaining > 0 {
        sw_idx = (state.pick_cursor % sw_n) ?? 0;
        sw_m   = sw_active[sw_idx] ?? sw_active[0];
        state.enemies += [Enemy {
            q:       sw_m.q,
            r:       sw_m.r,
            kind:    kind,
            heading: sw_m.direction,
            alive:   true,
        }];
        state.pick_cursor = state.pick_cursor + 1;
        sw_remaining = sw_remaining - 1;
    }
}

// Advance one alive enemy by one hex along its heading — unless the
// hex it would enter is one its class cannot hold, in which case it
// STAYS PUT.  Plan 11 F1b.
//
// Dead enemies are a no-op (the runtime keeps them in the roster for
// post-mortem accounting; final-wave-clear checks alive_count to
// gate "wave done").
//
// ── The world is a parameter, and deliberately not optional ─────
//
// It would have been one line to give `pal` / `pw` defaults and keep
// every existing caller compiling.  That would make the passability
// check skippable, and a caller that skipped it would walk enemies
// through walls exactly as this phase's own negative control did —
// silently, because an empty palette answers "no ground anywhere".
// So the signature changed and every call site was made to say which
// world it ticks against.  The compile errors were the point.
//
// ── What a blocked enemy does ───────────────────────────────────
//
// Nothing, today.  It still wants the core
// (`docs/ENEMY_MOVEMENT.md` § Two modes: "An enemy never halts
// permanently.  Blocked, it attacks"), but there is no combat yet,
// so approach mode's whole answer to a wall is to stop in front of
// it.  Stopping is what makes the wall a wall; the attack is F5+ and
// the routing round it is F5.
pub fn enemy_tick(e: Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                  hl: const HeightLayer, f: const FlowField, desire: const FlowField,
                  occ: Occupancy) {
    if !e.alive { return; }

    // ── Which mode? The bubble decides (plan 11 F5b) ─────────────
    //
    // `docs/ENEMY_MOVEMENT.md` § Two modes: outside the scrambler
    // bubble an enemy follows its spawn marker's heading; inside it,
    // the field toward the core.  The boundary IS the handoff.
    //
    // The field carries the core it was built for, so the test needs
    // no extra parameter — which is why `FlowField` keeps it.
    if !enemy_in_bubble(e, f.core) {
        enemy_walk_heading(e, pal, pw, hl, occ);
        return;
    }

    // ── Engage: follow the field (plan 11 F5) ───────────────────
    //
    // The field is per class and already refuses every hex this class
    // cannot hold, so a step down it needs no passability check of
    // its own — `flow_build` did it.  What it does NOT know is who is
    // standing where, which is this phase (F5c): take the first FREE
    // step in preference order, and stand still when every one of them
    // is held.
    //
    // ⚠ **Free, but still strictly CLOSER.**  A blocked enemy does not
    // sidestep to an equally-distant hex to get round the jam: every
    // entry `flow_steps` offers is at `d - 1`, so an enemy either
    // closes by exactly one step or does not move — which is what
    // keeps F5's invariant (`distance decreases by exactly 1 per tick`)
    // true of every enemy that moves at all, and keeps occupancy a
    // movement constraint rather than a second steering rule.  The
    // sideways spread the spec describes at a WALL belongs to F7,
    // where the desire field supplies the gradient that says which way
    // "beside" is; inventing one here would be a second steering rule
    // with nothing to derive it from.
    et_d = flow_distance(f, e.q, e.r);
    if et_d == 0 { return; }                    // arrived; attacking the core is combat's job
    if et_d < FLOW_UNREACHABLE {
        for et_t in flow_steps(f, e.q, e.r) {
            if occupancy_taken(occ, et_t.q, et_t.r) { continue; }
            enemy_move_to(e, et_t.q, et_t.r, occ);
            return;
        }
        // F3's sweep proves the arrow never stalls on a reachable
        // cell, so the only way to get here is a companion on every
        // closer neighbour.  Standing still is the right answer — a
        // jam is not a licence to wander off the route.
        return;
    }

    // ── Inside the bubble, but with no route to the core ─────────
    //
    // The siege (plan 11 F7).  It still wants the core, so it walks
    // down the DESIRE field — the same sweep with walls passable — and
    // stops where the height rule refuses the next step.  That hex is
    // what it attacks, and `enemy_target` names it.
    //
    // ⚠ **Why a field and not "the nearest wall".**  A target computed
    // once from the perimeter hands every enemy the SAME hex and
    // collapses the siege back to one chokepoint, which is the thing
    // `docs/ENEMY_MOVEMENT.md` § Sealing the perimeter exists to
    // prevent.  Following each enemy's own gradient makes the target a
    // consequence of where it came from, so enemies from different
    // sides meet the wall at different hexes with nothing coordinating
    // them.
    enemy_walk_desire(e, pal, pw, hl, desire, occ);
}

// One step down the desire gradient, if the step is one this class can
// take and nobody is standing on it — plan 11 F7.
//
// The same shape as the engage branch, over the other field: take the
// first FREE and LEGAL entry in preference order, otherwise stand
// still.  `flow_steps` offers only strictly-closer hexes, so a besieging
// enemy never wanders away from the core while it looks for a way in.
//
// ⚠ Its steps are checked with `can_step` where the engage branch's are
// not, and that asymmetry is the point: the routing field already
// refused every hex this class cannot enter, while the desire field
// deliberately did NOT — walls are passable in it, which is what makes
// it able to say where the wall is.
fn enemy_walk_desire(e: Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                     hl: const HeightLayer, desire: const FlowField, occ: Occupancy) {
    ewd_from = Hex { q: e.q, r: e.r };
    for ewd_t in flow_steps(desire, e.q, e.r) {
        if !can_step(pal, pw, hl, e.kind, ewd_from, ewd_t) { continue; }
        if occupancy_taken(occ, ewd_t.q, ewd_t.r) { continue; }
        enemy_move_to(e, ewd_t.q, ewd_t.r, occ);
        return;
    }
}

// The hex this enemy is attacking — its own hex when it is attacking
// nothing.
//
// Plan 11 F7.  `docs/ENEMY_MOVEMENT.md` § Two modes: *"An enemy never
// halts permanently.  Blocked, it attacks — because it still wants the
// core."*  This says WHICH hex; the damage is combat's, and nothing
// here takes any.
//
// ⚠ **You attack what you could stand on and cannot climb.**  The
// target is always a hex whose SURFACE is walkable — a wall's top, a
// body pile — so an enemy at the water's edge is not besieging the
// sea.  In the siege branch that is free (every cell of the desire
// field is walkable by construction); approach mode has to ask.
//
// Returning the enemy's own hex for "nothing" follows `flow_step`'s
// convention: a caller that ignores the answer attacks nobody rather
// than attacking something arbitrary.
pub fn enemy_target(e: const Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                    hl: const HeightLayer, f: const FlowField, desire: const FlowField) -> Hex {
    ent_here = Hex { q: e.q, r: e.r };
    if !e.alive { return ent_here; }

    // Approach mode: the route is the heading, so the obstacle is the
    // one hex ahead.
    if !enemy_in_bubble(e, f.core) {
        ent_ahead = lat_neighbour(ent_here, e.heading as integer);
        if can_step(pal, pw, hl, e.kind, ent_here, ent_ahead) { return ent_here; }
        if !hex_walkable(pal, pw, hl, ent_ahead.q, ent_ahead.r) { return ent_here; }
        return ent_ahead;
    }

    // A route exists, so nothing is in the way: F6 guarantees every
    // step the routing field offers is one this class can take, and a
    // companion on it is a delay rather than a target (F5c — occupancy
    // is never attacked).
    if flow_reachable(f, e.q, e.r) { return ent_here; }

    // The siege: the first blocked step down the desire gradient — and
    // only when NOTHING down it is legal, because an enemy that can
    // still walk is not yet besieging anything.
    ent_first = ent_here;
    ent_found = false;
    for ent_t in flow_steps(desire, e.q, e.r) {
        if can_step(pal, pw, hl, e.kind, ent_here, ent_t) { return ent_here; }
        if !ent_found {
            ent_first = ent_t;
            ent_found = true;
        }
    }
    ent_first
}

// Move an enemy, keeping the occupancy it moves through in step with
// it.  ⚠ The two updates are ONE operation: an enemy that entered
// without leaving would block the hex behind it for the rest of the
// tick, and the enemies behind it would never advance.
fn enemy_move_to(e: Enemy, q: integer, r: integer, occ: Occupancy) {
    occupancy_leave(occ, e.q, e.r);
    occupancy_enter(occ, q, r);
    e.q = q;
    e.r = r;
}

// Is this enemy inside the core's scrambler bubble?
//
// ⚠ Measured as a STRAIGHT-LINE hex distance, not as a route length.
// The bubble is a comms-jamming sphere carved by the core
// (`docs/DESIGN.md` § core), so an enemy three hexes from the core
// with a forty-step route around a wall is INSIDE it — jamming does
// not care how far you would have to walk.  Using the field distance
// instead would make the bubble bulge and shrink as the player builds,
// which is not what the fiction or the numbers describe.
//
// Inclusive at the boundary, matching `active_spawn_markers`'
// `>= disable_radius`: the hex the radius names is in.
pub fn enemy_in_bubble(e: const Enemy, core: Hex) -> boolean {
    lat_distance(core, Hex { q: e.q, r: e.r }) <= SCRAMBLER_BUBBLE_RADIUS
}

// One step along the enemy's heading, if the hex it would enter is one
// its class can hold and nobody is standing on it — approach mode's
// whole movement rule (plan 11 F1b, plus F5c's occupancy).
//
// A heading has no alternatives: there is one hex ahead, so a blocked
// enemy simply stops one hex short.  That is enough for the thing F5c
// is for — a column pressing a wall ends on distinct hexes instead of
// piling onto the single hex in front of it — and it is all approach
// mode can honestly do, having no field to say which way "beside" is.
fn enemy_walk_heading(e: Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                      hl: const HeightLayer, occ: Occupancy) {
    et_from = Hex { q: e.q, r: e.r };
    et_to   = lat_neighbour(et_from, e.heading as integer);
    // ⚠ ONE rule, shared with the `enemies passable` assertion that
    // measures it (`passable.loft`).  If the mover and the
    // measurement each had their own idea of passability, a green
    // gate would only prove the two agreed — not that either was
    // right.
    //
    // The MOVE, not the destination (plan 11 F6): a hex an enemy
    // could stand on is not automatically one it can climb onto from
    // where it is now, and after F6 the two stop coinciding.
    if !can_step(pal, pw, hl, e.kind, et_from, et_to) { return; }
    if occupancy_taken(occ, et_to.q, et_to.r) { return; }
    enemy_move_to(e, et_to.q, et_to.r, occ);
}

// ─── The fields, one per CLIMB LIMIT in the roster ──────────────

// One climb limit's field for this tick.
pub struct ClassField {
    climb: float,
    field: FlowField,
}

// A field for every distinct CLIMB LIMIT among the alive enemies, each
// built once.
//
// Not a field per class the game knows about: a field built for nobody
// is a number in a profile that nobody can explain.  And not ONE
// shared field either — a wall stops a robot and an insect climbs it,
// so a shared field would move insects along a route computed for
// something that cannot climb (plan 11 F0: passability is boolean, so
// nothing weighs an edge — it is separate fields, not one with costs).
//
// ⚠ **Keyed by the climb limit and not by the class** (plan 11 F6).
// `climb_limit` is the class's whole contribution to passability, so
// two classes that climb the same distance produce IDENTICAL fields
// and building both is duplicated work that also invites them to
// drift.  It is not a guess: `tests/11_f6_height_step.loft` asserts
// that two kinds agreeing on their limit produce equal fields, so the
// day a class gains a second movement axis the key goes red instead of
// quietly sharing a field it should not.
pub fn wave_fields(state: const WaveState, pal: vector<GroundType>,
                   pw: PaintedWorld, core: Hex) -> vector<ClassField> {
    wf_out: vector<ClassField> = [];
    for wf_e in state.enemies {
        if wf_e.alive && !fields_have(wf_out, climb_limit(wf_e.kind)) {
            wf_out += [ClassField {
                climb: climb_limit(wf_e.kind),
                field: flow_build(pal, pw, state.heights, wf_e.kind, core),
            }];
        }
    }
    wf_out
}

fn fields_have(fields: const vector<ClassField>, climb: float) -> boolean {
    fh_seen = false;
    for fh_f in fields {
        if fh_f.climb == climb { fh_seen = true; }
    }
    fh_seen
}

// ─── Reading a class's field WITHOUT copying it ─────────────────
//
// Plan 11 F8, and it is the phase's whole finding.  There used to be a
// `field_of(fields, kind) -> FlowField` here, and every caller looked
// exactly right:
//
//     enemy_tick(e, pal, pw, hl, field_of(fields, e.kind), desire, occ)
//
// **`fo_out = fo_f.field` is a whole-value bind, which COPIES the heap
// value** — the entire cell hash, per enemy, per lookup.  Measured on a
// radius-40 world (4921 hexes, the haze radius `numbers.json` bounds
// the world at) with an 80-enemy wave, the largest the wave list goes:
//
//   | lookup                        | 80 calls |
//   |-------------------------------|----------|
//   | via `field_of`                | 162052 us |
//   | passing `cf.field` through    |     72 us |
//
// **2250x, and the copy is O(cells) where the read is O(1).**  It was
// 51% of a tick that already ran at 96% of its budget, and it had been
// there since F5 — invisible, because a copy changes no behaviour and
// dryopea has no gate that can see cost.
//
// So there is no accessor: a caller loops the fields and passes
// `cf.field` STRAIGHT into a `const` parameter.  Nothing binds a
// `FlowField` to a local in a per-enemy path, and the helpers below
// exist so that no caller has to remember why.

// How far this enemy's class thinks (q, r) is from the core.
fn field_distance(fields: const vector<ClassField>, kind: u8,
                  q: integer, r: integer) -> integer {
    fd_climb = climb_limit(kind);
    for fd_f in fields {
        if fd_f.climb == fd_climb { return flow_distance(fd_f.field, q, r); }
    }
    FLOW_UNREACHABLE
}

// ─── The move order ─────────────────────────────────────────────
//
// Plan 11 F5c.  Once companions block a step, WHO MOVES FIRST changes
// where everybody ends up — so the order has to be a property of the
// state and not of the roster, or `ENEMY_MOVEMENT.md` § The tick
// resolves once is lost and with it every scripted number plan 08
// gates on.
//
// ⚠ **Closest to the core moves first, and that is not arbitrary.**
// Measured (plan 11 § F5c): with the tail moving first, a column in a
// corridor stretches — each enemy is blocked by the one ahead, which
// has not moved yet, so only the leader advances and the follower
// falls a hex behind every tick.  Leader-first, the whole column steps
// into the space the one ahead has just left and advances in lockstep,
// which is what a queue in a corridor should look like.
//
// "Closest to the core" is the FIELD distance, so it means the same
// thing whichever compass direction the column runs; ordering on a
// coordinate would make a westbound column advance and an eastbound
// one stretch.
//
// The rest of the key only has to be deterministic and state-derived.
// Roster index is the LAST resort, and it can only decide between
// enemies that agree on distance, hex and class — which are
// interchangeable, so the multiset of outcomes cannot depend on it.
// That is the whole order-independence argument, and
// `tests/11_f5c_spread.loft` asserts it against a reversed roster.

struct MoveSlot {
    idx:   integer,
    dist:  integer,
    q:     integer,
    r:     integer,
    kind:  integer,
    taken: boolean,
}

fn slot_before(a: const MoveSlot, b: const MoveSlot) -> boolean {
    if a.dist != b.dist { return a.dist < b.dist; }
    if a.q    != b.q    { return a.q    < b.q; }
    if a.r    != b.r    { return a.r    < b.r; }
    if a.kind != b.kind { return a.kind < b.kind; }
    a.idx < b.idx
}

// Roster indices in move order — a selection sort, because a wave is
// tens of enemies and the clarity is worth more than the exponent.
fn move_order(state: const WaveState, fields: const vector<ClassField>) -> vector<integer> {
    mo_slots: vector<MoveSlot> = [];
    mo_i = 0;
    for mo_e in state.enemies {
        if mo_e.alive {
            mo_slots += [MoveSlot {
                idx:   mo_i,
                dist:  field_distance(fields, mo_e.kind, mo_e.q, mo_e.r),
                q:     mo_e.q,
                r:     mo_e.r,
                kind:  mo_e.kind as integer,
                taken: false,
            }];
        }
        mo_i = mo_i + 1;
    }

    mo_out: vector<integer> = [];
    for _ in 0..len(mo_slots) {
        mo_best = -1;
        mo_at   = 0;
        for mo_s in mo_slots {
            if !mo_s.taken {
                mo_b = mo_slots[mo_best] ?? MoveSlot {};
                if mo_best < 0 || slot_before(mo_s, mo_b) { mo_best = mo_at; }
            }
            mo_at = mo_at + 1;
        }
        if mo_best < 0 { return mo_out; }
        mo_mark = 0;
        for mo_t in mo_slots {
            if mo_mark == mo_best { mo_t.taken = true; }
            mo_mark = mo_mark + 1;
        }
        mo_out += [(mo_slots[mo_best] ?? MoveSlot {}).idx];
    }
    mo_out
}

// ─── The desire field, built only when somebody is besieging ────

// Is anybody in a position to need the desire field this tick?
//
// It is the same argument `wave_fields` makes about classes: a sweep
// built for nobody is a cost in a profile nobody can explain.  Only an
// enemy INSIDE the bubble with no route consults it — outside the
// bubble is approach mode, which follows its heading and never asks.
fn wave_needs_desire(state: const WaveState, fields: const vector<ClassField>) -> boolean {
    for wnd_e in state.enemies {
        if wnd_e.alive {
            // ⚠ `wnd_cf.field` is read in place, never bound — see
            // § Reading a class's field WITHOUT copying it.  This runs
            // once per enemy per tick, so a bind here costs as much as
            // the whole rebuild it is deciding whether to skip.
            wnd_climb = climb_limit(wnd_e.kind);
            for wnd_cf in fields {
                if wnd_cf.climb == wnd_climb
                    && enemy_in_bubble(wnd_e, wnd_cf.field.core)
                    && !flow_reachable(wnd_cf.field, wnd_e.q, wnd_e.r) {
                    return true;
                }
            }
        }
    }
    false
}

// The desire field for this tick, or an empty one when nobody is
// besieging.  ⚠ An empty field offers no steps, so a mover handed one
// moves nobody — which is what a caller that skipped the build should
// see, rather than a plausible wrong move.
pub fn wave_desire(state: const WaveState, fields: const vector<ClassField>,
                   pal: vector<GroundType>, pw: PaintedWorld, core: Hex) -> FlowField {
    if !wave_needs_desire(state, fields) { return flow_empty(); }
    flow_desire(pal, pw, state.heights, core)
}

// What every enemy in the roster is attacking, aligned with it — an
// enemy's OWN hex where it is attacking nothing.
//
// Plan 11 F7, and the door `target` / `count targets` read.  It builds
// its own fields rather than taking a tick's: a measurement runs
// between ticks, and one that reused a stale field could report a
// siege the world had already ended.
pub fn wave_targets(state: const WaveState, pal: vector<GroundType>,
                    pw: PaintedWorld, core: Hex) -> vector<Hex> {
    wtg_fields = wave_fields(state, pal, pw, core);
    wtg_desire = flow_desire(pal, pw, state.heights, core);
    wtg_out: vector<Hex> = [];
    for wtg_e in state.enemies {
        // A dead enemy's class may have no field at all, and then the
        // loop simply does not fire — which is the same answer
        // `enemy_target` gives it anyway: its own hex.
        wtg_t = Hex { q: wtg_e.q, r: wtg_e.r };
        wtg_climb = climb_limit(wtg_e.kind);
        for wtg_cf in wtg_fields {
            if wtg_cf.climb == wtg_climb {
                wtg_t = enemy_target(wtg_e, pal, pw, state.heights,
                                     wtg_cf.field, wtg_desire);
            }
        }
        wtg_out += [wtg_t];
    }
    wtg_out
}

// Where everybody stands right now.
//
// ⚠ Built ONCE per tick and then kept in step by the mover, rather
// than re-derived per enemy: a hex a companion has already left this
// tick is FREE, which is what lets a column advance in lockstep
// instead of at half speed — see § The move order.
pub fn wave_occupancy(state: const WaveState) -> Occupancy {
    wo_o = occupancy_empty();
    for wo_e in state.enemies {
        if wo_e.alive { occupancy_enter(wo_o, wo_e.q, wo_e.r); }
    }
    wo_o
}

// What every besieging enemy does to the structure it is stopped by,
// this tick.
//
// ⚠ **It runs BEFORE anybody moves, off the fields the tick already
// built.**  An enemy attacks exactly when `enemy_target` names a hex
// other than its own — which is to say when nothing down its route is
// a step it can take — so the pre-move state is the state that
// decides, and reading it once up front is what makes the answer
// independent of the order the roster is walked in.
//
// ⚠ Only a BREAKABLE hex is written to.  A target can be a heap of
// rubble too high to climb, and chewing one does nothing in this plan
// — recording it anyway would fill the ledger with entries that can
// never resolve, and would make `damage_count` mean something other
// than "structures under attack".
fn wave_damage(state: WaveState, pal: vector<GroundType>, pw: PaintedWorld,
               fields: const vector<ClassField>, desire: const FlowField) {
    wd_bite = per_tick(ENEMY_DAMAGE_TO_WALL_PER_SECOND);
    for wd_e in state.enemies {
        if wd_e.alive {
            wd_climb = climb_limit(wd_e.kind);
            for wd_cf in fields {
                if wd_cf.climb == wd_climb {
                    // ⚠ The field goes STRAIGHT from the vector into a
                    // `const` parameter — binding it to a local copies
                    // the whole cell hash, once per enemy (plan 11 F8).
                    wd_t = enemy_target(wd_e, pal, pw, state.heights,
                                        wd_cf.field, desire);
                    if wd_t.q != wd_e.q || wd_t.r != wd_e.r {
                        if structure_breakable(pal, pw, wd_t.q, wd_t.r) {
                            damage_apply(state.damage, wd_t.q, wd_t.r, wd_bite);
                        }
                    }
                }
            }
        }
    }
}

// Kill every enemy that has absorbed its whole HP, and leave a body
// where each one stood.  Answers how many died.
//
// ⚠ **Two effects, and the gate wants BOTH.**  A death frees its hex's
// occupancy — `wave_occupancy` counts only the living, so that half is
// the roster flag — and it RAISES the terrain, because
// `ENEMY_MOVEMENT.md` § Bodies are terrain says a body is a pile and
// piles accumulate.  A death that only cleared the flag would give the
// player a kill zone that never closes; one that only raised the
// ground would leave a corpse blocking the hex it fell on.
//
// ⚠ **Called ONCE per tick, after every enemy has moved**, so the body
// lands where the enemy ended up and the terrain it makes belongs to
// tick N+1.  Same rule as `damage_resolve`, same reason: a hex raised
// mid-loop would change passability for whoever the roster visited
// later and not for the ones it visited first.
fn wave_deaths(state: WaveState) -> integer {
    wd_n = 0;
    for wd_e in state.enemies {
        if wd_e.alive && enemy_hp(wd_e) <= 0.0 {
            wd_e.alive = false;
            height_raise(state.heights, wd_e.q, wd_e.r, BODY_HEIGHT_METRES,
                         body_source(wd_e.kind) as u8? ?? 0);
            wd_n += 1;
        }
    }
    wd_n
}

// Advance the whole wave by one game-tick.
//
// ── The field is rebuilt ONCE per tick, before anybody moves ─────
//
// `docs/ENEMY_MOVEMENT.md` § The tick resolves once: within a tick
// every enemy acts against the same world.  That is not primarily a
// cost decision — it is what makes a tick ORDER-INDEPENDENT, and so
// what makes a scripted run reproducible, which is the premise plan
// 08 gates on.  A field rebuilt mid-loop would make the outcome
// depend on which enemy the roster happened to visit first, and no
// `.keys` scenario could assert a stable number over that.
//
// The invariant that holds it: the same wave, played with the roster
// iterated in REVERSE, produces an identical result.
//
// ⚠ **F5c is where that stopped being free.**  While movement only
// read the world it was trivially true; now a companion blocks a step,
// so the order enemies act in decides where they end up.  Four things
// are therefore fixed before the first enemy moves — the fields
// (§ One field per CLIMB LIMIT), the desire field (`wave_desire`), the
// occupancy (`wave_occupancy`) and the order (§ The move order) — and
// none of them is derived from roster order.
//
// ── One field per CLIMB LIMIT, built for the roster present ─────
//
// See `wave_fields`.  It is the roster that decides which fields get
// built, not the set of classes the game knows about — and the key is
// the climb limit, because that is a class's whole contribution to
// where it can go (plan 11 F6).
//
// ⚠ **From scratch every tick, deliberately.**  F8 makes it
// incremental, and its gate is equality with this — so this path
// stays the reference implementation and is not optimised away.
pub fn wave_tick(state: WaveState, pal: vector<GroundType>, pw: PaintedWorld, core: Hex) {
    // Everything the tick reads is fixed before anybody moves: the
    // fields, where everyone stands, and the order they act in.
    wt_fields = wave_fields(state, pal, pw, core);
    wt_desire = wave_desire(state, wt_fields, pal, pw, core);
    wt_occ    = wave_occupancy(state);

    // The siege lands against the world the tick STARTED with — see
    // `wave_damage`.
    wave_damage(state, pal, pw, wt_fields, wt_desire);

    for wt_i in move_order(state, wt_fields) {
        wt_e = state.enemies[wt_i] ?? Enemy {};
        // ⚠ The field is passed STRAIGHT from the vector into a `const`
        // parameter.  Looking it up through an accessor that returned a
        // `FlowField` copied the whole cell hash, once per enemy — see
        // § Reading a class's field WITHOUT copying it.
        wt_climb = climb_limit(wt_e.kind);
        for wt_cf in wt_fields {
            if wt_cf.climb == wt_climb {
                enemy_tick(wt_e, pal, pw, state.heights, wt_cf.field, wt_desire, wt_occ);
            }
        }
    }

    // ⚠ **The consequences land LAST, after every enemy has moved**, so
    // it is tick N+1 that walks over the body and routes through the
    // hole.  A hex raised or a wall felled mid-loop would change the
    // world for the enemies the roster happened to visit later and not
    // for the ones it visited first — the same rule `height.loft`'s
    // piles follow, and the one that makes a scripted run repeatable
    // at all (`ENEMY_MOVEMENT.md` § The tick resolves once).
    //
    // Deaths before structures, and the order is fixed rather than
    // immaterial: both write to the same rubble layer, the heights ADD
    // either way, but a hex that receives both in one tick takes the
    // SOURCE of the later deposit.  Fixing the order is what makes
    // that repeatable.
    wave_deaths(state);
    damage_resolve(pal, pw, state.damage, state.heights);
}

// Count of alive enemies in the wave — wave-clear check.
pub fn alive_count(state: WaveState) -> integer {
    ac_n = 0;
    for ac_e in state.enemies {
        if ac_e.alive { ac_n = ac_n + 1; }
    }
    ac_n
}

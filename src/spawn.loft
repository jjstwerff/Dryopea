//
// Spawn director + wave engine — runtime spawn execution.
//
// At wave start, `spawn_wave` emits N enemies, each at an
// active spawn marker (= a placed marker outside the
// close-spawn-disable radius from the core).  Each enemy's
// initial heading = the marker's `direction` field.
//
// Marker selection is **round-robin** through the active
// markers — a cursor in `WaveState` advances per spawn.
// Deterministic + testable; the eventual game's "feels random"
// texture comes from the marker positions themselves (the
// designer authors multiple-direction layouts), not from RNG.
// Loft doesn't yet expose a user-callable RNG; round-robin
// is the simplest substitute that produces multi-direction
// pressure without the RNG dependency.
//
// Movement is `enemy_tick`, and it has three rules on top of each
// other: the scrambler bubble picks the mode (F5b — heading outside,
// flow field inside), the height step says what ground the class can
// hold (F1b), and companions block a step (F5c — enemies spread, they
// do not stack).  No death/HP yet: that is the combat work after.
//
// Plan 03 phase M5; the walk's passability is plan 11 F1b, the routing
// F5/F5b, the occupancy F5c.

use lattice;
use markers;
use palette;
use painted;
use height;
use passable;
use flow;
use occupancy;
use damage;
use tower;
use wallet;
use vehicle;
use helper;
use carry;
use waves;
use tick_clock;

// The radius of the core's comms-jamming bubble, in hexes — the
// boundary where an enemy stops following its spawn heading and starts
// following the flow field (`docs/ENEMY_MOVEMENT.md` § Two modes).
//
// `examples/numbers.json` § core.scrambler_bubble_radius is where this
// number lives; it is restated here because nothing loads numbers.json
// yet, exactly as `script.loft` restates the spawn-disable radius.
// When a loader lands, this reads from it instead of holding a second
// copy.
pub const SCRAMBLER_BUBBLE_RADIUS: integer = 25;

// ─── What a tick is worth, in seconds (plan 12 B0) ──────────────
//
// `examples/numbers.json` § enemy_regular.speed_engage, restated here
// for the same reason as the bubble radius above: nothing loads that
// file yet.
//
// ⚠ **The tick's duration used to be DERIVED, and since plan 23 K2a it
// is CHOSEN.**  It was a derivation while `enemy_tick` advanced an
// enemy by exactly one hex: the design says an enemy covers 1.5 hexes
// a second, so a tick was 1/1.5 s and there was no second opinion to
// have about it.  `enemy_bank` below broke that — an enemy now banks
// `speed * tick_seconds` and steps whenever a whole hex is due — so
// the timestep is free and this expression is what KEEPS it at one
// regular's hex.  Nothing derives it any more.
//
// ⚠ **Why it is still spelled as a division.**  Holding the timestep
// at exactly one hex for a 1.5 hex/s robot is what makes K2a's whole
// gate available: the old path and the new one agree bit for bit, so
// 1128 tests and 569 measurements are the comparison
// (`plans/23-the-small-robots` § K2a).  Change the value and every
// clock in the corpus moves for a reason that is not a defect.
//
// The instruction it honours — project owner, 2026-08-13: *there will
// be a variety of speeds, so do not link speed too closely to a tick*.
// Three sources: per role (the scout is faster, the miner slower —
// **built, K2b**, see § How fast each class arrives), per CONDITION
// (**a damaged robot moves slower**, so speed changes during a life and
// is not a class constant at all — not built), and per tier (insects
// differ again — not built).  K2a built the mechanism and moved none of
// them; K2b moved the first.
//
// ⚠ `tests/12_b0_probe.loft`'s `test_a_tick_advances_an_enemy_exactly_
// one_hex` and `test_so_a_tick_is_two_thirds_of_a_second` are still
// GREEN after K2b, and the reason is worth stating because it is not
// the one that was predicted: both are written about the REGULAR, and
// the regular's speed is exactly what K2b held. What the ticks-are-
// hexes claim lost is its scope — it is now a statement about one
// class rather than about the engine, which is why this constant is
// called what HOLDS the timestep rather than what sets it (`@X058`).
//
// ⚠ And a shorter timestep still costs more than it looks: the tick's
// length is what plan 11 F8's budget is measured against.  Shortening
// it shrinks that budget in proportion, and the from-scratch field
// rebuild that fits comfortably at 667 ms does not fit at 100 ms —
// which is `plans/22-the-field-cache`'s own trigger, *"the one nobody
// would look for"*.  K2a makes the change
// POSSIBLE and deliberately does not make it.
pub const ENEMY_SPEED_HEX_PER_SECOND: float = 1.5;
// One simulation step, in `tick_clock.loft`'s base units — plan 26 L1.
//
// ⚠⚠ **This is now the ONE definition of the tick, and `TICK_SECONDS`
// is derived from it.**  It used to be the other way round, and
// `@X058` is what released the constraint: since plan 23 K2a
// `TICK_SECONDS` HOLDS the timestep at one regular's hex rather than
// being forced to it, so the timestep is free to be CHOSEN — and a
// chosen step has to be an exact integer of some unit or the whole of
// L1 collapses back into rounding.
//
// ⚠ 2/3 of a second, exactly, at 3 000 000 units a second.  See
// `tick_clock.loft` § THE BASE UNIT IS A CHOICE for why microseconds
// cannot express it and what the µs answer measured (`@M031`).
pub const TICK_STEP_UNITS: integer = 2000000;

// ⚠⚠ **DERIVED, and bit-identical to the `1.0 / ENEMY_SPEED_HEX_PER_
// SECOND` it replaces** — gated in `tests/26_l1_the_clock.loft`
// § The derived second is the old one, not asserted here, because a
// constant compared against itself is not a comparison.  Two hundred
// and fifty measurements read this number; it did not move.
pub const TICK_SECONDS: float = (TICK_STEP_UNITS as float) / (CLOCK_UNITS_PER_SECOND as float);

// ⚠ **Banked progress is in HEXES**, where `tower.loft`'s charge and
// plan 13 V4's boost are in SECONDS — the same trap in a different
// unit, so it gets its own constant rather than borrowing one that
// means something else.  `helper.loft`'s `HELPER_PROGRESS_EPSILON` is
// the same quantity for the crew, and the two are separate for the
// reason that file gives: a shared epsilon is a shared decision.
//
// ⚠⚠ **This guard cannot fire at today's speed, and that is what
// makes it dangerous rather than redundant.**  `1.5 * (1.0 / 1.5)` is
// exactly 1.0 to the bit, so the carry is 0.0 for ever.  MEASURED
// (2026-08-15, plan 23 K2a): setting this constant to 0.0 leaves all
// **1128 pre-K2a tests green and all 569 measurements green**, and
// fails only the three assertions written to go looking for it.  That
// is exactly the shape `plans/17` T1 named — *an epsilon whose removal
// leaves the suite green is a guard that cannot fire* — so the fix is
// its fix: exercise the branch directly, and measure a speed the
// constant does not take.
//
// ⚠ **It is load-bearing everywhere else.**  Measured over sixty ticks
// of this timestep, the epsilon is worth a whole hex at 1.0, 1.2, 1.8,
// 2.0 and 2.5 hex/s and worth nothing at 0.5, 0.75, 1.5, 2.25 and 3.0
// — so 1.5 is one of the few values that hides it.  It is worth a hex
// to a SHORTER TIMESTEP too: a tenth of a tick loses one over 300 steps
// without it.  `tests/23_k2a_banked_movement.loft` exercises the branch
// directly AND measures a speed that needs it, because neither alone is
// a gate.
//
// ⚠⚠ **And since K2b it is no longer invisible: it fires on BOTH
// gates.**  K2a's warning was that *a class K2b gives 1.0 hex/s would
// silently lose a hex every forty* — the scout took 2.5 and the miner
// took 1.0, and both are on that list.  MEASURED (2026-08-15, `@M017`),
// the same experiment with the classes in it: set this to 0.0 and **7
// of 1149 tests fail and `scripts/validate.sh` goes red**, where at K2a
// the identical change left everything green.  ⚠ Only three of the
// seven are assertions written to look for it; the rest are ordinary
// behaviour.  ⚠ And it takes THREE ticks, not sixty — three of
// `2.5 * (1.0/1.5)` sum to 4.999999999999999, so the fifth hex exists
// only because this constant releases it.
pub const ENEMY_PROGRESS_EPSILON: float = 1.0e-9;

// ── How fast each class arrives (plan 23 K2b) ───────────────────
//
// `examples/numbers.json` § enemy_small_robots — the second of the two
// axes `DESIGN.md` § Small robots commits, and the one K2a built the
// mechanism for.  ⚠ **The regular's 1.5 is untouched**, for the same
// reason its damage rate was in K0: it is the baseline every scenario
// in the corpus was written against, so two classes can move and the
// other 569 measurements cannot.
//
// ⚠ **A speed is a RATE now, not a tick count** (`@X058`).  These
// numbers reach the mover through `enemy_bank`, which banks
// `speed * tick_seconds` and releases whole hexes — so 2.5 hex/s is
// five hexes every three ticks rather than "two per tick, sometimes".
//
// MEASURED, one enemy walking nine hexes of open corridor into a
// sealed stub (`tests/23_k2b_the_scout.loft`, and the same nine hexes
// in `a-wall-against-a-*.keys`):
//
//   | class | hex/s | hex/tick | ticks to walk 9 | vs the robot |
//   |-------|-------|----------|-----------------|--------------|
//   | scout | 2.5   | 1.667    |  6              | 0.67x        |
//   | robot | 1.5   | 1.0      |  9              | the baseline |
//   | miner | 1.0   | 0.667    | 14              | 1.56x        |
//
// ⚠ **The pairing is the design and not a curve.**  The scout is fast
// AND nearly harmless (0.1 HP/s, K0): *"it arrives first and does
// almost nothing when it gets there"*, which is what makes it the unit
// artillery cannot hit and the unit not worth hitting.  The miner is
// the inversion — slow, and 3.0 HP/s into a perimeter.  A class that
// were fast and deadly would collapse the matching problem the two
// axes exist to create.
//
// ⚠ **Harvester and builder are deliberately absent**, and that is the
// `numbers.json` shape rather than an omission: that section is
// DELTAS, and a field a role does not list is the regular's.  Giving
// all four a row would make two of them tunables this plan invented.
//
// ⚠⚠ **Both figures are speeds at which `ENEMY_PROGRESS_EPSILON` is
// load-bearing** (`@M013`), and that was checked before they were
// chosen rather than after.  2.25 and 3.0 would have been *"quite a
// bit faster"* too, and both hide the guard exactly as 1.5 does — so
// picking one would have left the roster with no class that can see
// its own rounding.
pub const SCOUT_SPEED_HEX_PER_SECOND: float = 2.5;
pub const MINER_SPEED_HEX_PER_SECOND: float = 1.0;

// How fast this class walks, in hexes per second.
//
// An unknown kind takes the regular's speed — the same fallback rule
// `enemy_damage_to_wall` and `damage.loft::enemy_max_hp` give, and for
// a sharper reason here: 0.0 would be a class that never arrives, so a
// discriminant this table has not learned about yet would produce a
// wave that spawns and then stands in the field for ever, with every
// "the wave exists" assertion green.
//
// ⚠ **It is a CLASS lookup, and that is its limit.**  `DESIGN.md`
// § Speed must NOT be tied to the tick names three sources of variety
// and this covers one of them; *"a damaged robot moves slower"* is a
// running quantity that reads `taken`, and it belongs at the CALL SITE
// in `enemy_tick` — the shape `passable.loft::can_climb` already uses,
// where the rule takes the climb rather than looking it up.  Widening
// this function to take an `Enemy` is what would close that door.
pub fn enemy_speed(kind: u8) -> float {
    if kind == ENEMY_KIND_SCOUT as u8 { return SCOUT_SPEED_HEX_PER_SECOND; }
    if kind == ENEMY_KIND_MINER as u8 { return MINER_SPEED_HEX_PER_SECOND; }
    ENEMY_SPEED_HEX_PER_SECOND
}

// ── Why the SECONDS survive into the engine (plan 12 B0) ────────
//
// Every damage number in `numbers.json` is a per-SECOND rate — 1 pt/s
// of wallet drain, 1 HP/s into a wall, one tower shot a second — and
// plan 12 had a real fork open: convert them to per-tick once at the
// numbers boundary, or keep seconds and let each site multiply.
//
// B0 measured the fork rather than arguing it, and the tower settles
// it: a 1.0 s fire interval is **1.5 ticks**.  It is not a count of
// anything, so a per-tick integer cadence cannot express the design's
// own numbers, and rounding it either way changes the tower's DPS by
// 33%.  The same goes for the 5.0 s scramble window (7.5 ticks) and
// the 15.0 s inter-wave delay (22.5).
//
// So the boundary conversion is not available, `numbers.json` keeps
// saying `HP/s` — which is also what makes it moddable, since a
// per-tick number is unreadable to anyone outside this engine — and a
// rate reaches the sim by being multiplied by `TICK_SECONDS` at the
// point it is applied.  `wave_damage` (B2) is the first site.
pub fn per_tick(rate_per_second: float) -> float {
    rate_per_second * TICK_SECONDS
}

// What a besieging enemy does to the wall it cannot climb, per second
// — `numbers.json` § enemy_regular.damage_to_wall, restated here for
// the same reason the speed is.
//
// ⚠ **One rate for every class**, and that is the file's shape rather
// than a simplification: `numbers.json` has an `enemy_regular` section
// and no `enemy_insect` one, so a second number would be a tunable
// this plan invented.  When insects get a section they get a rate, and
// this becomes a lookup like `climb_limit`.
//
// ⚠ **And that lookup is where the small-robot roles live.**  The
// design commits four of them — scout, harvester, builder, miner
// (`DESIGN.md` § Small robots: four roles, one AI) — whose whole
// mechanical difference is what their working tools do to a wall: a
// miner cuts rock for a living and a scout does not.  So four enemy
// types cost one row each in `numbers.json` and one branch here, and
// **no new behaviour anywhere** — which is the point of the rule, not
// a happy accident.
//
// Slow on purpose.  100 HP at 1 HP/s is 100 s — 150 ticks — for one
// robot, so breaking a wall is a rare path rather than the default
// way in, and a base only falls to a wave that stays on it.
pub const ENEMY_DAMAGE_TO_WALL_PER_SECOND: float = 1.0;

// ── The four small robots' rates (plan 23 K0) ───────────────────
//
// `examples/numbers.json` § enemy_small_robots, and this is the branch
// the paragraph above promised.  ⚠ **The regular's 1.0 is untouched**,
// which is what lets four classes land without moving one of the 520
// measurements in `scripts/validate.sh`.
//
// The spread is the design's, not a curve: *"a miner cuts rock for a
// living; a scout has no real weapon at all"* (`DESIGN.md` § Small
// robots).  What the numbers have to make true is that **the same wave
// size against the same wall is a different problem** —
//
// MEASURED, four of them into a sealed two-row band
// (`tests/23_k0_the_classes.loft::breach_tick`):
//
//   | class     | HP/s | ticks to breach | against the baseline    |
//   |-----------|------|-----------------|-------------------------|
//   | scout     | 0.1  | 454             | never, in any real base |
//   | harvester | 0.5  |  96             |                         |
//   | robot     | 1.0  |  50             | the baseline, unchanged |
//   | builder   | 1.5  |  35             |                         |
//   | miner     | 3.0  |  23             | 20x the scout           |
//
// ⚠ **Two of those five moved in K2b and NOT because a rate changed.**
// They were 456 and 20 while every class walked at 1.5 hex/s; a breach
// clock counts from the tick the wave was PLACED, so it contains the
// walk as well as the chewing, and the scout now arrives sooner while
// the miner arrives later.  The three unmoved rows are what say the
// rates themselves are untouched.  ⚠ It is a small contamination here
// (four hexes of approach against tens of ticks of siege) and it would
// not be on a real base — price a class against `@M016`'s arrival
// clocks and this table separately, never against this table alone.
//
// ⚠ **The scout's figure is chosen to LOSE that race against a real
// base's length, not merely to be small.**  The longest base the
// corpus can play falls at **320 ticks** (`@M005`; it was 321 from plan
// 16 W4 until plan 24 W1 took a tick off it), so a rate that needs 458
// says *this class never opens a perimeter* in a measurement rather
// than in a comment.  ⚠ It was 0.2 when this table
// was first written, and the gate caught it: four scouts breached at
// 231 — comfortably inside a base that lasts 320, which is the
// opposite of what `DESIGN.md` means by *"a scout has no real weapon
// at all"*.  The arithmetic had been done against the 100 HP braced
// figure and the siege chews the 30 HP END (plan 12 B3).
//
// ⚠ **Zero would have been the lazy way to say it, and it says
// something else.**  An enemy that does nothing at a wall makes
// `wave_damage` skip it entirely, so `damage_count` — *"structures
// under attack"* — would stop counting a wall four scouts are
// standing on, and a player watching would be told nothing is
// happening.  Which is false: they are chewing, and they will get
// through eventually if the base lasts long enough to see it.
pub const SCOUT_DAMAGE_TO_WALL_PER_SECOND:     float = 0.1;
pub const HARVESTER_DAMAGE_TO_WALL_PER_SECOND: float = 0.5;
pub const BUILDER_DAMAGE_TO_WALL_PER_SECOND:   float = 1.5;
pub const MINER_DAMAGE_TO_WALL_PER_SECOND:     float = 3.0;

// What this class does to the structure it is stopped by, per second.
//
// An unknown kind takes the regular's rate — the same fallback rule
// `damage.loft::enemy_max_hp` gives: a class the table has not learned
// about yet gets the only figure anyone has chosen, rather than 0,
// which would make it silently harmless to every perimeter in the
// game.
pub fn enemy_damage_to_wall(kind: u8) -> float {
    if kind == ENEMY_KIND_SCOUT     as u8 { return SCOUT_DAMAGE_TO_WALL_PER_SECOND; }
    if kind == ENEMY_KIND_HARVESTER as u8 { return HARVESTER_DAMAGE_TO_WALL_PER_SECOND; }
    if kind == ENEMY_KIND_BUILDER   as u8 { return BUILDER_DAMAGE_TO_WALL_PER_SECOND; }
    if kind == ENEMY_KIND_MINER     as u8 { return MINER_DAMAGE_TO_WALL_PER_SECOND; }
    ENEMY_DAMAGE_TO_WALL_PER_SECOND
}

// What an enemy does to a PLAYER or helper standing in its way, per
// second — `numbers.json` § enemy_regular.damage_to_blocker, and five
// times what it does to a wall.
//
// ⚠ **That ratio is the design's whole point.**  `DESIGN.md` § 8: the
// vehicle *"cannot tank for the core"*.  At 5 HP/s against 100 HP one
// attacker kills a parked player in twenty seconds and four do it in
// five, so blocking buys a moment and costs the trip home — which is
// what makes it a positioning MISTAKE rather than a tactic.
pub const ENEMY_DAMAGE_TO_BLOCKER_PER_SECOND: float = 5.0;

// ─── The pre-walk window (plan 16 W2) ───────────────────────────

// How long an enemy stands at its spawn marker before it starts
// walking — `numbers.json` § enemy_regular.pre_walk_standstill, which
// § wave_system.pre_walk_visibility_interval states again from the
// wave's side at the same 5.0 s.
//
// `DESIGN.md` § Pre-walk visibility — the scramble decision window:
// *"enemies appear at their picked spawn markers and stand visible …
// This is the player's window to see what's coming (how many, from
// which directions) and decide whether to stand or scramble before any
// enemy has moved."*
//
// ⚠ **It is the enemy's property, not the wave's**, and the two rows in
// `numbers.json` are one number seen from both ends.  Storing it per
// enemy is what makes it per-CLASS data under the rule that one AI
// reads different numbers (`CLAUDE.md` § ONE AI, per-class DATA) — a
// slower class can be given a longer window with a row in the file and
// no code — and it is also what makes the window survive two waves
// being on the ground at once, which a single clock on the schedule
// could not express.
//
// ⚠ **Not a HUD.**  § No wave HUD is uncompromising — no wave number,
// no countdown, no banner — so this window plus the marker pulse are
// the entire wave UI, and this is the half that is a SIMULATION fact.
// It costs the enemies time; a cosmetic version would cost nothing and
// tell the player the same thing.
//
// ⚠ **One number for every class today**, and a bare constant rather
// than a lookup for the reason `ENEMY_DAMAGE_TO_WALL_PER_SECOND` gives
// three paragraphs up: `numbers.json` has an `enemy_regular` section
// and no `enemy_insect` one, so a second figure would be a tunable this
// plan invented.  When a class earns its own window it costs a row in
// the file and a `climb_limit`-shaped lookup here — and nothing else,
// because `spawn_wave` already writes the window per ENEMY.
pub const PRE_WALK_SECONDS: float = 5.0;

// The kind discriminants an `Enemy` carries — `ENEMY_KIND_REGULAR`
// and friends — live in `passable.loft`, because a class IS its
// climb limit as far as movement is concerned and the mover has to
// be able to ask (plan 11 F1b).  They are in scope here through the
// `use` above.
//
// ⚠ **The SCHEDULE still emits only regulars** (plan 23 K1).  A
// `.keys` script has said `wave 4 miner` since K0, but `wave_schedule`
// carries a `vector<integer>` — a wave is a COUNT with no class in it
// — so `wave_due` below hands `spawn_wave` a hard-coded
// `ENEMY_KIND_REGULAR`.  Until that changes, every wave the game
// sends itself is the same wave, and `ROBOT_ECONOMY.md`'s
// *"composition is a readout"* reads one symbol.

// One enemy on the map.  Mixes integer (q, r) with u8
// (kind, heading) fields.  Not serialised today — vector<Enemy>
// stays in memory only — so the QUESTIONS_FOR_LOFT.md
// `:j`/vector-u8 corruption bug doesn't apply.  If enemies ever
// need on-disk persistence, mirror the painted-layer pattern:
// widen u8 → integer in a separate on-disk struct.
// ⚠ `taken` is damage ABSORBED, not HP remaining, and the choice is
// the same one `damage.loft` makes for structures — with a second
// reason here that CLAUDE.md § Loft language gotchas spells out: a
// struct literal that omits a field takes that field's DEFAULT
// silently, so in a struct callers build field by field the neutral
// value must be the ZERO value.  Store HP remaining and every
// `Enemy { … }` literal in the suite that predates plan 12 B4 spawns a
// corpse.
// ⚠ `stand` is the same rule a third time (plan 16 W2): it is SECONDS
// LEFT at the spawn marker, so zero is an enemy that is free to walk —
// which is what an `Enemy { … }` literal that predates the field wants
// to be, and what every hand-placed enemy in the suite already is.  It
// is the one field here whose neutral value is not obviously the zero,
// so it is worth saying: "seconds STOOD" would count the wrong way and
// make every literal a robot that has not finished arriving.
// ⚠ `progress` is the rule a FOURTH time (plan 23 K2a): it is the
// fraction of a hex this enemy has banked and not yet spent, so zero is
// an enemy standing squarely on its hex — which is what every literal
// in the suite that predates the field already means.  It is the one
// field here that is not a fact about the enemy at all but about the
// simulation's remainder, and it is on the ENEMY rather than beside the
// roster because `docs/DESIGN.md` says speed varies per CONDITION: a
// damaged robot slows down, so the carry has to belong to whoever is
// carrying it.
pub struct Enemy {
    q:        integer,
    r:        integer,
    kind:     u8,
    heading:  u8,
    alive:    boolean,
    taken:    float,
    stand:    float,
    progress: float,
}

// What this enemy has left, in HP — 0.0 once it has absorbed its whole
// allowance.
pub fn enemy_hp(e: const Enemy) -> float {
    max(enemy_max_hp(e.kind) - e.taken, 0.0)
}

// Land `hp` of damage on one enemy.
//
// ⚠ **It does not kill.**  Death is `wave_deaths`, at the end of a
// tick, for the same reason `damage_apply` does not break a wall: one
// death path, so the tower B5 builds and the `hit` a script types
// cannot drift apart.  An enemy at 0 HP is a walking dead man until
// the tick resolves, which is exactly what "the tick resolves once"
// means (`docs/ENEMY_MOVEMENT.md`).
pub fn enemy_hurt(e: Enemy, hp: float) {
    e.taken = max(e.taken + hp, 0.0);
}

// Is this enemy still standing at its spawn marker (plan 16 W2)?
//
// ⚠ **It ASKS and never spends.**  The window is spent once per tick,
// at the end, by `wave_stand` — the same place and the same shape as
// `helper_recover_tick` — and this predicate is read by three callers
// before that.  A question that also advanced the clock would spend it
// three times in the tick it is read three times in, and the count
// would depend on how many things happened to ask.
//
// ⚠ **A standing enemy does nothing but stand**, which is the whole
// rule: it does not move (`enemy_tick`), it attacks nothing
// (`enemy_target`) and nobody is blocking it (`enemy_blocked_by`).
// Those three are the sites, and they are three rather than one
// because an enemy that has not begun its approach cannot be blocked
// on the way — "it is not going anywhere yet" is one fact with three
// consequences.  What it does NOT get is immunity: it is in the
// occupancy, it is in the roster, and a tower shoots it where it
// stands, which is the design's *"stand VISIBLE"*.
pub fn enemy_standing(e: const Enemy) -> boolean {
    e.stand > 0.0
}

// Wave-engine state.  `enemies` is the running roster across
// the current wave (and the future across-waves view); per-wave
// metadata lives here too.  `pick_cursor` is the round-robin
// index into the active-marker set, advancing every spawn.
//
// ⚠ `heights` is the RUNTIME rubble layer (plan 11 F6, plan 12 B1) —
// what bodies and broken walls have piled on the map — and `damage` is
// the ledger of what every structure has absorbed (plan 12 B2).  Both
// ride here rather than on the world because plan 11 says where they
// belong: *pile heights live with the wave, not in the save*.  A wave
// is also the thing whose lifetime they share, and no save file ever
// has to learn a field it should not keep.
//
// ⚠ The BREAK is the exception, and it is deliberate: a broken wall
// really is gone, so `damage.loft::break_structure` edits the painted
// world.  Only the heap it leaves is runtime.
//
// ⚠ `wallet` is the odd one out and outlives a wave: the other four
// fields describe a battlefield, and the wallet is the RUN's budget,
// carried between waves and (eventually) between bases.  It rides
// here anyway because this struct is already the only thing a
// scripted run threads through a tick, and a second runtime container
// holding one float would be a second thing every caller has to
// remember to pass.
//
// ⚠ `player` is the same argument a second time (plan 13 V1), and by
// now the NAME is a scar: this struct is the RUN's state and it is
// called `WaveState`.  Renaming it to `RunState` is a mechanical
// change across some sixty call sites and belongs to nobody's plan
// yet — recorded here so the name is not read as a claim about what
// it holds.
pub struct WaveState {
    enemies:     vector<Enemy>,
    pick_cursor: integer,
    heights:     HeightLayer,
    damage:      DamageLayer,
    towers:      TowerState,
    wallet:      Wallet,
    player:      Vehicle,
    crew:        vector<Helper>,
    cargo:       CargoLayer,
    schedule:    WaveSchedule,
}

// Factory: a fresh wave state with no enemies, a cursor at 0, the
// map exactly as painted and the budget untouched.
pub fn wave_state_empty() -> WaveState {
    WaveState {
        enemies: [], pick_cursor: 0,
        heights: height_layer_empty(),
        damage:  damage_layer_empty(),
        towers:  tower_state_empty(),
        wallet:  wallet_new(),
        player:  vehicle_empty(),
        crew:    [],
        cargo:   cargo_empty(),
        schedule: wave_schedule_new(),
    }
}

// ⚠ An enemy heading steps through `lat_neighbour` (`use lattice;`),
// and there is NO 6-direction offset table to reach for.  Plan 11 F2
// moved `hex_offset` out of here — the flow field is built from the
// same relation, and a wave engine is the wrong owner for the
// geometry of the whole world — and plan 09 C6 then deleted the table
// itself: in odd-r the delta depends on row parity, so a constant
// `(dq, dr)` table does not exist.  One relation, one place.

// ─── Active markers (close-spawn-disable filter) ────────────────

// Return the subset of placed spawn markers that are AT LEAST
// `disable_radius` hexes from the core.  Markers within the
// radius are visible to the player (a safety signal — "this
// won't fire on you") but don't emit enemies.  Per DESIGN.md
// § Updates: free-pick landing.
//
// Returns a fresh vector copy so the caller can iterate without
// holding the hash open.  Order is iteration order of the
// underlying hash — stable within a single program run but not
// across runs (use index 0 etc as test fixtures only when the
// test placed exactly one marker, or use the round-robin
// cursor's behaviour to test order-independent properties).
pub fn active_spawn_markers(
    mw:             MarkerWorld,
    core_q:         integer,
    core_r:         integer,
    disable_radius: integer,
) -> vector<MarkerEntry> {
    asm_out: vector<MarkerEntry> = [];
    asm_core = Hex { q: core_q, r: core_r };
    for asm_e in mw.markers {
        if asm_e.kind == MARKER_KIND_SPAWN as u8 {
            asm_d = lat_distance(asm_core, Hex { q: asm_e.q, r: asm_e.r });
            if asm_d >= disable_radius {
                asm_out += [MarkerEntry {
                    q:         asm_e.q,
                    r:         asm_e.r,
                    kind:      asm_e.kind,
                    direction: asm_e.direction,
                }];
            }
        }
    }
    asm_out
}

// ─── Wave spawn + tick ──────────────────────────────────────────

// Spawn one wave's worth of enemies: emit `count` enemies of class
// `kind`, each at a different (round-robin) active marker, each with
// the marker's direction as its initial heading.  Appends to
// `state.enemies`; advances `state.pick_cursor` by `count`.
//
// ⚠ `kind` is a parameter and not a default (plan 11 F6).  Until F6
// every enemy the game could emit was a robot, so no scenario could
// state the thing the per-class field exists for — *an insect crosses
// what a robot must walk around*.  A default would have kept that
// untestable from a `.keys` script while looking like it worked, which
// is the shape plan 08 § The instrument comes first is about.
//
// No-op if there are zero active markers (an all-disabled map
// or an authoring mistake — the caller logs / surfaces).
pub fn spawn_wave(
    state:          WaveState,
    count:          integer,
    kind:           u8,
    mw:             MarkerWorld,
    core_q:         integer,
    core_r:         integer,
    disable_radius: integer,
) {
    sw_active = active_spawn_markers(mw, core_q, core_r, disable_radius);
    sw_n = len(sw_active);
    if sw_n == 0 { return; }
    // `while` loop drops an unused loop counter; the `?? 0` and
    // `?? <fallback>` defensive operators silence the static
    // analyser's modulus / out-of-bounds warnings — both
    // invariants are guarded by the `sw_n == 0` early-return
    // above (sw_n > 0; pick_cursor % sw_n ∈ 0..sw_n-1).
    sw_remaining = count;
    while sw_remaining > 0 {
        sw_idx = (state.pick_cursor % sw_n) ?? 0;
        sw_m   = sw_active[sw_idx] ?? sw_active[0];
        // ⚠ **The window is written HERE, so both spawners have it**
        // (plan 16 W2).  A `.keys` script's `wave` verb and W1's
        // schedule both arrive through this function, and W1's gate
        // (`tests/16_w1_the_schedule.loft` § The two spawners agree)
        // exists to keep it that way.  Giving the schedule its own
        // window would make every scenario in `tests/scripts/` measure
        // a game the player never plays.
        state.enemies += [Enemy {
            q:       sw_m.q,
            r:       sw_m.r,
            kind:    kind,
            heading: sw_m.direction,
            alive:   true,
            stand:   PRE_WALK_SECONDS,
        }];
        state.pick_cursor = state.pick_cursor + 1;
        sw_remaining = sw_remaining - 1;
    }
}

// Bank one timestep of movement onto this enemy and answer the whole
// hexes it releases — plan 23 K2a.
//
// ⚠ **The SPEED is a parameter and not a lookup**, which is the one
// place this differs from `helper.loft::helper_bank`, and it is not a
// style choice.  Every class moves at `ENEMY_SPEED_HEX_PER_SECOND`
// today, and that value is precisely the one at which the epsilon
// below cannot fire — so a bank that read the constant itself could
// only ever be tested at the speed that hides its own guard.  Naming
// the speed at the call site is what lets
// `tests/23_k2a_banked_movement.loft` measure 1.0 hex/s, where the
// guard is worth a hex every forty.  ⚠ K2b did exactly that and
// changed nothing else here: the caller now passes
// `enemy_speed(e.kind)`, and the argument is what keeps this function
// testable at speeds no class currently takes.
//
// ⚠ **It stays an argument even though a lookup now exists**, and the
// reason has outlived K2a's: `DESIGN.md` § Speed must NOT be tied to
// the tick wants speed to vary *within a life* — *"a damaged robot
// moves slower"* — so the number this is banked at is a property of the
// enemy's CONDITION and not of its class.  A bank that looked its own
// speed up would have to be widened again the day that lands.
//
// ⚠ **It keeps the REMAINDER rather than discarding it**, which is
// what makes the average exact rather than merely close — the property
// a shorter simulation timestep rests on entirely (`plans/22`).  Ten
// steps of a tenth of a tick must be worth exactly one tick, and they
// are.
//
// ⚠ **What it does NOT do is bank for an enemy that is not walking.**
// `enemy_tick` asks the pre-walk window first and returns before it
// gets here, so a wave that stood eight ticks at its marker does not
// leave in one stride.  That ordering is the whole of plan 16 W2's
// survival, and it is a line in the CALLER because a bank that knew
// about standing would have to know about every other reason not to
// move too.
pub fn enemy_bank(e: Enemy, speed: float, tick_seconds: float) -> integer {
    e.progress = e.progress + speed * tick_seconds;
    eb_whole   = (e.progress + ENEMY_PROGRESS_EPSILON) as integer? ?? 0;
    if eb_whole > 0 { e.progress = e.progress - (eb_whole as float); }
    if e.progress < 0.0 { e.progress = 0.0; }
    eb_whole
}

// Advance one alive enemy by the hexes this timestep owes it — plan 11
// F1b, rebuilt on banked progress in plan 23 K2a.
//
// ⚠ **A tick is no longer a hex.**  This used to take exactly one step
// because a tick was DEFINED as the time an enemy takes to cross one
// (`TICK_SECONDS` above); it now asks `enemy_bank` how many whole hexes
// are due and takes that many — which since K2b is **2 for a scout in
// two ticks out of three, and 0 for a miner in one tick out of three**,
// with no change to a mover, a target or a field.  The loop below is
// the whole of what a faster class cost.
//
// ⚠ **A hex the ground refuses is SPENT, not re-banked**, and that is
// the opposite of what `helper_bank` does for the crew.  A helper
// parked against a wall goes on accumulating so its average stays a
// rate; an enemy stopped by a wall must NOT, because it is besieging
// rather than travelling — store the hexes and a robot that chewed a
// breach for ten ticks crosses the base in one.  So the released hexes
// go through `enemy_step` and whatever it cannot use is gone.
//
// Dead enemies are a no-op (the runtime keeps them in the roster for
// post-mortem accounting; final-wave-clear checks alive_count to
// gate "wave done").
//
// ── The world is a parameter, and deliberately not optional ─────
//
// It would have been one line to give `pal` / `pw` defaults and keep
// every existing caller compiling.  That would make the passability
// check skippable, and a caller that skipped it would walk enemies
// through walls exactly as this phase's own negative control did —
// silently, because an empty palette answers "no ground anywhere".
// So the signature changed and every call site was made to say which
// world it ticks against.  The compile errors were the point.
// ⚠ `tick_seconds` joined them for the same reason (K2a): the
// timestep is a CHOICE now, so a caller that did not state it would be
// choosing the old one by accident.
pub fn enemy_tick(e: Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                  hl: const HeightLayer, f: const FlowField, desire: const FlowField,
                  occ: Occupancy, blockers: const BlockerMap, tick_seconds: float) {
    if !e.alive { return; }

    // ⚠ **The pre-walk window** (plan 16 W2): an enemy that has not
    // finished standing at its marker does not move — and, since K2a,
    // does not BANK either.  It is spent at the END of the tick by
    // `wave_stand`, never here — see `enemy_standing`.
    if enemy_standing(e) { return; }

    // ⚠ The speed is looked up HERE and not inside the bank (plan 23
    // K2b, `@X061`).  This is the one line that knows an enemy's class
    // decides its pace, which is where a per-CONDITION speed will also
    // go when *"a damaged robot moves slower"* lands.
    et_left = enemy_bank(e, enemy_speed(e.kind), tick_seconds);
    while et_left > 0 {
        enemy_step(e, pal, pw, hl, f, desire, occ, blockers);
        et_left = et_left - 1;
    }
}

// One whole hex of movement, resolved against the world as it stands
// right now — the body `enemy_tick` used to be, called once per hex
// the bank released (plan 23 K2a).
//
// ⚠ **It re-asks everything, every step.**  Occupancy is updated by
// `enemy_move_to` as the enemy moves, so a class taking two hexes in a
// timestep sees its companions where they are after its first step
// rather than where they were at the top of the tick.  That is what
// keeps a fast class from walking through a queue it would have been
// stopped by — and since K2b the scout is that class, twice in every
// three ticks, so the property is now exercised rather than merely
// prepared for.
//
// ── What a blocked enemy does ───────────────────────────────────
//
// Nothing, today.  It still wants the core
// (`docs/ENEMY_MOVEMENT.md` § Two modes: "An enemy never halts
// permanently.  Blocked, it attacks"), but there is no combat yet,
// so approach mode's whole answer to a wall is to stop in front of
// it.  Stopping is what makes the wall a wall; the attack is F5+ and
// the routing round it is F5.
fn enemy_step(e: Enemy, pal: vector<GroundType>, pw: PaintedWorld,
              hl: const HeightLayer, f: const FlowField, desire: const FlowField,
              occ: Occupancy, blockers: const BlockerMap) {
    // ── Which mode? The bubble decides (plan 11 F5b) ─────────────
    //
    // `docs/ENEMY_MOVEMENT.md` § Two modes: outside the scrambler
    // bubble an enemy follows its spawn marker's heading; inside it,
    // the field toward the core.  The boundary IS the handoff.
    //
    // The field carries the core it was built for, so the test needs
    // no extra parameter — which is why `FlowField` keeps it.
    if !enemy_in_bubble(e, f.core) {
        enemy_walk_heading(e, pal, pw, hl, occ);
        return;
    }

    // ── Engage: follow the field (plan 11 F5) ───────────────────
    //
    // The field is per class and already refuses every hex this class
    // cannot hold, so a step down it needs no passability check of
    // its own — `flow_build` did it.  What it does NOT know is who is
    // standing where, which is this phase (F5c): take the first FREE
    // step in preference order, and stand still when every one of them
    // is held.
    //
    // ⚠ **Closer first; BESIDE only when a companion is what stopped
    // it** (plan 11 F7b).  `ENEMY_MOVEMENT.md` § Sealing the perimeter has
    // said since before any of this was built that *"an enemy whose
    // target hex is taken by a companion does not wait behind it — it
    // moves beside them"*, and F5c built only the first half of that:
    // it tried the next strictly-closer hex and then gave up.  On a hex
    // AXIS there IS no next one — the field offers exactly one closer
    // neighbour on an axis and two off it — so a column arriving from a
    // single spawn queued single file, and plan 12 B7 measured what
    // that was worth: thirteen robots reach an undefended core and
    // exactly TWO ever nibble it.  The drain did not scale with the
    // wave, and neither did anything else.
    //
    // ⚠ **A sidestep closes NO distance, so it must never become the
    // route.**  It fires only after every strictly-closer step came
    // back occupied, and the enemy still ends the tick no further from
    // the core than it started — which is why F5c's
    // `test_a_blocked_enemy_never_moves_away_from_the_core` holds
    // unchanged through this phase.
    es_d = flow_distance(f, e.q, e.r);
    if es_d == 0 { return; }                    // arrived; attacking the core is combat's job
    if es_d < FLOW_UNREACHABLE {
        for es_t in flow_steps(f, e.q, e.r) {
            if occupancy_taken(occ, es_t.q, es_t.r) { continue; }
            // ⚠ A vehicle blocks a step exactly as a companion does
            // (plan 13 V5).  What differs is the CONSEQUENCE, not the
            // movement: `wave_block` charges an enemy that has no way
            // round, and a companion is never attacked for the same
            // obstruction.
            // ⚠ Since plan 14 H3 that is the whole crew and not just
            // the player — one map, so an enemy cannot walk through an
            // NPC it would have been stopped by if the player were
            // driving it.
            if blocker_taken(blockers, es_t.q, es_t.r) { continue; }
            enemy_move_to(e, es_t.q, es_t.r, occ);
            return;
        }
        // F3's sweep proves the arrow never stalls on a reachable
        // cell, so the only way to get here is a companion on every
        // closer neighbour — the ground already said yes.  That makes
        // this branch the pure companion case, and moving beside is
        // exactly what the spec asks for.
        for es_s in flow_sidesteps(f, e.q, e.r) {
            if occupancy_taken(occ, es_s.q, es_s.r) { continue; }
            if blocker_taken(blockers, es_s.q, es_s.r) { continue; }
            enemy_move_to(e, es_s.q, es_s.r, occ);
            return;
        }
        // Hemmed in on every side at this distance too.  Standing
        // still is the right answer — a jam is not a licence to
        // wander off the route.
        return;
    }

    // ── Inside the bubble, but with no route to the core ─────────
    //
    // The siege (plan 11 F7).  It still wants the core, so it walks
    // down the DESIRE field — the same sweep with walls passable — and
    // stops where the height rule refuses the next step.  That hex is
    // what it attacks, and `enemy_target` names it.
    //
    // ⚠ **Why a field and not "the nearest wall".**  A target computed
    // once from the perimeter hands every enemy the SAME hex and
    // collapses the siege back to one chokepoint, which is the thing
    // `docs/ENEMY_MOVEMENT.md` § Sealing the perimeter exists to
    // prevent.  Following each enemy's own gradient makes the target a
    // consequence of where it came from, so enemies from different
    // sides meet the wall at different hexes with nothing coordinating
    // them.
    enemy_walk_desire(e, pal, pw, hl, desire, occ);
}

// One step down the desire gradient, if the step is one this class can
// take and nobody is standing on it — plan 11 F7.
//
// The same shape as the engage branch, over the other field: take the
// first FREE and LEGAL entry in preference order, otherwise stand
// still.  `flow_steps` offers only strictly-closer hexes, so a besieging
// enemy never wanders away from the core while it looks for a way in.
//
// ⚠ Its steps are checked with `can_step` where the engage branch's are
// not, and that asymmetry is the point: the routing field already
// refused every hex this class cannot enter, while the desire field
// deliberately did NOT — walls are passable in it, which is what makes
// it able to say where the wall is.
//
// ── Why "the wall is in the way" is asked FIRST ──────────────────
//
// Plan 11 F7b, sharpened by plan 24 W1.  In the engage branch every
// closer step the field offers is one the ground already allowed, so
// "nothing was free" can only mean a companion and moving beside is
// unambiguous.  Here it can mean two completely different things, and
// they want opposite answers:
//
//   - **a companion is on it** — the enemy is queueing behind someone,
//     and `ENEMY_MOVEMENT.md` § Sealing the perimeter says it moves
//     BESIDE them.  That is the sidestep.
//   - **the WALL is on it** — the enemy has arrived at what it came to
//     break.  It must stand still, because `enemy_target` names the
//     hex in front of it and `wave_damage` spends its second there.
//
// ⚠ **Sidestepping a terrain block would be a jitter, not a spread.**
// An unconditional sidestep would send a besieger shuffling along the
// face for ever, attacking a different hex every tick and finishing
// none of them.
//
// ⚠⚠ **F7b told the two apart with `ewd_queued`, AFTER the walk — and
// that was the defect `@M019` found.**  Asking the question late means
// an enemy with any legal closer step walks, even when another of its
// closer steps is the wall it is standing beside.  On a straight face
// only three hexes ever lack a legal step (the desire ring has one
// minimum on it), so the front was three wide **for any wall length**
// — plan 23 K3's `@M018` — and two of every five besiegers walked
// away from a wall they were touching.  The pre-pass below asks it
// first, which is the whole of plan 24 W1.
fn enemy_walk_desire(e: Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                     hl: const HeightLayer, desire: const FlowField, occ: Occupancy) {
    ewd_from = Hex { q: e.q, r: e.r };

    // ── ⚠⚠ ARRIVING BEATS QUEUEING (plan 24 W1) ─────────────────
    //
    // A besieger standing beside a wall it could break attacks it,
    // rather than walking on down a gradient whose next hex a
    // companion is already holding.  ⚠ It is a PRE-PASS and it has to
    // be: the decision is *do I walk at all*, so it cannot be a branch
    // inside a loop that has already moved.
    //
    // ⚠ **This is what widens the front, and the reason is `@M019`.**
    // A desire field is a ring around the CORE, so a straight face has
    // exactly ONE minimum: only that hex and the two where the lateral
    // step runs out had no legal closer step, which is **three for any
    // wall length** and is the whole of `@M018`.  Every other face hex
    // was touching the wall and walking sideways to queue behind the
    // minimum.  Asking *"is a wall between me and the core?"* instead
    // of *"can I still move?"* makes the front as wide as the face.
    //
    // ⚠ **It needs no memory and cannot jitter.**  An enemy that stops
    // here never moves again, and `flow_steps` is in `lat_neighbours`
    // order, so `enemy_target` names the same hex every tick — which
    // is what plan 11 F7b's `ewd_queued` had to buy with a condition.
    //
    // ⚠ **`enemy_target` asks this identical question**, deliberately
    // in the same words: the mover and the targeter disagreeing is an
    // enemy that stands still attacking nothing, or one that walks
    // away from the hex it is recorded as biting.
    for ewd_w in flow_steps(desire, e.q, e.r) {
        if !can_step(pal, pw, hl, e.kind, ewd_from, ewd_w) { return; }
    }

    // Past the pre-pass every strictly-closer step is one the ground
    // allows, so "nothing was free" can only mean a companion — which
    // is the unambiguous case plan 11 F7b's sidestep was written for,
    // and it no longer needs `ewd_queued` to tell the two apart.
    ewd_queued = false;
    for ewd_t in flow_steps(desire, e.q, e.r) {
        if occupancy_taken(occ, ewd_t.q, ewd_t.r) { ewd_queued = true; continue; }
        enemy_move_to(e, ewd_t.q, ewd_t.r, occ);
        return;
    }
    if !ewd_queued { return; }      // nowhere to go at all: stand

    for ewd_s in flow_sidesteps(desire, e.q, e.r) {
        if !can_step(pal, pw, hl, e.kind, ewd_from, ewd_s) { continue; }
        if occupancy_taken(occ, ewd_s.q, ewd_s.r) { continue; }
        enemy_move_to(e, ewd_s.q, ewd_s.r, occ);
        return;
    }
}

// The hex this enemy is attacking — its own hex when it is attacking
// nothing.
//
// Plan 11 F7.  `docs/ENEMY_MOVEMENT.md` § Two modes: *"An enemy never
// halts permanently.  Blocked, it attacks — because it still wants the
// core."*  This says WHICH hex; the damage is combat's, and nothing
// here takes any.
//
// ⚠ **You attack what you could stand on and cannot climb.**  The
// target is always a hex whose SURFACE is walkable — a wall's top, a
// body pile — so an enemy at the water's edge is not besieging the
// sea.  In the siege branch that is free (every cell of the desire
// field is walkable by construction); approach mode has to ask.
//
// Returning the enemy's own hex for "nothing" follows `flow_step`'s
// convention: a caller that ignores the answer attacks nobody rather
// than attacking something arbitrary.
pub fn enemy_target(e: const Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                    hl: const HeightLayer, f: const FlowField, desire: const FlowField) -> Hex {
    ent_here = Hex { q: e.q, r: e.r };
    if !e.alive { return ent_here; }

    // An enemy still standing at its marker is not going anywhere, so
    // nothing is in its way (plan 16 W2).  Its own hex is what this
    // function already answers for "attacking nothing", so a standing
    // enemy contributes no target and `wave_damage` lands nothing —
    // one guard rather than a second condition at every reader.
    if enemy_standing(e) { return ent_here; }

    // Approach mode: the route is the heading, so the obstacle is the
    // one hex ahead.
    if !enemy_in_bubble(e, f.core) {
        ent_ahead = lat_neighbour(ent_here, e.heading as integer);
        if can_step(pal, pw, hl, e.kind, ent_here, ent_ahead) { return ent_here; }
        if !hex_walkable(pal, pw, hl, ent_ahead.q, ent_ahead.r) { return ent_here; }
        return ent_ahead;
    }

    // A route exists, so nothing is in the way: F6 guarantees every
    // step the routing field offers is one this class can take, and a
    // companion on it is a delay rather than a target (F5c — occupancy
    // is never attacked).
    if flow_reachable(f, e.q, e.r) { return ent_here; }

    // The siege: the first blocked step down the desire gradient.
    //
    // ⚠⚠ **Arriving beats queueing** (plan 24 W1), and this is the
    // targeting half of it — `enemy_walk_desire`'s pre-pass is the
    // mover's half, asked in the same words on purpose.  A wall
    // between this enemy and the core is what it came to break,
    // whether or not some OTHER neighbour would still let it walk.
    //
    // ⚠ It used to answer *"attacking nothing"* the moment any closer
    // step was legal, and `@M019` is what that cost: on a straight
    // face only three hexes ever lack one, for any wall length, so a
    // wave's usable width was three however wide the perimeter
    // (`@M018`) and two of every five besiegers stood beside a wall
    // they were not touching.
    //
    // ⚠ **No occupancy is consulted, and that is a constraint rather
    // than a choice** — this function takes none, and the rule is
    // phrased *"a wall is in my way"* rather than *"my closer steps
    // are held"* so that it does not need any.  A target that moved
    // with the crowd would also change during the move loop, and
    // `wave_damage` reads it afterwards.
    for ent_t in flow_steps(desire, e.q, e.r) {
        if !can_step(pal, pw, hl, e.kind, ent_here, ent_t) { return ent_t; }
    }
    ent_here
}

// Move an enemy, keeping the occupancy it moves through in step with
// it.  ⚠ The two updates are ONE operation: an enemy that entered
// without leaving would block the hex behind it for the rest of the
// tick, and the enemies behind it would never advance.
fn enemy_move_to(e: Enemy, q: integer, r: integer, occ: Occupancy) {
    occupancy_leave(occ, e.q, e.r);
    occupancy_enter(occ, q, r);
    e.q = q;
    e.r = r;
}

// Is this enemy inside the core's scrambler bubble?
//
// ⚠ Measured as a STRAIGHT-LINE hex distance, not as a route length.
// The bubble is a comms-jamming sphere carved by the core
// (`docs/DESIGN.md` § core), so an enemy three hexes from the core
// with a forty-step route around a wall is INSIDE it — jamming does
// not care how far you would have to walk.  Using the field distance
// instead would make the bubble bulge and shrink as the player builds,
// which is not what the fiction or the numbers describe.
//
// Inclusive at the boundary, matching `active_spawn_markers`'
// `>= disable_radius`: the hex the radius names is in.
pub fn enemy_in_bubble(e: const Enemy, core: Hex) -> boolean {
    lat_distance(core, Hex { q: e.q, r: e.r }) <= SCRAMBLER_BUBBLE_RADIUS
}

// One step along the enemy's heading, if the hex it would enter is one
// its class can hold and nobody is standing on it — approach mode's
// whole movement rule (plan 11 F1b, plus F5c's occupancy).
//
// A heading has no alternatives: there is one hex ahead, so a blocked
// enemy simply stops one hex short.  That is enough for the thing F5c
// is for — a column pressing a wall ends on distinct hexes instead of
// piling onto the single hex in front of it — and it is all approach
// mode can honestly do, having no field to say which way "beside" is.
fn enemy_walk_heading(e: Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                      hl: const HeightLayer, occ: Occupancy) {
    et_from = Hex { q: e.q, r: e.r };
    et_to   = lat_neighbour(et_from, e.heading as integer);
    // ⚠ ONE rule, shared with the `enemies passable` assertion that
    // measures it (`passable.loft`).  If the mover and the
    // measurement each had their own idea of passability, a green
    // gate would only prove the two agreed — not that either was
    // right.
    //
    // The MOVE, not the destination (plan 11 F6): a hex an enemy
    // could stand on is not automatically one it can climb onto from
    // where it is now, and after F6 the two stop coinciding.
    if !can_step(pal, pw, hl, e.kind, et_from, et_to) { return; }
    if occupancy_taken(occ, et_to.q, et_to.r) { return; }
    enemy_move_to(e, et_to.q, et_to.r, occ);
}

// ─── The fields, one per CLIMB LIMIT in the roster ──────────────

// One climb limit's field for this tick.
pub struct ClassField {
    climb: float,
    field: FlowField,
}

// A field for every distinct CLIMB LIMIT among the alive enemies, each
// built once.
//
// Not a field per class the game knows about: a field built for nobody
// is a number in a profile that nobody can explain.  And not ONE
// shared field either — a wall stops a robot and an insect climbs it,
// so a shared field would move insects along a route computed for
// something that cannot climb (plan 11 F0: passability is boolean, so
// nothing weighs an edge — it is separate fields, not one with costs).
//
// ⚠ **Keyed by the climb limit and not by the class** (plan 11 F6).
// `climb_limit` is the class's whole contribution to passability, so
// two classes that climb the same distance produce IDENTICAL fields
// and building both is duplicated work that also invites them to
// drift.  It is not a guess: `tests/11_f6_height_step.loft` asserts
// that two kinds agreeing on their limit produce equal fields, so the
// day a class gains a second movement axis the key goes red instead of
// quietly sharing a field it should not.
pub fn wave_fields(state: const WaveState, pal: vector<GroundType>,
                   pw: PaintedWorld, core: Hex) -> vector<ClassField> {
    wf_out: vector<ClassField> = [];
    for wf_e in state.enemies {
        if wf_e.alive && !fields_have(wf_out, climb_limit(wf_e.kind)) {
            wf_out += [ClassField {
                climb: climb_limit(wf_e.kind),
                field: flow_build(pal, pw, state.heights, wf_e.kind, core),
            }];
        }
    }
    wf_out
}

fn fields_have(fields: const vector<ClassField>, climb: float) -> boolean {
    fh_seen = false;
    for fh_f in fields {
        if fh_f.climb == climb { fh_seen = true; }
    }
    fh_seen
}

// ─── Reading a class's field WITHOUT copying it ─────────────────
//
// Plan 11 F8, and it is the phase's whole finding.  There used to be a
// `field_of(fields, kind) -> FlowField` here, and every caller looked
// exactly right:
//
//     enemy_tick(e, pal, pw, hl, field_of(fields, e.kind), desire, occ)
//
// **`fo_out = fo_f.field` is a whole-value bind, which COPIES the heap
// value** — the entire cell hash, per enemy, per lookup.  Measured on a
// radius-40 world (4921 hexes, the haze radius `numbers.json` bounds
// the world at) with an 80-enemy wave, the largest the wave list goes:
//
//   | lookup                        | 80 calls |
//   |-------------------------------|----------|
//   | via `field_of`                | 162052 us |
//   | passing `cf.field` through    |     72 us |
//
// **2250x, and the copy is O(cells) where the read is O(1).**  It was
// 51% of a tick that already ran at 96% of its budget, and it had been
// there since F5 — invisible, because a copy changes no behaviour and
// dryopea has no gate that can see cost.
//
// So there is no accessor: a caller loops the fields and passes
// `cf.field` STRAIGHT into a `const` parameter.  Nothing binds a
// `FlowField` to a local in a per-enemy path, and the helpers below
// exist so that no caller has to remember why.

// How far this enemy's class thinks (q, r) is from the core.
fn field_distance(fields: const vector<ClassField>, kind: u8,
                  q: integer, r: integer) -> integer {
    fd_climb = climb_limit(kind);
    for fd_f in fields {
        if fd_f.climb == fd_climb { return flow_distance(fd_f.field, q, r); }
    }
    FLOW_UNREACHABLE
}

// ─── The move order ─────────────────────────────────────────────
//
// Plan 11 F5c.  Once companions block a step, WHO MOVES FIRST changes
// where everybody ends up — so the order has to be a property of the
// state and not of the roster, or `ENEMY_MOVEMENT.md` § The tick
// resolves once is lost and with it every scripted number plan 08
// gates on.
//
// ⚠ **Closest to the core moves first, and that is not arbitrary.**
// Measured (plan 11 § F5c): with the tail moving first, a column in a
// corridor stretches — each enemy is blocked by the one ahead, which
// has not moved yet, so only the leader advances and the follower
// falls a hex behind every tick.  Leader-first, the whole column steps
// into the space the one ahead has just left and advances in lockstep,
// which is what a queue in a corridor should look like.
//
// "Closest to the core" is the FIELD distance, so it means the same
// thing whichever compass direction the column runs; ordering on a
// coordinate would make a westbound column advance and an eastbound
// one stretch.
//
// The rest of the key only has to be deterministic and state-derived.
// Roster index is the LAST resort, and it can only decide between
// enemies that agree on distance, hex and class — which are
// interchangeable, so the multiset of outcomes cannot depend on it.
// That is the whole order-independence argument, and
// `tests/11_f5c_spread.loft` asserts it against a reversed roster.

struct MoveSlot {
    idx:   integer,
    dist:  integer,
    q:     integer,
    r:     integer,
    kind:  integer,
    taken: boolean,
}

fn slot_before(a: const MoveSlot, b: const MoveSlot) -> boolean {
    if a.dist != b.dist { return a.dist < b.dist; }
    if a.q    != b.q    { return a.q    < b.q; }
    if a.r    != b.r    { return a.r    < b.r; }
    if a.kind != b.kind { return a.kind < b.kind; }
    a.idx < b.idx
}

// Roster indices in move order — a selection sort, because a wave is
// tens of enemies and the clarity is worth more than the exponent.
fn move_order(state: const WaveState, fields: const vector<ClassField>) -> vector<integer> {
    mo_slots: vector<MoveSlot> = [];
    mo_i = 0;
    for mo_e in state.enemies {
        if mo_e.alive {
            mo_slots += [MoveSlot {
                idx:   mo_i,
                dist:  field_distance(fields, mo_e.kind, mo_e.q, mo_e.r),
                q:     mo_e.q,
                r:     mo_e.r,
                kind:  mo_e.kind as integer,
                taken: false,
            }];
        }
        mo_i = mo_i + 1;
    }

    mo_out: vector<integer> = [];
    for _ in 0..len(mo_slots) {
        mo_best = -1;
        mo_at   = 0;
        for mo_s in mo_slots {
            if !mo_s.taken {
                mo_b = mo_slots[mo_best] ?? MoveSlot {};
                if mo_best < 0 || slot_before(mo_s, mo_b) { mo_best = mo_at; }
            }
            mo_at = mo_at + 1;
        }
        if mo_best < 0 { return mo_out; }
        mo_mark = 0;
        for mo_t in mo_slots {
            if mo_mark == mo_best { mo_t.taken = true; }
            mo_mark = mo_mark + 1;
        }
        mo_out += [(mo_slots[mo_best] ?? MoveSlot {}).idx];
    }
    mo_out
}

// ─── The desire field, built only when somebody is besieging ────

// Is anybody in a position to need the desire field this tick?
//
// It is the same argument `wave_fields` makes about classes: a sweep
// built for nobody is a cost in a profile nobody can explain.  Only an
// enemy INSIDE the bubble with no route consults it — outside the
// bubble is approach mode, which follows its heading and never asks.
fn wave_needs_desire(state: const WaveState, fields: const vector<ClassField>) -> boolean {
    for wnd_e in state.enemies {
        if wnd_e.alive {
            // ⚠ `wnd_cf.field` is read in place, never bound — see
            // § Reading a class's field WITHOUT copying it.  This runs
            // once per enemy per tick, so a bind here costs as much as
            // the whole rebuild it is deciding whether to skip.
            wnd_climb = climb_limit(wnd_e.kind);
            for wnd_cf in fields {
                if wnd_cf.climb == wnd_climb
                    && enemy_in_bubble(wnd_e, wnd_cf.field.core)
                    && !flow_reachable(wnd_cf.field, wnd_e.q, wnd_e.r) {
                    return true;
                }
            }
        }
    }
    false
}

// The desire field for this tick, or an empty one when nobody is
// besieging.  ⚠ An empty field offers no steps, so a mover handed one
// moves nobody — which is what a caller that skipped the build should
// see, rather than a plausible wrong move.
pub fn wave_desire(state: const WaveState, fields: const vector<ClassField>,
                   pal: vector<GroundType>, pw: PaintedWorld, core: Hex) -> FlowField {
    if !wave_needs_desire(state, fields) { return flow_empty(); }
    flow_desire(pal, pw, state.heights, core)
}

// What every enemy in the roster is attacking, aligned with it — an
// enemy's OWN hex where it is attacking nothing.
//
// Plan 11 F7, and the door `target` / `count targets` read.  It builds
// its own fields rather than taking a tick's: a measurement runs
// between ticks, and one that reused a stale field could report a
// siege the world had already ended.
pub fn wave_targets(state: const WaveState, pal: vector<GroundType>,
                    pw: PaintedWorld, core: Hex) -> vector<Hex> {
    wtg_fields = wave_fields(state, pal, pw, core);
    wtg_desire = flow_desire(pal, pw, state.heights, core);
    wtg_out: vector<Hex> = [];
    for wtg_e in state.enemies {
        // A dead enemy's class may have no field at all, and then the
        // loop simply does not fire — which is the same answer
        // `enemy_target` gives it anyway: its own hex.
        wtg_t = Hex { q: wtg_e.q, r: wtg_e.r };
        wtg_climb = climb_limit(wtg_e.kind);
        for wtg_cf in wtg_fields {
            if wtg_cf.climb == wtg_climb {
                wtg_t = enemy_target(wtg_e, pal, pw, state.heights,
                                     wtg_cf.field, wtg_desire);
            }
        }
        wtg_out += [wtg_t];
    }
    wtg_out
}

// Where everybody stands right now.
//
// ⚠ Built ONCE per tick and then kept in step by the mover, rather
// than re-derived per enemy: a hex a companion has already left this
// tick is FREE, which is what lets a column advance in lockstep
// instead of at half speed — see § The move order.
pub fn wave_occupancy(state: const WaveState) -> Occupancy {
    wo_o = occupancy_empty();
    for wo_e in state.enemies {
        if wo_e.alive { occupancy_enter(wo_o, wo_e.q, wo_e.r); }
    }
    wo_o
}

// Where everybody on the PLAYER's side stands right now (plan 14 H3).
//
// The sibling of `wave_occupancy`, built at the same moment and for
// the same reason — and a second map rather than a second count,
// because an enemy treats the two differently: it steps beside a
// companion and it attacks a vehicle (`occupancy.loft` § The other
// map).
//
// ⚠ **A WRECK is not a blocker.**  A downed helper is scenery until
// somebody carries it home (H4), so it does not stop an enemy and
// cannot be attacked again — otherwise the first crew member to die in
// a corridor would become a permanent obstruction that every later
// wave stops to hit, which is a wall the player built by accident.
// ⚠ It is also the reason this map is rebuilt each tick rather than
// kept: the roster's contents are the same, and which of them COUNT
// changes.
pub fn wave_blockers(state: const WaveState) -> BlockerMap {
    wb_b = blocker_empty();
    if vehicle_present(state.player) {
        blocker_set(wb_b, state.player.q, state.player.r, BLOCKER_PLAYER);
    }
    wb_i = 0;
    for wb_h in state.crew {
        if wb_h.alive { blocker_set(wb_b, wb_h.q, wb_h.r, BLOCKER_CREW + wb_i); }
        wb_i += 1;
    }
    wb_b
}

// Which enemy a tower at `at` fires on — a roster index, or `-1` for
// nothing it can reach AND see.
//
// **Nearest to the TOWER**, because that is what a range-limited
// weapon does, with ties broken by `q` then `r` and never by roster
// position.
//
// ⚠ **The tie-break is not decoration.**  A wave arrives spread, so
// equidistant enemies are common, and "whichever the loop saw first"
// would make a scripted run answer differently the moment anything
// changed spawn order — which plan 08 gates dryopea by replaying.
// Ordering by coordinate makes the answer a property of the WORLD
// rather than of the roster.
//
// ⚠ **The sight check is LAST, and that is a cost decision.**
// `tower_sees` walks up to 15 hexes and asks `hex_height` at each, so
// asking it of all 80 enemies in a wave would put a line trace per
// enemy per shot into the tick.  A candidate that does not beat the
// best on distance cannot be picked whether it is visible or not, so
// the trace only runs for a candidate that would otherwise be taken —
// a handful per shot rather than a roster's worth.  The answer is
// identical, which is what makes this an ordering and not a rule.
//
// ⚠ **A blind tower answers -1, exactly like an empty field**, and
// `wave_fire` treats the two the same on purpose: a tower cannot spend
// a shot it did not fire, whether the reason is that there was nothing
// there or that a wall was.
pub fn tower_pick(state: const WaveState, pal: vector<GroundType>, pw: PaintedWorld,
                  at: const Hex) -> integer {
    tp_best = -1;
    tp_dist = 0;
    tp_q    = 0;
    tp_r    = 0;
    tp_i    = 0;
    for tp_e in state.enemies {
        if tp_e.alive {
            tp_h = Hex { q: tp_e.q, r: tp_e.r };
            tp_d = lat_distance(at, tp_h);
            if tp_d <= TOWER_RANGE_HEXES {
                tp_take = tp_best < 0;
                if !tp_take && tp_d < tp_dist { tp_take = true; }
                if !tp_take && tp_d == tp_dist && tp_e.q < tp_q { tp_take = true; }
                if !tp_take && tp_d == tp_dist && tp_e.q == tp_q && tp_e.r < tp_r {
                    tp_take = true;
                }
                if tp_take && tower_sees(pal, pw, state.heights, at, tp_h,
                                         enemy_height(tp_e.kind)) {
                    tp_best = tp_i;
                    tp_dist = tp_d;
                    tp_q    = tp_e.q;
                    tp_r    = tp_e.r;
                }
            }
        }
        tp_i = tp_i + 1;
    }
    tp_best
}

// Every tower banks a tick's worth of charge and spends whatever whole
// intervals it holds.  Answers how many shots were fired.
//
// ⚠ **It runs BEFORE anybody moves**, beside `wave_damage`: a tower
// shoots at where an enemy IS at the tick's start, and the enemy then
// takes its step.  So a fatal shot is followed by one last step and
// the body falls one hex down the route — the consequence B4 wrote
// down, arriving here with its first real cause.
//
// ⚠ It lands DAMAGE and never a death.  `wave_deaths` at the end of
// the tick is the one death path (B4), so a tower kill and a scripted
// `hit` leave the same body in the same place.
//
// ⚠ **A shot is spent only when it is FIRED, and it is fired only at
// something the tower can see** (B5b).  One rule, and it covers both
// halves of the gate: a tower with nothing in range and a tower whose
// every line is blocked both hold their charge and their budget,
// because neither of them took a shot.  `DESIGN.md` § 7's decay is per
// SHOT — an idle tower in a quiet corner never decays — and a budget
// that fell while the tower was staring at a wall would be a timer
// wearing a magazine's name.
//
// ⚠ What stops that becoming a stockpile is `tower_hold`: a tower that
// could not fire keeps ONE interval and drops the rest, so a line that
// opens after a hundred blind ticks buys one shot and not sixty-six.
//
// ⚠ A **black** tower is inert — it does not even bank.  Nothing in
// this plan repairs one, so in an unattended run that is terminal, and
// it is half of what B7's clock measures.
pub fn wave_fire(state: WaveState, pal: vector<GroundType>, pw: PaintedWorld,
                 mw: MarkerWorld) -> integer {
    wf_shots = 0;
    for wf_m in mw.markers {
        // ⚠ **A topless tower does not fire, whatever its magazine
        // says** (plan 17 T2).  `tower_black` means SPENT and
        // `tower_has_top` means there is something up there to spend —
        // two different reasons not to shoot, and folding them into one
        // predicate would make a freshly-detached tower read as a
        // fully-loaded one.
        if wf_m.kind == MARKER_KIND_TOWER as u8
           && tower_has_top(state.towers, wf_m.q, wf_m.r)
           && !tower_black(state.towers, wf_m.q, wf_m.r) {
            tower_bank(state.towers, wf_m.q, wf_m.r, TICK_SECONDS);
            wf_at = Hex { q: wf_m.q, r: wf_m.r };
            // ⚠ WHILE, not IF — see `tower.loft` § Why a tower needs
            // runtime state.  A tower ticked after a pause spends
            // every interval it banked rather than losing them.
            // ⚠ EPSILON, not a bare `>=` — a tick is 1/1.5 s and has
            // no exact float form, so three of them sum a hair under
            // two seconds and the tower silently drops every third
            // shot (`tower.loft` § TOWER_CHARGE_EPSILON).
            while tower_charge(state.towers, wf_m.q, wf_m.r)
                  >= TOWER_FIRE_INTERVAL_S - TOWER_CHARGE_EPSILON
                  && !tower_black(state.towers, wf_m.q, wf_m.r) {
                wf_i = tower_pick(state, pal, pw, wf_at);
                // ⚠ **The break is the phase.**  Nothing to shoot means
                // the interval is NOT spent, so this loop would spin
                // for ever without it — which is the shape of the bug
                // that says "hold your fire" and means "hang".
                if wf_i < 0 { break; }
                tower_bank(state.towers, wf_m.q, wf_m.r, -TOWER_FIRE_INTERVAL_S);
                tower_spend_shot(state.towers, wf_m.q, wf_m.r);
                // ⚠ Indexed in place, never through a helper that
                // RETURNS an `Enemy` — a returned struct is a copy and
                // the hit would land on nothing (B4).
                enemy_hurt(state.enemies[wf_i] ?? Enemy {}, TOWER_DAMAGE_PER_SHOT);
                wf_shots = wf_shots + 1;
            }
            tower_hold(state.towers, wf_m.q, wf_m.r);
        }
    }
    wf_shots
}

// What every besieging enemy does to the structure it is stopped by,
// this tick.
//
// ⚠ **It runs BEFORE anybody moves, off the fields the tick already
// built.**  An enemy attacks exactly when `enemy_target` names a hex
// other than its own — which is to say when nothing down its route is
// a step it can take — so the pre-move state is the state that
// decides, and reading it once up front is what makes the answer
// independent of the order the roster is walked in.
//
// ⚠ Only a BREAKABLE hex is written to.  A target can be a heap of
// rubble too high to climb, and chewing one does nothing in this plan
// — recording it anyway would fill the ledger with entries that can
// never resolve, and would make `damage_count` mean something other
// than "structures under attack".
fn wave_damage(state: WaveState, pal: vector<GroundType>, pw: PaintedWorld,
               fields: const vector<ClassField>, desire: const FlowField) {
    for wd_e in state.enemies {
        if wd_e.alive {
            // ⚠ **The bite is per ENEMY since plan 23 K0**, where it
            // used to be hoisted out of the loop.  A miner and a scout
            // in one wave chew the same wall at different rates, so a
            // single rate for the roster is no longer expressible —
            // and hoisting it back would silently give the whole wave
            // whichever class happened to be first.
            wd_bite  = per_tick(enemy_damage_to_wall(wd_e.kind));
            wd_climb = climb_limit(wd_e.kind);
            for wd_cf in fields {
                if wd_cf.climb == wd_climb {
                    // ⚠ The field goes STRAIGHT from the vector into a
                    // `const` parameter — binding it to a local copies
                    // the whole cell hash, once per enemy (plan 11 F8).
                    wd_t = enemy_target(wd_e, pal, pw, state.heights,
                                        wd_cf.field, desire);
                    if wd_t.q != wd_e.q || wd_t.r != wd_e.r {
                        if structure_breakable(pal, pw, wd_t.q, wd_t.r) {
                            damage_apply(state.damage, wd_t.q, wd_t.r, wd_bite);
                        }
                    }
                }
            }
        }
    }
}

// Drain the wallet by one tick's worth of nibbling, and answer how
// many enemies were doing it.
//
// `docs/DESIGN.md` § Enemy targeting + nibble puts the core SECOND in
// an enemy's priority list — above a wall, below a blocker — and this
// is that entry.  An enemy that has arrived is done routing and done
// besieging; it stands on the building and bleeds the player's
// budget for as long as it is there.
//
// ⚠ **Reach, not targeting.**  `enemy_target` deliberately answers
// the enemy's OWN hex for an enemy that has arrived — it names what
// is in the WAY, and nothing is — so there is no target to consult
// here and no field to walk.  What a nibbler is, is a position:
// `wallet.loft::nibble_in_reach`, one `lat_distance` per live enemy.
// That is also why this pass is cheap enough not to show up in
// `tests/11_f8_the_tick_budget.loft` — it is strictly less work per
// enemy than the `enemy_in_bubble` the mover already does.
//
// ⚠ **Summed, then drained ONCE.**  Not because N small drains would
// arrive at a different number — the clamp is a `min`, so they would
// not — but because the count is the thing B6's gate names (*N
// nibblers drain exactly N pt/s*), and a single write is the site
// that can be read against it.
//
// ⚠ **Called BEFORE the move loop**, beside `wave_damage`, so both
// halves of the exchange are spent against the world the tick STARTED
// with.  An enemy that arrives this tick pays next tick — the same
// rule a breach follows, and the one that keeps a tick
// order-independent.
fn wave_nibble(state: WaveState, core: const Hex) -> integer {
    wn_n = 0;
    for wn_e in state.enemies {
        if wn_e.alive && nibble_in_reach(core, wn_e.q, wn_e.r) {
            wn_n += 1;
        }
    }
    if wn_n > 0 {
        wallet_drain(state.wallet,
                     per_tick(NIBBLE_POINTS_PER_SECOND) * (wn_n as float));
    }
    wn_n
}

// Is the PLAYER the reason this enemy cannot advance?
//
// Plan 13 V5, and it is `DESIGN.md` § 8's *"physically blocking an
// enemy's path to the core"* made exact.  Three conditions, and all
// three are needed:
//
//   1. the vehicle is standing on one of this enemy's strictly-closer
//      steps — it is in the WAY, not merely nearby;
//   2. every other closer step is taken — there is no way forward
//      round it;
//   3. every sidestep is taken too — there is no way ROUND it at all.
//
// ⚠ **Condition 3 is what stops the vehicle being a wall.**  In the
// open an enemy simply goes round (plan 11 F7b) and nobody is blocked
// or damaged, which is exactly `DESIGN.md` § 8's *"in the absence of a
// blocker, the player and NPCs are ignored"*.  It is in a **narrow
// entrance or a kill funnel** — the two examples the design gives —
// that there is nowhere to go and the player becomes a liability.  So
// the mechanic is emergent from the map rather than from a rule about
// parking.
//
// ⚠ **A COMPANION is never attacked for the same obstruction**
// (`occupancy.loft`: *"a companion blocks a step and is never attacked
// for it"*).  That asymmetry is the design's, not an oversight: robots
// ignore each other and attack the thing that does not belong.
// ⚠ **It answers WHICH vehicle, because a roster can have several in
// the way** (plan 14 H3).  The one attacked is the blocker on the
// BEST step — the hex the enemy wanted first — which is the only
// choice that reads as "it hits what it is facing" and the only one
// that keeps a scripted run repeatable.  `BLOCKER_NONE` for an enemy
// that is not blocked by anyone.
fn enemy_blocked_by(e: const Enemy, f: const FlowField,
                    occ: const Occupancy, b: const BlockerMap) -> integer {
    if !e.alive { return BLOCKER_NONE; }
    // Nobody is in the way of an enemy that has not started walking
    // (plan 16 W2) — so a player parked on a spawn marker is not
    // attacked for the five seconds before the wave sets off, and the
    // window is a window for them too.
    if enemy_standing(e) { return BLOCKER_NONE; }

    ebp_hit = BLOCKER_NONE;
    for ebp_t in flow_steps(f, e.q, e.r) {
        ebp_id = blocker_at(b, ebp_t.q, ebp_t.r);
        if ebp_id != BLOCKER_NONE {
            if ebp_hit == BLOCKER_NONE { ebp_hit = ebp_id; }
            continue;
        }
        if !occupancy_taken(occ, ebp_t.q, ebp_t.r) { return BLOCKER_NONE; }
    }
    if ebp_hit == BLOCKER_NONE { return BLOCKER_NONE; }

    for ebp_s in flow_sidesteps(f, e.q, e.r) {
        if blocker_taken(b, ebp_s.q, ebp_s.r) { continue; }
        if !occupancy_taken(occ, ebp_s.q, ebp_s.r) { return BLOCKER_NONE; }
    }
    ebp_hit
}

// Spend a tick of blocker damage on the player, and answer how many
// enemies were doing it.
//
// ⚠ Called with `wave_damage` and `wave_nibble`, off the PRE-move
// world, so all three halves of the exchange are spent against the
// same tick — and the respawn a fatal blow causes lands at the END
// with the deaths and the breaks.
// ⚠ **Tallied per BLOCKER, then spent once each** (plan 14 H3).  The
// rate is *per attacker*, so two enemies stopped by one helper cost it
// twice as much and two enemies stopped by two different helpers cost
// each of them once — which is the same sentence plan 13 V5 wrote when
// the player was the only thing that could be hit.
//
// ⚠ The tally is a vector indexed by ID and not a lookup per enemy,
// because the roster is at most seven long and the enemies are not.
fn wave_block(state: WaveState, fields: const vector<ClassField>,
              occ: const Occupancy, blockers: const BlockerMap) -> integer {
    wb_hits: vector<integer> = [];
    for _ in 0..(BLOCKER_CREW + len(state.crew)) { wb_hits += [0]; }

    wb_n = 0;
    for wb_e in state.enemies {
        wb_climb = climb_limit(wb_e.kind);
        for wb_cf in fields {
            if wb_cf.climb == wb_climb {
                // ⚠ The field goes STRAIGHT into a `const` parameter —
                // binding it to a local copies the whole cell hash
                // (plan 11 F8).
                wb_id = enemy_blocked_by(wb_e, wb_cf.field, occ, blockers);
                if wb_id != BLOCKER_NONE && wb_id < len(wb_hits) {
                    wb_hits[wb_id] = (wb_hits[wb_id] ?? 0) + 1;
                    wb_n += 1;
                }
            }
        }
    }
    if wb_n == 0 { return 0; }

    wb_rate = per_tick(ENEMY_DAMAGE_TO_BLOCKER_PER_SECOND);
    wb_player = wb_hits[BLOCKER_PLAYER] ?? 0;
    if wb_player > 0 {
        vehicle_hurt(state.player, wb_rate * (wb_player as float));
    }
    wb_c = 0;
    for wb_h in state.crew {
        wb_took = wb_hits[BLOCKER_CREW + wb_c] ?? 0;
        if wb_took > 0 { helper_hurt(wb_h, wb_rate * (wb_took as float)); }
        wb_c += 1;
    }
    wb_n
}

// Kill every enemy that has absorbed its whole HP, and leave a body
// where each one stood.  Answers how many died.
//
// ⚠ **Two effects, and the gate wants BOTH.**  A death frees its hex's
// occupancy — `wave_occupancy` counts only the living, so that half is
// the roster flag — and it RAISES the terrain, because
// `ENEMY_MOVEMENT.md` § Bodies are terrain says a body is a pile and
// piles accumulate.  A death that only cleared the flag would give the
// player a kill zone that never closes; one that only raised the
// ground would leave a corpse blocking the hex it fell on.
//
// ⚠ **Called ONCE per tick, after every enemy has moved**, so the body
// lands where the enemy ended up and the terrain it makes belongs to
// tick N+1.  Same rule as `damage_resolve`, same reason: a hex raised
// mid-loop would change passability for whoever the roster visited
// later and not for the ones it visited first.
fn wave_deaths(state: WaveState) -> integer {
    wd_n = 0;
    for wd_e in state.enemies {
        if wd_e.alive && enemy_hp(wd_e) <= 0.0 {
            wd_e.alive = false;
            height_raise(state.heights, wd_e.q, wd_e.r, BODY_HEIGHT_METRES,
                         body_source(wd_e.kind) as u8? ?? 0);
            wd_n += 1;
        }
    }
    wd_n
}

// Advance the whole wave by one game-tick.
//
// ── The field is rebuilt ONCE per tick, before anybody moves ─────
//
// `docs/ENEMY_MOVEMENT.md` § The tick resolves once: within a tick
// every enemy acts against the same world.  That is not primarily a
// cost decision — it is what makes a tick ORDER-INDEPENDENT, and so
// what makes a scripted run reproducible, which is the premise plan
// 08 gates on.  A field rebuilt mid-loop would make the outcome
// depend on which enemy the roster happened to visit first, and no
// `.keys` scenario could assert a stable number over that.
//
// The invariant that holds it: the same wave, played with the roster
// iterated in REVERSE, produces an identical result.
//
// ⚠ **F5c is where that stopped being free.**  While movement only
// read the world it was trivially true; now a companion blocks a step,
// so the order enemies act in decides where they end up.  Four things
// are therefore fixed before the first enemy moves — the fields
// (§ One field per CLIMB LIMIT), the desire field (`wave_desire`), the
// occupancy (`wave_occupancy`) and the order (§ The move order) — and
// none of them is derived from roster order.
//
// ── The marker world is a parameter, and deliberately not optional ─
//
// Towers are markers (plan 12 B5a), so the tick has to see the marker
// layer to know what shoots.  It would have been one line to default
// it and keep 54 call sites compiling — and a caller that took the
// default would silently have no towers, so a test asserting "the
// enemy survived" would pass for exactly the wrong reason.  That is
// the same argument `enemy_tick` § The world is a parameter makes
// about the palette, and the compile errors were the point again.
//
// ── One field per CLIMB LIMIT, built for the roster present ─────
//
// See `wave_fields`.  It is the roster that decides which fields get
// built, not the set of classes the game knows about — and the key is
// the climb limit, because that is a class's whole contribution to
// where it can go (plan 11 F6).
//
// ⚠ **From scratch every tick, deliberately.**  F8 makes it
// incremental, and its gate is equality with this — so this path
// stays the reference implementation and is not optimised away.
pub fn wave_tick(state: WaveState, pal: vector<GroundType>, pw: PaintedWorld,
                 mw: MarkerWorld, core: Hex) {
    // ⚠ **The schedule goes FIRST, before anything reads the roster**
    // (plan 16 W1), so a wave that arrives this tick is a wave this
    // tick's fields, occupancy and move order already know about.
    // Spawning after the movers would put enemies into a world that had
    // already been surveyed without them — the same reason the deaths
    // and the breaks go last.
    //
    // ⚠ It is a no-op until something STARTS the schedule, so every
    // scenario that places its own enemies and every test that calls
    // this with `marker_empty()` behaves exactly as before.
    //
    // ⚠ **And the TRIGGER goes in front of it** (plan 16 W3), close
    // enough to read as one statement: has anybody poked a far spawn
    // marker, and is a wave due.  Same tick, because the list starting
    // and wave 1 going out are one event — `wave_schedule_begin`
    // leaves no lull in front of the first wave, since a fifteen-second
    // pause after the player provoked something would read as the poke
    // not having worked.
    //
    // ⚠ It reads the world the tick STARTED with, exactly as the
    // fields, the occupancy and the move order below do.  A player
    // arriving mid-tick is seen by the NEXT one — the same rule a body
    // and a breach follow, and what keeps "who is where" a single
    // answer for the whole tick.
    wave_provoke_step(state, mw, core);
    wave_schedule_step(state, mw, core);

    // Everything the tick reads is fixed before anybody moves: the
    // fields, where everyone stands, and the order they act in.
    wt_fields = wave_fields(state, pal, pw, core);
    wt_desire = wave_desire(state, wt_fields, pal, pw, core);
    wt_occ    = wave_occupancy(state);
    wt_block  = wave_blockers(state);

    // Every half of the exchange lands against the world the tick
    // STARTED with — towers shoot at where the enemies are now,
    // besieging enemies bite the wall in front of them, and the ones
    // that have arrived bleed the wallet.
    wave_fire(state, pal, pw, mw);
    wave_damage(state, pal, pw, wt_fields, wt_desire);
    wave_nibble(state, core);
    wave_block(state, wt_fields, wt_occ, wt_block);


    for wt_i in move_order(state, wt_fields) {
        wt_e = state.enemies[wt_i] ?? Enemy {};
        // ⚠ The field is passed STRAIGHT from the vector into a `const`
        // parameter.  Looking it up through an accessor that returned a
        // `FlowField` copied the whole cell hash, once per enemy — see
        // § Reading a class's field WITHOUT copying it.
        wt_climb = climb_limit(wt_e.kind);
        for wt_cf in wt_fields {
            if wt_cf.climb == wt_climb {
                enemy_tick(wt_e, pal, pw, state.heights, wt_cf.field, wt_desire,
                           wt_occ, wt_block, TICK_SECONDS);
            }
        }
    }

    // ⚠ **The consequences land LAST, after every enemy has moved**, so
    // it is tick N+1 that walks over the body and routes through the
    // hole.  A hex raised or a wall felled mid-loop would change the
    // world for the enemies the roster happened to visit later and not
    // for the ones it visited first — the same rule `height.loft`'s
    // piles follow, and the one that makes a scripted run repeatable
    // at all (`ENEMY_MOVEMENT.md` § The tick resolves once).
    //
    // Deaths before structures, and the order is fixed rather than
    // immaterial: both write to the same rubble layer, the heights ADD
    // either way, but a hex that receives both in one tick takes the
    // SOURCE of the later deposit.  Fixing the order is what makes
    // that repeatable.
    // ⚠ **The player takes its turn HERE, with the other consequences
    // and BEFORE them.**  It is driven rather than routed, so it reads
    // no field and no occupancy — a vehicle is not a companion an enemy
    // can be blocked by, and an enemy is not something the player bumps
    // into (both are `DESIGN.md` § 8's blocker-damage model, which plan
    // 13 does not build).
    //
    // Before the deaths and the breaks, so that a body dropped THIS
    // tick cannot be swept up in the same one: what the player clears
    // belongs to tick N+1, exactly as a body and a breach do.  Putting
    // it after would let a crew tidy a kill zone the instant it filled,
    // and would make the ordering of these three lines load-bearing.
    vehicle_tick(state.player, pal, pw, state.heights, TICK_SECONDS);

    // ⚠ **The crew takes its turn with the player** (plan 14 H1), for
    // the same reason and in the same place: they are the same chassis
    // doing the same kind of work, and what they change about the
    // world belongs to tick N+1.
    for wt_h in state.crew {
        helper_tick(wt_h, pal, pw, state.heights, TICK_SECONDS);
    }

    // ⚠ **Cargo goes where its carrier goes** (plan 15 C1).  A carried
    // object's position is kept TRUE rather than left stale until it is
    // put down: `DESIGN.md` § Carry visibility renders cargo above its
    // carrier as part of its geometry, which is a statement that the
    // two are at one place, and a measurement that reads a stale hex is
    // a lie nobody discovers until something depends on it.
    //
    // Immediately after the movers and before anything reads a
    // position, so no consequence in this tick can see a carrier and
    // its load on different hexes.
    cargo_follow(state.cargo, BLOCKER_PLAYER, state.player.q, state.player.r);
    wt_cg = 0;
    for wt_c in state.crew {
        cargo_follow(state.cargo, BLOCKER_CREW + wt_cg, wt_c.q, wt_c.r);
        wt_cg += 1;
    }

    // ⚠ **Salvage is the wallet's only income** (plan 13 V3), and it
    // is what keeps plan 12 B6's promise that the budget never refills
    // unattended: a run with nobody in it clears nothing and so earns
    // nothing.  Bound to a local rather than nested, per `flow.loft`
    // § A struct cannot ride home on two tail calls.
    wt_salv = vehicle_salvage(state.player, state.heights, TICK_SECONDS);
    if wt_salv.metres > 0.0 {
        wallet_earn(state.wallet, loot_rate(wt_salv.source) * wt_salv.metres);
    }

    // ⚠ **The crew's work is the player's work and pays into the same
    // wallet** (plan 14 H2).  `DESIGN.md` § 9 calls helpers *"NPC
    // vehicles that do the cooperative's actual work"* — one
    // cooperative, so one budget, and a helper that earned into a purse
    // of its own would be a second economy nothing spends from.
    //
    // ⚠ **After the whole crew has moved**, so a helper clears from
    // where it ended this tick and never from a hex a later mover would
    // have taken it off — the same reason the player's salvage is not
    // folded into `vehicle_tick`.
    //
    // ⚠ Each asks the layer as it stands when its turn comes, which is
    // what makes a crew of N clear N times as fast on ONE heap.  Order
    // decides only who gets the short last bite, and roster order fixes
    // that so a scripted run repeats.
    for wt_hs in state.crew {
        wt_hsalv = helper_salvage(wt_hs, state.heights, TICK_SECONDS);
        if wt_hsalv.metres > 0.0 {
            wallet_earn(state.wallet, loot_rate(wt_hsalv.source) * wt_hsalv.metres);
        }
    }

    // ⚠ **Upkeep takes its turn with the other work** (plan 17 T1),
    // beside the salvage and for the same reason: it is what a vehicle
    // does by BEING somewhere, and what it changes about the world
    // belongs to tick N+1.  So a rebuild that finishes at the end of
    // this tick fires for the first time in the next one — the same
    // rule a body and a breach follow.
    //
    // ⚠ **After the movers**, so a vehicle works on the tower it ENDED
    // this tick beside and never on one a later mover would have taken
    // it away from.
    //
    // ⚠ Called as a bare statement rather than bound to a local:
    // `wave_repair` is declared below and binding a FORWARD-declared
    // call to a local panics the parser
    // ([loft#918](https://github.com/loft-lang/loft/issues/918)).
    wave_repair(state, mw, TICK_SECONDS);

    wave_deaths(state);
    damage_resolve(pal, pw, state.damage, state.heights);

    // ⚠ **A destroyed vehicle is never a game-loss** (`DESIGN.md` § 8):
    // the player reappears inside the core, whole.  Resolved here with
    // the other consequences so a fatal blow lands at the end of the
    // tick it was struck in, exactly as a death and a breach do.
    if vehicle_present(state.player) && vehicle_hp(state.player) <= 0.0 {
        // ⚠ **Dying is not a retrieval** (plan 15 C1).  The player
        // reappears at the core; cargo that rode home with them would
        // mean the retrieval you FAILED to make succeeds by being
        // destroyed, which is a strictly better way to play than
        // driving back.  So it stays on the battlefield at the hex the
        // vehicle was lost on — where the next attempt has to go.
        //
        // Before the respawn, because the respawn moves the vehicle and
        // this needs the hex it DIED on.
        cargo_spill(state.cargo, BLOCKER_PLAYER,
                    Hex { q: state.player.q, r: state.player.r });
        vehicle_respawn(state.player, core);
    }

    // ⚠ **And a helper does NOT come back** (plan 14 H3).  `DESIGN.md`
    // § 9: *"No automatic respawn — retrieval is the only way back."*
    // The two lines sit together on purpose: this is the one rule where
    // the crew is not the player's chassis doing the player's job, and
    // a reader who changes one has to see the other.
    //
    // ⚠ The wreck keeps its ROSTER SLOT and its hex.  `state.crew` is
    // never compacted, so helper 2 is helper 2 for the whole run — which
    // is what lets a script name it after it has died, and what H4's
    // retrieval will need to put a recovered crew member back.
    // ⚠ **Losing a crew member is TWO effects and this is the one site
    // that does both** (plan 15 C1) — the rule `damage.loft::
    // break_structure` states for a wall: the helper stops moving AND a
    // carryable wreck appears where it stood.  Split across two sites
    // they drift, and the drift is a crew member who is down with
    // nothing to fetch, or a wreck on the ground whose owner is
    // walking around.
    //
    // ⚠ **Spill BEFORE the wreck, and the order is load-bearing**: a
    // helper carrying a downed colleague leaves TWO objects on this
    // hex, which is the case `carry.loft` refuses a hash for — the
    // second one would overwrite the first and delete a crew member
    // with no fault raised anywhere.
    wt_wi = 0;
    for wt_w in state.crew {
        if wt_w.alive && helper_hp(wt_w) <= 0.0 {
            helper_wreck(wt_w);
            cargo_spill(state.cargo, BLOCKER_CREW + wt_wi,
                        Hex { q: wt_w.q, r: wt_w.r });
            cargo_spawn(state.cargo, CARGO_WRECK, wt_wi, wt_w.q, wt_w.r);
        }
        wt_wi += 1;
    }

    // ⚠ **And a RETRIEVED one comes back on its own clock** (plan 15
    // C2).  `DESIGN.md` § 9: *"Deliver to the core → recovery state for
    // ~60 s → helper rejoins the roster"* — so the line above and this
    // one are the whole of § 9's *"No automatic respawn — retrieval is
    // the only way back"*: nothing starts this clock except a delivery.
    //
    // ⚠ 60.0 s is EXACTLY 90 ticks, and the epsilon inside
    // `helper_recover_tick` is what keeps it 90 rather than 91.
    for wt_rc in state.crew {
        helper_recover_tick(wt_rc, TICK_SECONDS, core);
    }

    // ⚠ **And the wave spends its pre-walk window here too** (plan 16
    // W2), beside the recovery clock and for the same reason: both are
    // per-mover timers rather than changes to the world, and both are
    // read all through the tick they are spent at the end of.
    //
    // ⚠ **The POSITION is what fixes the count, and it is worth the
    // paragraph.**  A banked timer of `T` seconds spans `ceil(T / dt)`
    // ticks if the reader asks before the spend and one FEWER if it
    // asks after — the two forms differ by exactly one tick, always.
    // They coincide only where `T` divides `dt` exactly, which is
    // precisely the case plan 15 C0's epsilon is about.  So the two
    // questions are complementary and every banked timer has exactly
    // one of them live:
    //
    //   | timer                     | T / dt | live question |
    //   |---|---|---|
    //   | helper recovery 60.0 s    | 90     | the EPSILON (C0) |
    //   | pre-walk window 5.0 s     | 7.5    | this ORDERING    |
    //   | boost 2.0 s / cooldown 5.0| 3 / 7.5| epsilon / neither|
    //
    // Spending at the END of the tick — where `helper_recover_tick`
    // spends — makes the enemy stand for `ceil(7.5) = 8` ticks and step
    // on the 9th, which is the reading that keeps the design's promise:
    // the window is a guarantee to the PLAYER, so a fractional tick
    // rounds up rather than down.  Putting this line before the movers
    // would silently make it 7, with no test able to say which was
    // meant.
    wave_stand(state, TICK_SECONDS);
}

// Spend one tick of every enemy's pre-walk window (plan 16 W2).
//
// ⚠ The counterpart of `enemy_standing`, and the ONLY writer: one
// spend per enemy per tick, whatever asked and however often.
fn wave_stand(state: WaveState, tick_seconds: float) {
    for ws_e in state.enemies {
        if ws_e.stand > 0.0 { ws_e.stand = ws_e.stand - tick_seconds; }
    }
}

// ─── The schedule's other half (plan 16 W1) ─────────────────────

// Spawn markers this close to the core are silenced for the mission —
// `numbers.json` § core.close_spawn_disable_radius.
//
// ⚠ A second copy of `script.loft::SCRIPT_SPAWN_DISABLE_RADIUS`, and
// the duplication is the same one every engine file carries: nothing
// loads `numbers.json`.  ⚠ But now TWO code paths spawn waves — the
// script's `wave` verb and this schedule — so they have to agree, and
// `tests/16_w1_the_schedule.loft` § The two spawners agree is what says
// they do.
pub const SPAWN_DISABLE_RADIUS: integer = 10;

// Ask the schedule whether a wave is due, and put it on the ground if
// one is.  Answers how many enemies were sent.
//
// ⚠ **The split with `waves.loft::wave_schedule_due` is deliberate**:
// that half decides, knowing only a clock and whether the field is
// clear, and can be tested without a map; this half needs the marker
// world and the core, and is where the design's *"per-enemy spawn-
// marker selection"* lives.
//
// ⚠ **`alive_count == 0` is the ONE definition of cleared** and there
// is no second clock.  `DESIGN.md` says the lull runs *"between the
// last enemy dying and the next wave's spawn"*, which is the same
// statement given a clear is made of deaths — see `plans/16` § Open
// questions 2.
// ⚠ **One `spawn_wave` per PART, in authored order** (plan 23 K1).  A
// pure list is one part per wave, so this is bit-identical to the
// single call it replaced; a composed one puts its groups on the ground
// in the order they were written, which K0 measured to be worth 20x on
// a wall's breach clock.  Each call carries on from `pick_cursor`, so
// the whole wave still spreads round the markers as one.
pub fn wave_schedule_step(state: WaveState, mw: MarkerWorld, core: Hex) -> integer {
    wss_due = wave_schedule_due(state.schedule, alive_count(state) == 0,
                                TICK_SECONDS);
    if wss_due <= 0 { return 0; }

    wss_parts = wave_schedule_parts(state.schedule,
                                    wave_schedule_sent(state.schedule) - 1);
    for wss_p in wss_parts {
        spawn_wave(state, wss_p.count, wss_p.kind as u8? ?? 0, mw,
                   core.q, core.r, SPAWN_DISABLE_RADIUS);
    }
    wss_due
}

// ─── Upkeep: bringing a black tower back (plan 17 T1) ───────────
//
// `DESIGN.md` § 7 gives the player a way to refill a spent tower, and
// plan 16 W4 measured what its absence costs: a base spends its
// magazines and its wall and has no way back up, so the lull between
// waves is a pause rather than a repair window.  Plan 17 T0 then
// measured the other side — without repair, building MORE towers buys
// nothing at all (3, 5 and 7 towers give 321, 319 and 317 ticks and
// four of seven waves each), and with it seven towers clear the whole
// authored list.
//
// ⚠ **The crew repairs as well as the player** (project owner,
// 2026-08-15).  `DESIGN.md`'s prose says *"the player walks up to a
// black-in-place tower"* while `numbers.json`'s only rate is
// `repair_time_HELPER_rebuild` — a conflict in the sources, resolved by
// honouring both: repair stays PRESENCE-LOCKED, which is § What kind of
// game this is' test, and the crew gets a job that exists BETWEEN
// waves, which is exactly what W4 found missing when a retrieved crew
// member came back to nothing.

// Which black tower `at` should work on — the nearest, ties by `q` then
// `r`.  Answers a hex with no marker on it when there is none in reach.
//
// ⚠ **Ordered by coordinate and never by hash order.**  `mw.markers` is
// stable within one run and not across them (`active_spawn_markers`
// says so), and a scripted run has to repeat — the same argument
// `tower_pick` makes about roster order.
fn repair_target(state: const WaveState, mw: const MarkerWorld,
                 at: const Hex) -> Hex {
    rt_best = Hex { q: 0, r: 0 };
    rt_have = false;
    rt_dist = 0;
    for rt_m in mw.markers {
        if rt_m.kind == MARKER_KIND_TOWER as u8 {
            rt_h = Hex { q: rt_m.q, r: rt_m.r };
            if tower_in_repair_reach(rt_h, at)
               && tower_repairable(state.towers, rt_m.q, rt_m.r) {
                rt_d = lat_distance(rt_h, at);
                if !rt_have || rt_d < rt_dist
                   || (rt_d == rt_dist
                       && (rt_m.q < rt_best.q
                           || (rt_m.q == rt_best.q && rt_m.r < rt_best.r))) {
                    rt_best = rt_h;
                    rt_dist = rt_d;
                    rt_have = true;
                }
            }
        }
    }
    // ⚠ Nothing in reach answers the vehicle's OWN hex, and that is safe
    // rather than lucky: `tower_repair_tick` refuses any hex that is not
    // a repairable tower, and a hex with no tower marker on it has no
    // `TowerState` cell — only `tower_spend_shot` creates one — so it
    // reads zero shots fired and is not black.
    if !rt_have { return Hex { q: at.q, r: at.r }; }
    rt_best
}

// Every vehicle's turn at a black tower.  Answers how many rebuilds
// FINISHED this tick.
//
// ⚠ **One tower per vehicle per tick, and any number of vehicles per
// tower** — the same shape `helper_salvage` has on one heap, and it is
// what makes a crew of N rebuild N times as fast.  Each asks the state
// as its turn comes, so order decides only who lands the last fraction.
//
// ⚠ **No key is pressed.**  Repair is a POSITION, exactly as clearing
// rubble is (`vehicle.loft` § salvage): a vehicle parked beside a black
// tower is working on it.  `DESIGN.md` § 11 keeps the player's
// instructions to a destination, and every helper job so far is
// positional.
// ⚠ **A carrier's hands are FULL** (plan 17 T3).  `numbers.json`
// § helper.carry_slot_count is 1 for the player and a helper alike, so
// a vehicle holding a downed colleague or a tower-top is not also doing
// twenty seconds of manual work on a mast.
//
// ⚠ **It also keeps the transplant a real choice**: without it a player
// ferrying a spare top to a black tower rebuilds that tower on the way
// in, so the fast path arrives at something already coming back and the
// two mechanics cannot be told apart.
//
// ⚠ `DESIGN.md` does not state this rule; it is derived from the one
// slot, and `tests/17_t3_what_upkeep_is_worth.loft` § A carrier cannot
// repair is what stops it being an unfalsifiable line of code.
fn carrier_free(state: const WaveState, owner: integer) -> boolean {
    !cargo_carrying(state.cargo, owner)
}

fn wave_repair(state: WaveState, mw: const MarkerWorld,
               tick_seconds: float) -> integer {
    wr_done = 0;

    if vehicle_present(state.player) && carrier_free(state, BLOCKER_PLAYER) {
        wr_at = Hex { q: state.player.q, r: state.player.r };
        wr_t  = repair_target(state, mw, wr_at);
        if tower_repair_tick(state.towers, wr_t.q, wr_t.r, tick_seconds) {
            wr_done += 1;
        }
    }

    // ⚠ `alive` is the whole filter — a wreck is not working on
    // anything, and neither is a crew member in recovery at the core.
    // The same test `wave_blockers` and `wave_provoked` apply.
    wr_ci = 0;
    for wr_h in state.crew {
        if wr_h.alive && carrier_free(state, BLOCKER_CREW + wr_ci) {
            wr_hat = Hex { q: wr_h.q, r: wr_h.r };
            wr_ht  = repair_target(state, mw, wr_hat);
            if tower_repair_tick(state.towers, wr_ht.q, wr_ht.r, tick_seconds) {
                wr_done += 1;
            }
        }
        wr_ci += 1;
    }

    wr_done
}

// ─── What starts the list at all (plan 16 W3) ───────────────────
//
// `DESIGN.md` § Wave-1 triggers — walls or provocation gives wave 1
// two triggers, and this is the second: *"the player has driven onto a
// spawn marker that sits ≥ `wave_1_provocation_distance` hex from the
// core — touching it = poking the enemy"*.  The other one counts walls
// BUILT and dryopea has no construction, so it arrives with it
// (`plans/16` § Why the order is this order).
//
// ⚠ **Provocation is a POSITION, and that is the whole design.**  It
// is the shape `DESIGN.md` § 11 wants of everything the player does:
// no key, no menu, no toggle — you go there or you do not, and going
// there means being twelve hexes from home at the moment the list
// starts.  A trigger the player pressed would hand out the same
// information for nothing.
//
// ⚠ **Two thresholds, and the gap between them is deliberate.**  A
// marker under `SPAWN_DISABLE_RADIUS` (10) is silenced for the whole
// mission and never emits anything; a marker at 10 or 11 emits enemies
// but cannot be poked.  So the middle band is a live spawn source that
// is safe to stand on, which is what makes the distance test a rule
// rather than a restatement of "is this marker active" — and it is
// what `tests/16_w3_the_provocation.loft` § A near marker uses to tell
// the two numbers apart.

// A spawn marker at least this far from the core can be provoked —
// `numbers.json` § wave_system.wave_1_provocation_distance, restated
// here for the reason every engine constant is: nothing loads that
// file yet.
pub const WAVE_1_PROVOCATION_HEXES: integer = 12;

// Is (q, r) a spawn marker far enough out to be worth poking?
fn provocation_at(mw: const MarkerWorld, core: const Hex,
                  q: integer, r: integer) -> boolean {
    if marker_kind(mw, q, r) != MARKER_KIND_SPAWN { return false; }
    lat_distance(core, Hex { q: q, r: r }) >= WAVE_1_PROVOCATION_HEXES
}

// Has a vehicle of the cooperative driven onto a far spawn marker?
//
// ⚠ **The CREW provokes too, and it is an extension of the design's
// letter.**  § Wave-1 triggers says *"the player has driven onto"*, and
// the crew is the player's chassis doing the player's job everywhere
// else in this engine — `wave_blockers` puts both in one map, and
// `salvage_at` is one implementation for both.  A helper sent out to
// clear a distant kill zone is the player deciding to be out there,
// and exempting it would mean the safe way to scout a far marker is to
// send somebody else — a free look at exactly the information the
// window in W2 charges eight ticks for.
//
// ⚠ **A wreck does not poke anything.**  `alive` is the wreck (plan 14
// H3) and is false in recovery too, which is the same filter
// `wave_blockers` applies: a crew member lying on a marker is debris,
// and one at the core on a 60 s clock is not standing anywhere.
//
// ⚠ **And nor does an ENEMY.**  This asks the roster of VEHICLES and
// never "is anybody on this hex" — a wave spawns ON its marker, so a
// hex-occupancy test would let a scripted wave 1 provoke wave 1.
pub fn wave_provoked(state: const WaveState, mw: const MarkerWorld,
                     core: const Hex) -> boolean {
    if vehicle_present(state.player)
        && provocation_at(mw, core, state.player.q, state.player.r) {
        return true;
    }
    for wp_h in state.crew {
        if wp_h.alive && provocation_at(mw, core, wp_h.q, wp_h.r) {
            return true;
        }
    }
    false
}

// Start the wave list if something has provoked it.  Answers whether
// THIS tick was the one that did.
//
// ⚠ **It fires once, ever.**  `running` is the guard, so a player who
// parks on the marker and stays there does not restart the schedule
// every tick — which would reset the lull to zero and turn a wave list
// into a hose.  That is what `waves.loft` keeps `running` separate from
// `sent > 0` for: a run that has a list and is not playing it is a real
// state, and this is the one thing that leaves it.
pub fn wave_provoke_step(state: WaveState, mw: const MarkerWorld,
                         core: const Hex) -> boolean {
    if wave_schedule_running(state.schedule) { return false; }
    if !wave_provoked(state, mw, core) { return false; }
    wave_schedule_begin(state.schedule);
    true
}

// ─── The one action, from the run's side (plan 15 C2) ───────────
//
// `DESIGN.md` § 11 gives the player ONE key for this — empty hands =
// pickup, carrying = deposit — so what a carrier can do is decided by
// what it is holding and where it is standing, never by which verb was
// typed.  These two functions are that key's two outcomes.
//
// ⚠ **They take an owner id and find the hex themselves**, which is the
// point: a caller that passed its own idea of where the carrier is
// could deposit a wreck at the core while the vehicle was somewhere
// else entirely.  There is deliberately no variant that accepts a hex.

// Where a carrier is standing.  `BLOCKER_PLAYER` or a crew id.
pub fn wave_carrier_hex(state: const WaveState, owner: integer) -> Hex {
    if owner == BLOCKER_PLAYER {
        return Hex { q: state.player.q, r: state.player.r };
    }
    wch_want = blocker_crew_index(owner);
    wch_i    = 0;
    wch_at   = Hex { q: 0, r: 0 };
    for wch_h in state.crew {
        if wch_i == wch_want { wch_at = Hex { q: wch_h.q, r: wch_h.r }; }
        wch_i += 1;
    }
    wch_at
}

// Can this carrier act at all?
//
// ⚠ **A wreck carries nothing**, which is `alive` doing the work again
// (plan 14 H3): a downed crew member stops driving, clearing, earning,
// blocking — and now carrying — because every verb asks the one flag.
pub fn wave_carrier_ready(state: const WaveState, owner: integer) -> boolean {
    if owner == BLOCKER_PLAYER { return vehicle_present(state.player); }

    wcr_want = blocker_crew_index(owner);
    if wcr_want < 0 || wcr_want >= len(state.crew) { return false; }

    wcr_i  = 0;
    wcr_ok = false;
    for wcr_h in state.crew {
        if wcr_i == wcr_want { wcr_ok = wcr_h.alive; }
        wcr_i += 1;
    }
    wcr_ok
}

// Pick up whatever is in reach.  Answers the object taken, or
// `CARGO_NONE`.
// Which tower marker in reach of `at` has a top worth taking.  Answers
// `at` itself when there is none, which `tower_detach_top` then refuses
// (a hex with no tower cell has a top by definition and no marker, so
// the caller's marker test is what stops it).
//
// ⚠ Ordered by coordinate, never by hash order — a scripted run has to
// repeat.  Same argument `repair_target` and `tower_pick` make.
fn top_source(state: const WaveState, mw: const MarkerWorld,
              at: const Hex) -> Hex {
    ts_best = Hex { q: at.q, r: at.r };
    ts_have = false;
    for ts_m in mw.markers {
        if ts_m.kind == MARKER_KIND_TOWER as u8 {
            ts_h = Hex { q: ts_m.q, r: ts_m.r };
            if tower_in_repair_reach(ts_h, at)
               && tower_has_top(state.towers, ts_m.q, ts_m.r) {
                if !ts_have || ts_m.q < ts_best.q
                   || (ts_m.q == ts_best.q && ts_m.r < ts_best.r) {
                    ts_best = ts_h;
                    ts_have = true;
                }
            }
        }
    }
    if !ts_have { return Hex { q: at.q, r: at.r }; }
    ts_best
}

// Which tower marker in reach of `at` a carried top could go onto.
fn mount_site(mw: const MarkerWorld, at: const Hex) -> Hex {
    ms_best = Hex { q: at.q, r: at.r };
    ms_have = false;
    for ms_m in mw.markers {
        if ms_m.kind == MARKER_KIND_TOWER as u8 {
            ms_h = Hex { q: ms_m.q, r: ms_m.r };
            if tower_in_repair_reach(ms_h, at) {
                if !ms_have || ms_m.q < ms_best.q
                   || (ms_m.q == ms_best.q && ms_m.r < ms_best.r) {
                    ms_best = ms_h;
                    ms_have = true;
                }
            }
        }
    }
    if !ms_have { return Hex { q: at.q, r: at.r }; }
    ms_best
}

// Is there a tower marker at (q, r)?
fn is_tower_marker(mw: const MarkerWorld, q: integer, r: integer) -> boolean {
    marker_kind(mw, q, r) == MARKER_KIND_TOWER
}

pub fn wave_take(state: WaveState, owner: integer, mw: const MarkerWorld) -> integer {
    if !wave_carrier_ready(state, owner) { return CARGO_NONE; }
    if cargo_carrying(state.cargo, owner) { return CARGO_NONE; }

    wtk_at = wave_carrier_hex(state, owner);

    // ⚠ **A loose object on the ground wins over detaching a top**, and
    // the tie-break is deliberate: picking something up is recoverable
    // and detaching is not — it costs a tower its firing until somebody
    // puts a top back.  So an ambiguous press does the harmless thing,
    // and a player who wants the top moves off the wreck first.
    // ⚠ It also makes the loop terminate sensibly: a top just set down
    // beside its tower is picked back UP rather than a second one being
    // torn off.
    wtk_i = cargo_take(state.cargo, owner, wtk_at, CARGO_REACH_HEXES);
    if wtk_i != CARGO_NONE { return wtk_i; }

    // ⚠ **Detaching is TWO effects at ONE site** — the tower loses its
    // top and a carryable top appears in the taker's hands — which is
    // the rule `break_structure` and `helper_wreck` both keep.  Split
    // across two sites they drift, and the drift is a tower that stopped
    // firing with nothing to show for it.
    wtk_src = top_source(state, mw, wtk_at);
    if !is_tower_marker(mw, wtk_src.q, wtk_src.r) { return CARGO_NONE; }

    wtk_shots = tower_detach_top(state.towers, wtk_src.q, wtk_src.r);
    if wtk_shots < 0 { return CARGO_NONE; }

    wtk_new = cargo_spawn(state.cargo, CARGO_TOP, wtk_shots,
                          wtk_at.q, wtk_at.r);
    cargo_take(state.cargo, owner, wtk_at, CARGO_REACH_HEXES);
    wtk_new
}

// Put down what this carrier is holding — DELIVERING it if where they
// stand is a destination its kind accepts.  Answers the object, or
// `CARGO_NONE` when its hands were empty.
//
// ⚠ **One verb, and the destination decides**, which is § 11's
// context-resolved key: a player who drops a downed colleague at the
// core has retrieved them, and the same press one hex further out has
// merely put them down.  Two verbs would let a script deposit at a
// place the game would not.
pub fn wave_drop(state: WaveState, owner: integer, core: Hex,
                 mw: const MarkerWorld) -> integer {
    if !wave_carrier_ready(state, owner) { return CARGO_NONE; }

    wdr_at = wave_carrier_hex(state, owner);

    // ⚠ **A top's OTHER destination, and it is this file's half**
    // (plan 17 T2).  `carry.loft::cargo_destination_ok` answers what a
    // kind can state from `(kind, at, core)` alone; mounting needs the
    // marker world and the tower state, which a carry model may not
    // know about — see that function's § A top has TWO destinations.
    //
    // ⚠ **Mounting comes FIRST**, so a tower standing next to the core
    // is a mount rather than an evacuation: the destructive reading of
    // an ambiguous press is the one you can undo by picking the top
    // back up, where an evacuation consumes it for the rest of the run.
    wdr_held = cargo_held_by(state.cargo, owner);
    if wdr_held != CARGO_NONE {
        wdr_o = cargo_get(state.cargo, wdr_held);
        if wdr_o.kind == CARGO_TOP {
            wdr_site = mount_site(mw, wdr_at);
            if is_tower_marker(mw, wdr_site.q, wdr_site.r) {
                // ⚠ **The HOT-SWAP, composed rather than primitive**:
                // `DESIGN.md` § Tower overload — *"strained top drops to
                // the ground; spare goes onto the tower"*.  The sitting
                // top comes off into a ground object FIRST, so nothing
                // is ever overwritten and the count is conserved across
                // the whole exchange.
                if tower_has_top(state.towers, wdr_site.q, wdr_site.r) {
                    wdr_old = tower_detach_top(state.towers,
                                               wdr_site.q, wdr_site.r);
                    cargo_spawn(state.cargo, CARGO_TOP, wdr_old,
                                wdr_at.q, wdr_at.r);
                }
                if tower_mount_top(state.towers, wdr_site.q, wdr_site.r,
                                   wdr_o.subj) {
                    cargo_consume(state.cargo, wdr_held);
                    return wdr_held;
                }
            }
        }
    }

    wdr_i = cargo_deliver(state.cargo, owner, wdr_at, core);
    if wdr_i != CARGO_NONE {
        wave_arrived(state, wdr_i, core);
        return wdr_i;
    }
    cargo_put(state.cargo, owner, wdr_at)
}

// What a delivered object DOES at its destination.
//
// ⚠ **The per-kind half that `carry.loft` deliberately does not have**
// — it needs the roster, and a carry model that knew about helpers
// could not serve tower-tops.  A later kind adds a branch here and a
// row in `cargo_destination_ok`, and nothing else anywhere.
//
// ⚠ It reads the object AFTER it was consumed, which works because a
// spent record keeps its slot (`CARGO_GONE` is a state, not a removal).
fn wave_arrived(state: WaveState, i: integer, core: const Hex) {
    wa_o = cargo_get(state.cargo, i);
    if wa_o.kind != CARGO_WRECK { return; }

    wa_j = 0;
    for wa_h in state.crew {
        if wa_j == wa_o.subj { helper_begin_recovery(wa_h, core); }
        wa_j += 1;
    }
}

// Count of alive enemies in the wave — wave-clear check.
pub fn alive_count(state: WaveState) -> integer {
    ac_n = 0;
    for ac_e in state.enemies {
        if ac_e.alive { ac_n = ac_n + 1; }
    }
    ac_n
}

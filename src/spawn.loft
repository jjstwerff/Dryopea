//
// Spawn director + wave engine — runtime spawn execution.
//
// At wave start, `spawn_wave` emits N enemies, each at an
// active spawn marker (= a placed marker outside the
// close-spawn-disable radius from the core).  Each enemy's
// initial heading = the marker's `direction` field.
//
// Marker selection is **round-robin** through the active
// markers — a cursor in `WaveState` advances per spawn.
// Deterministic + testable; the eventual game's "feels random"
// texture comes from the marker positions themselves (the
// designer authors multiple-direction layouts), not from RNG.
// Loft doesn't yet expose a user-callable RNG; round-robin
// is the simplest substitute that produces multi-direction
// pressure without the RNG dependency.
//
// Movement is `enemy_tick`, and it has three rules on top of each
// other: the scrambler bubble picks the mode (F5b — heading outside,
// flow field inside), the height step says what ground the class can
// hold (F1b), and companions block a step (F5c — enemies spread, they
// do not stack).  No death/HP yet: that is the combat work after.
//
// Plan 03 phase M5; the walk's passability is plan 11 F1b, the routing
// F5/F5b, the occupancy F5c.

use world;
use markers;
use palette;
use painted;
use passable;
use flow;
use occupancy;

// The radius of the core's comms-jamming bubble, in hexes — the
// boundary where an enemy stops following its spawn heading and starts
// following the flow field (`docs/ENEMY_MOVEMENT.md` § Two modes).
//
// `examples/numbers.json` § core.scrambler_bubble_radius is where this
// number lives; it is restated here because nothing loads numbers.json
// yet, exactly as `script.loft` restates the spawn-disable radius.
// When a loader lands, this reads from it instead of holding a second
// copy.
pub const SCRAMBLER_BUBBLE_RADIUS: integer = 25;

// The kind discriminants an `Enemy` carries — `ENEMY_KIND_REGULAR`
// and friends — live in `passable.loft`, because a class IS its
// climb limit as far as movement is concerned and the mover has to
// be able to ask (plan 11 F1b).  They are in scope here through the
// `use` above; the validation tier still emits only regulars.

// One enemy on the map.  Mixes integer (q, r) with u8
// (kind, heading) fields.  Not serialised today — vector<Enemy>
// stays in memory only — so the QUESTIONS_FOR_LOFT.md
// `:j`/vector-u8 corruption bug doesn't apply.  If enemies ever
// need on-disk persistence, mirror the painted-layer pattern:
// widen u8 → integer in a separate on-disk struct.
pub struct Enemy {
    q:       integer,
    r:       integer,
    kind:    u8,
    heading: u8,
    alive:   boolean,
}

// Wave-engine state.  `enemies` is the running roster across
// the current wave (and the future across-waves view); per-wave
// metadata lives here too.  `pick_cursor` is the round-robin
// index into the active-marker set, advancing every spawn.
pub struct WaveState {
    enemies:     vector<Enemy>,
    pick_cursor: integer,
}

// Factory: a fresh wave state with no enemies and a cursor at 0.
pub fn wave_state_empty() -> WaveState {
    WaveState { enemies: [], pick_cursor: 0 }
}

// ⚠ `hex_offset` — the 6-direction table an enemy heading steps
// along — now lives in `world.loft` § The neighbour relation, and is
// in scope here through `use world;`.  Plan 11 F2 moved it: the
// flow field is built from the same relation, and a wave engine is
// the wrong owner for the geometry of the whole world.  One table,
// one place for plan 09's lattice conversion to change.

// ─── Active markers (close-spawn-disable filter) ────────────────

// Return the subset of placed spawn markers that are AT LEAST
// `disable_radius` hexes from the core.  Markers within the
// radius are visible to the player (a safety signal — "this
// won't fire on you") but don't emit enemies.  Per DESIGN.md
// § Updates: free-pick landing.
//
// Returns a fresh vector copy so the caller can iterate without
// holding the hash open.  Order is iteration order of the
// underlying hash — stable within a single program run but not
// across runs (use index 0 etc as test fixtures only when the
// test placed exactly one marker, or use the round-robin
// cursor's behaviour to test order-independent properties).
pub fn active_spawn_markers(
    mw:             MarkerWorld,
    core_q:         integer,
    core_r:         integer,
    disable_radius: integer,
) -> vector<MarkerEntry> {
    asm_out: vector<MarkerEntry> = [];
    asm_core = Hex { q: core_q, r: core_r };
    for asm_e in mw.markers {
        if asm_e.kind == MARKER_KIND_SPAWN as u8 {
            asm_d = hex_distance(asm_core, Hex { q: asm_e.q, r: asm_e.r });
            if asm_d >= disable_radius {
                asm_out += [MarkerEntry {
                    q:         asm_e.q,
                    r:         asm_e.r,
                    kind:      asm_e.kind,
                    direction: asm_e.direction,
                }];
            }
        }
    }
    asm_out
}

// ─── Wave spawn + tick ──────────────────────────────────────────

// Spawn one wave's worth of enemies: emit `count` enemies, each
// at a different (round-robin) active marker, each with the
// marker's direction as its initial heading.  Appends to
// `state.enemies`; advances `state.pick_cursor` by `count`.
//
// No-op if there are zero active markers (an all-disabled map
// or an authoring mistake — the caller logs / surfaces).
pub fn spawn_wave(
    state:          WaveState,
    count:          integer,
    mw:             MarkerWorld,
    core_q:         integer,
    core_r:         integer,
    disable_radius: integer,
) {
    sw_active = active_spawn_markers(mw, core_q, core_r, disable_radius);
    sw_n = len(sw_active);
    if sw_n == 0 { return; }
    // `while` loop drops an unused loop counter; the `?? 0` and
    // `?? <fallback>` defensive operators silence the static
    // analyser's modulus / out-of-bounds warnings — both
    // invariants are guarded by the `sw_n == 0` early-return
    // above (sw_n > 0; pick_cursor % sw_n ∈ 0..sw_n-1).
    sw_remaining = count;
    while sw_remaining > 0 {
        sw_idx = (state.pick_cursor % sw_n) ?? 0;
        sw_m   = sw_active[sw_idx] ?? sw_active[0];
        state.enemies += [Enemy {
            q:       sw_m.q,
            r:       sw_m.r,
            kind:    ENEMY_KIND_REGULAR as u8,
            heading: sw_m.direction,
            alive:   true,
        }];
        state.pick_cursor = state.pick_cursor + 1;
        sw_remaining = sw_remaining - 1;
    }
}

// Advance one alive enemy by one hex along its heading — unless the
// hex it would enter is one its class cannot hold, in which case it
// STAYS PUT.  Plan 11 F1b.
//
// Dead enemies are a no-op (the runtime keeps them in the roster for
// post-mortem accounting; final-wave-clear checks alive_count to
// gate "wave done").
//
// ── The world is a parameter, and deliberately not optional ─────
//
// It would have been one line to give `pal` / `pw` defaults and keep
// every existing caller compiling.  That would make the passability
// check skippable, and a caller that skipped it would walk enemies
// through walls exactly as this phase's own negative control did —
// silently, because an empty palette answers "no ground anywhere".
// So the signature changed and every call site was made to say which
// world it ticks against.  The compile errors were the point.
//
// ── What a blocked enemy does ───────────────────────────────────
//
// Nothing, today.  It still wants the core
// (`docs/ENEMY_MOVEMENT.md` § Two modes: "An enemy never halts
// permanently.  Blocked, it attacks"), but there is no combat yet,
// so approach mode's whole answer to a wall is to stop in front of
// it.  Stopping is what makes the wall a wall; the attack is F5+ and
// the routing round it is F5.
pub fn enemy_tick(e: Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                  f: FlowField, occ: Occupancy) {
    if !e.alive { return; }

    // ── Which mode? The bubble decides (plan 11 F5b) ─────────────
    //
    // `docs/ENEMY_MOVEMENT.md` § Two modes: outside the scrambler
    // bubble an enemy follows its spawn marker's heading; inside it,
    // the field toward the core.  The boundary IS the handoff.
    //
    // The field carries the core it was built for, so the test needs
    // no extra parameter — which is why `FlowField` keeps it.
    if !enemy_in_bubble(e, f.core) {
        enemy_walk_heading(e, pal, pw, occ);
        return;
    }

    // ── Engage: follow the field (plan 11 F5) ───────────────────
    //
    // The field is per class and already refuses every hex this class
    // cannot hold, so a step down it needs no passability check of
    // its own — `flow_build` did it.  What it does NOT know is who is
    // standing where, which is this phase (F5c): take the first FREE
    // step in preference order, and stand still when every one of them
    // is held.
    //
    // ⚠ **Free, but still strictly CLOSER.**  A blocked enemy does not
    // sidestep to an equally-distant hex to get round the jam: every
    // entry `flow_steps` offers is at `d - 1`, so an enemy either
    // closes by exactly one step or does not move — which is what
    // keeps F5's invariant (`distance decreases by exactly 1 per tick`)
    // true of every enemy that moves at all, and keeps occupancy a
    // movement constraint rather than a second steering rule.  The
    // sideways spread the spec describes at a WALL belongs to F7,
    // where the desire field supplies the gradient that says which way
    // "beside" is; inventing one here would be a second steering rule
    // with nothing to derive it from.
    et_d = flow_distance(f, e.q, e.r);
    if et_d == 0 { return; }                    // arrived; attacking the core is combat's job
    if et_d < FLOW_UNREACHABLE {
        for et_t in flow_steps(f, e.q, e.r) {
            if occupancy_taken(occ, et_t.q, et_t.r) { continue; }
            enemy_move_to(e, et_t.q, et_t.r, occ);
            return;
        }
        // F3's sweep proves the arrow never stalls on a reachable
        // cell, so the only way to get here is a companion on every
        // closer neighbour.  Standing still is the right answer — a
        // jam is not a licence to wander off the route.
        return;
    }

    // ── Inside the bubble, but with no route to the core ─────────
    //
    // It presses on along its heading and stops at what it cannot
    // cross (plan 11 F1b).  ⚠ **F7 replaces this**: a blocked enemy
    // should follow a second field with the walls passable and attack
    // the first impassable hex its OWN route meets, which is what
    // spreads a siege along the perimeter instead of collapsing it to
    // one chokepoint.  Walking a heading into the wall is the
    // stand-in until then, and it stops in the right place.
    enemy_walk_heading(e, pal, pw, occ);
}

// Move an enemy, keeping the occupancy it moves through in step with
// it.  ⚠ The two updates are ONE operation: an enemy that entered
// without leaving would block the hex behind it for the rest of the
// tick, and the enemies behind it would never advance.
fn enemy_move_to(e: Enemy, q: integer, r: integer, occ: Occupancy) {
    occupancy_leave(occ, e.q, e.r);
    occupancy_enter(occ, q, r);
    e.q = q;
    e.r = r;
}

// Is this enemy inside the core's scrambler bubble?
//
// ⚠ Measured as a STRAIGHT-LINE hex distance, not as a route length.
// The bubble is a comms-jamming sphere carved by the core
// (`docs/DESIGN.md` § core), so an enemy three hexes from the core
// with a forty-step route around a wall is INSIDE it — jamming does
// not care how far you would have to walk.  Using the field distance
// instead would make the bubble bulge and shrink as the player builds,
// which is not what the fiction or the numbers describe.
//
// Inclusive at the boundary, matching `active_spawn_markers`'
// `>= disable_radius`: the hex the radius names is in.
pub fn enemy_in_bubble(e: const Enemy, core: Hex) -> boolean {
    hex_distance(core, Hex { q: e.q, r: e.r }) <= SCRAMBLER_BUBBLE_RADIUS
}

// One step along the enemy's heading, if the hex it would enter is one
// its class can hold and nobody is standing on it — approach mode's
// whole movement rule (plan 11 F1b, plus F5c's occupancy).
//
// A heading has no alternatives: there is one hex ahead, so a blocked
// enemy simply stops one hex short.  That is enough for the thing F5c
// is for — a column pressing a wall ends on distinct hexes instead of
// piling onto the single hex in front of it — and it is all approach
// mode can honestly do, having no field to say which way "beside" is.
fn enemy_walk_heading(e: Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                      occ: Occupancy) {
    et_off = hex_offset(e.heading);
    et_q = e.q + et_off.0;
    et_r = e.r + et_off.1;
    // ⚠ ONE rule, shared with the `enemies passable` assertion that
    // measures it (`passable.loft`).  If the mover and the
    // measurement each had their own idea of passability, a green
    // gate would only prove the two agreed — not that either was
    // right.
    if !can_occupy(pal, pw, e.kind, et_q, et_r) { return; }
    if occupancy_taken(occ, et_q, et_r) { return; }
    enemy_move_to(e, et_q, et_r, occ);
}

// ─── The fields, one per class in the roster ────────────────────

// One class's field for this tick.
pub struct ClassField {
    kind:  integer,
    field: FlowField,
}

// A field for every class actually present among the alive enemies,
// each built once.
//
// Not a field per class the game knows about: a field built for nobody
// is a number in a profile that nobody can explain.  And not ONE
// shared field either — a wall stops a robot and an insect climbs it,
// so a shared field would move insects along a route computed for
// something that cannot climb (plan 11 F0: passability is boolean, so
// nothing weighs an edge — it is separate fields, not one with costs).
fn wave_fields(state: const WaveState, pal: vector<GroundType>,
               pw: PaintedWorld, core: Hex) -> vector<ClassField> {
    wf_out: vector<ClassField> = [];
    for wf_e in state.enemies {
        if wf_e.alive && !fields_have(wf_out, wf_e.kind as integer) {
            wf_out += [ClassField {
                kind:  wf_e.kind as integer,
                field: flow_build(pal, pw, wf_e.kind, core),
            }];
        }
    }
    wf_out
}

fn fields_have(fields: const vector<ClassField>, kind: integer) -> boolean {
    fh_seen = false;
    for fh_f in fields {
        if fh_f.kind == kind { fh_seen = true; }
    }
    fh_seen
}

// The field this class routes on.  An empty field on a miss, which
// cannot happen for an alive enemy (`wave_fields` built one for every
// class present) and which routes nobody anywhere if it ever did.
fn field_of(fields: vector<ClassField>, kind: integer) -> FlowField {
    fo_out = FlowField { cells: [], core: Hex { q: 0, r: 0 }, truncated: false };
    for fo_f in fields {
        if fo_f.kind == kind { fo_out = fo_f.field; }
    }
    fo_out
}

// ─── The move order ─────────────────────────────────────────────
//
// Plan 11 F5c.  Once companions block a step, WHO MOVES FIRST changes
// where everybody ends up — so the order has to be a property of the
// state and not of the roster, or `ENEMY_MOVEMENT.md` § The tick
// resolves once is lost and with it every scripted number plan 08
// gates on.
//
// ⚠ **Closest to the core moves first, and that is not arbitrary.**
// Measured (plan 11 § F5c): with the tail moving first, a column in a
// corridor stretches — each enemy is blocked by the one ahead, which
// has not moved yet, so only the leader advances and the follower
// falls a hex behind every tick.  Leader-first, the whole column steps
// into the space the one ahead has just left and advances in lockstep,
// which is what a queue in a corridor should look like.
//
// "Closest to the core" is the FIELD distance, so it means the same
// thing whichever compass direction the column runs; ordering on a
// coordinate would make a westbound column advance and an eastbound
// one stretch.
//
// The rest of the key only has to be deterministic and state-derived.
// Roster index is the LAST resort, and it can only decide between
// enemies that agree on distance, hex and class — which are
// interchangeable, so the multiset of outcomes cannot depend on it.
// That is the whole order-independence argument, and
// `tests/11_f5c_spread.loft` asserts it against a reversed roster.

struct MoveSlot {
    idx:   integer,
    dist:  integer,
    q:     integer,
    r:     integer,
    kind:  integer,
    taken: boolean,
}

fn slot_before(a: const MoveSlot, b: const MoveSlot) -> boolean {
    if a.dist != b.dist { return a.dist < b.dist; }
    if a.q    != b.q    { return a.q    < b.q; }
    if a.r    != b.r    { return a.r    < b.r; }
    if a.kind != b.kind { return a.kind < b.kind; }
    a.idx < b.idx
}

// Roster indices in move order — a selection sort, because a wave is
// tens of enemies and the clarity is worth more than the exponent.
fn move_order(state: const WaveState, fields: vector<ClassField>) -> vector<integer> {
    mo_slots: vector<MoveSlot> = [];
    mo_i = 0;
    for mo_e in state.enemies {
        if mo_e.alive {
            mo_slots += [MoveSlot {
                idx:   mo_i,
                dist:  flow_distance(field_of(fields, mo_e.kind as integer), mo_e.q, mo_e.r),
                q:     mo_e.q,
                r:     mo_e.r,
                kind:  mo_e.kind as integer,
                taken: false,
            }];
        }
        mo_i = mo_i + 1;
    }

    mo_out: vector<integer> = [];
    for _ in 0..len(mo_slots) {
        mo_best = -1;
        mo_at   = 0;
        for mo_s in mo_slots {
            if !mo_s.taken {
                mo_b = mo_slots[mo_best] ?? MoveSlot {};
                if mo_best < 0 || slot_before(mo_s, mo_b) { mo_best = mo_at; }
            }
            mo_at = mo_at + 1;
        }
        if mo_best < 0 { return mo_out; }
        mo_mark = 0;
        for mo_t in mo_slots {
            if mo_mark == mo_best { mo_t.taken = true; }
            mo_mark = mo_mark + 1;
        }
        mo_out += [(mo_slots[mo_best] ?? MoveSlot {}).idx];
    }
    mo_out
}

// Where everybody stands right now.
//
// ⚠ Built ONCE per tick and then kept in step by the mover, rather
// than re-derived per enemy: a hex a companion has already left this
// tick is FREE, which is what lets a column advance in lockstep
// instead of at half speed — see § The move order.
pub fn wave_occupancy(state: const WaveState) -> Occupancy {
    wo_o = occupancy_empty();
    for wo_e in state.enemies {
        if wo_e.alive { occupancy_enter(wo_o, wo_e.q, wo_e.r); }
    }
    wo_o
}

// Advance the whole wave by one game-tick.
//
// ── The field is rebuilt ONCE per tick, before anybody moves ─────
//
// `docs/ENEMY_MOVEMENT.md` § The tick resolves once: within a tick
// every enemy acts against the same world.  That is not primarily a
// cost decision — it is what makes a tick ORDER-INDEPENDENT, and so
// what makes a scripted run reproducible, which is the premise plan
// 08 gates on.  A field rebuilt mid-loop would make the outcome
// depend on which enemy the roster happened to visit first, and no
// `.keys` scenario could assert a stable number over that.
//
// The invariant that holds it: the same wave, played with the roster
// iterated in REVERSE, produces an identical result.
//
// ⚠ **F5c is where that stopped being free.**  While movement only
// read the world it was trivially true; now a companion blocks a step,
// so the order enemies act in decides where they end up.  Three things
// are therefore fixed before the first enemy moves — the fields
// (§ One field per CLASS), the occupancy (`wave_occupancy`) and the
// order (§ The move order) — and none of the three is derived from
// roster order.
//
// ── One field per CLASS, built for the classes present ──────────
//
// See `wave_fields`.  It is the roster that decides which fields get
// built, not the set of classes the game knows about.
//
// ⚠ **From scratch every tick, deliberately.**  F8 makes it
// incremental, and its gate is equality with this — so this path
// stays the reference implementation and is not optimised away.
pub fn wave_tick(state: WaveState, pal: vector<GroundType>, pw: PaintedWorld, core: Hex) {
    // Everything the tick reads is fixed before anybody moves: the
    // fields, where everyone stands, and the order they act in.
    wt_fields = wave_fields(state, pal, pw, core);
    wt_occ    = wave_occupancy(state);
    for wt_i in move_order(state, wt_fields) {
        wt_e = state.enemies[wt_i] ?? Enemy {};
        enemy_tick(wt_e, pal, pw, field_of(wt_fields, wt_e.kind as integer), wt_occ);
    }
}

// Count of alive enemies in the wave — wave-clear check.
pub fn alive_count(state: WaveState) -> integer {
    ac_n = 0;
    for ac_e in state.enemies {
        if ac_e.alive { ac_n = ac_n + 1; }
    }
    ac_n
}

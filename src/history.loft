//
// Editor undo / redo history.
//
// Each "action" the user takes (paint stroke, marker place,
// marker remove, clear-all) produces one `UndoEntry` capturing
// the (old → new) delta for every hex / marker the action
// touched.  The History keeps a linear timeline of those
// entries plus a cursor — moves left for undo, right for redo,
// any new action while cursor < len truncates the future-redo
// branch.
//
// Delta fields use `integer` even where `u8` would fit, so that
// comparisons against MARKER_KIND_SPAWN-style integer constants
// need no cast.  (They were ALSO widened to dodge loft's
// trailing-u8 serialisation bug; that reason lapsed when the bug
// was fixed — and never really applied, since history is
// session-only and never reaches disk.  The cast-free comparisons
// are why they stay.)
//
// Plan 03 follow-up — QoL polish.

use world;
use painted;
use markers;

// One painted-hex change: (q, r) went from `old_kind` to
// `new_kind`.  Sea (kind 0) is the absence-of-paint sentinel;
// painting it on a painted hex erases the entry (painted.loft's
// sparse semantics).
pub struct PaintedDelta {
    q:        integer,
    r:        integer,
    old_kind: integer,
    new_kind: integer,
}

// One marker change: (q, r) went from `(old_present, old_kind,
// old_dir)` to `(new_present, new_kind, new_dir)`.  `*_present
// == false` means the hex had no marker before / after; the
// *_kind and *_direction values are ignored in that case (kept
// as 0 for cleanliness).  `*_kind` is the marker kind
// discriminant (MARKER_KIND_SPAWN, MARKER_KIND_TARGET, …) —
// needed so undo restores the right kind, not just direction.
pub struct MarkerDelta {
    q:             integer,
    r:             integer,
    old_present:   boolean,
    old_kind:      integer,
    old_direction: integer,
    new_present:   boolean,
    new_kind:      integer,
    new_direction: integer,
}

// One user action's worth of changes.  An action might touch
// multiple painted hexes (a paint-line drag) and/or multiple
// markers (a future "select region + clear" — clear-all today
// snapshots everything into one entry).
pub struct UndoEntry {
    painted: vector<PaintedDelta>,
    markers: vector<MarkerDelta>,
}

// Linear action timeline.  Position `cursor` is "after the most
// recent applied action": ops below cursor are undoable, ops at
// and above cursor are redoable.  Truncation drops the future-
// redo branch when a new action lands during undone state.
pub struct History {
    entries: vector<UndoEntry>,
    cursor:  integer,
}

// Maximum undo depth.  When `entries` grows past this, the
// oldest entries are dropped on each push.  50 is plenty for
// a session; bigger values waste memory without benefit since
// loft has no allocator pressure for a 50-deep list.
pub const HISTORY_MAX_DEPTH: integer = 50;

// ─── Factories ──────────────────────────────────────────────────

pub fn undo_entry_empty() -> UndoEntry {
    UndoEntry { painted: [], markers: [] }
}

pub fn history_empty() -> History {
    History { entries: [], cursor: 0 }
}

// Has the entry actually got any deltas?  Used by callers to
// skip pushing no-op actions (a paint stroke that painted the
// hex it was already on, etc.).
pub fn undo_entry_is_noop(e: const UndoEntry) -> boolean {
    len(e.painted) == 0 && len(e.markers) == 0
}

// ─── Internal helpers — vector rebuilds ─────────────────────────
//
// Loft has no public vector pop/remove/slice today.  These
// helpers rebuild the timeline as needed; O(n) per call,
// acceptable for a 50-deep history.

fn truncate_to(h: History, te_n: integer) {
    if te_n >= len(h.entries) { return; }
    te_new: vector<UndoEntry> = [];
    for te_i in 0..te_n {
        te_new += [h.entries[te_i]];
    }
    h.entries = te_new;
}

fn drop_oldest(h: History, doe_n: integer) {
    if doe_n <= 0 || doe_n > len(h.entries) { return; }
    doe_new: vector<UndoEntry> = [];
    for doe_i in doe_n..len(h.entries) {
        doe_new += [h.entries[doe_i]];
    }
    h.entries = doe_new;
    h.cursor = h.cursor - doe_n;
    if h.cursor < 0 { h.cursor = 0; }
}

// ─── Push / undo / redo / availability ──────────────────────────

// Record a new action.  Discards any redo-branch past the
// current cursor (the "new action while undone" pattern), then
// appends + advances + caps depth.  No-op if the entry has no
// deltas.
pub fn history_push(h: History, hp_entry: UndoEntry) {
    if undo_entry_is_noop(hp_entry) { return; }
    truncate_to(h, h.cursor);
    h.entries += [hp_entry];
    h.cursor = h.cursor + 1;
    if len(h.entries) > HISTORY_MAX_DEPTH {
        drop_oldest(h, len(h.entries) - HISTORY_MAX_DEPTH);
    }
}

pub fn history_can_undo(h: const History) -> boolean { h.cursor > 0 }
pub fn history_can_redo(h: const History) -> boolean { h.cursor < len(h.entries) }

// Apply the inverse of the most recent action.  Returns true if
// anything was undone, false on an empty history.
pub fn history_undo(h: History, pw: PaintedWorld, mw: MarkerWorld) -> boolean {
    if !history_can_undo(h) { return false; }
    // can_undo above proves cursor ∈ 1..=len(entries), so the
    // index is in range; the null check is belt-and-suspenders
    // and also loft's accepted defensive form for `v[i]`
    // out-of-bounds (bind, then null-check).
    hu_idx = h.cursor - 1;
    hu_entry = h.entries[hu_idx];
    if hu_entry == null { return false; }
    for hu_pd in hu_entry.painted {
        paint(pw, hu_pd.q, hu_pd.r, hu_pd.old_kind as u8? ?? 0);
    }
    for hu_md in hu_entry.markers {
        if hu_md.old_present {
            if hu_md.old_kind == MARKER_KIND_TARGET {
                place_target(mw, hu_md.q, hu_md.r);
            } else {
                place_spawn(mw, hu_md.q, hu_md.r, hu_md.old_direction as u8? ?? 0);
            }
        } else {
            remove_marker(mw, hu_md.q, hu_md.r);
        }
    }
    h.cursor = h.cursor - 1;
    true
}

// Re-apply the most recently undone action.  Returns true if
// anything was redone, false on an empty redo branch.
pub fn history_redo(h: History, pw: PaintedWorld, mw: MarkerWorld) -> boolean {
    if !history_can_redo(h) { return false; }
    hr_idx = h.cursor;
    hr_entry = h.entries[hr_idx];   // null check below: see history_undo
    if hr_entry == null { return false; }
    for hr_pd in hr_entry.painted {
        paint(pw, hr_pd.q, hr_pd.r, hr_pd.new_kind as u8? ?? 0);
    }
    for hr_md in hr_entry.markers {
        if hr_md.new_present {
            if hr_md.new_kind == MARKER_KIND_TARGET {
                place_target(mw, hr_md.q, hr_md.r);
            } else {
                place_spawn(mw, hr_md.q, hr_md.r, hr_md.new_direction as u8? ?? 0);
            }
        } else {
            remove_marker(mw, hr_md.q, hr_md.r);
        }
    }
    h.cursor = h.cursor + 1;
    true
}

// ─── Recording wrappers (called from main.loft instead of the
//     bare paint / place_spawn / remove_marker primitives) ───────

// Paint a single hex AND append a PaintedDelta to `stroke` if
// the kind actually changed.  Use to accumulate per-frame paint
// events into one stroke entry across a drag; main.loft pushes
// the stroke onto the history on button release.
pub fn paint_and_record(
    pw:       PaintedWorld,
    q:        integer,
    r:        integer,
    new_kind: u8,
    stroke:   UndoEntry,
) {
    par_old = lookup_painted(pw, q, r);
    if par_old != new_kind {
        paint(pw, q, r, new_kind);
        stroke.painted += [PaintedDelta {
            q:        q,
            r:        r,
            old_kind: par_old as integer,
            new_kind: new_kind as integer,
        }];
    }
}

// Paint a LINE of hexes AND record one delta per hex that actually
// changed.  Replaces a direct paint_line call when the caller wants
// undo support.
//
// ⚠ This carries a SECOND copy of `painted.loft::paint_line`'s lerp,
// and both are still AXIAL on purpose — see that function for why
// the conversion waits for C5.  Two copies of an interpolation is
// how the undo path and the paint path come to disagree about which
// hexes a drag covered, which is a corrupt undo entry rather than a
// visible bug, so they must convert in the SAME commit.
// `tests/09_c4_arrows.loft::test_paint_and_record_cover_the_same_hexes`
// is what fails if only one of them moves.
pub fn paint_line_and_record(
    pw:       PaintedWorld,
    a:        Hex,
    b:        Hex,
    new_kind: u8,
    stroke:   UndoEntry,
) {
    pla_n = hex_distance(a, b);
    if pla_n == 0 {
        paint_and_record(pw, a.q, a.r, new_kind, stroke);
        return;
    }
    pla_aq = a.q as float;
    pla_ar = a.r as float;
    pla_bq = b.q as float;
    pla_br = b.r as float;
    // pla_n > 0 guaranteed above; `?? 0.0` silences loft's
    // div-by-zero static check.
    pla_inv = (1.0 / (pla_n as float)) ?? 0.0;
    for pla_i in 0..=pla_n {
        pla_t  = (pla_i as float) * pla_inv;
        pla_qf = pla_aq + (pla_bq - pla_aq) * pla_t;
        pla_rf = pla_ar + (pla_br - pla_ar) * pla_t;
        pla_h  = cube_round_axial(pla_qf, pla_rf);
        paint_and_record(pw, pla_h.q, pla_h.r, new_kind, stroke);
    }
}

// Place a spawn marker AND push a one-marker UndoEntry onto the
// history.  Captures the prior state (absent or different
// direction) for clean undo.
pub fn place_spawn_and_record(
    mw:            MarkerWorld,
    q:             integer,
    r:             integer,
    new_direction: u8,
    history:       History,
) {
    pssr_was = has_marker(mw, q, r);
    pssr_old_dir:  u8      = 0 as u8;
    pssr_old_kind: integer = 0;
    if pssr_was {
        pssr_old_dir  = marker_direction(mw, q, r);
        pssr_old_kind = marker_kind(mw, q, r);
    }
    place_spawn(mw, q, r, new_direction);
    pssr_entry = undo_entry_empty();
    pssr_entry.markers += [MarkerDelta {
        q:             q,
        r:             r,
        old_present:   pssr_was,
        old_kind:      pssr_old_kind,
        old_direction: pssr_old_dir as integer,
        new_present:   true,
        new_kind:      MARKER_KIND_SPAWN,
        new_direction: new_direction as integer,
    }];
    history_push(history, pssr_entry);
}

// Place a target marker AND push a one-marker UndoEntry.
// Targets are spherical — no direction field; stored as 0,
// ignored on undo/redo apply.  Matches place_spawn_and_record's
// shape so the editor's marker-mode hotpath dispatches cleanly.
pub fn place_target_and_record(
    mw:      MarkerWorld,
    q:       integer,
    r:       integer,
    history: History,
) {
    ptar_was = has_marker(mw, q, r);
    ptar_old_dir:  u8      = 0 as u8;
    ptar_old_kind: integer = 0;
    if ptar_was {
        ptar_old_dir  = marker_direction(mw, q, r);
        ptar_old_kind = marker_kind(mw, q, r);
    }
    place_target(mw, q, r);
    ptar_entry = undo_entry_empty();
    ptar_entry.markers += [MarkerDelta {
        q:             q,
        r:             r,
        old_present:   ptar_was,
        old_kind:      ptar_old_kind,
        old_direction: ptar_old_dir as integer,
        new_present:   true,
        new_kind:      MARKER_KIND_TARGET,
        new_direction: 0,
    }];
    history_push(history, ptar_entry);
}

// Remove the marker at (q, r) AND push a one-marker UndoEntry.
// No-op if there's no marker to remove.  Captures the prior
// kind so undo restores the right marker type (spawn vs target).
pub fn remove_marker_and_record(
    mw:      MarkerWorld,
    q:       integer,
    r:       integer,
    history: History,
) {
    if !has_marker(mw, q, r) { return; }
    rmar_old_dir  = marker_direction(mw, q, r);
    rmar_old_kind = marker_kind(mw, q, r);
    remove_marker(mw, q, r);
    rmar_entry = undo_entry_empty();
    rmar_entry.markers += [MarkerDelta {
        q:             q,
        r:             r,
        old_present:   true,
        old_kind:      rmar_old_kind,
        old_direction: rmar_old_dir as integer,
        new_present:   false,
        new_kind:      0,
        new_direction: 0,
    }];
    history_push(history, rmar_entry);
}

// Build an UndoEntry capturing the diff between the current
// editor state and a freshly-loaded state.  Used by Ctrl+R
// (reload from disk) so that a subsequent Ctrl+Z restores the
// pre-reload state.  Three cases per hex:
//   - in current AND loaded with different kind → one delta
//   - in current, NOT in loaded → delta old=current, new=0
//   - in loaded, NOT in current → delta old=0, new=loaded
// Same shape for markers (present/absent + direction).
// Caller is responsible for rebinding `pw`/`mw` to the loaded
// worlds AFTER this returns; this function ONLY records.
pub fn reload_and_record(
    pw_current: PaintedWorld,
    mw_current: MarkerWorld,
    pw_loaded:  PaintedWorld,
    mw_loaded:  MarkerWorld,
    history:    History,
) {
    rar_entry = undo_entry_empty();

    // Painted: current → loaded.  Iterate current (everything
    // that's about to change or disappear) and loaded (everything
    // that's about to appear); the kind comparison skips no-op
    // hexes.
    for rar_cp in pw_current.painted {
        rar_loaded_k = lookup_painted(pw_loaded, rar_cp.q, rar_cp.r);
        if rar_loaded_k != rar_cp.kind {
            rar_entry.painted += [PaintedDelta {
                q:        rar_cp.q,
                r:        rar_cp.r,
                old_kind: rar_cp.kind as integer,
                new_kind: rar_loaded_k as integer,
            }];
        }
    }
    for rar_lp in pw_loaded.painted {
        rar_cur_k = lookup_painted(pw_current, rar_lp.q, rar_lp.r);
        if rar_cur_k == 0 as u8 {
            // Hex existed in loaded but NOT in current (sea is
            // the absent default).  The current-iteration loop
            // above missed it; add the appear-delta here.
            rar_entry.painted += [PaintedDelta {
                q:        rar_lp.q,
                r:        rar_lp.r,
                old_kind: 0,
                new_kind: rar_lp.kind as integer,
            }];
        }
    }

    // Markers: current → loaded.  Same 3-case shape.  Kind
    // change (e.g. a hex was a spawn in memory, became a target
    // on disk) is treated as direction-change semantics — the
    // delta carries both old + new kind/direction.
    for rar_cm in mw_current.markers {
        rar_loaded_present = has_marker(mw_loaded, rar_cm.q, rar_cm.r);
        if rar_loaded_present {
            rar_loaded_kind = marker_kind(mw_loaded, rar_cm.q, rar_cm.r);
            rar_loaded_dir  = marker_direction(mw_loaded, rar_cm.q, rar_cm.r);
            if rar_loaded_kind != (rar_cm.kind as integer)
            || rar_loaded_dir  != rar_cm.direction {
                // Kind or direction differs.
                rar_entry.markers += [MarkerDelta {
                    q:             rar_cm.q,
                    r:             rar_cm.r,
                    old_present:   true,
                    old_kind:      rar_cm.kind as integer,
                    old_direction: rar_cm.direction as integer,
                    new_present:   true,
                    new_kind:      rar_loaded_kind,
                    new_direction: rar_loaded_dir as integer,
                }];
            }
            // else: no change, skip
        } else {
            // Marker disappeared on reload
            rar_entry.markers += [MarkerDelta {
                q:             rar_cm.q,
                r:             rar_cm.r,
                old_present:   true,
                old_kind:      rar_cm.kind as integer,
                old_direction: rar_cm.direction as integer,
                new_present:   false,
                new_kind:      0,
                new_direction: 0,
            }];
        }
    }
    for rar_lm in mw_loaded.markers {
        if !has_marker(mw_current, rar_lm.q, rar_lm.r) {
            // Marker appeared on reload (wasn't in current).
            rar_entry.markers += [MarkerDelta {
                q:             rar_lm.q,
                r:             rar_lm.r,
                old_present:   false,
                old_kind:      0,
                old_direction: 0,
                new_present:   true,
                new_kind:      rar_lm.kind as integer,
                new_direction: rar_lm.direction as integer,
            }];
        }
    }

    history_push(history, rar_entry);
}

// Snapshot the entire editor state into a single UndoEntry and
// push it.  Caller is responsible for actually clearing the
// state afterward (rebinding `pw = painted_empty()` etc.) —
// this function only captures the deltas to make the clear
// undoable.
// `pw` / `mw` are `const`: this reads both layers and writes only
// the history.  The qualifier was dropped for a while because a
// multi-`const` call writing through a third parameter's nested
// vector tripped `Claim on read-only store`; that is fixed
// (QUESTIONS_FOR_LOFT.md § Resolved, verified 2026-08-12) and the
// signature says what it means again.
pub fn clear_and_record(
    pw:      const PaintedWorld,
    mw:      const MarkerWorld,
    history: History,
) {
    car_entry = undo_entry_empty();
    for car_pe in pw.painted {
        car_entry.painted += [PaintedDelta {
            q:        car_pe.q,
            r:        car_pe.r,
            old_kind: car_pe.kind as integer,
            new_kind: 0,
        }];
    }
    for car_me in mw.markers {
        car_entry.markers += [MarkerDelta {
            q:             car_me.q,
            r:             car_me.r,
            old_present:   true,
            old_kind:      car_me.kind as integer,
            old_direction: car_me.direction as integer,
            new_present:   false,
            new_kind:      0,
            new_direction: 0,
        }];
    }
    history_push(history, car_entry);
}

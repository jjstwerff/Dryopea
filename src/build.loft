//
// BUILDING — the ORDER, and the layer it lives in.
//
// Plan 27 phase C1.  The player cannot make a base: walls and towers
// are placed in the EDITOR, and the wallet buys nothing.  This is the
// record that changes that.
//
// ── The invariant ───────────────────────────────────────────────
//
// > **A build order is ONE record — a site, what goes there, and the
// > work still owed — and it is the only way a structure comes into
// > existence during a run.**
//
// Everything that orders creates one (wall paint, the beacon ferry);
// everything that builds spends helper-seconds against one; an order
// that reaches its total paints its hex and disappears.
//
// ⚠ Omitting the order at a NEW creator is LOUD — nothing appears — so
// the two creators do not need a type to force the call.
//
// ── Work is what has been SPENT, never what is LEFT ─────────────
//
// ⚠⚠ Same rule as `damage.loft` § DAMAGE TAKEN, `tower.loft` § Shots
// FIRED and `wallet.loft` § points SPENT, and here it is [loft#914]
// that makes it load-bearing: **a struct literal that omits a field
// takes that field's default SILENTLY**.  Store work REMAINING and a
// `BuildOrder { q: 1, r: 2, kind: … }` written anywhere is an order
// that is **already finished** — it would paint a wall the moment
// anything looked at it.  Store work SPENT and the same partial literal
// is an order nobody has started, which is the truthful zero.
//
// ── And it is INTEGER base units, not a float ───────────────────
//
// ⚠⚠ **A float rate accumulated per tick comes up SHORT**, which is the
// family `plans/26` spent a whole plan on (`@D003`, `@D004`).  Measured
// here before it was fixed: at 10 HP/s over a 2/3 s tick a `wall_high`
// took **31 ticks against a true 30**, because `10.0 * (2/3)` is not
// exact and thirty of them fall just under 200.  The repo's answer is
// integer base units, and it is the same answer here.
//
// ⚠ So an order owes a DURATION of helper time — which is what
// `numbers.json` § `wall.build_time_wall` says in the first place
// (*"one helper, one wall hex, 10 s"*).  The HP/s framing
// (§ `helper.construction_tick_hp_per_second`) is the same arithmetic
// said the other way round, and `tests/27_c0_probe.loft` asserts the
// two agree.
//
// ── Why this is NOT a `fixstep::Timer` ──────────────────────────
//
// ⚠⚠ It is the obvious reuse and it was REFUSED on semantics, not on
// taste: `timer_spend` **fires exactly once and then DISARMS**, so a
// completed timer answers `timer_spent` = 0 and the progress is gone.
// A build order has to stay readable after it completes — the tick
// spends the work and `build_resolve` paints it later, at the
// consequence stage — so a `Timer` here would need a second `done`
// flag to remember what it deliberately forgot.  **A one-shot that
// forgets and a progress bar that must not are two families**, and one
// integer is the whole of the second one.
//
// ⚠ The TOTAL is derived from the kind rather than stored, so there is
// no total to disagree with what is being built — `structure_max_hp`'s
// own choice, one layer over.
//
// ── What the order does NOT say ─────────────────────────────────
//
// ⚠ **It carries no height and no passability.**  A site is an
// INTENT: an enemy walks over it, a vehicle drives through it, and the
// flow field does not know it is there.  The alternative — a
// half-built obstacle that already blocks — is a mechanic rather than
// a detail, and `plans/27` § Open questions 2 is where it would be
// argued.
//
// ⚠ **And it carries no builder.**  `@X252` makes helpers
// semi-automatic by default, so an order is PICKED UP rather than
// assigned; a `helper` field here would be the auto-assignment
// `@X198` names as the thing that deletes the assignment pillar.
//
// ── Why this is not a `StructureHit` ────────────────────────────
//
// ⚠⚠ `DamageLayer` is the same SHAPE — a sparse hash keyed by hex, one
// door, zero removes the entry — and it is **not the same rule**.
// Damage is harm to a structure that EXISTS; an order is intent for one
// that does not, and it carries a KIND because nothing on the hex says
// what is coming.  The pattern is copied; the record is not extended.
// *Equality of shape is evidence; sameness of rule is the claim.*

use painted;
use palette;
use damage;
use lattice;
use fixstep;
use save;
use markers;

// How long one helper takes over each structure, in the clock's base
// units — `numbers.json` § `wall.build_time_wall` (10 s) and
// § `wall.build_time_wall_high` (20 s).
//
// ⚠ LITERALS, because loft refuses a call in a const initialiser; the
// seconds below are DERIVED so the two can never disagree
// (`tick_timer.loft` makes the same choice for the same reason).
pub const BUILD_WALL_UNITS:      integer = 30000000;
pub const BUILD_WALL_HIGH_UNITS: integer = 60000000;
// `numbers.json` § tower.construction_time_helper — 30 s, three times a
// wall, which is what makes a tower a decision rather than a reflex.
pub const BUILD_TOWER_UNITS:     integer = 90000000;

// What one hex of TRENCH owes, in base units (BACKLOG C5) — 10 s,
// exactly a `wall`'s.
//
// ⚠⚠ **CHOSEN, and it is chosen to be EQUAL rather than derived.**
// `numbers.json` has no trench row — the case `docs/PROGRESSION.md`
// § P2 says to push back on and then choose in the open.  Equal is the
// choice because it makes the player's question *what does it DO*
// rather than *what does it cost*: a wall hex and a trench hex are the
// same 1.5 m of ground moved, one piled up and one taken away, and the
// two answer different threats (`moat.loft` § THE DEPTH IS THE MOAT'S
// COST).  A price difference would decide that trade with arithmetic
// instead of with the map.
//
// ⚠ It is a LITERAL rather than `= BUILD_WALL_UNITS`, matching its
// three siblings above — and deliberately, because the day one of the
// two moves the other must be looked at rather than dragged along.
pub const BUILD_MOAT_UNITS:      integer = 30000000;

pub const BUILD_WALL_SECONDS: float =
    (BUILD_WALL_UNITS as float) / (CLOCK_UNITS_PER_SECOND as float);
pub const BUILD_WALL_HIGH_SECONDS: float =
    (BUILD_WALL_HIGH_UNITS as float) / (CLOCK_UNITS_PER_SECOND as float);
pub const BUILD_TOWER_SECONDS: float =
    (BUILD_TOWER_UNITS as float) / (CLOCK_UNITS_PER_SECOND as float);
pub const BUILD_MOAT_SECONDS: float =
    (BUILD_MOAT_UNITS as float) / (CLOCK_UNITS_PER_SECOND as float);

// What a tower beacon costs, in wallet points — `numbers.json`
// § tower.order_cost_points.
//
// ⚠⚠ **This is the FIRST thing the wallet has ever bought.**  Points
// have been earned since `13-V3` and drained since `12-B6`, and
// `ROADMAP.md` § Why BUILDING is the load-bearing gap names that as the
// gap: *"it is what the wallet is for … and neither exists"*.
//
// ⚠ Spent at PICKUP, not at placement, and the design says so: *"failed
// deposit does not refund"*.  A beacon in the hands IS the hundred
// points.
pub const TOWER_ORDER_COST_POINTS: float = 100.0;

// What an order builds.
//
// ⚠ `BUILD_GROUND` is 0 so that [loft#914]'s silent default lands on
// the common case: a `BuildOrder { q, r, kind: … }` written by hand is
// a ground order, which is what it reads like.
pub const BUILD_GROUND: u8 = 0;   // paint the hex with `kind`
pub const BUILD_TOWER:  u8 = 1;   // place a tower marker on it

// One ordered structure.
pub struct BuildOrder {
    q:     integer,
    r:     integer,
    what:  u8,        // BUILD_GROUND / BUILD_TOWER — how to read `kind`
    kind:  u8,        // palette index, for BUILD_GROUND
    spent: integer,   // helper time put in — see § Work is what has been SPENT
}

// Every order on the map.  Lives on `WaveState`, never saved: a map
// holds the GROUND and the MARKERS (`maps.loft`), and an order is
// something a RUN is in the middle of.
pub struct BuildLayer {
    cells: hash<BuildOrder[q, r]>,
}

// Factory: nothing ordered.
pub fn build_layer_empty() -> BuildLayer {
    BuildLayer { cells: [] }
}

// How much helper time `kind` owes, in base units — 0 for anything
// that cannot be built.
//
// ⚠⚠ **A flat figure per kind, and that is a refusal** (`@M048`).  The
// tempting definition is *the HP it will have*, which would also handle
// bracing for free — elegantly, and wrongly: `structure_max_hp` scales
// by `brace_of`, so a lone stub would owe a sixth of a wall and go up
// in 1.5 s where `DESIGN.md` § 13 says *one helper, one wall hex, 10 s*
// flatly.  **A wall is cheaper to BREAK at an end; it is not cheaper to
// BUILD there.**
//
// ⚠ It asks by KIND rather than by hex because an order's hex is still
// grass — there is nothing painted there to read.
//
// Example: @DRY-098, @DRY-131
pub fn order_work_units(pal: vector<GroundType>, what: u8, kind: u8) -> integer {
    if what == BUILD_TOWER { return BUILD_TOWER_UNITS; }
    owu_e = pal[kind as integer] ?? GroundType {};
    if owu_e.name == "wall"      { return BUILD_WALL_UNITS; }
    if owu_e.name == "wall_high" { return BUILD_WALL_HIGH_UNITS; }
    // ⚠⚠ **`water` is a thing that can be BUILT, and it is the only
    // buildable kind that goes DOWN** (BACKLOG C5).  The trench is an
    // ordinary ground order — same queue, same work loop, same erase
    // rule, same resolve — and `build_resolve` paints it like any other,
    // which is why a moat needed no second layer.
    //
    // ⚠ **`rapids` and `waterfall` are NOT here on purpose.**  Their
    // drops are 3 and 8 against a boost that climbs 3.0, so ordering one
    // would let a player dig a hole they could never leave.
    // `moat.loft` § Why `water` and only `water` may be dug has the
    // argument; the refusal lives here because `order_work_units` is
    // already the list of what may be built at all.
    if owu_e.name == "water"     { return BUILD_MOAT_UNITS; }
    0
}

// Is there an order here?
pub fn order_at(bl: const BuildLayer, q: integer, r: integer) -> boolean {
    bl.cells[q, r] != null
}

// What is ordered here — palette index, or 0 (sea, i.e. nothing) on a
// hex with no order.
pub fn order_kind(bl: const BuildLayer, q: integer, r: integer) -> u8 {
    ok_c = bl.cells[q, r];
    if ok_c == null { 0 as u8 } else { ok_c.kind }
}

// What is ordered here — `BUILD_GROUND` on a hex with no order, which is
// also what a ground order reads.  ⚠ Tell them apart with `order_at`.
pub fn order_what(bl: const BuildLayer, q: integer, r: integer) -> u8 {
    ow_c = bl.cells[q, r];
    if ow_c == null { return BUILD_GROUND; }
    ow_c.what
}

// Helper time spent here so far, in base units — 0 where nothing is
// ordered, which is also what an untouched order reads.
//
// ⚠ The two are told apart by `order_at`, never by this number.
pub fn order_spent(bl: const BuildLayer, q: integer, r: integer) -> integer {
    od_c = bl.cells[q, r];
    if od_c == null { 0 } else { od_c.spent }
}

// How many orders stand.
pub fn order_count(bl: const BuildLayer) -> integer {
    len(bl.cells)
}

// Why an order at (q, r) for `kind` would be refused — `""` when it
// would not.
//
// ⚠⚠ **This is the doorstep, and `order_place` asks it rather than
// duplicating it** — the shape `maps.loft::map_fault` uses, so the
// same sentence answers *may I?* and *why not?*.
//
// ⚠ Pure of the run: it reads the palette, the ground and the orders
// already standing, so it reads the same for a hex reached by driving,
// by a script, or by a beacon.
//
// Example: @DRY-099
pub fn order_fault(pal: vector<GroundType>, pw: PaintedWorld,
                   bl: const BuildLayer, q: integer, r: integer,
                   what: u8, kind: u8) -> text {
    if order_work_units(pal, what, kind) <= 0 {
        of_want = pal[kind as integer] ?? GroundType {};
        return "`{of_want.name}` is not something that can be built";
    }
    // ⚠ The palette has carried `buildable` since plan 01 and no
    // simulation code read it until now.  Sea, water, rapids,
    // waterfall, steep_rock, both walls and rubble are all false —
    // which is *you cannot build on water, on a cliff, on a heap, or
    // on something already standing*, in one flag.
    of_here = lookup_painted(pw, q, r);
    of_g = pal[of_here as integer] ?? GroundType {};
    if !of_g.buildable {
        return "the ground at ({q}, {r}) is `{of_g.name}`, which is not buildable";
    }
    if order_at(bl, q, r) {
        if order_what(bl, q, r) == BUILD_TOWER {
            return "({q}, {r}) is already ordered as a tower";
        }
        of_std = pal[order_kind(bl, q, r) as integer] ?? GroundType {};
        return "({q}, {r}) is already ordered as `{of_std.name}`";
    }
    // ⚠⚠ **What is NOT asked here: is there already a MARKER on this
    // hex.**  It needs the marker world, which a build layer has no
    // business knowing about — so the tower's half lives in
    // `spawn.loft::wave_drop`, where the markers are already in hand.
    // That is exactly the split `carry.loft::cargo_destination_ok`
    // makes for a tower TOP, and for the same reason.
    ""
}

// Order `kind` at (q, r).  Answers whether it was accepted.
//
// ⚠⚠ **The ONE door.**  It asks `order_fault` itself, so a caller
// cannot place an illegal order by forgetting to check — which is what
// makes the refusals above a rule rather than a convention.  The wall
// trail and the beacon ferry both arrive here.
//
// Example: @DRY-098
pub fn order_place(pal: vector<GroundType>, pw: PaintedWorld,
                   bl: BuildLayer, q: integer, r: integer,
                   what: u8, kind: u8) -> boolean {
    if order_fault(pal, pw, bl, q, r, what, kind) != "" { return false; }
    bl.cells[q, r] = BuildOrder { q: q, r: r, what: what, kind: kind, spent: 0 };
    true
}

// Take an order back.  Answers whether one was removed.
//
// ⚠⚠ **Refuses an order somebody has started**, which is `DESIGN.md`
// § 11 § Wall paint's *"only valid while no helper has started
// building — construction commits the order"*.  The rule lives here
// rather than in the trail, because the beacon ferry wants it too and
// a second copy is the one that drifts.
//
// Example: @DRY-100
pub fn order_erase(bl: BuildLayer, q: integer, r: integer) -> boolean {
    oe_c = bl.cells[q, r];
    if oe_c == null { return false; }
    // ⚠⚠ **A TOWER order is never erasable**, and this branch is the
    // one the probe found (§ One queue, two things to build).  The
    // player paid 100 points at PICKUP and `numbers.json`
    // § tower.order_cost_points says *"failed deposit does not
    // refund"* — so without this line the wall trail, which erases any
    // order it drives over, would destroy a beacon the player had just
    // paid for, silently, by crossing their own tower site.
    if oe_c.what == BUILD_TOWER { return false; }
    if oe_c.spent > 0 { return false; }
    bl.cells[q, r] = null;
    true
}

// Spend `amount` of work on the order at (q, r).  Answers whether that
// spend COMPLETED it.
//
// ⚠ It does not paint — completion is a consequence and belongs with
// the tick's other consequences (`spawn.loft` § the deaths and the
// breaks).  `order_finish` is the site that does both halves.
//
// ⚠ A spend on a hex with no order is a no-op rather than a fault: a
// helper working on an order somebody erased this tick is a race the
// caller should not have to spell.
pub fn order_spend(pal: vector<GroundType>, bl: BuildLayer,
                   q: integer, r: integer, units: integer) -> boolean {
    oa_c = bl.cells[q, r];
    if oa_c == null { return false; }
    if units <= 0 { return false; }
    oa_total = order_work_units(pal, oa_c.what, oa_c.kind);
    oa_was = oa_c.spent;
    oa_c.spent = oa_was + units;
    oa_was < oa_total && oa_c.spent >= oa_total
}

// Has the order at (q, r) had all its work spent?
pub fn order_complete(pal: vector<GroundType>, bl: const BuildLayer,
                      q: integer, r: integer) -> boolean {
    oc_c = bl.cells[q, r];
    if oc_c == null { return false; }
    oc_total = order_work_units(pal, oc_c.what, oc_c.kind);
    oc_total > 0 && oc_c.spent >= oc_total
}

// ─── The work (plan 27 C2) ──────────────────────────────────────

// How far a builder reaches, in hexes — its own hex and the six around
// it.
//
// ⚠ **Its own constant, though it equals `VEHICLE_SALVAGE_REACH_HEXES`
// today.**  Clearing a heap and raising a wall are two rules that
// happen to agree on a number; sharing the constant would make a change
// to one silently change the other.  *Equality of value is evidence;
// sameness of rule is the claim.*
pub const BUILD_REACH_HEXES: integer = 1;

// One builder's tick of construction.
pub struct BuildWork {
    q:        integer,
    r:        integer,
    spent:    integer,    // helper time put in — 0 when nothing was in reach
    finished: boolean,    // did this spend complete the order?
}

// Work for one tick by a builder standing at `at`.
//
// ⚠⚠ **The MOST ADVANCED order in reach, not the nearest.**  A
// half-built wall stops nothing, so finishing one is worth more than
// starting three — and it is what makes *N helpers are N times as
// fast* observable at all, because a crew that spread out would finish
// nothing sooner.  `vehicle.loft::salvage_at` makes the same shape of
// choice (the DEEPEST heap) for the same reason.
//
// ⚠ Ties keep the builder's OWN hex, then direction order — `>` rather
// than `>=`, exactly as `salvage_at` does, so a scripted run repeats.
//
// ⚠ It SPENDS: like `salvage_at` it is the work, not a query.
//
// ⚠ `elapsed` is the tick's length in the clock's BASE UNITS, which is
// what makes one helper-second one helper-second at every tick length
// (`plans/26` L2's rule, and the reason this is not a float rate).
//
// Example: @DRY-101
pub fn build_at(pal: vector<GroundType>, bl: BuildLayer, at: const Hex,
                elapsed: integer) -> BuildWork {
    ba_best = Hex { q: at.q, r: at.r };
    ba_top  = -1;
    if order_at(bl, at.q, at.r) { ba_top = order_spent(bl, at.q, at.r); }
    for ba_d in 0..6 {
        ba_n = lat_neighbour(at, ba_d);
        if !order_at(bl, ba_n.q, ba_n.r) { continue; }
        ba_done = order_spent(bl, ba_n.q, ba_n.r);
        if ba_done > ba_top {
            ba_top  = ba_done;
            ba_best = ba_n;
        }
    }
    if ba_top < 0 { return BuildWork { q: at.q, r: at.r, spent: 0, finished: false }; }

    ba_fin = order_spend(pal, bl, ba_best.q, ba_best.r, elapsed);
    BuildWork { q: ba_best.q, r: ba_best.r, spent: elapsed, finished: ba_fin }
}

// Raise every finished order and take it off the layer.  Answers how
// many appeared.
//
// ⚠⚠ **The tick's CONSEQUENCE stage — `damage_resolve`'s sibling**, and
// for the same reason it exists: work accumulates while the crew moves,
// and the world changes once, at the end.  Painting inside the work
// loop would let helper 2 build against a world helper 1 had already
// changed, and would make the crew's roster order load-bearing.
//
// ⚠ A completed order is REMOVED rather than left at full: an order on
// a hex that now holds a wall would fail `order_fault`'s own
// `buildable` test for ever, which is a record that can never be acted
// on again.
//
// ⚠ **`what` decides which of the two things appears**, and it is the
// only site that reads it that way — a tower is a MARKER and a wall is
// PAINT, so the completion effect is the one place the two orders
// genuinely part company.
//
// Example: @DRY-101, @DRY-102, @DRY-104, @DRY-106
pub fn build_resolve(pal: vector<GroundType>, pw: PaintedWorld,
                     mw: MarkerWorld, bl: BuildLayer) -> integer {
    br_done: vector<BuildOrder> = [];
    for br_c in bl.cells {
        br_t = order_work_units(pal, br_c.what, br_c.kind);
        if br_t > 0 && br_c.spent >= br_t {
            br_done += [BuildOrder { q: br_c.q, r: br_c.r, what: br_c.what,
                                     kind: br_c.kind, spent: br_c.spent }];
        }
    }
    for br_o in br_done {
        if br_o.what == BUILD_TOWER {
            // ⚠ `place_marker` is the ONE dispatch (`markers.loft`), so a
            // tower raised here is the same tower the editor places and
            // a `.keys` file authors — there is no second way to make
            // one, and a tower with no `TowerCharge` cell is a tower
            // that has not fired yet rather than a broken one.
            place_marker(mw, br_o.q, br_o.r, MARKER_KIND_TOWER, 0 as u8);
        } else {
            paint(pw, br_o.q, br_o.r, br_o.kind);
        }
        bl.cells[br_o.q, br_o.r] = null;
    }
    len(br_done)
}

// The palette index the wall trail lays.
//
// ⚠ Looked up by NAME rather than written as `9`, because the palette
// is loaded from a file and a hard-coded index is a second definition
// of what `wall` is — `save.loft::palette_index_of` is the one door.
//
// ⚠ **The trail lays the LOW wall.**  `DESIGN.md` § 13 gives both
// heights the same economics and the player the choice, but the choice
// itself is a second key and `@X139` makes the key table a budget —
// so the trail lays one kind and picking the other is unbuilt work
// rather than an omission.
pub fn as_wall_kind(pal: vector<GroundType>) -> u8 {
    awk_i = palette_index_of(pal, "wall");
    if awk_i < 0 { return 0 as u8; }
    awk_i as u8? ?? 0
}

// The palette index the TRENCH trail lays (BACKLOG C5).
//
// ⚠ `as_wall_kind`'s shape and for its reason: by NAME, because a
// hard-coded `1` is a second definition of what `water` is.
//
// ⚠⚠ **The trail lays the SHALLOW water, and unlike its sibling that
// is not a deferred choice — it is the only one that is safe.**  A
// `rapids` or `waterfall` trench is deeper than the player's own boost
// climbs, so a second key offering them would offer a soft-lock.
// `moat.loft` § Why `water` and only `water` may be dug.
//
// Example: @DRY-133
pub fn as_moat_kind(pal: vector<GroundType>) -> u8 {
    amk_i = palette_index_of(pal, "water");
    if amk_i < 0 { return 0 as u8; }
    amk_i as u8? ?? 0
}

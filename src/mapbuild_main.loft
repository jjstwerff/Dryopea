//
// BACKLOG A2 — the map builder's entry point.
//
// Launch (per CLAUDE.md § Key commands):
//   scripts/build_maps.sh              every source in maps/
//   scripts/build_maps.sh starter_01   just that one
//   make maps  /  make maps MAP=starter_01
//
// This file is to `src/maps.loft` what `src/validate_main.loft` is to
// the gate: the shell, and nothing else.  It holds no decision,
// because a `#cwd` file cannot be `use`d as a library and so is
// compiled by nothing — see `src/maps.loft`.
//
// ⚠ Parse-check it by hand after every edit — `scripts/test.sh`
// cannot see it (`make check FILE=src/mapbuild_main.loft`).

#cwd

use dryopea;

fn main() {
    // One optional argument: the name of a single map to build,
    // without its `.keys`.  Absent means all of them.
    mm_only = arguments()[0] ?? "";

    println("dryopea maps — building {MAPS_DIR}/*{MAP_EXT}");
    mm_rep = map_build_all(MAPS_DIR, VALIDATE_PALETTE, VALIDATE_SHOTS_DIR, mm_only);
    println(map_build_verdict(mm_rep));

    // `panic` is the only way a loft program hands a non-zero status
    // to the shell today — there is no `exit`.  The verdict is
    // already printed above; this is what makes `make maps` go red
    // rather than merely say so.
    if mm_rep.message != "" {
        panic("maps: {mm_rep.message}");
    }
}

//
// The lattice — plan 09 phase C1.
//
// dryopea's hex world moved from **axial flat-top** — the convention
// `src/world.loft` carried, deleted in C6 — to **pointy-top, odd-r
// offset**, the convention `hex_grid` calls
// "THE CONVENTION (shared with moros — the single executable source
// of it)", which every `hex_*` library and moros already speak.
// dryopea was the only consumer in the ecosystem holding the other
// one, so dryopea is what moves.
//
// ⚠ **This file DELEGATES; it does not reimplement.**  Every lattice
// answer here comes from `hex_grid`.  CLAUDE.md § Loft consumer
// relationship makes that the rule ("do not write a dryopea-local
// version of a routine a library already provides"), and it is also
// what makes the goal true by CONSTRUCTION rather than by agreement:
// a second implementation would speak the right lattice only for as
// long as two copies stayed in step, and moros#10 is what happens
// when they do not.
//
// What this file adds on top is exactly the two things `hex_grid`
// cannot know:
//
//   - dryopea's `Hex { q, r }` type, so call sites are not threading
//     bare tuples and reading `.0` / `.1` (which loft#877 makes
//     actively dangerous in tail position),
//   - dryopea's METRES.  `hex_grid` works at circumradius 1.0;
//     dryopea's hexes are 1.5 m vertex-to-vertex.
//
// ── What the metre scale is, and why it is exactly 0.75 ─────────
//
// `hex_grid` places centres at `x = √3·(col + ½·(row&1))`,
// `y = 1.5·row` with `HEX_SIZE = 1.0`, so a hex there has
// circumradius 1 and neighbouring centres are `√3` apart.
//
// dryopea's `HEX_DIAMETER` is 1.5 m VERTEX-TO-VERTEX, so its
// circumradius is 0.75 m and its centre-to-centre spacing is
// `√3 × 0.75 = 1.299038` — which is exactly `HEX_FLAT_TO_FLAT`, the
// constant dryopea already carried (in `world.loft` then; here since
// C6).  So the two agree already and the conversion is one multiply.
//
// That settles the plan's open question 1: dryopea SCALES
// `hex_grid`'s output and keeps its own metre.  It does not redefine
// the metre, and `hex_grid` does not need a scale parameter.
//
// ── ⚠ Two findings that will shear something if forgotten ───────
//
// **1. There is no fixed (dq, dr) per direction any more.**  In
// odd-r offset the neighbour delta DEPENDS ON ROW PARITY — that is
// the whole point of the layout.  So the old `hex_offset`, which
// answered a constant pair per direction, has no counterpart here and
// is deliberately absent.  An operation is DELETED by this
// conversion, not translated — and C6 deleted the last of it along
// with `world.loft` itself.
//
// **2. `hex_grid`'s compass assumes +y is UP; dryopea's is DOWN — so
// the metre conversion NEGATES y.**  `hex_grid` documents "r
// increases upward" and names direction 5 `NE`, while placing row
// `r+1` at LARGER y; dryopea's world +y is SOUTH.  Taken literally
// the two agree on the lattice and disagree on the compass by a
// north↔south mirror.
//
// **Decision (project owner, 2026-08-13): follow `hex_grid`'s
// compass, and let the maps flip.**  So `lat_to_metres` returns
// `-y`, and direction 5 really is north-east on screen.  The
// alternative — keep the picture and mirror the names — would have
// left every `hex_*` library and moros describing dryopea's world
// with the wrong words forever, which is the whole thing plan 09
// exists to stop.
//
// ⚠ The negation is a FRAME convention, not a second implementation:
// it is in the same category as the metre scale — something
// `hex_grid` cannot know, because it does not know which way
// dryopea's screen faces.  It costs nothing in the lattice (a
// reflection preserves distance, adjacency and the pointy-top
// hexagon, which is symmetric about its own horizontal axis) and it
// keeps BOTH of dryopea's standing conventions: world +y still grows
// south, and the render path still has no y-flip in it.
//
// ⚠ What it does cost: **existing maps render vertically mirrored.**
// That is accepted, not overlooked — C5 relabels coordinates and
// does NOT add a compensating flip.  A map that came back looking
// the same would mean the compass had not moved.
//
// ── Naming ──────────────────────────────────────────────────────
//
// Everything is `lat_*`.  Two lattices coexist until C6 deletes the
// axial one, and both take a `Hex`, so a bare `distance` sitting
// beside `hex_distance` is precisely how a call site picks the wrong
// answer without anybody noticing.  The prefix makes the migration
// greppable and C6 can drop it.

use hex_grid;

// ─── The coordinate, and the metre ──────────────────────────────
//
// Moved here from `world.loft` when C6 deleted it.  A hex coordinate
// and the world's scale outlive the lattice that was hand-rolled
// around them — what died was the axial ARITHMETIC, not the type.

// A hex coordinate: **pointy-top, odd-r offset**, so `q` is a COLUMN
// and `r` is a ROW.  Odd rows sit half a hex east of even ones,
// which is why a neighbour's delta depends on `r & 1` and why
// nothing may step a coordinate except `lat_neighbour`.
pub struct Hex {
    q: integer,
    r: integer,
}

pub const HEX_DIAMETER: float = 1.5;            // m, vertex-to-vertex
pub const HEX_FLAT_TO_FLAT: float = 1.299038;   // m, ≈ √3 × circumradius

pub const HAZE_RADIUS_HEXES_DEFAULT: integer = 40;  // numbers.json camera.visible_radius_haze

// Metres per `hex_grid` unit: dryopea's circumradius.  A hex is
// `HEX_DIAMETER` vertex-to-vertex, so its circumradius is half that.
pub const LAT_METRES_PER_UNIT: float = 0.75;   // = HEX_DIAMETER / 2

// ─── Neighbours ─────────────────────────────────────────────────

// The hex one step from `h` in direction `d` (0..5).
//
// ⚠ Parity-dependent — see finding 1 above.  This is the ONLY way
// to step a coordinate in the new lattice; there is no offset table
// to add by hand.
pub fn lat_neighbour(h: const Hex, d: integer) -> Hex {
    ln_n = hex_grid::hex_neighbor(h.q, h.r, d);
    Hex { q: ln_n.0, r: ln_n.1 }
}

// All six neighbours, in direction order.
pub fn lat_neighbours(h: const Hex) -> vector<Hex> {
    lns_out: vector<Hex> = [];
    for lns_d in 0..6 {
        lns_out += [lat_neighbour(h, lns_d)];
    }
    lns_out
}

// Which direction leads from `a` to its neighbour `b`?  -1 when the
// two are not adjacent — the inverse of `lat_neighbour`, and what a
// marker arrow needs to point at the cell it names.
pub fn lat_direction(a: const Hex, b: const Hex) -> integer {
    hex_grid::hex_neighbor_dir(a.q, a.r, b.q, b.r)
}

// The two corners of a hex's ring that bound the edge towards its
// neighbour in direction `d`, in RING ORDER — consecutive, and the
// pair WRAPS for one of the six.  Plan 25 M1.
//
// ⚠ The order is what a caller depends on: `ground_side_faces` walks
// a quad up from the FIRST named corner, and that is what makes the
// face point outward.  A pair given the other way round is a face
// that draws nothing under `GL_CULL_FACE`.
//
// ⚠ Takes no `Hex`: unlike the neighbour LABEL delta, the corner
// relation does NOT depend on row parity — a hexagon is the same
// hexagon on both parities, and only its coordinates move.  Same
// split as `lat_direction_unit`.
//
// ⚠ **Delegated and never tabulated**, for `lat_neighbour`'s reason:
// a hand-written six-row table here is a second lattice, and it would
// speak the right one only for as long as two copies stayed in step.
// `tests/25_m1` re-derives the pairing GEOMETRICALLY — the two corners
// nearest the neighbour's centre — rather than restating the table, so
// the delegation is checked in dryopea's own frame rather than
// assumed to survive its two y-negations.
pub fn lat_edge_corners(d: integer) -> (integer, integer) {
    hex_grid::hex_edge_corners(d)
}

// ─── Metric ─────────────────────────────────────────────────────

// Distance in steps.
pub fn lat_distance(a: const Hex, b: const Hex) -> integer {
    hex_grid::hex_distance(a.q, a.r, b.q, b.r)
}

// ─── The relabel ────────────────────────────────────────────────
//
// odd-r offset ↔ axial.  `hex_grid` uses this internally (its
// `hex_distance` and `px_to_hex` both convert) but does not export
// it, and two things here need it: `lat_line`, because interpolation
// is only linear in axial, and C2's data migration.
//
// ⚠ `hex_grid::hex_round` returns AXIAL, not offset — its own
// `px_to_hex` converts the result before handing it back.  A caller
// that treats a `hex_round` answer as offset gets a sheared cell,
// silently.  `lat_from_axial` is the conversion that stops that.

// offset (col, row) → axial (q, r).
pub fn lat_to_axial(h: const Hex) -> (integer, integer) {
    lta_aq = h.q - (h.r - (h.r & 1)) / 2;
    (lta_aq, h.r)
}

// axial (q, r) → offset (col, row).
pub fn lat_from_axial(aq: integer, ar: integer) -> Hex {
    Hex { q: aq + (ar - (ar & 1)) / 2, r: ar }
}

// ─── Metres ─────────────────────────────────────────────────────

// Hex centre in world-space metres (x, y).
//
// ⚠ +y is SOUTH here, as everywhere else in dryopea, and `hex_grid`'s
// +y is NORTH — hence the negation.  It is what makes the compass
// true: direction 5 is `NE` in the library's docs, and after this it
// is up-and-right on dryopea's screen too.  See finding 2.
pub fn lat_to_metres(h: const Hex) -> (float, float) {
    ltm_p = hex_grid::hex_to_px(h.q, h.r);
    (ltm_p.0 * LAT_METRES_PER_UNIT, -ltm_p.1 * LAT_METRES_PER_UNIT)
}

// Which hex contains the world-space point (x, y)?  The inverse of
// `lat_to_metres`, negation included — miss that and picking lands
// one row off in the mirrored direction, which looks like a rounding
// bug and is not one.
pub fn lat_from_metres(x: float, y: float) -> Hex {
    // `?? 0.0` silences loft's div-by-zero static check; the divisor
    // is a non-zero constant.
    lfm_inv = (1.0 / LAT_METRES_PER_UNIT) ?? 0.0;
    lfm_h = hex_grid::px_to_hex(x * lfm_inv, -y * lfm_inv);
    Hex { q: lfm_h.0, r: lfm_h.1 }
}

// Corner `i` of hex `h`, in metres.  Corner 0 is the TOP vertex — a
// pointy-top hex has one, and the negation is what keeps it at the
// top of dryopea's screen rather than the bottom.
//
// ⚠ The negation reverses the WINDING: `hex_grid` walks the corners
// counter-clockwise in its own frame, so in dryopea's they run
// clockwise.  Consecutive corners are still adjacent and still one
// side apart, which is all a convex fill needs — but anything that
// ever comes to depend on signed area or winding order must read
// this rather than the library's doc-comment.
pub fn lat_corner_metres(h: const Hex, i: integer) -> (float, float) {
    lcm_p = hex_grid::hex_corner_px(h.q, h.r, i);
    (lcm_p.0 * LAT_METRES_PER_UNIT, -lcm_p.1 * LAT_METRES_PER_UNIT)
}

// The offset from ANY hex's centre to its corner `i`, in metres.
//
// Constant, because the shape does not depend on where the hex is —
// which is what lets the renderer compute six pixel offsets once per
// draw instead of six absolute positions per hex.  `draw_hex` reads
// this rather than carrying its own vertex table, so the hexagon on
// screen is the lattice's hexagon by construction.
pub fn lat_corner_offset(i: integer) -> (float, float) {
    lco_p = hex_grid::hex_corner_offset(i);
    (lco_p.0 * LAT_METRES_PER_UNIT, -lco_p.1 * LAT_METRES_PER_UNIT)
}

// The unit vector in world metres pointing along direction `d`.
//
// ⚠ Uniform across the lattice, unlike the neighbour LABEL delta.
// The label step is parity-dependent (finding 1 above); the physical
// direction is not — direction 3 is due west from every hex on both
// row parities.  So this is computed once from the origin, and it is
// what a marker arrow points along.
//
// Derived from `lat_neighbour` rather than from an angle table, so a
// direction can never mean one thing to the mover and another to the
// arrow drawn over it.
pub fn lat_direction_unit(d: integer) -> (float, float) {
    ldu_o  = Hex { q: 0, r: 0 };
    ldu_n  = lat_neighbour(ldu_o, d);
    ldu_om = lat_to_metres(ldu_o);
    ldu_nm = lat_to_metres(ldu_n);
    // Centre-to-centre is √3 circumradii; `?? 0.0` silences the
    // div-by-zero check on a non-zero constant.
    ldu_inv = (1.0 / (hex_grid::SQRT3 * LAT_METRES_PER_UNIT)) ?? 0.0;
    ((ldu_nm.0 - ldu_om.0) * ldu_inv, (ldu_nm.1 - ldu_om.1) * ldu_inv)
}

// The compass BEARING from `a` to `b`, in radians, and whether there
// is one — `0` is due east and `+pi/2` due north, which is `atan2`'s
// own convention read on a compass.
//
// ⚠⚠ **It answers a PAIR, and the second half is the whole reason it
// is not a bare float.**  `a == b` has no direction at all, and
// `atan2(0, 0)` answers `0.0` — due east — which is a perfectly
// plausible bearing.  Plan 19 P2 spells *stop* as
// `vehicle_drive(v, v.q, v.r)`, so a parked mover's destination IS its
// position: a bare float would swing every parked vehicle and every
// camera behind one to face east on each key release (`@X067`).
//
// ⚠ **The y NEGATION is what makes it a compass and not a screen
// angle.**  `lat_to_metres` grows `+y` SOUTH (§ the compass note at the
// top of this file), so north is `-dy`.  Get it wrong and every bearing
// is mirrored about the east-west axis, which still tracks, still
// eases, and still looks like a working heading.
pub fn lat_bearing(a: const Hex, b: const Hex) -> (float, boolean) {
    lb_from = lat_to_metres(a);
    lb_to   = lat_to_metres(b);
    lb_east  = lb_to.0 - lb_from.0;
    lb_north = -(lb_to.1 - lb_from.1);
    if lb_east == 0.0 && lb_north == 0.0 { return (0.0, false); }
    (atan2(lb_north, lb_east), true)
}

// ─── Lines and discs ────────────────────────────────────────────

// Every hex on the line from `a` to `b`, endpoints included.
//
// Interpolation happens in AXIAL, because offset coordinates are not
// linear — lerping them directly is the shear moros#10 paid for.
// Convert in, lerp, cube-round, convert back.
pub fn lat_line(a: const Hex, b: const Hex) -> vector<Hex> {
    ll_out: vector<Hex> = [];
    ll_n = lat_distance(a, b);
    if ll_n == 0 {
        ll_out += [Hex { q: a.q, r: a.r }];
        return ll_out;
    }
    ll_a = lat_to_axial(a);
    ll_b = lat_to_axial(b);
    ll_aq = ll_a.0 as float;
    ll_ar = ll_a.1 as float;
    ll_dq = (ll_b.0 - ll_a.0) as float;
    ll_dr = (ll_b.1 - ll_a.1) as float;
    // Hoisted out of the loop, and `?? 0.0` silences the div-by-zero
    // check — `ll_n > 0` is guaranteed by the early return.
    ll_inv = (1.0 / (ll_n as float)) ?? 0.0;
    for ll_i in 0..=ll_n {
        ll_t  = (ll_i as float) * ll_inv;
        ll_rd = hex_grid::hex_round(ll_aq + ll_dq * ll_t, ll_ar + ll_dr * ll_t);
        ll_out += [lat_from_axial(ll_rd.0, ll_rd.1)];
    }
    ll_out
}

// Every hex within `radius` of `centre`, the centre included — the
// disc the camera renders.
//
// ⚠ Built by FILTERING a bounding box on `lat_distance`, not by
// enumerating an axial range and converting.  The second would make
// the disc correct by construction and its count a tautology; this
// way the count (`3N(N+1)+1`, exact for any hex lattice) is a real
// check on `lat_distance` itself.
//
// The box needs one extra column each side: the odd-row half-shift
// moves a cell's column by one relative to its axial position.
pub fn lat_disc(centre: const Hex, radius: integer) -> vector<Hex> {
    ld_out: vector<Hex> = [];
    if radius < 0 { return ld_out; }
    for ld_r in (centre.r - radius)..=(centre.r + radius) {
        for ld_q in (centre.q - radius - 1)..=(centre.q + radius + 1) {
            ld_h = Hex { q: ld_q, r: ld_r };
            if lat_distance(centre, ld_h) <= radius {
                ld_out += [ld_h];
            }
        }
    }
    ld_out
}

// #examples
//
// A PART, AS TRIANGLES — the geometry emitter.
//
// Plan 20 phase A2.  `docs/PARTS.md` § D4 is the decision this serves:
// *"a part emits TRIANGLES, and pixels appear only at the final
// rasterisation"*, with the table of layers that says nothing above the
// rasteriser depends on a pixel.  This file is the row marked *the
// geometry emitter*, and it mentions no pixel at all.
//
// ── ⚠ The pose comes from the LIBRARY, and this file has no FK ──
//
// Every vertex is placed by `hex_body::frame_point` over a
// `rig_world_frame3` — one tree walk per BONE, reused for every vertex
// hung on it.  ⚠⚠ **There is no forward kinematics here**, and that is
// the same rule `PARTS.md` § D1 states for the rig itself: a second
// implementation of a pose is the one a future reader would reach for,
// and it would drift from the one the sockets use.
//
// ⚠ `rig_world_frame3` exists BECAUSE of this file: `rig_world_seg3`
// answers a bone's base and tip, both ON its axis, and a limb is a
// cloud of points that are not.  It was added upstream in `hex_body`
// 0.3.0 rather than worked around here.
//
// ── ⚠ What this file does NOT do ────────────────────────────────
//
// **No colour.**  A mesh carries geometry; `PARTS.md` § D8 makes a class
// *a row of data*, and `ground_gl.loft` already proves the pattern —
// colour is a UNIFORM per draw, never a vertex attribute (`@X074`), and
// putting one on a vertex would throw away the exact classification the
// gates read.
//
// **No placement in the world.**  A part emits in its OWN frame, origin
// at the footprint centre.  Where the vehicle IS belongs to the renderer
// (plan 20 A5), which is also the only thing that knows `play_alpha`.
//
// **No booms.**  ⚠ § D7's four run DIAGONALLY, and neither `Limb` nor
// `hex_body::Rig` carries a REST ORIENTATION.  They sit strictly inside
// the rotor envelope so nothing here or in A3 changes; a `LIMB_STRUT`
// taking two endpoints and a thickness needs no rotation concept and is
// the shape to reach for when they are wanted.

use mesh3d;
use part;

// How many segments a round limb is drawn with.
//
// ⚠ TWELVE, and it is the hex's own number rather than a smoothness
// knob: dryopea's world is a hex lattice, a rotor read against it wants
// no more resolution than the ground has, and 12 divides the 6 corners
// evenly so a disc's silhouette lines up with the lattice it hovers
// over.  ⚠ It is a CONSTANT rather than a parameter because two callers
// drawing one rotor at two resolutions would make `mesh_crc` disagree
// about identical geometry.
pub const PART_ROUND_SEGMENTS: integer = 12;

// A whole turn in radians.  ⚠ **`pub` since plan 20 A5**: every angle in
// this plan is in TURNS (`PARTS.md` § D4), so a caller holding a compass
// bearing in RADIANS needs the conversion — and a second copy of tau is a
// second place a factor of two can go missing.
pub const PART_TAU: float = 6.283185307179586;

// ─── One limb at a time ─────────────────────────────────────────

// A DIRECTION through a frame — the point transform without its
// translation.  ⚠ A normal is a direction and must not be translated;
// posing one as a point puts every normal at the bone's base plus the
// normal, which still normalises to something plausible and is wrong
// everywhere the bone is not at the origin.
//
// ⚠ It is declared ABOVE its callers deliberately: loft cannot type a
// tuple destructure from a callee declared lower in the file
// ([loft#918]'s shape), and the diagnostic names the destructured
// variables rather than the ordering.
fn frame_dir(f: Frame, dx: float, dy: float, dz: float) -> (float, float, float) {
  (ox, oy, oz) = frame_point(f, 0.0, 0.0, 0.0);
  (px, py, pz) = frame_point(f, dx, dy, dz);
  (px - ox, py - oy, pz - oz)
}

// A box: eight corners, six faces, **12 triangles**.
//
// ⚠ Each face gets its OWN four vertices, so the normals are flat.  A
// box sharing eight corners would have to average its normals and every
// face would read as curved — which is the same argument
// `ground_mesh.loft` makes about not blending a flat plane.
//
// Example: @DRY-034, @DRY-062
pub fn emit_box(m: Mesh, f: Frame, l: Limb) -> integer {
  hx = l.lb_sx / 2.0 ?? 0.0;
  hy = l.lb_sy / 2.0 ?? 0.0;
  hz = l.lb_sz / 2.0 ?? 0.0;
  n = 0;
  for fc in 0..6 {
    // the face's outward axis: 0,1 = ±x   2,3 = ±y   4,5 = ±z
    ax = 0.0; ay = 0.0; az = 0.0;
    if fc == 0 { ax = 1.0; } else if fc == 1 { ax = -1.0; }
    else if fc == 2 { ay = 1.0; } else if fc == 3 { ay = -1.0; }
    else if fc == 4 { az = 1.0; } else { az = -1.0; }
    // ⚠⚠ TWO IN-PLANE AXES WHOSE CROSS PRODUCT IS THE OUTWARD ONE — and
    // the NEGATIVE faces swap them, which is what plan 20 A5 found
    // missing.  `u x v = a` is what makes the quad below wind
    // counter-clockwise seen from outside, and the three negative faces
    // used the same pair as their positive partners: `y x z` is `+x` for
    // both the `+x` and the `-x` face, so half of every box in the
    // catalogue was wound INWARDS.
    //
    // ⚠ It changed no count, no vertex and no normal — `mesh_crc` folds
    // the triangle INDICES and they were unchanged too, because the
    // quad's four corners are the same rectangle walked the other way.
    // The only instrument that can see it is a cross product against the
    // stored normal, which is `tests/20_a5`'s
    // `test_every_triangle_winds_with_its_normal`.
    //
    // ⚠ Scaling `u` by the outward SIGN does NOT fix it and looks as if
    // it does: `us` below is derived from `u`, so both flip and `u * us`
    // is unchanged.  The pair has to be SWAPPED.
    ux = 0.0; uy = 0.0; uz = 0.0;
    vx = 0.0; vy = 0.0; vz = 0.0;
    if fc == 0 { uy = 1.0; vz = 1.0; }        // +x:  y x z = +x
    else if fc == 1 { uz = 1.0; vy = 1.0; }   // -x:  z x y = -x
    else if fc == 2 { uz = 1.0; vx = 1.0; }   // +y:  z x x = +y
    else if fc == 3 { ux = 1.0; vz = 1.0; }   // -y:  x x z = -y
    else if fc == 4 { ux = 1.0; vy = 1.0; }   // +z:  x x y = +z
    else { uy = 1.0; vx = 1.0; }              // -z:  y x x = -z
    n += emit_quad(m, f, l, ax * hx, ay * hy, az * hz,
                   ux * hx + uy * hy + uz * hz, ux, uy, uz,
                   vx * hx + vy * hy + vz * hz, vx, vy, vz, ax, ay, az);
  }
  n
}

// One face of a box: a centre, two half-edge vectors, and its normal.
// ⚠ Its winding is counter-clockwise seen from OUTSIDE, which is what
// `ground_gl.loft` turns `GL_CULL_FACE` on to make a mistake loud.
fn emit_quad(m: Mesh, f: Frame, l: Limb,
             cx: float, cy: float, cz: float,
             us: float, ux: float, uy: float, uz: float,
             vs: float, vx: float, vy: float, vz: float,
             nx: float, ny: float, nz: float) -> integer {
  ox = l.lb_cx + cx; oy = l.lb_cy + cy; oz = l.lb_cz + cz;
  (ax, ay, az) = frame_point(f, ox - ux * us - vx * vs,
                                oy - uy * us - vy * vs,
                                oz - uz * us - vz * vs);
  (bx, by, bz) = frame_point(f, ox + ux * us - vx * vs,
                                oy + uy * us - vy * vs,
                                oz + uz * us - vz * vs);
  (cx2, cy2, cz2) = frame_point(f, ox + ux * us + vx * vs,
                                   oy + uy * us + vy * vs,
                                   oz + uz * us + vz * vs);
  (dx, dy, dz) = frame_point(f, ox - ux * us + vx * vs,
                                oy - uy * us + vy * vs,
                                oz - uz * us + vz * vs);
  (gx, gy, gz) = frame_dir(f, nx, ny, nz);
  i0 = add_vertex(m, vertex(vec3(ax, ay, az), vec3(gx, gy, gz), vec2(0.0, 0.0)));
  i1 = add_vertex(m, vertex(vec3(bx, by, bz), vec3(gx, gy, gz), vec2(1.0, 0.0)));
  i2 = add_vertex(m, vertex(vec3(cx2, cy2, cz2), vec3(gx, gy, gz), vec2(1.0, 1.0)));
  i3 = add_vertex(m, vertex(vec3(dx, dy, dz), vec3(gx, gy, gz), vec2(0.0, 1.0)));
  add_triangle(m, i0, i1, i2);
  add_triangle(m, i0, i2, i3);
  2
}

// A disc about the limb's own `+z`: a top fan, a bottom fan and a rim.
// **`4 * PART_ROUND_SEGMENTS` triangles.**
//
// Example: @DRY-036
pub fn emit_disc(m: Mesh, f: Frame, l: Limb) -> integer {
  emit_round(m, f, l, l.lb_sx, l.lb_sx, l.lb_sz / 2.0 ?? 0.0)
}

// A truncated cone about the limb's own `+z`, standing on its centre's
// z: bottom radius, top radius, height.  Same triangle count as a disc.
//
// Example: @DRY-037
pub fn emit_cone(m: Mesh, f: Frame, l: Limb) -> integer {
  emit_round(m, f, l, l.lb_sx, l.lb_sy, l.lb_sz / 2.0 ?? 0.0)
}

// The one round emitter: a bottom ring of radius `r0` and a top ring of
// `r1`, `h` either side of the limb's centre.  A disc is the case
// `r0 == r1`, which is why there is one of these and not two.
fn emit_round(m: Mesh, f: Frame, l: Limb, r0: float, r1: float, h: float) -> integer {
  segs = PART_ROUND_SEGMENTS;
  (bcx, bcy, bcz) = frame_point(f, l.lb_cx, l.lb_cy, l.lb_cz - h);
  (tcx, tcy, tcz) = frame_point(f, l.lb_cx, l.lb_cy, l.lb_cz + h);
  (ux, uy, uz) = frame_dir(f, 0.0, 0.0, 1.0);
  bmid = add_vertex(m, vertex(vec3(bcx, bcy, bcz),
                              vec3(0.0 - ux, 0.0 - uy, 0.0 - uz), vec2(0.5, 0.5)));
  tmid = add_vertex(m, vertex(vec3(tcx, tcy, tcz), vec3(ux, uy, uz), vec2(0.5, 0.5)));
  n = 0;
  for si in 0..segs {
    a0 = (si as float) * PART_TAU / (segs as float) ?? 0.0;
    a1 = ((si + 1) as float) * PART_TAU / (segs as float) ?? 0.0;
    n += emit_round_seg(m, f, l, r0, r1, h, a0, a1, bmid, tmid, ux, uy, uz);
  }
  n
}

// One wedge of a round limb: two rim triangles and the two fan triangles
// that close the ends.  **Four triangles per segment.**
fn emit_round_seg(m: Mesh, f: Frame, l: Limb, r0: float, r1: float, h: float,
                  a0: float, a1: float, bmid: integer, tmid: integer,
                  ux: float, uy: float, uz: float) -> integer {
  c0 = cos(a0); s0 = sin(a0);
  c1 = cos(a1); s1 = sin(a1);
  (b0x, b0y, b0z) = frame_point(f, l.lb_cx + r0 * c0, l.lb_cy + r0 * s0, l.lb_cz - h);
  (b1x, b1y, b1z) = frame_point(f, l.lb_cx + r0 * c1, l.lb_cy + r0 * s1, l.lb_cz - h);
  (t0x, t0y, t0z) = frame_point(f, l.lb_cx + r1 * c0, l.lb_cy + r1 * s0, l.lb_cz + h);
  (t1x, t1y, t1z) = frame_point(f, l.lb_cx + r1 * c1, l.lb_cy + r1 * s1, l.lb_cz + h);
  // the rim's outward normal, midway across the wedge
  (nx, ny, nz) = frame_dir(f, (c0 + c1) / 2.0 ?? 0.0, (s0 + s1) / 2.0 ?? 0.0, 0.0);
  rb0 = add_vertex(m, vertex(vec3(b0x, b0y, b0z), vec3(nx, ny, nz), vec2(0.0, 0.0)));
  rb1 = add_vertex(m, vertex(vec3(b1x, b1y, b1z), vec3(nx, ny, nz), vec2(1.0, 0.0)));
  rt1 = add_vertex(m, vertex(vec3(t1x, t1y, t1z), vec3(nx, ny, nz), vec2(1.0, 1.0)));
  rt0 = add_vertex(m, vertex(vec3(t0x, t0y, t0z), vec3(nx, ny, nz), vec2(0.0, 1.0)));
  add_triangle(m, rb0, rb1, rt1);
  add_triangle(m, rb0, rt1, rt0);
  // the two caps, each sharing its centre vertex
  fb0 = add_vertex(m, vertex(vec3(b0x, b0y, b0z),
                             vec3(0.0 - ux, 0.0 - uy, 0.0 - uz), vec2(0.0, 0.0)));
  fb1 = add_vertex(m, vertex(vec3(b1x, b1y, b1z),
                             vec3(0.0 - ux, 0.0 - uy, 0.0 - uz), vec2(1.0, 0.0)));
  add_triangle(m, bmid, fb1, fb0);
  ft0 = add_vertex(m, vertex(vec3(t0x, t0y, t0z), vec3(ux, uy, uz), vec2(0.0, 0.0)));
  ft1 = add_vertex(m, vertex(vec3(t1x, t1y, t1z), vec3(ux, uy, uz), vec2(1.0, 0.0)));
  add_triangle(m, tmid, ft0, ft1);
  4
}

// ─── The whole part ─────────────────────────────────────────────

// Emit every limb of `p`, posed at `values`.  Answers the number of
// triangles added.
//
// ⚠ ONE FRAME PER BONE, held across that bone's limbs — the hover unit
// hangs seven limbs on its chassis, and walking the rig seven times to
// place them would be seven identical answers.
//
// Example: @DRY-034, @DRY-038, @DRY-039
pub fn part_emit(m: Mesh, p: Part, values: vector<float>) -> integer {
  n = 0;
  for bi in 0..rig_count(p.pt_rig) {
    fr = rig_world_frame3(p.pt_rig, values, bi);
    n += emit_bone_limbs(m, p, fr, bi);
  }
  n
}

// Emit every limb of `p`, posed at `values`, TRANSLATED by `(dx, dy, dz)`.
//
// ⚠ **The offset is a translation and not a placement**: it moves the
// part's own frame and turns nothing, which is what a socketed child
// needs (plan 20 A4 — `pose.loft::emit_tower` puts the tower's top 6 m
// up the mast) and what plan 20 A5 will need again with a facing on top
// of it.
//
// ⚠⚠ **A SOCKET'S ROTATION IS NOT CARRIED, AND THAT IS THE NAMED GAP.**
// The exact composition is *the parent's socket FRAME applied to the
// child's posed points*, and `hex_body` publishes no way to compose two
// `Frame`s — so a child hung on a bone that TURNS would follow the
// socket's position (`socket_world` is exact) and keep its own
// orientation.  Every socket in `catalogue.loft` rides an unrotated bone
// and the tower's top is a body of revolution about that bone's own
// axis, so today the two are the same picture to the bit.  ⚠ The day a
// socket turns — a turret, a swinging arm — the fix is
// `frame_compose` UPSTREAM in `hex_body`, the same route `rig_bone3`
// and `rig_world_frame3` took, and never a rotation re-derived here
// (`PARTS.md` § D1).
//
// Example: @DRY-041
pub fn part_emit_at(m: Mesh, p: Part, values: vector<float>,
                    dx: float, dy: float, dz: float) -> integer {
  part_emit_facing(m, p, values, 0.0, dx, dy, dz)
}

// Emit every limb of `p`, posed at `values`, TURNED through `yaw` turns
// about the world's `+z` and then moved to `(dx, dy, dz)`.
//
// ⚠⚠ **TURN THEN MOVE, and the order is the whole function.**  A part
// is authored about its own origin, so the rotation has to happen while
// that origin is still at zero: translate first and a vehicle two
// hundred metres from the origin swings through a two-hundred-metre arc
// instead of turning on the spot.  Both orders compile, both draw a
// vehicle somewhere, and only one draws it where the simulation says.
//
// ⚠ **`part_emit_at` IS this at `yaw = 0.0`** — one loop, and the zero
// case is bit-identical because `cos(0)` and `sin(0)` are exactly `1.0`
// and `0.0`, so every product is an exact `+ 0.0`.
// `tests/20_a2_the_geometry.loft`'s `mesh_crc` equality is what says so
// rather than this sentence.
//
// ⚠ The yaw is in TURNS, like every angle in this plan — `PARTS.md`
// § D4's units, and the reason A2's canopy gate asserts a COORDINATE:
// degrees and turns are indistinguishable until something swings.
// A caller holding a compass BEARING converts once, through
// `entity_view.loft::facing_turns`, and never here.
//
// Example: @DRY-057, @DRY-059, @DRY-063
pub fn part_emit_facing(m: Mesh, p: Part, values: vector<float>, yaw: float,
                        dx: float, dy: float, dz: float) -> integer {
  n = 0;
  for bi in 0..rig_count(p.pt_rig) {
    fr = frame_place(rig_world_frame3(p.pt_rig, values, bi), yaw, dx, dy, dz);
    n += emit_bone_limbs(m, p, fr, bi);
  }
  n
}

// One `Frame`, moved — same basis, origin plus `(dx, dy, dz)`.
//
// ⚠ **A LITERAL rather than three assignments**, and it has to be: a
// struct RETURNED from a function is a COPY in loft ([loft#894]), so
// `f.fr_x = f.fr_x + dx` on `rig_world_frame3`'s answer is a silent
// no-op that compiles and moves nothing.  ⚠ Every one of the twelve
// fields is written out for the neighbouring reason — an omitted field
// takes its zero silently ([loft#914]), and a zeroed basis row draws a
// part flattened onto a plane.
fn frame_shift(f: Frame, dx: float, dy: float, dz: float) -> Frame {
  Frame { fr_x: f.fr_x + dx, fr_y: f.fr_y + dy, fr_z: f.fr_z + dz,
          fr_00: f.fr_00, fr_01: f.fr_01, fr_02: f.fr_02,
          fr_10: f.fr_10, fr_11: f.fr_11, fr_12: f.fr_12,
          fr_20: f.fr_20, fr_21: f.fr_21, fr_22: f.fr_22 }
}

// One `Frame`, TURNED about the world's `+z` and then moved.
//
// ⚠⚠ **THE BASIS TURNS TOO, and forgetting it is silent on this
// catalogue.**  `frame_point` is `origin + M . local`, so a placement is
// `R . (origin + M . local) + d` — which is a new origin `R . origin + d`
// AND a new basis `R . M`.  Rotate the origin alone and every limb keeps
// its authored orientation while orbiting the part's centre: a vehicle
// whose chassis stays pointing north while its skids swing round it.
// ⚠ And at REST every bone's `M` is the identity — bone 0 is unrotated
// and a joint at 0 turns nothing — so a wrong basis draws the right
// picture for the whole catalogue until a joint is off zero.  That is
// why `tests/20_a5` turns a vehicle with its CANOPY OPEN: the canopy's
// axis is LATERAL, which is the one rotation that does not commute with
// a yaw.
//
// ⚠ `M` is ROW-major with `fr_<row><col>` — read out of `hex_body`'s
// own `frame_point`, not assumed.
fn frame_place(f: Frame, yaw: float, dx: float, dy: float, dz: float) -> Frame {
  fp_a = yaw * PART_TAU;
  fp_c = cos(fp_a);
  fp_s = sin(fp_a);
  Frame {
    fr_x: fp_c * f.fr_x - fp_s * f.fr_y + dx,
    fr_y: fp_s * f.fr_x + fp_c * f.fr_y + dy,
    fr_z: f.fr_z + dz,
    fr_00: fp_c * f.fr_00 - fp_s * f.fr_10,
    fr_01: fp_c * f.fr_01 - fp_s * f.fr_11,
    fr_02: fp_c * f.fr_02 - fp_s * f.fr_12,
    fr_10: fp_s * f.fr_00 + fp_c * f.fr_10,
    fr_11: fp_s * f.fr_01 + fp_c * f.fr_11,
    fr_12: fp_s * f.fr_02 + fp_c * f.fr_12,
    fr_20: f.fr_20, fr_21: f.fr_21, fr_22: f.fr_22,
  }
}

// Every limb riding one bone, through one frame.
fn emit_bone_limbs(m: Mesh, p: Part, fr: Frame, bone: integer) -> integer {
  n = 0;
  for l in p.pt_limbs {
    if l.lb_bone == bone {
      if l.lb_kind == LIMB_BOX { n += emit_box(m, fr, l); }
      else if l.lb_kind == LIMB_DISC { n += emit_disc(m, fr, l); }
      else if l.lb_kind == LIMB_CONE { n += emit_cone(m, fr, l); }
    }
  }
  n
}

// The neutral pose — every joint at zero, which is the pose `part_size`
// measures and the one a catalogue entry is authored in.
//
// Example: @DRY-038
pub fn part_values_rest(p: Part) -> vector<float> {
  vs: vector<float> = [];
  for bi in 0..rig_count(p.pt_rig) { vs += [0.0 * (bi as float)]; }
  vs
}

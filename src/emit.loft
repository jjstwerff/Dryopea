//
// A situation, written down.  Plan 18 phase S2.
//
// Takes the ground, the markers and the runtime state a run is in, and
// writes the `.keys` file that reproduces them.  `script_run` reads it
// back, and S0's `state_diff` / `world_diff` say whether anything was
// lost — which is the whole gate: **capture → emit → replay → identical**.
//
// ── ⚠ It emits a STARTING POSITION, never a recording ───────────
//
// Nothing here writes a `tick`.  The output is the same kind of thing
// every file in `tests/scripts/` already is — an authored setup — which
// is what keeps a captured fixture out of the golden trap `plans/18`
// § Decision describes: there is nothing derived in it to go stale,
// because it says what the world IS rather than what the simulation
// did.
//
// ── ⚠ ORDER is load-bearing ─────────────────────────────────────
//
// The verbs validate each other's subjects, so the file has to build
// the world before the things that stand on it:
//
//   `flag` before `tower`   — a tower setter demands its marker
//   `crew` before `object`  — an owner may be a crew index
//   `place` before `hit` / `stand` / `banked` / `dead` — roster indices
//   `schedule` before `pending`             — it authors the list
//
// ⚠ Get one wrong and the emitted file fails to REPLAY, loudly, which
// is the good direction: the round-trip gate names the line.
//
// ── ⚠ What is deliberately not optimised ────────────────────────
//
// The ground is one `click` per painted hex, grouped by palette entry
// so the `palette` line is not repeated.  A 120-hex band is 120 lines.
// `plans/18` § Open questions 2 weighed collapsing collinear runs into
// `drag` and settled it: gate the emitter on the ROUND TRIP rather than
// on how it reads, so the readable form is an optimisation with a test
// already behind it rather than a thing to get right first.

use lattice;
use painted;
use palette;
use markers;
use height;
use damage;
use tower;
use trap;
use wallet;
use vehicle;
use helper;
use task;
use carry;
use waves;
use spawn;
use errand;
use poi;
use fixstep;

// ─── The pieces ─────────────────────────────────────────────────

fn emit_markers(mw: const MarkerWorld) -> text {
    em_out = "";
    for em_m in mw.markers {
        em_out = em_out + "flag {em_m.q} {em_m.r} "
                        + marker_kind_name(em_m.kind as integer);
        // Only a spawn marker's direction means anything, but writing
        // it for all three costs nothing and keeps one shape.
        em_out = em_out + " {em_m.direction as integer}\n";
    }
    em_out
}

// ⚠ Grouped by palette entry rather than by hex, so `palette` is
// written once per KIND instead of once per hex.
fn emit_ground(pal: vector<GroundType>, pw: const PaintedWorld) -> text {
    eg_out = "";
    eg_k = 0;
    for _ in pal {
        eg_any = false;
        for eg_h in pw.painted {
            if (eg_h.kind as integer) == eg_k {
                if !eg_any {
                    eg_out = eg_out + "palette {eg_k}\n";
                    eg_any = true;
                }
                eg_out = eg_out + "click {eg_h.q} {eg_h.r}\n";
            }
        }
        eg_k += 1;
    }
    eg_out
}

fn emit_enemies(state: const WaveState) -> text {
    ee_out = "";
    ee_i = 0;
    for ee_e in state.enemies {
        ee_out = ee_out + "place {ee_e.q} {ee_e.r} "
                        + enemy_class_name(ee_e.kind)
                        + " {ee_e.heading as integer}\n";
        // ⚠ Only what is NOT neutral, so a captured fixture reads as
        // the situation rather than as a dump: a healthy robot that is
        // free to walk needs no line but its placement.
        if ee_e.taken != 0.0 { ee_out = ee_out + "hit {ee_i} {ee_e.taken}\n"; }
        // ⚠ **SECONDS, not raw base units** (plan 26 L3) — the same
        // rule `banked` follows two lines down: `.keys` is a format a
        // person authors, and the round trip is exact because a
        // duration is a whole number of units and the door rounds.
        ee_st = clock_seconds_from_units(timer_left(ee_e.stand));
        if ee_st != 0.0 { ee_out = ee_out + "stand {ee_i} {ee_st}\n"; }
        // ⚠ **Added by plan 23 K2b, and the tripwire is what found it.**
        // K2a banked movement per enemy and `compare.loft` learned
        // `progress` while no scenario could hold a non-zero one — at
        // 1.5 hex/s the carry is exactly 0.0 after every tick.  K2b
        // shipped a scout at 2.5 and a miner at 1.0, and `18_s2`'s
        // round trip went red naming `enemies[0].progress` on the very
        // first suite run.  A tripwire that fires on the phase it was
        // written for is the cheapest kind of coverage there is.
        // ⚠ **HEXES, not raw bank units** (plan 26 L2).  `.keys` is a
        // format a person authors, and `banked 0 0.5` is half a hex
        // where `banked 0 1500000` is a number only the runtime means
        // anything by.  The round trip is exact all the same: a double
        // carries 53 bits and `BANK_WHOLE` needs 42, so
        // `bank_restore_fraction` recovers the integer this wrote.
        ee_bk = bank_fraction(ee_e.bank, BANK_WHOLE);
        if ee_bk != 0.0 { ee_out = ee_out + "banked {ee_i} {ee_bk}\n"; }
        if !ee_e.alive { ee_out = ee_out + "dead {ee_i}\n"; }
        // ⚠⚠ **The ROUTINE** (`plans/30` R7a), and it is the line
        // `compare.loft`'s `errand_same` row has been waiting for since
        // R1: nothing wrote a non-default routine, so a captured
        // situation could lose one and no gate could see it.
        //
        // ⚠⚠ **THE FLAG IS THE CONDITION AND THE ROLE IS ONE OF THE
        // COLUMNS**, and getting that round the wrong way was caught by
        // `compare.loft`'s new `errand` row within one suite run: an
        // AMBIENT robot (BACKLOG B4) is `errand: true` with `ROLE_NONE`,
        // so a line written only for a robot with a ROUTINE loses the
        // flag on every traffic scenario the corpus has — and
        // `wave_cutoff` clears exactly that flag, so a capture without
        // it is a robot the bubble has already taken walking on.
        //
        // ⚠⚠ **AND IT IS INDEPENDENT IN THE OTHER DIRECTION TOO, which
        // `plans/30` R8's own scenario found.**  `wave_cutoff` clears
        // the FLAG and leaves the ROUTINE where it is — a hauler the
        // bubble took still carries its anchors, and nothing reads them
        // because `errand_role` guards on the flag first.  A condition
        // keyed on the flag alone therefore dropped a cut-off hauler's
        // anchors on the round trip, and `compare.loft` named it:
        // *role 1 … mob 1 vs role 0 … mob 0*.
        //
        // ⚠ So the test is *is any of it not neutral* — the same rule
        // every emitter here follows, asked of BOTH facts rather than of
        // the one that looked like the subject.
        //
        // ⚠ The role and the bag are NAMED and the `slip` is SECONDS,
        // which is `banked`'s rule and `remit`'s: a `.keys` file is read
        // by a person, and the round trip is exact because the door
        // rounds.
        if ee_e.errand || !errand_same(ee_e.route, errand_new()) {
            ee_out = ee_out + "routine {ee_i} "
                            + errand_role_of(ee_e.route.role).name + " "
                            + errand_bag_name(ee_e.route.carry)
                            + " {slip_seconds(ee_e.route.slip)}"
                            + " {ee_e.route.mob}"
                            + " {ee_e.route.home.q} {ee_e.route.home.r}"
                            + " {ee_e.route.work.q} {ee_e.route.work.r}"
                            + " {ee_e.route.alt.q} {ee_e.route.alt.r} "
                            + (if ee_e.errand { "on" } else { "cut" })
                            + "\n";
        }
        ee_i += 1;
    }
    ee_out
}

// ⚠ It takes the palette only for the ORDER lines, which name their
// kind rather than indexing it — the same choice `kind` and `flag` make.
fn emit_layers(pal: vector<GroundType>, state: const WaveState) -> text {
    el_out = "";
    for el_h in state.heights.cells {
        el_out = el_out + "raise {el_h.q} {el_h.r} {el_h.metres} "
                        + rubble_source_name(el_h.source) + "\n";
    }
    for el_d in state.damage.cells {
        el_out = el_out + "damage {el_d.q} {el_d.r} {el_d.taken}\n";
    }
    // ⚠ Build orders (plan 27 C1).  Written by KIND NAME rather than by
    // palette index, like `kind` and `flag`, so a `.keys` file survives
    // a palette whose entries were reordered.
    // ⚠ A TOWER order writes the word `tower` where a ground order
    // writes its palette kind — the discriminant is spelled out rather
    // than encoded, because a `.keys` file is read by a person and
    // `order 4 0 tower 12` says what it is.
    for el_o in state.orders.cells {
        el_ow = "tower";
        if el_o.what == BUILD_GROUND {
            el_ow = (pal[el_o.kind as integer] ?? GroundType {}).name;
        }
        el_out = el_out + "order {el_o.q} {el_o.r} " + el_ow + " "
                        + "{clock_seconds_from_units(el_o.spent)}\n";
    }
    // ⚠⚠ **THE MOMENT THE RUN HAS REACHED** (`plans/30` R3).  Written
    // only when it is not the run's first instant, so the 50 captured
    // scenarios that describe a starting position emit exactly what they
    // did — and `now` in a file is a line that says *this situation is
    // part-way through something*.
    //
    // ⚠⚠ **It is load-bearing rather than tidy**: a mob's position is
    // `cycle_at(… now − slip)`, so a replay that started the clock at
    // zero would put every routine back at the start of its round while
    // leaving the bodies where they stood.  ⚠ `compare.loft`'s `now` row
    // is what said so — it fired on `tests/18_s2` the first time the
    // suite ran with a clock in it, which is sites 7 and 8 of
    // `plans/30` § Count the RE-ASSERTION SITES going live rather than
    // waiting.
    //
    // ⚠ SECONDS, because a `.keys` file is read by a person and
    // `clock_units_from_seconds` recovers the integer exactly
    // (`fixstep` § the authoring door).
    if state.now != 0 {
        el_out = el_out + "now {clock_seconds_from_units(state.now)}\n";
    }
    // ⚠ The jammer (BACKLOG C3).  Written only when the core is DARK,
    // so a captured scenario emits exactly what it did — and `jammer
    // off` in a fixture is a line that says something happened, where
    // `jammer on` in every file would say nothing at all.
    if !jammer_on(state.jammer) {
        el_out = el_out + "jammer off\n";
    }
    // ⚠ Ambient traffic (BACKLOG B4).  Written only when the road is
    // BUSY, so the 35 captured scenarios emit exactly what they did.
    if traffic_running(state.traffic) {
        el_out = el_out + "traffic {state.traffic.rate} "
                        + "{bank_fraction(state.traffic.bank, BANK_WHOLE)}\n";
    }
    for el_t in state.towers.cells {
        el_out = el_out + "tower {el_t.q} {el_t.r} {el_t.shots} "
                        + "{el_t.charge} "
                        + "{clock_seconds_from_units(timer_spent(el_t.repair))} "
                        + (if el_t.top_removed { "off" } else { "on" }) + "\n";
    }
    // ⚠ Trap plates (BACKLOG C4).  Only the cells that EXIST, which is
    // the same *what is not neutral* rule the enemies follow: a plate
    // nobody has set off has no cell, so a map full of live traps emits
    // its `flag … trap` lines and nothing else — and the 37 captured
    // scenarios, which have no traps at all, emit exactly what they did.
    for el_p in state.traps.cells {
        el_out = el_out + "trap {el_p.q} {el_p.r} "
                        + (if el_p.spent { "off" } else { "on" }) + " "
                        + "{clock_seconds_from_units(timer_spent(el_p.rearm))}\n";
    }
    if wallet_spent(state.wallet) != 0.0 {
        el_out = el_out + "spent {wallet_spent(state.wallet)}\n";
    }
    el_out
}

fn emit_movers(state: const WaveState) -> text {
    em2_out = "";

    // ⚠ `park` always, even for a vehicle that is not in the world: the
    // struct carries a hex either way, and the `player` line that
    // follows is what says whether it is present.
    em2_out = em2_out + "park {state.player.q} {state.player.r}\n";
    em2_out = em2_out + "drive {state.player.to_q} {state.player.to_r}\n";
    em2_out = em2_out + "player "
                      + (if state.player.parked { "on" } else { "off" })
                      + " {clock_seconds_from_units(timer_left(state.player.boost))}"
                      + " {clock_seconds_from_units(timer_left(state.player.cool))} "
                      + "{state.player.taken}\n";

    em2_i = 0;
    for em2_h in state.crew {
        em2_out = em2_out + "crew {em2_h.q} {em2_h.r}\n";
        em2_out = em2_out + "send {em2_i} {em2_h.to_q} {em2_h.to_r}\n";
        em2_bk  = bank_fraction(em2_h.bank, BANK_WHOLE);
        em2_out = em2_out + "member {em2_i} "
                          + (if em2_h.alive { "on" } else { "off" })
                          + " {em2_bk} {em2_h.taken} "
                          + "{clock_seconds_from_units(timer_left(em2_h.recover))}\n";
        // ⚠ Tiredness only when there is any (BACKLOG C2) — a rested
        // crew is every crew the corpus has.
        if endurance_spent(em2_h.endurance) != 0 {
            em2_out = em2_out + "tired {em2_i} "
                              + "{clock_seconds_from_units(endurance_spent(em2_h.endurance))}\n";
        }
        // ⚠ Skills only when there are any (BACKLOG C1), so the 36
        // captured scenarios emit exactly what they did — an untrained
        // crew is every crew the game has ever had.
        if em2_h.skills.build != 0 || em2_h.skills.repair != 0
           || em2_h.skills.scout != 0 {
            em2_out = em2_out + "skill {em2_i} {em2_h.skills.build} "
                              + "{em2_h.skills.repair} {em2_h.skills.scout}\n";
        }
        // ⚠ A remit only when there is one (plan 29 O3) — `TASK_ANY` is
        // *nobody has told them anything*, which is every crew member in
        // the corpus and the state a run starts in.
        //
        // ⚠⚠ **The WRITER and the READER are a PAIR** (`@D007`): this
        // writes `task_name` and `script.loft`'s `remit` reads it
        // through `task_from_name`, so a fifth remit has to be added to
        // both or a captured state silently loses it.
        if em2_h.remit != TASK_ANY {
            em2_out = em2_out + "remit {em2_i} {task_name(em2_h.remit)}\n";
        }
        em2_i += 1;
    }
    em2_out
}

fn emit_cargo(state: const WaveState) -> text {
    ec_out = "";
    for ec_o in state.cargo.items {
        ec_who = "ground";
        if ec_o.owner == CARGO_GONE { ec_who = "gone"; }
        else if ec_o.owner == BLOCKER_PLAYER { ec_who = "player"; }
        // ⚠⚠ **A MOB is the fourth kind of owner** (`plans/30` R7b), and
        // it is spelled `mob <n>` rather than as a bare number because
        // the crew are bare numbers: two owner spaces sharing one
        // spelling is `@D007`'s shape waiting to happen.
        else if ec_o.owner >= BLOCKER_MOB {
            ec_who = "mob {ec_o.owner - BLOCKER_MOB}";
        }
        else if ec_o.owner != BLOCKER_NONE {
            ec_who = "{blocker_crew_index(ec_o.owner)}";
        }
        // ⚠⚠ **Every kind `carry.loft` can hold needs a NAME here**, and
        // a BEACON did not have one until BACKLOG D2's scenario left one
        // on the ground: it was written as `wreck` and read back as one,
        // so a captured situation silently changed what was lying there.
        // ⚠ Same defect class as `cargo` and `spoil` in the `raise` verb
        // (BACKLOG C9) — writable and unnameable — and the same fix: the
        // writer and `script.loft`'s `object` verb are a PAIR, and a kind
        // added to one and not the other is invisible until a scenario
        // drops one.
        ec_kind = "wreck";
        if ec_o.kind == CARGO_TOP     { ec_kind = "top"; }
        if ec_o.kind == CARGO_BEACON  { ec_kind = "beacon"; }
        // ⚠ The FOURTH kind (`plans/30` R7b) — added here and in
        // `script.loft`'s `object` verb in the same edit, because
        // `@D007` is what happens when the writer and the reader are
        // two.
        if ec_o.kind == CARGO_SALVAGE { ec_kind = "salvage"; }
        ec_out = ec_out + "object {ec_o.q} {ec_o.r} " + ec_kind
                        + " {ec_o.subj} " + ec_who + "\n";
    }
    ec_out
}

// ⚠ **`compose` only for a wave that needs it** (plan 23 K1).  The
// `schedule` line carries every wave's SIZE, which is all a pure list
// has ever been, so all 28 captures written before composition existed
// come back byte-identical — and a wave that is not one group of
// regulars gets a `compose` line after it that replaces what the
// `schedule` line said.  Emitting one unconditionally would have been
// simpler and would have rewritten every fixture in the repo.
fn emit_schedule(state: const WaveState) -> text {
    es_out = "";
    es_n = wave_schedule_count(state.schedule);
    if es_n > 0 {
        es_out = es_out + "schedule";
        es_w = 0;
        while es_w < es_n {
            es_out = es_out + " {wave_schedule_size(state.schedule, es_w)}";
            es_w += 1;
        }
        es_out = es_out + "\n";
        es_c = 0;
        while es_c < es_n {
            if !wave_schedule_pure(state.schedule, es_c) {
                es_out = es_out + "compose {es_c}";
                es_parts = wave_schedule_parts(state.schedule, es_c);
                for es_p in es_parts {
                    es_out = es_out + " {es_p.count} "
                                    + enemy_class_name(es_p.kind as u8? ?? 0);
                }
                es_out = es_out + "\n";
            }
            es_c += 1;
        }
        es_out = es_out + "pending {state.schedule.sent} "
                        + "{clock_seconds_from_units(wave_schedule_lull(state.schedule))} "
                        + "{clock_seconds_from_units(state.schedule.delay)} "
                        + (if state.schedule.running { "on" } else { "off" })
                        + "\n";
    }
    if state.pick_cursor != 0 {
        es_out = es_out + "cursor {state.pick_cursor}\n";
    }
    es_out
}

// ⚠⚠ **THE PLACES, AND WHAT WALKS BETWEEN THEM** (`plans/30` R7a).
//
// Three lines in a fixed order, because two of them name an earlier one
// by INDEX: a `route` names a `poi`, a `mob` names a `route`.  ⚠ It is
// `emit_ground`'s rule with a new subject — the ORDER a `.keys` file is
// written in is load-bearing, not cosmetic.
//
// ⚠⚠ **A ROUTE'S `count` REBUILDS ITS OWN MOBS**, so the records are not
// written out one by one: `poi_enlist` seats `count` of them and a `mob`
// line then says what a played tick changed.  That works only because a
// record is never REMOVED — `poi_retire` sets `gone` and keeps the slot,
// exactly as `CARGO_GONE` does — so the seats a reader rebuilds are the
// seats the writer had.
//
// ⚠ Only the mobs that are NOT fresh get a line, which is the *what is
// not neutral* rule every emitter here follows: a scenario that has just
// authored its places emits none at all.
// Example: @DRY-209
fn emit_places(state: const WaveState) -> text {
    ep_out = "";
    for ep_p in state.pois.pois {
        ep_out = ep_out + "poi " + poi_kind_of(ep_p.kind).name
                        + " {ep_p.q} {ep_p.r} " + poi_state_name(ep_p.state)
                        + " {clock_seconds_from_units(ep_p.since)}\n";
    }
    for ep_rt in state.pois.routes {
        ep_out = ep_out + "route {ep_rt.poi} "
                        + errand_role_of(ep_rt.role).name + " "
                        + enemy_class_name(ep_rt.kind)
                        + " {ep_rt.count}"
                        + " {ep_rt.a.q} {ep_rt.a.r}"
                        + " {ep_rt.b.q} {ep_rt.b.r}\n";
    }
    ep_i = 0;
    for ep_m in state.pois.mobs {
        if ep_m.slip != 0 || ep_m.gone || ep_m.live {
            ep_out = ep_out + "mob {ep_i} "
                            + "{slip_seconds(ep_m.slip)} "
                            + (if ep_m.gone { "done" } else { "working" })
                            + " "
                            + (if ep_m.live { "body" } else { "rule" })
                            + "\n";
        }
        ep_i += 1;
    }
    ep_out
}

// ─── The door ───────────────────────────────────────────────────
//
// ⚠ LAST, and every helper above it — loft#918 panics the parser on a
// local bound to a call whose callee sits lower in the file.  Same scar
// `compare.loft` carries.

// Write the `.keys` file that reproduces this situation.  `origin` is a
// free-text note about where it came from.
//
// ⚠ **The origin is a comment the runner ignores**, and it is what makes
// a captured fixture explicable a year later — the difference between a
// test somebody trusts and one they delete (`plans/18` § Open
// questions 3).
pub fn emit_keys(pal: vector<GroundType>, pw: const PaintedWorld,
                 mw: const MarkerWorld, state: const WaveState,
                 origin: text) -> text {
    ek_out = "# captured: " + origin + "\n";
    ek_out = ek_out + "# ⚠ GENERATED by `emit.loft` — a starting position, not a\n";
    ek_out = ek_out + "#   recording.  Re-capture rather than hand-editing.\n";
    ek_out = ek_out + emit_markers(mw);
    ek_out = ek_out + emit_ground(pal, pw);
    ek_out = ek_out + emit_enemies(state);
    ek_out = ek_out + emit_layers(pal, state);
    ek_out = ek_out + emit_movers(state);
    ek_out = ek_out + emit_cargo(state);
    ek_out = ek_out + emit_places(state);
    ek_out = ek_out + emit_schedule(state);
    ek_out
}

// ─── Cropping a situation down (plan 18 S3) ─────────────────────
//
// A capture of a real base is the whole map, and most of it is not what
// the fixture is about.  Cropping keeps a disc around the interesting
// hex and drops the rest.
//
// ── ⚠⚠ A crop is bounded by the RULES, not by the picture ───────
//
// Dropping a hex is not neutral: the painted layer is **sea-default**,
// so a cropped-away hex does not vanish, it becomes water — which is
// not walkable, and which has no height.  So a crop can silently:
//
//   * make the flow field stop at the new edge, because sea is not a
//     surface anything stands on;
//   * UNBLOCK a tower's sight line, because `tower_sees` traces over
//     `hex_height` and sea is 0 m where a wall was 3;
//   * change a marker's MEANING, since `SPAWN_DISABLE_RADIUS` and
//     `WAVE_1_PROVOCATION_HEXES` are distances from the core.
//
// ⚠ **And the core is the worst of them.**  Every enemy routes to it,
// so a crop that drops it empties the flow field and every enemy falls
// back to the DESIRE field — a different steering mode entirely
// (`ENEMY_MOVEMENT.md` § Two modes).  The fixture would reproduce
// nothing while looking perfectly well-formed.
//
// ── ⚠ The refusals are NECESSARY and not SUFFICIENT ─────────────
//
// `crop_fault` refuses the crops that certainly break.  It cannot
// certify the rest: whether a particular crop preserved a particular
// behaviour is a question about that behaviour, and the only honest
// answer is to run both and compare — which is what
// `tests/18_s3_the_crop.loft` § A tight crop changes the answer shows
// happening.  Recorded here so nobody reads a clean `crop_fault` as
// proof.

// How far out a crop must reach whatever else it does.
//
// ⚠ **DERIVED from the longest reach anything inside has OUT of the
// crop**, which is a tower's: `TOWER_RANGE_HEXES` is 15, and its sight
// line reads `hex_height` at every hex along the way.  Crop tighter and
// terrain that decided whether a shot landed is replaced by sea.
pub const CROP_MIN_RADIUS_HEXES: integer = TOWER_RANGE_HEXES;

// Why this crop must be refused — "" when it may go ahead.
pub fn crop_fault(core: const Hex, centre: const Hex,
                  radius: integer) -> text {
    if radius < CROP_MIN_RADIUS_HEXES {
        return "radius {radius} is under the {CROP_MIN_RADIUS_HEXES} a tower's sight line needs";
    }
    cf_d = lat_distance(centre, core);
    if cf_d > radius {
        return "the core at ({core.q}, {core.r}) is {cf_d} hexes out, outside a radius of {radius} — every enemy routes to it";
    }
    ""
}

fn in_crop(centre: const Hex, radius: integer, q: integer, r: integer) -> boolean {
    lat_distance(centre, Hex { q: q, r: r }) <= radius
}

// Everything inside the disc, as a fresh painted world.
fn crop_painted(pw: const PaintedWorld, centre: const Hex,
                radius: integer) -> PaintedWorld {
    cp_out = painted_empty();
    for cp_h in pw.painted {
        if in_crop(centre, radius, cp_h.q, cp_h.r) {
            paint(cp_out, cp_h.q, cp_h.r, cp_h.kind);
        }
    }
    cp_out
}

fn crop_markers(mw: const MarkerWorld, centre: const Hex,
                radius: integer) -> MarkerWorld {
    cm_out = marker_empty();
    for cm_m in mw.markers {
        if in_crop(centre, radius, cm_m.q, cm_m.r) {
            place_marker(cm_out, cm_m.q, cm_m.r, cm_m.kind, cm_m.direction);
        }
    }
    cm_out
}

// ⚠ **The per-hex layers and the ENEMIES are cropped; the crew, the
// cargo and the player are NOT.**  An index is an identity here —
// `cargo.subj` points into the crew roster — so dropping a crew member
// would leave a wreck pointing at nobody.  They are few and they are
// the interesting part of a situation anyway.
fn crop_state(state: const WaveState, centre: const Hex,
              radius: integer) -> WaveState {
    cs_out = wave_state_empty();

    for cs_e in state.enemies {
        if in_crop(centre, radius, cs_e.q, cs_e.r) {
            // ⚠ **Every field, spelled out** — a literal that omits one
            // takes its default SILENTLY (loft#914), so a crop that
            // forgot `progress` would quietly reset a scout's carry and
            // move the very clock a cropped fixture exists to preserve.
            cs_out.enemies += [Enemy { q: cs_e.q, r: cs_e.r, kind: cs_e.kind,
                                       heading: cs_e.heading, alive: cs_e.alive,
                                       taken: cs_e.taken, stand: cs_e.stand,
                                       bank: cs_e.bank, errand: cs_e.errand,
                                       route: cs_e.route }];
        }
    }
    cs_out.pick_cursor = state.pick_cursor;

    for cs_h in state.heights.cells {
        if in_crop(centre, radius, cs_h.q, cs_h.r) {
            height_raise(cs_out.heights, cs_h.q, cs_h.r, cs_h.metres, cs_h.source);
        }
    }
    for cs_d in state.damage.cells {
        if in_crop(centre, radius, cs_d.q, cs_d.r) {
            damage_apply(cs_out.damage, cs_d.q, cs_d.r, cs_d.taken);
        }
    }
    // ⚠ Build orders crop like every other layer — an order outside the
    // radius is ground the crop does not contain, so keeping it would
    // emit a line about a hex the fixture no longer has.
    for cs_o in state.orders.cells {
        if in_crop(centre, radius, cs_o.q, cs_o.r) {
            cs_out.orders.cells[cs_o.q, cs_o.r] =
                BuildOrder { q: cs_o.q, r: cs_o.r, what: cs_o.what,
                             kind: cs_o.kind, spent: cs_o.spent };
        }
    }
    // ⚠ A tower's cell goes with its MARKER, by the same predicate — a
    // cell kept without its marker would be unemittable, and a marker
    // kept without its cell would replay as a fresh tower.
    for cs_t in state.towers.cells {
        if in_crop(centre, radius, cs_t.q, cs_t.r) {
            tower_bank(cs_out.towers, cs_t.q, cs_t.r, 0.0);
            cs_tc = cs_out.towers.cells[cs_t.q, cs_t.r];
            if cs_tc != null {
                cs_tc.shots       = cs_t.shots;
                cs_tc.charge      = cs_t.charge;
                cs_tc.repair      = cs_t.repair;
                cs_tc.top_removed = cs_t.top_removed;
            }
        }
    }

    // ⚠ **A plate's cell goes with its MARKER**, by the tower's argument
    // and for the tower's reason (BACKLOG C4): `crop_markers` keeps a
    // trap marker inside the radius, so a cell dropped here would
    // replay as a FRESH plate — a fixture cropped around a base that
    // had already spent its trap would come back with a live one.
    for cs_p in state.traps.cells {
        if in_crop(centre, radius, cs_p.q, cs_p.r) {
            cs_out.traps.cells[cs_p.q, cs_p.r] =
                TrapCharge { q: cs_p.q, r: cs_p.r, spent: cs_p.spent,
                             rearm: cs_p.rearm };
        }
    }

    // ⚠ The run-wide switches are not per-hex and so cannot be cropped
    // at all — they are carried whole, the way the wallet and the
    // schedule are.
    cs_out.jammer   = state.jammer;
    cs_out.traffic  = state.traffic;
    cs_out.wallet   = state.wallet;
    cs_out.player   = state.player;
    cs_out.crew     = state.crew;
    cs_out.cargo    = state.cargo;
    cs_out.schedule = state.schedule;
    // ⚠⚠ **The CLOCK is run-wide too** (`plans/30` R3), and it is
    // load-bearing rather than tidy: a mob's position is
    // `cycle_at(… now − slip)`, so a crop that reset the moment to zero
    // would put every routine in the cropped fixture back at the start
    // of its round while leaving the bodies where they stood.  ⚠ Site 7
    // of `plans/30` § Count the RE-ASSERTION SITES, and
    // `compare.loft`'s `now` row is what would say so.
    cs_out.now      = state.now;
    // ⚠⚠ **THE PLACES ARE RUN-WIDE AND CARRIED WHOLE** (`plans/30` R6b).
    // A POI is a scenario-scale object, not a per-hex layer: cropping one
    // OUT would leave its population running a round anchored on a place
    // the cropped fixture has not got, which is `@FR-E-Poi-Owns` broken
    // by a tool rather than by the engine.  ⚠ Site 7 of `plans/30`
    // § Count the RE-ASSERTION SITES again, and `compare.loft`'s `pois`
    // row is what would say so.
    cs_out.pois     = state.pois;
    cs_out
}

// Write down only what is within `radius` of `centre`.  Answers "" and
// writes nothing when `crop_fault` refuses.
//
// ⚠ **Refusing by writing nothing** rather than by emitting a smaller
// file: a crop that broke the situation must not produce a fixture that
// looks fine and reproduces something else.  The caller asks
// `crop_fault` for the reason.
pub fn crop_keys(pal: vector<GroundType>, pw: const PaintedWorld,
                 mw: const MarkerWorld, state: const WaveState,
                 core: const Hex, centre: const Hex, radius: integer,
                 origin: text) -> text {
    if crop_fault(core, centre, radius) != "" { return ""; }

    ck_pw = crop_painted(pw, centre, radius);
    ck_mw = crop_markers(mw, centre, radius);
    ck_st = crop_state(state, centre, radius);
    ck_t  = emit_keys(pal, ck_pw, ck_mw, ck_st,
                      origin + " (cropped r{radius} at ({centre.q}, {centre.r}))");
    ck_t
}

//
// Occupancy — who is standing where, this tick.
//
// Plan 11 phase F5c.  `docs/ENEMY_MOVEMENT.md` § Sealing the perimeter:
// *"An enemy whose target hex is taken by a companion does not wait
// behind it… Companions block movement; they are never targets."*
// This file is the first half of that sentence and nothing else, so
// the mover and the `enemies distinct` assertion that measures it read
// ONE implementation — the same reason `passable.loft` exists.
//
// ── It is a COUNT per hex, not a boolean ────────────────────────
//
// Enemies arrive stacked: `spawn_wave` emits a whole wave at one
// marker hex, so N enemies share a hex before any of them has moved.
// A boolean set would say "occupied", one of them would step off, and
// the hex would read free while N-1 still stand on it.  So a cell
// counts its occupants, `occupancy_leave` decrements and the hex is
// free only at zero.
//
// The count never goes negative: `occupancy_leave` on a hex nobody
// holds is a no-op rather than a -1, because a single-enemy caller
// legitimately ticks against an EMPTY occupancy ("this enemy is
// alone") and a negative count would then read as "free" for the rest
// of the tick.
//
// ── What it is NOT ──────────────────────────────────────────────
//
// It is not passability (`passable.loft` — a property of the GROUND,
// per class) and it is not a target list.  A hex can be perfectly
// walkable and still refused this tick because somebody is on it;
// next tick they have moved and it is free.  Nothing in the game ever
// attacks an occupied hex *because* it is occupied.


// One hex and how many enemies stand on it.
pub struct OccupiedHex {
    q: integer,
    r: integer,
    n: integer,
}

// Who is standing where.  A hash must be a struct field (the same
// loft idiom `PaintedWorld` follows), and wrapping it also gives the
// count rule one door rather than every caller doing its own
// null-check arithmetic.
pub struct Occupancy {
    cells: hash<OccupiedHex[q, r]>,
}

// Factory: nobody anywhere.  What a caller ticking a lone enemy
// passes — and it means "this enemy is alone", not "skip the check".
pub fn occupancy_empty() -> Occupancy {
    Occupancy { cells: [] }
}

// Somebody stepped onto (q, r).
pub fn occupancy_enter(o: Occupancy, q: integer, r: integer) {
    oe_c = o.cells[q, r];
    if oe_c == null {
        o.cells[q, r] = OccupiedHex { q: q, r: r, n: 1 };
    } else {
        oe_c.n = oe_c.n + 1;
    }
}

// Somebody stepped off (q, r).  A no-op on a hex nobody holds — see
// § It is a COUNT per hex.
pub fn occupancy_leave(o: Occupancy, q: integer, r: integer) {
    ol_c = o.cells[q, r];
    if ol_c == null { return; }
    if ol_c.n > 0 { ol_c.n = ol_c.n - 1; }
}

// Is anybody standing on (q, r)?
pub fn occupancy_taken(o: const Occupancy, q: integer, r: integer) -> boolean {
    ot_c = o.cells[q, r];
    if ot_c == null { return false; }
    ot_c.n > 0
}

// How many enemies are on (q, r)?
pub fn occupancy_count(o: const Occupancy, q: integer, r: integer) -> integer {
    oc_c = o.cells[q, r];
    if oc_c == null { return 0; }
    oc_c.n
}

// How many distinct hexes are held.
//
// ⚠ Counts hash entries, which include hexes whose count has fallen
// back to zero, so it is only equal to "hexes with somebody on them"
// on an occupancy nobody has left.  `occupancy_stacked` is what the
// assertions ask; this is for a caller that wants the size.
pub fn occupancy_cells(o: const Occupancy) -> integer {
    len(o.cells)
}

// ─── The other map: who on the PLAYER's side is standing where ──
//
// Plan 14 phase H3.  The same question as `Occupancy` and a different
// answer, so it is a second map rather than a second count in the
// first one: an enemy that finds a COMPANION in its way steps beside
// it and never attacks it, and one that finds a VEHICLE in its way
// with no route round attacks that vehicle (`DESIGN.md` § 8's blocker
// exception).  One structure holding both would have to be read with
// a "but which kind?" at every call site.
//
// ⚠ **It answers WHO, not "is anybody there".**  Plan 13 V5 asked
// `vehicle_on(player, …)` because there was exactly one thing it could
// be; with a roster the damage has to land on the right vehicle, so
// the map stores an id and `blocker_at` answers it.
//
// ⚠ **Ids, not indices**: `BLOCKER_PLAYER` is 0 and helper `i` is
// `BLOCKER_CREW + i`, so `BLOCKER_NONE` can be -1 and an absent cell
// answers it.  Zero is a real blocker here, which is why "nobody" is
// negative rather than the neutral value the ledgers use.
//
// ⚠ **A hex holds ONE of them.**  Two vehicles cannot share a hex in
// any scenario the game can author, and if a future one lets them, the
// later `blocker_set` wins — deliberately the same one-per-hex
// simplification `height.loft` makes for a pile's source.
pub const BLOCKER_NONE:   integer = -1;
pub const BLOCKER_PLAYER: integer = 0;
pub const BLOCKER_CREW:   integer = 1;

pub struct BlockerHex {
    q:  integer,
    r:  integer,
    id: integer,
}

pub struct BlockerMap {
    cells: hash<BlockerHex[q, r]>,
}

// Factory: nobody on the player's side is anywhere.  What a caller
// ticking an enemy with no vehicles in the run passes.
pub fn blocker_empty() -> BlockerMap {
    BlockerMap { cells: [] }
}

// Put a blocker on (q, r).
pub fn blocker_set(b: BlockerMap, q: integer, r: integer, id: integer) {
    bs_c = b.cells[q, r];
    if bs_c == null {
        b.cells[q, r] = BlockerHex { q: q, r: r, id: id };
    } else {
        bs_c.id = id;
    }
}

// Who is standing on (q, r)?  `BLOCKER_NONE` when nobody is.
pub fn blocker_at(b: const BlockerMap, q: integer, r: integer) -> integer {
    ba_c = b.cells[q, r];
    if ba_c == null { return BLOCKER_NONE; }
    ba_c.id
}

// Is anybody on the player's side standing on (q, r)?
pub fn blocker_taken(b: const BlockerMap, q: integer, r: integer) -> boolean {
    blocker_at(b, q, r) != BLOCKER_NONE
}

// How many blockers are in the world.
pub fn blocker_count(b: const BlockerMap) -> integer {
    len(b.cells)
}

// The crew index an id names, or -1 when it is not a helper.
//
// A named door rather than a `- 1` at every reader, because an id and
// an index differing by one is exactly the kind of arithmetic that
// eventually damages the wrong crew member.
pub fn blocker_crew_index(id: integer) -> integer {
    if id < BLOCKER_CREW { return -1; }
    id - BLOCKER_CREW
}

// The first hex holding more than one enemy, or null-ish (n == 0) when
// nobody is stacked.
//
// The hex is the return value rather than a boolean, because every
// caller that reports a fault wants to name it: "two enemies are on
// the same hex" costs a debugging session that "2 enemies are stacked
// on (4, 0)" does not — the same argument `occupancy_fault` makes.
pub fn occupancy_stacked(o: const Occupancy) -> OccupiedHex {
    for os_c in o.cells {
        if os_c.n > 1 { return OccupiedHex { q: os_c.q, r: os_c.r, n: os_c.n }; }
    }
    OccupiedHex { q: 0, r: 0, n: 0 }
}

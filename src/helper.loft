//
// The NPC crew — and the first mover in dryopea whose speed does not
// fit the tick.
//
// Plan 14 phase H1.  `docs/DESIGN.md` § 9: *"NPC vehicles that do the
// cooperative's actual work"*, on the **same chassis as the player**.
// So a helper drives the way the player drives — `vehicle.loft::
// drive_along`, one implementation — and differs in exactly two
// numbers: how fast, and how much it can take.
//
// ── ⚠ Why this one needed machinery nothing else did ────────────
//
// A tick is `1 / 1.5` s because that is what an enemy takes to cross
// one hex, and every mover built so far has covered a whole number of
// hexes in it: an enemy 1, the player 2, a boosting player 4.  A
// helper is **2.5 hex/s — 1.667 hexes a tick** — and there is no way
// to round that.
//
// So a helper BANKS its progress: each tick it adds `speed × elapsed`
// to a running total and steps out the whole hexes, keeping the
// remainder.  That was the pattern `tower.loft` uses for a fire
// interval and plan 13 V4 uses for a boost timer, arriving a third
// time — and it was deliberately LOCAL to the mover that needed it.
//
// ⚠ **Plan 26 L2 made it global on purpose, and that is the reversal
// worth recording**: the count of hand-rolled copies reached seven,
// one of them (`vehicle.loft`) omitted the carry entirely, and no test
// in the corpus could see it (`@D003`, `@M030`).  The arithmetic now
// lives once, in `tick_bank.loft`, and this function is a door onto
// it.
//
// ⚠ **This is NOT "the tick becomes a timestep".**  `CLAUDE.md`
// § Cost warns that decoupling speed from the tick shrinks the
// per-tick budget and re-opens plan 11 F8's incremental rebuild.  That
// warning is about choosing a SHORTER tick; a helper needs fractional
// hexes at today's tick, so the budget is untouched and F8's trigger
// does not fire.  Measured in `plans/14` § H0.
//
// ── ⚠ The epsilon is worth 6.7% of a helper's speed ─────────────
//
// Banking `2.5 × (1/1.5)` and flooring, the carry lands on
// 0.99999999999999956 where it should be 1.0 — so a whole hex is
// deferred, and the residue DEGRADES every cycle, so the helper falls
// further behind the longer it runs.  Measured over nine ticks: 14
// hexes instead of 15, which is **2.333 hex/s instead of 2.500**.
//
// It is `TOWER_CHARGE_EPSILON`'s trap for the third time and its most
// expensive appearance yet — the tower lost a third of its shots
// visibly and a boost ran one tick long, while this loses 7% of a
// speed silently and forever.  The clean **1, 2, 2** repeating pattern
// is what says it is right; "it arrived" would never have told them
// apart.

use lattice;
use palette;
use painted;
use height;
use passable;
use vehicle;
use tick_clock;
use tick_bank;
use tick_timer;

// ─── The numbers ────────────────────────────────────────────────
//
// `examples/numbers.json` § helper, restated here because nothing
// loads that file yet — the same note every other engine file carries.

// numbers.json § helper.speed.  ⚠ 1.667 hexes a tick, and the reason
// this file has an accumulator at all.
pub const HELPER_SPEED_HEX_PER_SECOND: float = 2.5;

// numbers.json § helper.hp — half the player's 100.
pub const HELPER_HP: float = 50.0;

// numbers.json § helper.roster_start / roster_cap.
pub const HELPER_ROSTER_START: integer = 2;
pub const HELPER_ROSTER_CAP:   integer = 6;

// ⚠⚠ **`HELPER_PROGRESS_EPSILON` IS GONE (plan 26 L2).**  Banked
// progress was a float count of HEXES and a whole hex was released by
// `(progress + 1e-9) as integer`; it is an exact integer bank now
// (`tick_bank.loft`), so there is nothing left to nudge.  ⚠ The guard
// was real at 2.5 hex/s — without it the carry sat a hair under a
// whole hex on every third tick and that hex was deferred for ever,
// 2.333 hex/s against a documented 2.500 — and what removes it is the
// arithmetic being able to say `10 000 000 / 3 000 000`, not the
// problem having gone away.  `spawn.loft` § ENEMY_PROGRESS_EPSILON IS
// GONE carries the measurement (`@M017`).

// numbers.json § helper.recovery_time_after_retrieval — the time a
// retrieved crew member spends at the core before rejoining.
//
// ⚠ **The UNITS are the definition and the seconds are DERIVED**, which
// is the shape `TICK_STEP_UNITS` / `TICK_SECONDS` set at plan 26 L1: a
// duration is an exact integer count of the clock's base unit, and a
// float second beside it is a second definition that can disagree.
// 60 s is exactly 180 000 000 thirds of a microsecond.
//
// ⚠ **A LITERAL, and it has to be**: a const whose initialiser CASTS
// another computed const needs a temporary, and loft refuses one in a
// const ("the slot it names belongs to this declaration").  So the
// count is written out, the way `TICK_STEP_UNITS` is — and
// `tests/26_l3_the_timers.loft` § Every duration is a whole number of
// base units is what stops the literal drifting from the seconds it
// claims to be.
pub const HELPER_RECOVERY_UNITS: integer = 180000000;   // 60 s
pub const HELPER_RECOVERY_SECONDS: float = (HELPER_RECOVERY_UNITS as float)
                                           / (CLOCK_UNITS_PER_SECOND as float);

// ⚠⚠ **`HELPER_TIMER_EPSILON` IS GONE (plan 26 L3), and it was doing
// REAL WORK right up to the moment it was deleted.**  60.0 s over a
// `1 / 1.5` s tick is exactly 90 ticks, so counting down through floats
// left a hair of positive residue after the ninetieth and gave a
// ninety-FIRST — plan 15 C0's *"the trap fires ONLY where the timer
// divides the tick exactly, which is the case that looks safest"*.
//
// ⚠ **Measured at seven tick lengths before it was removed, this guard
// held the recovery at its true length at every one of them** (90 /
// 120 / 180 / 300 / 600 / 1200 / 1800 ticks), where the two timers that
// never got a guard did not — `@M033`, `tests/26_l3_the_timers.loft`.
// What replaces it is `tick_timer.loft`: the recovery is an integer
// count of base units and 180 000 000 / 2 000 000 is 90 with nothing
// left over.

// ─── The helper ─────────────────────────────────────────────────

// ⚠ Zero is the neutral value for all three of `bank`, `taken` and
// `alive`… except `alive`, which a `Helper { }` literal would default
// to FALSE.  That is deliberate and it is the opposite of `Enemy`'s
// choice: an enemy roster is built by a spawner, and a helper roster
// is built one `helper_add` at a time, so the factory is the only door
// and there is no partial literal to protect.
pub struct Helper {
    q:       integer,
    r:       integer,
    to_q:    integer,
    to_r:    integer,
    alive:   boolean,
    bank:    Bank,      // banked ground, always under a whole hex
    taken:   float,     // damage ABSORBED, never HP remaining
    recover: Timer,     // the recovery clock; unarmed when not in it
}

// Factory: a helper standing at (q, r) with nothing banked.
pub fn helper_new(q: integer, r: integer) -> Helper {
    Helper { q: q, r: r, to_q: q, to_r: r, alive: true,
             bank: bank_new(), taken: 0.0, recover: timer_new() }
}

// Point a helper at a hex.  It drives there over the next ticks.
pub fn helper_drive(h: Helper, q: integer, r: integer) {
    h.to_q = q;
    h.to_r = r;
}

pub fn helper_arrived(h: const Helper) -> boolean {
    h.q == h.to_q && h.r == h.to_r
}

// What this helper has left, in HP.
pub fn helper_hp(h: const Helper) -> float {
    max(HELPER_HP - h.taken, 0.0)
}

// Land damage on a helper.
//
// ⚠ **It does not wreck it.**  The wreck is the tick's, at the end,
// beside the deaths and the breaks — the rule `enemy_hurt`,
// `damage_apply` and `vehicle_hurt` all keep, so a script and the
// simulation cannot drift about when a crew member is lost.
pub fn helper_hurt(h: Helper, hp: float) {
    h.taken = max(h.taken + hp, 0.0);
}

// ─── Wrecked (plan 14 H3) ───────────────────────────────────────

// Put a helper out of the run where it stands.
//
// ⚠ **`alive` IS the wreck**, and there is no second flag: `DESIGN.md`
// § 9 says the vehicle wrecks at its hex and the helper inside is
// *"downed but alive"*, so the crew member is not gone — the thing that
// moves and works is.  Every verb that acts already asks `alive`
// (`helper_tick`, `helper_salvage`) and `wave_blockers` asks it too, so
// a wreck stops driving, stops clearing and stops blocking at once.
//
// ⚠ **And nothing puts it back.**  § 9: *"No automatic respawn —
// retrieval is the only way back"*, which is the ONE rule where a
// helper is not the player's chassis doing the player's job
// (`vehicle_respawn` is the contrast, three lines away in the tick).
// Retrieval is H4 and it is blocked on a carry model.
pub fn helper_wreck(h: Helper) {
    h.alive = false;
}

// Is this crew member down?
//
// ⚠ **True during RECOVERY too**, and that is deliberate: a crew member
// at the core with 40 s left on the clock is not driving, not clearing,
// not earning and not blocking, which is every consequence `alive`
// carries.  `helper_recovering` is what tells the two apart, for the
// one caller that cares — a measurement asking whether the crew is
// whole.
pub fn helper_wrecked(h: const Helper) -> boolean {
    !h.alive
}

// ─── Retrieved, and coming back (plan 15 C2) ────────────────────

// Is this crew member in recovery at the core?
pub fn helper_recovering(h: const Helper) -> boolean {
    !h.alive && timer_running(h.recover)
}

// Is this crew member still lying on the battlefield?
//
// ⚠ The distinction `helper_wrecked` cannot make, and the one a player
// acts on: a LOST helper needs fetching and a recovering one needs
// nothing but time.
pub fn helper_lost(h: const Helper) -> boolean {
    !h.alive && !timer_running(h.recover)
}

// Start the recovery clock, at the core.  Answers whether it started.
//
// `DESIGN.md` § 9: *"Deliver to the core → recovery state for ~60 s →
// helper rejoins the roster."*
//
// ⚠ **It moves the helper to the core**, because somebody carried it
// there: leaving the record on the hex it died on would make "where is
// helper 2" answer the battlefield while the crew member is at the
// core, and a stale position is a lie that surfaces only once something
// reads it (the same rule `cargo_follow` keeps for a carried object).
//
// ⚠ A crew member who is already up cannot start recovering — the
// guard is here rather than at the call site so a second delivery path
// could not skip it.
pub fn helper_begin_recovery(h: Helper, core: const Hex) -> boolean {
    if h.alive { return false; }
    if timer_running(h.recover) { return false; }

    timer_arm(h.recover, HELPER_RECOVERY_UNITS);
    h.q       = core.q;
    h.r       = core.r;
    h.to_q    = core.q;
    h.to_r    = core.r;
    true
}

// Spend one tick of recovery.  Answers whether the helper rejoined the
// roster on this tick.
//
// ⚠ **The epsilon used to be the whole function** — 60.0 s is exactly
// 90 ticks and a bare `> 0.0` gave 91, which no assertion that the crew
// member came back can see.  Since plan 26 L3 the clock is an integer
// count of base units, so the ninetieth call lands exactly on the
// boundary and there is nothing to nudge.
//
// ⚠ It rejoins WHOLE: the damage that downed it is cleared and the
// banked progress reset, because what came back is a repaired vehicle
// rather than the wreck that was carried in.  Anything less would make
// a retrieved helper wreck again to the next stray attacker, and the
// roster would decay across a run no matter how well it was played.
pub fn helper_recover_tick(h: Helper, elapsed: integer, core: const Hex) -> boolean {
    if !helper_recovering(h) { return false; }
    if !timer_spend(h.recover, elapsed) { return false; }

    h.alive    = true;
    h.taken    = 0.0;
    bank_reset(h.bank);
    h.q        = core.q;
    h.r        = core.r;
    h.to_q     = core.q;
    h.to_r     = core.r;
    true
}

// Bank `elapsed` base time units of movement and answer the whole
// hexes it releases.
//
// ⚠ It keeps the REMAINDER rather than discarding it, which is what
// makes the average exact rather than merely close: over any three
// ticks a helper releases exactly five hexes.  ⚠ Since plan 26 L2 that
// is exact by construction rather than by an epsilon — five thirds of
// a tick is `10 000 000 / 3 000 000` and the fifth hex needs nobody's
// permission.
//
// ⚠ **The speed is a LOOKUP here where `enemy_bank` takes an
// argument** (`@X060`), and that asymmetry survived L2: the crew has
// one class and `DESIGN.md`'s *a damaged robot moves slower* is a
// property of the ENEMY roster.  The day a wrecked helper limps, this
// grows the argument and not a second door.
pub fn helper_bank(h: Helper, elapsed: integer) -> integer {
    bank_gain(h.bank, bank_rate(HELPER_SPEED_HEX_PER_SECOND), elapsed, BANK_WHOLE)
}

// Advance a helper one tick towards where it is pointed.
//
// The same chassis as the player — `vehicle.loft::drive_along`, which
// walks the straight line and stops at the first step the ground
// refuses.  A helper hovers like the player does, so it climbs the
// same `CLIMB_VEHICLE`.
//
// ⚠ **It banks even when it cannot move.**  A helper parked against a
// wall goes on accumulating, so the tick it is finally pointed
// somewhere reachable it leaves with whatever it had — which is what
// keeps the average a RATE rather than a function of how often it was
// blocked.
pub fn helper_tick(h: Helper, pal: vector<GroundType>, pw: PaintedWorld,
                   hl: const HeightLayer, elapsed: integer) {
    if !h.alive { return; }

    ht_hexes = helper_bank(h, elapsed);
    if ht_hexes <= 0 { return; }

    ht_at = drive_along(pal, pw, hl,
                        Hex { q: h.q, r: h.r }, Hex { q: h.to_q, r: h.to_r },
                        ht_hexes, CLIMB_VEHICLE);
    h.q = ht_at.q;
    h.r = ht_at.r;
}

// ─── The work (plan 14 H2) ──────────────────────────────────────

// Clear rubble within reach for one tick, deepest heap first — the
// player's rule, on the player's chassis, done by an NPC.
//
// ⚠ **This phase adds no mechanic whatsoever**, and that is the point
// of putting it first: `vehicle_salvage` (plan 13 V2) already decides
// what gets cleared, how fast, how far it reaches and what a bite is
// worth, so a helper doing it exercises the ROSTER and nothing else.
// A phase that invented a helper-only job would have gated the job.
//
// ⚠ **A roster is N of the same thing.**  Two helpers beside one heap
// take two bites out of it in a tick, because each asks the layer as
// it stands when its turn comes — so a crew of N clears N times as
// fast until the heap runs out, and the last bite is short rather than
// negative (`salvage_at` takes `min(bite, depth)`).  That is what makes
// "twice as fast" an exact statement and not an approximate one.
//
// ⚠ A wrecked helper clears nothing — the same sentence
// `vehicle_salvage` writes as `if !v.parked`, and the reason H3 can
// down a helper without touching this function.
pub fn helper_salvage(h: const Helper, hl: HeightLayer,
                      tick_seconds: float) -> Salvage {
    if !h.alive { return Salvage { metres: 0.0, source: -1 }; }

    // ⚠ Bound to a local, per `vehicle_salvage` — loft#880.
    hs_got = salvage_at(Hex { q: h.q, r: h.r }, hl, tick_seconds);
    hs_got
}

//
// Software rasterizer for golden-image validation.
//
// Renders a (Camera, PaintedWorld) into a graphics::Canvas at a
// chosen pixels-per-metre — headless, no GL context required.
// Tests save the resulting Canvas with `save_png` and compare
// byte-for-byte against a stored golden PNG in tests/golden/.
//
// Plan 01 phase E1 — golden-image validation.

use graphics;
use lattice;
use camera;
use painted;

// ── Palette colours (mirrors examples/palette.json) ──────────────
//
// Inlined here rather than loaded from JSON so the renderer's
// output is deterministic across test runs.  Keep in sync with
// palette.json by hand for now; a later phase can load palette.json
// directly once a JSON-to-runtime-palette path exists.

// ⚠ Twelve, and the twelfth is not paintable.  `rubble` (plan 12 B1)
// is the first ground type a PLAYER never selects — it is deposited by
// the runtime rubble layer and reached through `passable.loft`, not
// through the picker — so `bindings.loft` deliberately stops its
// palette hotkeys at eleven.  It still needs a colour here: this table
// is what `measure.loft` buckets a frame with, and drawing the rubble
// layer will read it the day the runtime has a view of its own.
pub const PALETTE_SIZE: integer = 12;

pub fn palette_color(kind: u8) -> integer {
    pc_k = kind as integer;
    if pc_k == 0  { rgb(0x0a, 0x2c, 0x5e) }                   // sea
    else if pc_k == 1  { rgb(0x2a, 0x7e, 0xc0) }              // water
    else if pc_k == 2  { rgb(0x6f, 0xbc, 0xe8) }              // rapids
    else if pc_k == 3  { rgb(0xe8, 0xf4, 0xfc) }              // waterfall
    else if pc_k == 4  { rgb(0xf0, 0xd8, 0x60) }              // sand
    else if pc_k == 5  { rgb(0x4c, 0xaf, 0x50) }              // grass
    else if pc_k == 6  { rgb(0x8b, 0x62, 0x40) }              // hill
    else if pc_k == 7  { rgb(0xb0, 0xb0, 0xb0) }              // rock
    else if pc_k == 8  { rgb(0x55, 0x55, 0x55) }              // steep_rock
    else if pc_k == 9  { rgb(0xd0, 0x48, 0x48) }              // wall (placeholder red)
    else if pc_k == 10 { rgb(0x7a, 0x18, 0x18) }              // wall_high (placeholder dark red)
    else if pc_k == 11 { rgb(0x88, 0x78, 0xa8) }              // rubble (placeholder violet-grey)
    else { rgb(0xff, 0x00, 0xff) }                            // unknown → magenta
}

pub fn sea_color() -> integer { palette_color(0 as u8) }

// ── Canvas / world projection ────────────────────────────────────

// Inverse of world_to_canvas: pixel (sx, sy) on a canvas
// of size (cw, ch) at scale `ppm`, centred on the camera's
// hex, maps back to a world-space (x, y).  Combined with
// lat_from_metres this is the screen→hex mouse-pick path.
pub fn screen_to_world(
    cam: EditorCamera,
    sx:  integer,
    sy:  integer,
    cw:  integer,
    ch:  integer,
    ppm: float,
) -> (float, float) {
    stw_camw = lat_to_metres(cam.pos);
    // `?? 0.0` silences loft's div-by-zero static check —
    // ppm is always > 0 at call sites (PPM = 24.0 default).
    stw_inv = (1.0 / ppm) ?? 0.0;
    stw_dx = ((sx - cw / 2) as float) * stw_inv;
    stw_dy = ((sy - ch / 2) as float) * stw_inv;
    (stw_camw.0 + stw_dx, stw_camw.1 + stw_dy)
}

// Convenience: screen pixel → Hex containing that pixel.  Used
// by mouse-click painting (the editor's primary picking path).
pub fn screen_to_hex(
    cam: EditorCamera,
    sx:  integer,
    sy:  integer,
    cw:  integer,
    ch:  integer,
    ppm: float,
) -> Hex {
    sth_w = screen_to_world(cam, sx, sy, cw, ch, ppm);
    lat_from_metres(sth_w.0, sth_w.1)
}

// Translate a world-space (x, y) to canvas pixel coordinates given a
// camera (positioned at a hex) and a pixels-per-metre scale.
//
// Canvas y grows DOWN and dryopea's world y grows SOUTH, so the two
// agree and there is NO flip here — see CLAUDE.md § Hex convention.
// The one place a sign is inverted is `lattice.loft`'s metre
// conversion, which is where `hex_grid`'s north-up frame is turned
// into dryopea's south-down one (plan 09 C1, the compass decision).
pub fn world_to_canvas(
    cam:  EditorCamera,
    wx:   float,
    wy:   float,
    cw:   integer,
    ch:   integer,
    ppm:  float,
) -> (integer, integer) {
    wtc_camw = lat_to_metres(cam.pos);
    wtc_dx_m = wx - wtc_camw.0;
    wtc_dy_m = wy - wtc_camw.1;
    // Half-pixel offset (0.5) so hex centres land on a single pixel
    // rather than straddling two.
    wtc_px = (cw as float)  * 0.5 + wtc_dx_m * ppm + 0.5;
    wtc_py = (ch as float)  * 0.5 + wtc_dy_m * ppm + 0.5;   // no flip — world & screen both grow south
    (wtc_px as integer, wtc_py as integer)
}

// ── Hex rendering primitive ─────────────────────────────────────
//
// Draws a single hex on the canvas at its world centre.  Uses
// six fill_triangles over the lattice's own corner ring, so the
// painted hex reads cleanly to its edges rather than as a circle.

pub fn draw_hex(
    cv:   Canvas,
    cam:  EditorCamera,
    h:    Hex,
    color: integer,
    cw:   integer,
    ch:   integer,
    ppm:  float,
) {
    dh_world = lat_to_metres(h);
    dh_centre = world_to_canvas(cam, dh_world.0, dh_world.1, cw, ch, ppm);
    dh_cx = dh_centre.0;
    dh_cy = dh_centre.1;

    // The six corners come from `lat_corner_offset`, not from a
    // vertex table kept here — so the hexagon drawn IS the hexagon
    // the lattice describes, and a change to the lattice cannot
    // leave the picture behind.  Pointy-top, so corner 0 is straight
    // up and the shape is TALLER than it is wide.
    //
    // Offsets rather than absolute corners: they are the same for
    // every hex, so this costs no camera transform per vertex.
    //
    // ⚠ `round`, not `+ 0.5` truncation — offsets are signed now,
    // and truncating toward zero would pull every negative vertex a
    // pixel inward and make the hex lopsided.
    dh_prev = lat_corner_offset(5);
    dh_px = dh_cx + round(dh_prev.0 * ppm) as integer;
    dh_py = dh_cy + round(dh_prev.1 * ppm) as integer;

    // Six triangles, all sharing the centre.
    for dh_i in 0..6 {
        dh_cur = lat_corner_offset(dh_i);
        dh_qx = dh_cx + round(dh_cur.0 * ppm) as integer;
        dh_qy = dh_cy + round(dh_cur.1 * ppm) as integer;
        cv.fill_triangle(dh_cx, dh_cy, dh_px, dh_py, dh_qx, dh_qy, color);
        dh_px = dh_qx;
        dh_py = dh_qy;
    }
}

// ── The render pipeline ─────────────────────────────────────────
//
// Sea-default + painted overlay.  Iterates the painted entries
// (sparse — most hexes are sea) and draws each as a coloured hex
// on top of the sea-filled canvas.
//
// `ppm` (pixels per metre) determines the visible scale.  At
// ppm=16 with HEX_DIAMETER=1.5, a hex is 24 px wide vertex-to-
// vertex.

pub fn render_to_canvas(
    cam:  EditorCamera,
    pw:   PaintedWorld,
    w:    integer,
    h:    integer,
    ppm:  float,
) -> Canvas {
    cv = canvas(w, h, sea_color());

    // Iterate sparse painted entries.  Each non-sea hex draws on
    // top of the sea-filled canvas.  An out-of-frustum hex still
    // draws — fill_triangle clips internally; the cost is tiny
    // for a sparse layer.
    for entry in pw.painted {
        draw_hex(cv, cam,
                 Hex { q: entry.q, r: entry.r },
                 palette_color(entry.kind),
                 w, h, ppm);
    }

    cv
}

// Draw a 1-px white outline along the perimeter of a hex —
// used to indicate the hovered hex during painting.  Same corner
// ring as draw_hex, from the same source.
pub fn draw_hex_outline(
    cv:    Canvas,
    cam:   EditorCamera,
    h:     Hex,
    color: integer,
    cw:    integer,
    ch:    integer,
    ppm:   float,
) {
    dho_world = lat_to_metres(h);
    dho_centre = world_to_canvas(cam, dho_world.0, dho_world.1, cw, ch, ppm);
    dho_cx = dho_centre.0;
    dho_cy = dho_centre.1;

    // Same corner ring as `draw_hex`, from the same source — an
    // outline that disagreed with the fill would be a hairline of
    // the wrong colour along every hovered hex.
    dho_prev = lat_corner_offset(5);
    dho_px = dho_cx + round(dho_prev.0 * ppm) as integer;
    dho_py = dho_cy + round(dho_prev.1 * ppm) as integer;

    for dho_i in 0..6 {
        dho_cur = lat_corner_offset(dho_i);
        dho_qx = dho_cx + round(dho_cur.0 * ppm) as integer;
        dho_qy = dho_cy + round(dho_cur.1 * ppm) as integer;
        cv.draw_line(dho_px, dho_py, dho_qx, dho_qy, color);
        dho_px = dho_qx;
        dho_py = dho_qy;
    }
}

// Render the world + a hover-highlight outline on the supplied
// hex.  Convenience helper for tests / live edit modes that
// want to show the player which hex the cursor is on.
pub fn render_with_hover(
    cam:     EditorCamera,
    pw:      PaintedWorld,
    hovered: Hex,
    w:       integer,
    h:       integer,
    ppm:     float,
) -> Canvas {
    rwh_cv = render_to_canvas(cam, pw, w, h, ppm);
    draw_hex_outline(rwh_cv, cam, hovered, 0xffffff, w, h, ppm);
    rwh_cv
}

// Render the world + a PREVIEW of the next paint on the hovered
// hex.  Fills the hex with the active palette colour so the
// player sees what the next click will look like before it
// commits.  A white outline still sits on top, so a preview that
// happens to match the current hex colour (e.g. hovering over
// already-grass while grass is selected) stays unmistakable.
//
// If `active == 0` (sea), the preview paints with sea — which
// IS what painting sea looks like (erases any prior paint), so
// the preview stays honest.
pub fn render_with_hover_preview(
    cam:     EditorCamera,
    pw:      PaintedWorld,
    hovered: Hex,
    active:  u8,
    w:       integer,
    h:       integer,
    ppm:     float,
) -> Canvas {
    rwhp_cv = render_to_canvas(cam, pw, w, h, ppm);
    draw_hex(rwhp_cv, cam, hovered, palette_color(active), w, h, ppm);
    draw_hex_outline(rwhp_cv, cam, hovered, 0xffffff, w, h, ppm);
    rwhp_cv
}

// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A ROBOT GOING ABOUT ITS BUSINESS — traffic, and how it ends.
//
// BACKLOG B4.  ⚠⚠ **Every robot in the code was a WAVE** (`@X245`):
// the roster only ever grew from `wave_schedule_step`, every one of
// them walked toward the core, and none of them ever left.  A player
// landing on a fresh world saw an empty map until they poked a spawn
// marker.
//
// ⚠ `@X245` says the finished game's first fifteen minutes are
// SCOUTING, in a world that is alive — *"robots in their normal work
// flow, busy with whatever project they happen to be in"* — and names
// three things it needs.  Two now exist: somebody to point at it
// (text, `@X268`) and somewhere to go (§ X1's rings).  **This is the
// third.**
//
// ── ⚠⚠ Traffic and waves are the SAME robots ────────────────────
//
// `ROBOT_ECONOMY.md` § The graph: *"Material flows along the edges;
// the flow is the traffic; **the traffic is the waves**."*  And
// `SETTING.md` § Why waves happen: a wave is *"the gradual accretion
// of individual cut-off robots"*, where a spawn marker is *"where
// cut-off robots first enter the bubble's edge"* and **the marker's
// direction is the heading they were going BEFORE**.
//
// So this file adds **no mover and no second AI** — `DESIGN.md` § 10's
// rule, and `ROBOT_ECONOMY.md` § The governing rule states it again:
// *an installation that needs its own movement code has broken it*.
// `spawn.loft::enemy_walk_heading` has walked a robot along its
// business since plan 11 F5b.  What was missing is at both ends:
//
//   ⚠ **a robot's business never ENDED** — walk into a cliff or the
//     sea and it stands there for the rest of the run, so traffic
//     would silt the map up rather than cross it;
//   ⚠ **and nothing ever started one** that the wave schedule had not.
//
// ── ⚠⚠ The bubble is the whole mechanic ─────────────────────────
//
// A robot on an errand that enters the scrambler bubble **loses its
// errand** — its link is cut, it is one of the wave, and it never goes
// back.  That is `SETTING.md`'s fiction made mechanical, and it is
// what `ROBOT_ECONOMY.md` means by *"the only thing that matters is
// which edges the base happens to sit on"*:
//
//   **the same traffic is scenery or a wave, and where you landed is
//   what decides which.**
//
// ⚠ Measured rather than asserted — `tests/b4_the_errand.loft` runs one
// traffic rate past a marker outside the bubble and the same rate past
// one inside it, and reads scenery in the first and a siege in the
// second.
//
// ── What keeps the 679 gate measurements still ──────────────────
//
// ⚠⚠ `Enemy.errand` defaults **false**, so every robot in every
// existing scenario is a cut-off robot exactly as before, and traffic
// is off until a `.keys` file says `traffic <rate>`.  [loft#914]'s
// silent default lands on *the way the game already worked*, which is
// the only direction it could safely land.

use spawn;
use markers;
use lattice;
use passable;
use flow;
use painted;
use palette;
use height;
use occupancy;
use fixstep;
use task;

// Robots per second one source puts on the road, when a map says
// nothing — `traffic <rate>` is how a scenario says otherwise.
//
// ⚠ ZERO, and that is the load-bearing default: ambient life is opt-in
// so that the 35 gated scenarios measure the game they always did.
pub const TRAFFIC_RATE_DEFAULT: float = 0.0;

// One map's ambient traffic.
//
// ⚠ A `Bank` rather than a timer, and for `fixstep`'s own reason: a
// rate banked in integer base units releases whole robots exactly at
// every tick length, where a float accumulator comes up short (`@M049`
// is the same mistake one system over).  ⚠ The RATE is stored because
// it is a property of the map; the bank holds only the carry.
pub struct Traffic {
    rate: float,
    bank: Bank,
}

// Factory: a quiet map.
pub fn traffic_new() -> Traffic {
    Traffic { rate: TRAFFIC_RATE_DEFAULT, bank: bank_new() }
}

// Set how busy this map is, in robots per second.
//
// ⚠ Negative is clamped to nothing rather than refused: a map is quiet
// or it is busy, and there is no third thing a negative rate could
// mean.
//
// Example: @DRY-110
pub fn traffic_set(t: Traffic, rate: float) {
    t.rate = max(rate, 0.0);
}

// Is any traffic running?
pub fn traffic_running(t: const Traffic) -> boolean {
    t.rate > 0.0
}

// How many robots this map puts on the road over `elapsed`.
//
// ⚠ It SPENDS the bank, so a caller asks once per tick — the same
// contract `enemy_bank` and `helper_bank` have.
//
// Example: @DRY-110
pub fn traffic_due(t: Traffic, elapsed: integer) -> integer {
    if !traffic_running(t) { return 0; }
    bank_gain(t.bank, bank_rate(t.rate), elapsed, BANK_WHOLE)
}

// ─── ⚠⚠ THE ROUTINE — five anchors, and the BAG steers ──────────
//
// Plan 30 R1.  `docs/ERRANDS.md` § What a mob carries is the design and
// `@FR-E-Rule-Not-State` is the rule: **a mob's position is a FUNCTION,
// not a memory**, so what a robot holds is a handful of fixed anchors
// and the route is DERIVED from them every time it is asked.
//
// ⚠⚠ **There is no waypoint list here and there must never be one.**  A
// stored path has to be maintained — invalidated when the world changes,
// resumed after a deviation, saved and reloaded — and a destination
// computed from five fields needs none of that: **deviation is free
// precisely because there is nothing to resume.**  It is
// `pose.loft`'s *read the sim, never a second flag* one system over.
//
// ── ⚠⚠ THE BAG STEERS, NOT THE CALENDAR  `@FR-E-Bag-Steers` ─────
//
// The one rule in this section that was MEASURED rather than reasoned,
// and it was measured in `../crawler` (`src/sim.loft:2513`):
//
// > *"This used to alternate by day parity … the picking ground is 50
// > hexes out, a day carries it 13, and the leg flipped every day — so
// > it oscillated between home and 13 hexes out, forever.  In 21 days
// > it gathered nothing … Keyed on the bag the trip is self-correcting
// > at any distance."*
//
// ⚠⚠ **dryopea has that hazard and worse**, because `@X298` makes a
// route cross a 1.5 km cell: **any period you could pick is shorter
// than the trip.**  So `errand_leg` asks the BAG, and the loop closes
// itself at 4 hexes and at 400 with no clock in it at all.
//
// ⚠ **GUARD is the one role a clock may steer**, and only because it
// has no bag and its two legs are equidistant by construction.  That is
// a fact about the ROLE, so it is a COLUMN (`period`) and not a branch.
//
// ⚠⚠ **The rule has TWO sites and they are two HALVES, not two
// implementations** (`@X329` asks for the difference to be named):
// `errand_leg` READS the bag to choose a leg, `errand_arrive` FILLS and
// EMPTIES it on arrival.  Neither is the rule on its own — a bag nothing
// fills makes the leg constant for ever, which is a mob that arrives and
// stands there, the same failure reached from the other side.  ⚠ This
// section is the ARGUMENT; those two functions are the enforcement.
//
// ── ⚠⚠ A ROLE IS A ROW, FROM THE FIRST LINE  `@X322` ────────────
//
// `../crawler` split here and its own comments say the split hurt:
// hostiles are pure data over one code path, while civilians are
// hard-coded `role == 7` integer comparisons in **eight** places, and
// `src/sim.loft:145` records that the role list *"stopped at 6 while
// 7-12 were in use, which costs a reader real time."*
//
// ⚠⚠ **So the table is INDEXED and never compared**, and
// `tests/30_r1_the_errand.loft` reads every `src/*.loft` back to prove
// it: a comparison against a `ROLE_` constant anywhere in `src/` is the
// defect, and it is the only form crawler's could have taken.
//
// ⚠ **And a row must not promise behaviour the engine does not have.**
// Four of crawler's eleven monster flags are declared in its table and
// read by no AI code at all — `@X112`'s *check the number exists first*
// from the other end.  So there are exactly four columns here and
// `errand_leg` reads all four; **what draws a role off its route is
// deliberately NOT a column yet** — that is R7, and it gets one when
// something reads it.
//
// ── ⚠ Why `carry` is not `carry.loft`'s  `@FR-F-Nameable-Difference` ─
//
// CLAUDE.md says *never a "carried" field on the carrier as well*, and
// this is a field on the carrier — so the difference has to be NAMEABLE
// and it has to be a fact about the domain (`@X329`).  It is:
//
// > **`carry.loft` conserves an object that is ON THE MAP and that the
// > player could pick up instead; a mob's bag holds material that was
// > never on the map and never will be.**
//
// A `CarryObject` has an `owner` and conservation is structural because
// a tower top exists whether or not anybody is holding it.  A hauler's
// load comes from off-map and leaves with the hauler, so there is no
// object to conserve and no second copy to disagree with.
//
// ⚠⚠ **R7 is where that stops being true and the obligation is here so
// it is not discovered there**: the moment a mob picks up *the player's
// salvage heap* it is holding a thing the player could have had, and
// that load must be a `carry.loft` object with the bag as the routine's
// READING of it — never a second ledger.

// ⚠⚠ **NOTHING IN THE TICK CALLS ANY OF THIS YET, AND THAT IS THE
// PHASE.**  R1 lands the record, the table and the derived destination;
// `errand_leg` is what R3's mover will descend a field toward, and R2 is
// what makes `cycle_at` evaluable at an arbitrary `t`.  Until then every
// robot in every scenario reads `ROLE_NONE`, which is today's game.

// ─── The roles ──────────────────────────────────────────────────

// ⚠⚠ **`ROLE_NONE` is 0 and that is load-bearing** ([loft#914]): a
// struct literal that omits a field takes its default silently, so the
// neutral value has to be the one every `Enemy { … }` literal written
// before this phase already means — **no cycle at all**, which is a
// cut-off robot walking to the core and an ambient one walking the
// bearing its spawn marker gave it.  Both of those are the whole roster
// today and neither has a routine.
pub const ROLE_NONE:   integer = 0;
pub const ROLE_HAUL:   integer = 1;   // load at the face, drop at the depot
pub const ROLE_GATHER: integer = 2;   // cut at the face, carry it home
pub const ROLE_GUARD:  integer = 3;   // the post and its second leg

// How many rows the table has.  ⚠ `errand_table_fault` holds the table
// to it, which is the half crawler's *"stopped at 6 while 7-12 were in
// use"* was missing.
pub const ROLE_KIND_COUNT: integer = 4;

// Which of a routine's three anchor hexes a leg ends at.
//
// ⚠ `ANCHOR_NONE` is 0 for the same [loft#914] reason, and it means
// *this role has no destination of its own* — `errand_destination` then
// answers `job_none()` and the enemy mover keeps the field it always
// had.
pub const ANCHOR_NONE: integer = 0;
pub const ANCHOR_HOME: integer = 1;
pub const ANCHOR_WORK: integer = 2;
pub const ANCHOR_ALT:  integer = 3;

// An empty bag, and a full one.  ⚠ Zero is empty, so a partial literal
// is a robot carrying nothing.
pub const ERRAND_BAG_EMPTY: u8 = 0;
pub const ERRAND_BAG_LOAD:  u8 = 1;

// How long a guard stands one leg of its post, in `fixstep` base units
// — 10 s, which is 15 ticks at today's 2/3 s.
//
// ⚠ It is the only period in the file and it belongs to the one role
// `docs/ERRANDS.md` lets a clock steer.  A number here for a role that
// CARRIES would be the crawler defect with dryopea's name on it.
//
// ⚠⚠ **IT IS A WHOLE NUMBER OF TICKS AND THAT IS A CONSTRAINT, NOT A
// COINCIDENCE** — `cycle_fault` refuses one that is not (`@M074`): a leg
// boundary in TIME lands wherever the timestep puts it, so a period the
// step does not divide leaves the body a hex ahead of its own rule for
// as long as the leg lasts.
//
// ⚠⚠ **AND IT CANNOT SEE ITS OWN ROUNDING** (`@M014`'s class): ten
// seconds at 1.0, 1.5 and 2.5 hex/s is 10, 15 and 25 WHOLE hexes, so the
// bank's carry is exactly zero at every flip and `cycle_phase`'s
// difference-of-two-walks agrees with the naive form **for any
// implementation**.  ⚠ `tests/30_r2_the_cycle.loft` sweeps a 16-tick
// NEIGHBOUR for that reason, and a change to this number must keep the
// sweep — never rely on the shipped value to exercise the branch.
pub const GUARD_LEG_UNITS: integer = 30000000;

// One role, as a row: where it goes empty, where it goes loaded, and
// whether a clock or the bag decides which.
//
// ⚠ `period` of 0 means **the bag steers** — it is not a missing number,
// it is the answer, and `errand_leg` reads it as one.
pub struct Role {
    name:   text,
    empty:  integer,
    laden:  integer,
    period: integer,
}

pub fn errand_row(name: text, empty: integer, laden: integer,
                  period: integer) -> Role {
    Role { name: name, empty: empty, laden: laden, period: period }
}

// ⚠⚠ **THE TABLE.**  Every role in the game is a row here and there is
// no `role ==` anywhere — `errand_role_of` indexes it, and a role the
// engine does not know reads as `ROLE_NONE` rather than as a branch
// nobody took.
//
// Example: @DRY-144, @DRY-149, @DRY-152
pub fn errand_roles() -> vector<Role> {
    ers: vector<Role> = [];
    ers += [errand_row("none",   ANCHOR_NONE, ANCHOR_NONE, 0)];
    ers += [errand_row("haul",   ANCHOR_WORK, ANCHOR_ALT,  0)];
    ers += [errand_row("gather", ANCHOR_WORK, ANCHOR_HOME, 0)];
    ers += [errand_row("guard",  ANCHOR_WORK, ANCHOR_ALT,  GUARD_LEG_UNITS)];
    ers
}

// The row for a role — `ROLE_NONE`'s for anything the table does not
// have.  ⚠ It is the ONE lookup; nothing else may index the table.
//
// Example: @DRY-144
pub fn errand_role_of(role: integer) -> Role {
    ero_all = errand_roles();
    ero_i   = role;
    if ero_i < 0 || ero_i >= len(ero_all) { ero_i = ROLE_NONE; }
    ero_all[ero_i] ?? errand_row("none", ANCHOR_NONE, ANCHOR_NONE, 0)
}

// The role a script or a measurement spells `name`, or `ROLE_NONE`.
//
// ⚠ **The writer and the reader are ONE here** (`@D007` is what happens
// when they are two): a name comes out of the row it names, so a role
// added to the table is spellable the moment it exists.
pub fn errand_role_named(name: text) -> integer {
    ern_i = 0;
    for ern_row in errand_roles() {
        if ern_row.name == name { return ern_i; }
        ern_i += 1;
    }
    ROLE_NONE
}

// ─── What a mob carries ─────────────────────────────────────────

// Five anchors and a bag — everything a robot needs to know where it is
// going, and nothing else.
//
// ⚠⚠ **`@FR-E-Place-State`**: a mob may hold nothing beyond `carry` and
// `slip`, because there are many of them and they are everywhere.  State
// belongs to the PLACE — R5's POI — which is few and does not move.
//
// ⚠ `role` is an `integer` rather than `u8` where `docs/ERRANDS.md`
// wrote one: it indexes a table and is compared to nothing, and a `u8`
// would buy a byte at the price of a cast at every index.
pub struct Errand {
    role:  integer,
    home:  Hex,        // the maintenance point, or the nest
    work:  Hex,        // the face, the picking ground, the post
    alt:   Hex,        // the drop-off, or the second patrol leg
    carry: u8,         // what is in the bag — empty is 0
    slip:  integer,    // base units this mob has fallen behind (`@X302`)
}

// Factory: no routine at all, which is every robot in the game today.
pub fn errand_new() -> Errand {
    Errand { role: ROLE_NONE, home: Hex { q: 0, r: 0 },
             work: Hex { q: 0, r: 0 }, alt: Hex { q: 0, r: 0 },
             carry: ERRAND_BAG_EMPTY, slip: 0 }
}

// A routine, spelled out.  ⚠ Build from here or from `errand_new` and
// never from a partial literal — [loft#914] would take an anchor's
// default silently and put the drop-off on the core.
pub fn errand_at(role: integer, home: const Hex, work: const Hex,
                 alt: const Hex) -> Errand {
    Errand { role: role, home: home, work: work, alt: alt,
             carry: ERRAND_BAG_EMPTY, slip: 0 }
}

// Are two routines the same routine?
//
// ⚠ Field by field and exactly — `slip` is an integer since the record
// was written, so there is no epsilon to argue about here the way
// `compare.loft` once had to for a banked carry.
pub fn errand_same(a: const Errand, b: const Errand) -> boolean {
    a.role == b.role && a.carry == b.carry && a.slip == b.slip
        && a.home.q == b.home.q && a.home.r == b.home.r
        && a.work.q == b.work.q && a.work.r == b.work.r
        && a.alt.q  == b.alt.q  && a.alt.r  == b.alt.r
}

// ─── Where it is going ──────────────────────────────────────────

// Which routine this robot is running.
//
// ⚠⚠ **THE ONE DOOR FOR READING A ROLE, and it is what makes the
// bubble's one-way door impossible to forget.**  `wave_cutoff` clears
// `errand` and nothing else; a hauler that has lost its link reads
// `ROLE_NONE` HERE, so site 5 of `plans/30` § Count the RE-ASSERTION
// SITES cannot omit a second write because there is no second write to
// omit.  A reader that reached for `e.route.role` instead would see a
// robot still running a cycle it has been cut off from.
//
// Example: @DRY-151
pub fn errand_role(e: const Enemy) -> integer {
    if !e.errand { return ROLE_NONE; }
    e.route.role
}

// Where an anchor is.  ⚠ `ANCHOR_NONE` answers the origin, which no
// caller may use — `errand_destination_of` refuses that leg before it
// asks.
pub fn errand_anchor(er: const Errand, anchor: integer) -> Hex {
    if anchor == ANCHOR_HOME { return er.home; }
    if anchor == ANCHOR_WORK { return er.work; }
    if anchor == ANCHOR_ALT  { return er.alt; }
    Hex { q: 0, r: 0 }
}

// Which anchor this mob is making for — the whole of `@FR-E-Bag-Steers`
// in one expression.
//
// ⚠⚠ **The BAG is asked unless the row names a period**, and a row that
// names one is a role with no bag.  So the two steerings are one
// function reading one column, which is `@X329`'s *a healthy merge
// replaces a difference in CODE with a difference in DATA*.
//
// ⚠ `slip` is subtracted here and nowhere else: a mob that has been
// held up is genuinely later, so its clock reads earlier.
//
// Example: @DRY-145, @DRY-146, @DRY-150
pub fn errand_leg(row: const Role, er: const Errand, now: integer) -> integer {
    if row.period > 0 {
        el_t = now - er.slip;
        if el_t < 0 { el_t = 0; }
        if (el_t / row.period) % 2 == 0 { return row.empty; }
        return row.laden;
    }
    if er.carry != ERRAND_BAG_EMPTY { return row.laden; }
    row.empty
}

// The hex this routine is making for, as a `Job`.
//
// ⚠⚠ **`Job` is `task.loft`'s and that is `@X332` cashed in**: a leg's
// destination is exactly a kind and a hex, and there is no nameable
// difference between the crew's record of one and a mob's.  What does
// NOT come across is the SELECTION — `jobs_in_scope` takes a `Skills`
// and `job_pick` chooses the nearest, and *a mob is TOLD where to go*.
//
// ⚠ `kind` is `TASK_ANY` for every role today, and the column is empty
// rather than guessed: **not one of the four kinds is what a hauler does
// at its face** — picking a load up is not clearing rubble — so the
// arrival ACTION waits for R7 to read one.  That is `@X112` from the
// other end, and a row promising behaviour the engine has not got is
// exactly what this file refuses to be.
//
// Example: @DRY-145
pub fn errand_destination_of(row: const Role, er: const Errand,
                             now: integer) -> Job {
    edo_a = errand_leg(row, er, now);
    if edo_a == ANCHOR_NONE { return job_none(); }
    edo_h = errand_anchor(er, edo_a);
    Job { found: true, kind: TASK_ANY, q: edo_h.q, r: edo_h.r }
}

// The same, for a robot on the roster.
//
// ⚠ It goes through `errand_role`, so a cut-off hauler answers
// `job_none()` and the mover it has always had takes it from there.
//
// Example: @DRY-147, @DRY-151
pub fn errand_destination(e: const Enemy, now: integer) -> Job {
    ed2_row = errand_role_of(errand_role(e));
    errand_destination_of(ed2_row, e.route, now)
}

// The mob is standing on its destination: turn the bag over.  Answers
// whether it did.
//
// ⚠⚠ **This is the other half of `@FR-E-Bag-Steers` and the cycle does
// not close without it.**  A bag that nothing fills makes `errand_leg`
// answer the same anchor for ever, which is a mob that arrives and
// stands there — the failure the bag was chosen to avoid, reached from
// the other side.
//
// ⚠ A clock-steered role has no bag, so it turns nothing over: `period`
// is the one column asked, in this function and in `errand_leg`, and the
// two agree because they read it rather than each deciding.
//
// Example: @DRY-145
pub fn errand_arrive(er: Errand, row: const Role, at: const Hex,
                     now: integer) -> boolean {
    if row.period > 0 { return false; }
    ea_a = errand_leg(row, er, now);
    if ea_a == ANCHOR_NONE { return false; }
    ea_h = errand_anchor(er, ea_a);
    if ea_h.q != at.q || ea_h.r != at.r { return false; }
    if er.carry == ERRAND_BAG_EMPTY { er.carry = ERRAND_BAG_LOAD; }
    else                            { er.carry = ERRAND_BAG_EMPTY; }
    true
}

// ─── ⚠⚠ THE CYCLE — evaluable at any `t`, in O(legs) ────────────
//
// Plan 30 R2, and `@FR-E-Closed-Form` is the whole of it: *a cycle is
// evaluable at an arbitrary `t` in O(legs) and never by stepping forward
// from its start.*  ⚠ That is what makes `@X299`'s un-tracked mob
// **computed** rather than approximated, which is why materialising one
// later must not change where it is — and it is why `plans/22`'s LOD
// refusal needs no exception here.
//
// ── ⚠ Two halves, and only the second needed a probe ────────────
//
// ⚠⚠ **TIME → STEPS is exact arithmetic.**  `fixstep`'s `Bank` keeps its
// remainder, so however `t` was spent, the whole hexes a mover has
// released by then are `floor(rate × t / BANK_WHOLE)` — nothing
// accumulates and there is nothing to step through.  `cycle_walked` is
// that expression and it is the closed form's entire time half.
//
// ⚠⚠ **STEPS → HEX is a PATH, and R0 probe 1 is why** (`@M071`): only
// **10 of 90** straight crossings of the authored maps arrive and 44 of
// the 80 failures are painted terrain, so a leg is a **descent of a flow
// field toward its anchor**.  ⚠ The round is therefore stored as the
// hexes themselves — one per step offset — and `cycle_at` INDEXES it.
// ⚠ `@X331`'s bound survives that unchanged, because a field distance is
// a distance.
//
// ── ⚠⚠ THE BANK DOES NOT RESTART AT A LEG BOUNDARY ─────────────
//
// ⚠⚠ **The one thing here a plausible implementation gets wrong, and the
// sweep is what finds it.**  A mob that turns at an anchor carries its
// banked fraction across, so *how far into this leg am I* is
// `walked(t) − walked(t₀)` and **never** `walked(t − t₀)`.  The two
// differ by a whole hex whenever the carry is non-zero — which is most
// of the time — and nothing about the wrong form looks wrong.
//
// ⚠ **It is equally an obligation on R3's mover**, written here because
// that is where it would be forgotten: **a mob that walks past an anchor
// spends its remaining hexes on the NEXT leg** and never loses them at
// the turn.  ⚠⚠ And a DWELL at an anchor is a **leg of the cycle with a
// length**, not a pause beside it: a pause is a second time source, and
// a closed form has room for exactly one.
//
// ── ⚠ The period is in STEPS, and the clock is a COLUMN ─────────
//
// A bag-steered cycle's phase advances only when the mob MOVES, so its
// period is a count of hexes and the round closes itself at any distance
// (`@FR-E-Bag-Steers`, `@M073`).  A clock-steered one advances whether
// the mob moves or not, so `row.period` picks the leg and the walk only
// says how far into it the mob got.
//
// ⚠⚠ **That is the same difference `errand_leg` reads, out of the same
// COLUMN** — `@X329`'s *a healthy merge replaces a difference in CODE
// with a difference in DATA* — which is why the two agree by
// construction rather than by being kept in step.

// A whole round, as the hexes it passes through.
//
// ⚠ `path` holds ONE hex per step offset and the round WRAPS: offset
// `period` is `path[0]` again, so a leg's last hex is the next leg's
// first and is stored once.  ⚠ `anchors` and `lengths` are per leg and
// the same length as each other; `period` is the sum of `lengths`, and
// `cycle_fault` is what holds it to that rather than letting it wrap
// silently.
//
// ⚠⚠ **It is a vector of hexes and not a nested leg struct on purpose**
// ([loft#974]): a record fetched through an accessor reads its vector
// field as EMPTY once an unrelated struct has been allocated, and a
// `vector<CycleLeg>` whose every element carries a `vector<Hex>` is that
// shape exactly.  Flat, there is no accessor to read through.
pub struct Cycle {
    anchors: vector<integer>,   // the anchor each leg ENDS at
    lengths: vector<integer>,   // steps in each leg
    path:    vector<Hex>,       // `period` hexes, one per step offset
    period:  integer,           // steps in a whole round
}

// A mob with no cycle at all — which is every robot in the game today.
pub fn cycle_new() -> Cycle {
    Cycle { anchors: [], lengths: [], path: [], period: 0 }
}

// Is there a round to be on?
pub fn cycle_running(c: const Cycle) -> boolean {
    c.period > 0
}

// The greatest common divisor — the only arithmetic helper in this file,
// and it is here to keep `cycle_walked` EXACT rather than merely close.
fn cycle_gcd(a: integer, b: integer) -> integer {
    cg_x = a;
    cg_y = b;
    while cg_y != 0 {
        cg_t = (cg_x % cg_y) ?? 0;
        cg_x = cg_y;
        cg_y = cg_t;
    }
    cg_x
}

// How many whole hexes a mover banking at `rate` has released by `t`.
//
// ⚠⚠ **`bank_gain`'s cumulative answer in CLOSED FORM, and it is exact**
// — the bank keeps its remainder, so whatever chunks `t` was spent in
// the total released is `floor(rate × t / BANK_WHOLE)`.  That exactness
// is the whole of `@FR-E-Closed-Form`: there is nothing to step through
// because there is nothing to accumulate.
//
// ⚠⚠ **The gcd is not tidiness.**  `rate × t` overflows an i64 a few
// game-hours in at a scout's pace and **an overflow is silent**.
// Reducing by the gcd first makes every shipped speed divide
// `BANK_WHOLE` exactly — 1.0, 1.5 and 2.5 hex/s all reduce to `t / k` —
// so the multiply that could overflow is never performed.
//
// Example: @DRY-158
pub fn cycle_walked(rate: integer, t: integer) -> integer {
    if rate <= 0 || t <= 0 { return 0; }
    cw_g = cycle_gcd(rate, BANK_WHOLE);
    cw_r = (rate / cw_g) ?? 1;
    cw_w = (BANK_WHOLE / cw_g) ?? 1;
    ((cw_r * t) / cw_w) ?? 0
}

// Where on its round this cycle is at `t` — the leg, and the offset into
// the whole round.
//
// ⚠⚠ **One modulo, O(legs) to find the leg, one index — and never a step
// forward from `t = 0`.**  That is `@FR-E-Closed-Form` in one function,
// and *elaborate* therefore costs LEGS.
//
// ⚠ `t` is already `now − slip`; this function does not know about slip
// and must not (`cycle_where` is the door that subtracts it, exactly as
// `errand_leg` does).
//
// Example: @DRY-154, @DRY-155
pub fn cycle_phase(c: const Cycle, row: const Role, rate: integer,
                   t: integer) -> (integer, integer) {
    if !cycle_running(c) { return (0, 0); }
    cp_legs = len(c.lengths);
    if cp_legs <= 0 { return (0, 0); }
    cp_t = t;
    if cp_t < 0 { cp_t = 0; }
    if row.period > 0 {
        // ⚠ THE CLOCK picks the leg — the one role `docs/ERRANDS.md`
        // lets it steer, and only because it has no bag — while the walk
        // says how far into that leg the mob got before it turned round.
        cp_i  = (((cp_t / row.period) ?? 0) % cp_legs) ?? 0;
        cp_t0 = ((cp_t / row.period) ?? 0) * row.period;
        cp_at = 0;
        cp_j  = 0;
        for cp_n in c.lengths {
            if cp_j >= cp_i { break; }
            cp_at += cp_n;
            cp_j  += 1;
        }
        cp_len = c.lengths[cp_i] ?? 0;
        // ⚠⚠ The DIFFERENCE of two cumulative walks, never a walk over
        // the difference — § THE BANK DOES NOT RESTART is the argument,
        // and the two forms differ by a hex most of the time.
        cp_into = cycle_walked(rate, cp_t) - cycle_walked(rate, cp_t0);
        if cp_into > cp_len { cp_into = cp_len; }
        if cp_into < 0      { cp_into = 0; }
        return (cp_i, cp_at + cp_into);
    }
    // ⚠ THE BAG steers, so the phase is a count of HEXES and the round
    // closes itself at 4 hexes and at 400 alike (`@M073`).
    cp_off  = (cycle_walked(rate, cp_t) % c.period) ?? 0;
    cp_seen = 0;
    cp_k    = 0;
    for cp_m in c.lengths {
        if cp_off < cp_seen + cp_m { return (cp_k, cp_off); }
        cp_seen += cp_m;
        cp_k    += 1;
    }
    // ⚠ Unreachable while the legs sum to the period — which is exactly
    // what `cycle_fault` refuses a cycle for not doing.  An offset with
    // no leg to own it is the SILENT form of that authoring error, so it
    // answers the round's start rather than guessing at one.
    (0, cp_off)
}

// The hex this routine is standing on at `t`.
//
// Example: @DRY-154
pub fn cycle_at(c: const Cycle, row: const Role, rate: integer,
                t: integer) -> Hex {
    if !cycle_running(c) { return Hex { q: 0, r: 0 }; }
    ca_ph = cycle_phase(c, row, rate, t);
    // ⚠ The round WRAPS: a clock-steered mob standing at the end of the
    // last leg reads offset `period`, which is `path[0]` — the same hex,
    // named from the other side.
    ca_h = c.path[(ca_ph.1 % c.period) ?? 0];
    if ca_h == null { return Hex { q: 0, r: 0 }; }
    Hex { q: ca_h.q, r: ca_h.r }
}

// Where the rule says this robot is, now.
//
// ⚠⚠ **THE DOOR THE CONFORMANCE GATE ASKS** (`plans/30` § Rc): at the
// end of every tick, every mob still on a cycle must be exactly here.
//
// ⚠ It reads the role through `errand_role`, so a robot the bubble has
// taken answers its own hex and stops being on a cycle it has lost —
// site 5 of § Count the RE-ASSERTION SITES needs no second write to
// remember, for the same reason `errand_destination` does not.
//
// ⚠⚠ **`slip` is subtracted HERE and in `errand_leg`, and nowhere else**
// (`@FR-E-Slip`): a mob held up is genuinely later, so its clock reads
// earlier and its DESTINATION never changes.
//
// ⚠⚠ **AND THE FALLBACK IS A TRAP FOR § Rc, SO IT IS NAMED HERE.**  A
// robot with no cycle answers its OWN hex, which makes
// `cycle_where(e, c, now) == (e.q, e.r)` **trivially true** for it — so
// the conformance gate must FILTER on `errand_role` and count what it
// looked at, never lean on this answer.  ⚠ A corpus in which nothing is
// on a cycle would otherwise read green
// (`CLAUDE.md` § A gate whose reading is already saturated).
//
// Example: @DRY-156, @DRY-160, @DRY-166, @DRY-167, @DRY-168
pub fn cycle_where(e: const Enemy, c: const Cycle, now: integer) -> Hex {
    cwh_row = errand_role_of(errand_role(e));
    // ⚠ The ROW is asked and never the role id — the table is indexed
    // and never compared (`@X333`), and *this role has no cycle* is
    // exactly *its legs go nowhere*.
    if cwh_row.empty == ANCHOR_NONE { return Hex { q: e.q, r: e.r }; }
    if !cycle_running(c)            { return Hex { q: e.q, r: e.r }; }
    cycle_at(c, cwh_row, bank_rate(enemy_speed(e.kind)),
             now - e.route.slip)
}

// Build the round this routine walks: one leg per anchor, each a descent
// of a flow field toward it.
//
// ⚠⚠ **The legs come from the ROW and not from a waypoint list** — a
// round starts where the mob last dropped (`row.laden`), walks to
// `row.empty`, and comes back.  That is `errand_leg`'s two answers made
// into two legs, so the cycle and the steering cannot disagree about
// which anchor is which.
//
// ⚠ **A leg that does not connect refuses the whole cycle**, answering
// `cycle_new()` — a mob with no cycle, which is today's game — rather
// than a short round that would put a body somewhere the rule never
// said.  ⚠ `cycle_fault` is what NAMES the refusal.
//
// ⚠ Two sweeps, and `@M072` is what makes that affordable: a field over
// an authored map is ~500 cells, and a mob asks for at most three
// anchors.  It is built ONCE per routine and never in the tick.
//
// Example: @DRY-154, @DRY-157
pub fn cycle_build(er: const Errand, row: const Role,
                   pal: vector<GroundType>, pw: PaintedWorld,
                   hl: const HeightLayer, kind: u8) -> Cycle {
    if row.empty == ANCHOR_NONE || row.laden == ANCHOR_NONE {
        return cycle_new();
    }
    cb_from = errand_anchor(er, row.laden);
    cb_to   = errand_anchor(er, row.empty);
    cb_out  = cycle_two_legs(pal, pw, hl, kind, cb_from, cb_to,
                             row.empty, row.laden);
    cb_out
}

// The two legs of a round, as one flat path.  ⚠ Split out so the struct
// is built by a single literal at the end and nothing writes through a
// returned copy ([loft#894]).
fn cycle_two_legs(pal: vector<GroundType>, pw: PaintedWorld,
                  hl: const HeightLayer, kind: u8,
                  from: const Hex, to: const Hex,
                  out_anchor: integer, back_anchor: integer) -> Cycle {
    ctl_out    = flow_route(flow_build(pal, pw, hl, kind, to), from);
    ctl_back   = flow_route(flow_build(pal, pw, hl, kind, from), to);
    ctl_n_out  = len(ctl_out) - 1;
    ctl_n_back = len(ctl_back) - 1;
    // ⚠ A leg with no length is a round with no length, and a leg that
    // never arrived is a leg that does not connect — both are the same
    // refusal from the caller's side: no cycle at all.
    if ctl_n_out <= 0 || ctl_n_back <= 0 { return cycle_new(); }
    if !cycle_ends_at(ctl_out, to) || !cycle_ends_at(ctl_back, from) {
        return cycle_new();
    }
    ctl_path: vector<Hex> = [];
    ctl_i = 0;
    for ctl_h in ctl_out {
        // ⚠ The join is stored ONCE: this leg's last hex is the next
        // leg's first, so the outward path contributes its first
        // `n` entries and the return path its first `m`.
        if ctl_i < ctl_n_out { ctl_path += [Hex { q: ctl_h.q, r: ctl_h.r }]; }
        ctl_i += 1;
    }
    ctl_j = 0;
    for ctl_b in ctl_back {
        if ctl_j < ctl_n_back { ctl_path += [Hex { q: ctl_b.q, r: ctl_b.r }]; }
        ctl_j += 1;
    }
    Cycle { anchors: [out_anchor, back_anchor],
            lengths: [ctl_n_out, ctl_n_back],
            path:    ctl_path,
            period:  ctl_n_out + ctl_n_back }
}

// Does this route actually reach `at`?
fn cycle_ends_at(path: vector<Hex>, at: const Hex) -> boolean {
    cea_last = path[len(path) - 1];
    if cea_last == null { return false; }
    cea_last.q == at.q && cea_last.r == at.r
}

// Why this cycle is not a cycle, or "".
//
// ⚠⚠ **A cycle whose legs do not sum to its period is an authoring error
// and is REFUSED here rather than wrapped silently** (`@FR-E-Closed-Form`).
// A wrapped one is not a crash: it is a mob standing on the wrong hex for
// ever, with every count in the suite green.
//
// ⚠⚠ **And the last check is `crawler`'s defect refused at
// construction**: a clock-steered role whose period is too short to walk
// its own leg *"oscillated between home and 13 hexes out, forever"*
// (`@M073`).  Here the leg's length is known before the mob moves, so
// the authoring error can be NAMED instead of measured.
//
// ⚠ `rate` is the mover's, because whether a clock is long enough to
// walk a post depends on how fast the walker is — a fact about the
// domain, not about the code.
//
// Example: @DRY-155, @DRY-157, @DRY-159
pub fn cycle_fault(c: const Cycle, row: const Role, rate: integer) -> text {
    if !cycle_running(c) {
        return "this routine has no cycle: a leg is empty, or an anchor "
               + "cannot be reached from the one before it";
    }
    if len(c.anchors) != len(c.lengths) {
        return "the cycle has {len(c.anchors)} anchors and "
               + "{len(c.lengths)} legs";
    }
    cf_sum = 0;
    for cf_n in c.lengths {
        if cf_n <= 0 { return "a leg of {cf_n} steps has no length"; }
        cf_sum += cf_n;
    }
    if cf_sum != c.period {
        return "the legs sum to {cf_sum} steps and the period says "
               + "{c.period}";
    }
    if len(c.path) != c.period {
        return "the round is {len(c.path)} hexes long and its period says "
               + "{c.period}";
    }
    // ⚠⚠ **A LOST HEX MUST BE A WHOLE NUMBER OF BASE UNITS** (§ THE
    // MOVER), and it is `@M074`'s family with a different subject: for
    // `cycle_walked(rate, t − slip)` to be exactly one hex short at
    // EVERY later `t`, `rate × slip` has to be a whole multiple of
    // `BANK_WHOLE`.  A rate that cannot express *one hex late* as a time
    // is an authoring error, named here rather than measured later as a
    // mob drifting a hex ahead of its own rule.
    if cycle_hex_units(rate) <= 0 {
        return "a rate of {rate} does not make a hex a whole number of "
               + "base units, so a deviation cannot be paid for exactly";
    }
    if row.period > 0 {
        // ⚠⚠ **A CLOCK PERIOD MUST BE A WHOLE NUMBER OF TICKS**, and
        // `@M074` is what it costs when it is not: a leg boundary in
        // TIME lands wherever the timestep happens to put it, so a
        // period the step does not divide leaves the body a hex ahead of
        // its own rule for as long as the leg lasts.  ⚠ A boundary in
        // DISTANCE cannot do that at any timestep, which is the second
        // and INDEPENDENT reason for `@FR-E-Bag-Steers`.
        //
        // ⚠ Measured over the whole cross-product rather than at the
        // shipped step alone (`CLAUDE.md` § THE INSTRUMENT IS A
        // CROSS-PRODUCT), which is why the check is against the tick and
        // not against a promise that nobody will change it.
        if ((row.period % TICK_STEP_UNITS) ?? 1) != 0 {
            return "role '{row.name}': a clock period of {row.period} "
                   + "units is not a whole number of ticks";
        }
        // ⚠ The MINIMUM a period buys, because the bank's carry can only
        // ever add one — a leg this walk cannot finish is one no carry
        // will rescue.
        cf_reach = cycle_walked(rate, row.period);
        for cf_m in c.lengths {
            if cf_m > cf_reach {
                return "a clock-steered leg of {cf_m} steps cannot be "
                       + "walked in a period worth {cf_reach}";
            }
        }
    }
    ""
}

// ─── What a row may not be ──────────────────────────────────────

// Why this row is not a role, or "".
//
// ⚠ The same shape as `crop_fault` and `map_fault`: a refusal that NAMES
// what is wrong, because a table is authored and an authoring error that
// wraps silently is R2's *a cycle whose legs do not sum to its period*
// arriving one phase early.
pub fn errand_row_fault(row: const Role) -> text {
    if row.name == "" { return "a role row with no name"; }
    if row.period < 0 {
        return "role '{row.name}': a leg cannot be {row.period} units long";
    }
    if row.empty < ANCHOR_NONE || row.empty > ANCHOR_ALT {
        return "role '{row.name}': {row.empty} is not an anchor";
    }
    if row.laden < ANCHOR_NONE || row.laden > ANCHOR_ALT {
        return "role '{row.name}': {row.laden} is not an anchor";
    }
    // ⚠ Half a cycle is an authoring error rather than a special case: a
    // role that has one anchor has a destination it can never leave.
    if (row.empty == ANCHOR_NONE) != (row.laden == ANCHOR_NONE) {
        return "role '{row.name}': one leg goes nowhere and the other does not";
    }
    if row.empty == row.laden && row.empty != ANCHOR_NONE {
        return "role '{row.name}': both legs end at the same anchor, "
               + "so the round trip has no length";
    }
    // ⚠⚠ **A clock may steer a role only if it has no bag**
    // (`docs/ERRANDS.md` § THE BAG STEERS), and there is no check for it
    // here because there is nothing to check: `errand_arrive` refuses a
    // row with a period, so a clock-steered role's bag is empty for the
    // life of the run and `errand_leg` never reaches the branch that
    // would ask it.  ⚠ The constraint is CONSTRUCTED rather than
    // asserted, which is the stronger of the two.
    ""
}

// Why the shipped table is not a table, or "".
//
// ⚠ It asks three things a compiler cannot: every row is legal, no two
// rows share a name, and `ROLE_KIND_COUNT` still counts them.
//
// Example: @DRY-144, @DRY-148
pub fn errand_table_fault() -> text {
    etf_all = errand_roles();
    if len(etf_all) != ROLE_KIND_COUNT {
        return "the table has {len(etf_all)} rows and ROLE_KIND_COUNT says "
               + "{ROLE_KIND_COUNT}";
    }
    etf_i = 0;
    for etf_row in etf_all {
        etf_f = errand_row_fault(etf_row);
        if etf_f != "" { return etf_f; }
        etf_j = 0;
        for etf_other in etf_all {
            if etf_j > etf_i && etf_other.name == etf_row.name {
                return "two roles are both called '{etf_row.name}'";
            }
            etf_j += 1;
        }
        etf_i += 1;
    }
    ""
}

// ─── ⚠⚠ THE MOVER — the ONE DOOR that writes a mob's position ───
//
// Plan 30 R3, and `@FR-E-One-Door` is the whole shape of it: *exactly
// one function moves a mob on a cycle, and it owns `slip`.*  ⚠ § Count
// the RE-ASSERTION SITES lists **twelve** places that could write a
// position and forget the bookkeeping, and **every omission is silent**
// — a forgotten `slip` does not fail to compile and does not throw, the
// mob simply arrives early.  So four of the twelve are collapsed by
// there being nothing else that may move a mob at all.
//
// ⚠ **It adds no mover.**  `enemy_step`'s engage branch has descended a
// field toward the core since plan 11 F5, and F7b's *blocked by a
// COMPANION → step beside; blocked by the GROUND → stand* is the rule
// this reuses with the destination changed.  What approach mode never
// had is the FIELD — `enemy_walk_heading` says so itself, *"having no
// field to say which way beside is"* — and an anchor supplies one.
//
// ── ⚠⚠ WHAT IS EXACT, AND IT IS THE PHASE RATHER THAN THE HEX ───
//
// ⚠⚠ **`@FR-E-Slip` says a body pushed off its cycle *re-converges on
// the same hex* — the ANCHOR — and it does NOT say the body is on the
// rule's hex while it is being pushed.**  That distinction is this
// section's finding and it is worth stating before the code:
//
//   * a mob nothing has pushed walks `flow_steps[0]` every step, which
//     is exactly what `flow_route` built the round out of, so it stands
//     on `cycle_at`'s hex at the end of every tick — **hex equality is
//     total in a world with nothing to deviate it**;
//   * a mob that takes a DIFFERENT strictly-closer step because a
//     companion is on the first is on another route of the same length.
//     It loses no time and it is not on the rule's hex;
//   * a mob that can only SIDESTEP loses exactly one hex of progress,
//     and that is what `slip` pays for.
//
// ⚠⚠ **So the invariant that is total is the PHASE**: a mob's distance
// to its current anchor equals the rule's distance to it, always, for
// every deviation.  Hex equality is the special case of it where nothing
// blocked.  ⚠ That is what R5's bound needs (`@FR-E-Boundable` is stated
// in field distance) and what `plans/30` § Rc gates.
//
// ── ⚠⚠ A LOST HEX IS A WHOLE NUMBER OF BASE UNITS, OR IT IS NOT EXACT ─
//
// ⚠⚠ **The one arithmetic constraint in the phase, and it is `@M074`'s
// family with a different subject.**  For `cycle_walked(rate, t − slip)`
// to be *exactly* one hex short for **every** later `t`, `rate × slip`
// has to be a whole multiple of `BANK_WHOLE` — otherwise the floor
// disagrees at the `t` values whose fraction falls under the remainder,
// and the mob is a hex ahead of its own rule for part of every step.
//
// ⚠ So one lost hex costs `BANK_WHOLE / rate` units and the division
// must be EXACT.  `cycle_hex_units` is that number, `cycle_fault`
// refuses a rate that has not got one, and every speed the game ships —
// 1.0, 1.5 and 2.5 hex/s — divides `BANK_WHOLE` exactly.  ⚠⚠ **A speed
// that does not is an authoring error named at construction**, exactly
// as a clock period that is not a whole number of ticks is.
//
// ⚠ **Time the mob did not spend walking needs no such division**: the
// pre-walk window freezes the mob and `slip += elapsed` freezes `t −
// slip` with it, which is exact at any rate and any timestep.

// How many base units one hex of walking is worth at `rate` — 0 when
// the rate has no such number.
//
// ⚠⚠ **Zero means REFUSE, not free**: a rate that does not divide
// `BANK_WHOLE` cannot express *one hex late* as a time at all, and a
// caller that treated 0 as *no delay* would let a blocked mob keep its
// place in the rule.  `cycle_fault` is where it is turned into a
// refusal, so the mover never meets one.
//
// Example: @DRY-161
pub fn cycle_hex_units(rate: integer) -> integer {
    if rate <= 0 { return 0; }
    if ((BANK_WHOLE % rate) ?? 1) != 0 { return 0; }
    (BANK_WHOLE / rate) ?? 0
}

// One destination's field for this tick, and the class that reads it.
//
// ⚠ Keyed by the HEX and the CLIMB LIMIT — the same key `ClassField`
// uses one field over, for the same reason (`spawn.loft` § The fields):
// `climb_limit` is the class's whole contribution to passability, so two
// classes agreeing on it produce identical fields and building both is
// duplicated work that also invites them to drift.
pub struct ErrandField {
    q:     integer,
    r:     integer,
    climb: float,
    field: FlowField,
}

// A field for every distinct (destination, climb limit) among the mobs
// running a routine — each built once.
//
// ⚠⚠ **EMPTY when nothing is on a routine, which is every scenario in
// the tree today** — so the tick pays nothing for this and the 920 gate
// measurements cannot move.  That is the phase's inertness, constructed
// rather than promised.
//
// ⚠ `@M072` is what makes it affordable when it is not empty: a sweep
// over an authored map is **~500 cells** and a mob asks for at most
// three anchors, so a handful of POIs is a handful of sweeps.  ⚠⚠ It is
// rebuilt every tick and that is a stepstone: `plans/22`'s cache, keyed
// by exactly this pair, is where it stops being one, and `@X299`'s POI
// is where the cycle stops being rebuilt with it.
//
// Example: @DRY-169
pub fn errand_fields(state: const WaveState, pal: vector<GroundType>,
                     pw: PaintedWorld) -> vector<ErrandField> {
    ef2_out: vector<ErrandField> = [];
    for ef2_e in state.enemies {
        if !ef2_e.alive { continue; }
        ef2_job = errand_destination(ef2_e, state.now);
        if !ef2_job.found { continue; }
        ef2_c = climb_limit(ef2_e.kind);
        if errand_fields_have(ef2_out, ef2_job.q, ef2_job.r, ef2_c) { continue; }
        ef2_out += [ErrandField {
            q: ef2_job.q, r: ef2_job.r, climb: ef2_c,
            field: flow_build(pal, pw, state.heights, ef2_e.kind,
                              Hex { q: ef2_job.q, r: ef2_job.r }),
        }];
    }
    ef2_out
}

fn errand_fields_have(fields: const vector<ErrandField>, q: integer,
                      r: integer, climb: float) -> boolean {
    efh_seen = false;
    for efh_f in fields {
        if efh_f.q == q && efh_f.r == r && efh_f.climb == climb {
            efh_seen = true;
        }
    }
    efh_seen
}

// Is this robot running a routine that has somewhere to go?
//
// ⚠⚠ **THE DISPATCH, and it goes through `errand_destination` rather
// than through a flag** — so a robot the bubble has taken answers false
// here for the same reason it answers `ROLE_NONE` to `errand_role`, and
// site 5 of § Count the RE-ASSERTION SITES still has no second write to
// forget.  ⚠ A role whose row has no anchors answers false as well,
// which is `ROLE_NONE` and therefore the whole roster today.
//
// Example: @DRY-168, @DRY-169
pub fn errand_cycling(e: const Enemy, now: integer) -> boolean {
    ecy_job = errand_destination(e, now);
    ecy_job.found
}

// Move one mob on a routine by the hexes this timestep owes it — and
// pay for every one it could not spend.
//
// ⚠⚠ **THE ONE DOOR** (`@FR-E-One-Door`).  Nothing else may write
// `e.q` / `e.r` for a mob on a cycle, and `slip` is owned here so that
// there is no site left that could forget it.  ⚠ `enemy_move_to` is the
// one WRITE and this is the one DECISION — the nameable difference
// (`@X329`) is that the write keeps `Occupancy` true and knows nothing
// about routines, while this knows nothing about how a position is
// stored.
//
// ⚠⚠ **`now` is the moment the step BEGINS, never the one it ends at.**
// A mover decides where it is going and then spends the time; resolving
// the destination at the END would send a body down the leg it is about
// to be turned onto for the whole of the step before the turn.  ⚠ It is
// `tests/30_r2_the_cycle.loft`'s harness contract, and the two forms are
// indistinguishable for every role whose clock leaves it DWELLING at its
// post — which every shipped one does, so the corpus carries a guard
// with no dwell at all to keep the branch visible (`@M013`).
//
// ⚠ **The pre-walk window is TIME the mob did not spend walking**, so it
// is `slip` and nothing else: `enemy_tick` returns before banking, so
// freezing `now − slip` with it is exact at any rate and any timestep.
//
// ⚠ A hex the world refuses is SPENT and never re-banked, exactly as
// `enemy_tick` spends one — an errand mob held up by a queue must not
// store the hexes and then cross the map in one tick.  What is different
// is that the spending is RECORDED, which is the whole of `slip`.
//
// Example: @DRY-162, @DRY-163, @DRY-164, @DRY-165, @DRY-170, @DRY-171
pub fn errand_step(e: Enemy, fields: const vector<ErrandField>,
                   occ: Occupancy, blockers: const BlockerMap,
                   now: integer, elapsed: integer) {
    if !e.alive { return; }
    if enemy_standing(e) {
        e.route.slip += elapsed;
        return;
    }
    es2_row  = errand_role_of(errand_role(e));
    es2_cost = cycle_hex_units(bank_rate(enemy_speed(e.kind)));
    es2_left = enemy_bank(e, enemy_speed(e.kind), elapsed);
    while es2_left > 0 {
        if errand_hex(e, fields, occ, blockers, es2_row, now) {
            e.route.slip += es2_cost;
        }
        es2_left -= 1;
    }
}

// One hex of a routine: descend the field toward the leg's anchor, and
// turn the bag over on arrival.  Answers whether the mob LOST the hex.
//
// ⚠⚠ **The destination is re-read for every hex and so is the field**,
// which is `@X335`: a mob that walks past an anchor spends its remaining
// hexes on the NEXT leg and never loses them at the turn.  A field
// chosen once per tick would send a mob that arrived mid-tick on down
// the leg it had just finished.
//
// ⚠ **The arrival is asked AFTER the step**, exactly as
// `tests/30_r2_the_cycle.loft`'s stepped harness asks it — the rule and
// the body have to flip the bag at the same hex or they are describing
// two different mobs.
//
// ── ⚠⚠ A DWELL IS NOT A BLOCK, AND THE DIFFERENCE IS `slip` ─────
//
// ⚠⚠ **A mob standing ON its own destination has not lost anything**,
// and the check before the step is what says so rather than being the
// authoring guard it looks like.  A carrier can never be there — the
// arrival after its last step already turned the bag over and named the
// other anchor — so the only mob this can be is a CLOCK-steered one
// waiting out its period at its post.
//
// ⚠ **The rule agrees, by clamping**: `cycle_phase` caps a clock leg's
// offset at the leg's own length, so the hexes a dwelling guard's bank
// keeps releasing are ones the RULE does not spend either.  Charging
// `slip` for them would drag `now − slip` backwards for as long as the
// guard stood, and its clock would then never flip at all — a guard
// frozen at its post with **every conformance count green**, because
// the frozen rule agrees with the frozen body.
fn errand_hex(e: Enemy, fields: const vector<ErrandField>,
              occ: Occupancy, blockers: const BlockerMap,
              row: const Role, now: integer) -> boolean {
    errand_arrive(e.route, row, Hex { q: e.q, r: e.r }, now);
    ehx_job = errand_destination_of(row, e.route, now);
    if !ehx_job.found { return false; }
    if ehx_job.q == e.q && ehx_job.r == e.r { return false; }
    ehx_c  = climb_limit(e.kind);
    ehx_on = false;
    for ehx_f in fields {
        // ⚠ The field is passed STRAIGHT from the vector into a `const`
        // parameter and never bound to a local — a whole-value bind
        // COPIES the cell hash, per mob, per hex (`spawn.loft` § Reading
        // a class's field WITHOUT copying it: **2250x**).
        if ehx_f.q == ehx_job.q && ehx_f.r == ehx_job.r
            && ehx_f.climb == ehx_c {
            ehx_on = errand_descend(e, ehx_f.field, occ, blockers);
        }
    }
    if ehx_on { errand_arrive(e.route, row, Hex { q: e.q, r: e.r }, now); }
    !ehx_on
}

// One step down a field toward its destination — closer if anything
// closer is free, BESIDE if only a companion stopped it, and standing
// still otherwise.  Answers whether the distance actually fell.
//
// Enforces @FR-E-Non-Increasing: the two lists it reads are
// `flow_steps` (strictly closer) and `flow_sidesteps` (exactly equal),
// so a mob's distance to its anchor can never grow.  ⚠⚠ That is not a
// detail of the sidestep — R0 probe 3 (`@X331`) is what makes R5's bound
// exist at all, and a variant admitting a FURTHER neighbour would look
// harmless here and silently take the bound with it.
//
// ⚠ **It is the same rule as `enemy_step`'s engage branch and it asks
// the same two questions in the same order**, which is what `plans/30`
// R3's *one actor, ONE occupancy rule* means: `crawler` paid for the
// other answer — *"one actor cannot have two contradictory occupancy
// rules across its two states.  A sleeping monster is not terrain."*
//
// ⚠ No `can_step` here, and deliberately: the field already refused
// every hex this class cannot enter, exactly as the engage branch's
// does.  The desire field is the one that needs the second question,
// because walls are passable in it.
fn errand_descend(e: Enemy, f: const FlowField, occ: Occupancy,
                  blockers: const BlockerMap) -> boolean {
    edd_d = flow_distance(f, e.q, e.r);
    if edd_d >= FLOW_UNREACHABLE { return false; }
    if edd_d == 0 { return false; }
    for edd_t in flow_steps(f, e.q, e.r) {
        if occupancy_taken(occ, edd_t.q, edd_t.r) { continue; }
        if blocker_taken(blockers, edd_t.q, edd_t.r) { continue; }
        enemy_move_to(e, edd_t.q, edd_t.r, occ);
        return true;
    }
    // ⚠ Every closer step the field offered was one the GROUND allowed,
    // so nothing being free can only mean a body — which is F7b's
    // unambiguous case and the one *beside* is the answer to.
    for edd_s in flow_sidesteps(f, e.q, e.r) {
        if occupancy_taken(occ, edd_s.q, edd_s.r) { continue; }
        if blocker_taken(blockers, edd_s.q, edd_s.r) { continue; }
        enemy_move_to(e, edd_s.q, edd_s.r, occ);
        // ⚠⚠ It MOVED and it made no progress, and the caller pays for
        // the difference — a sidestep is a hex of the round the mob
        // still owes, which is exactly what `slip` is.
        return false;
    }
    false
}

// ─── Where a robot's business ENDS ──────────────────────────────

// Has this robot finished its business here?
//
// ⚠⚠ **Its business is its HEADING** — `SETTING.md` says a spawn
// marker's direction is *what they were going before* — so a robot is
// done when it can go no further that way: the map's edge, a cliff,
// deep water.  It has crossed, and it goes on its way.
//
// ⚠ **Only a robot on an ERRAND is ever done.**  A cut-off robot that
// walks into a wall is besieging it, which is the whole of
// `ENEMY_MOVEMENT.md`; making that one leave would delete the game.
//
// ⚠ It asks `can_step`, the one passability rule, rather than a second
// idea of what stops a robot — the same reason `enemy_walk_heading`
// asks it.
//
// Example: @DRY-111
pub fn errand_done(e: const Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                   hl: const HeightLayer) -> boolean {
    if !e.errand { return false; }
    if !e.alive  { return false; }
    // ⚠⚠ **A ROBOT ON A ROUTINE IS NEVER DONE BY BUMPING INTO
    // SOMETHING** (`plans/30` R3).  Its business is a CYCLE and not a
    // heading, so *it can go no further this way* is not the end of it —
    // the mover walks it round whatever stopped it.  ⚠ Site 4 of
    // `plans/30` § Count the RE-ASSERTION SITES is *`errand_depart`
    // removes at the wrong time*, and without this line a hauler whose
    // spawn heading happened to face a cliff would be swept off the
    // roster on its first tick, mid-round, with nothing to see.
    // ⚠ **The ROW is asked and never the role id** (`@X333`) — *this
    // role has no cycle* is exactly *its legs go nowhere*.
    // ⚠ R4 is where a routine gains its own ending: a mob that finishes
    // its round leaves the roster at HOME (`@FR-E-Home-Is-A-Place`), and
    // this guard is what stops the heading answering first.
    ed_row = errand_role_of(errand_role(e));
    if ed_row.empty != ANCHOR_NONE { return false; }
    ed_from = Hex { q: e.q, r: e.r };
    ed_to   = lat_neighbour(ed_from, e.heading as integer);
    !can_step(pal, pw, hl, e.kind, ed_from, ed_to)
}

// Take every robot that has finished off the roster.  Answers how many
// went on their way.
//
// ⚠⚠ **It REMOVES rather than killing**, and the difference is the
// point: `wave_deaths` drops a body, pays salvage and raises the
// rubble that ramps a wall.  A robot that simply walked on leaves
// nothing behind, earns the player nothing, and was never theirs to
// kill.  Routing this through the death path would pay a wallet for
// traffic the player never touched.
//
// ⚠ Called at the tick's CONSEQUENCE stage beside the deaths, so a
// robot that finished this tick is gone for tick N+1 and every
// measurement inside this tick saw it.
//
// Example: @DRY-111
pub fn errand_depart(state: WaveState, pal: vector<GroundType>,
                     pw: PaintedWorld, hl: const HeightLayer) -> integer {
    ed_keep: vector<Enemy> = [];
    ed_gone = 0;
    for ed_e in state.enemies {
        if errand_done(ed_e, pal, pw, hl) {
            ed_gone += 1;
            continue;
        }
        ed_keep += [ed_e];
    }
    if ed_gone > 0 { state.enemies = ed_keep; }
    ed_gone
}

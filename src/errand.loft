// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A ROBOT GOING ABOUT ITS BUSINESS — traffic, and how it ends.
//
// BACKLOG B4.  ⚠⚠ **Every robot in the code was a WAVE** (`@X245`):
// the roster only ever grew from `wave_schedule_step`, every one of
// them walked toward the core, and none of them ever left.  A player
// landing on a fresh world saw an empty map until they poked a spawn
// marker.
//
// ⚠ `@X245` says the finished game's first fifteen minutes are
// SCOUTING, in a world that is alive — *"robots in their normal work
// flow, busy with whatever project they happen to be in"* — and names
// three things it needs.  Two now exist: somebody to point at it
// (text, `@X268`) and somewhere to go (§ X1's rings).  **This is the
// third.**
//
// ── ⚠⚠ Traffic and waves are the SAME robots ────────────────────
//
// `ROBOT_ECONOMY.md` § The graph: *"Material flows along the edges;
// the flow is the traffic; **the traffic is the waves**."*  And
// `SETTING.md` § Why waves happen: a wave is *"the gradual accretion
// of individual cut-off robots"*, where a spawn marker is *"where
// cut-off robots first enter the bubble's edge"* and **the marker's
// direction is the heading they were going BEFORE**.
//
// So this file adds **no mover and no second AI** — `DESIGN.md` § 10's
// rule, and `ROBOT_ECONOMY.md` § The governing rule states it again:
// *an installation that needs its own movement code has broken it*.
// `spawn.loft::enemy_walk_heading` has walked a robot along its
// business since plan 11 F5b.  What was missing is at both ends:
//
//   ⚠ **a robot's business never ENDED** — walk into a cliff or the
//     sea and it stands there for the rest of the run, so traffic
//     would silt the map up rather than cross it;
//   ⚠ **and nothing ever started one** that the wave schedule had not.
//
// ── ⚠⚠ The bubble is the whole mechanic ─────────────────────────
//
// A robot on an errand that enters the scrambler bubble **loses its
// errand** — its link is cut, it is one of the wave, and it never goes
// back.  That is `SETTING.md`'s fiction made mechanical, and it is
// what `ROBOT_ECONOMY.md` means by *"the only thing that matters is
// which edges the base happens to sit on"*:
//
//   **the same traffic is scenery or a wave, and where you landed is
//   what decides which.**
//
// ⚠ Measured rather than asserted — `tests/b4_the_errand.loft` runs one
// traffic rate past a marker outside the bubble and the same rate past
// one inside it, and reads scenery in the first and a siege in the
// second.
//
// ── What keeps the 679 gate measurements still ──────────────────
//
// ⚠⚠ `Enemy.errand` defaults **false**, so every robot in every
// existing scenario is a cut-off robot exactly as before, and traffic
// is off until a `.keys` file says `traffic <rate>`.  [loft#914]'s
// silent default lands on *the way the game already worked*, which is
// the only direction it could safely land.

use spawn;
use markers;
use lattice;
use passable;
use flow;
use painted;
use palette;
use height;
use occupancy;
use fixstep;
use task;
use carry;
use vehicle;

// Robots per second one source puts on the road, when a map says
// nothing — `traffic <rate>` is how a scenario says otherwise.
//
// ⚠ ZERO, and that is the load-bearing default: ambient life is opt-in
// so that the 35 gated scenarios measure the game they always did.
pub const TRAFFIC_RATE_DEFAULT: float = 0.0;

// One map's ambient traffic.
//
// ⚠ A `Bank` rather than a timer, and for `fixstep`'s own reason: a
// rate banked in integer base units releases whole robots exactly at
// every tick length, where a float accumulator comes up short (`@M049`
// is the same mistake one system over).  ⚠ The RATE is stored because
// it is a property of the map; the bank holds only the carry.
pub struct Traffic {
    rate: float,
    bank: Bank,
}

// Factory: a quiet map.
pub fn traffic_new() -> Traffic {
    Traffic { rate: TRAFFIC_RATE_DEFAULT, bank: bank_new() }
}

// Set how busy this map is, in robots per second.
//
// ⚠ Negative is clamped to nothing rather than refused: a map is quiet
// or it is busy, and there is no third thing a negative rate could
// mean.
//
// Example: @DRY-110
pub fn traffic_set(t: Traffic, rate: float) {
    t.rate = max(rate, 0.0);
}

// Is any traffic running?
pub fn traffic_running(t: const Traffic) -> boolean {
    t.rate > 0.0
}

// How many robots this map puts on the road over `elapsed`.
//
// ⚠ It SPENDS the bank, so a caller asks once per tick — the same
// contract `enemy_bank` and `helper_bank` have.
//
// Example: @DRY-110
pub fn traffic_due(t: Traffic, elapsed: integer) -> integer {
    if !traffic_running(t) { return 0; }
    bank_gain(t.bank, bank_rate(t.rate), elapsed, BANK_WHOLE)
}

// ─── ⚠⚠ THE ROUTINE — five anchors, and the BAG steers ──────────
//
// Plan 30 R1.  `docs/ERRANDS.md` § What a mob carries is the design and
// `@FR-E-Rule-Not-State` is the rule: **a mob's position is a FUNCTION,
// not a memory**, so what a robot holds is a handful of fixed anchors
// and the route is DERIVED from them every time it is asked.
//
// ⚠⚠ **There is no waypoint list here and there must never be one.**  A
// stored path has to be maintained — invalidated when the world changes,
// resumed after a deviation, saved and reloaded — and a destination
// computed from five fields needs none of that: **deviation is free
// precisely because there is nothing to resume.**  It is
// `pose.loft`'s *read the sim, never a second flag* one system over.
//
// ── ⚠⚠ THE BAG STEERS, NOT THE CALENDAR  `@FR-E-Bag-Steers` ─────
//
// The one rule in this section that was MEASURED rather than reasoned,
// and it was measured in `../crawler` (`src/sim.loft:2513`):
//
// > *"This used to alternate by day parity … the picking ground is 50
// > hexes out, a day carries it 13, and the leg flipped every day — so
// > it oscillated between home and 13 hexes out, forever.  In 21 days
// > it gathered nothing … Keyed on the bag the trip is self-correcting
// > at any distance."*
//
// ⚠⚠ **dryopea has that hazard and worse**, because `@X298` makes a
// route cross a 1.5 km cell: **any period you could pick is shorter
// than the trip.**  So `errand_leg` asks the BAG, and the loop closes
// itself at 4 hexes and at 400 with no clock in it at all.
//
// ⚠ **GUARD is the one role a clock may steer**, and only because it
// has no bag and its two legs are equidistant by construction.  That is
// a fact about the ROLE, so it is a COLUMN (`period`) and not a branch.
//
// ⚠⚠ **The rule has TWO sites and they are two HALVES, not two
// implementations** (`@X329` asks for the difference to be named):
// `errand_leg` READS the bag to choose a leg, `errand_arrive` FILLS and
// EMPTIES it on arrival.  Neither is the rule on its own — a bag nothing
// fills makes the leg constant for ever, which is a mob that arrives and
// stands there, the same failure reached from the other side.  ⚠ This
// section is the ARGUMENT; those two functions are the enforcement.
//
// ── ⚠⚠ A ROLE IS A ROW, FROM THE FIRST LINE  `@X322` ────────────
//
// `../crawler` split here and its own comments say the split hurt:
// hostiles are pure data over one code path, while civilians are
// hard-coded `role == 7` integer comparisons in **eight** places, and
// `src/sim.loft:145` records that the role list *"stopped at 6 while
// 7-12 were in use, which costs a reader real time."*
//
// ⚠⚠ **So the table is INDEXED and never compared**, and
// `tests/30_r1_the_errand.loft` reads every `src/*.loft` back to prove
// it: a comparison against a `ROLE_` constant anywhere in `src/` is the
// defect, and it is the only form crawler's could have taken.
//
// ⚠ **And a row must not promise behaviour the engine does not have.**
// Four of crawler's eleven monster flags are declared in its table and
// read by no AI code at all — `@X112`'s *check the number exists first*
// from the other end.  So every column here is read the moment it
// exists: `errand_leg` reads four of them and R4's `shift` is read by
// `errand_done`; **what draws a role off its route is deliberately NOT
// a column yet** — that is R7, and it gets one when something reads it.
//
// ── ⚠ Why `carry` is not `carry.loft`'s  `@FR-F-Nameable-Difference` ─
//
// CLAUDE.md says *never a "carried" field on the carrier as well*, and
// this is a field on the carrier — so the difference has to be NAMEABLE
// and it has to be a fact about the domain (`@X329`).  It is:
//
// > **`carry.loft` conserves an object that is ON THE MAP and that the
// > player could pick up instead; a mob's bag holds material that was
// > never on the map and never will be.**
//
// A `CarryObject` has an `owner` and conservation is structural because
// a tower top exists whether or not anybody is holding it.  A hauler's
// load comes from off-map and leaves with the hauler, so there is no
// object to conserve and no second copy to disagree with.
//
// ⚠⚠ **R7b is where that stops being true and the obligation is here so
// it is not discovered there**: the moment a mob picks up *the player's
// salvage heap* it is holding a thing the player could have had, and
// that load must be a `carry.loft` object with the bag as the routine's
// READING of it — never a second ledger.

// ⚠⚠ **NOTHING IN THE TICK CALLS ANY OF THIS YET, AND THAT IS THE
// PHASE.**  R1 lands the record, the table and the derived destination;
// `errand_leg` is what R3's mover will descend a field toward, and R2 is
// what makes `cycle_at` evaluable at an arbitrary `t`.  Until then every
// robot in every scenario reads `ROLE_NONE`, which is today's game.

// ─── The roles ──────────────────────────────────────────────────

// ⚠⚠ **`ROLE_NONE` is 0 and that is load-bearing** ([loft#914]): a
// struct literal that omits a field takes its default silently, so the
// neutral value has to be the one every `Enemy { … }` literal written
// before this phase already means — **no cycle at all**, which is a
// cut-off robot walking to the core and an ambient one walking the
// bearing its spawn marker gave it.  Both of those are the whole roster
// today and neither has a routine.
pub const ROLE_NONE:   integer = 0;
pub const ROLE_HAUL:   integer = 1;   // load at the face, drop at the depot
pub const ROLE_GATHER: integer = 2;   // cut at the face, carry it to the nest
pub const ROLE_GUARD:  integer = 3;   // the post and its second leg
pub const ROLE_HARVEST: integer = 4;  // pick, dump, and go for service

// ⚠⚠ **`haul` IS THE PLANT-MATERIAL GATHERER'S SHAPE, AND `gather` IS
// THE NEST'S** — the distinction the world makes and the one this file
// got wrong first (owner, 2026-08-29; `SETTING.md` § There is no fossil
// carbon, `ROBOT_ECONOMY.md` § 6).
//
// ⚠ The planet has no gas, oil or coal, so every gram of fuel and of
// plastics feedstock starts as harvested growth — which makes the
// harvester the commonest machine in the world, and gives it **three
// places, not two**: the picking ground it works, the **first-pass
// processing point it dumps at**, and a **repair point**, which is a
// different installation.  That is `work`, `alt` and `home`, and it is
// exactly `haul`'s two columns with `home` off the round.
//
// ⚠ `gather` is the shape where the drop-off IS the home — a nest, or
// any node that both receives the load and services the carrier.  Its
// round touches home, so R4's ending reaches it with no extra leg.
//
// ⚠⚠ **AND R4b IS WHERE THE HARVESTER GOT ITS OWN ENDING** (`@X341`,
// `@M078`): the
// `harvest` row is `haul`'s two legs with a SHIFT, and a shift on a
// round that does not pass home grows a **terminal leg** — the working
// legs repeat, and then the mob walks once to the repair point and off
// the roster.  ⚠ `haul` keeps no shift and is the route that does not
// end; the two are one mechanism and a column of data apart.

// How many rows the table has.  ⚠ `errand_table_fault` holds the table
// to it, which is the half crawler's *"stopped at 6 while 7-12 were in
// use"* was missing.
pub const ROLE_KIND_COUNT: integer = 5;

// Which of a routine's three anchor hexes a leg ends at.
//
// ⚠ `ANCHOR_NONE` is 0 for the same [loft#914] reason, and it means
// *this role has no destination of its own* — `errand_destination` then
// answers `job_none()` and the enemy mover keeps the field it always
// had.
pub const ANCHOR_NONE: integer = 0;
pub const ANCHOR_HOME: integer = 1;
pub const ANCHOR_WORK: integer = 2;
pub const ANCHOR_ALT:  integer = 3;

// ⚠⚠ **THE LEG SELECTOR, and it is called the bag because two of its
// three values are cargo.**  A mob's whole steering state is this one
// number — `errand_leg` reads it, `errand_arrive` writes it, and there is
// nothing else anywhere that could disagree with it, which is
// `@FR-E-Place-State` read as a budget rather than as a prohibition.
//
// ⚠ Zero is empty, so a partial literal is a robot carrying nothing.
//
// ⚠⚠ **`HOMEWARD` is R4b's TERMINAL leg, and it is a LATCH rather than
// a cargo** (`@X341`) — the round is over and this mob is walking to a
// repair point its round does not pass (`@X339`).  It lives in the bag because
// *the bag steers* (`@FR-E-Bag-Steers`) and an ending is a steering
// decision: a second field saying *am I finished* would be a clock in
// all but name, and `errand_leg` would then have two things to read and
// a rule for when they disagree.
//
// ⚠⚠ **It is latched at an ARRIVAL and never at a moment**, and that
// is what makes the body agree with the closed form by construction
// (`@M077`): the bag turns over at the drop-off, so *the first empty leg
// after the shift* is exactly `T = ceil(S / period) × period` and there
// is no boundary in TIME anywhere for a timestep to land inside.
pub const ERRAND_BAG_EMPTY:    u8 = 0;
pub const ERRAND_BAG_LOAD:     u8 = 1;
pub const ERRAND_BAG_HOMEWARD: u8 = 2;
pub const ERRAND_BAG_COUNT: integer = 3;

// ⚠⚠ **THE BAG'S NAMES, and they are a TABLE for `@X333`'s reason** —
// a `.keys` file says `empty` and never `0`, so a fourth value of the
// bag is spellable the day it exists and the WRITER and the READER come
// out of one row (`@D007`).
//
// ⚠ The order IS the constants' order and `errand_table_fault` holds it
// to that; a row moved without its constant would rename two bags at
// once and nothing would throw.
pub fn errand_bags() -> vector<text> {
    ebs: vector<text> = [];
    ebs += ["empty"];
    ebs += ["load"];
    ebs += ["homeward"];
    ebs
}

// What is in this bag, as a word.  ⚠ The ONE lookup.
pub fn errand_bag_name(bag: u8) -> text {
    ebn_all = errand_bags();
    ebn_i   = bag as integer;
    if ebn_i < 0 || ebn_i >= len(ebn_all) { ebn_i = 0; }
    ebn_all[ebn_i] ?? "empty"
}

// Every bag, as one comma-separated phrase — `errand_role_names`'s twin.
pub fn errand_bag_names() -> text {
    ebm_out = "";
    for ebm_n in errand_bags() {
        if ebm_out != "" { ebm_out = ebm_out + ", "; }
        ebm_out = ebm_out + ebm_n;
    }
    ebm_out
}

// The bag a script spells `name`, or -1 — which a caller must REFUSE
// rather than read as empty, because *a word nobody knows* and *this
// mob is carrying nothing* are opposite answers.
pub fn errand_bag_named(name: text) -> integer {
    ebd_i = 0;
    for ebd_n in errand_bags() {
        if ebd_n == name { return ebd_i; }
        ebd_i += 1;
    }
    0 - 1
}

// ─── ⚠⚠ WHAT DRAWS A ROLE OFF ITS ROUTE ─────────────────────────
//
// Plan 30 R7b, and `@FR-E-Built-Not-Seen` is the whole of it:
//
// > ⚠⚠ **A mob leaves its route for something the player DID or BUILT,
// > never for the player being SEEN.**
//
// ⚠ `crawler` measured what the other answer costs: without its *an
// incursion does not break formation for a hero it has merely seen*
// rule, raiders parked on a hero for seven days and *"the whole
// mechanism silently became 'monsters walk at the player', which the
// game already had"*.  ⚠⚠ So there is no radius here that looks at the
// PLAYER at all — a lure is a fact about the GROUND, and the only way to
// make one is to leave something on it.
//
// ⚠ `LURE_NONE` is 0 for [loft#914]'s reason a seventh time: a `Role`
// row that names no lure is a role nothing draws off its route, which is
// every role written before this phase.
pub const LURE_NONE:    integer = 0;
pub const LURE_SALVAGE: integer = 1;   // a heap the player left lying
pub const LURE_KIND_COUNT: integer = 2;

// How far off its route a hauler will go for a heap.
//
// ⚠⚠ **It is the ONE number that decides whether this mechanic exists**,
// and it is small on purpose: a reach that grew toward the scrambler
// bubble's 25 would make every robot on the map converge on the player's
// leavings, which is *monsters walk at you* wearing a different hat.
// ⚠ Four hexes is a heap you can SEE the robot turn for, and it is what
// `bound_of` pays for — R5's discs grow by exactly this much and the
// cull's reach with them.
pub const LURE_SALVAGE_REACH_HEXES: integer = 4;

// What draws a role off its route, and how far it will go.
//
// ⚠⚠ **A LURE IS A ROW AND THE TABLE IS INDEXED** — `@X333`'s rule with
// its third subject, after the roles and the places.  The one column
// that matters is the REACH, because *how far* is the whole difference
// between a distraction and a swarm.
pub struct Lure {
    name:  text,
    reach: integer,
}

pub fn errand_lure_row(name: text, reach: integer) -> Lure {
    Lure { name: name, reach: reach }
}

// ⚠⚠ **THE LURE TABLE.**  A lure the engine does not know reads as
// `LURE_NONE` rather than as a branch nobody took.
pub fn errand_lures() -> vector<Lure> {
    els: vector<Lure> = [];
    els += [errand_lure_row("none",    0)];
    els += [errand_lure_row("salvage", LURE_SALVAGE_REACH_HEXES)];
    els
}

// The row for a lure — `LURE_NONE`'s for anything the table has not got.
// ⚠ The ONE lookup; nothing else may index the table.
pub fn errand_lure_of(lure: integer) -> Lure {
    elo_all = errand_lures();
    elo_i   = lure;
    if elo_i < 0 || elo_i >= len(elo_all) { elo_i = LURE_NONE; }
    elo_all[elo_i] ?? errand_lure_row("none", 0)
}

// The lure a script or a measurement spells `name`, or `LURE_NONE`.
pub fn errand_lure_named(name: text) -> integer {
    eln_i = 0;
    for eln_row in errand_lures() {
        if eln_row.name == name { return eln_i; }
        eln_i += 1;
    }
    LURE_NONE
}

// Does the table have a lure of this name at all?  ⚠ `errand_role_known`'s
// twin, and for its reason: `none` is a legal word.
pub fn errand_lure_known(name: text) -> boolean {
    errand_lure_of(errand_lure_named(name)).name == name
}

// Every lure, as one comma-separated phrase — for a REFUSAL that names
// what it would have accepted.
pub fn errand_lure_names() -> text {
    elm_out = "";
    for elm_row in errand_lures() {
        if elm_out != "" { elm_out = elm_out + ", "; }
        elm_out = elm_out + elm_row.name;
    }
    elm_out
}

// How long a guard stands one leg of its post, in `fixstep` base units
// — 10 s, which is 15 ticks at today's 2/3 s.
//
// ⚠ It is the only period in the file and it belongs to the one role
// `docs/ERRANDS.md` lets a clock steer.  A number here for a role that
// CARRIES would be the crawler defect with dryopea's name on it.
//
// ⚠⚠ **IT IS A WHOLE NUMBER OF TICKS AND THAT IS A CONSTRAINT, NOT A
// COINCIDENCE** — `cycle_fault` refuses one that is not (`@M074`): a leg
// boundary in TIME lands wherever the timestep puts it, so a period the
// step does not divide leaves the body a hex ahead of its own rule for
// as long as the leg lasts.
//
// ⚠⚠ **AND IT CANNOT SEE ITS OWN ROUNDING** (`@M014`'s class): ten
// seconds at 1.0, 1.5 and 2.5 hex/s is 10, 15 and 25 WHOLE hexes, so the
// bank's carry is exactly zero at every flip and `cycle_phase`'s
// difference-of-two-walks agrees with the naive form **for any
// implementation**.  ⚠ `tests/30_r2_the_cycle.loft` sweeps a 16-tick
// NEIGHBOUR for that reason, and a change to this number must keep the
// sweep — never rely on the shipped value to exercise the branch.
pub const GUARD_LEG_UNITS: integer = 30000000;

// How long a gatherer keeps taking rounds before it stays at the nest,
// in `fixstep` base units — 120 s, which is 180 ticks at today's 2/3 s.
//
// ⚠⚠ **It is a MULTIPLE of the round and not a round**
// (`@FR-E-Home-Is-A-Place`).  A gatherer's round over a scenario-sized
// map is twenty to thirty seconds, so this is four to six of them —
// which is the owner's *"once in a while"* rather than *every trip*.  A
// shift of one round would make a carrier a one-shot delivery and the
// traffic would stop being traffic.
//
// ⚠ **It does NOT have to be a whole number of ticks**, and the
// difference from `GUARD_LEG_UNITS` is worth naming rather than
// copying: a clock PERIOD picks a leg, so a boundary landing inside a
// step leaves the body a hex ahead of its own rule (`@M074`).  A shift
// picks nothing — it is read once a tick at the consequence stage and
// only ever while the mob is standing on its home anchor, so a boundary
// inside a step is a departure one tick later and nothing else.
pub const GATHER_SHIFT_UNITS: integer = 360000000;

// How long a harvester keeps taking rounds before it goes for service,
// in `fixstep` base units — 180 s, which is 270 ticks at today's 2/3 s.
//
// ⚠⚠ **The commonest robot in the world ends its round here** (`@X339`,
// `@X340`): the planet has no fossil carbon, so every gram of fuel and
// of plastics feedstock starts as harvested growth, and the machine
// that picks it is the one there are most of.
//
// ⚠ **It is LONGER than a gatherer's shift and that is the domain, not
// a copy**: a nest insect goes home to STAY, a harvester goes to a
// repair point *"once in a while"* and — R4b does not build this —
// eventually comes back.  ⚠⚠ **And it is a whole number of hexes at
// every shipped speed**, which `cycle_fault` refuses a shift for not
// being: 540 000 000 units is 180, 270 and 450 hexes at 1.0, 1.5 and
// 2.5 hex/s.
pub const HARVEST_SHIFT_UNITS: integer = 540000000;

// One role, as a row: where it goes empty, where it goes loaded,
// whether a clock or the bag decides which, and how long it keeps
// doing it.
//
// ⚠ `period` of 0 means **the bag steers** — it is not a missing number,
// it is the answer, and `errand_leg` reads it as one.
//
// ⚠ `shift` of 0 means **this role never ends** — also an answer, and
// `errand_done` reads it as one.  ⚠⚠ A row with a shift must have HOME
// as one of its two anchors or the shift is a promise its round cannot
// keep, and `errand_row_fault` refuses one that has not (§ Home is a
// PLACE).
pub struct Role {
    name:   text,
    empty:  integer,
    laden:  integer,
    period: integer,
    shift:  integer,

    // ⚠⚠ **WHAT DRAWS THIS ROLE OFF ITS ROUTE** (R7b) — the fifth
    // column, and the one `plans/30` § R1 said was *deliberately not a
    // column yet*.  It indexes `errand_lures()` and is compared to
    // nothing, exactly as `role` indexes `errand_roles()`.
    //
    // ⚠ `LURE_NONE` is 0, so a row that does not name one is a role
    // nothing distracts — which is every role R1 through R7a shipped.
    lure:   integer,
}

pub fn errand_row(name: text, empty: integer, laden: integer,
                  period: integer, shift: integer, lure: integer) -> Role {
    Role { name: name, empty: empty, laden: laden, period: period,
           shift: shift, lure: lure }
}

// Does this row's round END somewhere the round does not pass?
//
// ⚠⚠ **The one question that separates the harvester from the nest**
// (`@X339`), and it is answered from the ROW's two anchors alone.  A
// round that already touches `home` ends the way R4 ends it — the mob
// leaves the roster the tick its own cycle brings it there — and one
// that does not needs a **terminal leg**: the working legs repeat until
// the shift, then one walk home.
//
// ⚠ It is asked in four places and they must all agree, which is why it
// is a function rather than the condition written out: `cycle_build`
// grows the leg, `cycle_phase` turns onto it, `errand_arrive` latches
// the bag at the turn, and `errand_home_done` reads the latch back.
//
// Example: @DRY-178
pub fn errand_terminal(row: const Role) -> boolean {
    row.shift > 0 && row.period == 0
        && row.empty != ANCHOR_HOME && row.laden != ANCHOR_HOME
}

// ⚠⚠ **THE TABLE.**  Every role in the game is a row here and there is
// no `role ==` anywhere — `errand_role_of` indexes it, and a role the
// engine does not know reads as `ROLE_NONE` rather than as a branch
// nobody took.
//
// Example: @DRY-144, @DRY-149, @DRY-152
pub fn errand_roles() -> vector<Role> {
    ers: vector<Role> = [];
    ers += [errand_row("none",   ANCHOR_NONE, ANCHOR_NONE, 0, 0, LURE_NONE)];
    // ⚠ The harvester's row: out to the picking ground empty, back to
    // the first-pass plant laden, `home` the repair point it does not
    // visit on its round.  ⚠⚠ **A distribution robot is the SAME row** —
    // out empty, back loaded — differing only in how far apart its
    // anchors are and what is in the bag, which is `DESIGN.md` § 10's
    // *one AI, per-class DATA* rather than a second row.
    //
    // ⚠⚠ **AND IT IS THE ROW YOUR SALVAGE HEAP DISTRACTS** (R7b,
    // `@FR-E-Built-Not-Seen`): a hauler runs out with EMPTY HANDS, so a
    // heap the player left on its route reads as spilled cargo and it
    // picks the load up.  ⚠ The counter-play is `docs/ERRANDS.md`'s own
    // — *clear the heap early; that is a trip in the worst place.*
    ers += [errand_row("haul",   ANCHOR_WORK, ANCHOR_ALT,  0, 0,
                       LURE_SALVAGE)];
    // ⚠⚠ **`gather` AND `guard` HAVE NO LURE, AND THAT IS THE PAIR THE
    // MEASUREMENT NEEDS** (R7b).  A gatherer cuts what it was sent for
    // and a guard is standing a post; neither is a robot with empty
    // hands and a depot to fill, which is the whole reason a hauler
    // reads a heap as spilled cargo.  ⚠ So the same scenario run with a
    // `gather` route is the CONTROL — one table column apart, exactly as
    // `@M073`'s clock-steered hauler was.
    ers += [errand_row("gather", ANCHOR_WORK, ANCHOR_HOME, 0,
                       GATHER_SHIFT_UNITS, LURE_NONE)];
    ers += [errand_row("guard",  ANCHOR_WORK, ANCHOR_ALT,  GUARD_LEG_UNITS,
                       0, LURE_NONE)];
    // ⚠⚠ **THE HARVESTER — `haul`'s shape with an ENDING** (R4b,
    // `@X339`).  Same two working legs and the same walker; what the
    // column adds is a shift, and what the shift buys is a THIRD leg the
    // round walks once: the repair point, which is not the dump.
    //
    // ⚠ **`haul` beside it is not a duplicate**, and the difference is a
    // fact about the domain rather than about the code (`@X329`): a
    // distribution robot on a long route between two nodes is a round
    // the player never sees end, and a harvester's service trip is the
    // ending this phase exists to give it.  ⚠⚠ Two catalogue rows, one
    // mechanism, and the difference is DATA — which is what a catalogue
    // is for (`@X322`).
    ers += [errand_row("harvest", ANCHOR_WORK, ANCHOR_ALT, 0,
                       HARVEST_SHIFT_UNITS, LURE_SALVAGE)];
    ers
}

// The row for a role — `ROLE_NONE`'s for anything the table does not
// have.  ⚠ It is the ONE lookup; nothing else may index the table.
//
// Example: @DRY-144
pub fn errand_role_of(role: integer) -> Role {
    ero_all = errand_roles();
    ero_i   = role;
    if ero_i < 0 || ero_i >= len(ero_all) { ero_i = ROLE_NONE; }
    ero_all[ero_i] ?? errand_row("none", ANCHOR_NONE, ANCHOR_NONE, 0, 0, LURE_NONE)
}

// Every role, as one comma-separated phrase — for a REFUSAL that names
// what it would have accepted.  ⚠ Derived and never written out, which
// is `enemy_class_names`'s rule: a hand-kept list in an error message
// drifts, and one naming a role the table has not got sends a reader
// looking for it.
pub fn errand_role_names() -> text {
    ern2_out = "";
    for ern2_row in errand_roles() {
        if ern2_out != "" { ern2_out = ern2_out + ", "; }
        ern2_out = ern2_out + ern2_row.name;
    }
    ern2_out
}

// Does the table have a role of this name at all?
//
// ⚠⚠ **IT EXISTS BECAUSE `errand_role_named` CANNOT SAY NO** (`plans/30`
// R7a).  That function answers `ROLE_NONE` for a word it does not know
// — and `"none"` is a legal word, so *a typo* and *the role with no
// round* come back the same number.  A caller that wanted to refuse a
// typo therefore reached for `== ROLE_NONE`, which is exactly the
// comparison `@X333` forbids and which `tests/30_r1_the_errand.loft`
// swept `src/` and CAUGHT.
//
// ⚠ So the question is asked of the ROW instead: a name comes out of the
// row it names, so *the row I got back is called what I asked for* is
// the whole test — and there is no role id anywhere in it.
pub fn errand_role_known(name: text) -> boolean {
    errand_role_of(errand_role_named(name)).name == name
}

// The role a script or a measurement spells `name`, or `ROLE_NONE`.
//
// ⚠ **The writer and the reader are ONE here** (`@D007` is what happens
// when they are two): a name comes out of the row it names, so a role
// added to the table is spellable the moment it exists.
pub fn errand_role_named(name: text) -> integer {
    ern_i = 0;
    for ern_row in errand_roles() {
        if ern_row.name == name { return ern_i; }
        ern_i += 1;
    }
    ROLE_NONE
}

// ─── What a mob carries ─────────────────────────────────────────

// Five anchors and a bag — everything a robot needs to know where it is
// going, and nothing else.
//
// ⚠⚠ **`@FR-E-Place-State`**: a mob may hold nothing beyond `carry` and
// `slip`, because there are many of them and they are everywhere.  State
// belongs to the PLACE — R5's POI — which is few and does not move.
//
// ⚠ `role` is an `integer` rather than `u8` where `docs/ERRANDS.md`
// wrote one: it indexes a table and is compared to nothing, and a `u8`
// would buy a byte at the price of a cast at every index.
pub struct Errand {
    role:  integer,
    home:  Hex,        // the maintenance point, or the nest
    work:  Hex,        // the face, the picking ground, the post
    alt:   Hex,        // the drop-off, or the second patrol leg
    carry: u8,         // what is in the bag — empty is 0
    slip:  integer,    // base units this mob has fallen behind (`@X302`)

    // Which `PoiWorld.mobs` record this body belongs to, ONE-BASED
    // (`plans/30` R6b).
    //
    // ⚠⚠ **Zero is *not a POI mob at all*, which is [loft#914]'s rule a
    // sixth time** — every `Enemy { … }` literal in the suite omits it,
    // and every routine a test builds by hand is a mob nobody's place
    // owns.  ⚠ One-based so that the default can mean absence: a
    // zero-based index would make record 0 indistinguishable from
    // nothing.
    //
    // ⚠⚠ **It is a BACK-pointer and never a forward one.**  The
    // materialiser asks *which bodies exist* by sweeping the roster for
    // this field, so nothing has to be kept in step when `wave_deaths`
    // compacts the roster — an index the other way round would be
    // silently invalidated by every death.
    mob:   integer,
}

// Factory: no routine at all, which is every robot in the game today.
pub fn errand_new() -> Errand {
    Errand { role: ROLE_NONE, home: Hex { q: 0, r: 0 },
             work: Hex { q: 0, r: 0 }, alt: Hex { q: 0, r: 0 },
             carry: ERRAND_BAG_EMPTY, slip: 0, mob: 0 }
}

// A routine, spelled out.  ⚠ Build from here or from `errand_new` and
// never from a partial literal — [loft#914] would take an anchor's
// default silently and put the drop-off on the core.
pub fn errand_at(role: integer, home: const Hex, work: const Hex,
                 alt: const Hex) -> Errand {
    Errand { role: role, home: home, work: work, alt: alt,
             carry: ERRAND_BAG_EMPTY, slip: 0, mob: 0 }
}

// Are two routines the same routine?
//
// ⚠ Field by field and exactly — `slip` is an integer since the record
// was written, so there is no epsilon to argue about here the way
// `compare.loft` once had to for a banked carry.
pub fn errand_same(a: const Errand, b: const Errand) -> boolean {
    a.role == b.role && a.carry == b.carry && a.slip == b.slip
        && a.mob == b.mob
        && a.home.q == b.home.q && a.home.r == b.home.r
        && a.work.q == b.work.q && a.work.r == b.work.r
        && a.alt.q  == b.alt.q  && a.alt.r  == b.alt.r
}

// ─── Where it is going ──────────────────────────────────────────

// Which routine this robot is running.
//
// ⚠⚠ **THE ONE DOOR FOR READING A ROLE, and it is what makes the
// bubble's one-way door impossible to forget.**  `wave_cutoff` clears
// `errand` and nothing else; a hauler that has lost its link reads
// `ROLE_NONE` HERE, so site 5 of `plans/30` § Count the RE-ASSERTION
// SITES cannot omit a second write because there is no second write to
// omit.  A reader that reached for `e.route.role` instead would see a
// robot still running a cycle it has been cut off from.
//
// Example: @DRY-151
pub fn errand_role(e: const Enemy) -> integer {
    if !e.errand { return ROLE_NONE; }
    e.route.role
}

// Where an anchor is.  ⚠ `ANCHOR_NONE` answers the origin, which no
// caller may use — `errand_destination_of` refuses that leg before it
// asks.
pub fn errand_anchor(er: const Errand, anchor: integer) -> Hex {
    if anchor == ANCHOR_HOME { return er.home; }
    if anchor == ANCHOR_WORK { return er.work; }
    if anchor == ANCHOR_ALT  { return er.alt; }
    Hex { q: 0, r: 0 }
}

// Which anchor this mob is making for — the whole of `@FR-E-Bag-Steers`
// in one expression.
//
// ⚠⚠ **The BAG is asked unless the row names a period**, and a row that
// names one is a role with no bag.  So the two steerings are one
// function reading one column, which is `@X329`'s *a healthy merge
// replaces a difference in CODE with a difference in DATA*.
//
// ⚠ `slip` is subtracted here and nowhere else: a mob that has been
// held up is genuinely later, so its clock reads earlier.
//
// Example: @DRY-145, @DRY-146, @DRY-150
pub fn errand_leg(row: const Role, er: const Errand, now: integer) -> integer {
    if row.period > 0 {
        el_t = now - er.slip;
        if el_t < 0 { el_t = 0; }
        if (el_t / row.period) % 2 == 0 { return row.empty; }
        return row.laden;
    }
    // ⚠⚠ **The TERMINAL leg, and it is one more value of the same
    // number** (R4b).  A latched bag is a mob whose round is over and
    // which is walking to a place the round never passes — read here so
    // that `errand_destination_of`, `errand_arrive` and the mover all
    // see one answer to *where am I going*.
    if er.carry == ERRAND_BAG_HOMEWARD { return ANCHOR_HOME; }
    if er.carry != ERRAND_BAG_EMPTY { return row.laden; }
    row.empty
}

// The bag a mob making for `anchor` must be carrying — `errand_leg`'s
// own map, read backwards.
//
// ⚠⚠ **IT EXISTS BECAUSE MATERIALISING A MOB HAS TO SET ONE** (`plans/30`
// R6a).  An un-materialised mob has no bag to read: its position is
// `cycle_at`, which asks the CLOCK and the CYCLE and never the bag.  So
// the moment it is given a body, something has to say what is in its
// hands, and the only true answer is *whatever agrees with the leg its
// own rule has it on* — a body handed the wrong bag steers to the wrong
// anchor on its very first step.
//
// ⚠ It is the INVERSE of one table and not a second reading of it: the
// difference between the two is the direction, which is nameable
// (`@FR-F-Nameable-Difference`), and `tests/30_r6a_the_tiers.loft` gates
// the round trip so they cannot drift apart.
//
// ⚠ **`row.laden` is asked before the terminal leg, and the order is
// REDUNDANT rather than load-bearing** — measured, not assumed
// (`@M081`).  A gatherer's laden anchor IS `home` (`@X338`) and would
// want LOAD there rather than the R4b latch, but `errand_terminal`
// already refuses a row whose `laden` is `ANCHOR_HOME`, so the two
// conditions can never both hold and swapping them changes nothing.
// ⚠ It is kept in this order because that is the order a reader checks
// them in, and because the redundancy is with `errand_terminal`'s own
// shape test rather than with a branch nobody reaches.
//
// Example: @DRY-191
pub fn errand_bag_for(row: const Role, anchor: integer) -> u8 {
    if anchor == row.empty { return ERRAND_BAG_EMPTY; }
    if anchor == row.laden { return ERRAND_BAG_LOAD; }
    if errand_terminal(row) && anchor == ANCHOR_HOME {
        return ERRAND_BAG_HOMEWARD;
    }
    ERRAND_BAG_EMPTY
}

// The hex this routine is making for, as a `Job`.
//
// ⚠⚠ **`Job` is `task.loft`'s and that is `@X332` cashed in**: a leg's
// destination is exactly a kind and a hex, and there is no nameable
// difference between the crew's record of one and a mob's.  What does
// NOT come across is the SELECTION — `jobs_in_scope` takes a `Skills`
// and `job_pick` chooses the nearest, and *a mob is TOLD where to go*.
//
// ⚠ `kind` is `TASK_ANY` for every role today, and the column is empty
// rather than guessed: **not one of the four kinds is what a hauler does
// at its face** — picking a load up is not clearing rubble — so the
// arrival ACTION waits for R7 to read one.  That is `@X112` from the
// other end, and a row promising behaviour the engine has not got is
// exactly what this file refuses to be.
//
// Example: @DRY-145
pub fn errand_destination_of(row: const Role, er: const Errand,
                             now: integer) -> Job {
    edo_a = errand_leg(row, er, now);
    if edo_a == ANCHOR_NONE { return job_none(); }
    edo_h = errand_anchor(er, edo_a);
    Job { found: true, kind: TASK_ANY, q: edo_h.q, r: edo_h.r }
}

// The same, for a robot on the roster.
//
// ⚠ It goes through `errand_role`, so a cut-off hauler answers
// `job_none()` and the mover it has always had takes it from there.
//
// Example: @DRY-147, @DRY-151
pub fn errand_destination(e: const Enemy, now: integer) -> Job {
    ed2_row = errand_role_of(errand_role(e));
    errand_destination_of(ed2_row, e.route, now)
}

// The mob is standing on its destination: turn the bag over.  Answers
// whether it did.
//
// ⚠⚠ **This is the other half of `@FR-E-Bag-Steers` and the cycle does
// not close without it.**  A bag that nothing fills makes `errand_leg`
// answer the same anchor for ever, which is a mob that arrives and
// stands there — the failure the bag was chosen to avoid, reached from
// the other side.
//
// ⚠ A clock-steered role has no bag, so it turns nothing over: `period`
// is the one column asked, in this function and in `errand_leg`, and the
// two agree because they read it rather than each deciding.
//
// Example: @DRY-145, @DRY-179, @DRY-183
// ⚠⚠ **`over` IS THE SHIFT, ASKED IN HEXES** (R4b, `@M077`): *has this
// mob walked out its round's span by the time it reached this hex?*  It
// is a parameter rather than a comparison made here because the mob's
// hex count is the MOVER's to keep — `errand_step` owns `slip` and
// therefore owns *how far have I actually come* — and because a
// boundary in TIME lands wherever the timestep puts it while one in
// DISTANCE is exact at any timestep.  ⚠ `errand_shift_over` is the one
// expression that answers it, and every caller goes through it.
pub fn errand_arrive(er: Errand, row: const Role, at: const Hex,
                     now: integer, over: boolean) -> boolean {
    if row.period > 0 { return false; }
    ea_a = errand_leg(row, er, now);
    if ea_a == ANCHOR_NONE { return false; }
    ea_h = errand_anchor(er, ea_a);
    if ea_h.q != at.q || ea_h.r != at.r { return false; }
    // ⚠ A latched mob has arrived at the END of its round: the bag is
    // not turned over again, because there is no next leg to steer onto
    // and `errand_home_done` is about to take it off the roster.
    if er.carry == ERRAND_BAG_HOMEWARD { return true; }
    // ⚠⚠ **THE LATCH, and it is the whole start of the terminal leg.**
    // The drop-off is where a round both ends and begins, so *the first
    // empty leg after the shift* is the first arrival here with the
    // shift walked out — which is `T = ceil(S / period) × period`
    // exactly, and is what `cycle_phase` computes on the rule's side
    // without ever consulting a body.
    if er.carry == ERRAND_BAG_EMPTY      { er.carry = ERRAND_BAG_LOAD; }
    else if over && errand_terminal(row) { er.carry = ERRAND_BAG_HOMEWARD; }
    else                                 { er.carry = ERRAND_BAG_EMPTY; }
    true
}

// ─── ⚠⚠ THE CYCLE — evaluable at any `t`, in O(legs) ────────────
//
// Plan 30 R2, and `@FR-E-Closed-Form` is the whole of it: *a cycle is
// evaluable at an arbitrary `t` in O(legs) and never by stepping forward
// from its start.*  ⚠ That is what makes `@X299`'s un-tracked mob
// **computed** rather than approximated, which is why materialising one
// later must not change where it is — and it is why `plans/22`'s LOD
// refusal needs no exception here.
//
// ── ⚠ Two halves, and only the second needed a probe ────────────
//
// ⚠⚠ **TIME → STEPS is exact arithmetic.**  `fixstep`'s `Bank` keeps its
// remainder, so however `t` was spent, the whole hexes a mover has
// released by then are `floor(rate × t / BANK_WHOLE)` — nothing
// accumulates and there is nothing to step through.  `cycle_walked` is
// that expression and it is the closed form's entire time half.
//
// ⚠⚠ **STEPS → HEX is a PATH, and R0 probe 1 is why** (`@M071`): only
// **10 of 90** straight crossings of the authored maps arrive and 44 of
// the 80 failures are painted terrain, so a leg is a **descent of a flow
// field toward its anchor**.  ⚠ The round is therefore stored as the
// hexes themselves — one per step offset — and `cycle_at` INDEXES it.
// ⚠ `@X331`'s bound survives that unchanged, because a field distance is
// a distance.
//
// ── ⚠⚠ THE BANK DOES NOT RESTART AT A LEG BOUNDARY ─────────────
//
// ⚠⚠ **The one thing here a plausible implementation gets wrong, and the
// sweep is what finds it.**  A mob that turns at an anchor carries its
// banked fraction across, so *how far into this leg am I* is
// `walked(t) − walked(t₀)` and **never** `walked(t − t₀)`.  The two
// differ by a whole hex whenever the carry is non-zero — which is most
// of the time — and nothing about the wrong form looks wrong.
//
// ⚠ **It is equally an obligation on R3's mover**, written here because
// that is where it would be forgotten: **a mob that walks past an anchor
// spends its remaining hexes on the NEXT leg** and never loses them at
// the turn.  ⚠⚠ And a DWELL at an anchor is a **leg of the cycle with a
// length**, not a pause beside it: a pause is a second time source, and
// a closed form has room for exactly one.
//
// ── ⚠ The period is in STEPS, and the clock is a COLUMN ─────────
//
// A bag-steered cycle's phase advances only when the mob MOVES, so its
// period is a count of hexes and the round closes itself at any distance
// (`@FR-E-Bag-Steers`, `@M073`).  A clock-steered one advances whether
// the mob moves or not, so `row.period` picks the leg and the walk only
// says how far into it the mob got.
//
// ⚠⚠ **That is the same difference `errand_leg` reads, out of the same
// COLUMN** — `@X329`'s *a healthy merge replaces a difference in CODE
// with a difference in DATA* — which is why the two agree by
// construction rather than by being kept in step.

// A whole round, as the hexes it passes through.
//
// ⚠ `path` holds ONE hex per step offset and the round WRAPS: offset
// `period` is `path[0]` again, so a leg's last hex is the next leg's
// first and is stored once.  ⚠ `anchors` and `lengths` are per leg and
// the same length as each other; `period` is the sum of `lengths`, and
// `cycle_fault` is what holds it to that rather than letting it wrap
// silently.
//
// ⚠⚠ **It is a vector of hexes and not a nested leg struct on purpose**
// ([loft#974]): a record fetched through an accessor reads its vector
// field as EMPTY once an unrelated struct has been allocated, and a
// `vector<CycleLeg>` whose every element carries a `vector<Hex>` is that
// shape exactly.  Flat, there is no accessor to read through.
//
// ⚠⚠ **AND A ROUND MAY END SOMEWHERE IT DOES NOT PASS** (R4b, `@X341`):
// `terminal` is the length of a last leg that runs `laden anchor → home`
// ONCE, after the repeating part is done with.  `anchors`, `lengths` and
// `path` describe the whole walk — terminal leg included — while
// `period` is the length of the repeating PREFIX alone.  ⚠ So the sum of
// `lengths` is `period + terminal`, `path` holds `period + terminal`
// hexes, and offsets `period …` are the terminal leg's steps 1 … n.
// ⚠ `terminal` of 0 is a round that closes on itself, which is every
// cycle R2 built and the nest's shape (`@X338`).
pub struct Cycle {
    anchors: vector<integer>,   // the anchor each leg ENDS at
    lengths: vector<integer>,   // steps in each leg
    path:    vector<Hex>,       // `period + terminal` hexes, one per step
    period:  integer,           // steps in a whole REPEATING round
    terminal: integer,          // steps in the leg that ends the round
}

// A mob with no cycle at all — which is every robot in the game today.
pub fn cycle_new() -> Cycle {
    Cycle { anchors: [], lengths: [], path: [], period: 0, terminal: 0 }
}

// Is there a round to be on?
pub fn cycle_running(c: const Cycle) -> boolean {
    c.period > 0
}

// The greatest common divisor — the only arithmetic helper in this file,
// and it is here to keep `cycle_walked` EXACT rather than merely close.
fn cycle_gcd(a: integer, b: integer) -> integer {
    cg_x = a;
    cg_y = b;
    while cg_y != 0 {
        cg_t = (cg_x % cg_y) ?? 0;
        cg_x = cg_y;
        cg_y = cg_t;
    }
    cg_x
}

// How many whole hexes a mover banking at `rate` has released by `t`.
//
// ⚠⚠ **`bank_gain`'s cumulative answer in CLOSED FORM, and it is exact**
// — the bank keeps its remainder, so whatever chunks `t` was spent in
// the total released is `floor(rate × t / BANK_WHOLE)`.  That exactness
// is the whole of `@FR-E-Closed-Form`: there is nothing to step through
// because there is nothing to accumulate.
//
// ⚠⚠ **The gcd is not tidiness.**  `rate × t` overflows an i64 a few
// game-hours in at a scout's pace and **an overflow is silent**.
// Reducing by the gcd first makes every shipped speed divide
// `BANK_WHOLE` exactly — 1.0, 1.5 and 2.5 hex/s all reduce to `t / k` —
// so the multiply that could overflow is never performed.
//
// Example: @DRY-158
pub fn cycle_walked(rate: integer, t: integer) -> integer {
    if rate <= 0 || t <= 0 { return 0; }
    cw_g = cycle_gcd(rate, BANK_WHOLE);
    cw_r = (rate / cw_g) ?? 1;
    cw_w = (BANK_WHOLE / cw_g) ?? 1;
    ((cw_r * t) / cw_w) ?? 0
}

// What a mover banking at `rate` is carrying toward its NEXT hex at `t`
// — `cycle_walked`'s remainder, in raw bank progress.
//
// ⚠⚠ **IT EXISTS BECAUSE A FRESH BODY HAS AN EMPTY BANK** (`plans/30`
// R6a).  `cycle_walked` is the whole hexes a rule has released; the rest
// of the division is real and a mover owns it.  A mob given a body
// mid-round with `bank_new()` starts its next hex from nothing, so it
// releases that hex LATE by exactly this much — and the loss is silent,
// because the body is on the right hex the moment it appears and only
// drifts afterwards.
//
// ⚠⚠ **AND THE SHIPPED ROBOT CANNOT SEE IT** (`@M014`'s class): at
// 1.5 hex/s a hex is exactly one tick, so a body materialised on a tick
// boundary carries exactly ZERO and an implementation that dropped the
// carry would be indistinguishable.  A SCOUT at 2.5 hex/s carries
// 0.8e6, 0.4e6, 0.0 … in turn, which is what `tests/30_r6a_the_tiers.loft`
// is built on.
//
// ⚠ The same `gcd` reduction `cycle_walked` makes, for the same reason:
// it keeps the product small enough to stay exact.
//
// Example: @DRY-198
pub fn cycle_carry(rate: integer, t: integer) -> integer {
    if rate <= 0 || t <= 0 { return 0; }
    cc_g = cycle_gcd(rate, BANK_WHOLE);
    cc_r = (rate / cc_g) ?? 1;
    cc_w = (BANK_WHOLE / cc_g) ?? 1;
    cc_g * (((cc_r * t) % cc_w) ?? 0)
}

// Has this mob walked out its shift by the time it had come `walked`
// hexes?
//
// ⚠⚠ **THE ONE EXPRESSION THE ENDING IS COMPARED IN, AND IT IS HEXES**
// (`@M077`).  R4 compared `now − slip >= row.shift` — a boundary in TIME
// — and 12 of 192 swept cases disagree with the closed form's
// `ceil(S / period) × period`, by a WHOLE ROUND: an arrival that falls a
// hair before the shift answers *not yet* and the mob takes another
// round, body 210 hexes against a rule of 180.
//
// ⚠⚠ **It is `@FR-E-Bag-Steers` reached from a third direction** — a
// boundary in DISTANCE is exact at any timestep and one in TIME lands
// wherever the arrival happens to fall.  `@M073` reached it from the
// route's length, `@M074` from the timestep, this from the ENDING.
//
// ⚠ **The shipped shift cannot see it** (`@M014`'s class, a fourth
// instance): 120 s at 1.5 hex/s is 180 WHOLE hexes, so the two forms
// agree for any implementation at every speed the game ships.  A gate
// has to keep a neighbour that is not.
//
// Example: @DRY-178, @DRY-179
pub fn errand_shift_over(row: const Role, rate: integer,
                         walked: integer) -> boolean {
    if row.shift <= 0 { return false; }
    walked >= cycle_walked(rate, row.shift)
}

// The hex offset at which this round turns for home — the first arrival
// at the drop-off at or after the shift, and never before one whole
// round has been walked.
//
// ⚠⚠ **It is ARITHMETIC and not a search, which is the whole constraint
// on R4b** (`@FR-E-Closed-Form`): with `S` the hexes the shift is worth,
// the turn is `ceil(S / period) × period`, so `cycle_phase` stays one
// modulo below it and one subtraction above.
//
// ⚠ **The body agrees by construction rather than by being kept in
// step**: `errand_arrive` turns the bag over at the drop-off, so the
// first EMPTY leg after the shift is this same offset — the two are one
// fact read from two sides, not two clocks to synchronise.
//
// ⚠ A round with no terminal leg never turns, and answers 0 rather than
// a sentinel nobody would check: `cycle_phase` asks `terminal > 0` first.
//
// Example: @DRY-179, @DRY-180
pub fn cycle_turn(c: const Cycle, row: const Role, rate: integer) -> integer {
    if c.period <= 0 { return 0; }
    ct_s = cycle_walked(rate, row.shift);
    ct_k = ((ct_s + c.period - 1) / c.period) ?? 1;
    // ⚠ **A shift shorter than a round is ONE round, never none** — the
    // mob is authored AT the drop-off with an empty bag, so its first
    // arrival there is a whole round away and the body cannot latch
    // earlier however small the shift is.
    if ct_k < 1 { ct_k = 1; }
    ct_k * c.period
}

// Where on its round this cycle is at `t` — the leg, and the offset into
// the whole round.
//
// ⚠⚠ **One modulo, O(legs) to find the leg, one index — and never a step
// forward from `t = 0`.**  That is `@FR-E-Closed-Form` in one function,
// and *elaborate* therefore costs LEGS.
//
// ⚠ `t` is already `now − slip`; this function does not know about slip
// and must not (`cycle_where` is the door that subtracts it, exactly as
// `errand_leg` does).
//
// Example: @DRY-154, @DRY-155, @DRY-179
pub fn cycle_phase(c: const Cycle, row: const Role, rate: integer,
                   t: integer) -> (integer, integer) {
    if !cycle_running(c) { return (0, 0); }
    cp_legs = len(c.lengths);
    if cp_legs <= 0 { return (0, 0); }
    cp_t = t;
    if cp_t < 0 { cp_t = 0; }
    if row.period > 0 {
        // ⚠ THE CLOCK picks the leg — the one role `docs/ERRANDS.md`
        // lets it steer, and only because it has no bag — while the walk
        // says how far into that leg the mob got before it turned round.
        cp_i  = (((cp_t / row.period) ?? 0) % cp_legs) ?? 0;
        cp_t0 = ((cp_t / row.period) ?? 0) * row.period;
        cp_at = 0;
        cp_j  = 0;
        for cp_n in c.lengths {
            if cp_j >= cp_i { break; }
            cp_at += cp_n;
            cp_j  += 1;
        }
        cp_len = c.lengths[cp_i] ?? 0;
        // ⚠⚠ The DIFFERENCE of two cumulative walks, never a walk over
        // the difference — § THE BANK DOES NOT RESTART is the argument,
        // and the two forms differ by a hex most of the time.
        cp_into = cycle_walked(rate, cp_t) - cycle_walked(rate, cp_t0);
        if cp_into > cp_len { cp_into = cp_len; }
        if cp_into < 0      { cp_into = 0; }
        return (cp_i, cp_at + cp_into);
    }
    // ⚠ THE BAG steers, so the phase is a count of HEXES and the round
    // closes itself at 4 hexes and at 400 alike (`@M073`).
    cp_walk = cycle_walked(rate, cp_t);
    // ⚠⚠ **THE TERMINAL LEG — one subtraction above the turn, one
    // modulo below it** (R4b).  Above it the round no longer repeats, so
    // the offset is a distance INTO the last leg and is clamped at its
    // end: a mob that has arrived stays arrived, and `errand_depart`
    // takes it off the roster at the top of the next tick.
    cp_turn = cycle_turn(c, row, rate);
    if c.terminal > 0 && cp_walk >= cp_turn {
        cp_k = cp_walk - cp_turn;
        if cp_k > c.terminal { cp_k = c.terminal; }
        return (cp_legs - 1, c.period + cp_k);
    }
    cp_off  = (cp_walk % c.period) ?? 0;
    cp_seen = 0;
    cp_k    = 0;
    for cp_m in c.lengths {
        if cp_off < cp_seen + cp_m { return (cp_k, cp_off); }
        cp_seen += cp_m;
        cp_k    += 1;
    }
    // ⚠ Unreachable while the legs sum to the period — which is exactly
    // what `cycle_fault` refuses a cycle for not doing.  An offset with
    // no leg to own it is the SILENT form of that authoring error, so it
    // answers the round's start rather than guessing at one.
    (0, cp_off)
}

// The hex this routine is standing on at `t`.
//
// Example: @DRY-154
pub fn cycle_at(c: const Cycle, row: const Role, rate: integer,
                t: integer) -> Hex {
    if !cycle_running(c) { return Hex { q: 0, r: 0 }; }
    ca_ph = cycle_phase(c, row, rate, t);
    // ⚠ The round WRAPS: a clock-steered mob standing at the end of the
    // last leg reads offset `period`, which is `path[0]` — the same hex,
    // named from the other side.
    ca_i = (ca_ph.1 % c.period) ?? 0;
    // ⚠⚠ **The terminal leg is stored AFTER the round and its first hex
    // is the round's** (R4b): offset `period + k` is terminal step `k`,
    // and step 0 is the drop-off the mob turned at — `path[0]`, stored
    // once, exactly as a leg's join is.
    if c.terminal > 0 && ca_ph.1 >= c.period {
        ca_i = 0;
        if ca_ph.1 > c.period { ca_i = c.period + (ca_ph.1 - c.period) - 1; }
    }
    ca_h = c.path[ca_i];
    if ca_h == null { return Hex { q: 0, r: 0 }; }
    Hex { q: ca_h.q, r: ca_h.r }
}

// Where the rule says this robot is, now.
//
// ⚠⚠ **THE DOOR THE CONFORMANCE GATE ASKS** (`plans/30` § Rc): at the
// end of every tick, every mob still on a cycle must be exactly here.
//
// ⚠ It reads the role through `errand_role`, so a robot the bubble has
// taken answers its own hex and stops being on a cycle it has lost —
// site 5 of § Count the RE-ASSERTION SITES needs no second write to
// remember, for the same reason `errand_destination` does not.
//
// ⚠⚠ **`slip` is subtracted HERE and in `errand_leg`, and nowhere else**
// (`@FR-E-Slip`): a mob held up is genuinely later, so its clock reads
// earlier and its DESTINATION never changes.
//
// ⚠⚠ **AND THE FALLBACK IS A TRAP FOR § Rc, SO IT IS NAMED HERE.**  A
// robot with no cycle answers its OWN hex, which makes
// `cycle_where(e, c, now) == (e.q, e.r)` **trivially true** for it — so
// the conformance gate must FILTER on `errand_role` and count what it
// looked at, never lean on this answer.  ⚠ A corpus in which nothing is
// on a cycle would otherwise read green
// (`CLAUDE.md` § A gate whose reading is already saturated).
//
// Example: @DRY-156, @DRY-160, @DRY-166, @DRY-167, @DRY-168
pub fn cycle_where(e: const Enemy, c: const Cycle, now: integer) -> Hex {
    cwh_row = errand_role_of(errand_role(e));
    // ⚠ The ROW is asked and never the role id — the table is indexed
    // and never compared (`@X333`), and *this role has no cycle* is
    // exactly *its legs go nowhere*.
    if cwh_row.empty == ANCHOR_NONE { return Hex { q: e.q, r: e.r }; }
    if !cycle_running(c)            { return Hex { q: e.q, r: e.r }; }
    cycle_at(c, cwh_row, bank_rate(enemy_speed(e.kind)),
             now - e.route.slip)
}

// Build the round this routine walks: one leg per anchor, each a descent
// of a flow field toward it.
//
// ⚠⚠ **The legs come from the ROW and not from a waypoint list** — a
// round starts where the mob last dropped (`row.laden`), walks to
// `row.empty`, and comes back.  That is `errand_leg`'s two answers made
// into two legs, so the cycle and the steering cannot disagree about
// which anchor is which.
//
// ⚠ **A leg that does not connect refuses the whole cycle**, answering
// `cycle_new()` — a mob with no cycle, which is today's game — rather
// than a short round that would put a body somewhere the rule never
// said.  ⚠ `cycle_fault` is what NAMES the refusal.
//
// ⚠ Two sweeps, and `@M072` is what makes that affordable: a field over
// an authored map is ~500 cells, and a mob asks for at most three
// anchors.  It is built ONCE per routine and never in the tick.
//
// Example: @DRY-154, @DRY-157, @DRY-178
pub fn cycle_build(er: const Errand, row: const Role,
                   pal: vector<GroundType>, pw: PaintedWorld,
                   hl: const HeightLayer, kind: u8) -> Cycle {
    if row.empty == ANCHOR_NONE || row.laden == ANCHOR_NONE {
        return cycle_new();
    }
    cb_from = errand_anchor(er, row.laden);
    cb_to   = errand_anchor(er, row.empty);
    cb_out  = cycle_two_legs(pal, pw, hl, kind, cb_from, cb_to,
                             row.empty, row.laden, errand_terminal(row),
                             er.home);
    cb_out
}

// The two legs of a round, as one flat path.  ⚠ Split out so the struct
// is built by a single literal at the end and nothing writes through a
// returned copy ([loft#894]).
fn cycle_two_legs(pal: vector<GroundType>, pw: PaintedWorld,
                  hl: const HeightLayer, kind: u8,
                  from: const Hex, to: const Hex,
                  out_anchor: integer, back_anchor: integer,
                  term: boolean, home: const Hex) -> Cycle {
    ctl_out    = flow_route(flow_build(pal, pw, hl, kind, to), from);
    ctl_back   = flow_route(flow_build(pal, pw, hl, kind, from), to);
    ctl_n_out  = len(ctl_out) - 1;
    ctl_n_back = len(ctl_back) - 1;
    // ⚠ A leg with no length is a round with no length, and a leg that
    // never arrived is a leg that does not connect — both are the same
    // refusal from the caller's side: no cycle at all.
    if ctl_n_out <= 0 || ctl_n_back <= 0 { return cycle_new(); }
    if !cycle_ends_at(ctl_out, to) || !cycle_ends_at(ctl_back, from) {
        return cycle_new();
    }
    ctl_path: vector<Hex> = [];
    ctl_i = 0;
    for ctl_h in ctl_out {
        // ⚠ The join is stored ONCE: this leg's last hex is the next
        // leg's first, so the outward path contributes its first
        // `n` entries and the return path its first `m`.
        if ctl_i < ctl_n_out { ctl_path += [Hex { q: ctl_h.q, r: ctl_h.r }]; }
        ctl_i += 1;
    }
    ctl_j = 0;
    for ctl_b in ctl_back {
        if ctl_j < ctl_n_back { ctl_path += [Hex { q: ctl_b.q, r: ctl_b.r }]; }
        ctl_j += 1;
    }
    ctl_anch: vector<integer> = [out_anchor, back_anchor];
    ctl_lens: vector<integer> = [ctl_n_out, ctl_n_back];
    // ⚠⚠ **THE TERMINAL LEG** (R4b): a third descent, from the drop-off
    // the round starts and ends at to the repair point it never passes.
    // ⚠ It is a PATH like the other two — R0 probe 1 (`@M071`) applies
    // to it no differently — and it is stored MINUS its first hex,
    // because that hex is `path[0]` and a join is stored once.
    ctl_n_hm = 0;
    if term {
        ctl_hm   = flow_route(flow_build(pal, pw, hl, kind, home), from);
        ctl_n_hm = len(ctl_hm) - 1;
        // ⚠ A home the round cannot reach refuses the WHOLE cycle, so a
        // shift is never a promise the geometry cannot keep — the same
        // refusal a leg that does not connect already gets, and
        // `cycle_fault` names it from the caller's side.
        if ctl_n_hm <= 0 || !cycle_ends_at(ctl_hm, home) { return cycle_new(); }
        ctl_k = 0;
        for ctl_t in ctl_hm {
            if ctl_k > 0 { ctl_path += [Hex { q: ctl_t.q, r: ctl_t.r }]; }
            ctl_k += 1;
        }
        ctl_anch += [ANCHOR_HOME];
        ctl_lens += [ctl_n_hm];
    }
    Cycle { anchors: ctl_anch,
            lengths: ctl_lens,
            path:    ctl_path,
            period:  ctl_n_out + ctl_n_back,
            terminal: ctl_n_hm }
}

// Does this route actually reach `at`?
fn cycle_ends_at(path: vector<Hex>, at: const Hex) -> boolean {
    cea_last = path[len(path) - 1];
    if cea_last == null { return false; }
    cea_last.q == at.q && cea_last.r == at.r
}

// Why this cycle is not a cycle, or "".
//
// ⚠⚠ **A cycle whose legs do not sum to its period is an authoring error
// and is REFUSED here rather than wrapped silently** (`@FR-E-Closed-Form`).
// A wrapped one is not a crash: it is a mob standing on the wrong hex for
// ever, with every count in the suite green.
//
// ⚠⚠ **And the last check is `crawler`'s defect refused at
// construction**: a clock-steered role whose period is too short to walk
// its own leg *"oscillated between home and 13 hexes out, forever"*
// (`@M073`).  Here the leg's length is known before the mob moves, so
// the authoring error can be NAMED instead of measured.
//
// ⚠ `rate` is the mover's, because whether a clock is long enough to
// walk a post depends on how fast the walker is — a fact about the
// domain, not about the code.
//
// Example: @DRY-155, @DRY-157, @DRY-159, @DRY-182
pub fn cycle_fault(c: const Cycle, row: const Role, rate: integer) -> text {
    if !cycle_running(c) {
        return "this routine has no cycle: a leg is empty, or an anchor "
               + "cannot be reached from the one before it";
    }
    if len(c.anchors) != len(c.lengths) {
        return "the cycle has {len(c.anchors)} anchors and "
               + "{len(c.lengths)} legs";
    }
    cf_sum = 0;
    for cf_n in c.lengths {
        if cf_n <= 0 { return "a leg of {cf_n} steps has no length"; }
        cf_sum += cf_n;
    }
    // ⚠ `period` is the REPEATING prefix and `lengths` is the whole
    // walk, so the sum is the two together — a terminal leg that was not
    // counted would wrap a mob back onto the round it had just left.
    if cf_sum != c.period + c.terminal {
        return "the legs sum to {cf_sum} steps and the period says "
               + "{c.period} with {c.terminal} terminal";
    }
    if len(c.path) != c.period + c.terminal {
        return "the round is {len(c.path)} hexes long and its period says "
               + "{c.period} with {c.terminal} terminal";
    }
    // ⚠⚠ **A TERMINAL LEG IS A ROUND'S ENDING, so it needs a row that
    // HAS one** — and it needs the BAG to steer, because the turn point
    // is a count of hexes and a clock-steered phase is a span of time
    // (`@FR-E-Bag-Steers`, `@M077`).
    if c.terminal > 0 && !errand_terminal(row) {
        return "role '{row.name}': a terminal leg of {c.terminal} steps "
               + "on a round that does not end away from home";
    }
    // ⚠⚠ **A SHIFT MUST BE A WHOLE NUMBER OF HEXES AT THIS RATE**, and
    // it is `@M074`'s family with a third subject: the body reaches its
    // ending at an ARRIVAL, so a shift that falls between two of them is
    // a boundary the walk cannot land on and *at or after the shift*
    // then depends on which side of a hex the timestep left the mob.
    // ⚠ `cycle_hex_units` is non-zero by the check above.
    if row.shift > 0 {
        if ((row.shift % cycle_hex_units(rate)) ?? 1) != 0 {
            return "role '{row.name}': a shift of {row.shift} units is "
                   + "not a whole number of hexes at "
                   + "{cycle_hex_units(rate)} units a hex";
        }
    }
    // ⚠⚠ **A LOST HEX MUST BE A WHOLE NUMBER OF BASE UNITS** (§ THE
    // MOVER), and it is `@M074`'s family with a different subject: for
    // `cycle_walked(rate, t − slip)` to be exactly one hex short at
    // EVERY later `t`, `rate × slip` has to be a whole multiple of
    // `BANK_WHOLE`.  A rate that cannot express *one hex late* as a time
    // is an authoring error, named here rather than measured later as a
    // mob drifting a hex ahead of its own rule.
    if cycle_hex_units(rate) <= 0 {
        return "a rate of {rate} does not make a hex a whole number of "
               + "base units, so a deviation cannot be paid for exactly";
    }
    if row.period > 0 {
        // ⚠⚠ **A CLOCK PERIOD MUST BE A WHOLE NUMBER OF TICKS**, and
        // `@M074` is what it costs when it is not: a leg boundary in
        // TIME lands wherever the timestep happens to put it, so a
        // period the step does not divide leaves the body a hex ahead of
        // its own rule for as long as the leg lasts.  ⚠ A boundary in
        // DISTANCE cannot do that at any timestep, which is the second
        // and INDEPENDENT reason for `@FR-E-Bag-Steers`.
        //
        // ⚠ Measured over the whole cross-product rather than at the
        // shipped step alone (`CLAUDE.md` § THE INSTRUMENT IS A
        // CROSS-PRODUCT), which is why the check is against the tick and
        // not against a promise that nobody will change it.
        if ((row.period % TICK_STEP_UNITS) ?? 1) != 0 {
            return "role '{row.name}': a clock period of {row.period} "
                   + "units is not a whole number of ticks";
        }
        // ⚠ The MINIMUM a period buys, because the bank's carry can only
        // ever add one — a leg this walk cannot finish is one no carry
        // will rescue.
        cf_reach = cycle_walked(rate, row.period);
        for cf_m in c.lengths {
            if cf_m > cf_reach {
                return "a clock-steered leg of {cf_m} steps cannot be "
                       + "walked in a period worth {cf_reach}";
            }
        }
    }
    ""
}

// ─── What a row may not be ──────────────────────────────────────

// Why this row is not a role, or "".
//
// ⚠ The same shape as `crop_fault` and `map_fault`: a refusal that NAMES
// what is wrong, because a table is authored and an authoring error that
// wraps silently is R2's *a cycle whose legs do not sum to its period*
// arriving one phase early.
pub fn errand_row_fault(row: const Role) -> text {
    if row.name == "" { return "a role row with no name"; }
    if row.period < 0 {
        return "role '{row.name}': a leg cannot be {row.period} units long";
    }
    if row.empty < ANCHOR_NONE || row.empty > ANCHOR_ALT {
        return "role '{row.name}': {row.empty} is not an anchor";
    }
    if row.laden < ANCHOR_NONE || row.laden > ANCHOR_ALT {
        return "role '{row.name}': {row.laden} is not an anchor";
    }
    // ⚠ Half a cycle is an authoring error rather than a special case: a
    // role that has one anchor has a destination it can never leave.
    if (row.empty == ANCHOR_NONE) != (row.laden == ANCHOR_NONE) {
        return "role '{row.name}': one leg goes nowhere and the other does not";
    }
    if row.empty == row.laden && row.empty != ANCHOR_NONE {
        return "role '{row.name}': both legs end at the same anchor, "
               + "so the round trip has no length";
    }
    if row.shift < 0 {
        return "role '{row.name}': a shift cannot be {row.shift} units long";
    }
    // ⚠⚠ **A SHIFT IS A PROMISE THE ROUND HAS TO BE ABLE TO KEEP**
    // (`@FR-E-Home-Is-A-Place`, § Home is a PLACE).  A mob leaves the
    // roster at its HOME anchor and nowhere else, so a row that names a
    // shift while its round never touches home has named an ending its
    // cycle can never reach — the mob would work for ever and the
    // column would read as behaviour the engine has not got.
    //
    // ⚠ It is REFUSED here rather than measured later, exactly as
    // `cycle_fault` refuses a period too short to walk its own leg: the
    // failure is silent otherwise, because a role that never ends and a
    // role that cannot reach its ending look identical from outside.
    // ⚠⚠ **AND R4b IS WHERE `home` STOPPED HAVING TO BE ON THE ROUND**
    // (`@X339`): a round that does not pass its repair point grows a
    // TERMINAL leg to it, so the row is legal and the REACHABILITY is
    // the cycle's question rather than the row's — `cycle_build` refuses
    // the whole cycle when the walk home does not connect, exactly as it
    // refuses a working leg that does not.
    //
    // ⚠ What is still refused here is the shape no ending can be built
    // for: a CLOCK-steered round.  Its phase is a span of time and its
    // bag is never turned over, so there is no arrival for a shift
    // measured in hexes to land on (`@M077`, `@FR-E-Bag-Steers`).
    if row.shift > 0 && row.period > 0 {
        return "role '{row.name}': a clock-steered round cannot end — "
               + "its phase is a time and a shift is a distance";
    }
    // ⚠⚠ **A clock may steer a role only if it has no bag**
    // (`docs/ERRANDS.md` § THE BAG STEERS), and there is no check for it
    // here because there is nothing to check: `errand_arrive` refuses a
    // row with a period, so a clock-steered role's bag is empty for the
    // life of the run and `errand_leg` never reaches the branch that
    // would ask it.  ⚠ The constraint is CONSTRUCTED rather than
    // asserted, which is the stronger of the two.
    ""
}

// Why the shipped table is not a table, or "".
//
// ⚠ It asks three things a compiler cannot: every row is legal, no two
// rows share a name, and `ROLE_KIND_COUNT` still counts them.
//
// Example: @DRY-144, @DRY-148, @DRY-177
pub fn errand_table_fault() -> text {
    etf_all = errand_roles();
    if len(etf_all) != ROLE_KIND_COUNT {
        return "the table has {len(etf_all)} rows and ROLE_KIND_COUNT says "
               + "{ROLE_KIND_COUNT}";
    }
    etf_i = 0;
    for etf_row in etf_all {
        etf_f = errand_row_fault(etf_row);
        if etf_f != "" { return etf_f; }
        etf_j = 0;
        for etf_other in etf_all {
            if etf_j > etf_i && etf_other.name == etf_row.name {
                return "two roles are both called '{etf_row.name}'";
            }
            etf_j += 1;
        }
        etf_i += 1;
    }
    // ⚠ The BAG's table, held to its constants for the same reason the
    // roles are — a row and a constant that drifted apart rename two
    // bags at once and nothing throws.
    if len(errand_bags()) != ERRAND_BAG_COUNT {
        return "the bag table has {len(errand_bags())} rows and "
               + "ERRAND_BAG_COUNT is {ERRAND_BAG_COUNT}";
    }
    if errand_bag_named("empty") != (ERRAND_BAG_EMPTY as integer)
       || errand_bag_named("homeward") != (ERRAND_BAG_HOMEWARD as integer) {
        return "the bag names are out of step with their constants";
    }
    ""
}

// Seconds to base units for a SIGNED span.
//
// ⚠⚠ **`slip` is the one duration in the game that goes NEGATIVE**, and
// `fixstep`'s authoring door refuses one on purpose — a timer counting
// backwards is the defect `clock_advance` exists to name.  ⚠ But
// `poi_materialise` folds a mob's SEAT OFFSET into `slip` as a negative
// lateness (`@X343`: *the one liberty this function takes with `slip`'s
// meaning*), so a body seated part-way round its round carries one —
// and a reader that clamped it to zero would put the whole rota back at
// the same place on the round.
//
// ⚠ Found by `tests/18_s2`'s round trip on the very first scenario with
// a POI in it: `slip -24000000 vs slip 0`, silent, and the mobs would
// have replayed stacked.
//
// Example: @DRY-210
pub fn slip_units(seconds: float) -> integer {
    if seconds < 0.0 { return 0 - clock_units_from_seconds(0.0 - seconds); }
    clock_units_from_seconds(seconds)
}

// The other half, so the writer and the reader are ONE rule.
pub fn slip_seconds(units: integer) -> float {
    if units < 0 { return 0.0 - clock_seconds_from_units(0 - units); }
    clock_seconds_from_units(units)
}

// ─── ⚠⚠ THE LURE — what the player LEFT, and what it costs ─────
//
// Plan 30 R7b.  ⚠⚠ **The rule is `@FR-E-Built-Not-Seen` and everything
// here is its enforcement**: nothing in this section reads the player's
// position, and there is no radius around a person anywhere in it.  A
// lure is a fact about the GROUND — a heap somebody left — so the only
// way to make one is to leave something lying.
//
// ── ⚠⚠ A HEX WALKED AWAY FROM YOUR ANCHOR COSTS TWO ────────────
//
// ⚠⚠ **This is the phase's finding, and it is what lets a mob leave its
// route at all without a single new field on it.**  `@FR-E-Slip` says a
// deviation costs TIME and never DESTINATION, and that *a body pushed
// off its cycle re-converges on the same hex* — so a detour has to be
// paid for **both ways**, and the return leg is indistinguishable from
// ordinary progress.  A mover that charged one hex per hex spent going
// out would leave the body permanently short of its own rule by the
// depth of the detour, silently.
//
// ⚠ So: a step that INCREASES the distance to the leg's anchor is
// charged **two** hexes of `slip` — the one it spent and the one it owes
// — a step that holds the distance EQUAL is charged one, as a sidestep
// always was, and a step that DECREASES it is free.  ⚠⚠ Then the rule's
// distance to the anchor equals the body's at **every** moment of the
// detour, in and out, with nothing remembered: with `i` steps out and
// `d` steps back the body stands at `D + i − d`, the rule has advanced
// `(i + d) − 2i = d − i`, and `D − (d − i)` is the same number.
//
// ⚠ `@FR-E-Place-State` is what makes that the required answer rather
// than a clever one: a mob may hold nothing beyond `carry` and `slip`,
// so a DEBT COUNTER is not available and the debt has to be paid at the
// moment it is incurred.

// How much of `slip` one hex of this step costs — 0, 1 or 2.
//
// ⚠ It is asked of the ANCHOR's field and never of the destination's:
// while a mob is turned aside the two are different fields, and the
// whole accounting above is about the ANCHOR.
//
// Example: @DRY-211
pub fn errand_hex_cost(before: integer, after: integer) -> integer {
    if before >= FLOW_UNREACHABLE || after >= FLOW_UNREACHABLE { return 1; }
    if after < before  { return 0; }
    if after == before { return 1; }
    2
}

// The cargo-ledger identity of a mob — `BLOCKER_MOB` plus its POI mob
// index, or `BLOCKER_NONE`.
//
// ⚠⚠ **AN IDENTITY THAT OUTLIVES A BODY, which is what a ledger needs**
// and what a roster index is not: `errand_depart`, `wave_deaths` and
// `poi_drop_body` all rebuild the roster, so an object keyed on a slot
// would silently start following a different robot.  ⚠ `PoiMob` is
// exactly *the thing that outlives the body*, so its one-based index is
// the key — and a body no place owns has no identity to hold cargo
// against and therefore never steals.
//
// ⚠ The offset is large enough that it can never collide with
// `BLOCKER_CREW + i`, which is bounded by the roster cap.
pub const BLOCKER_MOB: integer = 1000000;

pub fn errand_owner(e: const Enemy) -> integer {
    if e.route.mob <= 0 { return BLOCKER_NONE; }
    BLOCKER_MOB + e.route.mob
}

// The heap this mob would turn aside for, or `job_none()`.
//
// ⚠⚠ **EMPTY HANDS ARE HALF THE RULE.**  A hauler runs OUT with nothing
// in its bag, which is why a heap on its route reads as spilled cargo at
// all; one coming back laden has no hands and walks past.  ⚠ The bag is
// asked and never a clock, which is `@FR-E-Bag-Steers` reached from a
// fourth direction.
//
// ⚠ `collectable` is `vehicle.loft`'s and that is deliberate: the thief
// and the owner must not disagree about what salvage IS, so SPOIL is
// refused here for the same reason it is refused there.
//
// ⚠ NEAREST wins and ties break by `lat_disc`'s order, which keeps a
// scripted run repeatable.
//
// Example: @DRY-212
pub fn errand_lure_at(row: const Role, e: const Enemy,
                      hl: const HeightLayer, cl: const CargoLayer) -> Job {
    ela_reach = errand_lure_of(row.lure).reach;
    if ela_reach <= 0 { return job_none(); }
    if e.route.carry != ERRAND_BAG_EMPTY { return job_none(); }
    ela_who = errand_owner(e);
    if ela_who == BLOCKER_NONE { return job_none(); }
    if cargo_carrying(cl, ela_who) { return job_none(); }
    ela_best = job_none();
    ela_far  = ela_reach + 1;
    ela_here = Hex { q: e.q, r: e.r };
    for ela_h in lat_disc(ela_here, ela_reach) {
        if height_rise(hl, ela_h.q, ela_h.r) <= 0.0 { continue; }
        if !collectable(hl, ela_h.q, ela_h.r) { continue; }
        ela_d = lat_distance(ela_here, ela_h);
        if ela_d >= ela_far { continue; }
        ela_far  = ela_d;
        // ⚠⚠ **`TASK_CLEAR`, and it is the first `Job.kind` a mob has
        // ever named** — `plans/30` § Open questions 1 left the column
        // empty rather than guessing, saying *not one of the four kinds
        // is what a hauler does at its face*.  This is not the face: it
        // is a heap, and clearing one is exactly what the crew's own
        // `TASK_CLEAR` means (`@X332` cashed in from the other end).
        ela_best = Job { found: true, kind: TASK_CLEAR,
                         q: ela_h.q, r: ela_h.r };
    }
    ela_best
}

// Take the heap at `at` — off the ground and onto this mob.
//
// ⚠⚠ **THE PILE IS CLEARED AND THE LOAD IS CONSERVED**, which is
// `@X334`'s obligation coming due: *a bag holds material that was never
// on the map, and `carry.loft` conserves an object that IS on the map
// and the player could have picked up instead.*  A heap the player left
// is the second kind, so it becomes a `CarryObject` rather than a number
// nobody can follow — and killing the thief is what gets it back.
//
// ⚠ **The BAG is not touched, and that is load-bearing.**  The bag is
// the ROUND's state and `cycle_phase` reads the walk rather than the bag
// — so a theft that flipped it would put the body on a different leg
// from its own rule, permanently and silently.  The mob steals, then
// goes on to its face exactly as before, and hauls both loads in.
//
// Answers the cargo index, or `CARGO_NONE`.
//
// Example: @DRY-213
pub fn errand_lure_take(e: const Enemy, at: const Hex, hl: HeightLayer,
                        cl: CargoLayer) -> integer {
    elt_who = errand_owner(e);
    if elt_who == BLOCKER_NONE { return CARGO_NONE; }
    if cargo_carrying(cl, elt_who) { return CARGO_NONE; }
    elt_m = height_rise(hl, at.q, at.r);
    if elt_m <= 0.0 { return CARGO_NONE; }
    if !collectable(hl, at.q, at.r) { return CARGO_NONE; }
    elt_src = height_source(hl, at.q, at.r);
    height_clear(hl, at.q, at.r);
    // ⚠ `subj` carries the load in MILLIMETRES, because the field is an
    // integer and a heap is metres.  ⚠⚠ **The source travels with it**
    // in the top bits so that spilling one back puts the same stuff on
    // the ground — a wreck that came back as masonry would be the
    // writer-and-reader defect (`@D007`) inside one struct.
    elt_i = cargo_spawn(cl, CARGO_SALVAGE,
                        errand_load_pack(elt_m, elt_src), at.q, at.r);
    cargo_take(cl, elt_who, at, CARGO_REACH_HEXES);
    elt_i
}

// Let a stolen load go at the mob's own drop-off.
//
// ⚠⚠ **THE PICKUP'S PAIR, and it lives beside it on purpose.**  Both
// are *what this mob does at this hex*, which is `errand_hex`'s whole
// subject — a delivery that lived in the tick instead would be a second
// place deciding whether a mob is carrying anything, and the two could
// disagree about a mob that died between them.
//
// ⚠ The destination is the mob's own LADEN anchor and never a row in
// `cargo_destination_ok`: *the depot this particular mob is walking to*
// is a fact about a routine and not about a kind, which is
// `CARGO_BEACON`'s split one consumer over (`carry.loft` § A top has TWO
// destinations).
//
// ⚠ A role with no laden anchor delivers nothing, which is right: it has
// no depot to deliver to.
//
// Answers whether it let go.
//
// Example: @DRY-215
pub fn errand_lure_drop(e: const Enemy, row: const Role,
                        cl: CargoLayer) -> boolean {
    eld_who = errand_owner(e);
    if eld_who == BLOCKER_NONE { return false; }
    eld_i = cargo_held_by(cl, eld_who);
    if eld_i == CARGO_NONE { return false; }
    if row.laden == ANCHOR_NONE { return false; }
    eld_at = errand_anchor(e.route, row.laden);
    if lat_distance(Hex { q: e.q, r: e.r }, eld_at) > CARGO_REACH_HEXES {
        return false;
    }
    cargo_consume(cl, eld_i);
    true
}

// A stolen load, as one integer: millimetres, with the rubble SOURCE
// above them.
//
// ⚠ One field, two facts, and it is named rather than open-coded because
// `carry.loft` says so: *a kind that needs a second payload field has
// outgrown this and should say so rather than overloading one integer
// twice.*  This overloads it ONCE, in a pair of functions.
pub const LOAD_SOURCE_SCALE: integer = 1000000;

pub fn errand_load_pack(metres: float, source: integer) -> integer {
    elp_mm = (metres * 1000.0) as integer;
    if elp_mm < 0 { elp_mm = 0; }
    if elp_mm >= LOAD_SOURCE_SCALE { elp_mm = LOAD_SOURCE_SCALE - 1; }
    source * LOAD_SOURCE_SCALE + elp_mm
}

pub fn errand_load_metres(subj: integer) -> float {
    ((subj % LOAD_SOURCE_SCALE) ?? 0) as float / 1000.0
}

pub fn errand_load_source(subj: integer) -> integer {
    (subj / LOAD_SOURCE_SCALE) ?? 0
}

// ─── ⚠⚠ THE MOVER — the ONE DOOR that writes a mob's position ───
//
// Plan 30 R3, and `@FR-E-One-Door` is the whole shape of it: *exactly
// one function moves a mob on a cycle, and it owns `slip`.*  ⚠ § Count
// the RE-ASSERTION SITES lists **twelve** places that could write a
// position and forget the bookkeeping, and **every omission is silent**
// — a forgotten `slip` does not fail to compile and does not throw, the
// mob simply arrives early.  So four of the twelve are collapsed by
// there being nothing else that may move a mob at all.
//
// ⚠ **It adds no mover.**  `enemy_step`'s engage branch has descended a
// field toward the core since plan 11 F5, and F7b's *blocked by a
// COMPANION → step beside; blocked by the GROUND → stand* is the rule
// this reuses with the destination changed.  What approach mode never
// had is the FIELD — `enemy_walk_heading` says so itself, *"having no
// field to say which way beside is"* — and an anchor supplies one.
//
// ── ⚠⚠ WHAT IS EXACT, AND IT IS THE PHASE RATHER THAN THE HEX ───
//
// ⚠⚠ **`@FR-E-Slip` says a body pushed off its cycle *re-converges on
// the same hex* — the ANCHOR — and it does NOT say the body is on the
// rule's hex while it is being pushed.**  That distinction is this
// section's finding and it is worth stating before the code:
//
//   * a mob nothing has pushed walks `flow_steps[0]` every step, which
//     is exactly what `flow_route` built the round out of, so it stands
//     on `cycle_at`'s hex at the end of every tick — **hex equality is
//     total in a world with nothing to deviate it**;
//   * a mob that takes a DIFFERENT strictly-closer step because a
//     companion is on the first is on another route of the same length.
//     It loses no time and it is not on the rule's hex;
//   * a mob that can only SIDESTEP loses exactly one hex of progress,
//     and that is what `slip` pays for.
//
// ⚠⚠ **So the invariant that is total is the PHASE**: a mob's distance
// to its current anchor equals the rule's distance to it, always, for
// every deviation.  Hex equality is the special case of it where nothing
// blocked.  ⚠ That is what R5's bound needs (`@FR-E-Boundable` is stated
// in field distance) and what `plans/30` § Rc gates.
//
// ── ⚠⚠ A LOST HEX IS A WHOLE NUMBER OF BASE UNITS, OR IT IS NOT EXACT ─
//
// ⚠⚠ **The one arithmetic constraint in the phase, and it is `@M074`'s
// family with a different subject.**  For `cycle_walked(rate, t − slip)`
// to be *exactly* one hex short for **every** later `t`, `rate × slip`
// has to be a whole multiple of `BANK_WHOLE` — otherwise the floor
// disagrees at the `t` values whose fraction falls under the remainder,
// and the mob is a hex ahead of its own rule for part of every step.
//
// ⚠ So one lost hex costs `BANK_WHOLE / rate` units and the division
// must be EXACT.  `cycle_hex_units` is that number, `cycle_fault`
// refuses a rate that has not got one, and every speed the game ships —
// 1.0, 1.5 and 2.5 hex/s — divides `BANK_WHOLE` exactly.  ⚠⚠ **A speed
// that does not is an authoring error named at construction**, exactly
// as a clock period that is not a whole number of ticks is.
//
// ⚠ **Time the mob did not spend walking needs no such division**: the
// pre-walk window freezes the mob and `slip += elapsed` freezes `t −
// slip` with it, which is exact at any rate and any timestep.

// How many base units one hex of walking is worth at `rate` — 0 when
// the rate has no such number.
//
// ⚠⚠ **Zero means REFUSE, not free**: a rate that does not divide
// `BANK_WHOLE` cannot express *one hex late* as a time at all, and a
// caller that treated 0 as *no delay* would let a blocked mob keep its
// place in the rule.  `cycle_fault` is where it is turned into a
// refusal, so the mover never meets one.
//
// Example: @DRY-161
pub fn cycle_hex_units(rate: integer) -> integer {
    if rate <= 0 { return 0; }
    if ((BANK_WHOLE % rate) ?? 1) != 0 { return 0; }
    (BANK_WHOLE / rate) ?? 0
}

// One destination's field for this tick, and the class that reads it.
//
// ⚠ Keyed by the HEX and the CLIMB LIMIT — the same key `ClassField`
// uses one field over, for the same reason (`spawn.loft` § The fields):
// `climb_limit` is the class's whole contribution to passability, so two
// classes agreeing on it produce identical fields and building both is
// duplicated work that also invites them to drift.
pub struct ErrandField {
    q:     integer,
    r:     integer,
    climb: float,
    field: FlowField,
}

// A field for every (anchor, climb limit) a mob on a routine could be
// making for THIS TICK — each built once.
//
// ⚠⚠ **EVERY ANCHOR OF THE ROW, NOT THE ONE THE MOB IS MAKING FOR
// NOW** — and the difference is a defect, not a margin (`@D008`).  A mob
// that reaches an anchor with hexes left in its bank turns and spends
// them on the NEXT leg (`@X335`), so it asks for a field this function
// had no reason to build if it only read the mob's destination at the
// tick's start.  ⚠ There is then no field to descend, the mover cannot
// place the step, and **the remaining hexes are charged to `slip`** —
// which is silent twice over: nothing throws, and the conformance gate
// agrees because the rule reads `now − slip` and follows the body down.
//
// ⚠⚠ **It is invisible at the shipped robot's speed**, which releases
// exactly one hex a tick and therefore never turns with hexes left
// (`@M014`'s class).  A SCOUT releases 1, 2, 2 and turns mid-tick every
// other round, and R4's gate is where it finally showed — as a mob whose
// phase had drifted twelve hexes from its own rule over three minutes.
//
// ⚠ `@M072` is what makes it affordable: a sweep over an authored map is
// **~500 cells** and a mob asks for at most three anchors — the budget
// this reads two of, which is what that number was for.  ⚠⚠ It is
// rebuilt every tick and that is a stepstone: `plans/22`'s cache, keyed
// by exactly this pair, is where it stops being one, and `@X299`'s POI
// is where the cycle stops being rebuilt with it.
//
// Example: @DRY-169, @DRY-172, @DRY-180
pub fn errand_fields(state: const WaveState, pal: vector<GroundType>,
                     pw: PaintedWorld) -> vector<ErrandField> {
    ef2_out: vector<ErrandField> = [];
    for ef2_e in state.enemies {
        if !ef2_e.alive { continue; }
        // ⚠ Through `errand_cycling`, so a robot the bubble took asks
        // for nothing — the same one door the mover reads its role
        // through, and site 5 of `plans/30` § Count the RE-ASSERTION
        // SITES still has no second write to forget.
        if !errand_cycling(ef2_e, state.now) { continue; }
        ef2_row = errand_role_of(errand_role(ef2_e));
        ef2_c   = climb_limit(ef2_e.kind);
        // ⚠⚠ **A ROW WITH A TERMINAL LEG ASKS FOR A THIRD ANCHOR**, and
        // leaving it out is `@D008` again with the new leg's name on it:
        // the mob turns for home at the drop-off, finds no field to
        // descend, and charges the rest of its tick to `slip` — silent,
        // because the conformance rule is read at `now − slip` and
        // follows the body down.  ⚠ `@M072`'s budget is *at most three
        // anchors* and this is the third; a row with no shift still asks
        // for two.
        ef2_anch: vector<integer> = [ef2_row.empty, ef2_row.laden];
        if errand_terminal(ef2_row) { ef2_anch += [ANCHOR_HOME]; }
        for ef2_a in ef2_anch {
            if ef2_a == ANCHOR_NONE { continue; }
            ef2_h = errand_anchor(ef2_e.route, ef2_a);
            if errand_fields_have(ef2_out, ef2_h.q, ef2_h.r, ef2_c) {
                continue;
            }
            ef2_out += [ErrandField {
                q: ef2_h.q, r: ef2_h.r, climb: ef2_c,
                field: flow_build(pal, pw, state.heights, ef2_e.kind,
                                  Hex { q: ef2_h.q, r: ef2_h.r }),
            }];
        }
    }
    ef2_out
}

fn errand_fields_have(fields: const vector<ErrandField>, q: integer,
                      r: integer, climb: float) -> boolean {
    efh_seen = false;
    for efh_f in fields {
        if efh_f.q == q && efh_f.r == r && efh_f.climb == climb {
            efh_seen = true;
        }
    }
    efh_seen
}

// Is this robot running a routine that has somewhere to go?
//
// ⚠⚠ **THE DISPATCH, and it goes through `errand_destination` rather
// than through a flag** — so a robot the bubble has taken answers false
// here for the same reason it answers `ROLE_NONE` to `errand_role`, and
// site 5 of § Count the RE-ASSERTION SITES still has no second write to
// forget.  ⚠ A role whose row has no anchors answers false as well,
// which is `ROLE_NONE` and therefore the whole roster today.
//
// Example: @DRY-168, @DRY-169
pub fn errand_cycling(e: const Enemy, now: integer) -> boolean {
    ecy_job = errand_destination(e, now);
    ecy_job.found
}

// Move one mob on a routine by the hexes this timestep owes it — and
// pay for every one it could not spend.
//
// ⚠⚠ **THE ONE DOOR** (`@FR-E-One-Door`).  Nothing else may write
// `e.q` / `e.r` for a mob on a cycle, and `slip` is owned here so that
// there is no site left that could forget it.  ⚠ `enemy_move_to` is the
// one WRITE and this is the one DECISION — the nameable difference
// (`@X329`) is that the write keeps `Occupancy` true and knows nothing
// about routines, while this knows nothing about how a position is
// stored.
//
// ⚠⚠ **`now` is the moment the step BEGINS, never the one it ends at.**
// A mover decides where it is going and then spends the time; resolving
// the destination at the END would send a body down the leg it is about
// to be turned onto for the whole of the step before the turn.  ⚠ It is
// `tests/30_r2_the_cycle.loft`'s harness contract, and the two forms are
// indistinguishable for every role whose clock leaves it DWELLING at its
// post — which every shipped one does, so the corpus carries a guard
// with no dwell at all to keep the branch visible (`@M013`).
//
// ⚠ **The pre-walk window is TIME the mob did not spend walking**, so it
// is `slip` and nothing else: `enemy_tick` returns before banking, so
// freezing `now − slip` with it is exact at any rate and any timestep.
//
// ⚠ A hex the world refuses is SPENT and never re-banked, exactly as
// `enemy_tick` spends one — an errand mob held up by a queue must not
// store the hexes and then cross the map in one tick.  What is different
// is that the spending is RECORDED, which is the whole of `slip`.
//
// Example: @DRY-162, @DRY-163, @DRY-164, @DRY-165, @DRY-170, @DRY-171
pub fn errand_step(e: Enemy, fields: const vector<ErrandField>,
                   occ: Occupancy, blockers: const BlockerMap,
                   pal: vector<GroundType>, pw: PaintedWorld,
                   hl: HeightLayer, cl: CargoLayer,
                   now: integer, elapsed: integer) {
    if !e.alive { return; }
    if enemy_standing(e) {
        e.route.slip += elapsed;
        return;
    }
    es2_row  = errand_role_of(errand_role(e));
    es2_rate = bank_rate(enemy_speed(e.kind));
    es2_cost = cycle_hex_units(es2_rate);
    es2_left = enemy_bank(e, enemy_speed(e.kind), elapsed);
    // ⚠⚠ **HOW FAR THIS MOB HAS ACTUALLY COME, and it is the currency
    // the ending is compared in** (R4b, `@M077`).  ⚠ It is
    // `walked(now − slip)` plus the hexes RELEASED so far this tick, and
    // both halves are needed: a hex charged to `slip` moves the first
    // term down by exactly one — `cycle_hex_units` is what makes that
    // exact — while the second counts it, so the sum is the mob's true
    // offset whether it spent the hex or lost it.
    // ⚠ A count read only at the tick's start would be short by up to
    // the whole bank, and a scout releases three.
    es2_done = 0;
    while es2_left > 0 {
        // ⚠⚠ **A COUNT and no longer a boolean** (R7b): a hex walked
        // AWAY from the leg's anchor costs TWO — the one it spent and
        // the one it owes coming back — which is what lets a mob turn
        // aside for a lure and still re-converge on its own rule
        // (`@FR-E-Slip`, § A HEX WALKED AWAY FROM YOUR ANCHOR COSTS
        // TWO).  ⚠ Every step that is not a detour answers 0 or 1
        // exactly as it always did.
        e.route.slip += es2_cost
            * errand_hex(e, fields, occ, blockers, pal, pw, hl, cl,
                         es2_row, es2_rate,
                         cycle_walked(es2_rate, now - e.route.slip) + es2_done,
                         now);
        es2_left -= 1;
        es2_done += 1;
        // ⚠⚠ **A ROUND THAT HAS ENDED STOPS HERE, AND A MOVER THAT
        // RELEASES MORE THAN ONE HEX A TICK IS WHY** (R4,
        // `@FR-E-Home-Is-A-Place`).  `errand_depart` reads the position
        // at the tick's CONSEQUENCE stage, so a mob that walked THROUGH
        // its home anchor and out the other side inside one tick is
        // never seen standing on it — a scout releases 1, 2, 2 hexes a
        // tick and would cycle for ever, while the robot beside it left
        // on time.  ⚠ It is `@M014`'s class again: the shipped speed a
        // gate is most likely to use is the one that cannot see this.
        //
        // ⚠ **The remaining hexes are DROPPED and not slipped**: the mob
        // is not held up, it has arrived, and `slip` is for lateness
        // (`@FR-E-Slip`).  ⚠⚠ It is also the ONE tick a finishing mob
        // may not be on its rule's hex — the rule keeps walking and the
        // body has stopped — and it is off the roster before the
        // consequence stage ends, so nothing can ask.  A harness that
        // drives this function without `errand_depart` beside it will
        // see a mob standing at its nest for ever, which is exactly what
        // a mob whose scenario forgot to take it away should look like.
        if errand_home_done(es2_row, e.route, es2_rate,
                            Hex { q: e.q, r: e.r }, now) {
            return;
        }
    }
}

// One hex of a routine: descend the field toward the leg's anchor, and
// turn the bag over on arrival.  Answers whether the mob LOST the hex.
//
// ⚠⚠ **The destination is re-read for every hex and so is the field**,
// which is `@X335`: a mob that walks past an anchor spends its remaining
// hexes on the NEXT leg and never loses them at the turn.  A field
// chosen once per tick would send a mob that arrived mid-tick on down
// the leg it had just finished.
//
// ⚠ **The arrival is asked AFTER the step**, exactly as
// `tests/30_r2_the_cycle.loft`'s stepped harness asks it — the rule and
// the body have to flip the bag at the same hex or they are describing
// two different mobs.
//
// ── ⚠⚠ A DWELL IS NOT A BLOCK, AND THE DIFFERENCE IS `slip` ─────
//
// ⚠⚠ **A mob standing ON its own destination has not lost anything**,
// and the check before the step is what says so rather than being the
// authoring guard it looks like.  A carrier can never be there — the
// arrival after its last step already turned the bag over and named the
// other anchor — so the only mob this can be is a CLOCK-steered one
// waiting out its period at its post.
//
// ⚠ **The rule agrees, by clamping**: `cycle_phase` caps a clock leg's
// offset at the leg's own length, so the hexes a dwelling guard's bank
// keeps releasing are ones the RULE does not spend either.  Charging
// `slip` for them would drag `now − slip` backwards for as long as the
// guard stood, and its clock would then never flip at all — a guard
// frozen at its post with **every conformance count green**, because
// the frozen rule agrees with the frozen body.
//
// ── ⚠⚠ AND THE COST IS A COUNT, BECAUSE A DETOUR IS PAID BOTH WAYS ─
//
// ⚠ It answers 0, 1 or 2 — the hexes of `slip` this step owes — read
// from the ANCHOR's distance before and after and never from what the
// mover happened to aim at.  ⚠⚠ That is the whole of § A HEX WALKED AWAY
// FROM YOUR ANCHOR COSTS TWO, and it is what keeps `@FR-E-Slip` true for
// a mob that has turned aside for a lure: the rule's distance to the
// anchor equals the body's at every moment of the detour, with nothing
// remembered.
//
// ⚠ **The three answers are the three things a step can do** and every
// one of them predates R7b: closer is free, EQUAL is the sidestep that
// has always cost one, and *nothing moved* is equal too.  Only FURTHER
// is new, and only a lure can produce it.
fn errand_hex(e: Enemy, fields: const vector<ErrandField>,
              occ: Occupancy, blockers: const BlockerMap,
              pal: vector<GroundType>, pw: PaintedWorld,
              hl: HeightLayer, cl: CargoLayer,
              row: const Role, rate: integer, walked: integer,
              now: integer) -> integer {
    // ⚠ `walked` is the count BEFORE this hex, so the arrival after a
    // step that gained one is asked at `walked + 1` — the mob is one hex
    // further on than it was when the step began, and the ending is
    // compared in hexes precisely so that difference can be spelled.
    errand_arrive(e.route, row, Hex { q: e.q, r: e.r }, now,
                  errand_shift_over(row, rate, walked));
    ehx_job = errand_destination_of(row, e.route, now);
    if !ehx_job.found { return 0; }
    if ehx_job.q == e.q && ehx_job.r == e.r { return 0; }
    ehx_c  = climb_limit(e.kind);

    // ⚠⚠ **THE LURE, and it is read BEFORE the step** (R7b).  A mob
    // already standing at a heap takes it and then walks on normally
    // this same hex — the pickup is not a move and must not cost one,
    // exactly as `errand_arrive` is not a move.
    errand_lure_drop(e, row, cl);
    ehx_lure = errand_lure_at(row, e, hl, cl);
    if ehx_lure.found
        && lat_distance(Hex { q: e.q, r: e.r },
                        Hex { q: ehx_lure.q, r: ehx_lure.r })
           <= CARGO_REACH_HEXES {
        errand_lure_take(e, Hex { q: ehx_lure.q, r: ehx_lure.r }, hl, cl);
        ehx_lure = job_none();
    }

    ehx_before = FLOW_UNREACHABLE;
    ehx_after  = FLOW_UNREACHABLE;
    ehx_moved  = false;
    for ehx_f in fields {
        // ⚠ The field is passed STRAIGHT from the vector into a `const`
        // parameter and never bound to a local — a whole-value bind
        // COPIES the cell hash, per mob, per hex (`spawn.loft` § Reading
        // a class's field WITHOUT copying it: **2250x**).
        if ehx_f.q == ehx_job.q && ehx_f.r == ehx_job.r
            && ehx_f.climb == ehx_c {
            ehx_before = flow_distance(ehx_f.field, e.q, e.r);
            if ehx_lure.found {
                ehx_moved = errand_toward(e, pal, pw, hl, occ, blockers,
                                          Hex { q: ehx_lure.q,
                                                r: ehx_lure.r });
            }
            if !ehx_moved {
                ehx_moved = errand_descend(e, ehx_f.field, occ, blockers);
            }
            ehx_after = flow_distance(ehx_f.field, e.q, e.r);
        }
    }
    if ehx_moved {
        errand_arrive(e.route, row, Hex { q: e.q, r: e.r }, now,
                      errand_shift_over(row, rate, walked + 1));
    }
    errand_hex_cost(ehx_before, ehx_after)
}

// One step TOWARD a lure — strictly nearer it in lattice distance, on
// ground this class may enter, and free.  Answers whether it moved.
//
// ⚠⚠ **STRICTLY nearer is what makes it terminate**: the mob is at most
// the lure's reach away, every step takes one off that, and there is no
// pair of hexes it can oscillate between.  A rule that allowed an equal
// step would let a mob circle a heap it can never reach.
//
// ⚠ **Greedy, and that is priced.**  R0 probe 1 (`@M071`) falsified
// greedy for a whole LEG — only 10 of 90 straight crossings of the
// authored maps arrive — but a lure is four hexes away, not four
// hundred, and a lure the mob cannot greedily reach is one it simply
// walks past.  ⚠ A field per heap per tick is what the alternative
// costs, and `@FR-E-Boundable` is not worth spending on a distraction.
//
// ⚠ `can_step` is asked here where `errand_descend` does not need it —
// the field has already refused every hex its class cannot enter, and a
// lure has no field.
//
// Example: @DRY-214
fn errand_toward(e: Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                 hl: const HeightLayer, occ: Occupancy,
                 blockers: const BlockerMap, to: const Hex) -> boolean {
    etw_from = Hex { q: e.q, r: e.r };
    etw_d    = lat_distance(etw_from, to);
    if etw_d <= 0 { return false; }
    for etw_n in lat_neighbours(etw_from) {
        if lat_distance(etw_n, to) >= etw_d { continue; }
        if occupancy_taken(occ, etw_n.q, etw_n.r) { continue; }
        if blocker_taken(blockers, etw_n.q, etw_n.r) { continue; }
        if !can_step(pal, pw, hl, e.kind, etw_from, etw_n) { continue; }
        enemy_move_to(e, etw_n.q, etw_n.r, occ);
        return true;
    }
    false
}

// One step down a field toward its destination — closer if anything
// closer is free, BESIDE if only a companion stopped it, and standing
// still otherwise.  Answers whether the distance actually fell.
//
// Enforces @FR-E-Non-Increasing: the two lists it reads are
// `flow_steps` (strictly closer) and `flow_sidesteps` (exactly equal),
// so a mob's distance to its anchor can never grow.  ⚠⚠ That is not a
// detail of the sidestep — R0 probe 3 (`@X331`) is what makes R5's bound
// exist at all, and a variant admitting a FURTHER neighbour would look
// harmless here and silently take the bound with it.
//
// ⚠ **It is the same rule as `enemy_step`'s engage branch and it asks
// the same two questions in the same order**, which is what `plans/30`
// R3's *one actor, ONE occupancy rule* means: `crawler` paid for the
// other answer — *"one actor cannot have two contradictory occupancy
// rules across its two states.  A sleeping monster is not terrain."*
//
// ⚠ No `can_step` here, and deliberately: the field already refused
// every hex this class cannot enter, exactly as the engage branch's
// does.  The desire field is the one that needs the second question,
// because walls are passable in it.
fn errand_descend(e: Enemy, f: const FlowField, occ: Occupancy,
                  blockers: const BlockerMap) -> boolean {
    edd_d = flow_distance(f, e.q, e.r);
    if edd_d >= FLOW_UNREACHABLE { return false; }
    if edd_d == 0 { return false; }
    for edd_t in flow_steps(f, e.q, e.r) {
        if occupancy_taken(occ, edd_t.q, edd_t.r) { continue; }
        if blocker_taken(blockers, edd_t.q, edd_t.r) { continue; }
        enemy_move_to(e, edd_t.q, edd_t.r, occ);
        return true;
    }
    // ⚠ Every closer step the field offered was one the GROUND allowed,
    // so nothing being free can only mean a body — which is F7b's
    // unambiguous case and the one *beside* is the answer to.
    for edd_s in flow_sidesteps(f, e.q, e.r) {
        if occupancy_taken(occ, edd_s.q, edd_s.r) { continue; }
        if blocker_taken(blockers, edd_s.q, edd_s.r) { continue; }
        enemy_move_to(e, edd_s.q, edd_s.r, occ);
        // ⚠⚠ It MOVED and it made no progress, and the caller pays for
        // the difference — a sidestep is a hex of the round the mob
        // still owes, which is exactly what `slip` is.
        return false;
    }
    false
}

// ─── ⚠⚠ HOME IS A PLACE — where a ROUTINE ends ─────────────────
//
// Plan 30 R4, and `@FR-E-Home-Is-A-Place` is the whole of it: *a mob
// that finishes its round leaves the roster at a PLACE — a maintenance
// point, a nest — and never by being deleted where it happened to
// stop.*  ⚠ Owner, 2026-08-28: *"instead of going to sleep the robots
// get back to a known maintenance point once in a while, and insects to
// their nest."*
//
// ⚠⚠ **THE CONSERVATION WAS ALREADY RIGHT AND THE PLACE WAS MISSING.**
// `errand_depart` REMOVES rather than killing, so the wallet is never
// paid for traffic the player did not touch, and that half is untouched
// here.  What it gains is somewhere the player can watch them go.
//
// ── ⚠⚠ THE ENDING IS A LEG OF THE ROUND, NOT A FOURTH STATE ─────
//
// ⚠⚠ **This is the constraint that decided the design, and it comes
// from the plan's one-sentence invariant**: a mob is on its cycle, or
// its lateness is in `slip`, or it has left through the bubble — three
// states and ONE exit.  ⚠ A mob that broke off its round to walk home
// would be a FOURTH state and a SECOND exit: the rule would keep going
// round while the body headed somewhere the round never goes, and
// `cycle_at` could not answer for it at all.
//
// ⚠ So home is not somewhere a finished mob GOES — **it is a hex the
// round already passes through, and the mob leaves the roster the tick
// its own cycle brings it there**.  Nothing about the mover, the cycle
// or the conformance gate changes: the mob is exactly where its rule
// says right up to the tick it is gone.
//
// ⚠⚠ **THE BILL R4 LEFT, AND R4b PAID IT** (`@X339`): a round that
// runs `work ↔ alt` never touches home, so R4's ending reached the NEST
// and not the plant-material harvester — which `SETTING.md` § There is
// no fossil carbon makes the commonest machine in the world, because a
// planet with no fossil carbon starts every gram of fuel and plastics
// feedstock as harvested growth.  ⚠ Its dump and its repair point are
// **different places**, so it has three and a round with two.
//
// ⚠⚠ **What it needed was a TERMINAL leg** — the working legs repeat
// until the shift, then one walk to `home` and off the roster — and it
// is a change to the CLOSED FORM (`cycle_build`, `cycle_phase`,
// `cycle_turn`) rather than to this section: the turn point is
// `T = ceil(S / period) × period`, which is arithmetic, so
// `@FR-E-Closed-Form` is untouched.  ⚠ `guard` still cannot end, and
// `errand_row_fault` refuses a shift on a clock-steered row rather than
// letting the column lie.
//
// ── ⚠ WHAT ENDS A ROUND is a SPAN, not a count of rounds ────────
//
// ⚠ A count of rounds is not available without asking the CYCLE how
// long a round is, and `errand_done` has no cycle — building one would
// be two flow sweeps per mob per tick.  ⚠⚠ A span of time needs
// neither: `now − slip` is the mob's own clock, already the only
// argument `cycle_where` and `errand_leg` read, so *has this one worked
// long enough* is one subtraction.
//
// ⚠⚠ **And it cannot oscillate, which is what `@FR-E-Bag-Steers`
// forbids a clock for.**  `@M073`'s defect is a clock deciding WHICH
// ANCHOR — a period shorter than the trip turns the mob round before it
// arrives, for ever.  A shift decides nothing about direction: the mob
// keeps taking whole rounds until one of them happens to end at home
// after the span has run out.  ⚠ So a shift SHORTER than a round is not
// a bug, it is *one round*, and a shift of 0 is *never*.

// Has this routine's round come to its end, here and now?
//
// ⚠ Three questions and all three are needed: the row has an ending at
// all, the mob is standing on the home anchor, and its own clock has
// run past the shift.
//
// ⚠⚠ **The middle one is what keeps a fresh mob from departing where it
// started.**  A gatherer is authored AT its nest with an empty bag, and
// the discriminator is the third question rather than the bag: at the
// run's first moment `now − slip` is 0 and no positive shift has
// expired, and a mob held in the pre-walk window keeps it at 0 because
// `errand_step` charges the whole window to `slip`.
//
// Example: @DRY-172, @DRY-173, @DRY-176, @DRY-181, @DRY-183
pub fn errand_home_done(row: const Role, er: const Errand, rate: integer,
                        at: const Hex, now: integer) -> boolean {
    if row.shift <= 0 { return false; }
    ehd_home = errand_anchor(er, ANCHOR_HOME);
    if ehd_home.q != at.q || ehd_home.r != at.r { return false; }
    // ⚠⚠ **A ROUND WITH A TERMINAL LEG READS THE LATCH AND NOT A
    // CLOCK** (R4b): the bag was turned to `HOMEWARD` at the arrival
    // that ended the round, so *is the shift over* was already asked,
    // in hexes, at the one moment it can be asked exactly.  ⚠ Asking it
    // again here from `now` would be a second boundary, and two
    // boundaries are two things to disagree.
    if errand_terminal(row) { return er.carry == ERRAND_BAG_HOMEWARD; }
    // ⚠ A NEST-shaped round has no turn — home comes round on its own —
    // so the question is asked here, and in HEXES for `@M077`'s reason.
    ehd_t = now - er.slip;
    if ehd_t < 0 { ehd_t = 0; }
    cycle_walked(rate, ehd_t) >= cycle_walked(rate, row.shift)
}

// ─── Where a robot's business ENDS ──────────────────────────────

// Has this robot finished its business here?
//
// ⚠⚠ **THE ONE QUESTION, and its answer depends on what the robot's
// business IS.**  A robot on no routine is going the way its spawn
// marker pointed, so it is done when it can go no further that way; a
// robot on a routine is going round a CYCLE, so it is done when the
// round brings it home after its shift.  ⚠ Two businesses, two endings,
// one door out — `errand_depart` asks nothing else, so there is no
// second removal path that could disagree.
//
// ⚠⚠ **Its business is its HEADING** when it has no routine —
// `SETTING.md` says a spawn marker's direction is *what they were going
// before* — so a robot is done when it can go no further that way: the
// map's edge, a cliff, deep water.  It has crossed, and it goes on its
// way.
//
// ⚠ **Only a robot on an ERRAND is ever done.**  A cut-off robot that
// walks into a wall is besieging it, which is the whole of
// `ENEMY_MOVEMENT.md`; making that one leave would delete the game.
//
// ⚠ It asks `can_step`, the one passability rule, rather than a second
// idea of what stops a robot — the same reason `enemy_walk_heading`
// asks it.
//
// Example: @DRY-111, @DRY-172, @DRY-174
pub fn errand_done(e: const Enemy, pal: vector<GroundType>, pw: PaintedWorld,
                   hl: const HeightLayer, now: integer) -> boolean {
    if !e.errand { return false; }
    if !e.alive  { return false; }
    // ⚠⚠ **A ROBOT ON A ROUTINE IS NEVER DONE BY BUMPING INTO
    // SOMETHING** (`plans/30` R3).  Its business is a CYCLE and not a
    // heading, so *it can go no further this way* is not the end of it —
    // the mover walks it round whatever stopped it.  ⚠ Site 4 of
    // `plans/30` § Count the RE-ASSERTION SITES is *`errand_depart`
    // removes at the wrong time*, and without this line a hauler whose
    // spawn heading happened to face a cliff would be swept off the
    // roster on its first tick, mid-round, with nothing to see.
    // ⚠ **The ROW is asked and never the role id** (`@X333`) — *this
    // role has no cycle* is exactly *its legs go nowhere*.
    // ⚠⚠ **A routine has its OWN ending and it is HOME** (R4,
    // `@FR-E-Home-Is-A-Place`, § HOME IS A PLACE above), so this guard
    // is what stops the heading answering first for a mob that has one.
    ed_row = errand_role_of(errand_role(e));
    if ed_row.empty != ANCHOR_NONE {
        return errand_home_done(ed_row, e.route,
                                bank_rate(enemy_speed(e.kind)),
                                Hex { q: e.q, r: e.r }, now);
    }
    ed_from = Hex { q: e.q, r: e.r };
    ed_to   = lat_neighbour(ed_from, e.heading as integer);
    !can_step(pal, pw, hl, e.kind, ed_from, ed_to)
}

// Take every robot that has finished off the roster.  Answers how many
// went on their way.
//
// ⚠⚠ **It REMOVES rather than killing**, and the difference is the
// point: `wave_deaths` drops a body, pays salvage and raises the
// rubble that ramps a wall.  A robot that simply walked on leaves
// nothing behind, earns the player nothing, and was never theirs to
// kill.  Routing this through the death path would pay a wallet for
// traffic the player never touched.
//
// ⚠ Called at the tick's CONSEQUENCE stage beside the deaths, so a
// robot that finished this tick is gone for tick N+1 and every
// measurement inside this tick saw it.
//
// ⚠⚠ **Two robots leave through here and they leave from different
// places** (R4): one on no routine has crossed the map and goes at the
// edge of what it could walk, one on a routine goes at its HOME anchor
// — and `errand_done` is the ONE question, so there is no second
// removal path to keep in step (`@FR-E-Home-Is-A-Place`).
//
// Example: @DRY-111, @DRY-175
pub fn errand_depart(state: WaveState, pal: vector<GroundType>,
                     pw: PaintedWorld, hl: const HeightLayer) -> integer {
    ed_keep: vector<Enemy> = [];
    ed_gone = 0;
    for ed_e in state.enemies {
        // ⚠ `state.now` is the moment the TICK began — the clock is the
        // last line of `wave_tick` — which is the same moment
        // `errand_step` resolved this mob's destination at, so the
        // round that ends here is the one the mover just walked.
        if errand_done(ed_e, pal, pw, hl, state.now) {
            ed_gone += 1;
            continue;
        }
        ed_keep += [ed_e];
    }
    if ed_gone > 0 { state.enemies = ed_keep; }
    ed_gone
}

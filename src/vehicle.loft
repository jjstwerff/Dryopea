//
// The player's hover unit — the first thing in dryopea that is not an
// enemy and not a building.
//
// Plan 13 phase V1.  `docs/DESIGN.md` § 8 describes a **noncombatant
// base manager**: it cannot harm an enemy and is not hunted by one.
// Everything it does, it does by being somewhere — § 11 § Position
// triggers, not key presses: *"drive into the core = force-launch,
// drive over loot = auto-pickup, drive to a tower = repair"*.  So the
// whole of V1 is getting it to a hex, and every later phase is
// something that happens when it arrives.
//
// ── Why it needs no mover of its own (plan 13 V0) ───────────────
//
// A tick is `1 / 1.5` s because that is what an enemy takes to cross
// one hex, and `numbers.json` § player_vehicle.speed_normal is
// **3.0 hex/s** — exactly two hexes a tick.  Boost is 6.0, exactly
// four.  So the vehicle is the LAST entity in the design whose speed
// fits a whole-hex tick, and it needs none of the progress-banking
// machinery `tower.loft` uses for its fire interval.
//
// ⚠ **What forces that machinery is the HELPER, not the player** —
// 2.5 hex/s is 1.667 hexes a tick — and the phase-3 boss at 1.0 hex/s
// is 0.667.  Measured before V1 was written, because building a
// banking mover here would have been machinery with no case to justify
// it and nothing able to gate it.  See `plans/13` § V0.
//
// ── Passability: the vehicle is a CLIMB and nothing else ────────
//
// `passable.loft` asks two questions — is the SURFACE one this class
// holds, and is the STEP within its climb.  For a hover unit the first
// is a no-op: **`walk_vehicle` is `true` for every one of the twelve
// palette entries**, sea and `steep_rock` included, because it hovers
// over them.  So the height step is its whole passability, and its
// climb is its hover clearance straight out of `numbers.json`.
//
// That is why there is no passability code in this file.  The rule is
// `passable.loft`'s, the vehicle is a third KIND, and a second
// implementation would be the thing plan 11 F1 exists to prevent.

use lattice;
use palette;
use painted;
use height;
use passable;

// ─── The numbers ────────────────────────────────────────────────
//
// `examples/numbers.json` § player_vehicle, restated here because
// nothing loads that file yet — the same note `spawn.loft`,
// `damage.loft`, `tower.loft` and `wallet.loft` carry.

// numbers.json § player_vehicle.speed_normal — twice an enemy's 1.5.
pub const VEHICLE_SPEED_HEX_PER_SECOND: float = 3.0;

// numbers.json § player_vehicle.speed_boost — four hexes a tick.
pub const VEHICLE_BOOST_HEX_PER_SECOND: float = 6.0;

// numbers.json § player_vehicle.hover_clearance_idle / _boost.
//
// ⚠ **The boost figure is EXACTLY a `wall`**, and that is where § 8's
// *"boost can cross steep_rock, walls, closed perimeters"* comes from
// — it is not a separate movement mode, it is the same height rule
// with a bigger number.  A 5.0 m `wall_high` is still refused, so the
// anti-insect barrier is anti-PLAYER too.  Nobody wrote that down; it
// falls out of the two numbers meeting (plan 13 V0).
pub const VEHICLE_CLIMB_METRES:       float = 0.4;
pub const VEHICLE_BOOST_CLIMB_METRES: float = 3.0;

// numbers.json § player_vehicle.boost_duration / boost_cooldown.
pub const VEHICLE_BOOST_DURATION_S: float = 2.0;
pub const VEHICLE_BOOST_COOLDOWN_S: float = 5.0;

// ⚠ **A boost is 2.0 s and a tick is `1 / 1.5` s, so three ticks sum
// to 1.9999999999999998 and a bare `> 0.0` gives the player a FOURTH
// tick of boost.**  Exactly the trap `tower.loft::TOWER_CHARGE_EPSILON`
// exists for — a repeating fraction summing a hair short — arriving on
// a timer instead of a fire interval.  Here it would have been a 33%
// longer boost than the design says, which is the kind of thing no
// assertion about "it got over the wall" could ever see.
pub const VEHICLE_TIMER_EPSILON: float = 1.0e-9;

// numbers.json § player_vehicle.salvage_rate — metres of rubble a
// second, and **derived rather than picked**: a body is 0.5 m
// (`enemy_regular.body_height`), so this is exactly one dead robot a
// second and the three-body ramp that beats a tower takes three.
pub const VEHICLE_SALVAGE_METRES_PER_SECOND: float = 0.5;

// How far the vehicle reaches to clear, in hexes.
//
// ⚠ **FORCED, not chosen — and it is plan 13 V2's finding.**  The
// obvious rule is `DESIGN.md` § 11's *"drive over loot = auto-pickup"*
// applied to rubble: stand on the pile and clear it.  **The vehicle
// cannot get onto it.**  A hover unit climbs its 0.4 m clearance and
// the heap that beats a tower is 1.5 m — nearly four times that — so a
// reach of 0 would have built a mechanic that can never fire on the
// only case anybody wants it for.
//
// So it clears what it is BESIDE, which is what `DESIGN.md` § 7 §
// Tower-core retrieval already calls *"drive next to it"* and what
// § What kind of game this is means by *"someone must drive INTO it
// and clear them"*.  It also gives the mechanic a shape: a heap is
// eaten from the edge, and once it is under a hover's clearance the
// vehicle can drive on and finish it from on top — with no second rule,
// because the reach covers its own hex too.
pub const VEHICLE_SALVAGE_REACH_HEXES: integer = 1;

// ─── The vehicle ────────────────────────────────────────────────

// Where the player is, and where they are heading.
//
// ⚠ **`q` / `r` default to 0, which is a real hex**, so a `Vehicle {}`
// literal parks the player on the origin rather than nowhere.  That is
// deliberate and it is why `parked` exists as a separate flag: the
// zero value has to mean "not in the world", the same rule
// `damage.loft` and `wallet.loft` follow for their ledgers.  A run
// that never places a vehicle must not have one standing on its core.
// ⚠ Both timers are seconds REMAINING, and zero is the neutral value
// for each: no boost left means not boosting, no cooldown left means
// ready.  So a `Vehicle { }` literal is an idle vehicle with a boost
// available, which is the same zero-is-neutral rule `damage.loft` and
// `wallet.loft` keep for their ledgers.
pub struct Vehicle {
    q:          integer,
    r:          integer,
    to_q:       integer,
    to_r:       integer,
    parked:     boolean,   // false = not in the world at all
    boost_left: float,     // seconds of boost still burning
    cool_left:  float,     // seconds before another boost is available
}

// Factory: no vehicle in the world.
pub fn vehicle_empty() -> Vehicle {
    Vehicle { q: 0, r: 0, to_q: 0, to_r: 0, parked: false,
              boost_left: 0.0, cool_left: 0.0 }
}

// ─── Boost ──────────────────────────────────────────────────────

// Is the vehicle boosting right now?
pub fn vehicle_boosting(v: const Vehicle) -> boolean {
    v.boost_left > VEHICLE_TIMER_EPSILON
}

// Could it start a boost this tick?
pub fn vehicle_boost_ready(v: const Vehicle) -> boolean {
    v.parked && !vehicle_boosting(v) && v.cool_left <= VEHICLE_TIMER_EPSILON
}

// Start a boost.  Answers whether one started.
//
// ⚠ **The cooldown runs from the moment a boost ENDS, not from the
// moment it starts** (`DESIGN.md` § 8: *"cooldown ~5 s before next
// boost"*), so `vehicle_tick` arms it as the boost expires rather than
// this function arming it here.  Written the other way a 2 s boost
// would eat 2 s of its own 5 s cooldown and the real gap between
// boosts would be three seconds.
pub fn vehicle_boost(v: Vehicle) -> boolean {
    if !vehicle_boost_ready(v) { return false; }
    v.boost_left = VEHICLE_BOOST_DURATION_S;
    true
}

// What this vehicle climbs, in metres, in the state it is in.
//
// ⚠ **This is the answer to plan 13 V0 § 3**, which recorded a climb
// that changes with STATE as a blocker: `climb_limit(kind)` is a
// function of CLASS and cannot express it.  The fix turned out to be
// already in the tree — `passable.loft::can_climb` takes the climb
// DIRECTLY, and plan 11 F7 built it for the desire field, which needed
// exactly the same thing for a different reason ("walls are passable"
// is "the climb does not bind").  So the rule never needed changing
// and the vehicle simply asks for it by value.
pub fn vehicle_climb(v: const Vehicle) -> float {
    if vehicle_boosting(v) { return VEHICLE_BOOST_CLIMB_METRES; }
    VEHICLE_CLIMB_METRES
}

// What it covers in a tick of `tick_seconds`, in the state it is in.
pub fn vehicle_speed(v: const Vehicle) -> float {
    if vehicle_boosting(v) { return VEHICLE_BOOST_HEX_PER_SECOND; }
    VEHICLE_SPEED_HEX_PER_SECOND
}

// Is there a player in this run at all?
pub fn vehicle_present(v: const Vehicle) -> boolean {
    v.parked
}

// Put the vehicle on a hex, standing still.
//
// It does NOT check passability, and that is the same choice
// `spawn_wave` makes about a spawn marker: placing is authoring, and
// an author who puts the player somewhere unreachable has said
// something the simulation should show rather than silently correct.
pub fn vehicle_place(v: Vehicle, q: integer, r: integer) {
    v.q      = q;
    v.r      = r;
    v.to_q   = q;
    v.to_r   = r;
    v.parked = true;
}

// Point the vehicle at a hex.  It drives there over the next ticks.
pub fn vehicle_drive(v: Vehicle, q: integer, r: integer) {
    v.to_q = q;
    v.to_r = r;
}

// Has it arrived where it was pointed?
pub fn vehicle_arrived(v: const Vehicle) -> boolean {
    v.q == v.to_q && v.r == v.to_r
}

// How many whole hexes the vehicle covers in a tick of `tick_seconds`.
//
// ⚠ **A RATE, converted at the point it is applied** — the rule
// `spawn.loft::per_tick` exists for and the reason `numbers.json` goes
// on saying `hex/s`.  Two at today's tick, and the assertion that it
// IS two lives in the test rather than here: a constant hard-coding 2
// would stop reading the speed at all, and would go on saying 2 when
// the timestep changes.
//
// ⚠ **The duration is a PARAMETER and that is a dependency rule, not
// a style choice.**  `TICK_SECONDS` lives in `spawn.loft`, which
// `use`s this file — so reading it from here is a cycle the compiler
// refuses, and it is right to: the wave engine may know about the
// player, and the player must not need the wave engine to move.
//
// ⚠ It TRUNCATES, so a speed that is not a whole number of hexes per
// tick silently loses the remainder.  Every vehicle speed in
// `numbers.json` is exact today (3.0 and 6.0 hex/s are 2 and 4 hexes),
// and `plans/13` § V0 records that the helper at 2.5 and the boss at
// 1.0 are NOT — they are what forces progress banking, and this
// function is where that lands.
pub fn vehicle_hexes_per_tick(tick_seconds: float) -> integer {
    (VEHICLE_SPEED_HEX_PER_SECOND * tick_seconds) as integer? ?? 0
}

// The same, for whatever state the vehicle is in — two hexes idle and
// four boosting, both exact at today's tick (plan 13 V0).
pub fn vehicle_hexes_this_tick(v: const Vehicle, tick_seconds: float) -> integer {
    (vehicle_speed(v) * tick_seconds) as integer? ?? 0
}

// Clear rubble within reach for one tick, deepest heap first.
// Answers the metres taken away.
//
// Plan 13 phase V2.  `docs/ENEMY_MOVEMENT.md` § Bodies are terrain
// ends on the losing line — *"the kill zone ramps itself shut and then
// over the wall"* — and plan 12 B7 measured it: a base with a tower
// falls SOONER than the same base without one, because the tower's own
// dead ramp over the wall it defends.  This is the counter-play, and
// until it existed `height_clear` had been built with no caller since
// plan 12 B1.
//
// ⚠ **No key, and that is `DESIGN.md` § 11.**  Clearing happens
// because the player is THERE.  The cost is the positioning — for a
// kill zone, driving into it while it is still a kill zone — which is
// the test `CLAUDE.md` § What dryopea is applies to every mechanic.
//
// ⚠ **ONE heap a tick, the deepest in reach.**  Not all seven: a
// vehicle that cleared its whole neighbourhood at full rate each would
// tidy a wave's worth of dead in a single pass, and the pressure this
// mechanic exists to create is that clearing TAKES TIME you do not
// have.  Deepest-first because a ramp is made by the tallest pile, so
// that is the one worth eating; ties break by direction order after
// the vehicle's own hex, which keeps a scripted run repeatable.
// What one tick of clearing produced: how much, and what of.
//
// ⚠ Both halves, because the caller needs both and reading the source
// back off the layer afterwards would be a different answer — a hex
// cleared to nothing loses its entry, so its source is gone by the
// time anyone could ask.
pub struct Salvage {
    metres: float,
    source: integer,
}

pub fn vehicle_salvage(v: const Vehicle, hl: HeightLayer,
                       tick_seconds: float) -> Salvage {
    if !v.parked { return Salvage { metres: 0.0, source: -1 }; }

    vs_here  = Hex { q: v.q, r: v.r };
    vs_best  = vs_here;
    vs_deep  = height_rise(hl, vs_here.q, vs_here.r);

    vs_src = height_source(hl, vs_here.q, vs_here.r);
    for vs_d in 0..6 {
        vs_n    = lat_neighbour(vs_here, vs_d);
        vs_rise = height_rise(hl, vs_n.q, vs_n.r);
        if vs_rise > vs_deep {
            vs_deep = vs_rise;
            vs_best = vs_n;
            vs_src  = height_source(hl, vs_n.q, vs_n.r);
        }
    }
    if vs_deep <= 0.0 { return Salvage { metres: 0.0, source: -1 }; }

    vs_bite = VEHICLE_SALVAGE_METRES_PER_SECOND * tick_seconds;
    vs_took = min(vs_bite, vs_deep);
    // ⚠ `height_clear` takes the whole pile away; this wants a BITE, so
    // it goes through `height_raise` with a negative rise — which
    // `height.loft` floors at the ground and, at exactly zero, REMOVES
    // the entry.  That last part is the layer's own rule and it is what
    // makes a fully cleared hex read as authored ground again rather
    // than as a 0.0 m pile of nothing.
    // ⚠ The source is read BEFORE the bite, because a hex cleared to
    // nothing loses its entry and with it its name.
    height_raise(hl, vs_best.q, vs_best.r, 0.0 - vs_took, 0 as u8);
    Salvage { metres: vs_took, source: vs_src }
}

// Advance the vehicle one tick along the straight line to where it is
// pointed, stopping early at the first step the ground refuses.
//
// ⚠ **A LINE, not a route, and that is `docs/DESIGN.md` § 11.**  The
// player DRIVES: they hold a direction and the vehicle goes that way
// until something stops it.  Giving the player a flow field would be
// pathfinding — the machine choosing the way round an obstacle — which
// is exactly the feel that section rejects.  So a vehicle pointed
// through a wall drives up to the wall and stops, and the player is
// the one who has to go round.
//
// ⚠ **`lat_line` and nothing else**, for the reason § Hex convention
// gives: a `+ 1` on a q or an r reaching for "the next hex towards" is
// moros#10 again.
//
// ⚠ It takes the step rule from `passable.loft` rather than asking
// what a hex is made of.  A hover unit's climb is its clearance, so
// `wall` stops it, a body pile under 0.4 m does not, and water does
// not — with no branch anywhere naming any of them.
pub fn vehicle_tick(v: Vehicle, pal: vector<GroundType>, pw: PaintedWorld,
                    hl: const HeightLayer, tick_seconds: float) {
    if !v.parked { return; }

    vt_left  = vehicle_hexes_this_tick(v, tick_seconds);
    vt_climb = vehicle_climb(v);
    vt_line  = lat_line(Hex { q: v.q, r: v.r }, Hex { q: v.to_q, r: v.to_r });

    // ⚠ `lat_line` includes BOTH endpoints, so the hex it starts on is
    // the vehicle's own and is skipped — stepping onto it would burn a
    // hex of the tick's allowance going nowhere.
    vt_first = true;
    for vt_h in vt_line {
        if vt_first { vt_first = false; continue; }
        if vt_left <= 0 { return; }
        // ⚠ `can_climb` and not `can_step`: the climb is the vehicle's
        // STATE, not its class — see `vehicle_climb`.
        if !can_climb(pal, pw, hl, vt_climb, Hex { q: v.q, r: v.r }, vt_h) {
            vehicle_burn(v, tick_seconds);
            return;                       // drove into something
        }
        v.q = vt_h.q;
        v.r = vt_h.r;
        vt_left -= 1;
    }
    vehicle_burn(v, tick_seconds);
}

// Spend one tick of the boost and the cooldown.
//
// ⚠ **Called on EVERY exit from `vehicle_tick`**, including the one
// where the vehicle drove into something — a boost burns whether or
// not it got you anywhere, which is what makes spending it on the
// wrong moment a mistake the player can make.
//
// ⚠ The cooldown is armed as the boost EXPIRES, so the five seconds
// are five seconds of not boosting rather than three (§ vehicle_boost).
fn vehicle_burn(v: Vehicle, tick_seconds: float) {
    if vehicle_boosting(v) {
        v.boost_left = v.boost_left - tick_seconds;
        if !vehicle_boosting(v) {
            v.boost_left = 0.0;
            v.cool_left  = VEHICLE_BOOST_COOLDOWN_S;
        }
        return;
    }
    if v.cool_left > 0.0 {
        v.cool_left = max(v.cool_left - tick_seconds, 0.0);
    }
}

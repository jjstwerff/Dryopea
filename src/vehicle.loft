// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// The player's hover unit — the first thing in dryopea that is not an
// enemy and not a building.
//
// Plan 13 phase V1.  `docs/DESIGN.md` § 8 describes a **noncombatant
// base manager**: it cannot harm an enemy and is not hunted by one.
// Everything it does, it does by being somewhere — § 11 § Position
// triggers, not key presses: *"drive into the core = force-launch,
// drive over loot = auto-pickup, drive to a tower = repair"*.  So the
// whole of V1 is getting it to a hex, and every later phase is
// something that happens when it arrives.
//
// ── Why it needs no mover of its own (plan 13 V0) ───────────────
//
// A tick is `1 / 1.5` s because that is what an enemy takes to cross
// one hex, and `numbers.json` § player_vehicle.speed_normal is
// **3.0 hex/s** — exactly two hexes a tick.  Boost is 6.0, exactly
// four.  So the vehicle is the LAST entity in the design whose speed
// fits a whole-hex tick, and it needs none of the progress-banking
// machinery `tower.loft` uses for its fire interval.
//
// ⚠ **What forces that machinery is the HELPER, not the player** —
// 2.5 hex/s is 1.667 hexes a tick — and the phase-3 boss at 1.0 hex/s
// is 0.667.  Measured before V1 was written, because building a
// banking mover here would have been machinery with no case to justify
// it and nothing able to gate it.  See `plans/13` § V0.
//
// ── Passability: the vehicle is a CLIMB and nothing else ────────
//
// `passable.loft` asks two questions — is the SURFACE one this class
// holds, and is the STEP within its climb.  For a hover unit the first
// is a no-op: **`walk_vehicle` is `true` for every one of the twelve
// palette entries**, sea and `steep_rock` included, because it hovers
// over them.  So the height step is its whole passability, and its
// climb is its hover clearance straight out of `numbers.json`.
//
// That is why there is no passability code in this file.  The rule is
// `passable.loft`'s, the vehicle is a third KIND, and a second
// implementation would be the thing plan 11 F1 exists to prevent.

use lattice;
use palette;
use painted;
use height;
use passable;
use fixstep;

// ─── The numbers ────────────────────────────────────────────────
//
// `examples/numbers.json` § player_vehicle, restated here because
// nothing loads that file yet — the same note `spawn.loft`,
// `damage.loft`, `tower.loft` and `wallet.loft` carry.

// numbers.json § player_vehicle.speed_normal — twice an enemy's 1.5.
pub const VEHICLE_SPEED_HEX_PER_SECOND: float = 3.0;

// numbers.json § player_vehicle.speed_boost — four hexes a tick.
pub const VEHICLE_BOOST_HEX_PER_SECOND: float = 6.0;

// numbers.json § player_vehicle.hover_clearance_idle / _boost.
//
// ⚠ **The boost figure is EXACTLY a `wall`**, and that is where § 8's
// *"boost can cross steep_rock, walls, closed perimeters"* comes from
// — it is not a separate movement mode, it is the same height rule
// with a bigger number.  A 5.0 m `wall_high` is still refused, so the
// anti-insect barrier is anti-PLAYER too.  Nobody wrote that down; it
// falls out of the two numbers meeting (plan 13 V0).
pub const VEHICLE_CLIMB_METRES:       float = 0.4;
pub const VEHICLE_BOOST_CLIMB_METRES: float = 3.0;

// numbers.json § player_vehicle.hp_blocker.
//
// ⚠ **The only damage the vehicle can take**, and `DESIGN.md` § 8 is
// emphatic about why: the player is a **noncombatant base manager**,
// not a gunner.  It cannot harm an enemy and is not hunted by one.
// This number exists solely so that BLOCKING has a price — *"a minimal
// damage model that activates only by positioning choices"*.
pub const VEHICLE_HP_BLOCKER: float = 100.0;

// numbers.json § player_vehicle.boost_duration / boost_cooldown.
//
// ⚠ **The UNITS are the definition and the seconds are DERIVED** since
// plan 26 L3 — `helper.loft::HELPER_RECOVERY_UNITS` carries the reason.
//
// ⚠ **A LITERAL, and it has to be**: a const whose initialiser CASTS
// another computed const needs a temporary, and loft refuses one in a
// const ("the slot it names belongs to this declaration").  So the
// count is written out, the way `TICK_STEP_UNITS` is — and
// `tests/26_l3_the_timers.loft` § Every duration is a whole number of
// base units is what stops the literal drifting from the seconds it
// claims to be.
pub const VEHICLE_BOOST_DURATION_UNITS: integer = 6000000;    // 2 s
pub const VEHICLE_BOOST_COOLDOWN_UNITS: integer = 15000000;   // 5 s
pub const VEHICLE_BOOST_DURATION_S: float = (VEHICLE_BOOST_DURATION_UNITS as float)
                                            / (CLOCK_UNITS_PER_SECOND as float);
pub const VEHICLE_BOOST_COOLDOWN_S: float = (VEHICLE_BOOST_COOLDOWN_UNITS as float)
                                            / (CLOCK_UNITS_PER_SECOND as float);

// ⚠⚠ **`VEHICLE_TIMER_EPSILON` IS GONE (plan 26 L3), and it was the
// clearest of the three because the price was VISIBLE.**  A boost is
// 2.0 s and a tick is `1 / 1.5` s, so three ticks summed to
// 1.9999999999999998 and a bare `> 0.0` gave the player a FOURTH tick —
// a 33% longer boost than the design says, which no assertion about
// "it got over the wall" could ever see.  ⚠ Both timers are integer
// counts of base units now: 6 000 000 / 2 000 000 is 3 with nothing
// left over, at this tick length and at every other one (`@M033`).

// numbers.json § player_vehicle.salvage_rate — metres of rubble a
// second, and **derived rather than picked**: a body is 0.5 m
// (`enemy_regular.body_height`), so this is exactly one dead robot a
// second and the three-body ramp that beats a tower takes three.
pub const VEHICLE_SALVAGE_METRES_PER_SECOND: float = 0.5;

// How far the vehicle reaches to clear, in hexes.
//
// ⚠ **FORCED, not chosen — and it is plan 13 V2's finding.**  The
// obvious rule is `DESIGN.md` § 11's *"drive over loot = auto-pickup"*
// applied to rubble: stand on the pile and clear it.  **The vehicle
// cannot get onto it.**  A hover unit climbs its 0.4 m clearance and
// the heap that beats a tower is 1.5 m — nearly four times that — so a
// reach of 0 would have built a mechanic that can never fire on the
// only case anybody wants it for.
//
// So it clears what it is BESIDE, which is what `DESIGN.md` § 7 §
// Tower-core retrieval already calls *"drive next to it"* and what
// § What kind of game this is means by *"someone must drive INTO it
// and clear them"*.  It also gives the mechanic a shape: a heap is
// eaten from the edge, and once it is under a hover's clearance the
// vehicle can drive on and finish it from on top — with no second rule,
// because the reach covers its own hex too.
pub const VEHICLE_SALVAGE_REACH_HEXES: integer = 1;

// ─── The vehicle ────────────────────────────────────────────────

// Where the player is, and where they are heading.
//
// ⚠ **`q` / `r` default to 0, which is a real hex**, so a `Vehicle {}`
// literal parks the player on the origin rather than nowhere.  That is
// deliberate and it is why `parked` exists as a separate flag: the
// zero value has to mean "not in the world", the same rule
// `damage.loft` and `wallet.loft` follow for their ledgers.  A run
// that never places a vehicle must not have one standing on its core.
// ⚠ Both timers are seconds REMAINING, and zero is the neutral value
// for each: no boost left means not boosting, no cooldown left means
// ready.  So a `Vehicle { }` literal is an idle vehicle with a boost
// available, which is the same zero-is-neutral rule `damage.loft` and
// `wallet.loft` keep for their ledgers.
// ⚠⚠ **`bank` is the field this struct spent three plans without, and
// its absence was `@D003`** (plan 26 L2).  `Enemy` and `Helper` have
// carried their remainder since plan 23 K2a and plan 14 H1; the player
// truncated it, and was exact only because `3.0 * (1/1.5)` is 2.0 to
// the bit.  Measured over one simulated minute at seven tick lengths
// it covered **180 / 120 / 180 / 0 / 0 / 0 / 0** hexes against a true
// 180, and stopped moving entirely under a 250 ms tick (`@M030`).
// Zero is the neutral value for it, so a `Vehicle { }` literal is a
// player standing squarely on its hex.
pub struct Vehicle {
    q:          integer,
    r:          integer,
    to_q:       integer,
    to_r:       integer,
    parked:     boolean,   // false = not in the world at all
    boost: Timer,          // the boost, while it burns
    cool:  Timer,          // the wait before another boost is available
    taken:      float,     // blocker damage ABSORBED, never HP remaining
    bank:       Bank,      // banked ground, always under a whole hex
}

// Factory: no vehicle in the world.
pub fn vehicle_empty() -> Vehicle {
    Vehicle { q: 0, r: 0, to_q: 0, to_r: 0, parked: false,
              boost: timer_new(), cool: timer_new(), taken: 0.0,
              bank: bank_new() }
}

// ─── Blocker damage (plan 13 V5) ────────────────────────────────

// ⚠ **`vehicle_on` is GONE (plan 14 H3), and its absence is the
// point.**  Plan 13 V5 asked "is the vehicle standing on this hex?"
// because the player was the only thing that could be; with a roster
// the question is *who* is standing there, and the answer is
// `occupancy.loft`'s `BlockerMap`, built once a tick by
// `spawn.loft::wave_blockers`.  Keeping a per-vehicle predicate beside
// it would be a second door onto one question — and the one a future
// caller would reach for, because it needs no map.

// What the vehicle has left, in HP.
//
// ⚠ Damage TAKEN, not HP remaining — the rule `Enemy.taken`,
// `damage.loft` and `wallet.loft` all keep, and it matters here for
// the same reason: a `Vehicle { }` literal must be a HEALTHY vehicle,
// and zero is the only neutral value that gives it.
pub fn vehicle_hp(v: const Vehicle) -> float {
    max(VEHICLE_HP_BLOCKER - v.taken, 0.0)
}

// Land blocker damage on the vehicle.
//
// ⚠ **It does not destroy it.**  The respawn is the tick's, at the end,
// for the reason `enemy_hurt` does not kill and `damage_apply` does
// not break: one death path, so a script and the simulation cannot
// drift apart about when it happens.
pub fn vehicle_hurt(v: Vehicle, hp: float) {
    v.taken = max(v.taken + hp, 0.0);
}

// Put the vehicle back at the core, whole.
//
// `DESIGN.md` § 8 § Respawn at core: *"Vehicle death is never a
// game-loss"* — the player reappears inside the core with full HP.
//
// ⚠ **The launch countdown it is supposed to start is NOT built.**
// The design says respawning ratifies a scramble unless the player
// drives out to cancel; there is no scramble in dryopea yet, so what
// this does is the movement half only.  Recorded rather than silently
// approximated — see `plans/13` § V5.
// ⚠ **The carry goes with the damage** (plan 26 L2), for the reason
// `helper_recover_tick` clears the crew's: what reappears at the core
// is a repaired vehicle rather than the wreck that was destroyed, and
// half a hex of banked ground toward somewhere it no longer stands is
// not a fact about it.
pub fn vehicle_respawn(v: Vehicle, core: const Hex) {
    v.taken      = 0.0;
    timer_cancel(v.boost);
    timer_cancel(v.cool);
    bank_reset(v.bank);
    vehicle_place(v, core.q, core.r);
}

// ─── Boost ──────────────────────────────────────────────────────

// Is the vehicle boosting right now?
pub fn vehicle_boosting(v: const Vehicle) -> boolean {
    timer_running(v.boost)
}

// Could it start a boost this tick?
pub fn vehicle_boost_ready(v: const Vehicle) -> boolean {
    v.parked && !timer_running(v.boost) && !timer_running(v.cool)
}

// Start a boost.  Answers whether one started.
//
// ⚠ **The cooldown runs from the moment a boost ENDS, not from the
// moment it starts** (`DESIGN.md` § 8: *"cooldown ~5 s before next
// boost"*), so `vehicle_tick` arms it as the boost expires rather than
// this function arming it here.  Written the other way a 2 s boost
// would eat 2 s of its own 5 s cooldown and the real gap between
// boosts would be three seconds.
pub fn vehicle_boost(v: Vehicle) -> boolean {
    if !vehicle_boost_ready(v) { return false; }
    timer_arm(v.boost, VEHICLE_BOOST_DURATION_UNITS);
    true
}

// What this vehicle climbs, in metres, in the state it is in.
//
// ⚠ **This is the answer to plan 13 V0 § 3**, which recorded a climb
// that changes with STATE as a blocker: `climb_limit(kind)` is a
// function of CLASS and cannot express it.  The fix turned out to be
// already in the tree — `passable.loft::can_climb` takes the climb
// DIRECTLY, and plan 11 F7 built it for the desire field, which needed
// exactly the same thing for a different reason ("walls are passable"
// is "the climb does not bind").  So the rule never needed changing
// and the vehicle simply asks for it by value.
pub fn vehicle_climb(v: const Vehicle) -> float {
    if vehicle_boosting(v) { return VEHICLE_BOOST_CLIMB_METRES; }
    VEHICLE_CLIMB_METRES
}

// How fast it moves right now, in hexes per second — boost or
// cruise.
pub fn vehicle_speed(v: const Vehicle) -> float {
    if vehicle_boosting(v) { return VEHICLE_BOOST_HEX_PER_SECOND; }
    VEHICLE_SPEED_HEX_PER_SECOND
}

// Is there a player in this run at all?
pub fn vehicle_present(v: const Vehicle) -> boolean {
    v.parked
}

// Put the vehicle on a hex, standing still.
//
// It does NOT check passability, and that is the same choice
// `spawn_wave` makes about a spawn marker: placing is authoring, and
// an author who puts the player somewhere unreachable has said
// something the simulation should show rather than silently correct.
pub fn vehicle_place(v: Vehicle, q: integer, r: integer) {
    v.q      = q;
    v.r      = r;
    v.to_q   = q;
    v.to_r   = r;
    v.parked = true;
}

// Point the vehicle at a hex.  It drives there over the next ticks.
pub fn vehicle_drive(v: Vehicle, q: integer, r: integer) {
    v.to_q = q;
    v.to_r = r;
}

// Has it arrived where it was pointed?
pub fn vehicle_arrived(v: const Vehicle) -> boolean {
    v.q == v.to_q && v.r == v.to_r
}

// Bank `elapsed` base time units of movement onto the player, and
// answer the whole hexes it releases.
//
// ⚠⚠ **This is the fix for `@D003`, and it is a BANK rather than a
// better rounding** (plan 26 L2).  What stood here was
//
//     (vehicle_speed(v) * tick_seconds) as integer
//
// which truncated and carried nothing, where `spawn.loft::enemy_bank`
// and `helper.loft::helper_bank` had kept their remainder since plan
// 23 K2a.  Every vehicle speed in `numbers.json` is exact at TODAY's
// tick (3.0 and 6.0 hex/s are 2 and 4 hexes) and that is the whole of
// why nothing noticed: the arithmetic was a hair from wrong rather
// than right.
//
// ⚠⚠ **MEASURED over one simulated minute** at 667 / 500 / 333 / 200 /
// 100 / 50 / 33 ms ticks (`@M030`, `tests/26_l0_the_timestep_sweep.
// loft`): a miner at 1.0, a robot at 1.5, a scout at 2.5 and a helper
// at 2.5 hex/s came back exact at all seven, and the player read
// **180 / 120 / 180 / 0 / 0 / 0 / 0** against a true 180 — never
// leaving its starting hex at 200 ms with a whole minute to cross 40
// hexes of painted corridor.  ⚠ And the failure was not "a bit slow":
// at 200 ms a BOOSTING player covered 300 hexes and a cruising one
// none, so the truncation did not scale a rate down, it reordered
// which rates exist.
//
// ⚠ **A rounding is NOT the fix, and L0 measured that too**: a
// `+ 0.5` here fires all four defect records while OVERSHOOTING — 240
// hexes a minute at 500 ms — and still zeroes at the short end.  Only
// a carry is a rate.
//
// ⚠ **The duration is a PARAMETER and that is a dependency rule, not
// a style choice.**  `TICK_STEP_UNITS` lives in `spawn.loft`, which
// `use`s this file — so reading it from here is a cycle the compiler
// refuses, and it is right to: the wave engine may know about the
// player, and the player must not need the wave engine to move.
//
// ⚠ **The speed is a LOOKUP** — `vehicle_speed` answers boost or
// cruise — where `enemy_bank` takes an argument (`@X060`).  The player
// has one class and its variation is a STATE this file owns; an
// enemy's is a condition the roster owns.
//
// ⚠ **`plans/13` § V0 saw the shape and priced it as future work** —
// the helper at 2.5 and the boss at 1.0 are not whole hexes a tick,
// "and this function is where that lands".  What V0 could not see is
// that the TIMESTEP is the axis rather than the speed: `@X058` made it
// a free choice, and `plans/22`'s shorter tick is what turned this
// from latent into load-bearing.
pub fn vehicle_bank(v: Vehicle, elapsed: integer) -> integer {
    bank_gain(v.bank, bank_rate(vehicle_speed(v)), elapsed, BANK_WHOLE)
}

// The MOST one timestep could move the player, in the state it is in —
// an upper bound that spends nothing.
//
// ⚠ **A different question from `vehicle_bank`, and the reason it is a
// separate door** (`tick_bank.loft::bank_most`).  A caller that wants
// to know how far ahead to POINT the vehicle must not consume its
// carry to find out — `play.loft::play_steer_reach` is the one, and
// spelling it as a bank would make holding a key drain the player's
// remainder once per frame.
//
// ⚠ It is the CEILING, so at today's tick it answers 2 cruising and 4
// boosting exactly as the truncating version did, and it answers 1
// rather than 0 at a tick too short to guarantee a hex.
pub fn vehicle_hexes_per_tick(v: const Vehicle, elapsed: integer) -> integer {
    bank_most(bank_rate(vehicle_speed(v)), elapsed, BANK_WHOLE)
}

// Clear rubble within reach for one tick, deepest heap first.
// Answers the metres taken away.
//
// Plan 13 phase V2.  `docs/ENEMY_MOVEMENT.md` § Bodies are terrain
// ends on the losing line — *"the kill zone ramps itself shut and then
// over the wall"* — and plan 12 B7 measured it: a base with a tower
// falls SOONER than the same base without one, because the tower's own
// dead ramp over the wall it defends.  This is the counter-play, and
// until it existed `height_clear` had been built with no caller since
// plan 12 B1.
//
// ⚠ **No key, and that is `DESIGN.md` § 11.**  Clearing happens
// because the player is THERE.  The cost is the positioning — for a
// kill zone, driving into it while it is still a kill zone — which is
// the test `CLAUDE.md` § What dryopea is applies to every mechanic.
//
// ⚠ **ONE heap a tick, the deepest in reach.**  Not all seven: a
// vehicle that cleared its whole neighbourhood at full rate each would
// tidy a wave's worth of dead in a single pass, and the pressure this
// mechanic exists to create is that clearing TAKES TIME you do not
// have.  Deepest-first because a ramp is made by the tallest pile, so
// that is the one worth eating; ties break by direction order after
// the vehicle's own hex, which keeps a scripted run repeatable.
// What one tick of clearing produced: how much, and what of.
//
// ⚠ Both halves, because the caller needs both and reading the source
// back off the layer afterwards would be a different answer — a hex
// cleared to nothing loses its entry, so its source is gone by the
// time anyone could ask.
pub struct Salvage {
    metres: float,
    source: integer,
}

pub fn vehicle_salvage(v: const Vehicle, hl: HeightLayer,
                       tick_seconds: float) -> Salvage {
    if !v.parked { return Salvage { metres: 0.0, source: -1 }; }

    // ⚠ Bound to a local rather than returned straight out of the call:
    // a struct handed home through two nested tail calls loses what its
    // loop wrote (loft#880), and this wrapper would be the second one.
    vs_got = salvage_at(Hex { q: v.q, r: v.r }, hl, tick_seconds);
    vs_got
}

// One tick of clearing by whatever is standing at `at`.  Answers the
// metres taken away and what they were made of.
//
// ── The shared chassis, second half (plan 14 H2) ────────────────
//
// `DESIGN.md` § 9 opens with *"same chassis as the player"*, and H1
// made that true of DRIVING (`drive_along`).  This is the other half:
// the player and every helper clear the same way, at the same rate,
// with the same reach, because clearing is something the CHASSIS does
// and the two differ in nothing that bears on it.
//
// ⚠ **The rate is the vehicle's and there is no helper figure**, which
// is a statement about `numbers.json` rather than an omission: §
// helper has speed, HP, roster and order cost, and no salvage rate at
// all.  A second constant here would be a tunable this plan invented
// — the rule `plans/14` § Anchors states — and `plans/14` § What this
// plan does NOT build parks the per-helper skill profiles (§ 9's
// *"Building / Mining / Scouting"*) that would eventually give one
// crew member a different figure from another.
pub fn salvage_at(at: const Hex, hl: HeightLayer, tick_seconds: float) -> Salvage {
    vs_best  = Hex { q: at.q, r: at.r };
    vs_deep  = height_rise(hl, at.q, at.r);

    vs_src = height_source(hl, at.q, at.r);
    for vs_d in 0..6 {
        vs_n    = lat_neighbour(at, vs_d);
        vs_rise = height_rise(hl, vs_n.q, vs_n.r);
        if vs_rise > vs_deep {
            vs_deep = vs_rise;
            vs_best = vs_n;
            vs_src  = height_source(hl, vs_n.q, vs_n.r);
        }
    }
    if vs_deep <= 0.0 { return Salvage { metres: 0.0, source: -1 }; }

    vs_bite = VEHICLE_SALVAGE_METRES_PER_SECOND * tick_seconds;
    vs_took = min(vs_bite, vs_deep);
    // ⚠ `height_clear` takes the whole pile away; this wants a BITE, so
    // it goes through `height_raise` with a negative rise — which
    // `height.loft` floors at the ground and, at exactly zero, REMOVES
    // the entry.  That last part is the layer's own rule and it is what
    // makes a fully cleared hex read as authored ground again rather
    // than as a 0.0 m pile of nothing.
    // ⚠ The source is read BEFORE the bite, because a hex cleared to
    // nothing loses its entry and with it its name.
    height_raise(hl, vs_best.q, vs_best.r, 0.0 - vs_took, 0 as u8);
    Salvage { metres: vs_took, source: vs_src }
}

// Walk `hexes` hexes from `from` towards `to` along the straight line,
// stopping at the first step a climb of `climb` refuses.  Answers
// where it ended up.
//
// ── The shared chassis (plan 14 H0) ─────────────────────────────
//
// `DESIGN.md` § 9 opens with *"same chassis as the player"*, and this
// is that sentence in code: the player and every helper drive the same
// way and differ only in how far and how high.  One implementation, so
// the two cannot drift about what driving into a wall does — the rule
// plan 11 F1 states for passability, applied to movement.
//
// ⚠ **A LINE, not a route, and that is `docs/DESIGN.md` § 11.**  The
// player DRIVES: they hold a direction and the vehicle goes that way
// until something stops it.  Giving the player a flow field would be
// pathfinding — the machine choosing the way round an obstacle — which
// is exactly the feel that section rejects.  So a vehicle pointed
// through a wall drives up to the wall and stops, and the player is
// the one who has to go round.
//
// ⚠ **`lat_line` and nothing else**, for the reason § Hex convention
// gives: a `+ 1` on a q or an r reaching for "the next hex towards" is
// moros#10 again.
//
// ⚠ It takes the step rule from `passable.loft::can_climb` rather than
// asking what a hex is made of, and the climb is passed rather than
// looked up — see `vehicle_climb` for why that mattered.
pub fn drive_along(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                   from: const Hex, to: const Hex,
                   hexes: integer, climb: float) -> Hex {
    da_at   = Hex { q: from.q, r: from.r };
    da_left = hexes;

    // ⚠ `lat_line` includes BOTH endpoints, so the hex it starts on is
    // the mover's own and is skipped — stepping onto it would burn a
    // hex of the tick's allowance going nowhere.
    da_first = true;
    for da_h in lat_line(from, to) {
        if da_first { da_first = false; continue; }
        if da_left <= 0 { return da_at; }
        if !can_climb(pal, pw, hl, climb, da_at, da_h) { return da_at; }
        da_at   = da_h;
        da_left -= 1;
    }
    da_at
}

// Advance the vehicle one tick along the straight line to where it is
// pointed, stopping early at the first step the ground refuses.
pub fn vehicle_tick(v: Vehicle, pal: vector<GroundType>, pw: PaintedWorld,
                    hl: const HeightLayer, elapsed: integer) {
    if !v.parked { return; }

    vt_at = drive_along(pal, pw, hl,
                        Hex { q: v.q, r: v.r }, Hex { q: v.to_q, r: v.to_r },
                        vehicle_bank(v, elapsed),
                        vehicle_climb(v));
    v.q = vt_at.q;
    v.r = vt_at.r;

    // ⚠ **The boost and the cooldown are TIMERS, and since plan 26 L3
    // they count the same integer base units the bank above does** —
    // a separate FAMILY (`plans/26` § The invariant) in the same unit.
    vehicle_burn(v, elapsed);
}

// Spend one tick of the boost and the cooldown.
//
// ⚠ **Called on EVERY exit from `vehicle_tick`**, including the one
// where the vehicle drove into something — a boost burns whether or
// not it got you anywhere, which is what makes spending it on the
// wrong moment a mistake the player can make.
//
// ⚠ The cooldown is armed as the boost EXPIRES, so the five seconds
// are five seconds of not boosting rather than three (§ vehicle_boost).
fn vehicle_burn(v: Vehicle, elapsed: integer) {
    if timer_running(v.boost) {
        if timer_spend(v.boost, elapsed) {
            timer_arm(v.cool, VEHICLE_BOOST_COOLDOWN_UNITS);
        }
        return;
    }
    // ⚠ Unconditional, because a timer that is not running answers
    // false and stays that way — the guard the float version needed
    // (`if v.cool_left > 0.0`) was there to stop the subtraction going
    // negative, and there is nothing to go negative any more.
    timer_spend(v.cool, elapsed);
}

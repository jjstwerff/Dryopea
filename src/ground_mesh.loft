//
// The ground, as triangles — plan 25 phases M0 (tops) and M1 (sides).
//
// The decisions are `plans/25-the-terrain-mesh/README.md` and are not
// restated; what is here is what a reader of THIS file has to know.
//
// ── ⚠⚠ There is no blend, and that is measured rather than lazy ──
//
// moros's mesher averages a corner's height with every neighbour
// sharing it (`@X044`), which is what makes terrain SLOPE instead of
// step.  In dryopea that mean is a no-op at every hex, in both
// directions: `examples/palette.json` gives `height_override` to
// exactly two of twelve kinds (`wall` 3 m, `wall_high` 5 m), so across
// ground every term of the mean is 0 — and across a structure's edge
// the mean has to be SKIPPED anyway, because that edge is a face.
//
// ⚠ And skipping it is the honest picture, not the cheap one.  The
// simulation asks `can_step`, which is a height DIFFERENCE; a mesh that
// sloped where the rule steps would draw a ramp the vehicle cannot
// climb.  Flat tops and vertical sides make a height difference
// readable as the SIZE OF A QUAD, which is what the player is deciding
// about.  `@X072`.
//
// ⚠ The trigger to add a blend is plan 02's slope solver — and it must
// widen the mesh chunk's halo in the same change.  `tests/25_m2` is
// written to go red if it does not.
//
// ── ⚠⚠ Colour is a UNIFORM, so this emits ONE MESH PER KIND ─────
//
// `mesh3d::Vertex` is position + normal + uv and carries no colour, and
// that turns out to be the shape agreeing rather than a gap.  A caller
// groups hexes by `hex_surface_index` and hands each group its own
// `Mesh`; the kind's palette colour then rides on the draw call as a
// uniform.  `@X074`.
//
// ⚠ **That is a GATE requirement, not a performance choice.**
// `measure.loft::classify_world` is an EXACT colour lookup — a pixel
// that is not a palette colour is a FAULT — and a flat-unlit frame
// drawn with a palette colour as a uniform can only contain palette
// colours, by construction.  Put the colour on the vertex and GL
// interpolates it across every triangle, so each gradient pixel lands
// in `unknown` and `docs/RENDERER.md` § R0's zero-drift measurement is
// thrown away.
//
// ── ⚠ The two lookups are different questions ───────────────────
//
// HEIGHT comes from `hex_height`, which reads the AUTHORED entry and
// ADDS the runtime layer.  COLOUR comes from `hex_surface_index`, which
// answers the SURFACE.  A wall under a metre of rubble meshes its top
// at 4 m and colours `rubble`.  ⚠ Ask the height off the surface
// instead and rubble's null `height_override` swallows the wall, so
// piling debris onto one would LOWER it — visibly, and `CLAUDE.md`
// § Rubble is a LAYER is the oldest trap in the repo.
//
// ── ⚠ The winding is the lattice's, and it is asserted not assumed ──
//
// `lat_corner_metres` negates y to reach dryopea's screen frame
// (clockwise) and `lat_to_world` negates it again to reach the camera's
// (`hex_grid`'s own).  Two negations cancel, so a corner ring walked
// 0→5 is COUNTER-CLOCKWISE seen from above — GL's default front face,
// with no reversal needed.  ⚠ `tests/25_m0` recomputes that from the
// triangles this file actually emits rather than trusting the sentence:
// get it backwards and, with `GL_CULL_FACE` on, the ground is invisible
// while every other valve reads healthy.

use lattice;
use palette;
use painted;
use height;
use passable;
use render_camera;
use mesh_chunks;
use mesh3d;

// The z of a top face, given the hex's height.  A separate name because
// the eventual water surface will not use it (see § Open below) and
// because a caller reading `hex_height` for its own reasons must not
// have to know whether the mesher adds an offset.  It does not.
pub const GROUND_TOP_OFFSET: float = 0.0;

// One hex's top face, as a six-triangle fan around its centre.
//
// Emits into `m` unconditionally — the caller decides which mesh, by
// asking `hex_surface_index` (§ Colour is a uniform).  Vertices are in
// the CAMERA's world (`lat_to_world`), so this is the only geometry
// dryopea produces that is not in the screen frame.
//
// ⚠ Six triangles rather than four: a hexagon fans from its centre in
// six, and a four-triangle strip across the diagonal would put two
// vertices of unequal height on one edge the day plan 02 lands.  The
// centre vertex is what a later slope solver writes into.
//
// Example: @DRY-011
pub fn ground_top_face(m: Mesh, pal: vector<GroundType>, pw: PaintedWorld,
                       hl: const HeightLayer, q: integer, r: integer) {
    gtf_h    = Hex { q: q, r: r };
    gtf_z    = hex_height(pal, pw, hl, q, r) + GROUND_TOP_OFFSET;
    gtf_up   = vec3(0.0, 0.0, 1.0);

    gtf_c    = lat_to_world(gtf_h, gtf_z);
    gtf_mid  = add_vertex(m, vertex(gtf_c, gtf_up, vec2(0.5, 0.5)));

    // The six rim vertices, in corner order.  Bound before the loop
    // that indexes them: the fan needs corner `i` and corner `i + 1`,
    // and re-emitting the shared one would double the vertex count for
    // a mesh that is about to be flattened anyway.
    gtf_rim: vector<integer> = [];
    for gtf_i in 0..6 {
        gtf_o = lat_corner_metres(gtf_h, gtf_i);
        // ⚠ `lat_corner_metres` is already in dryopea's SCREEN frame
        // (y south), so the camera's frame is one more negation — the
        // same one `lat_to_world` makes, applied to a corner rather
        // than a centre.  There is no `lat_corner_to_world`, because a
        // second function that negates is a second place to forget.
        gtf_p = vec3(gtf_o.0, -gtf_o.1, gtf_z);
        gtf_rim += [add_vertex(m, vertex(gtf_p, gtf_up, vec2(0.0, 0.0)))];
    }

    for gtf_j in 0..6 {
        gtf_a = gtf_rim[gtf_j] ?? 0;
        gtf_b = gtf_rim[(gtf_j + 1) % 6] ?? 0;
        // (centre, corner j, corner j+1) — counter-clockwise from above,
        // which is why nothing here reverses anything.
        add_triangle(m, gtf_mid, gtf_a, gtf_b);
    }
}

// Every side face this hex owns — plan 25 phase M1.
//
// One vertical quad per direction in which this column stands ABOVE
// its neighbour, running from the neighbour's height up to this one's,
// over the two corners `lat_edge_corners` names.  Emitted into `m`
// unconditionally, exactly as `ground_top_face` is: a side belongs to
// the column that STANDS, so it takes that column's surface colour and
// the caller has already picked the mesh.
//
// ── ⚠ `hh <= nh` is the whole rule (`@X046`) ────────────────────
//
// The edge between two columns of different heights is ONE face, and
// both cells can see it.  Without the guard each is emitted twice —
// once from either side — and the second copy is back-facing, so under
// `GL_CULL_FACE` it is invisible and pure cost.  ⚠ It is `<=` and not
// `<` for the other half: two neighbours at the SAME height have no
// face between them at all, and an unconditional quad there is a
// zero-area sliver at every hex boundary in the world.
//
// ⚠ **Absent is zero, and that is correct.**  `PaintedWorld` is sparse
// and sea-default, so a wall at the edge of the painted region has a
// neighbour at height 0 and gets its quad.  The alternative — a lookup
// that answers "no such hex" and skips — draws a base with one open
// side, and only where the author stopped painting.
//
// ── ⚠ The normal comes from the NEIGHBOUR, not from the winding ──
//
// `lat_to_world(neighbour) − lat_to_world(here)`, normalised.  Reading
// it off the cross product would be the same answer only for as long
// as the corner ring's sense holds, and this file's header is one long
// account of two negations that cancel.  Taking it from the two
// centres is an outward direction by construction; `tests/25_m1`
// asserts the WINDING agrees with it, which is the pair that licenses
// `GL_CULL_FACE`.
//
// Example: @DRY-012
pub fn ground_side_faces(m: Mesh, pal: vector<GroundType>, pw: PaintedWorld,
                         hl: const HeightLayer, q: integer, r: integer) {
    gsf_h  = Hex { q: q, r: r };
    gsf_hh = hex_height(pal, pw, hl, q, r);
    gsf_cw = lat_to_world(gsf_h, 0.0);

    for gsf_d in 0..6 {
        gsf_n  = lat_neighbour(gsf_h, gsf_d);
        gsf_nh = hex_height(pal, pw, hl, gsf_n.q, gsf_n.r);
        if gsf_hh <= gsf_nh { continue; }

        gsf_e = lat_edge_corners(gsf_d);
        gsf_a = lat_corner_metres(gsf_h, gsf_e.0);
        gsf_b = lat_corner_metres(gsf_h, gsf_e.1);

        gsf_nw = lat_to_world(gsf_n, 0.0);
        gsf_nm = normalize3(sub3(gsf_nw, gsf_cw));

        // ⚠ The same y-negation the rim vertices make, for the same
        // reason: `lat_corner_metres` answers in the SCREEN frame.
        gsf_ax = gsf_a.0;
        gsf_ay = -gsf_a.1;
        gsf_bx = gsf_b.0;
        gsf_by = -gsf_b.1;

        // (a_bottom, b_bottom, b_top, a_top).  The ring runs
        // counter-clockwise seen from above, so a quad walked up from
        // the FIRST named corner faces outward.
        gsf_i0 = add_vertex(m, vertex(vec3(gsf_ax, gsf_ay, gsf_nh), gsf_nm, vec2(0.0, 0.0)));
        gsf_i1 = add_vertex(m, vertex(vec3(gsf_bx, gsf_by, gsf_nh), gsf_nm, vec2(1.0, 0.0)));
        gsf_i2 = add_vertex(m, vertex(vec3(gsf_bx, gsf_by, gsf_hh), gsf_nm, vec2(1.0, 1.0)));
        gsf_i3 = add_vertex(m, vertex(vec3(gsf_ax, gsf_ay, gsf_hh), gsf_nm, vec2(0.0, 1.0)));
        add_quad(m, gsf_i0, gsf_i1, gsf_i2, gsf_i3);
    }
}

// ─── One tile, one palette kind — plan 25 phase M2 ───────────────

// The palette kinds present in one tile's drawn region, ascending.
//
// A caller builds one `Mesh` per kind (`@X074`), and asking for a kind
// that is not in the tile costs a whole tile walk to produce an empty
// mesh — so this says which walks are worth making.
//
// ⚠ ASCENDING rather than discovery order.  The kind list is a build
// order and therefore an upload order; taken off a hash it would differ
// between two builds of one map, which is the thing `mesh_crc` exists to
// notice.
//
// Example: @DRY-015
pub fn ground_chunk_kinds(pal: vector<GroundType>, pw: PaintedWorld,
                          hl: const HeightLayer, cx: integer, cy: integer)
                          -> vector<integer> {
    gck_seen: vector<boolean> = [];
    for _ in 0..len(pal) { gck_seen += [false]; }

    gck_span = mesh_chunk_span();
    gck_o    = mesh_chunk_origin(cx, cy);
    for gck_dr in 0..gck_span {
        for gck_dq in 0..gck_span {
            gck_q = gck_o.q + gck_dq;
            gck_r = gck_o.r + gck_dr;
            if !mesh_hex_drawn(pal, pw, hl, gck_q, gck_r) { continue; }
            gck_k = hex_surface_index(pal, pw, hl, gck_q, gck_r);
            if gck_k >= 0 && gck_k < len(pal) { gck_seen[gck_k] = true; }
        }
    }

    gck_out: vector<integer> = [];
    for gck_j in 0..len(pal) {
        if gck_seen[gck_j] ?? false { gck_out += [gck_j]; }
    }
    gck_out
}

// One tile's ground, for one palette kind.
//
// Every drawn hex in the tile whose SURFACE is `kind`, as a top face
// plus the side faces that hex owns, appended to `m`.  Which hexes are
// drawn is `mesh_chunks.loft`'s question, not this one's — sea is stored
// as absence, so the region is wider than the painted set (`@X075`).
//
// ⚠⚠ **The walk is by COORDINATE, and that is the load-bearing half.**
// Row by row from the tile's own origin, so a tile's mesh is a function
// of the MAP and not of the sequence it was painted in.  Iterate the
// painted hash instead and one tile built alone comes out in a different
// order from the same tile built inside a rebuild of everything —
// identical geometry, different `mesh_crc`, and M2's invariant is then a
// statement about hash internals.
//
// ⚠ It walks the tile once PER KIND, and `ground_chunk_kinds` walks it
// again to find them: ~6 passes over 1024 hexes for a typical tile.  The
// one-pass shape is a `Mesh` per kind held together, and `CLAUDE.md`
// § Loft gotchas is why it is not written that way — a struct in a
// container is a copy.
//
// ⚠⚠ **M4 MEASURED it and the answer is: not worth doing.**  The
// redundant filter walks are **7 %** of a tile's bake; the other 93 % is
// mesh building a one-pass shape would still have to do, so the rewrite
// buys almost nothing for a structure loft makes awkward.  ⚠ K is what
// grows it, so **adding palette kinds** is what would change the answer
// — `tests/25_m4` is written as a trigger at 25 % rather than as a
// requirement.  `@M028`.
//
// Example: @DRY-014
pub fn ground_chunk_mesh(m: Mesh, pal: vector<GroundType>, pw: PaintedWorld,
                         hl: const HeightLayer, cx: integer, cy: integer,
                         kind: integer) {
    gcm_span = mesh_chunk_span();
    gcm_o    = mesh_chunk_origin(cx, cy);
    for gcm_dr in 0..gcm_span {
        for gcm_dq in 0..gcm_span {
            gcm_q = gcm_o.q + gcm_dq;
            gcm_r = gcm_o.r + gcm_dr;
            if hex_surface_index(pal, pw, hl, gcm_q, gcm_r) != kind { continue; }
            if !mesh_hex_drawn(pal, pw, hl, gcm_q, gcm_r) { continue; }
            ground_top_face(m, pal, pw, hl, gcm_q, gcm_r);
            ground_side_faces(m, pal, pw, hl, gcm_q, gcm_r);
        }
    }
}

// ─── Open, and owned by a later phase ───────────────────────────
//
// ⚠ **What draws SEA has an INTERIM as of M2, not an answer.**  The
// drawn region is the painted set plus a one-hex ring (`@X075`), which
// draws the coastline and closes an erased gap up to two hexes wide;
// `mesh_chunks.loft`'s header carries the argument and the two rejected
// candidates.  The real answer is to give water the DROP
// `examples/palette.json` already carries per kind (sea 0, water 1,
// rapids 3, waterfall 8) and nothing reads — ⚠ which changes
// `hex_height` for every consumer, so it is a decision about the
// SIMULATION rather than about drawing, and it belongs with plan 02.

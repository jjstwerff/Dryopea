// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Passability — may an enemy of this class make this move?
//
// Plan 11 phases F1 and F6.  The rule is
// `docs/ENEMY_MOVEMENT.md` § Two modes, one passability rule; this
// file is that rule and nothing else, so the flow field (F2), the
// mover (F5) and the measurement (`enemies passable`) all read one
// implementation rather than three that agree today.
//
// ── ⚠ `walk_ground` is NOT passability ──────────────────────────
//
// `wall` and `wall_high` both carry `walk_ground = true`, and that
// is CORRECT: the walkable thing about a wall is its top, which is
// how an insect comes to be up there at all.  It describes the
// SURFACE, not whether anything can get onto it.  So the obvious
// one-field predicate lets robots walk through a 3 m wall — the
// exact bug this whole rule exists to prevent, measured by plan 11
// F0 and pinned by a test in `tests/11_f1_passable.loft`.
//
// Passability is therefore TWO questions, and a move must answer
// both:
//
//   1. is the surface one this class stands on?   `walk_ground`
//   2. is the step onto it within its climb?      height vs climb
//
// ── The step is an EDGE, and F6 is where that started to matter ──
//
// The spec's rule is about a MOVE:
//
//     height(to) - height(from)  <=  climb(class)
//
// F1 could measure a POSITION with it, because everything that was
// not a structure sat at height 0 and the step onto a hex WAS that
// hex's height.  F6 ends that: `height.loft` lets runtime raise a
// hex, so two neighbours can both be raised and the step between them
// be nothing at all.  `can_step` is the rule as the spec states it,
// and it is what the field and the mover ask.
//
// ⚠ **It is asymmetric, and that is the physics.**  A drop is free —
// `height(to) - height(from)` is negative going down, and every climb
// limit is non-negative — so a robot that somehow stands on a wall can
// step off it and never back on.  An implementation that compared
// `abs(...)` would seal enemies onto the terrain they fell from.
//
// ── What a POSITION can still honestly say ──────────────────────
//
// `enemies passable` asks about a hex an enemy is standing on, with no
// history to say where it came from.  The best a position can say is
// **"some neighbour offers a legal step in"** — which is
// `height(here) - floor(here) <= climb`, where the floor is the LOWEST
// standable neighbour.  On flat ground that is the F1 rule unchanged,
// which is why F1's tests did not move; beside a raised hex it is
// strictly better, and it is the rule that lets an insect climb its
// own dead onto a `wall_high` (`ENEMY_MOVEMENT.md` § Bodies are
// terrain, point 3) with no special case anywhere.
//
// ⚠ **A position rule cannot replace the edge rule, and F6 proved
// it.**  If `flow_build` filtered its cells with `can_occupy`, the
// step check would be VACUOUS: `can_occupy(x)` means `height(x)` is
// within a climb of its lowest neighbour, so for any two adjacent
// occupiable hexes the step between them is legal in both directions
// by construction, and the height rule could be deleted without a
// single test noticing.  The field therefore filters NODES by the
// surface and EDGES by the step — see `flow.loft` § What the field is
// over.
//
// Enforces @FR-M-Two-Questions.
//
// ── Where the climb limits come from ────────────────────────────
//
// They are not new numbers.  `docs/NUMBERS.md` § `wall` already
// fixes the two heights — `wall` 3.0 m, `wall_high` 5.0 m — and
// `ENEMY_MOVEMENT.md` § Wall climbability fixes who each one stops:
// a wall stops robots and not insects, a high wall stops both.  The
// constants below are the only pair of limits that produces that
// table, which is why they are derived here rather than added to
// `examples/numbers.json` as a third statement of the same fact.

use lattice;
use palette;
use painted;
use height;
use moat;

// ─── Enemy classes ──────────────────────────────────────────────
//
// The kind discriminant every `Enemy` carries.  It lives here
// rather than in `spawn.loft` because a class IS its climb limit as
// far as movement is concerned, and the dependency has to run this
// way round: F1b makes the mover consult this file, so this file
// must not depend on the mover's.
//
// New variants APPEND — never reorder, the numbers are stored in
// enemy records.
pub const ENEMY_KIND_REGULAR: integer = 0;   // the ground robot
pub const ENEMY_KIND_INSECT:  integer = 1;   // climbs a wall, not a high one

// The player (plan 13 V1).  ⚠ **Not an enemy, and the `ENEMY_KIND_`
// prefix on its two siblings is now a scar** — the same kind `lat_`
// carries in `lattice.loft`, kept because every call site reads it.
// What this table really enumerates is MOVERS, and the player is one.
//
// ⚠ **It shares the rule and nothing else.**  A second predicate for
// the vehicle would be the exact thing plan 11 F1 exists to prevent:
// one passability rule, per-class DATA.  The player's contribution is
// a climb, like everybody else's.
pub const KIND_VEHICLE: integer = 2;

// ── The four small robots (plan 23 K0) ──────────────────────────
//
// `DESIGN.md` § Small robots: four roles, one AI — scout, harvester,
// builder and miner, economic roles from the colonisation programme
// that are hostile only because their command links broke.
//
// ⚠ **They append AFTER the vehicle**, which reads oddly and is not a
// choice: the discriminants are stored in enemy records and § New
// variants APPEND says never reorder.  The vehicle sitting in the
// middle of the enemy numbering is the same scar its own comment
// names, one row further on.
//
// ⚠ **`robot` is not retired and is not one of the four.**  It stays
// the neutral baseline every scenario in the suite was written
// against, which is what lets this phase add four classes and move no
// existing measurement.
//
// ⚠ **Their whole mechanical difference is two numbers, and both are
// now built** — what they do to a wall
// (`spawn.loft::enemy_damage_to_wall`, K0) and how fast they arrive
// (`spawn.loft::enemy_speed`, K2b) — plus the harvester's cargo, which
// is not a third mechanism but two existing lookups composing
// (`damage.loft::body_source` → `wallet.loft::loot_rate`).  A class
// that needs anything else has broken the rule this file exists for,
// and the owner's *"we will eventually design more robots"*
// (2026-08-15) is what makes that a load-bearing constraint rather
// than tidiness.
pub const ENEMY_KIND_SCOUT:     integer = 3;   // fast, and nearly harmless
pub const ENEMY_KIND_HARVESTER: integer = 4;   // hauls — the richest salvage
pub const ENEMY_KIND_BUILDER:   integer = 5;   // working tools, modest bite
pub const ENEMY_KIND_MINER:     integer = 6;   // slow, and cuts rock for a living

// Climb limits in metres — see § Where the climb limits come from.
//
// ── Why a robot climbs 2.0 m, and not 0.0 or 1.0 ────────────────
//
// It climbed 0.0 m until plan 12 B1: "any structure stops me", said
// without pretending to a precision the game had not measured.  B0
// measured it, and 0.0 turned out to say something stronger than it
// meant — a robot refused a rise of one centimetre, so **no rubble
// height a robot could walk onto existed at all** and the body ramp
// `ENEMY_MOVEMENT.md` § Bodies are terrain promises was dead for the
// class it was written about.
//
// ⚠ **A single-hex ramp onto a structure `H` high needs a climb of
// `H / 2`.**  The pile has to be low enough to step ONTO and high
// enough to leave less than a climb above it, and one number does both
// jobs — so the workable pile heights are the band `[H - c, c]`, EMPTY
// whenever `c < H / 2`, however many bodies fall.  That is why plan
// 12's first guess of ~1.0 m was wrong: half a 3.0 m `wall` is 1.5.
//
// Four constraints, and 2.0 is the interior of what they leave:
//
//   | rubble climbable at all            | c > 0   | B1's whole request |
//   | a body ramp onto a `wall`          | c >= 1.5 | H / 2              |
//   | `wall_high` stays the harder wall  | c < 2.5 | else one ramp does both |
//   | a bare `wall` still stops a robot  | c < 3.0 | plan 11 F1b        |
//
// At 2.0 the band onto a `wall` is [1.0, 2.0] — one to two robot
// bodies at `numbers.json` § enemy_regular.height.
//
// `tests/12_b0_probe.loft` § 2 sweeps the rule rather than restating
// it, and reads nothing from this constant, so it stays green whatever
// this line says.
pub const CLIMB_REGULAR: float = 2.0;
pub const CLIMB_INSECT:  float = 3.0;   // exactly a `wall`; a `wall_high` is 5.0

// The player's climb is its HOVER CLEARANCE — `numbers.json` §
// player_vehicle.hover_clearance_idle, and not a number this plan
// invented.  It hovers 0.4 m over the local terrain, so it rides a
// terrace and a shallow pile and is stopped by a 3.0 m `wall` exactly
// as a robot is.
//
// ⚠ **Boost is 3.0 m and it does NOT live here**, because a climb
// that changes while the thing is alive is not a property of its
// class — `climb_limit` takes a kind and cannot express it.  Plan 13
// V0 § 3 records the problem and V4 has to settle it; the same
// question settles `DESIGN.md`'s *"a damaged robot moves slower"*.
pub const CLIMB_VEHICLE: float = 0.4;

// How far this class can step up, in metres.
//
// ⚠ **This is the class's WHOLE contribution to passability**, which
// is what lets `spawn.loft` build one field per climb limit instead of
// one per class (plan 11 F6).  Nothing else about a kind reaches this
// file, and `tests/11_f6_height_step.loft` asserts it directly: two
// kinds that agree here produce identical fields.  Give a class a
// second movement axis — a vehicle reading `walk_vehicle` rather than
// `walk_ground`, say — and that test goes red, which is the point of
// pinning it rather than trusting the comment.
//
// An unknown kind falls to the regular limit — the STRICTEST one.
// A class the table has not learned about yet must not be handed
// the run of the map on the strength of a number nobody chose.
//
// ⚠ **The four small robots have no row here on purpose** (plan 23
// K0).  They are ground robots and share the regular's 2.0 m exactly,
// so four branches returning `CLIMB_REGULAR` would be four lines that
// cannot fail — and would hide the property that matters: one climb
// means ONE distance field serves all five, which is what § This is
// the class's WHOLE contribution says the field-per-climb design
// rests on.  `tests/23_k0_the_classes.loft` asserts the sharing
// directly, so it is pinned rather than merely intended.
pub fn climb_limit(kind: u8) -> float {
    if kind == ENEMY_KIND_INSECT as u8 { return CLIMB_INSECT; }
    if kind == KIND_VEHICLE      as u8 { return CLIMB_VEHICLE; }
    CLIMB_REGULAR
}

// The class's name, for a message a player or a failing script can
// read.  An unknown kind names its number rather than lying about
// which class it is.
pub fn enemy_class_name(kind: u8) -> text {
    if kind == ENEMY_KIND_REGULAR   as u8 { return "robot"; }
    if kind == ENEMY_KIND_INSECT    as u8 { return "insect"; }
    if kind == KIND_VEHICLE         as u8 { return "vehicle"; }
    if kind == ENEMY_KIND_SCOUT     as u8 { return "scout"; }
    if kind == ENEMY_KIND_HARVESTER as u8 { return "harvester"; }
    if kind == ENEMY_KIND_BUILDER   as u8 { return "builder"; }
    if kind == ENEMY_KIND_MINER     as u8 { return "miner"; }
    "class {kind as integer}"
}

// The inverse — a class NAME to its discriminant, or `null` for a
// name no class answers to.
//
// ⚠ **It exists so that the two script verbs cannot drift.**
// `script.loft`'s `wave` and `place` each parsed the class list
// inline, so a fifth class meant editing two `if` chains and the one
// you forgot failed by SPAWNING THE WRONG THING quietly — which is
// exactly what those sites' own comments refuse ("a typo that spawns
// the wrong class quietly turns a green run into a lie").  One table,
// two callers, and adding a class is one row.
//
// ⚠ **`vehicle` is deliberately absent.**  It is a mover and not a
// class a wave can be made of, so a script that says `wave 5 vehicle`
// must fail — see `tests/23_k0_the_classes.loft`.
pub fn enemy_class_of(name: text) -> integer? {
    if name == "robot"     { return ENEMY_KIND_REGULAR; }
    if name == "insect"    { return ENEMY_KIND_INSECT; }
    if name == "scout"     { return ENEMY_KIND_SCOUT; }
    if name == "harvester" { return ENEMY_KIND_HARVESTER; }
    if name == "builder"   { return ENEMY_KIND_BUILDER; }
    if name == "miner"     { return ENEMY_KIND_MINER; }
    null
}

// Every class a wave can be made of, in discriminant order — for the
// error message a failing script reads, so the list cannot go stale
// against `enemy_class_of` the way a hand-written string does.
pub fn enemy_class_names() -> text {
    "robot, insect, scout, harvester, builder, miner"
}

// ─── What a hex is ──────────────────────────────────────────────
//
// ── Two questions again, and they are not the same hex ──────────
//
// Plan 12 B1 put a second layer over the map, and it splits what used
// to be one lookup:
//
//   - the AUTHORED ground is what the palette paints — it is what a
//     structure's `height_override` comes from, and rubble sits ON it
//     rather than replacing it;
//   - the SURFACE is what an enemy's feet are on — rubble where a pile
//     stands, the authored kind everywhere else.
//
// ⚠ **Keeping them apart is what makes the arithmetic add.**  A 1.5 m
// pile on a 3.0 m `wall` is a 4.5 m hex: the height is the AUTHORED
// entry plus the layer.  Read the surface instead and rubble's null
// `height_override` would swallow the wall, so piling debris onto a
// wall would LOWER it.
//
// ⚠ **And keeping rubble a `GroundType` is what keeps passability one
// rule.**  `can_stand` reads `walk_ground` with no branch for debris,
// so a broken wall opens a route by being a surface rather than by
// being a special case — which is exactly what dissolves the sea trap
// B0 measured (`tests/12_b0_probe.loft` § 3): the painted layer is
// sea-default, so a breach that ERASED its hex would be less passable
// than the wall it replaced.

// The palette entry PAINTED on a hex, with no runtime on it.
// Unpainted is SEA (index 0), the sparse world's implicit default — so
// an enemy on a blank map is standing in the water, and this file says
// so rather than treating "nothing painted" as "nothing in the way".
//
// This is the height's base term and nothing else asks it; every
// question about what an enemy is standing on goes through
// `hex_ground`.
fn painted_ground(pal: vector<GroundType>, pw: PaintedWorld, q: integer, r: integer) -> GroundType {
    pg_idx = lookup_painted(pw, q, r) as integer;
    if pg_idx < 0 || pg_idx >= len(pal) { return GroundType {}; }
    // An all-default GroundType is the right miss value: its
    // `walk_ground` is false, so an index no palette entry answers
    // for is ground nothing stands on.
    pal[pg_idx] ?? GroundType {}
}

// The AUTHORED kind's name at a hex — what the MAP says is here,
// whatever runtime has since put on top of it.
//
// ⚠ Not `hex_ground_name`, and the difference is the whole of plan 12
// B1: that one answers the SURFACE, so it says "rubble" for a wall
// under a heap of bodies.  A wall under a heap is still a wall — it
// still has a wall's HP and it still breaks like one — which is why
// `damage.loft` asks this and not that.
pub fn painted_kind_name(pal: vector<GroundType>, pw: PaintedWorld,
                         q: integer, r: integer) -> text {
    pkn_e = painted_ground(pal, pw, q, r);
    if pkn_e.name == "" { return "?"; }
    pkn_e.name
}

// How high the AUTHORED ground at a hex stands, in metres, with no
// runtime on it — 0.0 for land, which is what flat ground IS.
//
// ⚠⚠ **Two terms, and they point OPPOSITE WAYS.**  A structure stands
// UP by its `height_override` and water sits DOWN by its `drop`
// (`moat.loft`), so this is a sum rather than a lookup — and no palette
// entry can contribute both, because `palette.json` gives every
// structure a null `drop` and every water kind a null `height_override`.
// ⚠ The subtraction is what makes a moat a HOLE: `can_step` is
// asymmetric, so a mover falls in for free and climbs out only within
// its limit (§ It is asymmetric, and that is the physics).
//
// ⚠ The two `?? 0.0` / `?? 0` guards are load-bearing, not defensive
// noise.  Both fields are `null` on the kinds that do not use them —
// `palette.json` writes it that way — and a null height compares
// `<= climb` as TRUE, so an unguarded read gives the right answer
// for terrain by accident and would keep giving it until loft's
// null-comparison semantics moved.  Say the zero, rather than inherit
// it.
pub fn painted_height_of(pal: vector<GroundType>, pw: PaintedWorld,
                         q: integer, r: integer) -> float {
    pho_e = painted_ground(pal, pw, q, r);
    (pho_e.height_override ?? 0.0) - moat_depth(pho_e)
}

// The SURFACE at a hex — what an enemy standing there is standing on.
//
// Rubble wherever the layer's pile CLEARS the ground, the painted kind
// everywhere else.  A palette missing the `rubble` entry falls back to
// the painted kind rather than to an all-default `GroundType`: a
// modder who shortened the palette gets the map they painted, not a
// world nothing can walk on.
//
// ── ⚠⚠ A PILE UNDER THE WATERLINE IS NOT A SURFACE (BACKLOG C5) ──
//
// The threshold is the hex's own DEPTH (`moat.loft`), not zero: half a
// metre of debris in a metre of water is still water, and standing on
// it is standing in the moat.  ⚠ **On land the two are the same
// sentence** — `moat_depth` is 0.0 for every land kind, every structure
// and the sea itself, so this is `height_piled`'s `rise > 0` unchanged
// wherever anybody has ever painted, which is why 745 gate
// measurements did not move.
//
// ⚠⚠ **It is what gives the drop a job.**  Without it a trench flips to
// walkable rubble at the first grain of spoil however deep it is, so
// the palette's 1-3-8 would decide nothing; with it, the depth is
// exactly *how much a moat swallows before it is ground again* — which
// is `docs/MATERIALS.md`'s *"a trench allowed to fill"* as arithmetic.
// ⚠⚠ **Enforces @FR-M-Waterline, and it is the ONE place the threshold
// is asked.**  `hex_ground` and `hex_surface_index` are two DOORS onto
// this one question — the entry and the identity — and they restated it
// line for line until 2026-08-29.  ⚠ The second even said so in a
// comment (*"thresholded exactly as `hex_ground` thresholds it"*), which
// is the shape `plans/32` L0 had just paid for again: **two
// implementations of one rule is a defect with a delay**, and a comment
// asserting the equivalence is not the equivalence.
//
// ⚠ The palette guard belongs here too: a palette too short to hold
// `rubble` has no kind to answer with, so the pile is not a surface and
// both doors fall through to what was painted.
fn hex_surface_is_rubble(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                         q: integer, r: integer) -> boolean {
    height_rise(hl, q, r) > moat_depth_at(pal, pw, q, r)
        && pal[GROUND_RUBBLE] != null
}

// Example: @DRY-130
fn hex_ground(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
              q: integer, r: integer) -> GroundType {
    if hex_surface_is_rubble(pal, pw, hl, q, r) {
        hg_rubble = pal[GROUND_RUBBLE];
        if hg_rubble != null { return hg_rubble; }
    }
    painted_ground(pal, pw, q, r)
}

// The surface's name at a hex, for the message that names it.
pub fn hex_ground_name(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                       q: integer, r: integer) -> text {
    hgn_e = hex_ground(pal, pw, hl, q, r);
    if hgn_e.name == "" { return "?"; }
    hgn_e.name
}

// The surface's palette INDEX at a hex (plan 25 M0).
//
// The same question `hex_ground` answers, given back as the identity
// rather than as the entry — which is what a caller that GROUPS by
// surface needs.  `ground_mesh.loft` emits one mesh per palette kind
// (`@X074`), so the index is its key; the struct would have to be
// compared field by field to serve as one.
//
// ⚠ **This is the SURFACE, not the painted kind** — `GROUND_RUBBLE`
// wherever the layer carries a pile, whatever the map says underneath.
// Pair it with `hex_height`, which is the other half and reads the
// AUTHORED entry so the two terms add: a wall under a heap meshes at
// wall + heap and colours `rubble`.  Take the height off the surface
// instead and rubble's null `height_override` swallows the wall, so
// piling debris onto one would LOWER it.
pub fn hex_surface_index(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                         q: integer, r: integer) -> integer {
    // ⚠ The same threshold `hex_ground` asks, through the same door
    // (§ A PILE UNDER THE WATERLINE) — a half-submerged pile still
    // draws as water, and a palette with no `rubble` gives back the map
    // that was painted rather than a kind the renderer cannot colour.
    if hex_surface_is_rubble(pal, pw, hl, q, r) { return GROUND_RUBBLE; }
    // ⚠⚠ **The MISS is where the two doors genuinely differ, and it is
    // not the rule**: `painted_ground` range-checks and answers an
    // all-default entry, this answers the raw index.  Left as it is
    // rather than quietly aligned — the callers group BY this index and
    // changing what an unpaintable hex groups under is a decision, not
    // a de-duplication.
    lookup_painted(pw, q, r) as integer
}

// How tall the thing standing on a hex is, in metres — the painted
// structure PLUS whatever runtime has piled on it.
//
// ⚠⚠ **Enforces @FR-M-Surface, and it is the half that is easy to get
// backwards.**  It reads the AUTHORED entry, never the surface: rubble
// sits ON the wall, so the two terms ADD.  `painted_height_of` answers
// the HEIGHT and `hex_ground` the SURFACE — swap them and rubble's null
// `height_override` swallows the wall, so piling debris onto one would
// LOWER it.  See § Two questions again.
//
// The third source — terrain shape — waits on plan 02's slope solver
// and lands as one more term here, which is the whole reason this is
// a sum rather than a lookup.
pub fn hex_height(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                  q: integer, r: integer) -> float {
    painted_height_of(pal, pw, q, r) + height_rise(hl, q, r)
}

// ─── The line over the top: what stands in the way of a SIGHT ───
//
// `can_step` asks whether a mover may cross the ground between two
// hexes; this asks whether anything on that ground reaches above a
// straight line drawn OVER it.  Two questions about the same heights,
// which is why they live in one file.
//
// ⚠ **It answers WHERE, not whether**, and that is what lets two very
// different callers share one walker.  A tower only needs the boolean
// (`tower.loft::tower_sees`) — but a camera needs the distance, because
// a blocked view is answered by SHORTENING THE BOOM to just short of
// whatever blocked it (`render_camera.loft::camera_boom_free`).  A
// predicate cannot say how far, and a second line-walker written to say
// it is a second answer about one world.

// How far above the sight line an obstacle has to reach before it
// blocks — a metre-scale rule decided at 1 nanometre.
//
// ⚠ **Not defensive noise: without it a float ulp decides whether a
// tower works.**  The canonical geometry lands ON the boundary — a
// 6 m tower, a 3 m wall halfway to a 1 m target, ray height exactly
// 3.0 — and the ratios that produce it (1/2, 1/3, 3/10) are exact in
// binary for some placements and a hair either side for others.  The
// tie goes to the LOOKER: a wall the line grazes is grazed, not hit.
//
// ⚠ Was `tower.loft::TOWER_SIGHT_EPSILON` until plan 21 R2 moved the
// walker down here; the reasoning above is the tower's and survives
// unchanged, because a camera grazing a wall wants the same answer.
pub const SIGHT_EPSILON: float = 1.0e-9;

// The first cell along `from → to` whose surface stands above the
// straight line from `from_h` to `to_h`, as its index along
// `lat_line`, or **−1** when the line is clear.
//
// ⚠ **The ENDPOINTS are walked too**, which `tower_sees` used not to
// do — and for a tower it makes no difference, measured and asserted
// (`tests/21_r2_the_boom.loft` § An endpoint cannot block its own
// line): a tower's eye is its hex's surface plus a positive height and
// its aim is the target's surface plus a positive height, so neither
// end can stand above a ray that starts on top of it.  ⚠ For the CAMERA
// it makes every difference — the far end of the camera's line is the
// EYE, and terrain there is precisely the case of the eye parked inside
// a hillside.  Excluding it would leave the one caller that needs the
// check unable to ask for it.
pub fn sight_first_block(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                         from: const Hex, to: const Hex,
                         from_h: float, to_h: float) -> integer {
    sfb_n = lat_distance(from, to);
    // A hex cannot stand between itself and its neighbour.
    if sfb_n <= 1 { return -1; }

    sfb_inv = (1.0 / (sfb_n as float)) ?? 0.0;
    sfb_i = 0;
    for sfb_c in lat_line(from, to) {
        sfb_ray = from_h + (to_h - from_h) * ((sfb_i as float) * sfb_inv);
        if hex_height(pal, pw, hl, sfb_c.q, sfb_c.r) > sfb_ray + SIGHT_EPSILON {
            return sfb_i;
        }
        sfb_i = sfb_i + 1;
    }
    -1
}

// ─── Question 1: the surface ────────────────────────────────────

// Is this hex's SURFACE one an enemy stands on at all?
//
// ⚠ **Kind-free, and that is a claim rather than an omission.**
// `walk_ground` is a property of the GROUND, and `climb_limit` is
// documented above as the class's WHOLE contribution to passability —
// so the surface question takes no class, and `tests/11_f6_height_
// step.loft` pins the consequence by giving two kinds equal fields.
// F7's desire field leans on it directly: one sweep serves every
// class, because the only thing it drops is the climb.
//
// The day a class reads `walk_vehicle` instead, this gains a kind and
// both of those go red — which is the warning, and is why it is
// written as a claim here rather than left implicit in a signature.
// ⚠⚠ **And it is what the VEHICLE reads too**, which is not what the
// palette suggests: every water kind carries `walk_vehicle: true` and
// nothing reads that field, so a hovering mover is stopped by flat sea
// exactly as a robot is (BACKLOG C5).
//
// Example: @DRY-129
pub fn hex_walkable(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                    q: integer, r: integer) -> boolean {
    // ⚠ Bound to a local, NOT `hex_ground(...).walk_ground` — reading a
    // field off a call's result in TAIL position answers the absent
    // sentinel (loft#877, which dryopea filed at F5c for an INDEX; it
    // is the same defect for a field access).  Written the short way
    // this returns false for every hex on the map, which empties every
    // flow field and stops the whole game dead — 9 tests, and none of
    // them named this function.
    hw_e = hex_ground(pal, pw, hl, q, r);
    hw_e.walk_ground
}

// Is this hex's SURFACE one a hovering mover can be over?
//
// `@D006`, BACKLOG C10.  `docs/GROUND_TYPES.md` § The master palette
// has said since plan 01 that *walkable (vehicle) is true even for
// `steep_rock` and `waterfall` because the floating vehicle hovers
// above terrain; per-agent-type traversal is the design* — and until
// C10 **no code in the tree read the column.**
//
// ⚠ Bound to a local for the reason `hex_walkable` is: a field read off
// a call's result in TAIL position answers the absent sentinel
// ([loft#877]), which here would say nothing hovers anywhere.
//
// ⚠⚠ **The two columns differ for the four WATER kinds and nothing
// else**, and that is a statement C10 had to make true: `steep_rock`
// carried `walk_vehicle: true` on the strength of *the floating vehicle
// hovers above terrain*, and a 0.4 m clearance does not clear a cliff.
// The flag was unearned because the cliff has no HEIGHT to be stopped
// by — `height_override` is null and the `slope` 40 that should raise it
// waits on plan 02 — so `walk_ground: false` was the only thing carrying
// *this is a cliff*.  ⚠ It flips back the day a cliff is tall.
// Example: @DRY-137
pub fn hex_hoverable(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                     q: integer, r: integer) -> boolean {
    hh_e = hex_ground(pal, pw, hl, q, r);
    hh_e.walk_vehicle
}

// Which column decides what a surface is for this mover.
fn surface_carries(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                   hover: boolean, q: integer, r: integer) -> boolean {
    if hover { return hex_hoverable(pal, pw, hl, q, r); }
    hex_walkable(pal, pw, hl, q, r)
}

// Why this class cannot stand on this hex's SURFACE — "" when it can.
//
// The surface question alone, with no height in it: sea is not a
// surface a ground robot stands on however low it is, and a wall's
// top IS one however high.  Keeping it separate is what lets the
// field filter its cells by the surface and its edges by the step.
//
// ⚠ It takes the LAYER, because the surface is not the painted kind
// where rubble lies on it — a pile over water is a place to stand.
pub fn stand_fault(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                   kind: u8, q: integer, r: integer) -> text {
    if hex_walkable(pal, pw, hl, q, r) { return ""; }
    "'{hex_ground_name(pal, pw, hl, q, r)}' is not a surface a {enemy_class_name(kind)} stands on"
}

// Can this class stand on this hex's surface, ignoring how it got
// there?  The boolean face of `stand_fault`.
pub fn can_stand(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                 kind: u8, q: integer, r: integer) -> boolean {
    stand_fault(pal, pw, hl, kind, q, r) == ""
}

// ─── Question 2: the step ───────────────────────────────────────

// Why this class cannot move from `from` to `to` — "" when it can.
//
// Both ends must be standable, and the rise between them must be
// within the class's climb.  This is the spec's rule verbatim, and it
// is the ONLY passability question the field's edges and the mover
// ask.
//
// It does not check adjacency: callers step through `lat_neighbour`,
// which is the only place in dryopea allowed to produce a neighbouring
// coordinate (`lattice.loft`).  A rule that re-derived adjacency here
// would be a second copy of the lattice.
pub fn step_fault(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                  kind: u8, from: const Hex, to: const Hex) -> text {
    stf_from = stand_fault(pal, pw, hl, kind, from.q, from.r);
    if stf_from != "" { return stf_from; }
    stf_to = stand_fault(pal, pw, hl, kind, to.q, to.r);
    if stf_to != "" { return stf_to; }

    stf_rise = hex_height(pal, pw, hl, to.q, to.r) - hex_height(pal, pw, hl, from.q, from.r);
    stf_c    = climb_limit(kind);
    if stf_rise > stf_c {
        return "({from.q}, {from.r}) -> ({to.q}, {to.r}) is a {stf_rise:3.1} m step and a {enemy_class_name(kind)} climbs {stf_c:3.1} m";
    }
    ""
}

// May this class move from `from` to `to`?  The boolean face of
// `step_fault`, so the two can never disagree.
pub fn can_step(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                kind: u8, from: const Hex, to: const Hex) -> boolean {
    can_climb(pal, pw, hl, climb_limit(kind), from, to)
}

// The same rule with the climb given directly rather than looked up
// from a class.
//
// ⚠ **F7's desire field is this function with a climb nothing
// exceeds.**  `docs/ENEMY_MOVEMENT.md` § Sealing the perimeter needs a
// second sweep in which *walls are passable* — where an enemy WANTS to
// go when no route exists — and "walls are passable" is exactly "the
// climb does not bind".  Written this way the desire field is the same
// BFS over the same surfaces with one number changed, rather than a
// second traversal that could disagree with the first about what
// ground is.
pub fn can_climb(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                 climb: float, from: const Hex, to: const Hex) -> boolean {
    can_travel(pal, pw, hl, climb, false, from, to)
}

// The same rule for something that HOVERS — `@D006`, BACKLOG C10.
//
// ⚠⚠ **A second DOOR over one implementation, never a second rule.**
// Plan 11 F1's *one passability rule, per-class DATA* is what stops the
// mover and the field disagreeing about what ground is, and two
// independent traversals would be exactly that.  `can_travel` is the
// rule; this and `can_climb` are the two ways of asking it, named for
// their callers.
//
// ⚠ **The surface is the only thing that differs.**  A hovering mover
// still obeys the height rule — it rides `VEHICLE_CLIMB_METRES` of
// clearance over the local terrain, so a 3.0 m `wall` stops it exactly
// as it stops a robot, and a trench it drops into is a climb OUT it
// may not have.  What changes is which surfaces exist for it at all.
pub fn can_hover(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                 climb: float, from: const Hex, to: const Hex) -> boolean {
    can_travel(pal, pw, hl, climb, true, from, to)
}

// The rule both doors are.  `hover` picks which column of the palette
// says what a surface is — `walk_ground` or `walk_vehicle`.
fn can_travel(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
              climb: float, hover: boolean, from: const Hex, to: const Hex) -> boolean {
    if !surface_carries(pal, pw, hl, hover, from.q, from.r) { return false; }
    if !surface_carries(pal, pw, hl, hover, to.q, to.r) { return false; }
    climb_ok(hex_height(pal, pw, hl, from.q, from.r),
             hex_height(pal, pw, hl, to.q, to.r), climb)
}

// ⚠⚠ **The HEIGHT half on its own, and it is NOT the rule.**
//
// `can_climb` is the rule and is defined in terms of this, so the two
// cannot disagree — this is a decomposition rather than a second door.
// What it exists for is the one caller that already knows both heights:
// `flow.loft::flow_sweep` asks the same frontier hex about six
// neighbours, so its height and its walkability are invariant across
// all six and computing them once is the same answer for a sixth of the
// work (profiled 2026-08-15: the sweep and its lookups were 75% of the
// suite's interpreted time).
//
// ⚠ **Calling this INSTEAD of `can_climb` is the bug `hex_walkable`
// exists to prevent.**  A step is legal when both ends are ground the
// class stands on AND the rise is within its climb; this is only the
// second clause.  `wall` and `wall_high` are `walk_ground = true` — a
// wall's walkable part is its top — so a height comparison on its own
// walks robots through 3 m walls.  Any caller has to have asked
// `hex_walkable` about BOTH ends first, and `flow_sweep` does.
pub fn climb_ok(from_height: float, to_height: float, climb: float) -> boolean {
    to_height - from_height <= climb
}

// ─── The position rule, for a measurement with no history ───────

// The height of the LOWEST hex a class could have stepped from — the
// floor around (q, r).
//
// `0.0` when nothing standable adjoins it, which is the world's own
// base level: an island hex is measured against sea level, exactly as
// F1's absolute rule measured every hex.  That fallback is what keeps
// a one-hex test world meaning what it meant.
//
// Not per class today: `walk_ground` is a property of the GROUND and
// every enemy class reads the same field.  The day a class reads
// `walk_vehicle` instead, this takes a kind and `climb_limit`'s
// "the class's whole contribution" note stops being true — which
// `tests/11_f6_height_step.loft` will say out loud.
pub fn hex_floor(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                 kind: u8, q: integer, r: integer) -> float {
    hf_lowest = 0.0;
    hf_any    = false;
    for hf_n in lat_neighbours(Hex { q: q, r: r }) {
        if can_stand(pal, pw, hl, kind, hf_n.q, hf_n.r) {
            hf_h = hex_height(pal, pw, hl, hf_n.q, hf_n.r);
            if !hf_any || hf_h < hf_lowest { hf_lowest = hf_h; }
            hf_any = true;
        }
    }
    if !hf_any { return 0.0; }
    hf_lowest
}

// Why this class may NOT be standing on this hex — "" when it may.
//
// The reason is the return value rather than a boolean plus a
// lookup, because every caller that reports a fault wants to name
// it: a gate that says "enemy 3 is somewhere it should not be"
// costs a debugging session that "enemy 3 stands on a 3.0 m wall
// and a robot climbs 0.0 m" does not.
//
// See § What a POSITION can still honestly say: this is the surface
// question plus "some neighbour offers a legal step in", and it is
// what `enemies passable` asks.  The mover never has to — every hex
// it moves an enemy onto passed `can_step` from a hex the enemy was
// legally on, and a legal step in is exactly what makes the
// destination legal to stand on.  So the two rules agree by
// induction rather than by coincidence.
pub fn occupancy_fault(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                       kind: u8, q: integer, r: integer) -> text {
    of_stand = stand_fault(pal, pw, hl, kind, q, r);
    if of_stand != "" { return of_stand; }

    of_rise = hex_height(pal, pw, hl, q, r) - hex_floor(pal, pw, hl, kind, q, r);
    of_c    = climb_limit(kind);
    if of_rise > of_c {
        return "'{hex_ground_name(pal, pw, hl, q, r)}' is a {of_rise:3.1} m step and a {enemy_class_name(kind)} climbs {of_c:3.1} m";
    }
    ""
}

// May this class be on this hex?  The boolean face of
// `occupancy_fault`, so the two can never disagree.
pub fn can_occupy(pal: vector<GroundType>, pw: PaintedWorld, hl: const HeightLayer,
                  kind: u8, q: integer, r: integer) -> boolean {
    occupancy_fault(pal, pw, hl, kind, q, r) == ""
}

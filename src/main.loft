//
// Plan 01 E1-live — the interactive editor entry point.
//
// Launch (per CLAUDE.md § Key commands):
//   loft src/main.loft
//   ↑ default — edits the single-slot save at ./dryopea_save.json
//
//   loft src/main.loft starter_01
//   ↑ named map — edits maps/starter_01.json + maps/starter_01_markers.json
//
// Same via `make play` / `make play MAP=starter_01`.  The `maps/`
// directory is auto-created on first save.
//
// Controls:
//   WASD              pan camera (held → debounced ~8 hexes/sec)
//   scroll wheel      zoom in/out
//   1..9, 0, -, =     select palette type (1=sea, 5=grass, 9=wall,
//                     0=wall_high; - and = reserved for indices 10
//                     and 11 as the palette grows past 9 types)
//   Left-click/drag   paint hovered hex with active type
//                     (ground mode) — in marker mode, single-click
//                     places a spawn at the hovered hex with the
//                     current place-direction; clicking on an
//                     existing marker removes it.
//   Tab               toggle Ground ↔ Marker mode; the badge in
//                     the top-right of the HUD shows the current
//                     mode (grass-green = Ground, hot pink = Marker).
//   R / Shift+R       (marker mode, kind=spawn) rotate the
//                     place-direction clockwise / counter-
//                     clockwise (0..5, mod 6).  No-op when
//                     kind=target (targets are spherical).
//                     A faint outline ghost preview at the
//                     hovered hex previews where the next click
//                     will land.
//   K                 (marker mode) cycle the place-kind:
//                     SPAWN ↔ TARGET.  Targets are sub-mode
//                     markers @PLAN50 consumes — placed at
//                     hex coords, anchored to the extruded
//                     surface at render time.
//   Ctrl+S            save to dryopea_save.json
//   Ctrl+Z            undo the most recent action.  Strokes
//                     count as ONE action (one drag = one undo).
//                     50-deep history.
//   Ctrl+Y            redo (re-apply the most recently undone).
//                     Any non-undo action discards the redo
//                     branch.
//   Ctrl+R            reload painted + marker layers from disk,
//                     discarding any in-memory changes.  Ctrl+Z
//                     restores the pre-reload state (one entry
//                     captures the whole diff).
//   Ctrl+N            clear all — empty painted layer, empty
//                     marker layer, reset camera to origin.
//                     Recorded as one undoable action.  Does
//                     NOT auto-save; the next Ctrl+S commits
//                     the cleared state.
//   H                 recentre camera at origin (without clearing
//                     painted or marker layers).  Letter rather
//                     than `Home` because graphics.loft doesn't
//                     ship a KEY_HOME constant yet.
//   Esc               save + exit
//
// Hotkey strategy: 12 base slots (1234567890-=) cover the near-term
// palette growth.  Future expansion uses modifier engagers (Shift,
// Ctrl, Shift+Ctrl) × the 12 base keys = 48 slots, plenty of room
// without abandoning row-1 muscle memory.
//
// On startup, loads dryopea_save.json if it exists; otherwise
// starts on an empty (all-sea) world.  Saves on exit so paint
// progress isn't lost when the window is closed without Ctrl+S.
//
// ── Structure (plan 08 phase V0) ────────────────────────────────
//
// Editor state lives in ONE `EditorState` (`src/editor_step.loft`),
// which is inside the `dryopea.loft` aggregator and therefore
// compiled + tested.  This file is the GL shell around it: open a
// window, poll input, call the seam, render.
//
// EVERY action now lives in `editor_step`.  Nothing here decides
// what an action means or mutates the world — the loop below reads
// the keyboard into an `EditorInput`, hands it over, and reports
// what changed by reading the state back.  Two things stay on this
// side on purpose:
//
//   - The rate limits (pan, paint).  `editor_step` must not read a
//     clock, or a scripted run would not be reproducible; so the
//     caller decides when a step is due and says so in the input.
//   - Combo resolution (Ctrl+R is reload, plain R is rotate).
//     Which physical keys mean an action is a keyboard concern; a
//     script names the action directly and never sees a modifier.
//
// Edge detection is NOT on this side: a held key is reported as
// held, and the seam decides whether it has just been pressed.
// That is what makes a scripted `hold Tab 5` behave the way holding
// Tab behaves for a player.

#cwd

use dryopea;
use graphics;

// The window size and the frame composition both live in
// `src/editor_view.loft` (VIEW_W / VIEW_H / VIEW_PPM +
// render_editor_frame), so a scripted `snap` photographs the same
// picture at the same size this window shows.
const PALETTE_PATH: text = "examples/palette.json";

// Default-slot paths (no CLI arg).  Named maps live under
// `maps/{name}.json` + `maps/{name}_markers.json` instead — see
// the path resolution at the top of `main()`.
const DEFAULT_SAVE_PATH:        text = "dryopea_save.json";
const DEFAULT_MARKER_SAVE_PATH: text = "dryopea_save_markers.json";

// Debounce thresholds in microseconds (`ticks()` is microsecond-
// precision).  Held keys fire at the rates below, not 60Hz.
const PAN_DEBOUNCE_US:   integer = 120000;   // ~8 hexes/sec
const PAINT_DEBOUNCE_US: integer = 50000;    // ~20 hexes/sec

// ASCII key codes that loft's graphics:: lib doesn't expose as
// symbolic KEY_* constants yet — graphics.loft has 0-9 + a
// handful of named letters (W A S D Q E O R F Z Y) but not all
// row-letters and no `-` / `=`.  Loft's key constants ARE the
// lowercase ASCII codes (`KEY_W = 119`, etc.); follow the same
// convention.  The dedicated `Home` key isn't in graphics.loft
// today either — using letter `H` instead for camera recentre.
const KEY_MINUS: integer = 45;    // ASCII '-' — palette index 10
const KEY_EQUAL: integer = 61;    // ASCII '=' — palette index 11
const KEY_N:     integer = 110;   // ASCII 'n' — Ctrl+N clears all
const KEY_H:     integer = 104;   // ASCII 'h' — recentre camera
const KEY_K:     integer = 107;   // ASCII 'k' — cycle marker kind

fn main() {
    // Resolve save paths from CLI args.  No args → default single-
    // slot save at the cwd-relative path.  One arg (a map name) →
    // `maps/{name}.json` + `maps/{name}_markers.json`; mkdir_all the
    // directory so the first save works on a fresh checkout.
    args = arguments();
    save_path:        text = DEFAULT_SAVE_PATH;
    marker_save_path: text = DEFAULT_MARKER_SAVE_PATH;
    map_label:        text = "<default>";
    if len(args) > 0 && args[0] != "" {
        map_name = args[0];
        save_path        = "maps/{map_name}.json";
        marker_save_path = "maps/{map_name}_markers.json";
        map_label        = map_name;
        mkdir_all("maps");
    }

    if !gl_create_window(VIEW_W, VIEW_H, "dryopea editor — {map_label}") {
        println("dryopea: failed to open window");
        return;
    }
    painter = create_painter_2d(VIEW_W as float, VIEW_H as float);

    palette = load_palette(PALETTE_PATH);

    // The whole editor session in one state object: painted + marker
    // layers, camera, picker, mode, undo history, chunk dirty set.
    // `editor_state_from` adopts the layers loaded off disk.
    loaded = load_map_or_empty(save_path, palette);
    s = editor_state_from(
        loaded.0,
        load_markers_or_empty(marker_save_path),
        loaded.1,
        picker_default(PALETTE_PATH),
    );
    editor_state_attach(s, save_path, marker_save_path);
    println("dryopea: editor open map=[{map_label}] ({painted_count(s.pw)} hexes, {marker_count(s.mw)} markers loaded)");
    println("         paths: {save_path} + {marker_save_path}");

    // ── Render gate (plan 07) ───────────────────────────────────
    // The world is only re-rasterised + re-uploaded when something
    // changed.  Content edits mark gridmesh's dirty set (s.cf);
    // camera / hover / mode / picker / placement changes set
    // s.render_needed.  Idle frames just redraw the cached texture —
    // no per-frame full recompute (the sluggishness fix).
    cur_tex:       integer = 0;           // 0 = no texture uploaded yet
    last_hover_q:  integer = 0;
    last_hover_r:  integer = 0;

    last_pan_us:   integer = 0;
    last_paint_us: integer = 0;

    // Edge-detection state for the still-inline actions.  A held key
    // must fire ONCE, not at 60Hz, so each one tracks its previous-
    // frame state and acts only on the rising edge.  These are input-
    // layer bookkeeping, not editor state — they stay here when the
    // actions themselves move into the seam.

    for _ in 0..1000000 {
        if !gl_poll_events() { break; }
        if gl_key_pressed(graphics::KEY_ESCAPE) { break; }

        tnow = ticks();

        // ── Input ───────────────────────────────────────────────

        ctrl_held = gl_key_pressed(graphics::KEY_CTRL);
        wheel = gl_mouse_wheel();

        // Modifier state — read once, used by the combo resolution
        // below.  Modifiers are not actions; they only decide WHICH
        // action a key means.
        shift_held = gl_key_pressed(graphics::KEY_SHIFT);

        // Camera pan + zoom, rate-limited so a held key walks the
        // camera at a readable ~8 hexes/sec rather than at 60Hz.
        // Pan-south is suppressed when Ctrl is held so Ctrl+S
        // doesn't also pan.
        pan_due  = tnow - last_pan_us > PAN_DEBOUNCE_US;
        pan_n    = pan_due && gl_key_pressed(graphics::KEY_W);
        pan_s    = pan_due && gl_key_pressed(graphics::KEY_S) && !ctrl_held;
        pan_e    = pan_due && gl_key_pressed(graphics::KEY_D);
        pan_w    = pan_due && gl_key_pressed(graphics::KEY_A);
        zoom_in  = pan_due && wheel > 0;
        zoom_out = pan_due && wheel < 0;
        if pan_n || pan_s || pan_e || pan_w || zoom_in || zoom_out {
            last_pan_us = tnow;
        }

        // Palette hotkeys → one selection index.  Idempotent, so no
        // edge detection; last key wins if several are down.
        sel_pressed: boolean = false;
        sel_index:   integer = 0;
        if gl_key_pressed(graphics::KEY_1) { sel_pressed = true; sel_index = 0; }
        if gl_key_pressed(graphics::KEY_2) { sel_pressed = true; sel_index = 1; }
        if gl_key_pressed(graphics::KEY_3) { sel_pressed = true; sel_index = 2; }
        if gl_key_pressed(graphics::KEY_4) { sel_pressed = true; sel_index = 3; }
        if gl_key_pressed(graphics::KEY_5) { sel_pressed = true; sel_index = 4; }
        if gl_key_pressed(graphics::KEY_6) { sel_pressed = true; sel_index = 5; }
        if gl_key_pressed(graphics::KEY_7) { sel_pressed = true; sel_index = 6; }
        if gl_key_pressed(graphics::KEY_8) { sel_pressed = true; sel_index = 7; }
        if gl_key_pressed(graphics::KEY_9) { sel_pressed = true; sel_index = 8; }
        if gl_key_pressed(graphics::KEY_0) { sel_pressed = true; sel_index = 9; }
        if gl_key_pressed(KEY_MINUS)       { sel_pressed = true; sel_index = 10; }
        if gl_key_pressed(KEY_EQUAL)       { sel_pressed = true; sel_index = 11; }

        // Mouse — hover + paint on left-button.
        mx = gl_mouse_x() as integer;
        my = gl_mouse_y() as integer;
        hovered = screen_to_hex(s.cam, mx, my, VIEW_W, VIEW_H, VIEW_PPM);
        if hovered.q != last_hover_q || hovered.r != last_hover_r {
            s.render_needed = true;   // hover preview / outline follows the cursor
        }

        mb_now = (gl_mouse_button() & 1) != 0;

        // ── The seam (plan 08 V0a + V0b) ────────────────────────
        // Held-key state goes IN; what each action means, and
        // whether a held key has just been pressed, is decided
        // inside `editor_step`.  This file's remaining job is the
        // rate limit: the clock stays on the polling side so the
        // step is reproducible, which is what lets a test or a
        // script drive it without a window.
        //
        // Ctrl+R is reload, so plain R only means "rotate" when
        // Ctrl is up — resolving a combo into which action was
        // meant is poll-side work.
        paint_tick_due = tnow - last_paint_us > PAINT_DEBOUNCE_US;
        pre_mode    = s.mode;
        pre_dir     = s.place_direction;
        pre_kind    = s.place_kind;
        pre_markers = marker_count(s.mw);
        pre_cursor  = s.history.cursor;
        pre_dirty   = s.dirty;
        editor_step(s, EditorInput {
            in_hover_q:        hovered.q,
            in_hover_r:        hovered.r,
            in_mouse_left:     mb_now,
            in_paint_tick:     paint_tick_due,
            in_toggle_mode:    gl_key_pressed(graphics::KEY_TAB),
            in_rotate:         gl_key_pressed(graphics::KEY_R) && !ctrl_held,
            in_rotate_ccw:     shift_held,
            in_cycle_kind:     gl_key_pressed(KEY_K) && !ctrl_held,
            in_select_palette: sel_pressed,
            in_palette_index:  sel_index,
            in_pan_north:      pan_n,
            in_pan_south:      pan_s,
            in_pan_east:       pan_e,
            in_pan_west:       pan_w,
            in_zoom_in:        zoom_in,
            in_zoom_out:       zoom_out,
            // Ctrl+H is left free for a future binding, so plain H
            // only means recentre when Ctrl is up.
            in_recentre:       gl_key_pressed(KEY_H) && !ctrl_held,
            in_undo:           ctrl_held && gl_key_pressed(graphics::KEY_Z),
            in_redo:           ctrl_held && gl_key_pressed(graphics::KEY_Y),
            in_clear_all:      ctrl_held && gl_key_pressed(KEY_N),
            in_save:           ctrl_held && gl_key_pressed(graphics::KEY_S),
            // Plain R rotates, Ctrl+R reloads — the modifier is what
            // tells the two apart.
            in_reload:         ctrl_held && gl_key_pressed(graphics::KEY_R),
        });
        if mb_now && s.mode == MODE_GROUND && paint_tick_due {
            last_paint_us = tnow;
        }

        // Console echo for the tool changes the HUD can't fully
        // show.  Read back from the state rather than predicted:
        // the step decides, this only reports.
        if s.mode != pre_mode {
            println("dryopea: mode = {mode_name(s.mode)}");
        }
        if s.place_direction != pre_dir {
            println("dryopea: place_direction = {s.place_direction as integer}");
        }
        if s.place_kind != pre_kind {
            println("dryopea: place_kind = {if s.place_kind == MARKER_KIND_TARGET { "TARGET" } else { "SPAWN" }}");
        }
        if marker_count(s.mw) != pre_markers {
            println("dryopea: markers = {marker_count(s.mw)} (clicked {hovered.q}, {hovered.r})");
        }
        if s.history.cursor != pre_cursor {
            println("dryopea: history {s.history.cursor}/{len(s.history.entries)} ({painted_count(s.pw)} hexes, {marker_count(s.mw)} markers)");
        }
        // Only a save or a reload makes memory match disk again.
        if pre_dirty && !s.dirty {
            println("dryopea: disk in sync ({painted_count(s.pw)} hexes, {marker_count(s.mw)} markers)");
        }

        // ── Render ──────────────────────────────────────────────

        // What the frame CONTAINS is `render_editor_frame`
        // (src/editor_view.loft), shared with the script runner's
        // `snap` so a shot is this picture and not a second one.
        // What is left here is the render GATE: re-rasterise +
        // re-upload ONLY when something changed — content edits
        // flag gridmesh's dirty set, view changes flag
        // s.render_needed — and otherwise reuse the cached texture.
        do_render = s.render_needed || chunks_dirty_count(s.cf) > 0;
        if do_render {
            cv = render_editor_frame(s, VIEW_W, VIEW_H, VIEW_PPM);

            // Swap the cached GL texture (free the old one first).
            if cur_tex != 0 { gl_delete_texture(cur_tex); }
            cur_tex = gl_upload_canvas(cv.data, cv.width, cv.height);
            s.render_needed = false;
            chunks_clear(s.cf);
            last_hover_q = hovered.q;
            last_hover_r = hovered.r;
        }

        // Present the cached texture every frame (cheap GPU blit +
        // swap); only the rasterise + upload above are gated.
        gl_clear(rgb(0, 0, 0));
        draw_texture_at(painter, cur_tex, 0.0, 0.0, VIEW_W as float, VIEW_H as float);
        gl_swap_buffers();
    }

    if cur_tex != 0 { gl_delete_texture(cur_tex); }

    // Save on exit so progress isn't lost when the window closes.
    save_world(s.pw, s.cam, palette, "exit", save_path);
    save_markers(s.mw, "exit", marker_save_path);
    println("dryopea: saved on exit map=[{map_label}] ({painted_count(s.pw)} hexes, {marker_count(s.mw)} markers)");
    gl_destroy_window();
}

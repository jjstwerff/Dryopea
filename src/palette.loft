//
// Palette loader.  GroundType mirrors `examples/palette.json`'s
// fields verbatim — loft's JSON-cast (`text as vector<T>`) does
// the parsing in one line.  Modders edit palette.json and
// re-launch; no rebuild (DESIGN.md § 17 Moddability).
//
// Plan 01 phase E2.

use graphics;     // rgb() for parse_hex_color output

// Matches the JSON shape directly.  Field names = JSON keys.
//   color stays as "#rrggbb" text; callers parse on demand via
//   parse_hex_color so palette.json stays human-editable.
//
// `extrusion_kind` + `height_override` are the 3D-extrusion
// contract dryopea exports to runtime consumers (the dryopea
// game itself, plus @PLAN50 bumper-airplanes which reads
// MapFile + palette to extrude the painted world into 3D).
// extrusion_kind ∈ {"flat", "ramp", "pillar", "cliff"}; see
// docs/GROUND_TYPES.md § Extrusion mapping.  height_override
// is the absolute height in metres for structure types
// (pillar / cliff); nullable for terrain types whose height
// comes from the slope-solver instead.
// ⚠ `slope`, `drop` and `height_override` are declared NULLABLE
// because `palette.json` writes `null` in each of them — `slope` for
// every water type, `drop` for every land type, `height_override`
// for everything that is not a structure.  The declaration follows
// the data rather than the other way round.
//
// It did not always: they were plain non-null scalars, and the JSON
// cast filled them with `null` regardless (loft's DN1 default says a
// plain `float` rejects null; the cast is not checked against it).
// So a reader got a null the type promised could not exist, and —
// worse — the compiler reported the `?? 0.0` that defends against it
// as a REDUNDANT coalesce, i.e. it advised deleting the guard that
// was doing the work.  Measured 2026-08-12 (plan 11 F1);
// QUESTIONS_FOR_LOFT.md § A `text as vector<Struct>` cast stores
// `null` into a DN1 non-null scalar field.
//
// With `?` on the field the type tells the truth, the guard is not
// redundant, and `passable.loft` reads a height it can trust.
pub struct GroundType {
    name:            text,
    color:           text,
    sub_palette:     text,
    slope:           integer?,
    drop:            integer?,
    drainage:        boolean,
    walk_ground:     boolean,
    walk_vehicle:    boolean,
    buildable:       boolean,
    extrusion_kind:  text,
    height_override: float?,
}

pub fn load_palette(path: text) -> vector<GroundType> {
    file(path).content() as vector<GroundType>
}

// The one palette index dryopea's code names, because the RUNTIME
// produces it rather than a player painting it (plan 12 B1).
//
// A palette index is an identity — it is what `painted.loft` stores
// and what `MapFile` round-trips — so `rubble` was APPENDED at 11 and
// 0-10 are unsheared.  `passable.loft` reads this entry whenever a hex
// carries a pile from `height.loft`; nothing writes it into the
// painted layer, and `bindings.loft` gives it no hotkey.
//
// Named here rather than in `passable.loft` because it is a fact about
// the palette FILE, and `tests/12_b1_rubble.loft` checks the file
// still agrees with it.
pub const GROUND_RUBBLE: integer = 11;

// ─── Hex-color parsing ─────────────────────────────────────────

// Convert one ASCII hex digit (0-9, a-f, A-F) to its 0-15 value.
pub fn hex_digit_value(c: integer) -> integer {
    if c >= 48 && c <= 57  { c - 48 }       // '0'..'9'
    else if c >= 97 && c <= 102 { c - 87 }  // 'a'..'f'
    else if c >= 65 && c <= 70  { c - 55 }  // 'A'..'F'
    else { 0 }
}

// Parse "#rrggbb" → packed integer color (graphics::rgb form).
pub fn parse_hex_color(s: text) -> integer {
    phc_r = hex_digit_value(s.byte_at(1)) * 16 + hex_digit_value(s.byte_at(2));
    phc_g = hex_digit_value(s.byte_at(3)) * 16 + hex_digit_value(s.byte_at(4));
    phc_b = hex_digit_value(s.byte_at(5)) * 16 + hex_digit_value(s.byte_at(6));
    rgb(phc_r, phc_g, phc_b)
}

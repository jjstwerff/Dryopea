# Two moments of one small base, photographed.
# Plan 08 V1b — the scenario scripts are still V3; this one exists
# to prove a `.keys` file can ask for pictures and get them.

echo v1b: a wall ring around a grass interior, then the spawns

at 0 0 2

palette 9
drag -2 0 2 0
drag -2 2 2 2
palette 5
drag -1 1 1 1

hover 4 -2
snap v1b_ground

do toggle_mode
do rotate
click -3 1
do rotate
click 3 1
hover 4 -2
snap v1b_markers

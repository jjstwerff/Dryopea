# cold-start — an editor that has just opened on nothing.
#
# The load path and the sea-default render.  Sea is not stored: an
# unpainted hex IS sea, so "the world is empty" and "the screen is
# entirely sea" are two different claims and this asserts both.
# If the sea-default ever stopped being drawn, every other scenario
# would still pass — they all paint something first.

echo cold-start: an editor open on an empty world

at 0 0 1

count painted 0 0
count markers 0 0

kind 0 0 sea
kind 5 -3 sea
kind -4 2 sea

marker 0 0 none

frame sea 1.0 1.0

snap cold-start

// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Plan 25 phase M2 — the world in tiles, and the checksum that says two
// builds agree.
//
// ── ⚠⚠ The trap this file exists for ────────────────────────────
//
// A tile rebuilt on its own has to be the SAME GEOMETRY as that tile out
// of a rebuild of everything, or the dirty path M3 uploads through is an
// approximation of the full one and the seam shows only at a tile edge.
// ⚠ Neither a count nor a picture can gate that: a mesh with the right
// number of vertices in the wrong places is the failure itself, and
// `CLAUDE.md`'s oldest test rule is that a golden AGREES WITH A SHEAR.
// So the comparison is `mesh_crc`, and § The checksum can see what it is
// for is the first thing asserted, because a checksum nobody has
// falsified is a number that always agrees.
//
// ── ⚠⚠ ZERO IS THE READING TO DISTRUST ─────────────────────────
//
// `mesh_crc` of an EMPTY mesh is 0 — the fold starts at all-ones and ends
// by inverting, so no vertices means no work.  A mesher stubbed to emit
// nothing therefore makes **every equality assertion in this file pass**.
// ⚠ That is `tests/21_r1`'s finding arriving in a third place (a gate
// that reads perfect is as suspect as one that reads wrong), and the fix
// is the same two lines: every equality here carries a non-zero floor,
// and § An empty mesh checksums to zero states the reason out loud rather
// than leaving `!= 0` looking like superstition.
//
// ── ⚠⚠ Why the tile walk is by COORDINATE — measured, and it is
//        not the reason this file was first written to gate ────────
//
// The gate written here first was *one map painted in two orders gives
// one mesh*, on the theory that a hash walk would follow the paint order
// and so make a tile's checksum a fact about its edit history.  ⚠ **Its
// own control killed it**: loft's keyed collections iterate in KEY order,
// not insertion order.  Measured over six fixtures — reversed insertion,
// a scrambled spread, a key landing in the middle, negative coordinates,
// and a grow-then-erase — `hash<PaintedHex[q, r]>` came back sorted
// lexicographically every time, and stayed sorted when an unrelated key
// was added.  So insertion order is not a hazard in loft and the test
// could not fail.  `@M025`.
//
// ⚠ The coordinate walk is still load-bearing, for a different reason
// entirely, and § The walk visits hexes the painted set does not is the
// gate that can see it: **the drawn region is wider than the painted
// set** (`@X075` — sea is stored as absence), so a walk over the painted
// entries structurally cannot reach the coastline.  It is not a
// determinism argument; it is a coverage one.
//
// ⚠⚠ The reusable half is the control, not the finding: a gate aimed at
// the mechanism you EXPECT to be the hazard is not one aimed at the
// hazard.  Plan 12 B3's fence tripwire made the same mistake in the other
// direction — written to go red the day a steering rule landed, still
// green when it did.
//
// ── ⚠ The halo is MEASURED, never restated ──────────────────────
//
// § The reach sweeps paint edits outward from a tile and reports the
// furthest one that can still move its checksum, then compares THAT to
// `MESH_HALO_K`.  ⚠ Written this way it fails in both directions — a
// declared halo too narrow for the mesher and one too wide — and it is
// the tripwire `plans/25` § What was measured first, 1 promises: plan
// 02's slope solver makes a corner a mean of the hexes sharing it, the
// reach becomes two rings, and this goes red unless the halo grows with
// it.

#cwd

use dryopea;

const PALETTE_PATH: text = "examples/palette.json";

// Palette indices by position — `tests/25_m0`'s three, for its reason.
const KIND_SEA:   integer = 0;
const KIND_GRASS: integer = 5;
const KIND_WALL:  integer = 9;

// The tile the fixtures put their wall on, and the tile west of it.
const TILE_CX: integer = 1;
const TILE_CY: integer = 0;

// ─── The fixtures ───────────────────────────────────────────────

// A band of grass straddling the boundary between tile (0, 0) and tile
// (1, 0), with a wall standing on the FIRST column of tile (1, 0).
//
// ⚠ The wall's position is the whole fixture: it is the hex whose west
// neighbour lives in the other tile, so it is the only hex whose mesh a
// neighbouring tile's edit can move.  A wall in the middle of a tile
// would make every reach assertion below read "nothing changed" and pass.
fn m2_band() -> PaintedWorld {
    mb_pw = painted_empty();
    for mb_q in 30..35 {
        paint(mb_pw, mb_q, 1, KIND_GRASS as u8);
    }
    paint(mb_pw, 32, 1, KIND_WALL as u8);
    mb_pw
}

// `m2_band` plus a hex far to the east, so the world holds a THIRD tile
// that no edit near the band can reach.  ⚠ Without it, a two-tile world
// makes "the dirty rule names every tile that moved" true for the rule
// *name every tile there is* — a superset of anything.
fn m2_band_plus_island() -> PaintedWorld {
    mi_pw = m2_band();
    paint(mi_pw, 100, 1, KIND_GRASS as u8);
    mi_pw
}

// `m2_band` with one extra wall painted at (q, 1) — the sweep's edit.
fn m2_band_with_wall_at(mw_q: integer) -> PaintedWorld {
    mw_pw = m2_band();
    paint(mw_pw, mw_q, 1, KIND_WALL as u8);
    mw_pw
}

// ─── Helpers ────────────────────────────────────────────────────

// One tile's WHOLE geometry as one number: every kind present, in the
// ascending order `ground_chunk_kinds` gives, appended to one mesh.
//
// ⚠ One mesh rather than a checksum per kind because the kind ORDER is
// part of what M2 claims — a build that discovered its kinds off a hash
// would upload the same tile in a different sequence, and folding them
// together is what makes that visible.
fn m2_tile_crc(mt_pal: vector<GroundType>, mt_pw: PaintedWorld,
               mt_hl: const HeightLayer, mt_cx: integer, mt_cy: integer)
               -> integer {
    mt_m  = mesh("tile");
    mt_ks = ground_chunk_kinds(mt_pal, mt_pw, mt_hl, mt_cx, mt_cy);
    for mt_k in mt_ks {
        ground_chunk_mesh(mt_m, mt_pal, mt_pw, mt_hl, mt_cx, mt_cy, mt_k);
    }
    mesh_crc(mt_m)
}

// The checksum recorded for tile `ck`, or -1 if that tile was not in the
// build at all.  ⚠ -1 and not 0: 0 is what an EMPTY tile checksums to,
// so the two answers have to be distinguishable or a vanished tile reads
// as an empty one.
fn m2_crc_at(mc_cks: vector<integer>, mc_crcs: vector<integer>,
             mc_ck: integer) -> integer {
    for mc_i in 0..len(mc_cks) {
        if (mc_cks[mc_i] ?? 0) == mc_ck { return mc_crcs[mc_i] ?? 0; }
    }
    0 - 1
}

// ─── The checksum can see what it is for ────────────────────────

// ⚠⚠ The one assertion the rest of the file rests on, and the reason it
// is not moros's function.  `hex_mesh::mesh_crc` folds positions and
// normals only; `ground_top_face` SHARES its six rim vertices between the
// six fan triangles, so M0's reversed fan moves no vertex at all — same
// positions, same normals, same order, only the indices differ.  A
// vertex-only checksum is blind to exactly the defect M0 exists for, and
// that defect draws NOTHING under `GL_CULL_FACE` while every other valve
// reads healthy.
pub fn test_the_checksum_sees_a_reversed_winding() {
    tr_up = vec3(0.0, 0.0, 1.0);
    tr_uv = vec2(0.0, 0.0);

    tr_a = mesh("wound-one-way");
    tr_i0 = add_vertex(tr_a, vertex(vec3(0.0, 0.0, 0.0), tr_up, tr_uv));
    tr_i1 = add_vertex(tr_a, vertex(vec3(1.0, 0.0, 0.0), tr_up, tr_uv));
    tr_i2 = add_vertex(tr_a, vertex(vec3(0.0, 1.0, 0.0), tr_up, tr_uv));
    add_triangle(tr_a, tr_i0, tr_i1, tr_i2);

    tr_b = mesh("wound-the-other");
    tr_j0 = add_vertex(tr_b, vertex(vec3(0.0, 0.0, 0.0), tr_up, tr_uv));
    tr_j1 = add_vertex(tr_b, vertex(vec3(1.0, 0.0, 0.0), tr_up, tr_uv));
    tr_j2 = add_vertex(tr_b, vertex(vec3(0.0, 1.0, 0.0), tr_up, tr_uv));
    add_triangle(tr_b, tr_j0, tr_j2, tr_j1);

    // The control: the two meshes' VERTICES are identical, so anything
    // that separates them separated them on the indices alone.
    assert(len(tr_a.vertices) == 3 && len(tr_b.vertices) == 3,
           "three vertices each, got {len(tr_a.vertices)} and "
           + "{len(tr_b.vertices)}");
    assert(len(tr_a.triangles) == 1 && len(tr_b.triangles) == 1,
           "one triangle each, got {len(tr_a.triangles)} and "
           + "{len(tr_b.triangles)}");
    for tr_n in 0..3 {
        tr_va = tr_a.vertices[tr_n];
        tr_vb = tr_b.vertices[tr_n];
        assert(tr_va != null && tr_vb != null, "vertex {tr_n} is missing");
        assert(tr_va.pos.x == tr_vb.pos.x && tr_va.pos.y == tr_vb.pos.y
               && tr_va.pos.z == tr_vb.pos.z,
               "vertex {tr_n} differs between the two meshes, so this test "
               + "is not about the winding at all");
    }

    tr_ca = mesh_crc(tr_a);
    tr_cb = mesh_crc(tr_b);
    assert(tr_ca != tr_cb,
           "two meshes with IDENTICAL vertices and opposite winding "
           + "checksum the same ({tr_ca}) — the fold reads vertices only, "
           + "so M0's reversed fan is invisible to every comparison in "
           + "this file");
    assert(tr_ca != 0 && tr_cb != 0,
           "a non-empty mesh checksums to 0 ({tr_ca}, {tr_cb}) — see § Zero "
           + "is the reading to distrust");
}

// ⚠ Stated out loud so that `!= 0` elsewhere in this file reads as a
// requirement rather than as superstition: the fold starts at all-ones
// and ends by inverting, so an empty mesh is 0 and a mesher stubbed to
// emit nothing makes every equality in this file hold.
pub fn test_an_empty_mesh_checksums_to_zero() {
    te_m = mesh("nothing");
    assert(mesh_crc(te_m) == 0,
           "an empty mesh should checksum to 0, got {mesh_crc(te_m)} — if "
           + "that changed, the non-zero floors in this file are guarding "
           + "the wrong value");

    // And the fold really does separate different geometry, which is the
    // other half: without it, "equal" below could mean "always equal".
    te_pal = load_palette(PALETTE_PATH);
    te_hl  = height_layer_empty();

    te_one = painted_empty();
    paint(te_one, 0, 0, KIND_WALL as u8);
    te_two = painted_empty();
    paint(te_two, 0, 0, KIND_GRASS as u8);

    te_ma = mesh("a-wall");
    te_mb = mesh("some-grass");
    ground_top_face(te_ma, te_pal, te_one, te_hl, 0, 0);
    ground_top_face(te_mb, te_pal, te_two, te_hl, 0, 0);
    te_ca = mesh_crc(te_ma);
    te_cb = mesh_crc(te_mb);
    assert(te_ca != 0 && te_cb != 0, "a top face checksummed to 0");
    assert(te_ca != te_cb,
           "a 3 m wall's top face and a 0 m grass hex's checksum the same "
           + "({te_ca}) — the fold cannot see a height");
}

// ⚠⚠ The fold's SCALE is a tolerance, and this is the branch test that
// makes it a guard which can fire.  `CLAUDE.md` § Timers and epsilons:
// *an epsilon whose removal leaves the suite green is a guard that cannot
// fire* — and `mesh_crc_f` rounds rather than truncates for exactly that
// family of reason, so something has to reach the branch.  Nothing else in
// this file can: every comparison here runs identical arithmetic on
// identical inputs, so both sides land on the same side of any
// discontinuity whatever the code does.
//
// ⚠ 3.0 is the value to test at, not an arbitrary one — it is `wall`'s
// height, `3.0 · 1e6` is exact, and truncation puts its discontinuity
// exactly there.  With truncation the first pair below DISAGREES.
pub fn test_the_scale_is_the_tolerance() {
    tl_up = vec3(0.0, 0.0, 1.0);
    tl_uv = vec2(0.0, 0.0);

    tl_a = mesh("at-three");
    add_vertex(tl_a, vertex(vec3(0.0, 0.0, 3.0), tl_up, tl_uv));
    tl_b = mesh("a-hair-under-three");
    add_vertex(tl_b, vertex(vec3(0.0, 0.0, 3.0 - 1e-9), tl_up, tl_uv));
    tl_c = mesh("visibly-over-three");
    add_vertex(tl_c, vertex(vec3(0.0, 0.0, 3.0 + 1e-5), tl_up, tl_uv));

    tl_ca = mesh_crc(tl_a);
    tl_cb = mesh_crc(tl_b);
    tl_cc = mesh_crc(tl_c);
    assert(tl_ca != 0, "a one-vertex mesh checksummed to 0");
    assert(tl_ca == tl_cb,
           "3.0 and 3.0 − 1e-9 checksum differently ({tl_ca} vs {tl_cb}) — "
           + "a thousandth of the scale is not a difference in geometry, so "
           + "the fold is truncating and every exact palette height sits on "
           + "the discontinuity");
    assert(tl_ca != tl_cc,
           "3.0 and 3.0 + 1e-5 checksum the SAME ({tl_ca}) — ten times the "
           + "scale is a real difference and the fold cannot see it, so the "
           + "tolerance is wider than `MESH_CRC_SCALE` claims");
}

// ─── The walk visits hexes the painted set does not ─────────────

// ⚠⚠ Why the tile walk is over the tile's own EXTENT and not over the
// painted entries.  The band is painted entirely on row 1, and tile
// (1, 0) draws NINE sea hexes — four on row 0, four on row 2 and one east
// of the band's end — every one of them unpainted.  A mesher that
// iterated `pw.painted` would emit none of them, and the coastline would
// be missing everywhere.
//
// ⚠ The counts are exact rather than `> 0`: sea is 0 m and its only
// raised neighbour is the wall, which owns that face itself (`@X046`), so
// nine top faces is 63 vertices and 54 triangles and nothing else.
pub fn test_the_walk_visits_hexes_the_painted_set_does_not() {
    tv_pal = load_palette(PALETTE_PATH);
    tv_hl  = height_layer_empty();
    tv_pw  = m2_band();

    // The control: every painted hex is on row 1, so a walk over the
    // painted entries could not reach rows 0 and 2 at all.
    tv_rows = 0;
    for tv_e in tv_pw.painted {
        assert(tv_e.r == 1,
               "the fixture painted ({tv_e.q}, {tv_e.r}) off row 1, so a "
               + "painted-set walk could have reached the coastline and "
               + "this test no longer separates the two");
        tv_rows += 1;
    }
    assert(tv_rows == 5, "the band is five hexes, and the walk saw {tv_rows}");

    tv_m = mesh("the-coast");
    ground_chunk_mesh(tv_m, tv_pal, tv_pw, tv_hl, TILE_CX, TILE_CY, KIND_SEA);
    assert(len(tv_m.vertices) == 63,
           "tile ({TILE_CX}, {TILE_CY}) draws nine unpainted sea hexes at "
           + "seven vertices each; got {len(tv_m.vertices)} — 0 means the "
           + "walk is over the painted set and the whole coastline is "
           + "missing");
    assert(len(tv_m.triangles) == 54,
           "nine hexes at six triangles each; got {len(tv_m.triangles)}");

    // And they really are unpainted, on both rows the band never touched.
    assert(lookup_painted(tv_pw, 33, 0) == KIND_SEA as u8
           && lookup_painted(tv_pw, 33, 2) == KIND_SEA as u8,
           "the rows either side of the band are painted, so the sea count "
           + "above is not about unpainted hexes");
    assert(mesh_hex_drawn(tv_pal, tv_pw, tv_hl, 33, 0)
           && mesh_hex_drawn(tv_pal, tv_pw, tv_hl, 33, 2),
           "an unpainted hex beside the band is not drawn, so `@X075`'s "
           + "ring is gone and the ground ends at the paint");

    // The two tiles hold different geometry, so a checksum that agreed
    // between them would not be reading the tile.
    tv_a = m2_tile_crc(tv_pal, tv_pw, tv_hl, TILE_CX, TILE_CY);
    tv_b = m2_tile_crc(tv_pal, tv_pw, tv_hl, 0, 0);
    assert(tv_a != 0 && tv_b != 0, "a tile checksummed to 0");
    assert(tv_a != tv_b,
           "the two tiles checksum the same ({tv_a}) — they hold different "
           + "geometry, so the fold is not reading the tile at all");
}

// ─── One tile alone, and out of a rebuild of everything ─────────

// The plan's stated invariant.  ⚠ Its content is that a tile's mesh is a
// function of the WORLD and of the tile, and of nothing accumulated on
// the way there — so the whole-world pass below walks the tile list in
// the hash's own order and the single-tile build does not.
pub fn test_one_tile_alone_equals_that_tile_out_of_a_rebuild_of_everything() {
    ta_pal = load_palette(PALETTE_PATH);
    ta_hl  = height_layer_empty();
    ta_pw  = m2_band();

    ta_ks   = mesh_chunks_all(ta_pw, ta_hl);
    ta_cks:  vector<integer> = [];
    ta_crcs: vector<integer> = [];
    for ta_k in ta_ks {
        ta_cks  += [ta_k.ck];
        ta_crcs += [m2_tile_crc(ta_pal, ta_pw, ta_hl, ta_k.cx, ta_k.cy)];
    }
    assert(len(ta_cks) == 2,
           "the band straddles exactly two tiles, and the rebuild-all pass "
           + "found {len(ta_cks)} — the comparison below is about a world "
           + "of a different shape than the fixture claims");

    ta_want = mesh_chunk_of(32, 1);
    ta_from_all = m2_crc_at(ta_cks, ta_crcs, ta_want.ck);
    ta_alone    = m2_tile_crc(ta_pal, ta_pw, ta_hl, ta_want.cx, ta_want.cy);

    assert(ta_from_all >= 0,
           "the rebuild-all pass never visited the tile holding the wall — "
           + "`mesh_chunks_all` is missing a tile the map has geometry in");
    assert(ta_alone != 0,
           "the tile built alone checksummed to 0, so the equality below "
           + "holds for a mesher that emits nothing");
    assert(ta_alone == ta_from_all,
           "tile ({ta_want.cx}, {ta_want.cy}) rebuilt alone is {ta_alone} "
           + "and out of a rebuild of everything is {ta_from_all} — a local "
           + "rebuild is an APPROXIMATION of the global one, and the seam "
           + "shows only at a tile edge");
}

// ⚠ Why M3 needs a mesh per (tile x kind) rather than one mesh it appends
// every tile to, measured rather than asserted as a rule.  Vertex indices
// are mesh-local, so a tile appended after another is wired differently —
// the same geometry with a different checksum, which is the whole reason
// the invariant above is stated per tile.
pub fn test_a_shared_mesh_makes_a_tile_uncomparable() {
    ts_pal = load_palette(PALETTE_PATH);
    ts_hl  = height_layer_empty();
    ts_pw  = m2_band();

    ts_east = mesh_chunk_of(32, 1);
    ts_west = mesh_chunk_of(31, 1);
    assert(ts_east.ck != ts_west.ck,
           "the fixture's two hexes are in one tile, so this test has "
           + "nothing to share a mesh between");

    // Alone.
    ts_own = mesh("east-alone");
    ground_chunk_mesh(ts_own, ts_pal, ts_pw, ts_hl, ts_east.cx, ts_east.cy,
                      KIND_WALL);
    ts_a = mesh_crc(ts_own);

    // Appended after its neighbour.
    ts_shared = mesh("both");
    ground_chunk_mesh(ts_shared, ts_pal, ts_pw, ts_hl, ts_west.cx, ts_west.cy,
                      KIND_GRASS);
    ts_before = len(ts_shared.vertices);
    ground_chunk_mesh(ts_shared, ts_pal, ts_pw, ts_hl, ts_east.cx, ts_east.cy,
                      KIND_WALL);

    assert(ts_a != 0, "the lone tile mesh is empty");
    assert(ts_before > 0,
           "the western tile contributed nothing, so nothing was shared and "
           + "this test proves nothing");
    assert(mesh_crc(ts_shared) != ts_a,
           "appending a tile after another gives the same checksum as "
           + "building it alone — vertex indices are apparently not part of "
           + "the fold, and § The checksum sees a reversed winding should "
           + "have failed first");
}

// ─── The reach ──────────────────────────────────────────────────

// ⚠ An edit ONE hex outside the tile moves its mesh, because the wall on
// the tile's first column reads that hex's height for its west face.
// This is the half that catches a halo too narrow.
pub fn test_an_edit_one_hex_outside_moves_the_tile() {
    to_pal = load_palette(PALETTE_PATH);
    to_hl  = height_layer_empty();

    to_base = m2_tile_crc(to_pal, m2_band(), to_hl, TILE_CX, TILE_CY);
    to_next = m2_tile_crc(to_pal, m2_band_with_wall_at(31), to_hl,
                          TILE_CX, TILE_CY);
    assert(to_base != 0, "the base tile checksummed to 0");
    assert(to_base != to_next,
           "a wall painted at (31, 1) — one hex west of the tile boundary — "
           + "left tile ({TILE_CX}, {TILE_CY}) unchanged at {to_base}.  The "
           + "wall at (32, 1) should have lost its west face, so the mesher "
           + "is not reading across the tile edge at all");
}

// ⚠ And two hexes out does NOT, which is the half that catches a halo too
// wide — and the tripwire for plan 02's blend, which would make it move.
pub fn test_an_edit_two_hexes_outside_does_not() {
    tt_pal = load_palette(PALETTE_PATH);
    tt_hl  = height_layer_empty();

    tt_base = m2_tile_crc(tt_pal, m2_band(), tt_hl, TILE_CX, TILE_CY);
    tt_far  = m2_tile_crc(tt_pal, m2_band_with_wall_at(30), tt_hl,
                          TILE_CX, TILE_CY);
    assert(tt_base != 0, "the base tile checksummed to 0");
    assert(tt_base == tt_far,
           "a wall painted at (30, 1) — TWO hexes outside the tile — moved "
           + "tile ({TILE_CX}, {TILE_CY}) from {tt_base} to {tt_far}.  The "
           + "mesher reads further than `MESH_HALO_K` says, so every dirty "
           + "rebuild leaves a stale tile beside the edited one");
}

// ⚠⚠ The halo asserted against the MESHER rather than against itself:
// sweep the edit outward and report the furthest distance that can still
// move the tile.  Fails if the declared halo is too narrow OR too wide,
// and goes red the day a corner-height mean makes the reach two rings.
pub fn test_the_measured_reach_is_the_declared_halo() {
    tm_pal = load_palette(PALETTE_PATH);
    tm_hl  = height_layer_empty();
    tm_base = m2_tile_crc(tm_pal, m2_band(), tm_hl, TILE_CX, TILE_CY);
    assert(tm_base != 0, "the base tile checksummed to 0");

    tm_reach = 0;
    tm_seen  = 0;
    for tm_d in 1..4 {
        tm_crc = m2_tile_crc(tm_pal, m2_band_with_wall_at(32 - tm_d), tm_hl,
                             TILE_CX, TILE_CY);
        if tm_crc != tm_base { tm_reach = tm_d; }
        tm_seen += 1;
    }
    assert(tm_seen == 3, "the sweep ran {tm_seen} distances, not 3");
    assert(tm_reach == MESH_HALO_K,
           "the mesher's measured reach is {tm_reach} hexes and "
           + "`MESH_HALO_K` declares {MESH_HALO_K}.  A larger reach means "
           + "every dirty rebuild leaves a stale tile; a smaller one means "
           + "the halo is doing work nothing needs");
}

// ─── Every tile that moved is named dirty ───────────────────────

// ⚠ The `11_f8` shape: the invalidation rule has to NAME every tile whose
// geometry an edit moved, and this is the only test here that can see it
// miss one.  ⚠ Its edit is in the tile's INTERIOR on purpose — an edit
// near the boundary touches both tiles of this two-tile world, and a
// dirty set that happens to be everything is a superset of anything.
pub fn test_every_tile_that_moved_is_named_dirty() {
    td_pal = load_palette(PALETTE_PATH);
    td_hl  = height_layer_empty();
    td_pw  = m2_band();

    td_ks   = mesh_chunks_all(td_pw, td_hl);
    td_cks:  vector<integer> = [];
    td_crcs: vector<integer> = [];
    for td_k in td_ks {
        td_cks  += [td_k.ck];
        td_crcs += [m2_tile_crc(td_pal, td_pw, td_hl, td_k.cx, td_k.cy)];
    }

    // (33, 1) is two hexes inside tile (1, 0)'s western edge, so nothing
    // in tile (0, 0) can read it.
    td_edit = m2_band_with_wall_at(33);
    td_touch = mesh_chunks_touched(33, 1);
    assert(len(td_touch) == 1,
           "the interior edit should touch exactly its own tile, and it "
           + "names {len(td_touch)} — a dirty set that is the whole world "
           + "cannot be shown to be right");

    td_ks2  = mesh_chunks_all(td_edit, td_hl);
    td_moved = 0;
    td_named = 0;
    for td_k2 in td_ks2 {
        td_now = m2_tile_crc(td_pal, td_edit, td_hl, td_k2.cx, td_k2.cy);
        td_was = m2_crc_at(td_cks, td_crcs, td_k2.ck);
        if td_now == td_was { continue; }
        td_moved += 1;
        td_hit = false;
        for td_t in td_touch {
            if td_t.ck == td_k2.ck { td_hit = true; }
        }
        assert(td_hit,
               "tile ({td_k2.cx}, {td_k2.cy}) went from {td_was} to "
               + "{td_now} and `mesh_chunks_touched(33, 1)` does not name "
               + "it — a dirty rebuild would leave that tile stale");
        td_named += 1;
    }
    assert(td_moved == 1,
           "exactly one tile should have moved and {td_moved} did — 0 means "
           + "the edit changed no geometry, so nothing above was tested");
    assert(td_named == td_moved, "the loop counted {td_named} of {td_moved}");
}

// ⚠⚠ The other half, and neither is enough alone.  The test above proves
// the dirty rule is not simply *everything*; this one proves it REACHES
// ACROSS a tile edge — an edit in tile (0, 0) moves tile (1, 0)'s mesh,
// because the wall on that tile's first column reads it.  ⚠ Drop the
// neighbour walk from `mesh_chunks_touched` and the test above stays
// green while every base built near a tile boundary keeps a stale face on
// it.
//
// ⚠ The island in the fixture is what keeps this non-trivial: with only
// two tiles, "names every tile that moved" and "names every tile" are the
// same sentence.
pub fn test_a_boundary_edit_names_the_tile_across_the_edge() {
    tb_pal = load_palette(PALETTE_PATH);
    tb_hl  = height_layer_empty();
    tb_pw  = m2_band_plus_island();

    tb_all = mesh_chunks_all(tb_pw, tb_hl);
    assert(len(tb_all) == 3,
           "the fixture should hold three tiles and holds {len(tb_all)} — "
           + "the subset check below means nothing otherwise");

    tb_touch = mesh_chunks_touched(31, 1);
    assert(len(tb_touch) < len(tb_all),
           "an edit at (31, 1) names {len(tb_touch)} of {len(tb_all)} "
           + "tiles — a dirty set that is the whole world cannot be shown "
           + "to be right");

    tb_east = mesh_chunk_of(32, 1);
    tb_hit  = false;
    for tb_t in tb_touch {
        if tb_t.ck == tb_east.ck { tb_hit = true; }
    }
    assert(tb_hit,
           "an edit at (31, 1) does not name tile ({tb_east.cx}, "
           + "{tb_east.cy}), which holds the wall that reads it — the dirty "
           + "rule stops at the tile edge, so a rebuild leaves the face "
           + "beside every boundary stale");

    // And the tile really does move, or the requirement above is a rule
    // about nothing.
    tb_was = m2_tile_crc(tb_pal, tb_pw, tb_hl, tb_east.cx, tb_east.cy);
    tb_now = m2_tile_crc(tb_pal, m2_band_with_wall_at(31), tb_hl,
                         tb_east.cx, tb_east.cy);
    assert(tb_was != 0, "the tile across the edge checksummed to 0");
    assert(tb_was != tb_now,
           "the edit moved nothing in tile ({tb_east.cx}, {tb_east.cy}), so "
           + "naming it is not required and this test asserts nothing");
}

// ─── The drawn region ───────────────────────────────────────────

// ⚠ The kind list is an UPLOAD order (M3 makes one `GroupVboSet` per
// palette kind), so it has to be a function of the map alone.  Ascending
// is the cheapest such order and `ground_chunk_kinds` promises it —
// promised in a comment is not promised.
pub fn test_the_kind_list_is_ascending() {
    tk_pal = load_palette(PALETTE_PATH);
    tk_hl  = height_layer_empty();
    tk_pw  = m2_band();

    tk_ks   = ground_chunk_kinds(tk_pal, tk_pw, tk_hl, TILE_CX, TILE_CY);
    tk_last = 0 - 1;
    tk_n    = 0;
    for tk_k in tk_ks {
        assert(tk_k > tk_last,
               "the kind list gives {tk_k} after {tk_last} — it is not "
               + "ascending, so two builds of one map can upload its tiles "
               + "in different orders");
        tk_last = tk_k;
        tk_n += 1;
    }
    // Sea (the coastline), grass (the band) and wall — exactly three, so
    // the loop above ran on something and a kind that vanished is named.
    assert(tk_n == 3,
           "tile ({TILE_CX}, {TILE_CY}) holds sea, grass and wall — three "
           + "kinds, not {tk_n}");
}

// ⚠ Sea is stored as ABSENCE, so the region is the painted set plus one
// hex (`@X075`).  A lone wall's six neighbours are drawn as sea, which is
// the coastline — and the count is exact, so a ring that grew or vanished
// names itself.
pub fn test_the_ring_around_what_stands_is_drawn() {
    tg_pal = load_palette(PALETTE_PATH);
    tg_hl  = height_layer_empty();
    tg_pw  = painted_empty();
    paint(tg_pw, 5, 5, KIND_WALL as u8);

    tg_k = mesh_chunk_of(5, 5);
    tg_m = mesh("the-coast");
    ground_chunk_mesh(tg_m, tg_pal, tg_pw, tg_hl, tg_k.cx, tg_k.cy, KIND_SEA);
    // Six ring hexes, each a six-triangle fan of seven vertices, and no
    // side faces — sea is 0 m and its only raised neighbour is the wall,
    // which owns that face itself (`@X046`).
    assert(len(tg_m.vertices) == 42,
           "a lone wall's coastline is six sea hexes at seven vertices "
           + "each; got {len(tg_m.vertices)}");
    assert(len(tg_m.triangles) == 36,
           "six hexes at six triangles each; got {len(tg_m.triangles)} — "
           + "more means the sea grew a side face it does not own");

    // The control: the wall itself is NOT in the sea mesh, and it is
    // drawn in its own.
    tg_w = mesh("the-wall");
    ground_chunk_mesh(tg_w, tg_pal, tg_pw, tg_hl, tg_k.cx, tg_k.cy, KIND_WALL);
    assert(len(tg_w.vertices) == 31,
           "the wall is one top face of seven plus six quads of four; got "
           + "{len(tg_w.vertices)}");
}

// ⚠ The interim's good half: a single erased hex surrounded by land is
// still DRAWN, so an eraser stroke does not punch a hole in the ground.
pub fn test_a_one_hex_gap_in_the_land_is_drawn() {
    tp_pal = load_palette(PALETTE_PATH);
    tp_hl  = height_layer_empty();
    tp_pw  = painted_empty();
    tp_h   = Hex { q: 5, r: 5 };
    for tp_d in 0..6 {
        tp_n = lat_neighbour(tp_h, tp_d);
        paint(tp_pw, tp_n.q, tp_n.r, KIND_GRASS as u8);
    }
    assert(lookup_painted(tp_pw, 5, 5) == KIND_SEA as u8,
           "the middle hex is painted, so there is no gap to test");
    assert(mesh_hex_drawn(tp_pal, tp_pw, tp_hl, 5, 5),
           "a hex with land all round it is not drawn — an eraser stroke "
           + "punches a hexagonal hole through the ground at exactly the "
           + "height of the land beside it");
}

// ⚠⚠ The interim's LIMIT, asserted so that closing it is a deliberate
// act.  A gap wider than two hexes still holes: the middle of it touches
// nothing painted, so nothing draws it.  ⚠ `plans/25` § Open 3 carries
// the three candidates and says the real answer — give water the DROP the
// palette already stores — is a decision about the SIMULATION and belongs
// with plan 02.  When this test goes red, that decision has been taken.
pub fn test_a_gap_wider_than_the_ring_still_holes() {
    th_pal = load_palette(PALETTE_PATH);
    th_hl  = height_layer_empty();

    // Grass everywhere in a block, then the middle hex AND its whole ring
    // erased — so the middle is two hexes from the nearest land.
    th_pw = painted_empty();
    for th_q in 2..9 {
        for th_r in 2..9 {
            paint(th_pw, th_q, th_r, KIND_GRASS as u8);
        }
    }
    th_h = Hex { q: 5, r: 5 };
    paint(th_pw, 5, 5, KIND_SEA as u8);
    for th_d in 0..6 {
        th_n = lat_neighbour(th_h, th_d);
        paint(th_pw, th_n.q, th_n.r, KIND_SEA as u8);
    }

    assert(!mesh_hex_drawn(th_pal, th_pw, th_hl, 5, 5),
           "the middle of a three-wide erased gap is drawn — the ring is "
           + "wider than one hex, so `@X075` has changed and this test is "
           + "the record of it");
    // The control: the land around the gap IS drawn, so the reading above
    // is about the gap and not about an empty fixture.
    assert(mesh_hex_drawn(th_pal, th_pw, th_hl, 2, 2),
           "the fixture's land is not drawn either, so nothing here is "
           + "about the gap");
    assert(mesh_hex_drawn(th_pal, th_pw, th_hl, 5, 3),
           "the gap's own rim should be drawn — it touches land");
}

// ─── The fixture is not degenerate ──────────────────────────────

// ⚠ R1's generic control.  Every count above is a number that a broken
// fixture could produce for reasons that have nothing to do with the
// mesher, so the fixture states what it is.
pub fn test_the_fixture_is_not_degenerate() {
    tf_pal = load_palette(PALETTE_PATH);
    tf_hl  = height_layer_empty();
    tf_pw  = m2_band();

    assert(len(tf_pal) == 12, "the palette should hold 12 kinds, got {len(tf_pal)}");

    // `MESH_KIND_SEA` is an index, and the whole drawn-region rule rests
    // on it naming water.
    tf_sea = tf_pal[MESH_KIND_SEA];
    assert(tf_sea != null, "the palette has no kind {MESH_KIND_SEA}");
    assert(tf_sea.name == "sea",
           "palette index {MESH_KIND_SEA} is '{tf_sea.name}', not sea — "
           + "`mesh_hex_drawn` is comparing surfaces against the wrong kind");

    // The wall stands on the FIRST column of its tile, which is what
    // makes every reach assertion able to fail.
    tf_k = mesh_chunk_of(32, 1);
    tf_o = mesh_chunk_origin(tf_k.cx, tf_k.cy);
    assert(tf_o.q == 32,
           "the tile holding (32, 1) starts at q {tf_o.q}, so the wall is "
           + "not on its edge and no outside edit can reach it");
    assert(tf_k.cx == TILE_CX && tf_k.cy == TILE_CY,
           "the wall is in tile ({tf_k.cx}, {tf_k.cy}) and the tests read "
           + "({TILE_CX}, {TILE_CY})");
    assert(mesh_chunk_of(31, 1).ck != tf_k.ck,
           "(31, 1) and (32, 1) are in one tile, so the reach sweep never "
           + "crosses a boundary");

    // The heights DIFFER, or every side-face count is 0 for a reason that
    // is not the mesher's.
    tf_wall = hex_height(tf_pal, tf_pw, tf_hl, 32, 1);
    tf_gras = hex_height(tf_pal, tf_pw, tf_hl, 31, 1);
    assert(abs(tf_wall - 3.0) < 1e-12, "the wall should be 3.0 m, got {tf_wall}");
    assert(abs(tf_gras - 0.0) < 1e-12, "the band should be flat, got {tf_gras}");

    // And the span is what the constant says, so 32 is not a number this
    // file invented.
    assert(mesh_chunk_span() == 32,
           "a tile is {mesh_chunk_span()} hexes across, and the fixture's "
           + "coordinates assume 32");
    assert(MESH_HALO_K == 1,
           "MESH_HALO_K is {MESH_HALO_K}; the sweep in § The reach covers "
           + "1..3 and cannot measure a larger one");
}

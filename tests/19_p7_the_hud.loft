//
// Plan 19 phase P7 — the HUD, which is one number.
//
// ── The one claim ────────────────────────────────────────────────────
//
// > **The corner shows the wallet, and the digits it draws are the
// > digits of the wallet.**
//
// `docs/DESIGN.md` § HUD is emphatic and most of this phase is what it
// REFUSES: *"Wallet (points) — one corner number.  The only number the
// player must see to make build decisions. […] That's the entire HUD.
// No wave-number, no inter-wave countdown, no minimap, no boost
// cooldown bar."*  So there is one number here and no second one, and
// adding one is a design change rather than a feature.
//
// ── ⚠⚠ A WRONG DIGIT IS THE FAILURE NO PIXEL COUNT CAN SEE ──────────
//
// `digit_segments` is a TABLE.  A `5` drawn with a `6`'s segments is a
// perfectly good-looking digit that reads the wrong number — the
// picture is crisp, the pixel count is plausible, and the player is
// told they have 600 points when they have 500.  ⚠ So the gate is an
// INDEPENDENT ORACLE rather than a re-statement: the number of lit
// segments per digit is the classic **6 2 5 5 4 5 6 3 7 6**, which is
// derived from nothing in this repo, and every digit's drawn pixels are
// asserted DISTINCT from every other digit's.
//
// ⚠⚠ **AND THE INK MUST NOT BE A COLOUR THE FRAME ALREADY USES**, for
// `@X092`'s reason one layer up: the GL gate reads a frame by exact
// colour, so a HUD painted in `sand` would be counted as ground and one
// painted in `scout` as a robot.
//
// ⚠⚠ **AND THE INK IS NOT ONE COLOUR — IT IS 201**, since the wallet
// ramp (`hud.loft` § the ramp).  So the check is a SWEEP of every whole
// point the wallet can show rather than one assertion about one
// constant, and it fired on its first run: amber to red passes through
// `#ff8000`, the SCOUT's colour, at exactly **134 points** (`@M043`).
// ⚠ It is exhaustive rather than sampled only because the ramp is a
// function of the INTEGER the digits show; over `wallet_left` it would
// reach uncountably many colours and could only be spot-checked.

#cwd

use dryopea;

const PALETTE: text = "examples/palette.json";

fn as_u8(n: integer) -> u8 {
    n as u8? ?? 0
}

// How many pixels of `colour` a canvas holds.
fn ink_of(cv: const Canvas, colour: integer) -> integer {
    io_n = 0;
    for io_y in 0..cv.height {
        for io_x in 0..cv.width {
            if (cv.get_pixel(io_x, io_y) & 0xffffff) == (colour & 0xffffff) { io_n += 1; }
        }
    }
    io_n
}

// Squared RGB distance between two 24-bit colours.
fn colour_distance2(a: integer, b: integer) -> integer {
    cd_r = ((a >> 16) & 255) - ((b >> 16) & 255);
    cd_g = ((a >> 8)  & 255) - ((b >> 8)  & 255);
    cd_b = (a         & 255) - (b         & 255);
    cd_r * cd_r + cd_g * cd_g + cd_b * cd_b
}

// A digit's drawn shape, folded to one integer — position-sensitive, so
// two digits that light the same NUMBER of pixels in different places
// do not collide.
fn digit_shape(d: integer) -> integer {
    ds_cv = canvas(HUD_DIGIT_W, HUD_DIGIT_H, 0);
    render_digit(ds_cv, d, 0, 0, rgb(0xff, 0xff, 0xff));
    // ⚠ MODULAR, and the first version was not: `h * 31 + i` folded over
    // a hundred-odd lit pixels overflows, and an overflowed fold landed
    // on exactly 0 for digit 0 — which the test read as *drew no pixels
    // at all*.  A checksum that can reach the value meaning "empty" is
    // the wrong checksum, which is `mesh_crc.loft`'s own lesson
    // (`@X065`) arriving in a test helper.
    ds_h = 17;
    for ds_y in 0..HUD_DIGIT_H {
        for ds_x in 0..HUD_DIGIT_W {
            if (ds_cv.get_pixel(ds_x, ds_y) & 0xffffff) != 0 {
                ds_h = ((ds_h * 131 + ds_y * HUD_DIGIT_W + ds_x + 1) % 1000000007) ?? 0;
            }
        }
    }
    ds_h
}

// ─────────────────────────────────────────────────────────────────────
// The table, against an oracle it cannot have influenced
// ─────────────────────────────────────────────────────────────────────

// @DRY-068 — every digit lights the number of segments it should
//
// ⚠⚠ **THE INDEPENDENT ORACLE.**  A seven-segment `0` lights six
// strokes, a `1` two, a `7` three and an `8` all seven — 6 2 5 5 4 5 6
// 3 7 6, which is a property of the shapes and not of this code.  A
// table with two rows swapped keeps the same MULTISET and would slip
// past a total, so the count is asserted PER DIGIT.
fn test_every_digit_lights_the_segments_it_should() {
    te_want = [6, 2, 5, 5, 4, 5, 6, 3, 7, 6];
    for te_d in 0..10 {
        te_bits = 0;
        te_m = digit_segments(te_d);
        for te_b in 0..7 {
            if te_m & (1 << te_b) != 0 { te_bits += 1; }
        }
        assert(te_bits == (te_want[te_d] ?? 0),
               "digit {te_d} lights {te_bits} segments, and a seven-segment "
               + "{te_d} lights {te_want[te_d] ?? 0}");
    }
    // ⚠ …and nothing outside the seven bits, or a stray one draws a
    // segment `render_digit` never looks at and the table lies quietly.
    for te_e in 0..10 {
        assert(digit_segments(te_e) & 0x80 == 0,
               "digit {te_e} sets a bit above the seven segments");
    }
    // A digit the table does not know draws NOTHING rather than a
    // plausible wrong glyph.
    assert(digit_segments(10) == 0 && digit_segments(0 - 1) == 0,
           "an out-of-range digit is blank, not a guess");
}

// @DRY-069 — and no two digits draw the same picture
//
// ⚠ The segment COUNT above cannot tell a `2` from a `3` or a `5` from
// a `6` — each pair lights the same number.  This is what can: the
// drawn pixels, folded position-sensitively.
fn test_no_two_digits_draw_the_same_picture() {
    tn_seen: vector<integer> = [];
    for tn_d in 0..10 { tn_seen += [digit_shape(tn_d)]; }
    for tn_i in 0..10 {
        assert((tn_seen[tn_i] ?? 0) != 0,
               "digit {tn_i} drew no pixels at all");
        for tn_j in 0..10 {
            if tn_i < tn_j {
                assert((tn_seen[tn_i] ?? 0) != (tn_seen[tn_j] ?? 1),
                       "digits {tn_i} and {tn_j} draw the same picture — one of "
                       + "them reads as the other and no pixel count can see it");
            }
        }
    }
    // ⚠ The fold has to be able to SEE a move, or every digit agreeing
    // would be a statement about the instrument.  An `8` shifted by one
    // pixel is a different shape.
    ts_a = canvas(HUD_DIGIT_W, HUD_DIGIT_H, 0);
    render_digit(ts_a, 8, 0, 0, rgb(0xff, 0xff, 0xff));
    ts_b = canvas(HUD_DIGIT_W, HUD_DIGIT_H, 0);
    render_digit(ts_b, 8, 1, 0, rgb(0xff, 0xff, 0xff));
    assert(ink_of(ts_a, 0xffffff) != ink_of(ts_b, 0xffffff)
           || ts_a.get_pixel(0, HUD_DIGIT_THICK) != ts_b.get_pixel(0, HUD_DIGIT_THICK),
           "a digit moved one pixel draws the same thing — the instrument "
           + "cannot see where a digit is");
}

// @DRY-070 — a digit fills its declared box exactly
//
// ⚠ `HUD_DIGIT_H` must be `3 * THICK + 2 * half`, or an `8` stops a
// pixel short of its box and every count above still passes.
fn test_a_digit_fills_its_box() {
    tb_cv = canvas(HUD_DIGIT_W, HUD_DIGIT_H, 0);
    render_digit(tb_cv, 8, 0, 0, rgb(0xff, 0xff, 0xff));
    // an `8` lights every segment, so it must touch all four edges
    assert((tb_cv.get_pixel(HUD_DIGIT_W / 2 ?? 0, 0) & 0xffffff) != 0,
           "an 8 does not reach the top of its box");
    assert((tb_cv.get_pixel(HUD_DIGIT_W / 2 ?? 0, HUD_DIGIT_H - 1) & 0xffffff) != 0,
           "an 8 does not reach the BOTTOM of its box — HUD_DIGIT_H is not "
           + "3 x THICK plus two whole halves");
    assert((tb_cv.get_pixel(0, HUD_DIGIT_THICK) & 0xffffff) != 0,
           "an 8 does not reach the left of its box");
    assert((tb_cv.get_pixel(HUD_DIGIT_W - 1, HUD_DIGIT_THICK) & 0xffffff) != 0,
           "an 8 does not reach the right of its box");
}

// ─────────────────────────────────────────────────────────────────────
// The number
// ─────────────────────────────────────────────────────────────────────

// @DRY-071 — the number is the wallet's, right-aligned, and 0 is a digit
fn test_the_number_is_the_wallets() {
    tw_w = wallet_new();
    assert(hud_wallet_points(tw_w) == 200,
           "a fresh run shows its whole wallet: {hud_wallet_points(tw_w)}");

    // ⚠ FLOOR, not round: a tower costs 100 whole points, so 99.6 must
    // not read as 100.
    wallet_drain(tw_w, 100.4);
    assert(hud_wallet_points(tw_w) == 99,
           "99.6 points reads as {hud_wallet_points(tw_w)} — rounding up would "
           + "show a tower the player cannot buy");

    // ⚠ And a broke run reads 0 rather than a negative number.
    tb_w = wallet_new();
    wallet_drain(tb_w, 240.0);
    assert(wallet_broke(tb_w), "the control: this run really is broke");
    assert(hud_wallet_points(tb_w) == 0,
           "a broke run reads {hud_wallet_points(tb_w)}, not a minus sign");
}

// @DRY-072 — the digits drawn ARE the digits of the number
//
// ⚠⚠ **THE CLAIM THE WHOLE PHASE IS FOR**, and it is asserted by
// COMPARING PICTURES rather than by counting ink: the corner showing
// `200` must draw a `2`, a `0` and a `0` in that order, at the places
// right-alignment puts them.
fn test_the_digits_drawn_are_the_digits_of_the_number() {
    tdd_cv = canvas(PLAY_HUD_W, PLAY_HUD_H, 0);
    tdd_n  = render_number(tdd_cv, 200, PLAY_HUD_W, 0, rgb(0xff, 0xff, 0xff));
    assert(tdd_n == 3, "200 is three digits, drawn {tdd_n}");

    // Each digit's own box, compared with that digit rendered alone.
    tdd_want = [2, 0, 0];
    for tdd_i in 0..3 {
        tdd_x = PLAY_HUD_W - (3 - tdd_i) * HUD_DIGIT_W
                - (2 - tdd_i) * HUD_DIGIT_GAP;
        tdd_one = canvas(HUD_DIGIT_W, HUD_DIGIT_H, 0);
        render_digit(tdd_one, tdd_want[tdd_i] ?? 0, 0, 0, rgb(0xff, 0xff, 0xff));
        tdd_same = true;
        for tdd_y in 0..HUD_DIGIT_H {
            for tdd_dx in 0..HUD_DIGIT_W {
                if (tdd_cv.get_pixel(tdd_x + tdd_dx, tdd_y) & 0xffffff)
                   != (tdd_one.get_pixel(tdd_dx, tdd_y) & 0xffffff) {
                    tdd_same = false;
                }
            }
        }
        assert(tdd_same,
               "column {tdd_i} of 200 is not a '{tdd_want[tdd_i] ?? 0}' — the "
               + "number drawn is not the number asked for");
    }

    // ⚠ The control: a DIFFERENT number must draw a different picture,
    // or the comparison above is a statement about an empty canvas.
    tdd_other = canvas(PLAY_HUD_W, PLAY_HUD_H, 0);
    render_number(tdd_other, 100, PLAY_HUD_W, 0, rgb(0xff, 0xff, 0xff));
    assert(ink_of(tdd_cv, 0xffffff) != ink_of(tdd_other, 0xffffff),
           "200 and 100 draw the same amount of ink");

    // …and zero is ONE digit rather than none.
    tdd_zero = canvas(PLAY_HUD_W, PLAY_HUD_H, 0);
    assert(render_number(tdd_zero, 0, PLAY_HUD_W, 0, rgb(0xff, 0xff, 0xff)) == 1,
           "0 draws no digit at all");
    assert(ink_of(tdd_zero, 0xffffff) > 0, "…and it draws ink");
}

// ─────────────────────────────────────────────────────────────────────
// The overlay
// ─────────────────────────────────────────────────────────────────────

// @DRY-073 — the overlay is TRANSPARENT except where the digits are
//
// ⚠⚠ **THE ONE THING THAT MAKES IT AN OVERLAY AND NOT A PANEL.**
// `rgb()` sets alpha to 255 and a bare `0x…` literal leaves it 0 — the
// distinction that cost `gl_gate.loft` a false failure (`@M041`).  A
// fill with alpha 255 would put an opaque black slab over the world's
// corner, which looks deliberate and is not.
fn test_the_overlay_is_transparent_where_the_digits_are_not() {
    to_ps = play_state_new();
    to_cv = play_hud_canvas(to_ps);
    assert(to_cv.width == PLAY_HUD_W && to_cv.height == PLAY_HUD_H,
           "the overlay is its declared size: {to_cv.width}x{to_cv.height}");

    to_clear = 0;
    to_ink   = 0;
    to_other = 0;
    for to_y in 0..to_cv.height {
        for to_x in 0..to_cv.width {
            to_p = to_cv.get_pixel(to_x, to_y);
            if to_p == 0 { to_clear += 1; }
            else if to_p == hud_wallet_ink(to_ps.wave.wallet) { to_ink += 1; }
            else { to_other += 1; }
        }
    }
    assert(to_other == 0,
           "{to_other} pixels of the overlay are neither transparent nor ink");
    assert(to_ink > 0, "the overlay drew no digits at all");
    assert(to_clear > to_ink,
           "the overlay is mostly ink ({to_ink} of {to_clear + to_ink}) — a "
           + "panel rather than an overlay");
}

// @DRY-074 — EVERY colour the ramp can reach is nobody else's
//
// ⚠⚠ **THE SWEEP, AND IT FIRED ON ITS FIRST RUN** (`@M043`).  The ink
// ramps amber to red over the wallet, so it is not one colour but one
// per whole point — and `#ff8000`, which sits on that line at **134
// points**, was the SCOUT's.  The HUD would have been painted in a
// robot's colour at one value of the wallet, and the GL gate would have
// counted those pixels as a robot: *shares slightly off*, which is the
// failure a frame gate cannot see.
fn test_every_colour_the_ramp_reaches_is_nobody_elses() {
    tr_pal  = load_palette(PALETTE);
    tr_full = hud_wallet_points(wallet_new());
    assert(tr_full > 100, "the sweep covers a real range: 0..{tr_full}");

    tr_hits  = 0;
    tr_first = "";
    tr_worst = 0 - 1;
    for tr_p in 0..tr_full + 1 {
        tr_c = hud_ink_for(tr_p, tr_full) & 0xffffff;
        for tr_k in 0..len(tr_pal) {
            tr_o = palette_color(as_u8(tr_k)) & 0xffffff;
            if tr_c == tr_o {
                tr_hits += 1;
                if tr_first == "" { tr_first = "palette kind {tr_k} at {tr_p} points"; }
            }
            tr_d = colour_distance2(tr_c, tr_o);
            if tr_worst < 0 || tr_d < tr_worst { tr_worst = tr_d; }
        }
        for tr_e in 0..ENT_CLASSES {
            tr_ec = entity_colour(tr_e) & 0xffffff;
            if tr_c == tr_ec {
                tr_hits += 1;
                if tr_first == "" {
                    tr_first = "{entity_class_name(tr_e)} at {tr_p} points";
                }
            }
            tr_de = colour_distance2(tr_c, tr_ec);
            if tr_de < tr_worst { tr_worst = tr_de; }
        }
        if tr_c == (GL_GATE_CLEAR & 0xffffff) {
            tr_hits += 1;
            if tr_first == "" { tr_first = "the clear colour at {tr_p} points"; }
        }
    }
    assert(tr_hits == 0,
           "the wallet ramp is somebody else's colour at {tr_hits} of its "
           + "{tr_full + 1} values — first {tr_first}");

    // ⚠ A DESIGN reading beside the gate, `entity_min_distance2`'s
    // sibling: exact distinctness says nothing about whether a player
    // can tell the HUD from the world behind it.
    assert(tr_worst > 3000,
           "the ramp's closest approach to anything else in a frame is "
           + "{tr_worst} (squared RGB) — under 3000 is a pair a player "
           + "cannot tell apart");
}

// @DRY-075 — the overlay follows the wallet
//
// ⚠ Emit BOTH states and assert they DIFFER, which is `plans/20`
// § Invariant gate's rule: *it rendered* cannot see a number read out
// of the wrong field.
fn test_the_overlay_follows_the_wallet() {
    tf_a = play_state_new();
    tf_ca = play_hud_canvas(tf_a);

    tf_b = play_state_new();
    wallet_drain(tf_b.wave.wallet, 137.0);
    assert(hud_wallet_points(tf_b.wave.wallet) == 63,
           "the control: the second wallet really moved");
    tf_cb = play_hud_canvas(tf_b);

    assert(ink_of(tf_ca, hud_wallet_ink(tf_a.wave.wallet))
           != ink_of(tf_cb, hud_wallet_ink(tf_b.wave.wallet)),
           "200 points and 63 points draw the same overlay — the number is "
           + "not being read from the wallet");
    // ⚠ …and they are not even the same COLOUR, which is the ramp.
    assert(hud_wallet_ink(tf_a.wave.wallet) != hud_wallet_ink(tf_b.wave.wallet),
           "a full wallet and a two-thirds-spent one are drawn in the same "
           + "colour — the ramp is not reading the wallet");
}

// @DRY-076 — the ramp runs from a full wallet to a broke one
//
// ⚠ The endpoints are the two constants and nothing between them is
// authored — the span is the RUN's budget, which the simulation already
// owns, so the ramp invents no number.  ⚠ Clamped BOTH ways:
// `wallet_earn` exists, so a run really can hold more than it started
// with, and a wallet above full is amber rather than a colour past it.
fn test_the_ramp_runs_from_full_to_broke() {
    tp_full = hud_wallet_points(wallet_new());
    assert((hud_ink_for(tp_full, tp_full) & 0xffffff) == HUD_INK_FULL,
           "a full wallet is the full colour: {hud_ink_for(tp_full, tp_full)}");
    assert((hud_ink_for(0, tp_full) & 0xffffff) == HUD_INK_BROKE,
           "a broke wallet is the broke colour: {hud_ink_for(0, tp_full)}");
    assert((hud_ink_for(tp_full + 500, tp_full) & 0xffffff) == HUD_INK_FULL,
           "a wallet ABOVE full is still the full colour, not one past it");
    assert((hud_ink_for(0 - 20, tp_full) & 0xffffff) == HUD_INK_BROKE,
           "a wallet below zero is the broke colour, not one past it");

    // ⚠ It really MOVES in between, or the two endpoints are a switch
    // rather than a ramp — and a switch reads as healthy at every value
    // except the two it names.
    // ⚠ MASKED, because `hud_ink_for` builds through `rgb()` and
    // therefore carries ALPHA 255 while the two constants are the bare
    // 24 bits — comparing them raw reads 4294950912 against 16760832
    // and every one of these assertions fails for a reason that is not
    // the ramp.  The same top byte cost `gl_gate.loft` a false failure
    // (`@M041`), one layer out.
    tp_mid = hud_ink_for((tp_full / 2) ?? 0, tp_full) & 0xffffff;
    assert(tp_mid != HUD_INK_FULL && tp_mid != HUD_INK_BROKE,
           "half a wallet is drawn in an endpoint colour — this is a switch, "
           + "not a ramp: {tp_mid}");

    // ⚠ …and it moves ONE WAY.  A ramp that doubled back would read as
    // healthier again on the way down, which is the one thing a warning
    // colour must not do.
    tp_prev = 0 - 1;
    for tp_p in 0..tp_full + 1 {
        tp_g = (hud_ink_for(tp_p, tp_full) >> 8) & 255;
        assert(tp_g >= tp_prev,
               "the ramp doubles back at {tp_p} points ({tp_g} after {tp_prev}) "
               + "— a warning colour that recovers is worse than none");
        tp_prev = tp_g;
    }
}

// @DRY-077 — the colour and the digits read ONE number
//
// ⚠⚠ **THE REASON THE RAMP IS A FUNCTION OF `hud_wallet_points`**: read
// off `wallet_left` instead and the colour and the digits are two
// readings of one wallet that can disagree by a rounding — and the
// disagreement is invisible, because both look plausible.
fn test_the_colour_and_the_digits_read_one_number() {
    tc_w = wallet_new();
    wallet_drain(tc_w, 60.7);
    assert(hud_wallet_points(tc_w) == 139,
           "the control: 139.3 points floors to {hud_wallet_points(tc_w)}");
    assert(hud_wallet_ink(tc_w) == hud_ink_for(hud_wallet_points(tc_w),
                                              WALLET_STARTING_POINTS as integer? ?? 0),
           "the ink is not the ink of the number that is drawn");
    // ⚠ Two wallets that SHOW the same number must be drawn the same,
    // however far apart their floats are.
    tc_v = wallet_new();
    wallet_drain(tc_v, 60.99);
    assert(hud_wallet_points(tc_v) == 139, "…and so does 139.01");
    assert(hud_wallet_ink(tc_v) == hud_wallet_ink(tc_w),
           "two wallets showing 139 are drawn in different colours");
}

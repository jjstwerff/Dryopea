//
// Plan 30 phase R2 — the cycle is CLOSED-FORM.
//
// ⚠⚠ **THE STRONGEST GATE IN THE PLAN, and it is an EQUALITY**: for
// every `t` in a sweep, `cycle_at(t)` is the hex a body reaches by
// STEPPING the mover from `t = 0`.  ⚠ It is what makes `@X299`'s
// un-tracked mob COMPUTED rather than approximated, and therefore what
// makes `plans/22`'s LOD refusal need no exception here.
//
// ── ⚠ What is the harness and what is under test ────────────────
//
// `r2_check` below is the HARNESS: a `Bank`, a `flow_step` down the field
// toward whatever `errand_destination_of` names, and `errand_arrive` at
// the far end.  ⚠⚠ **It shares no line with `cycle_at`** — one steps and
// the other computes — because an equality between two spellings of one
// arithmetic proves nothing.
//
// ⚠⚠ **The world is not a plain, and R0 probe 1 is why** (`@M071`): a
// barrier forces the route to bend, so a cycle that walked straight
// lines would disagree with the harness on almost every hex.  The
// fixture asserts the bend rather than assuming it.
//
// ── ⚠⚠ The sweep is a CROSS-PRODUCT ────────────────────────────
//
// `CLAUDE.md` § THE INSTRUMENT IS A CROSS-PRODUCT: the player read
// 180 / 120 / 180 / 0 / 0 / 0 / 0 hexes a minute against a true 180
// because the one tick-length gate in the repo banked an ENEMY.  So the
// sweep here is **three speeds × three chunkings**, and one chunking is
// deliberately a number that divides neither the tick nor a hex.
//
// ── ⚠⚠ And the CLOCK is where the equality stops being free ────
//
// A bag-steered leg boundary is a DISTANCE and lands exactly; a
// clock-steered one is a TIME and lands inside a chunk.  ⚠ That is
// measured here rather than argued (`@M074`), it is the second and
// independent reason for `@FR-E-Bag-Steers`, and it is why `cycle_fault`
// refuses a clock period that is not a whole number of ticks.

#cwd

use dryopea;

const PALETTE: text = "examples/palette.json";
const GRASS:   integer = 5;

// 120 ticks of game time in base units.  ⚠ Spelled out rather than
// derived from `TICK_STEP_UNITS`, because a file-scope const initialised
// from a sibling module's const PANICS the compiler ([loft#962]).
const R2_SPAN: integer = 240000000;

fn as_u8(n: integer) -> u8 { n as u8? ?? 0 }

// ─── The world — ⚠ a bend, not a plain ──────────────────────────

// Thirteen columns by seven rows of grass, with column 6 walled off
// except at its two southern rows.
//
// ⚠⚠ **An UNPAINTED hex is sea and sea is not walkable**
// (`CLAUDE.md` § a walking test must paint the ground it walks on), so
// the barrier is a hole rather than a kind — nothing about the palette
// is under test here and a wall would bring a height rule with it.
fn r2_world() -> PaintedWorld {
    rw_pw = painted_empty();
    for rw_r in 0..=6 {
        for rw_q in 0..=12 {
            if rw_q == 6 && rw_r <= 5 { continue; }
            paint(rw_pw, rw_q, rw_r, as_u8(GRASS));
        }
    }
    rw_pw
}

fn r2_home() -> Hex { Hex { q: 0,  r: 3 } }
fn r2_work() -> Hex { Hex { q: 12, r: 3 } }

fn r2_field(to: const Hex) -> FlowField {
    flow_build(load_palette(PALETTE), r2_world(), height_layer_empty(),
               as_u8(ENEMY_KIND_REGULAR), to)
}

// A gatherer whose picking ground is across the barrier.  ⚠ `gather`
// rather than `haul` because its two anchors are `home` and `work`,
// which are the two the fixture names.
fn r2_gatherer() -> Errand {
    errand_at(ROLE_GATHER, r2_home(), r2_work(), Hex { q: 0, r: 0 })
}

// ─── ⚠ The harness — a body, STEPPED ────────────────────────────

// Walk a body for `chunks` chunks of `chunk` base units and check the
// closed form against it at the end of every one.  Answers (positions
// that disagree, LEGS that disagree, moments looked at, the first
// disagreement).
//
// ⚠⚠ **The destination is resolved at the chunk's START.**  A mover
// decides where it is going and then spends the time; resolving at the
// END would send a body down the leg it is about to be turned onto for
// the whole of the chunk before the turn — a defect in the HARNESS that
// would read as one in the closed form.
//
// ⚠ A hex the ground refuses is SPENT and never re-banked
// (`spawn.loft::enemy_tick`), which is what a guard standing at its post
// does with the hexes its clock keeps releasing.
//
// ⚠⚠ **The LEG is checked as well as the hex, and it has to be**: two
// legs of one round share every hex at their join, so a rule that named
// the wrong leg there would put the body on exactly the right hex — the
// mistake is invisible in a position and visible only against
// `errand_leg`, which is R1's own answer to *where am I going*.
fn r2_check(c: const Cycle, er: Errand, row: const Role,
            start: const Hex, f_work: const FlowField,
            f_home: const FlowField, rate: integer,
            chunk: integer) -> (integer, integer, integer, text) {
    rck_b   = bank_new();
    rck_at  = Hex { q: start.q, r: start.r };
    rck_bad = 0;
    rck_leg = 0;
    rck_n   = (R2_SPAN / chunk) ?? 1;
    rck_say = "";
    rck_i   = 0;
    while rck_i < rck_n {
        rck_now  = rck_i * chunk;
        rck_left = bank_gain(rck_b, rate, chunk, BANK_WHOLE);
        while rck_left > 0 {
            rck_job = errand_destination_of(row, er, rck_now);
            if !rck_job.found { break; }
            rck_next = Hex { q: rck_at.q, r: rck_at.r };
            if rck_job.q == er.work.q && rck_job.r == er.work.r {
                rck_next = flow_step(f_work, rck_at.q, rck_at.r);
            } else {
                rck_next = flow_step(f_home, rck_at.q, rck_at.r);
            }
            rck_at = Hex { q: rck_next.q, r: rck_next.r };
            // ⚠⚠ Arrival is asked AFTER the step and whatever is left of
            // the bank carries on down the NEXT leg — `src/errand.loft`
            // § THE BANK DOES NOT RESTART AT A LEG BOUNDARY.
            rck_hit = errand_arrive(er, row, rck_at, rck_now);
            if rck_hit { rck_left = rck_left; }
            rck_left -= 1;
        }
        rck_i += 1;
        rck_t  = rck_i * chunk;
        rck_ph = cycle_phase(c, row, rate, rck_t);
        rck_want = cycle_at(c, row, rate, rck_t);
        // ⚠ The leg the RULE is on, named as the anchor it ends at, and
        // the anchor R1's steering is making for at the same moment.
        rck_ra = c.anchors[rck_ph.0] ?? ANCHOR_NONE;
        rck_ea = errand_leg(row, er, rck_t);
        if rck_want.q != rck_at.q || rck_want.r != rck_at.r {
            rck_bad += 1;
            if rck_say == "" {
                rck_say = " first at chunk {rck_i}: stepped "
                          + "({rck_at.q},{rck_at.r}), rule "
                          + "({rck_want.q},{rck_want.r})";
            }
        }
        if rck_ra != rck_ea {
            rck_leg += 1;
            if rck_say == "" {
                rck_say = " first at chunk {rck_i}: the rule is on the leg "
                          + "ending at anchor {rck_ra}, the steering names "
                          + "{rck_ea}";
            }
        }
    }
    (rck_bad, rck_leg, rck_i, rck_say)
}

// ─── ⚠ A LEG IS A PATH — the fixture's own control ──────────────

// @DRY-153 — a leg is the path a body walks, and it is not a line
fn test_a_leg_is_the_path_and_never_a_line() {
    tal_f  = r2_field(r2_work());
    tal_rt = flow_route(tal_f, r2_home());
    tal_n  = len(tal_rt) - 1;
    tal_d  = flow_distance(tal_f, r2_home().q, r2_home().r);
    tal_s  = lat_distance(r2_home(), r2_work());

    // ⚠ Every consecutive pair must be neighbours: a route that teleports
    // is not a route, and `lat_neighbour` is the only thing allowed to
    // step a coordinate (moros#10).
    tal_gap = 0;
    tal_i   = 0;
    tal_prv = Hex { q: 0, r: 0 };
    for tal_h in tal_rt {
        if tal_i > 0 && lat_distance(tal_prv, tal_h) != 1 { tal_gap += 1; }
        tal_prv = Hex { q: tal_h.q, r: tal_h.r };
        tal_i += 1;
    }
    tal_a = tal_rt[0] ?? Hex { q: 0 - 1, r: 0 - 1 };
    tal_z = tal_rt[tal_n] ?? Hex { q: 0 - 1, r: 0 - 1 };

    // ⚠⚠ **`tal_n > tal_s` is the fixture's vacuity control** — a world
    // whose route IS the straight line could not tell a terrain-aware
    // cycle from a line one, which is exactly what R0 probe 1 says a
    // real map is not (`@M071`).
    assert(tal_n == tal_d && tal_gap == 0
           && tal_a.q == r2_home().q && tal_a.r == r2_home().r
           && tal_z.q == r2_work().q && tal_z.r == r2_work().r
           && tal_n > tal_s,
           "a leg is a PATH: {tal_n} steps against a field distance of "
           + "{tal_d} and a straight line of {tal_s}, {tal_gap} of them "
           + "not a neighbour, from ({tal_a.q},{tal_a.r}) to "
           + "({tal_z.q},{tal_z.r})");
}

// ─── ⚠⚠ TIME → STEPS is exact ──────────────────────────────────

// @DRY-158 — the bank's cumulative answer in closed form
fn test_the_banks_closed_form_is_exact_at_every_chunking() {
    // ⚠⚠ **The cross-product, on the half that has no world in it**:
    // FOUR speeds against four step lengths, one of which divides
    // neither the tick nor a second, and one of which is a single base
    // unit.  ⚠ `CLAUDE.md` § A COUNT asked for in
    // SECONDS comes back SHORT is the failure this replaces, and it was
    // wrong for 602 of the first 1000 `n`.
    tbc_bad = 0;
    tbc_say = "";
    for tbc_sp in [1.0, 1.5, 2.5, 0.7] {
        tbc_rate = bank_rate(tbc_sp);
        for tbc_ch in [2000000, 666666, 137113, 1] {
            tbc_b   = bank_new();
            tbc_run = 0;
            tbc_t   = 0;
            tbc_i   = 0;
            // ⚠ A short span for the 1-unit chunk, or the sweep is a
            // hundred million iterations for no extra claim.
            tbc_n = 400;
            while tbc_i < tbc_n {
                tbc_run += bank_gain(tbc_b, tbc_rate, tbc_ch, BANK_WHOLE);
                tbc_t   += tbc_ch;
                tbc_i   += 1;
                if tbc_run != cycle_walked(tbc_rate, tbc_t) {
                    tbc_bad += 1;
                    if tbc_say == "" {
                        tbc_say = " {tbc_sp} hex/s in {tbc_ch}-unit chunks"
                                  + " at t={tbc_t}: banked {tbc_run}, rule "
                                  + "{cycle_walked(tbc_rate, tbc_t)}";
                    }
                }
            }
        }
    }
    // ⚠ The control: the sweep must be able to READ a difference at all
    // — a rate that releases nothing would agree with anything.
    assert(tbc_bad == 0 && cycle_walked(bank_rate(1.5), 240000000) == 120,
           "`cycle_walked` is `bank_gain` accumulated: {tbc_bad} "
           + "disagreements;{tbc_say} (control: 120 ticks at 1.5 hex/s is "
           + "{cycle_walked(bank_rate(1.5), 240000000)} hexes, want 120)");
}

// ─── ⚠⚠ THE EQUALITY — the rule IS the stepped body ─────────────

// @DRY-154 — the closed form equals the stepped mover, swept not sampled
fn test_the_closed_form_equals_the_stepped_mover() {
    tcf_row = errand_role_of(ROLE_GATHER);
    tcf_wf  = r2_field(r2_work());
    tcf_hf  = r2_field(r2_home());
    tcf_c   = cycle_build(r2_gatherer(), tcf_row, load_palette(PALETTE),
                          r2_world(), height_layer_empty(),
                          as_u8(ENEMY_KIND_REGULAR));
    tcf_bad   = 0;
    tcf_leg   = 0;
    tcf_seen  = 0;
    tcf_say   = "";
    for tcf_sp in [1.0, 1.5, 2.5, 0.7] {
        tcf_rate = bank_rate(tcf_sp);
        for tcf_ch in [2000000, 666666, 137113] {
            tcf_got = r2_check(tcf_c, r2_gatherer(), tcf_row, r2_home(),
                               tcf_wf, tcf_hf, tcf_rate, tcf_ch);
            tcf_bad  += tcf_got.0;
            tcf_leg  += tcf_got.1;
            tcf_seen += tcf_got.2;
            if tcf_say == "" && tcf_got.3 != "" {
                tcf_say = " {tcf_sp} hex/s, {tcf_ch}-unit chunks:" + tcf_got.3;
            }
        }
    }
    // ⚠⚠ **The vacuity controls are the second half of the assertion**:
    // the sweep must have looked at thousands of moments, the round must
    // be longer than the straight line there and back (so the cycle
    // BENDS), and the SLOWEST swept mover must close a whole round inside
    // the span while the fastest closes three — a sweep that never
    // reached the far anchor would be green for a rule that only ever
    // answers `home`.
    assert(tcf_bad == 0 && tcf_leg == 0 && tcf_seen > 2000
           && cycle_running(tcf_c)
           && tcf_c.period > 2 * lat_distance(r2_home(), r2_work())
           && cycle_walked(bank_rate(0.7), R2_SPAN) > tcf_c.period
           && cycle_walked(bank_rate(2.5), R2_SPAN) > 3 * tcf_c.period,
           "the rule must BE the stepped body: {tcf_bad} hexes and "
           + "{tcf_leg} legs of {tcf_seen} swept moments disagree;{tcf_say}"
           + " (period {tcf_c.period} steps against a straight "
           + "there-and-back of {2 * lat_distance(r2_home(), r2_work())})");
}

// ─── ⚠⚠ THE CLOCK — where a leg boundary stops landing exactly ──

// A guard whose post is four hexes from its second leg, on open ground.
fn r2_guard() -> Errand {
    errand_at(ROLE_GUARD, Hex { q: 0, r: 6 }, Hex { q: 4, r: 6 },
              Hex { q: 0, r: 6 })
}

// @DRY-155 — a clock-steered leg boundary lands inside a step
fn test_a_clock_boundary_lands_inside_a_step_and_the_bag_never_does() {
    tcb_er  = r2_guard();
    tcb_wf  = r2_field(tcb_er.work);
    tcb_hf  = r2_field(tcb_er.alt);

    // ⚠⚠ **THE SHIPPED PERIOD CANNOT SEE ITS OWN ROUNDING, AND THAT IS
    // WHY THE NEIGHBOURS ARE SWEPT** (`CLAUDE.md` § the branch test is
    // NECESSARY, not SUFFICIENT, `@M013` / `@M014`): `GUARD_LEG_UNITS`
    // is ten seconds, and at 1.0, 1.5 and 2.5 hex/s that is 10, 15 and
    // 25 whole hexes — the bank's carry is EXACTLY ZERO at every flip,
    // so *walked(t) − walked(t₀)* and *walked(t − t₀)* agree for any
    // implementation.  ⚠ **16 ticks** is one column away and buys
    // 26.67 hexes at a scout's pace, which is a carry that can disagree.
    tcb_shipped = errand_role_of(ROLE_GUARD);
    tcb_wonky   = errand_row("guard16", ANCHOR_WORK, ANCHOR_ALT, 32000000);

    tcb_bad  = 0;
    tcb_seen = 0;
    tcb_say  = "";
    for tcb_sp in [1.0, 1.5, 2.5, 0.7] {
        tcb_rate = bank_rate(tcb_sp);
        // ⚠ Both rows, and every step length that divides BOTH periods —
        // a whole tick and half of one.
        for tcb_ch in [2000000, 1000000] {
            tcb_a = r2_check(cycle_build(tcb_er, tcb_shipped,
                                         load_palette(PALETTE), r2_world(),
                                         height_layer_empty(),
                                         as_u8(ENEMY_KIND_REGULAR)),
                             r2_guard(), tcb_shipped, tcb_er.alt,
                             tcb_wf, tcb_hf, tcb_rate, tcb_ch);
            tcb_b = r2_check(cycle_build(tcb_er, tcb_wonky,
                                         load_palette(PALETTE), r2_world(),
                                         height_layer_empty(),
                                         as_u8(ENEMY_KIND_REGULAR)),
                             r2_guard(), tcb_wonky, tcb_er.alt,
                             tcb_wf, tcb_hf, tcb_rate, tcb_ch);
            tcb_bad  += tcb_a.0 + tcb_a.1 + tcb_b.0 + tcb_b.1;
            tcb_seen += tcb_a.2 + tcb_b.2;
            if tcb_say == "" && tcb_a.3 != "" {
                tcb_say = " shipped period, {tcb_sp} hex/s, {tcb_ch}:"
                          + tcb_a.3;
            }
            if tcb_say == "" && tcb_b.3 != "" {
                tcb_say = " 16-tick period, {tcb_sp} hex/s, {tcb_ch}:"
                          + tcb_b.3;
            }
        }
    }

    // ⚠⚠ **AND THE READING: a leg boundary in TIME lands wherever the
    // step puts it.**  Fifteen ticks is 7.5 two-tick steps, so the flip
    // falls in the MIDDLE of one — which at 1.5 hex/s is exactly one hex
    // — and the body is a hex ahead of its own rule until it arrives.
    tcb_drift = r2_check(cycle_build(tcb_er, tcb_shipped,
                                     load_palette(PALETTE), r2_world(),
                                     height_layer_empty(),
                                     as_u8(ENEMY_KIND_REGULAR)),
                         r2_guard(), tcb_shipped, tcb_er.alt,
                         tcb_wf, tcb_hf, bank_rate(1.5), 4000000);
    // ⚠⚠ **The BAG over the very same two-tick step, and it is the whole
    // control**: same world, same walker, same 4 000 000 units, and the
    // only difference is which column steers.  A reading that showed the
    // clock adrift without showing the bag steady would be measuring the
    // STEP rather than the steering.
    tbg_row = errand_role_of(ROLE_GATHER);
    tbg_hold = r2_check(cycle_build(r2_gatherer(), tbg_row,
                                    load_palette(PALETTE), r2_world(),
                                    height_layer_empty(),
                                    as_u8(ENEMY_KIND_REGULAR)),
                        r2_gatherer(), tbg_row, r2_home(),
                        r2_field(r2_work()), r2_field(r2_home()),
                        bank_rate(1.5), 4000000);

    // ⚠ And `cycle_fault` is what turns that reading into a REFUSAL: a
    // clock period that is not a whole number of ticks is an authoring
    // error, named at construction rather than measured later.
    tcb_odd_row = errand_row("odd", ANCHOR_WORK, ANCHOR_ALT, 30000001);
    tcb_c = cycle_build(tcb_er, tcb_shipped, load_palette(PALETTE),
                        r2_world(), height_layer_empty(),
                        as_u8(ENEMY_KIND_REGULAR));

    assert(tcb_bad == 0 && tcb_seen > 900
           && tcb_drift.0 > 0 && tbg_hold.0 == 0 && tbg_hold.1 == 0
           && cycle_fault(tcb_c, tcb_shipped, bank_rate(1.5)) == ""
           && cycle_fault(tcb_c, tcb_odd_row, bank_rate(1.5)) != "",
           "a clock steers exactly at a step that divides its period "
           + "({tcb_bad} of {tcb_seen} moments adrift;{tcb_say}) and not "
           + "at one that does not ({tcb_drift.0} adrift over "
           + "{tcb_drift.2} two-tick steps) — while the BAG holds over "
           + "the same step ({tbg_hold.0} hexes, {tbg_hold.1} legs of "
           + "{tbg_hold.2})");
}

// ─── ⚠ What a cycle may not be ──────────────────────────────────

// @DRY-157 — a leg that does not connect refuses the whole cycle
fn test_a_leg_that_does_not_connect_refuses_the_cycle() {
    tld_row = errand_role_of(ROLE_GATHER);
    tld_pal = load_palette(PALETTE);
    // ⚠ An anchor out in the sea: painted nothing, so nothing can stand
    // there and no field reaches it.
    tld_far = errand_at(ROLE_GATHER, r2_home(), Hex { q: 40, r: 40 },
                        Hex { q: 0, r: 0 });
    tld_c = cycle_build(tld_far, tld_row, tld_pal, r2_world(),
                        height_layer_empty(), as_u8(ENEMY_KIND_REGULAR));
    tld_ok = cycle_build(r2_gatherer(), tld_row, tld_pal, r2_world(),
                         height_layer_empty(), as_u8(ENEMY_KIND_REGULAR));
    // ⚠ The control is the second half: a refusal that refuses
    // everything is not a refusal.
    assert(!cycle_running(tld_c)
           && cycle_fault(tld_c, tld_row, bank_rate(1.5)) != ""
           && cycle_running(tld_ok)
           && cycle_fault(tld_ok, tld_row, bank_rate(1.5)) == "",
           "an unreachable anchor is no cycle at all — running={cycle_running(tld_c)}"
           + " fault='{cycle_fault(tld_c, tld_row, bank_rate(1.5))}'; and a "
           + "reachable pair must still build: running={cycle_running(tld_ok)}"
           + " fault='{cycle_fault(tld_ok, tld_row, bank_rate(1.5))}'");
}

// @DRY-159 — every way a round can fail to be a round
fn test_a_round_that_does_not_close_is_refused() {
    trc_bag = errand_role_of(ROLE_GATHER);
    trc_clk = errand_role_of(ROLE_GUARD);
    trc_p: vector<Hex> = [];
    for trc_i in 0..6 { trc_p += [Hex { q: trc_i, r: 0 }]; }

    // ⚠⚠ **The named one: legs that do not sum to the period.**  A
    // wrapped round is not a crash — it is a mob standing on the wrong
    // hex for ever with every count in the suite green.
    // ⚠⚠ **The legs must disagree with the period while the PATH still
    // agrees with it** — a mutation found this: with `lengths: [3, 3]`
    // and `period: 9` the round is refused by the path-length check
    // instead, so deleting the sum check left the suite green and the
    // plan's own named control was never being read.
    trc_sum  = Cycle { anchors: [ANCHOR_WORK, ANCHOR_HOME],
                       lengths: [2, 3], path: trc_p, period: 6 };
    trc_path = Cycle { anchors: [ANCHOR_WORK, ANCHOR_HOME],
                       lengths: [3, 4], path: trc_p, period: 7 };
    trc_cnt  = Cycle { anchors: [ANCHOR_WORK],
                       lengths: [3, 3], path: trc_p, period: 6 };
    trc_zero = Cycle { anchors: [ANCHOR_WORK, ANCHOR_HOME],
                       lengths: [6, 0], path: trc_p, period: 6 };
    trc_good = Cycle { anchors: [ANCHOR_WORK, ANCHOR_HOME],
                       lengths: [3, 3], path: trc_p, period: 6 };
    // ⚠ A clock too short to walk its own leg is `crawler`'s oscillation
    // refused at CONSTRUCTION — 15 ticks at 1.5 hex/s buys 15 hexes and
    // this leg is 30.
    trc_slow: vector<Hex> = [];
    for trc_j in 0..60 { trc_slow += [Hex { q: trc_j, r: 1 }]; }
    trc_short = Cycle { anchors: [ANCHOR_WORK, ANCHOR_ALT],
                        lengths: [30, 30], path: trc_slow, period: 60 };
    // ⚠ And a period that is not a whole number of ticks, which the test
    // above is what earns.
    trc_odd_row = errand_row("odd", ANCHOR_WORK, ANCHOR_ALT, 30000001);

    trc_bad = 0;
    for trc_c in [trc_sum, trc_path, trc_cnt, trc_zero] {
        if cycle_fault(trc_c, trc_bag, bank_rate(1.5)) == "" { trc_bad += 1; }
    }
    if cycle_fault(trc_short, trc_clk, bank_rate(1.5)) == "" { trc_bad += 1; }
    if cycle_fault(trc_good, trc_odd_row, bank_rate(1.5)) == "" { trc_bad += 1; }
    // ⚠ The generic control `CLAUDE.md` asks for: can this refusal
    // produce a non-trivial reading at all?
    assert(trc_bad == 0 && cycle_fault(trc_good, trc_bag, bank_rate(1.5)) == "",
           "{trc_bad} of 6 malformed rounds were accepted, and a well-formed "
           + "one must not be: '{cycle_fault(trc_good, trc_bag, bank_rate(1.5))}'");
}

// ─── ⚠ Slip, and the one-way door ───────────────────────────────

// @DRY-156 — slip makes a mob LATER and never lost
fn test_slip_makes_a_mob_later_and_never_lost() {
    tsm_row = errand_role_of(ROLE_GATHER);
    tsm_c   = cycle_build(r2_gatherer(), tsm_row, load_palette(PALETTE),
                          r2_world(), height_layer_empty(),
                          as_u8(ENEMY_KIND_REGULAR));
    tsm_e = Enemy { q: 0, r: 3, kind: ENEMY_KIND_REGULAR as u8? ?? 0,
                    alive: true, errand: true, route: r2_gatherer() };
    tsm_l = Enemy { q: 0, r: 3, kind: ENEMY_KIND_REGULAR as u8? ?? 0,
                    alive: true, errand: true, route: r2_gatherer() };
    // ⚠ Twelve ticks behind — an integer, so there is no epsilon to get
    // the direction of wrong.
    tsm_l.route.slip = 24000000;
    tsm_now  = 200000000;
    tsm_a    = cycle_where(tsm_e, tsm_c, tsm_now);
    tsm_b    = cycle_where(tsm_l, tsm_c, tsm_now);
    tsm_then = cycle_where(tsm_e, tsm_c, tsm_now - 24000000);
    // ⚠⚠ **The reading is that a slipped mob is where the punctual one
    // WAS**, not that it is somewhere else: `@FR-E-Slip` says a
    // deviation costs TIME and never DESTINATION.  ⚠ And the control is
    // that the two hexes differ at all — a mob standing still would
    // satisfy the equality for any slip.
    assert(tsm_b.q == tsm_then.q && tsm_b.r == tsm_then.r
           && (tsm_a.q != tsm_b.q || tsm_a.r != tsm_b.r),
           "a slipped mob is where the punctual one was: punctual "
           + "({tsm_a.q},{tsm_a.r}), slipped ({tsm_b.q},{tsm_b.r}), "
           + "punctual twelve ticks ago ({tsm_then.q},{tsm_then.r})");
}

// @DRY-160 — the bubble is the one exit, and the reader is where it lands
fn test_a_robot_the_bubble_took_is_off_its_cycle() {
    tbt_row = errand_role_of(ROLE_GATHER);
    tbt_c   = cycle_build(r2_gatherer(), tbt_row, load_palette(PALETTE),
                          r2_world(), height_layer_empty(),
                          as_u8(ENEMY_KIND_REGULAR));
    tbt_on  = Enemy { q: 7, r: 5, kind: ENEMY_KIND_REGULAR as u8? ?? 0,
                      alive: true, errand: true, route: r2_gatherer() };
    tbt_off = Enemy { q: 7, r: 5, kind: ENEMY_KIND_REGULAR as u8? ?? 0,
                      alive: true, errand: false, route: r2_gatherer() };
    tbt_now = 100000000;
    tbt_a = cycle_where(tbt_on,  tbt_c, tbt_now);
    tbt_b = cycle_where(tbt_off, tbt_c, tbt_now);
    // ⚠⚠ **The anchors are IDENTICAL in both** — what changed is the
    // link, not the routine — and a cut-off robot answers its OWN hex,
    // so site 5 of `plans/30` § Count the RE-ASSERTION SITES has no
    // second write to forget.
    assert(tbt_b.q == 7 && tbt_b.r == 5
           && (tbt_a.q != 7 || tbt_a.r != 5)
           && errand_same(tbt_on.route, tbt_off.route),
           "a robot the bubble took is off its cycle: linked "
           + "({tbt_a.q},{tbt_a.r}), cut off ({tbt_b.q},{tbt_b.r}) which "
           + "must be its own hex (7,5)");
}

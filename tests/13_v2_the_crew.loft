//
// Plan 13 phase V2 — the crew clears up, and a tower starts paying.
//
// ── The measurement this phase answers ──────────────────────────
//
// Plan 12 B7 ended on a base that fell SOONER for having a gun on it:
// a tower killed eight robots at the foot of its own wall, three of
// them landed on one hex, and 1.5 m of dead is inside plan 12 B0's
// [1.0, 2.0] ramp band onto a 3.0 m `wall` — so the survivors climbed
// over a wall that never lost a tenth of its HP.  B7 named the missing
// piece: *"a crew to collect bodies, which arrives with the vehicle"*.
//
//   undefended                    61 ticks
//   sealed wall                  104
//   sealed wall + tower           95     ← the tower is a LIABILITY
//   sealed wall + tower + crew   145     ← and now it is an asset
//
// ⚠ 121 of those were V2's, from denying the ramp alone; plan 13 V3
// added the other 24 by paying the crew for what it clears.
//
// ⚠ **The wall's HP is the mechanism; the clock is the consequence.**
// Without a crew that wall ends at 96.7 of 100 — nobody had to break
// it.  With one it ends at 69.3.  The crew adds no damage whatsoever;
// every extra second comes from denying the attackers a staircase.
//
// ── ⚠ What V2 could NOT do, and it is the phase's other output ───
//
// The plan's gate said the towered base's clock would rise with a crew
// in it.  Measured, a crew INSIDE that base changes nothing at all:
// 95 ticks with or without.  The ramp forms where enemies die, which
// is outside the wall, and a hover unit climbs 0.4 m against a 3.0 m
// wall — **a sealed base locks its own crew in.**
//
// Two more configurations, both measured, both flat:
//
//   - the same base with a GATE in the wall: 90 ticks with a crew and
//     90 without.  Where there is a way in, the ramp was never what
//     got them in, so clearing it buys nothing.
//   - a crew parked at the gateway clears the heap perfectly (1.0 m ->
//     0.0 m) and the clock does not move by a tick.
//
// So the mechanic pays **only where the ramp is the way in**, and
// getting to it needs `hover_clearance_boost` — 3.0 m, exactly a wall
// — which is V4.  Until then clearing a sealed base's kill zone is a
// one-way commitment, and `a-crew-that-clears-up.keys` is a player who
// made it.

#cwd

use dryopea;

const PALETTE: text = "examples/palette.json";
const SHOTS:   text = "tests/actual";
const GRASS:   integer = 5;

const CREW:  text = "tests/scripts/a-crew-that-clears-up.keys";
const TOWER: text = "tests/scripts/a-tower-buries-its-own-wall.keys";

// ⚠ A second reading of `tests/12_b7_the_clock.loft`'s constants, not
// a second source of truth: each is pinned by a `ticks` band inside
// its own `.keys` file.  They are here because the comparison needs
// them in scope together.
const TOWERED_TICKS: integer = 95;
const CREWED_TICKS:  integer = 145;
const WALLED_TICKS:  integer = 104;

fn as_u8(n: integer) -> u8 {
    n as u8? ?? 0
}

fn core() -> Hex {
    Hex { q: 0, r: 0 }
}

fn pal() -> vector<GroundType> {
    load_palette(PALETTE)
}

fn band() -> PaintedWorld {
    b_pw = painted_empty();
    for b_r in -2..=2 {
        for b_q in -3..=16 { paint(b_pw, b_q, b_r, as_u8(GRASS)); }
    }
    b_pw
}

fn play(state: WaveState, pw: PaintedWorld, n: integer) {
    p_pal = pal();
    for _ in 0..n { wave_tick(state, p_pal, pw, marker_empty(), core()); }
}

// ─────────────────────────────────────────────────────────────────
// The rate, and where it reaches
// ─────────────────────────────────────────────────────────────────

// ⚠ **One dead robot a second, and it is DERIVED.**
// `numbers.json` § player_vehicle.salvage_rate is 0.5 m/s because
// § enemy_regular.body_height is 0.5 m — so the three-body ramp that
// beats a tower takes three seconds, and the arithmetic is readable
// without this file.
fn test_the_rate_is_one_body_a_second() {
    assert(VEHICLE_SALVAGE_METRES_PER_SECOND == BODY_HEIGHT_METRES,
           "a second of salvage is a body: {VEHICLE_SALVAGE_METRES_PER_SECOND} against {BODY_HEIGHT_METRES}");

    ttr_pw = band();
    ttr_s  = wave_state_empty();
    height_raise(ttr_s.heights, 6, 0, 3.0, as_u8(RUBBLE_WRECKAGE));
    vehicle_place(ttr_s.player, 7, 0);

    play(ttr_s, ttr_pw, 3);
    ttr_left = height_rise(ttr_s.heights, 6, 0);
    ttr_want = 3.0 - VEHICLE_SALVAGE_METRES_PER_SECOND * 3.0 * TICK_SECONDS;

    assert(ttr_left > ttr_want - 0.0001 && ttr_left < ttr_want + 0.0001,
           "three ticks took {3.0 - ttr_left} m, wanted {3.0 - ttr_want}");
}

// ⚠ **The reach is FORCED, and this is the assertion that says so.**
// The obvious rule — stand on the pile, as `DESIGN.md` § 11 says of
// loot — cannot fire on the only case anybody wants it for: a hover
// unit climbs 0.4 m and the ramp that beats a tower is 1.5 m.  So the
// vehicle clears what it is BESIDE, and the proof that it must is that
// it cannot get on.
fn test_the_vehicle_cannot_stand_on_the_heap_it_must_clear() {
    tvc_pw = band();
    tvc_s  = wave_state_empty();
    height_raise(tvc_s.heights, 6, 0, 1.5, as_u8(RUBBLE_WRECKAGE));
    vehicle_place(tvc_s.player, 9, 0);
    vehicle_drive(tvc_s.player, 0, 0);

    play(tvc_s, tvc_pw, 2);
    assert(tvc_s.player.q == 7,
           "it is stopped one hex short of the heap: q = {tvc_s.player.q}");
    assert(height_rise(tvc_s.heights, 6, 0) < 1.5,
           "and clears it from there: {height_rise(tvc_s.heights, 6, 0)} m left");
}

// ⚠ The negative control for the reach: two hexes out is out of range,
// so a crew that parks in the wrong place does nothing.  Without this
// a reach of "anywhere on the map" passes every other test here.
fn test_a_heap_two_hexes_away_is_not_touched() {
    tht_pw = band();
    tht_s  = wave_state_empty();
    height_raise(tht_s.heights, 6, 0, 1.5, as_u8(RUBBLE_WRECKAGE));
    vehicle_place(tht_s.player, 8, 0);      // two hexes from the heap

    play(tht_s, tht_pw, 20);
    assert(height_rise(tht_s.heights, 6, 0) == 1.5,
           "out of reach is untouched: {height_rise(tht_s.heights, 6, 0)} m");
}

// ⚠ **ONE heap a tick, the deepest in reach.**  A vehicle that cleared
// its whole neighbourhood at full rate each would tidy a wave's worth
// of dead in one pass, and the pressure this mechanic exists to create
// is that clearing takes TIME.
fn test_it_eats_the_deepest_heap_first_and_only_that_one() {
    tie_pw = band();
    tie_s  = wave_state_empty();
    height_raise(tie_s.heights, 6, 0, 2.0, as_u8(RUBBLE_WRECKAGE));
    height_raise(tie_s.heights, 6, 1, 1.0, as_u8(RUBBLE_WRECKAGE));
    vehicle_place(tie_s.player, 7, 0);

    play(tie_s, tie_pw, 1);

    assert(height_rise(tie_s.heights, 6, 0) < 2.0,
           "the deep one is being eaten: {height_rise(tie_s.heights, 6, 0)} m");
    assert(height_rise(tie_s.heights, 6, 1) == 1.0,
           "and the shallow one is untouched this tick: {height_rise(tie_s.heights, 6, 1)} m");
}

// A hex cleared to nothing loses its entry rather than keeping a 0.0 m
// one — `height.loft`'s own rule, and what makes the ground read as
// authored again.
fn test_a_fully_cleared_hex_is_authored_ground_again() {
    taf_pw = band();
    taf_s  = wave_state_empty();
    height_raise(taf_s.heights, 6, 0, 0.5, as_u8(RUBBLE_WRECKAGE));
    vehicle_place(taf_s.player, 7, 0);

    play(taf_s, taf_pw, 10);

    assert(height_rise(taf_s.heights, 6, 0) == 0.0, "the heap is gone");
    assert(height_piled(taf_s.heights, 6, 0) == false,
           "and so is its entry — a 0.0 m pile is not a pile");
    assert(hex_ground_name(pal(), taf_pw, taf_s.heights, 6, 0) == "grass",
           "so the hex is what it was painted: '{hex_ground_name(pal(), taf_pw, taf_s.heights, 6, 0)}'");
}

// Nobody parked a vehicle: nothing is cleared, and a run without a
// player is exactly plan 12's unattended base.
fn test_a_run_with_no_player_clears_nothing() {
    tar_pw = band();
    tar_s  = wave_state_empty();
    height_raise(tar_s.heights, 0, 0, 1.5, as_u8(RUBBLE_WRECKAGE));

    play(tar_s, tar_pw, 20);
    assert(height_rise(tar_s.heights, 0, 0) == 1.5,
           "an absent crew clears nothing, even on the origin: {height_rise(tar_s.heights, 0, 0)} m");
}

// ─────────────────────────────────────────────────────────────────
// The payoff — the comparison plan 12 B7 set up
// ─────────────────────────────────────────────────────────────────

// ⚠ **The phase's gate**, and like B7's it is a comparison no single
// `.keys` file can make.  The two scenarios differ by ONE line —
// `park 7 0` — so the clock between them is the crew and can be
// nothing else.
fn test_a_crew_turns_the_tower_from_a_liability_into_an_asset() {
    tac_cs = editor_state_new(PALETTE);
    tac_ts = editor_state_new(PALETTE);

    tac_c = script_run_file(tac_cs, CREW,  SHOTS);
    tac_t = script_run_file(tac_ts, TOWER, SHOTS);

    assert(tac_c.ok, "a-crew-that-clears-up: {script_describe(tac_c)}");
    assert(tac_t.ok, "a-tower-buries-its-own-wall: {script_describe(tac_t)}");
    assert(tac_c.checks == 17, "the crew scenario made {tac_c.checks} measurements, expected 17");

    assert(tac_c.ticks == CREWED_TICKS,  "crewed clock {tac_c.ticks}");
    assert(tac_t.ticks == TOWERED_TICKS, "towered clock {tac_t.ticks}");

    assert(tac_c.ticks > tac_t.ticks,
           "the crew bought time: {tac_c.ticks} against {tac_t.ticks}");

    // ⚠ **And it clears the bar B7 could not.**  A tower used to make
    // a base fall sooner than the wall alone; with a crew behind it,
    // the gun is finally worth its own bodies.
    assert(tac_c.ticks > WALLED_TICKS,
           "and the tower now beats a bare wall: {tac_c.ticks} against {WALLED_TICKS}");

    // The mechanism, not the consequence: the wall was actually broken
    // through this time instead of climbed over.
    assert(height_rise(tac_c.wave.heights, 6, 0) == 0.0,
           "no ramp survived: {height_rise(tac_c.wave.heights, 6, 0)} m");
    assert(height_rise(tac_t.wave.heights, 6, 0) >= 1.0,
           "where without a crew there is one: {height_rise(tac_t.wave.heights, 6, 0)} m");

    tac_c_hp = structure_hp(tac_cs.picker.palette, tac_cs.pw, tac_c.wave.damage, 5, 0);
    tac_t_hp = structure_hp(tac_ts.picker.palette, tac_ts.pw, tac_t.wave.damage, 5, 0);
    assert(tac_c_hp < tac_t_hp - 20.0,
           "and they had to CHEW it: {tac_c_hp} HP left against {tac_t_hp} with the ramp");
}

fn test_the_crew_scenario_is_on_disk() {
    assert(file(CREW).exists(),
           "{CREW} is missing — the test above would pass against an empty file");
}

//
// Plan 18 phase S1b — the vocabulary becomes TOTAL over `WaveState`.
//
// S1a made the roster authorable.  This does the rest: the towers, the
// wallet and the cargo had no setter at all, and the player, the crew
// and the schedule each had fields no play verb reaches — a boost
// running, a recovery clock, how far down the wave list a run has got.
//
// After this a `.keys` file can say every field of a `WaveState`, which
// is what makes S2's emitter nearly trivial and its round-trip gate
// meaningful.
//
// ── ⚠⚠ The gate is the TOTALITY test ────────────────────────────
//
// § Every field of the state is reachable builds ONE state in which
// every field of every struct holds a non-neutral value, entirely from
// a `.keys` source, and asserts it is S0-identical to the same state
// built in loft.  A field with no setter cannot pass it: the two states
// differ, and `state_diff` names the field.
//
// ⚠ That is the property, and it is stronger than seven separate
// "this verb works" tests — those are green while the ONE state a
// capture actually needs is unreachable.
//
// ── ⚠ Seven command words, not one `set` with a subject ─────────
//
// `convert.loft::keys_schemas` keys a coordinate's POSITION on the
// first token.  A single `set` would need one pair position for
// `set tower 4 0 …` and another for `set wallet 30`, and the mismatch
// is SILENT — a lattice conversion would rewrite `set member 0 on 0.5`
// as though `0 on` were a hex.  `09_c5a_converter.loft` § What must NOT
// be touched is the file that refuses exactly that.

#cwd

use dryopea;

const PALETTE: text = "examples/palette.json";

fn as_u8(n: integer) -> u8 {
    n as u8? ?? 0
}

// A session with a core, a tower marker, a trap plate and some ground.
fn played(src: text) -> ScriptRun {
    p_head = "do toggle_mode\n"
           + "do cycle_kind\nclick 0 0\n"          // target at (0, 0)
           + "do cycle_kind\nclick 4 0\n"          // tower at (4, 0)
           // ⚠ The fourth kind (BACKLOG C4).  `trap` demands its marker
           // the way `tower` does, so the head has to place one or the
           // totality test below cannot say a word about `traps` — and
           // a field left at its default on BOTH sides of the
           // comparison compares equal and proves nothing, which is the
           // trap this whole file keeps stepping around.
           + "do cycle_kind\nclick 5 0\n"          // trap at (5, 0)
           + "do toggle_mode\npalette 5\ndrag -2 0 16 0\n"
           // ⚠ A wall, because `damage` refuses a hex with nothing
           // breakable on it — "at 0 HP" and "no wall here" are the two
           // states a break moves BETWEEN, and one number for both is
           // green before the siege and after the wall is gone.
           + "palette 9\nclick 6 0\n";
    p_r = script_run(editor_state_new(PALETTE), p_head + src, "tests/actual");
    p_r
}

// ─────────────────────────────────────────────────────────────────
// ⚠⚠ THE GATE: every field of the state is reachable
// ─────────────────────────────────────────────────────────────────

// One state, every field non-neutral, authored entirely from `.keys` —
// and S0 says whether anything was missed.
//
// ⚠ **A field with no setter fails this and names itself.**  That is
// what the phase is for: not "each verb works" but "the state a capture
// needs can be said at all".
fn test_every_field_of_the_state_is_reachable() {
    tef_run = played(
        // the roster (S1a)
          "place 9 1 insect 4\nhit 0 7.5\nstand 0 1.25\nbanked 0 0.75\ndead 0\n"
        + "cursor 3\n"
        // the runtime layers
        + "raise 5 1 1.5 carapace\n"
        + "damage 6 0 25\n"
        + "order 2 2 wall_high 3\n"
        + "order 3 3 tower 12\n"
        + "tower 4 0 12 0.4 6.0 off\n"
        + "trap 5 0 off 6.5\n"
        + "spent 30\n"
        // the movers
        + "park 1 0\ndrive 3 0\nplayer on 1.5 2.5 20\n"
        + "crew 2 1\nsend 0 8 1\nmember 0 off 0.5 15 45\n"
        + "remit 0 repair\n"
        // the cargo and the schedule
        + "object 7 0 wreck 0 player\n"
        // the PLACES, and one body's routine (`plans/30` R7a)
        + "poi face 12 4 damaged 3.0\n"
        + "route 0 haul robot 2 20 6 12 12\n"
        + "mob 1 1.5 done body\n"
        + "routine 0 haul load 2.5 2 4 4 12 4 8 8\n"
        + "schedule 4 6\ncompose 1 2 miner 4 scout\n"
        + "pending 1 5.0 9.0 on\n");
    assert(tef_run.ok, "the script runs: {script_describe(tef_run)}");

    // The same state, built by hand.
    tef_want = wave_state_empty();

    // ⚠ The banked carry joined this literal in plan 23 K2b.  It was a
    // field with no setter and it passed this test anyway, because at
    // 1.5 hex/s the carry is exactly 0.0 on both sides — the same
    // *default-on-both-sides* blindness the delay note below describes,
    // caught by `18_s2`'s round trip instead.  ⚠ Set through the door
    // since plan 26 L2: the bank is an integer count of thirds of a
    // microsecond's worth of ground and 0.75 of a hex is not a number
    // anybody should be writing by hand.
    tef_want.enemies += [Enemy { q: 9, r: 1, kind: ENEMY_KIND_INSECT as u8,
                                 heading: 4 as u8, alive: false,
                                 taken: 7.5,
                                 stand: timer_armed(clock_units_from_seconds(1.25)) }];
    bank_restore_fraction((tef_want.enemies[0] ?? Enemy { }).bank, 0.75, BANK_WHOLE);
    tef_want.pick_cursor = 3;

    height_raise(tef_want.heights, 5, 1, 1.5, as_u8(RUBBLE_CARAPACE));
    damage_apply(tef_want.damage, 6, 0, 25.0);
    // ⚠ A KIND and a PROGRESS the default would not produce (plan 27
    // C1) — the same argument the delay and the composition below make.
    // `orders` left empty on both sides compares equal and proves
    // nothing, and this file's own comment is what says so.
    tef_want.orders.cells[2, 2] =
        BuildOrder { q: 2, r: 2, what: BUILD_GROUND, kind: as_u8(10),
                     spent: clock_units_from_seconds(3.0) };
    // ⚠ A TOWER order as well, and for the reason this file keeps
    // giving: `what` left at `BUILD_GROUND` on both sides of the
    // comparison compares equal and proves nothing.
    tef_want.orders.cells[3, 3] =
        BuildOrder { q: 3, r: 3, what: BUILD_TOWER, kind: as_u8(0),
                     spent: clock_units_from_seconds(12.0) };

    tower_bank(tef_want.towers, 4, 0, 0.0);
    tef_wc = tef_want.towers.cells[4, 0];
    if tef_wc != null {
        tef_wc.shots       = 12;
        tef_wc.charge      = 0.4;
        timer_restore_spent(tef_wc.repair, clock_units_from_seconds(6.0),
                            TOWER_REPAIR_UNITS);
        tef_wc.top_removed = true;
    }

    // ⚠ A plate SPENT with work banked on it (BACKLOG C4).  Both a
    // live plate and an untouched one have no cell at all, so authoring
    // an armed one would leave `traps` empty on both sides — the
    // default-on-both-sides blindness this file's own comments name
    // three times over.
    trap_fire(tef_want.traps, 5, 0);
    tef_wp = tef_want.traps.cells[5, 0];
    if tef_wp != null {
        tef_wp.spent = true;
        timer_restore_spent(tef_wp.rearm, clock_units_from_seconds(6.5),
                            TRAP_REARM_UNITS);
    }

    wallet_drain(tef_want.wallet, 30.0);

    vehicle_place(tef_want.player, 1, 0);
    vehicle_drive(tef_want.player, 3, 0);
    tef_want.player.parked     = true;
    timer_arm(tef_want.player.boost, clock_units_from_seconds(1.5));
    timer_arm(tef_want.player.cool,  clock_units_from_seconds(2.5));
    tef_want.player.taken      = 20.0;

    tef_want.crew += [helper_new(2, 1)];
    helper_drive(tef_want.crew[0] ?? Helper { }, 8, 1);
    tef_wh = tef_want.crew[0] ?? Helper { };
    tef_wh.alive    = false;
    bank_restore_fraction(tef_wh.bank, 0.5, BANK_WHOLE);
    tef_wh.taken    = 15.0;
    timer_arm(tef_wh.recover, clock_units_from_seconds(45.0));
    // ⚠ A REMIT the default would not produce (plan 29 O3) — the same
    // argument the order kind, the tower order and the spent plate all
    // make above.  `TASK_ANY` on both sides compares equal and proves
    // nothing.  ⚠ Set through `helper_direct`, which also clears the
    // held job, because that is what the script verb does.
    helper_direct(tef_wh, TASK_REPAIR);

    tef_oi = cargo_spawn(tef_want.cargo, CARGO_WRECK, 0, 7, 0);
    (tef_want.cargo.items[tef_oi] ?? CarryObject { }).owner = BLOCKER_PLAYER;

    // ⚠⚠ **The PLACES** (`plans/30` R7a), and every one of the four
    // things a `PoiWorld` holds is set to something a fresh one would
    // not produce — the state is DAMAGED with a `since`, the route
    // carries both of its anchors, and the second mob is late, done and
    // materialised.  ⚠ A default on both sides compares equal and proves
    // nothing, which is the trap this file names five times over.
    tef_wpl = poi_at(POI_KIND_FACE, 12, 4);
    poi_state_set(tef_wpl, POI_STATE_DAMAGED, clock_units_from_seconds(3.0));
    tef_want.pois.pois += [tef_wpl];
    tef_want.pois.routes += [poi_route(0, ROLE_HAUL,
                                       as_u8(ENEMY_KIND_REGULAR),
                                       Hex { q: 20, r: 6 },
                                       Hex { q: 12, r: 12 }, 2)];
    // ⚠ Through the ONE door, so the seats are the ones the script's
    // reader hands out — a hand-built rota with different seats would be
    // a comparison of two conventions rather than of two states.
    poi_enlist(tef_want.pois, 0);
    tef_wmb = tef_want.pois.mobs[1] ?? PoiMob { };
    tef_wmb.slip = clock_units_from_seconds(1.5);
    tef_wmb.gone = true;
    tef_wmb.live = true;

    // ⚠⚠ **And one BODY's routine** — the tripwire `compare.loft` laid
    // at R1 and could not fire until this phase gave the emitter a verb.
    tef_wer = errand_at(ROLE_HAUL, Hex { q: 4, r: 4 }, Hex { q: 12, r: 4 },
                        Hex { q: 8, r: 8 });
    tef_wer.carry = ERRAND_BAG_LOAD;
    tef_wer.slip  = clock_units_from_seconds(2.5);
    tef_wer.mob   = 2;
    tef_we0 = tef_want.enemies[0] ?? Enemy { };
    tef_we0.route  = tef_wer;
    tef_we0.errand = true;

    // ⚠ A delay the DEFAULT would not produce.  The first version of
    // this test used `INTER_WAVE_DELAY_SECONDS` on both sides, which
    // made `WaveSchedule.delay` invisible: it had no setter at all and
    // the totality test passed anyway.  A field at its default on both
    // sides of a comparison compares equal and proves nothing.
    tef_want.schedule = wave_schedule_of([4, 6], 9.0);
    // ⚠ A COMPOSITION the default would not produce (plan 23 K1) — the
    // same argument the delay above makes: `WavePart.kind` left at
    // `robot` on both sides compares equal and proves nothing.
    wave_schedule_compose(tef_want.schedule, 1,
        [WavePart { wave: 1, count: 2, kind: ENEMY_KIND_MINER },
         WavePart { wave: 1, count: 4, kind: ENEMY_KIND_SCOUT }]);
    tef_want.schedule.sent    = 1;
    timer_arm(tef_want.schedule.lull, clock_units_from_seconds(5.0));
    tef_want.schedule.running = true;

    assert(state_diff(tef_run.play.wave, tef_want) == "",
           "every field said from a script: "
           + "'{state_diff(tef_run.play.wave, tef_want)}'");
}

// ─────────────────────────────────────────────────────────────────
// The individual verbs
// ─────────────────────────────────────────────────────────────────

fn test_a_towers_whole_top_is_authorable() {
    tat = played("tower 4 0 12 0.4 6.0 off\n");
    assert(tat.ok, "it runs: {script_describe(tat)}");
    assert(tower_shots(tat.play.wave.towers, 4, 0) == 12,
           "shots: {tower_shots(tat.play.wave.towers, 4, 0)}");
    assert(tower_charge(tat.play.wave.towers, 4, 0) == 0.4, "charge");
    assert(tower_repair_progress(tat.play.wave.towers, 4, 0)
           == clock_units_from_seconds(6.0), "repair");
    assert(!tower_has_top(tat.play.wave.towers, 4, 0), "and the top is off");
}

// ⚠ It demands a tower MARKER, the refusal `shots` and `top` already
// make: "no top" and "no tower" are the two states a stripped tower
// sits between, and one answer for both is green both before the tower
// is placed and after it is taken away.
fn test_a_tower_without_a_marker_is_refused() {
    taw = played("tower 9 9 1 0.0 0.0 on\n");
    assert(!taw.ok, "refused: '{taw.message}'");
    assert(taw.message.contains("no tower marker"), "and says why");
}

fn test_the_wallet_is_authorable() {
    twa = played("spent 30\n");
    assert(twa.ok, "it runs: {script_describe(twa)}");
    assert(wallet_spent(twa.play.wave.wallet) == 30.0,
           "points SPENT, the way the ledger stores it: "
           + "{wallet_spent(twa.play.wave.wallet)}");
}

// ⚠ The owner IS the state machine (`carry.loft`) — on the ground, in a
// carrier's slot, or spent — so all three have to be sayable.
fn test_every_cargo_owner_is_authorable() {
    teo = played("crew 2 1\n"
                 + "object 7 0 wreck 0 ground\n"
                 + "object 7 1 top 12 player\n"
                 + "object 7 2 wreck 1 0\n"
                 + "object 7 3 top 3 gone\n");
    assert(teo.ok, "it runs: {script_describe(teo)}");

    assert(cargo_owner(teo.play.wave.cargo, 0) == BLOCKER_NONE, "on the ground");
    assert(cargo_owner(teo.play.wave.cargo, 1) == BLOCKER_PLAYER, "in the player's hands");
    assert(cargo_owner(teo.play.wave.cargo, 2) == BLOCKER_CREW + 0, "in a helper's");
    assert(cargo_owner(teo.play.wave.cargo, 3) == CARGO_GONE, "and spent");

    // ⚠ Spent is not in the world, but it KEEPS its slot — an index is
    // an identity (plan 15 C1).
    assert(cargo_count(teo.play.wave.cargo) == 3, "three still in the world");
    assert(cargo_slots(teo.play.wave.cargo) == 4, "and four slots");
}

// ⚠⚠ **THIS TEST USED TO ASSERT THE BUG** (`@D007`, BACKLOG D2).  It
// read `object 7 0 beacon 0 ground` and required it to be REFUSED, on
// the grounds that `beacon` was *an unbuilt kind* — while
// `emit.loft::emit_cargo` could already produce a `CARGO_BEACON` and
// wrote it as `"wreck"`.
//
// ⚠ So the file named *the vocabulary is TOTAL* encoded the one gap it
// exists to prevent, and it did so because nothing in the corpus had
// ever dropped a beacon: the gate was correct and had no input that
// could fail it.
//
// ⚠⚠ **Totality is the claim, so it is asserted as one**: every kind
// `emit_cargo` can WRITE, the `object` verb can READ — and a typo is
// still refused, which is the half that keeps the acceptance honest.
fn test_every_cargo_kind_the_writer_emits_is_authorable() {
    for tck_k in ["wreck", "top", "beacon"] {
        tck = played("object 7 0 " + tck_k + " 0 ground\n");
        assert(tck.ok,
               "`{tck_k}` is a kind `emit_cargo` writes, so `object` must "
               + "read it: {script_describe(tck)}");
    }
}

fn test_a_cargo_kind_typo_is_refused() {
    tct = played("object 7 0 beecon 0 ground\n");
    assert(!tct.ok, "a typo is refused: '{tct.message}'");
    assert(tct.message.contains("unknown kind"), "and says so");
    // ⚠ And the message NAMES the set, so a reader who mistyped learns
    // what was available rather than only that they were wrong.
    assert(tct.message.contains("beacon"),
           "listing what it could have been: {tct.message}");
}

fn test_an_unknown_owner_is_refused() {
    tuo = played("object 7 0 wreck 0 nobody\n");
    assert(!tuo.ok, "refused: '{tuo.message}'");
    tuo2 = played("object 7 0 wreck 0 2\n");
    assert(!tuo2.ok, "and a crew index with no crew: '{tuo2.message}'");
}

// ⚠ `<on|off>` on the player is IN THE WORLD, not alive — a vehicle
// that has never been parked sits at (0, 0) and is absent, and (0, 0)
// is a real hex (`vehicle.loft` § parked).
fn test_the_players_condition_is_authorable() {
    tpc = played("park 1 0\nplayer off 1.5 2.5 20\n");
    assert(tpc.ok, "it runs: {script_describe(tpc)}");
    assert(!vehicle_present(tpc.play.wave.player),
           "a player taken OUT of the world");
    assert(timer_left(tpc.play.wave.player.boost)
           == clock_units_from_seconds(1.5), "a boost running");
    assert(timer_left(tpc.play.wave.player.cool)
           == clock_units_from_seconds(2.5), "a cooldown");
    assert(vehicle_hp(tpc.play.wave.player) == VEHICLE_HP_BLOCKER - 20.0,
           "and damage taken: {vehicle_hp(tpc.play.wave.player)}");
}

fn test_a_crew_members_condition_is_authorable() {
    tcc = played("crew 2 1\nmember 0 off 0.5 15 45\n");
    assert(tcc.ok, "it runs: {script_describe(tcc)}");
    tcc_h = tcc.play.wave.crew[0] ?? Helper { };
    assert(helper_wrecked(tcc_h), "down");
    assert(helper_recovering(tcc_h), "and in recovery — the 60 s clock");
    assert(bank_fraction(tcc_h.bank, BANK_WHOLE) == 0.5, "with banked movement");
    assert(helper_hp(tcc_h) == HELPER_HP - 15.0, "and damage taken");
}

fn test_a_member_index_past_the_crew_is_refused() {
    tmi = played("crew 2 1\nmember 3 on 0 0 0\n");
    assert(!tmi.ok, "refused: '{tmi.message}'");
}

// ⚠ `schedule` authors the LIST and starts it at the beginning;
// `pending` says how far down it a run has got, which no play verb
// reaches — and which decides when the next wave lands.
fn test_where_the_wave_list_has_got_to_is_authorable() {
    twl = played("schedule 4 6\npending 1 5.0 9.0 on\n");
    assert(twl.ok, "it runs: {script_describe(twl)}");
    assert(wave_schedule_sent(twl.play.wave.schedule) == 1, "one wave sent");
    assert(wave_schedule_lull(twl.play.wave.schedule)
           == clock_units_from_seconds(5.0), "five seconds of lull");
    assert(wave_schedule_running(twl.play.wave.schedule), "and it is running");
    assert(wave_schedule_delay(twl.play.wave.schedule)
           == clock_units_from_seconds(9.0),
           "with a retuned lull LENGTH: {wave_schedule_delay(twl.play.wave.schedule)}");
}

fn test_the_round_robin_cursor_is_authorable() {
    trc = played("cursor 3\n");
    assert(trc.ok, "it runs: {script_describe(trc)}");
    assert(trc.play.wave.pick_cursor == 3, "the cursor: {trc.play.wave.pick_cursor}");
}

// ─────────────────────────────────────────────────────────────────
// They author, and never simulate
// ─────────────────────────────────────────────────────────────────

// ⚠ **`tower` does not fire and `object` does not check reach.**  It is
// `damage <q> <r> <hp>`'s rule a third time: a setter fills the ledger
// and triggers no consequence, so the engine keeps one code path for
// each thing that actually happens.
fn test_the_setters_trigger_nothing() {
    // A tower authored black does not go looking for a target, and an
    // object authored into the player's hands does not need the player
    // to be anywhere near it.
    tst = played("tower 4 0 30 0.0 0.0 on\n"
                 + "park 15 0\n"
                 + "object 0 0 wreck 0 player\n"
                 + "count alive 0 0\npile 0 0 0.0 0.0\n");
    assert(tst.ok,
           "nothing was fired and nothing was dropped: {script_describe(tst)}");
    assert(cargo_carrying(tst.play.wave.cargo, BLOCKER_PLAYER),
           "the player is holding something fifteen hexes away");
}

// ─────────────────────────────────────────────────────────────────
// Arity and type are checked
// ─────────────────────────────────────────────────────────────────

fn test_arity_is_checked() {
    assert(!played("tower 4 0 12 0.4 6.0\n").ok, "tower needs its top state");
    assert(!played("spent\n").ok, "spent needs its points");
    assert(!played("player on 1.5 2.5\n").ok, "player needs four");
    assert(!played("crew 2 1\nmember 0 off 0.5 15\n").ok, "member needs five");
    assert(!played("pending 1 5.0 9.0\n").ok, "pending needs four");
    assert(!played("cursor\n").ok, "cursor needs its index");
    assert(!played("object 7 0 wreck 0\n").ok, "object needs an owner");
}

fn test_an_on_off_word_is_checked() {
    assert(!played("tower 4 0 1 0.0 0.0 yes\n").ok, "the top takes on|off");
    assert(!played("player true 0 0 0\n").ok, "and so does the player");
    assert(!played("crew 2 1\nmember 0 alive 0 0 0\n").ok, "and a member");
    assert(!played("pending 0 0.0 0.0 maybe\n").ok, "and the schedule");
}

//
// Plan 08 phase V0b — the remaining editor actions, driven through
// the seam.
//
// V0a moved paint across and proved the shape works
// (`08_v0a_editor_step.loft`).  V0b moves the rest, one group at a
// time; this file grows a section per group.
//
// The rule every group is tested against: a HELD key fires its
// action ONCE.  `EditorInput` carries what is held this frame, and
// `editor_step` finds the rising edge itself — so a scripted
// `hold Tab 5` toggles the mode once, exactly as holding Tab does
// for a player.  Every group therefore gets a held-for-n-frames
// test, not just a single-frame one.

#cwd

use dryopea;

const PALETTE: text = "examples/palette.json";

// ─── Frame builders ─────────────────────────────────────────────

fn tab_frame() -> EditorInput {
    tf_i = editor_input_empty();
    tf_i.in_toggle_mode = true;
    tf_i
}

fn rotate_frame(ccw: boolean) -> EditorInput {
    rf_i = editor_input_empty();
    rf_i.in_rotate     = true;
    rf_i.in_rotate_ccw = ccw;
    rf_i
}

fn cycle_kind_frame() -> EditorInput {
    ckf_i = editor_input_empty();
    ckf_i.in_cycle_kind = true;
    ckf_i
}

fn select_frame(idx: integer) -> EditorInput {
    sf_i = editor_input_empty();
    sf_i.in_select_palette = true;
    sf_i.in_palette_index  = idx;
    sf_i
}

// Hover (q, r) with the button down and a paint tick due.
fn paint_at(q: integer, r: integer) -> EditorInput {
    pa_i = editor_input_empty();
    pa_i.in_hover_q    = q;
    pa_i.in_hover_r    = r;
    pa_i.in_mouse_left = true;
    pa_i.in_paint_tick = true;
    pa_i
}

// One press: the key goes down for a frame, then comes back up.
// Two presses in a row need the gap — that IS the edge.
fn press(s: EditorState, p_frame: EditorInput) {
    editor_step(s, p_frame);
    editor_step(s, editor_input_empty());
}

// An editor already in marker mode, which is where the placement
// tools are live.
fn marker_mode_state() -> EditorState {
    mms_s = editor_state_new(PALETTE);
    press(mms_s, tab_frame());
    mms_s
}

// ─── Group 1 — mode toggle ──────────────────────────────────────

fn test_tab_toggles_mode() {
    ttm_s = editor_state_new(PALETTE);
    assert(ttm_s.mode == MODE_GROUND, "editor opens in ground mode");

    press(ttm_s, tab_frame());
    assert(ttm_s.mode == MODE_MARKER, "one press → marker mode");

    press(ttm_s, tab_frame());
    assert(ttm_s.mode == MODE_GROUND, "another press → back to ground");
}

// The held-key rule.  Without edge detection inside the seam this
// reads MARKER or GROUND depending on whether the frame count is
// odd — a script would be testing arithmetic, not the editor.
fn test_holding_tab_toggles_once() {
    tht_s = editor_state_new(PALETTE);

    for _ in 0..5 {
        editor_step(tht_s, tab_frame());
    }

    assert(tht_s.mode == MODE_MARKER, "five frames of held Tab is ONE toggle");
}

// Flipping mode mid-drag ends the stroke: it is complete from the
// player's point of view, and must be undoable as one action.
fn test_toggle_commits_an_open_stroke() {
    tcs_s = editor_state_new(PALETTE);
    picker_set_active(tcs_s.picker, 5);

    tcs_paint = editor_input_empty();
    tcs_paint.in_hover_q    = 0;
    tcs_paint.in_hover_r    = 0;
    tcs_paint.in_mouse_left = true;
    tcs_paint.in_paint_tick = true;
    editor_step(tcs_s, tcs_paint);
    assert(!history_can_undo(tcs_s.history), "stroke still open");

    editor_step(tcs_s, tab_frame());

    assert(history_can_undo(tcs_s.history), "the mode flip committed the stroke");
    assert(len(tcs_s.history.entries) == 1, "as ONE entry");
    assert(!tcs_s.painting, "and closed it");
}

// ─── Group 1 — place-direction rotation ─────────────────────────

fn test_rotate_steps_the_place_direction() {
    trs_s = marker_mode_state();
    assert(trs_s.place_direction == 0 as u8, "starts pointing at direction 0");

    press(trs_s, rotate_frame(false));
    assert(trs_s.place_direction == 1 as u8, "one press → one step clockwise");

    press(trs_s, rotate_frame(true));
    assert(trs_s.place_direction == 0 as u8, "shift → back anticlockwise");
}

fn test_holding_rotate_steps_once() {
    trh_s = marker_mode_state();

    for _ in 0..5 {
        editor_step(trh_s, rotate_frame(false));
    }

    assert(trh_s.place_direction == 1 as u8, "held R steps once, it doesn't spin");
}

// Six 60° steps is a full turn — and the seventh must not read as
// one, or the wrap is off by one somewhere.
fn test_six_rotations_are_the_identity() {
    tsr_s = marker_mode_state();

    for _ in 0..6 {
        press(tsr_s, rotate_frame(false));
    }
    assert(tsr_s.place_direction == 0 as u8, "six steps = full turn = identity");

    press(tsr_s, rotate_frame(false));
    assert(tsr_s.place_direction == 1 as u8, "a seventh press is NOT the identity");
}

// Ground mode has no place-direction, and a target is spherical —
// in both cases rotating would move a number the player cannot see
// the effect of.
fn test_rotate_ignored_outside_spawn_placement() {
    tri_s = editor_state_new(PALETTE);
    press(tri_s, rotate_frame(false));
    assert(tri_s.place_direction == 0 as u8, "ground mode: no rotation");

    tri_s2 = marker_mode_state();
    press(tri_s2, cycle_kind_frame());
    assert(tri_s2.place_kind == MARKER_KIND_TARGET, "now placing targets");
    press(tri_s2, rotate_frame(false));
    assert(tri_s2.place_direction == 0 as u8, "targets are spherical: no rotation");
}

// ─── Group 1 — place-kind cycle ─────────────────────────────────

fn test_cycle_kind_alternates() {
    tck_s = marker_mode_state();
    assert(tck_s.place_kind == MARKER_KIND_SPAWN, "spawns by default");

    press(tck_s, cycle_kind_frame());
    assert(tck_s.place_kind == MARKER_KIND_TARGET, "K → target");

    press(tck_s, cycle_kind_frame());
    assert(tck_s.place_kind == MARKER_KIND_SPAWN, "K again → back to spawn");
}

fn test_holding_cycle_kind_fires_once() {
    thc_s = marker_mode_state();

    for _ in 0..5 {
        editor_step(thc_s, cycle_kind_frame());
    }

    assert(thc_s.place_kind == MARKER_KIND_TARGET, "held K cycles once");
}

fn test_cycle_kind_ignored_in_ground_mode() {
    tci_s = editor_state_new(PALETTE);
    press(tci_s, cycle_kind_frame());
    assert(tci_s.place_kind == MARKER_KIND_SPAWN, "ground mode places nothing to cycle");
}

// ─── Group 1 — palette selection ────────────────────────────────

fn test_select_palette_sets_the_active_tool() {
    tsp_s = editor_state_new(PALETTE);
    assert(tsp_s.picker.active == 0, "opens on sea");

    editor_step(tsp_s, select_frame(5));
    assert(tsp_s.picker.active == 5, "hotkey selects the entry");
    assert(tsp_s.render_needed, "a tool change re-renders the preview + highlight");
}

// Idempotent by design: unlike the toggles, a held hotkey re-selects
// the entry that is already active, so no edge detection is needed.
fn test_holding_a_palette_key_is_idempotent() {
    thp_s = editor_state_new(PALETTE);

    for _ in 0..5 {
        editor_step(thp_s, select_frame(9));
    }

    assert(thp_s.picker.active == 9, "still the entry that was pressed");
}

fn test_no_selection_leaves_the_tool_alone() {
    tns_s = editor_state_new(PALETTE);
    editor_step(tns_s, select_frame(5));

    editor_step(tns_s, editor_input_empty());   // no hotkey down

    assert(tns_s.picker.active == 5, "a frame with no hotkey keeps the tool");
}

// ─── Group 2 — camera ───────────────────────────────────────────

fn pan_frame(north: boolean, south: boolean, east: boolean, west: boolean) -> EditorInput {
    pnf_i = editor_input_empty();
    pnf_i.in_pan_north = north;
    pnf_i.in_pan_south = south;
    pnf_i.in_pan_east  = east;
    pnf_i.in_pan_west  = west;
    pnf_i
}

fn zoom_frame(zin: boolean) -> EditorInput {
    zf_i = editor_input_empty();
    zf_i.in_zoom_in  = zin;
    zf_i.in_zoom_out = !zin;
    zf_i
}

fn recentre_frame() -> EditorInput {
    rcf_i = editor_input_empty();
    rcf_i.in_recentre = true;
    rcf_i
}

fn test_pan_walks_the_camera() {
    tpw_s = editor_state_new(PALETTE);

    editor_step(tpw_s, pan_frame(true, false, false, false));
    assert(tpw_s.cam.pos.r == 1, "north is +r (plan 09 C3 — hex_grid's compass)");

    editor_step(tpw_s, pan_frame(false, false, true, false));
    assert(tpw_s.cam.pos.q == 1, "east is +q");
    assert(tpw_s.render_needed, "the view moved → re-rasterise");
}

// Pan is level-triggered, not edge-triggered: holding a direction
// walks the camera every frame the caller says a step is due.  That
// is the opposite of Tab, and the difference is the point.
fn test_held_pan_keeps_walking() {
    thp2_s = editor_state_new(PALETTE);

    for _ in 0..5 {
        editor_step(thp2_s, pan_frame(false, true, false, false));
    }

    assert(thp2_s.cam.pos.r == -5, "five steps of held pan SOUTH is five hexes");
}

fn test_zoom_clamps_at_both_ends() {
    tzc_s = editor_state_new(PALETTE);
    assert(tzc_s.cam.zoom == ZOOM_MIN, "opens fully zoomed in");

    for _ in 0..3 {
        editor_step(tzc_s, zoom_frame(false));
    }
    assert(tzc_s.cam.zoom == ZOOM_MIN + 3, "three steps out");

    for _ in 0..40 {
        editor_step(tzc_s, zoom_frame(true));
    }
    assert(tzc_s.cam.zoom == ZOOM_MIN, "zoom in clamps at the near end");
}

fn test_recentre_returns_to_the_origin() {
    trc_s = editor_state_new(PALETTE);
    editor_step(trc_s, pan_frame(false, true, true, false));
    editor_step(trc_s, zoom_frame(false));
    assert(trc_s.cam.pos.q != 0 || trc_s.cam.pos.r != 0, "camera moved away");

    press(trc_s, recentre_frame());

    assert(trc_s.cam.pos.q == 0 && trc_s.cam.pos.r == 0, "H returns to the origin");
    assert(trc_s.cam.zoom == ZOOM_MIN, "and to the default zoom");
}

// Recentre fires on the press, not while the key is down — so the
// camera is free to move again with H still held.
fn test_held_recentre_does_not_pin_the_camera() {
    thr_s = editor_state_new(PALETTE);

    thr_both = recentre_frame();
    thr_both.in_pan_south = true;
    editor_step(thr_s, thr_both);   // recentre fires, then the pan
    editor_step(thr_s, thr_both);   // H still held: only the pan now

    assert(thr_s.cam.pos.r == -2, "the camera keeps panning under a held H");
}

// Recentre is a view action: it must not touch what was painted.
fn test_recentre_leaves_the_world_alone() {
    trl_s = editor_state_new(PALETTE);
    picker_set_active(trl_s.picker, 5);
    press(trl_s, paint_at(3, -2));

    press(trl_s, recentre_frame());

    assert(painted_count(trl_s.pw) == 1, "recentre paints nothing away");
    assert(lookup_painted(trl_s.pw, 3, -2) == 5 as u8, "the painted hex survives");
}

// ─── Group 3 — marker placement ─────────────────────────────────

// A click at (q, r): button down for one frame, then up.
fn click_at(s: EditorState, q: integer, r: integer) {
    ca_i = editor_input_empty();
    ca_i.in_hover_q    = q;
    ca_i.in_hover_r    = r;
    ca_i.in_mouse_left = true;
    editor_step(s, ca_i);
    editor_step(s, editor_input_empty());
}

fn test_click_places_a_spawn_facing_the_place_direction() {
    tcp_s = marker_mode_state();
    press(tcp_s, rotate_frame(false));
    press(tcp_s, rotate_frame(false));

    click_at(tcp_s, 2, -1);

    assert(marker_count(tcp_s.mw) == 1, "one click, one marker");
    assert(has_marker(tcp_s.mw, 2, -1), "at the hex that was clicked");
    assert(marker_kind(tcp_s.mw, 2, -1) == MARKER_KIND_SPAWN, "a spawn");
    assert(marker_direction(tcp_s.mw, 2, -1) == 2 as u8,
           "facing the direction the tool was turned to");
    assert(tcp_s.dirty, "placing marks the world unsaved");
}

fn test_click_on_an_existing_marker_removes_it() {
    tcr2_s = marker_mode_state();
    click_at(tcr2_s, 2, -1);
    assert(marker_count(tcr2_s.mw) == 1, "placed");

    click_at(tcr2_s, 2, -1);

    assert(marker_count(tcr2_s.mw) == 0, "clicking it again takes it away");
}

fn test_click_places_a_target_when_that_is_the_kind() {
    tct_s = marker_mode_state();
    press(tct_s, cycle_kind_frame());

    click_at(tct_s, 0, 3);

    assert(marker_kind(tct_s.mw, 0, 3) == MARKER_KIND_TARGET, "a target, not a spawn");
}

// Placement is edge-triggered, so sweeping with the button held
// lays ONE marker, not a trail.  This is the opposite of paint,
// and getting it wrong would carpet a map with spawns.
fn test_held_button_sweeping_places_one_marker() {
    thb_s = marker_mode_state();

    thb_i = editor_input_empty();
    thb_i.in_mouse_left = true;
    for thb_q in 0..5 {
        thb_i.in_hover_q = thb_q;
        editor_step(thb_s, thb_i);
    }

    assert(marker_count(thb_s.mw) == 1, "a held sweep places one marker");
    assert(has_marker(thb_s.mw, 0, 0), "at the hex where the press landed");
}

fn test_click_in_ground_mode_places_no_marker() {
    tcg_s = editor_state_new(PALETTE);
    picker_set_active(tcg_s.picker, 5);

    click_at(tcg_s, 2, -1);

    assert(marker_count(tcg_s.mw) == 0, "ground mode places no markers");
}

// Placement records its own history entry, so the marker layer is
// undoable the same way paint is.
fn test_placement_is_undoable() {
    tpu_s = marker_mode_state();
    click_at(tpu_s, 2, -1);

    assert(history_can_undo(tpu_s.history), "the placement is on the timeline");
    history_undo(tpu_s.history, tpu_s.pw, tpu_s.mw);
    assert(marker_count(tpu_s.mw) == 0, "undo takes the marker back off");
}

// ─── Group 4 — undo / redo / clear ──────────────────────────────

fn undo_frame() -> EditorInput {
    uf_i = editor_input_empty();
    uf_i.in_undo = true;
    uf_i
}

fn redo_frame() -> EditorInput {
    rdf_i = editor_input_empty();
    rdf_i.in_redo = true;
    rdf_i
}

fn clear_frame() -> EditorInput {
    cf_i = editor_input_empty();
    cf_i.in_clear_all = true;
    cf_i
}

fn test_undo_takes_back_a_stroke() {
    tut_s = editor_state_new(PALETTE);
    picker_set_active(tut_s.picker, 5);
    press(tut_s, paint_at(0, 0));
    assert(painted_count(tut_s.pw) == 1, "painted");

    press(tut_s, undo_frame());

    assert(painted_count(tut_s.pw) == 0, "undo takes it back");
    assert(tut_s.dirty, "and the world now differs from disk");
}

// Undo commits the drag you are in the middle of before undoing, so
// Ctrl+Z during a stroke takes back that stroke rather than the one
// before it.
fn test_undo_during_a_stroke_takes_back_that_stroke() {
    tud_s = editor_state_new(PALETTE);
    picker_set_active(tud_s.picker, 5);
    editor_step(tud_s, paint_at(0, 0));   // button still down

    editor_step(tud_s, undo_frame());

    assert(painted_count(tud_s.pw) == 0, "the open stroke is what came back off");
    assert(!tud_s.painting, "and the stroke is closed");
}

fn test_holding_undo_undoes_once() {
    thu_s = editor_state_new(PALETTE);
    picker_set_active(thu_s.picker, 5);
    press(thu_s, paint_at(0, 0));
    press(thu_s, paint_at(4, 0));
    assert(painted_count(thu_s.pw) == 2, "two separate strokes");

    for _ in 0..5 {
        editor_step(thu_s, undo_frame());
    }

    assert(painted_count(thu_s.pw) == 1, "held Ctrl+Z undoes ONE action");
}

fn test_undo_on_an_empty_history_is_harmless() {
    tue_s = editor_state_new(PALETTE);

    press(tue_s, undo_frame());

    assert(painted_count(tue_s.pw) == 0, "nothing to undo, nothing happens");
    assert(!tue_s.dirty, "and nothing is marked unsaved");
}

fn test_redo_reapplies_what_undo_took_back() {
    trr_s = editor_state_new(PALETTE);
    picker_set_active(trr_s.picker, 5);
    press(trr_s, paint_at(0, 0));
    press(trr_s, undo_frame());
    assert(painted_count(trr_s.pw) == 0, "undone");

    press(trr_s, redo_frame());

    assert(painted_count(trr_s.pw) == 1, "redo puts it back");
    assert(lookup_painted(trr_s.pw, 0, 0) == 5 as u8, "with the same ground type");
}

fn test_clear_empties_both_layers_and_recentres() {
    tce_s = editor_state_new(PALETTE);
    picker_set_active(tce_s.picker, 5);
    press(tce_s, paint_at(0, 0));
    press(tce_s, tab_frame());
    click_at(tce_s, 2, -1);
    editor_step(tce_s, pan_frame(false, true, false, false));
    assert(painted_count(tce_s.pw) == 1 && marker_count(tce_s.mw) == 1, "a world to clear");

    press(tce_s, clear_frame());

    assert(painted_count(tce_s.pw) == 0, "painted layer emptied");
    assert(marker_count(tce_s.mw) == 0, "marker layer emptied");
    assert(tce_s.cam.pos.q == 0 && tce_s.cam.pos.r == 0, "camera back at the origin");
    assert(tce_s.dirty, "the cleared state has not reached disk yet");
}

// A mis-hit Ctrl+N must cost one Ctrl+Z, not the session.
fn test_clear_is_one_undoable_action() {
    tcu_s = editor_state_new(PALETTE);
    picker_set_active(tcu_s.picker, 5);
    press(tcu_s, paint_at(0, 0));
    press(tcu_s, paint_at(4, 0));
    press(tcu_s, clear_frame());
    assert(painted_count(tcu_s.pw) == 0, "cleared");

    press(tcu_s, undo_frame());

    assert(painted_count(tcu_s.pw) == 2, "ONE undo brings the whole world back");
    assert(lookup_painted(tcu_s.pw, 0, 0) == 5 as u8, "first hex restored");
    assert(lookup_painted(tcu_s.pw, 4, 0) == 5 as u8, "second hex restored");
}

fn test_holding_clear_fires_once() {
    thf_s = editor_state_new(PALETTE);
    picker_set_active(thf_s.picker, 5);
    press(thf_s, paint_at(0, 0));

    for _ in 0..5 {
        editor_step(thf_s, clear_frame());
    }
    press(thf_s, undo_frame());

    assert(painted_count(thf_s.pw) == 1, "held Ctrl+N clears once, so one undo restores");
}

// ─── Group 5 — save / reload ────────────────────────────────────
//
// The two actions that touch disk.  They live in the seam because
// they are actions the editor genuinely has — leaving them outside
// would make them the two things a script cannot drive, which is
// exactly what plan 08's round-trip scenario needs to drive.
//
// Paths point into `tests/actual/`, which `scripts/test.sh` wipes
// between runs.

const SAVE_PATH:   text = "tests/actual/v0b_session.json";
const MARKER_PATH: text = "tests/actual/v0b_session_markers.json";

fn save_frame() -> EditorInput {
    svf_i = editor_input_empty();
    svf_i.in_save = true;
    svf_i
}

fn reload_frame() -> EditorInput {
    rlf_i = editor_input_empty();
    rlf_i.in_reload = true;
    rlf_i
}

// An attached session with one grass hex painted and saved.
fn saved_session() -> EditorState {
    ss_s = editor_state_new(PALETTE);
    editor_state_attach(ss_s, SAVE_PATH, MARKER_PATH);
    picker_set_active(ss_s.picker, 5);
    press(ss_s, paint_at(0, 0));
    press(ss_s, save_frame());
    ss_s
}

fn test_save_writes_the_file_and_clears_the_dirty_flag() {
    tsw_s = saved_session();

    assert(file(SAVE_PATH).exists(), "the save file is on disk");
    assert(!tsw_s.dirty, "and memory now matches it");
}

// The round trip the plan asks for, driven entirely through the
// seam: paint, save, change, reload, and the saved world is back.
fn test_reload_restores_what_was_saved() {
    trs2_s = saved_session();
    press(trs2_s, paint_at(4, 0));
    press(trs2_s, paint_at(5, 0));
    assert(painted_count(trs2_s.pw) == 3, "three hexes in memory");

    press(trs2_s, reload_frame());

    assert(painted_count(trs2_s.pw) == 1, "reload drops what was never saved");
    assert(lookup_painted(trs2_s.pw, 0, 0) == 5 as u8, "the saved hex is back");
    assert(!trs2_s.dirty, "memory matches disk again");
}

// A mis-hit Ctrl+R must be recoverable — the whole current→loaded
// diff is one undo entry.
fn test_reload_is_undoable() {
    tru_s = saved_session();
    press(tru_s, paint_at(4, 0));
    press(tru_s, reload_frame());
    assert(painted_count(tru_s.pw) == 1, "reloaded");

    press(tru_s, undo_frame());

    assert(painted_count(tru_s.pw) == 2, "one undo restores the pre-reload world");
    assert(lookup_painted(tru_s.pw, 4, 0) == 5 as u8, "including the unsaved hex");
}

fn test_holding_reload_reloads_once() {
    thr2_s = saved_session();
    press(thr2_s, paint_at(4, 0));
    thr2_before = len(thr2_s.history.entries);

    for _ in 0..5 {
        editor_step(thr2_s, reload_frame());
    }

    assert(len(thr2_s.history.entries) == thr2_before + 1,
           "held Ctrl+R reloads once, recording ONE entry");
}

// The negative control for the whole group.  A session that was
// never attached to a file has nowhere to save — and, more
// dangerously, nowhere to reload FROM: an unguarded reload would
// read an absent file and wipe the world with the empty one that
// comes back.
fn test_an_unattached_session_refuses_disk() {
    tua_s = editor_state_new(PALETTE);
    picker_set_active(tua_s.picker, 5);
    press(tua_s, paint_at(0, 0));

    press(tua_s, save_frame());
    assert(tua_s.dirty, "save was refused: the world is still unsaved");

    press(tua_s, reload_frame());
    assert(painted_count(tua_s.pw) == 1, "reload was refused: the world survives");
}

// A selection past the end of the palette must not select anything.
//
// ⚠ The seam's range check is the LAST guard, not the only one.  The
// palette has twelve entries since plan 12 B1 and only eleven of them
// have a hotkey — `rubble` is deposited by the runtime, never painted
// — so what stops a player reaching it is `bindings.loft` having no
// row for it (`tests/09_i1_bindings.loft`).  This is the check under
// that one: a selection nobody can produce is still refused.
fn test_out_of_range_selection_is_ignored() {
    tor_s = editor_state_new(PALETTE);
    editor_step(tor_s, select_frame(5));

    editor_step(tor_s, select_frame(12));

    assert(tor_s.picker.active == 5, "index past the end of the palette is ignored");
}

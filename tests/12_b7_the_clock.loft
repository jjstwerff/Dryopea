//
// Plan 12 phase B7 — the scenario, and its control.
//
// ── Why this phase needs a TEST and not only three scripts ──────
//
// Every other phase of plan 12 gates a claim about one run.  B7's
// claim is a COMPARISON — *"the defended base's time-to-zero is
// markedly longer than the same base stripped of walls and towers"* —
// and no `.keys` file can make it, because a script sees one clock.
// The three scenarios each pin their own number; this file is where
// the numbers are in scope together.
//
// `plans/12` § Invariant gate also names the negative control, and it
// is not "the wall does nothing": it is **equal times = the scenario
// measures nothing, whatever it draws**.  A pair of scenarios that
// happened to agree would look exactly like a working gate.
//
// ── What the phase MEASURED, and it is not what the plan said ───
//
//   an-undefended-base             61 ticks   ( 41 s)
//   a-defended-base               104 ticks   ( 69 s)   +70%
//   a-tower-buries-its-own-wall    95 ticks   ( 63 s)   -9% against the wall
//
// The gate holds for the WALL and is **falsified for the TOWER**, and
// the second half is this phase's most valuable output — the same
// shape B3 and B5b produced.  A tower kills eight robots at the foot
// of its own wall, three of them fall on one hex, and 1.5 m of bodies
// is inside B0's [1.0, 2.0] ramp band onto a 3.0 m wall.  The
// survivors walk over their dead.  The wall never loses a tenth of its
// HP.
//
// ⚠ **These are the plan 11 F7b numbers, and the phase's shape
// survived the mover changing under it.**  On the queueing mover B7
// first read 161 / 311 / 180: a wall bought 93% and a tower gave back
// 131 of the 150.  With the sidestep every clock is far shorter and
// the tower's penalty is 9 ticks of 43 — the body ramp is a fixed
// prize that used to be measured against a clock the queue had
// inflated threefold.  Both readings say the same three things, which
// is the strongest evidence this scenario measures the defences and
// not an artefact of how enemies happen to walk.
//
// That is `docs/ENEMY_MOVEMENT.md` § Bodies are terrain firing exactly
// as written, in a base with nobody to clear up — which `plans/12`
// § What this plan does NOT build predicted in as many words: *"bodies
// pile and nobody collects them ... that is not a defect of the
// scenario, it is the scenario's most interesting outcome"*.
//
// ⚠ **The assertions below pin TODAY's behaviour on purpose, and one
// of them has already been through it.**  This file first shipped
// saying that building plan 11 F7's equal-distance sidestep would turn
// it red.  F7b did, the numbers here are the rebaseline, and the
// paragraph that had to be rewritten is the one about the tower — it
// went from *gives back more than the wall keeps* to *keeps four times
// what it gives back*.  The remaining lever is a crew that clears
// bodies, which is the vehicle.
//
// ── Why the comparisons are ONE test function ───────────────────
//
// Cost.  These scenarios are the most expensive things in the suite —
// 260 ticks between them — and a `played(BARE)` helper called from
// each of six test functions replayed the three scripts TWELVE times.
// Every scenario below is played exactly ONCE and every claim about it
// is asserted from that run.  The cost of folding them is the usual
// one: the first failing assertion hides the rest.
//
// ⚠ **Quote the measured work, never a suite wall clock.**  Timed
// directly, the three replays cost 668 + 1703 + 717 ms; the suite's
// own before-and-after swung by twenty seconds across runs of the
// SAME tree and would have justified almost any conclusion.  That is
// `CLAUDE.md` § Profiling the suite's warning arriving in the one
// place it is easiest to ignore — a change whose cost you are trying
// to judge.

#cwd

use dryopea;

const PALETTE: text = "examples/palette.json";
const SHOTS:   text = "tests/actual";

const BARE:  text = "tests/scripts/an-undefended-base.keys";
const WALL:  text = "tests/scripts/a-defended-base.keys";
const TOWER: text = "tests/scripts/a-tower-buries-its-own-wall.keys";

// The three clocks, in game-ticks.  ⚠ Each is also pinned by a `ticks`
// band inside its own `.keys` file — this is a second reading of the
// same number rather than a second source of truth, and it exists
// because the comparison needs all three at once.
const UNDEFENDED_TICKS: integer = 61;
const WALLED_TICKS:     integer = 104;
const TOWERED_TICKS:    integer = 95;

fn as_u8(n: integer) -> u8 {
    n as u8? ?? 0
}

fn test_the_three_scenarios_are_on_disk() {
    for ttt_p in [BARE, WALL, TOWER] {
        assert(file(ttt_p).exists(),
               "{ttt_p} is missing — every test below would pass against an empty file");
    }
}

// ─────────────────────────────────────────────────────────────────
// The phase's gate: three runs, and what separates them
// ─────────────────────────────────────────────────────────────────

fn test_the_clock_separates_and_a_tower_gives_it_back() {
    // ⚠ A session each.  Two scenarios sharing an `EditorState` would
    // share a painted world, and the second one's clock would be
    // measured against the first one's breach.
    ttc_bs = editor_state_new(PALETTE);
    ttc_ws = editor_state_new(PALETTE);
    ttc_ts = editor_state_new(PALETTE);

    ttc_b = script_run_file(ttc_bs, BARE,  SHOTS);
    ttc_w = script_run_file(ttc_ws, WALL,  SHOTS);
    ttc_t = script_run_file(ttc_ts, TOWER, SHOTS);

    assert(ttc_b.ok, "an-undefended-base: {script_describe(ttc_b)}");
    assert(ttc_w.ok, "a-defended-base: {script_describe(ttc_w)}");
    assert(ttc_t.ok, "a-tower-buries-its-own-wall: {script_describe(ttc_t)}");

    // ⚠ Pinned counts: a scenario with its measurements deleted still
    // reports ok, so the gate has to say how many it expected.
    assert(ttc_b.checks == 10, "an-undefended-base made {ttc_b.checks} measurements, expected 10");
    assert(ttc_w.checks == 19, "a-defended-base made {ttc_w.checks} measurements, expected 19");
    assert(ttc_t.checks == 18, "a-tower-buries made {ttc_t.checks} measurements, expected 18");
    assert(ttc_b.snaps == 1 && ttc_w.snaps == 1 && ttc_t.snaps == 1,
           "each took its picture: {ttc_b.snaps}, {ttc_w.snaps}, {ttc_t.snaps}");

    assert(ttc_b.ticks == UNDEFENDED_TICKS, "bare clock {ttc_b.ticks}");
    assert(ttc_w.ticks == WALLED_TICKS,     "walled clock {ttc_w.ticks}");
    assert(ttc_t.ticks == TOWERED_TICKS,    "towered clock {ttc_t.ticks}");

    // ── The invariant, and its negative control, in one ratio ────
    //
    // `plans/12` § Invariant gate: *the defences are what cost the
    // attacker time*, refused by *equal times = the scenario measures
    // nothing*.  1.0 is the failure; a sealed wall buys 1.70.
    //
    // A RATIO rather than a tick count, because the two runs share
    // every other number — same ground, core, spawn and wave list — so
    // whatever a later balance change does to the clock it does to
    // both, and the SEPARATION is what has to survive.
    assert(ttc_w.ticks != ttc_b.ticks,
           "equal clocks would mean the scenario measures nothing: both {ttc_b.ticks}");
    assert((ttc_w.ticks as float) / (ttc_b.ticks as float) > 1.5,
           "the wall bought {ttc_w.ticks} ticks against {ttc_b.ticks} — under half again as long");

    // ── The inversion, asserted on purpose ───────────────────────
    assert(ttc_t.ticks < ttc_w.ticks,
           "TODAY a tower SHORTENS the clock: {ttc_t.ticks} with one, {ttc_w.ticks} without");
    assert(ttc_t.ticks > ttc_b.ticks,
           "but the wall under it still buys something: {ttc_t.ticks} against {ttc_b.ticks} bare");
    // ⚠ **This assertion was INVERTED by plan 11 F7b, and the flip is
    // the good news.**  On the queueing mover the tower gave back MORE
    // than the wall kept (131 lost against 19 kept).  With the
    // sidestep it keeps 34 of 43 and loses 9 — a tower is still a net
    // loss for a base nobody cleans up after, and it is no longer a
    // catastrophe.
    assert((ttc_t.ticks - ttc_b.ticks) > (ttc_w.ticks - ttc_t.ticks),
           "the wall under it now keeps more than the tower gives back: kept {ttc_t.ticks - ttc_b.ticks}, lost {ttc_w.ticks - ttc_t.ticks}");

    // ── The two endings, told apart by ONE hex ───────────────────
    //
    // `plans/12` § What this plan does NOT build asks B7 to report
    // which of two endings takes the base.  Each script asserts its
    // own; this is the statement that they DIFFER, which is what makes
    // "which ending" a question with an answer.
    // ⚠ The breach is at (5, -2), the wall's weak END — plan 11 F7b
    // widened the attacking front until it spanned the wall, so the
    // 30 HP hex runs out before the 100 HP one.  It was (5, 0), the
    // braced middle, when the wave still met the wall as a column.
    assert(painted_kind_name(ttc_ws.picker.palette, ttc_ws.pw, 5, -2) == "grass",
           "the wall alone is CHEWED THROUGH at its end: (5, -2) is '{painted_kind_name(ttc_ws.picker.palette, ttc_ws.pw, 5, -2)}'");
    assert(painted_kind_name(ttc_ts.picker.palette, ttc_ts.pw, 5, -2) == "wall",
           "the towered wall is still standing: (5, -2) is '{painted_kind_name(ttc_ts.picker.palette, ttc_ts.pw, 5, -2)}'");

    // Masonry ON the breach where the wall broke; bodies IN FRONT of
    // the wall that held.
    assert(height_rise(ttc_w.wave.heights, 5, -2) > 0.5,
           "the breach carries its own masonry: {height_rise(ttc_w.wave.heights, 5, -2)} m");
    assert(height_rise(ttc_t.wave.heights, 5, -2) == 0.0,
           "the intact wall carries nothing: {height_rise(ttc_t.wave.heights, 5, -2)} m");
    assert(height_rise(ttc_t.wave.heights, 6, 0) >= 1.0
        && height_rise(ttc_t.wave.heights, 6, 0) <= 2.0,
           "and the ramp at its foot is inside B0's band: {height_rise(ttc_t.wave.heights, 6, 0)} m");
}

// ⚠ **A GATE is not a defence, and this is the measurement that says
// so.**  The same five-hex wall with its middle hex never painted
// falls in the undefended base's own clock, to the tick — walking
// through an entrance costs an attacker nothing whatever.  It is what
// makes `a-defended-base.keys`'s seal the interesting artefact rather
// than an arbitrary choice, and it is a rule a player can learn: an
// entrance is a decision about their own convenience, never a defence.
fn test_a_wall_with_a_gate_in_it_buys_nothing() {
    taw = script_run(editor_state_new(PALETTE), gated_base(), SHOTS);

    assert(taw.ok, "the gated base: {script_describe(taw)}");
    // ⚠ ONE tick, where a sealed wall buys 43.  It was zero before
    // plan 11 F7b — the fan now costs a robot a single step to find
    // the doorway — and one tick in sixty-one is still "nothing" in
    // any sense a player could act on.
    assert(taw.ticks - UNDEFENDED_TICKS <= 2 && taw.ticks >= UNDEFENDED_TICKS,
           "a gate buys nothing: {taw.ticks} ticks walled-with-a-gate against {UNDEFENDED_TICKS} bare, where a SEAL buys {WALLED_TICKS}");
}

// `a-defended-base.keys` verbatim, except that (5, 0) is never
// painted.  Inline rather than a fourth file in `tests/scripts/`,
// because what it is FOR is the comparison above.
fn gated_base() -> text {
    gb = "do toggle_mode\ndo cycle_kind\nclick 0 0\n"
       + "do cycle_kind\ndo cycle_kind\ndo rotate\ndo rotate\ndo rotate\nclick 11 0\n"
       + "do toggle_mode\npalette 5\n";
    for gb_r in -2..=2 { gb = gb + "drag -3 {gb_r} 12 {gb_r}\n"; }
    gb = gb + "palette 9\nclick 5 -2\nclick 5 -1\nclick 5 1\nclick 5 2\n";
    gb + "wave 5\ntick 22\nwave 8\nfall 800\n"
}

// ⚠ **A base still standing when `fall` runs out is an ERROR, and
// that is the verb's whole safety property.**  Every clock above is a
// number `fall` produced; a `fall` that stopped quietly would hand
// `ticks` its own bound instead, so `ticks 156 166` would read as a
// scenario whose premise had collapsed rather than as one that
// measured something.  The band would still be a band, and it might
// even pass.
fn test_the_new_verbs_refuse_to_fail_quietly() {
    ttn_short = script_run(editor_state_new(PALETTE), standing_base(), SHOTS);
    assert(!ttn_short.ok && ttn_short.message.contains("still standing"),
           "a base that outlasts the bound ends the run: {ttn_short.message}");
    assert(ttn_short.message.contains("points left"),
           "and says how far it got: {ttn_short.message}");

    ttn_a = script_run(editor_state_new(PALETTE), "fall abc", SHOTS);
    assert(!ttn_a.ok && ttn_a.message.contains("integer"), "{ttn_a.message}");

    ttn_b = script_run(editor_state_new(PALETTE), "fall 0", SHOTS);
    assert(!ttn_b.ok && ttn_b.message.contains("1.."), "{ttn_b.message}");

    ttn_c = script_run(editor_state_new(PALETTE), "ticks 0", SHOTS);
    assert(!ttn_c.ok && ttn_c.message.contains("<lo> <hi>"), "{ttn_c.message}");
}

// One corridor, one small wave, and a bound far too short for it.
fn standing_base() -> text {
    "do toggle_mode\ndo cycle_kind\nclick 0 0\ndo cycle_kind\ndo cycle_kind\n"
  + "do rotate\ndo rotate\ndo rotate\nclick 11 0\ndo toggle_mode\npalette 5\n"
  + "drag -3 0 12 0\nwave 5\nfall 30\n"
}

// ─────────────────────────────────────────────────────────────────
// Why the clock is what it is — the mechanism, priced directly
// ─────────────────────────────────────────────────────────────────

// ⚠ **The finding this scenario first surfaced, and what became of
// it.**  B7 originally measured that the drain did NOT scale with the
// wave: thirteen robots reached the undefended core and exactly TWO
// ever nibbled it, because they arrived down one axis and a blocked
// enemy waited rather than stepping beside.  Plan 11 F7b built the
// step-beside, and this is the same measurement afterwards — the drain
// scales, and it saturates at the core's own footprint.
//
// Kept here rather than moved wholesale into
// `tests/11_f7b_the_sidestep.loft` because the two ask different
// questions: that file asks how many enemies REACH the core, this one
// asks what they cost the player, and it is the second that sets every
// clock above.
fn test_the_drain_now_scales_with_the_wave() {
    tds_pw = painted_empty();
    for tds_r in -3..=3 {
        for tds_q in -3..=14 { paint(tds_pw, tds_q, tds_r, as_u8(5)); }
    }

    tds_four   = column_drain(4,  tds_pw);
    tds_twelve = column_drain(12, tds_pw);
    tds_one    = per_tick(NIBBLE_POINTS_PER_SECOND) * 10.0;

    assert(tds_twelve > tds_four,
           "twelve cost more than four: {tds_four} against {tds_twelve} over ten ticks");
    assert(tds_four > 2.0 * tds_one,
           "and even four beat the old flat cap of two nibblers: {tds_four}");
    assert(tds_twelve <= 7.0 * tds_one + 0.000001,
           "capped by the core's seven-hex footprint: {tds_twelve}, ceiling {7.0 * tds_one}");
}

// Walk `n` robots down row 0 until the queue settles, then answer what
// ten more ticks cost the wallet.
fn column_drain(n: integer, pw: PaintedWorld) -> float {
    cd_s = wave_state_empty();
    for cd_i in 0..n {
        cd_s.enemies += [Enemy { q: 3 + cd_i, r: 0, kind: as_u8(ENEMY_KIND_REGULAR),
                                 heading: 3 as u8, alive: true }];
    }
    cd_core = Hex { q: 0, r: 0 };
    cd_pal  = load_palette(PALETTE);
    for _ in 0..12 { wave_tick(cd_s, cd_pal, pw, marker_empty(), cd_core); }

    cd_before = wallet_spent(cd_s.wallet);
    for _ in 0..10 { wave_tick(cd_s, cd_pal, pw, marker_empty(), cd_core); }
    wallet_spent(cd_s.wallet) - cd_before
}

//
// Plan 11 phase F1b — approach mode stops at walls.
//
// The smallest real gameplay fix in plan 11, and the first line of
// dryopea that makes a wall behave like a wall: `enemy_tick` asks
// `passable.loft` whether the hex it is about to enter can hold this
// class, and stays put when it cannot.
//
// ── The gate is a PAIR, not a halt ──────────────────────────────
//
// "The enemy stopped" on its own is passed by a mover that never
// moves at all — and after F1b that failure is live, because an
// unpainted hex is sea and a whole-map refusal looks exactly like a
// wall working.  So every stop here is measured against the same
// march WITHOUT the wall, or with a gap in it: it halts at (4, 0)
// when the wall is at (3, 0), and walks through to the core when
// (3, 0) is grass.  Both of those were red before F1b — the enemy
// walked straight through — and only one of them is red if the mover
// is simply broken.
//
// ── Where the class axis is tested ──────────────────────────────
//
// Through `enemy_tick` directly, not through a script: `spawn_wave`
// emits only regulars (the validation tier is robots-only per
// DESIGN.md § 19), so an insect has to be constructed. That is the
// point of F1b landing before the field — the CLASS is already in
// the rule, so F6 changes which field an enemy reads, not what
// passability means.

#cwd

use dryopea;

const PALETTE: text = "examples/palette.json";
const SHOTS:   text = "tests/actual";

// examples/palette.json, in file order.
const GRASS:      integer = 5;
const WALL:       integer = 9;
const WALL_HIGH:  integer = 10;

fn as_u8(n: integer) -> u8 {
    n as u8? ?? 0
}

// A corridor of grass along r = 0, from (hi, 0) down to (0, 0) — the
// ground the walk needs, and nothing else painted, so anything that
// stops an enemy is either the corridor's end or a wall put there on
// purpose.
fn corridor(hi: integer) -> PaintedWorld {
    c_pw = painted_empty();
    for c_q in 0..=hi {
        paint(c_pw, c_q, 0, as_u8(GRASS));
    }
    c_pw
}

// One westbound enemy of `kind` at (q, 0) — heading 4 is (-1, 0).
fn westbound(kind: integer, q: integer) -> Enemy {
    Enemy { q: q, r: 0, kind: as_u8(kind), heading: 4 as u8, alive: true }
}

// ⚠ Plan 11 F5 gave the walk a flow field, and the field is PER CLASS
// — a robot's and an insect's differ over the same world.  Every tick
// below is therefore handed the field of the class it is ticking,
// which is what `wave_tick` does for a real roster.
//
// Handing an insect the robot's field would not fail loudly; it would
// just move the insect along a route computed for something that
// cannot climb.  That is F6's subject, and it is why the field is a
// parameter rather than something `enemy_tick` builds for itself.
fn field_for(kind: integer, pw: PaintedWorld) -> FlowField {
    flow_build(load_palette(PALETTE), pw, as_u8(kind), Hex { q: 0, r: 0 })
}

// ─────────────────────────────────────────────────────────────────
// The unit-level pair: it stops AT the wall, and only at the wall
// ─────────────────────────────────────────────────────────────────

fn test_a_robot_halts_on_the_hex_before_the_wall() {
    tar_pal = load_palette(PALETTE);
    tar_pw  = corridor(12);
    paint(tar_pw, 3, 0, as_u8(WALL));

    tar_e = westbound(ENEMY_KIND_REGULAR, 6);
    for _ in 0..10 { enemy_tick(tar_e, tar_pal, tar_pw, field_for(ENEMY_KIND_REGULAR, tar_pw), occupancy_empty()); }

    assert(tar_e.q == 4, "halted on the hex BEFORE the wall, not in it: q = {tar_e.q}");
    assert(tar_e.r == 0, "and did not drift off the corridor");
}

// The same march with (3, 0) left as grass: it does NOT stop there,
// which is what makes the assertion above about the wall rather than
// about a mover that has stopped working.
fn test_the_same_march_with_no_wall_reaches_the_core() {
    tsm_e = westbound(ENEMY_KIND_REGULAR, 6);
    for _ in 0..10 { enemy_tick(tsm_e, load_palette(PALETTE), corridor(12),
                                field_for(ENEMY_KIND_REGULAR, corridor(12)), occupancy_empty()); }

    assert(tsm_e.q == 0, "walked the whole corridor to the core: q = {tsm_e.q}");
}

// A gap in the wall face is a way through, and nothing had to detect
// it (plan 11 F0: shortest path IS the preferred entry, and a
// straight heading through a hole needs even less).
fn test_a_gap_in_the_face_is_walked_through() {
    tag_pal = load_palette(PALETTE);
    tag_pw  = corridor(12);
    // A face across the corridor with the middle hex left open.
    paint(tag_pw, 3, -1, as_u8(WALL));
    paint(tag_pw, 3,  1, as_u8(WALL));

    tag_e = westbound(ENEMY_KIND_REGULAR, 6);
    for _ in 0..10 { enemy_tick(tag_e, tag_pal, tag_pw, field_for(ENEMY_KIND_REGULAR, tag_pw), occupancy_empty()); }

    assert(tag_e.q == 0, "the gap is at (3, 0) and it went through: q = {tag_e.q}");
}

// Blocked is not dead, and it is not permanent-by-flag: the enemy
// keeps being ticked and keeps declining the same step. When combat
// lands it is this enemy that attacks the wall
// (`ENEMY_MOVEMENT.md` § Two modes).
fn test_a_blocked_enemy_stays_alive_and_stays_put() {
    tbe_pal = load_palette(PALETTE);
    tbe_pw  = corridor(12);
    paint(tbe_pw, 3, 0, as_u8(WALL));

    tbe_e = westbound(ENEMY_KIND_REGULAR, 5);
    for _ in 0..50 { enemy_tick(tbe_e, tbe_pal, tbe_pw, field_for(ENEMY_KIND_REGULAR, tbe_pw), occupancy_empty()); }

    assert(tbe_e.q == 4, "fifty ticks later it is still in front of the wall");
    assert(tbe_e.alive, "and still alive — stopping is not dying");
}

// ─────────────────────────────────────────────────────────────────
// The class axis, through the mover
// ─────────────────────────────────────────────────────────────────

fn test_an_insect_climbs_the_wall_that_stopped_the_robot() {
    tai_pal = load_palette(PALETTE);
    tai_pw  = corridor(12);
    paint(tai_pw, 3, 0, as_u8(WALL));

    tai_bot = westbound(ENEMY_KIND_REGULAR, 6);
    tai_bug = westbound(ENEMY_KIND_INSECT,  6);
    tai_botf = field_for(ENEMY_KIND_REGULAR, tai_pw);
    tai_bugf = field_for(ENEMY_KIND_INSECT,  tai_pw);
    for _ in 0..10 {
        enemy_tick(tai_bot, tai_pal, tai_pw, tai_botf, occupancy_empty());
        enemy_tick(tai_bug, tai_pal, tai_pw, tai_bugf, occupancy_empty());
    }

    assert(tai_bot.q == 4, "the robot is stopped in front of it");
    assert(tai_bug.q == 0, "the insect climbed over and carried on: q = {tai_bug.q}");
    // Same world, same heading, same start — so the paths differ for
    // exactly one reason, which is the class.
    assert(tai_bot.q != tai_bug.q, "and the two paths DIFFER");
}

fn test_a_high_wall_stops_the_insect_too() {
    tah_pal = load_palette(PALETTE);
    tah_pw  = corridor(12);
    paint(tah_pw, 3, 0, as_u8(WALL_HIGH));

    tah_bug = westbound(ENEMY_KIND_INSECT, 6);
    for _ in 0..10 { enemy_tick(tah_bug, tah_pal, tah_pw, field_for(ENEMY_KIND_INSECT, tah_pw), occupancy_empty()); }

    assert(tah_bug.q == 4, "5 m is past its climb — that is what wall_high is FOR");
}

// ─────────────────────────────────────────────────────────────────
// The surface half of the rule, through the mover
// ─────────────────────────────────────────────────────────────────

// The corridor ENDS at (0, 0); west of it is unpainted, and
// unpainted is sea. A ground robot walks to the end and stops — no
// wall involved.
fn test_the_walk_stops_at_the_water_where_the_land_ends() {
    ttw_e = westbound(ENEMY_KIND_REGULAR, 4);
    for _ in 0..12 { enemy_tick(ttw_e, load_palette(PALETTE), corridor(4),
                                field_for(ENEMY_KIND_REGULAR, corridor(4)), occupancy_empty()); }

    assert(ttw_e.q == 0, "it stopped at the last painted hex: q = {ttw_e.q}");
}

fn test_a_dead_enemy_still_does_not_move() {
    tdn_e = westbound(ENEMY_KIND_REGULAR, 6);
    tdn_e.alive = false;
    enemy_tick(tdn_e, load_palette(PALETTE), corridor(12),
               field_for(ENEMY_KIND_REGULAR, corridor(12)), occupancy_empty());

    assert(tdn_e.q == 6, "dead: frozen, and not for a passability reason");
}

// ─────────────────────────────────────────────────────────────────
// The scenario
// ─────────────────────────────────────────────────────────────────
//
// `scripts/validate.sh` sweeps it, so the fix is visible as a played
// run and not only as a unit test — and the pinned check count is
// what stops a scenario with its assertions deleted from reporting a
// green run over nothing.

fn test_stopped_at_the_wall_plays_green() {
    tsw_s = editor_state_new(PALETTE);
    editor_state_attach(tsw_s,
                        "tests/actual/f1b_stop.json",
                        "tests/actual/f1b_stop_markers.json");
    tsw = script_run_file(tsw_s, "tests/scripts/stopped-at-the-wall.keys", SHOTS);

    assert(tsw.ok, "stopped-at-the-wall: {script_describe(tsw)}");
    assert(tsw.checks == 22, "it made {tsw.checks} measurements, expected 22");
    assert(tsw.snaps == 1, "and took its picture");
    assert(alive_count(tsw.wave) == 4, "four enemies are stopped at the wall");
}

fn test_the_scenario_file_is_on_disk() {
    assert(file("tests/scripts/stopped-at-the-wall.keys").exists(),
           "the test above would pass against an empty file");
}

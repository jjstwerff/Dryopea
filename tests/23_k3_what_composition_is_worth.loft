//
// Plan 23 phase K3 — what composition is WORTH, measured.
//
// K0 gave the four classes a bite, K1 gave a wave a COMPOSITION and
// K2b gave the classes a speed.  This is the phase that plays the
// three against each other on one perimeter and says what the axis
// came to.
//
// ── ⚠⚠ This file's headline was RETIRED by plan 24 W1 ───────────
//
// **What K3 measured, and what it priced, are both still here — but the
// finding it shipped is no longer true, and that was the point of it.**
//
// K3's headline was *a wave is as dangerous as its FASTEST class, and
// no more* (`@M018`).  It also named the cause and refused to fix it
// inside a measurement phase (`@X064`).  Plan 24 then found the cause
// was not the one every document named (`@M019`) and fixed it in one
// precedence — *arriving beats queueing* — and these numbers moved:
//
//   | wave of twelve      | was  | now | pure wave of its front class |
//   |---------------------|------|-----|------------------------------|
//   | 12 miner            |  94  |  94 | —                            |
//   | 4 builder + 8 miner | 104  | 101 | 12 builder = 100             |
//   | 4 robot   + 8 miner | 119  | 116 | 12 robot   = 115             |
//   | 4 harvester+8 miner | 164  | 122 | 12 harvester = 161           |
//   | 4 scout   + 8 miner | never| 126 | 12 scout   = never           |
//
// ⚠⚠ **The new headline: a wave is worth its front class PLUS whatever
// the front class cannot COVER.**  The siege front is the wall FACE's
// width now rather than the approach fan's three — five hexes on this
// band, seven on a seven-row one — so four screens always leak exactly
// one hex, and what that leak is worth depends on how hard the screen
// bites compared with what gets through it.  A builder screen leaks a
// miner and does not care; a harvester screen leaks a miner and loses
// thirty-nine ticks by it.
//
// ⚠ **The SCREEN is arithmetic — bodies against face width** — where it
// used to be positional immunity.  Four scouts no longer make a base
// unbreakable; they cost the wave a third of its clock.
//
// ── What survived unchanged ─────────────────────────────────────
//
//   1. **An enemy blocked by a COMPANION attacks nothing** (plan 11
//      F7b) — still true, and still what keeps everybody at q = 8 idle.
//   2. **Speed decides who gets there first** (plan 23 K2b).  Before
//      K2b every class walked at 1.5 hex/s and the ROSTER order was the
//      arrival order — which is what K0 measured at 20x.  It is not any
//      more: § The roster order is worth nothing measures three
//      orderings of the same twelve landing on the same tick.  ⚠ That
//      test got STRONGER under W1: it used to compare three bases that
//      never fell, and three zeroes are equal for any reason at all.
//   3. **The cliff is a cliff.**  The first three scouts are worth
//      nothing and the fourth is worth thirty-two ticks, so the
//      mechanism is still positional rather than arithmetic in the
//      wave's own bite.
//
// ── ⚠ What K3 got right, and it is the durable part ─────────────
//
// It did not claim a defect; it claimed the axis ran through **one
// symbol per wave** rather than through the mix, and it priced the fix
// instead of applying it.  ⚠ That price is what opened plan 24, and
// plan 24's W0 then showed the rule K3 named — *the equal-distance
// sidestep* — was one dryopea had had since plan 11 F7b and was not the
// missing piece at all.  **Pricing a fix you refuse to build is what
// let the next phase discover the name was wrong.**
// ── ⚠ Read the cap, not the silence ─────────────────────────────
//
// The screened waves are asserted against `LONGEST_BASE_TICKS` — the
// 321 of `@M005`, the longest base the corpus can play — and never
// against the loop's own limit, for the reason `23_k0`'s header gives:
// *"the scenario cap was not reached"* is a statement about the cap.
// *"It outlasts the longest base anybody can play"* is falsifiable.

#cwd

use dryopea;

const PALETTE: text = "examples/palette.json";
const GRASS:   integer = 5;
const WALL:    integer = 9;

// `@M005`, plan 16 W4 — the longest base the corpus can play.  A wave
// that has not opened a perimeter by here has no perimeter-opening
// role in any game anybody can sit through.
const LONGEST_BASE_TICKS: integer = 321;

fn as_u8(n: integer) -> u8 {
    n as u8? ?? 0
}

fn core() -> Hex {
    Hex { q: 0, r: 0 }
}

fn pal() -> vector<GroundType> {
    load_palette(PALETTE)
}

// A sealed band `2 * w + 1` rows deep, walled across `q = 6`, with the
// spawn fourteen hexes out — clear of `close_spawn_disable_radius` and
// well inside the scrambler bubble.
//
// ⚠ The width is a PARAMETER because § Only three hexes are ever
// attacked needs two of them: a finding about the approach fan that is
// measured on one band width is a finding about that band.
fn band(w: integer) -> PaintedWorld {
    b_pw = painted_empty();
    for b_r in -w..=w {
        for b_q in -3..=20 { paint(b_pw, b_q, b_r, as_u8(GRASS)); }
    }
    for b_r2 in -w..=w { paint(b_pw, 6, b_r2, as_u8(WALL)); }
    b_pw
}

fn base() -> MarkerWorld {
    bs_mw = marker_empty();
    place_marker(bs_mw, 14, 0, MARKER_KIND_SPAWN as u8, 3 as u8);
    bs_mw
}

fn part(count: integer, kind: integer) -> WavePart {
    WavePart { wave: 0, count: count, kind: kind }
}

// A one-wave list, armed and composed, running from the next tick.
//
// ⚠ The size is SUMMED from the parts (`@X055`), so `schedule` is
// handed the total the parts already agree on rather than a second
// fact that could disagree with them.
fn armed(parts: vector<WavePart>) -> WaveState {
    a_s = wave_state_empty();
    a_n = 0;
    for a_p in parts { a_n += a_p.count; }
    a_s.schedule = wave_schedule_of([a_n], INTER_WAVE_DELAY_SECONDS);
    wave_schedule_compose(a_s.schedule, 0, parts);
    wave_schedule_begin(a_s.schedule);
    a_s
}

// What a wave came to.  ⚠ `fell` is 0 when the base was still standing
// at the cap and `breach` is 0 when the wall never opened — both are
// zero-neutral, so a run that did nothing reads as a run that did
// nothing rather than as a run that finished instantly.
struct Clock {
    fell:   integer,
    breach: integer,
}

fn play(parts: vector<WavePart>, w: integer, limit: integer) -> Clock {
    p_pw  = band(w);
    p_mw  = base();
    p_pal = pal();
    p_s   = armed(parts);

    p_fell   = 0;
    p_breach = 0;
    for p_t in 1..=limit {
        if p_fell > 0 { continue; }
        wave_tick(p_s, p_pal, p_pw, p_mw, core());
        if p_breach == 0 {
            for p_c in -w..=w {
                if painted_kind_name(p_pal, p_pw, 6, p_c) != "wall" && p_breach == 0 {
                    p_breach = p_t;
                }
            }
        }
        if wallet_broke(p_s.wallet) { p_fell = p_t; }
    }
    Clock { fell: p_fell, breach: p_breach }
}

// A wave of twelve: `n` of `front`, then `12 - n` miners.
fn screened(n: integer, front: integer) -> vector<WavePart> {
    s_p: vector<WavePart> = [];
    if n > 0     { s_p += [part(n, front)]; }
    if n < 12    { s_p += [part(12 - n, ENEMY_KIND_MINER)]; }
    s_p
}

// ─────────────────────────────────────────────────────────────────
// 1. ⚠⚠ THE PHASE — three waves of twelve, three clocks
// ─────────────────────────────────────────────────────────────────

// The gate this plan wrote for itself: *three waves of equal SIZE and
// different composition give three different clocks*.  They do, and
// the spread is the width of the whole game — a base that falls in 94
// ticks, one that falls in 126, and one that is still standing when
// the longest base anybody can play has been over for a hundred.
//
// ⚠ **One variable.** Same band, same wall, same spawn, same twelve
// robots, same tick loop; the only thing that moves is how many of the
// twelve are scouts.  That is `plans/12` § Invariant gate's rule — two
// runs that differ in the thing under test and in nothing else.
fn test_three_compositions_three_clocks() {
    // ⚠⚠ **FOUR runs serve two findings, and that is deliberate.**
    // The clocks and the cliff below used to be two tests over six
    // runs, four of which were the same simulation twice — `screened(0)`
    // and `screened(4)` each ran once per test.  A `Clock` stops at the
    // fall, so a run capped at 321 and the same run capped at 200 give
    // the identical `fell`; the higher cap is the one that can also say
    // *never*.
    ttc_pure = play(screened(0, ENEMY_KIND_SCOUT), 2, LONGEST_BASE_TICKS);
    ttc_one  = play(screened(1, ENEMY_KIND_SCOUT), 2, LONGEST_BASE_TICKS);
    ttc_two  = play(screened(2, ENEMY_KIND_SCOUT), 2, LONGEST_BASE_TICKS);
    ttc_four = play(screened(4, ENEMY_KIND_SCOUT), 2, LONGEST_BASE_TICKS);

    assert(ttc_pure.fell >= 90 && ttc_pure.fell <= 100,
           "twelve miners take the base at ~94: measured {ttc_pure.fell}");
    assert(ttc_two.fell >= 90 && ttc_two.fell <= 100,
           "⚠ TWO scouts in front of ten miners cost the wave NOTHING — "
           + "the front is five hexes wide and they are two, so three "
           + "miners still get on it: measured {ttc_two.fell}");
    assert(ttc_four.fell >= 120 && ttc_four.fell <= 135,
           "and four scouts cost it about a third of its clock: measured "
           + "{ttc_four.fell}");
    assert(ttc_four.breach > 0,
           "the wall does OPEN: measured a breach at {ttc_four.breach}");

    // ⚠ **The cliff is still a cliff, and it MOVED** (plan 24 W1).  If
    // the wave's bite were the sum of its members, swapping a miner for
    // a scout would cost a twelfth of it each time.  Measured, the
    // first three scouts are worth NOTHING and the fourth is worth
    // thirty-two ticks — so the mechanism is still positional.
    //
    // ⚠⚠ **What changed is where the cliff sits and what is on the far
    // side of it.**  Until W1 the front was three hexes, so the THIRD
    // scout already denied it and the fourth bought outright immunity:
    // `@M018` measured four scouts + eight miners never taking the base
    // at all, standing at {LONGEST_BASE_TICKS}.  The front is the wall
    // FACE's width now — five here — so four scouts leave ONE hex to a
    // miner, and one miner is enough.  **The screen is arithmetic:
    // bodies against face width.**
    assert(ttc_one.fell >= 90 && ttc_one.fell <= 100,
           "the FIRST scout costs the wave nothing whatever — {ttc_one.fell} "
           + "against {ttc_pure.fell} ticks");
    assert(ttc_four.fell > ttc_two.fell + 20,
           "and the fourth is worth a third of the clock, where the "
           + "second was worth nothing: {ttc_four.fell} against "
           + "{ttc_two.fell}");
    assert(ttc_four.fell < LONGEST_BASE_TICKS,
           "⚠ but it no longer buys IMMUNITY, which is what plan 24 W1 "
           + "retired: {ttc_four.fell} against the {LONGEST_BASE_TICKS} "
           + "`@M018` recorded as a base still standing");
}

// ─────────────────────────────────────────────────────────────────
// 2. ⚠⚠ A wave is as dangerous as its FASTEST class, and no more
// ─────────────────────────────────────────────────────────────────

// The finding stated so it can fail: for a class `X` faster than a
// miner, **four X plus eight miners behaves like twelve X**, not like
// something between twelve X and twelve miners.
//
// ⚠ The negative control is built into the comparison rather than
// added beside it: the miner is the hardest-biting class in the game
// at 3.0 HP/s against a harvester's 0.5, so *a wave two thirds miner
// performing like a pure harvester wave* cannot be produced by any
// rate arithmetic at all.  It needs the miners to be doing NOTHING.
//
// ⚠ Both directions are asserted.  `mixed ≈ pure` alone would pass if
// every wave of twelve took the same time; `mixed` being far from
// `12 miner` is what makes the first comparison mean something.
//
// ⚠⚠ **Both classes and the miner baseline in ONE test, for cost.**
// As two tests it ran the twelve-miner control twice and the two
// harvester runs twice over — five simulations to learn nothing extra.
// Every assertion and message is unchanged; a failure names the class
// in its own message.
// ⚠ `leak` is what the ONE hex the screen cannot cover is worth, in
// ticks off the pure wave's clock: 0 for a screen that bites nearly as
// hard as a miner, and a big number for one that does not.
fn assert_the_screen_leaks(front: integer, name: text, lo: integer, hi: integer,
                           miner: integer, leak: integer) {
    afc_mixed = play(screened(4, front), 2, 200);
    afc_pure  = play(screened(12, front), 2, 200);

    assert(afc_pure.fell >= lo && afc_pure.fell <= hi,
           "twelve {name}s take the base at {lo}..{hi}: measured {afc_pure.fell}");
    assert(afc_mixed.fell > miner,
           "the mix never beats twelve miners outright — the screen is "
           + "still in the way: {afc_mixed.fell} against {miner}");

    if leak == 0 {
        // A screen that bites nearly as hard as a miner: the hex it
        // leaks changes almost nothing, so the mix reads like the pure
        // wave — which is what `@M018` claimed of EVERY class.
        assert(afc_mixed.fell - afc_pure.fell >= 0
               && afc_mixed.fell - afc_pure.fell <= 6,
               "four {name}s and eight miners behave like twelve {name}s, "
               + "because a {name} bites nearly as hard as the miner it "
               + "leaks: {afc_mixed.fell} against {afc_pure.fell} ticks");
    } else {
        // ⚠⚠ **And here `@M018` is FALSE since plan 24 W1.**  A soft
        // screen leaves one hex of the face to a miner, and that miner
        // is worth more than the four robots screening it — so the mix
        // is dramatically FASTER than the pure wave of its own front
        // class, not level with it.
        assert(afc_pure.fell - afc_mixed.fell >= leak,
               "⚠ four {name}s and eight miners are much FASTER than "
               + "twelve {name}s — the one hex the screen cannot cover "
               + "leaks a miner, and the miner decides it: "
               + "{afc_mixed.fell} against {afc_pure.fell} ticks");
    }
}

// ⚠⚠ **What plan 24 W1 replaced `@M018` with.**  A wave is worth its
// front class PLUS whatever the front class cannot cover — and since
// the front is the wall FACE's width (five hexes here) rather than the
// approach fan's three, four screens always leak exactly one.
//
// So the SCREEN is arithmetic — bodies against face width — and what
// the leak is worth depends entirely on how hard the screening class
// bites compared with what leaks through it:
//
//   | wave of twelve        | mixed | pure of its front class |
//   |-----------------------|-------|-------------------------|
//   | 4 builder + 8 miner   |  101  |  100  — level           |
//   | 4 robot + 8 miner     |  116  |  115  — level           |
//   | 4 harvester + 8 miner |  122  |  161  — 39 ticks FASTER  |
//   | 4 scout + 8 miner     |  126  |  never                  |
//
// ⚠ The negative control is the builder row: if the leak simply made
// every mix faster, a builder screen would show it too.  It does not,
// because a builder bites hard enough that the leaked miner is not the
// story.
fn test_the_screen_leaks_one_hex_and_the_leak_decides() {
    tfc_miner = play(screened(0, ENEMY_KIND_SCOUT), 2, 200).fell;
    assert_the_screen_leaks(ENEMY_KIND_BUILDER,   "builder",   95, 106, tfc_miner, 0);
    assert_the_screen_leaks(ENEMY_KIND_HARVESTER, "harvester", 155, 168, tfc_miner, 20);
}

// ─────────────────────────────────────────────────────────────────
// 3. ⚠ The ROSTER order is worth nothing — speed is the order
// ─────────────────────────────────────────────────────────────────

// K0 measured a mix's ORDER at 20x on a breach clock, and that reading
// is still true of what it measured: enemies PLACED at different
// distances from the wall, in a world where every class walked at
// 1.5 hex/s.
//
// ⚠ **A roster slot is a different thing from a position, and since
// K2b it decides nothing.**  A wave spawns stacked on one marker and
// leaves one enemy per tick, so the roster sets the departure order —
// and then the faster class overtakes, whatever order it left in.
// Measured: four scouts first, four scouts LAST, and four scouts
// alternated through the miners all land on the same tick.
fn test_the_roster_order_is_worth_nothing() {
    tro_front = play([part(4, ENEMY_KIND_SCOUT), part(8, ENEMY_KIND_MINER)], 2, 150);
    tro_back  = play([part(8, ENEMY_KIND_MINER), part(4, ENEMY_KIND_SCOUT)], 2, 150);
    tro_mixed = play([part(2, ENEMY_KIND_MINER), part(2, ENEMY_KIND_SCOUT),
                      part(4, ENEMY_KIND_MINER), part(2, ENEMY_KIND_SCOUT),
                      part(2, ENEMY_KIND_MINER)], 2, 150);

    // ⚠ **The finding SURVIVED plan 24 W1 and got sharper.**  Before
    // W1 all three orderings failed to take the base at all, so
    // *order is worth nothing* was asserted against three zeroes — and
    // three zeroes are equal for any reason whatever, including a base
    // nothing could crack.  All three now take it, on the SAME tick,
    // which is the same claim asserted against a live number.
    assert(tro_front.fell > 0 && tro_back.fell > 0 && tro_mixed.fell > 0,
           "all three orderings take the base: {tro_front.fell} / "
           + "{tro_back.fell} / {tro_mixed.fell}");
    assert(tro_front.fell == tro_back.fell && tro_back.fell == tro_mixed.fell,
           "and they take it on the same tick — the roster order decides "
           + "NOTHING, because the faster class overtakes: {tro_front.fell} "
           + "/ {tro_back.fell} / {tro_mixed.fell}");
    assert(tro_front.breach == tro_back.breach
           && tro_back.breach == tro_mixed.breach,
           "and they open the wall on the same tick too: "
           + "{tro_front.breach} / {tro_back.breach} / {tro_mixed.breach}");
}

// The overtake itself, watched rather than inferred — the miners leave
// FIRST and the scouts are in front by the time anybody reaches the
// wall.  ⚠ This is the mechanism; the test above is its consequence,
// and a phase that asserted only the consequence would not know why.
fn test_the_faster_class_takes_the_front_rank() {
    ttf_pw  = band(2);
    ttf_mw  = base();
    ttf_pal = pal();
    ttf_s   = armed([part(8, ENEMY_KIND_MINER), part(4, ENEMY_KIND_SCOUT)]);
    ttf_t = 0;
    while ttf_t < 40 {
        wave_tick(ttf_s, ttf_pal, ttf_pw, ttf_mw, core());
        ttf_t += 1;
    }

    ttf_front  = 0;
    ttf_scouts = 0;
    for ttf_e in ttf_s.enemies {
        if ttf_e.alive && ttf_e.q == 7 {
            ttf_front += 1;
            if ttf_e.kind == ENEMY_KIND_SCOUT as u8 { ttf_scouts += 1; }
        }
    }
    assert(ttf_front > 0, "somebody reached the wall's face: {ttf_front}");
    assert(ttf_scouts == 4,
           "and all FOUR scouts are in it, having left last: {ttf_scouts} "
           + "of {ttf_front} on the face");
}

// ─────────────────────────────────────────────────────────────────
// 4. ⚠⚠ Why — only three hexes of a wall are ever attacked
// ─────────────────────────────────────────────────────────────────

// How many DISTINCT wall hexes the roster is besieging, and how many
// of the besiegers are of `kind`.
fn siege_shape(parts: vector<WavePart>, w: integer, t: integer) -> (integer, integer) {
    ss_pw  = band(w);
    ss_mw  = base();
    ss_pal = pal();
    ss_s   = armed(parts);
    ss_i = 0;
    while ss_i < t {
        wave_tick(ss_s, ss_pal, ss_pw, ss_mw, core());
        ss_i += 1;
    }

    ss_ts    = wave_targets(ss_s, ss_pal, ss_pw, core());
    ss_seen: vector<Hex> = [];
    ss_miner = 0;
    ss_k     = 0;
    for ss_e in ss_s.enemies {
        ss_t = ss_ts[ss_k] ?? Hex { q: ss_e.q, r: ss_e.r };
        if ss_e.alive && !(ss_t.q == ss_e.q && ss_t.r == ss_e.r) {
            if ss_e.kind == ENEMY_KIND_MINER as u8 { ss_miner += 1; }
            ss_new = true;
            for ss_h in ss_seen {
                if ss_h.q == ss_t.q && ss_h.r == ss_t.r { ss_new = false; }
            }
            if ss_new { ss_seen += [Hex { q: ss_t.q, r: ss_t.r }]; }
        }
        ss_k += 1;
    }
    (len(ss_seen), ss_miner)
}

// ⚠⚠ **The cause, and plan 24 W1 CHANGED it.**  This test used to
// assert that twelve robots besiege three hexes of a five-row wall and
// three of a SEVEN-row one — the front being where the approach fan
// lands (plan 12 B3) rather than how long the wall is.  `@M019` found
// the real cause: a besieger attacked only when it could not WALK, and
// a desire ring has ONE minimum on a straight face, so exactly three
// hexes lacked a legal closer step for ANY wall length.
//
// ⚠ **The front is the wall's now** — four hexes on five rows, six on
// seven — and that claim is gated in `tests/24_w1_the_front.loft`
// § test_the_front_widens_with_the_wall rather than restated here, so
// the expensive pair of `siege_shape` runs happens once in the repo.
//
// What stays here is the SCREEN, which is this phase's own subject: how
// much of a mixed wave can reach the wall at all.
//
// ⚠⚠ **Four scouts leak exactly ONE miner, where they used to leak
// none.**  That is the whole of what plan 24 W1 did to composition: the
// screen is bodies against face width, four against five, so one hex is
// always uncovered — and `test_the_screen_leaks_one_hex_and_the_leak_
// decides` is what that is worth on the clock.
//
// ⚠ Written against the target list rather than against a clock — a
// clock says the wave is slow, this says which robots are idle.
fn test_four_scouts_leak_exactly_one_miner() {
    tfs_none = siege_shape(screened(0, ENEMY_KIND_SCOUT), 2, 30);
    tfs_four = siege_shape(screened(4, ENEMY_KIND_SCOUT), 2, 30);

    assert(tfs_none.1 > 1,
           "with no scouts, several miners are on the wall: {tfs_none.1}");
    assert(tfs_four.1 == 1,
           "⚠ with four scouts, exactly ONE of the eight miners is — the "
           + "face is five hexes and the screen is four: {tfs_four.1}");
    assert(tfs_four.0 == 4,
           "and the wall is besieged across four hexes either way: "
           + "{tfs_four.0}");
}

// ─────────────────────────────────────────────────────────────────
// 5. The scenarios
// ─────────────────────────────────────────────────────────────────
//
// `scripts/validate.sh` sweeps them, so the phase is visible as a
// PLAYED run through the whole seam — the editor's world, `schedule` +
// `compose`, `play_ticks` — and not only as a `wave_tick` loop.
//
// ⚠ The twin differs by ONE `compose` line, the way K0's pair differs
// by one word.  Neither file is a measurement on its own.
//
// ⚠ The pinned check counts are what stop a scenario with its
// assertions deleted from reporting a green run over nothing.

const SHOTS: text = "shots";

fn test_the_miner_wave_scenario_plays_green() {
    tmw_s = editor_state_new(PALETTE);
    editor_state_attach(tmw_s,
                        "tests/actual/k3_miners.json",
                        "tests/actual/k3_miners_markers.json");
    tmw_r = script_run_file(tmw_s, "tests/scripts/a-wave-of-twelve-miners.keys",
                            SHOTS);
    assert(tmw_r.ok, "a-wave-of-twelve-miners: {script_describe(tmw_r)}");
    assert(tmw_r.checks == 23,
           "it made {tmw_r.checks} measurements, expected 23");
}

fn test_the_screened_wave_scenario_plays_green() {
    tsw_s = editor_state_new(PALETTE);
    editor_state_attach(tsw_s,
                        "tests/actual/k3_screened.json",
                        "tests/actual/k3_screened_markers.json");
    tsw_r = script_run_file(tsw_s, "tests/scripts/a-wave-screened-by-four.keys",
                            SHOTS);
    assert(tsw_r.ok, "a-wave-screened-by-four: {script_describe(tsw_r)}");
    assert(tsw_r.checks == 35,
           "it made {tsw_r.checks} measurements, expected 35");
}

fn test_the_scenario_files_are_on_disk() {
    assert(file("tests/scripts/a-wave-of-twelve-miners.keys").exists(),
           "a-wave-of-twelve-miners.keys is on disk");
    assert(file("tests/scripts/a-wave-screened-by-four.keys").exists(),
           "a-wave-screened-by-four.keys is on disk");
}

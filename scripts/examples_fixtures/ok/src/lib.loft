// A clean file that has OPTED IN — so this fixture exercises the
// coverage check's PASSING path as well as the citation resolver.
// Without the opt-in a bug that failed every opted-in file would still
// leave this fixture green, and only `uncovered` would speak.
// #examples

// Add two numbers.
//
// Example: xy001
pub fn add(a: integer, b: integer) -> integer { a + b }

// Subtract two numbers.
//
// ⚠ And the EXEMPTION path: a citation of `none` covers the function
// for the coverage check while contributing no marker to resolve.
//
// Example: none — the inverse of `add`, shown by xy001
pub fn sub(a: integer, b: integer) -> integer { a - b }

// A clean file that has OPTED IN — so this fixture exercises the
// coverage check's PASSING path as well as the tag resolver.
// #examples

// Add two numbers.
//
// Example: @TST-001
pub fn add(a: integer, b: integer) -> integer { a + b }

// Subtract two numbers.
//
// ⚠ The EXEMPTION path: `none` covers the function for the coverage
// check while contributing no tag to resolve — and its reason names a
// tag on purpose, which a naive count would pick up.
//
// Example: none — the inverse of `add`, shown by @TST-001
pub fn sub(a: integer, b: integer) -> integer { a - b }
